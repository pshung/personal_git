// rt_abi_aliases.S
//
// Tier-1 fixture: ra/sp/gp/tp/fp survive the QEMU1 -> vsim handoff unchanged.
// These ABI-special GPRs are never touched by other Tier-1 fixtures.
// On the hybrid path survival is checked by --verify (state_diff compares
// the drained GPRs); the run ends at the vsim exit drain.
//
// Phase A (QEMU1): seed each alias with a distinct page-aligned constant.
// Phase B (vsim):  no-op; drains and exits 200 at the exit marker.
// Phase C: standalone-run self-verify tail (markers are HINT NOPs, so the
//          same binary runs to completion on any single engine); exit code =
//          first mismatching reg num, or 0.

#include "semihost_exit.inc"

.section .text
.globl _start
_start:
    li      ra, 0x00100000
    li      sp, 0x00200000
    li      gp, 0x00300000
    li      tp, 0x00400000
    li      fp, 0x00500000           // x8

    slti   x0, x0,  0x5A0                 // QEMU1 drains, exits

    slti   x0, x0,  0x5A1                 // vsim drains, exits 200

phase_c:
    li      t0, 0x00100000
    bne     ra, t0, fail_ra
    li      t0, 0x00200000
    bne     sp, t0, fail_sp
    li      t0, 0x00300000
    bne     gp, t0, fail_gp
    li      t0, 0x00400000
    bne     tp, t0, fail_tp
    li      t0, 0x00500000
    bne     fp, t0, fail_fp
    li      a2, 0
    SEMIHOST_EXIT a2

fail_ra: li a2, 1; SEMIHOST_EXIT a2
fail_sp: li a2, 2; SEMIHOST_EXIT a2
fail_gp: li a2, 3; SEMIHOST_EXIT a2
fail_tp: li a2, 4; SEMIHOST_EXIT a2
fail_fp: li a2, 8; SEMIHOST_EXIT a2
