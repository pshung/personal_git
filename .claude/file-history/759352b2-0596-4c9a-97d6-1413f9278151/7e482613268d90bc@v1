// `andesim doctor` -- read-only environment health.
//
// The four carried-over sections (artifacts, submodules, toolchain, runtime)
// plus the Summary line are a faithful C++ port of the Python hsim `cmd_doctor`,
// kept byte-identical so the parity flywheel stays green. The detail strings
// point at scripts/build_all.sh -- the build entry point, since the build
// command moved out of the binary into that script (hsim's doctor matches).
// After Summary the driver appends an `engines:` readout sourced from F2
// discovery -- new surface, INFO-tagged, never affecting the exit code (which
// stays 1 iff any FAIL row, exactly as the golden).
#include <algorithm>
#include <cctype>
#include <cstdio>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <string>
#include <vector>

