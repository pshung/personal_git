// One diagnostic row. status is PASS | FAIL | WARN | INFO; only PASS/FAIL/WARN
// feed the summary, and only FAIL gates the exit code.
struct Row {
  std::string name;
  std::string status;
  std::string detail;
};

// Strip every leading and trailing `c` from `s` (mirrors Python str.strip(c)).
std::string strip_char(std::string s, char c) {
  size_t b = 0, e = s.size();
  while (b < e && s[b] == c) ++b;
  while (e > b && s[e - 1] == c) --e;
  return s.substr(b, e - b);
}

// --- artifacts --------------------------------------------------------------

std::vector<Row> doctor_artifacts() {
  const fs::path root = repo_root();
  struct A {
    const char* label;
    const char* env;
    fs::path def;
  };
  // The vsim/qemu defaults come straight from the registry's resolvers
  // (vsim_scan_dir / builtin_qemu_arch), so doctor reports the same paths the
  // engine would use instead of re-deriving the env -> QEMU_BIN_DIR -> legacy
  // tiers. Env overrides still match hsim's _ARTIFACT_ENV; order (vsim, qemu,
  // plugin) mirrors the golden's dict order.
  const A arts[] = {
      {"vsim", "VSIM_BIN", vsim_scan_dir() / "sim_ax45mpv_premium"},
      {"qemu64", "VSIM_QEMU", builtin_qemu_arch(64).bin_path},
      {"plugin", "VSIM_PLUGIN", default_plugin_path()},
  };
  std::vector<Row> rows;
  for (const A& a : arts) {
    const char* ov = std::getenv(a.env);
    fs::path p = (ov && *ov) ? fs::path(ov) : a.def;
    if (fs::is_regular_file(p))
      rows.push_back({a.label, "PASS", p.string()});
    else
      rows.push_back(
          {a.label, "FAIL", "missing " + p.string() + " -- run scripts/build_all.sh"});
  }

  const fs::path fix = root / "tests" / "fixtures";
  size_t elfs = 0;
  std::error_code ec;
  if (fs::is_directory(fix, ec))
    for (const auto& e : fs::directory_iterator(fix, ec))
      if (e.path().extension() == ".elf") ++elfs;
  if (elfs > 0)
    rows.push_back(
        {"fixtures", "PASS", std::to_string(elfs) + " ELFs in " + fix.string()});
  else
    rows.push_back({"fixtures", "FAIL",
                    "no *.elf in " + fix.string() +
                        " -- run make -C tests/fixtures"});
  return rows;
}

// --- submodules -------------------------------------------------------------

std::vector<Row> doctor_submodules() {
  const fs::path root = repo_root();
  struct M {
    const char* name;
    fs::path marker;
    const char* rel;  // marker, repo-relative (the PASS detail)
  };
  // QEMU and vsim are no longer submodules -- both are integrated as prebuilt
  // external binaries, checked in the artifacts section (qemu/vsim rows) via
  // VSIM_QEMU / VSIM_BIN_DIR. The one remaining submodule is the shared ABI.
  const M ms[] = {
      {"include/ (abi)", root / "include" / "hybrid" / "state_abi.h",
       "include/hybrid/state_abi.h"},
  };
  std::vector<Row> rows;
  for (const M& m : ms) {
    if (fs::is_regular_file(m.marker))
      rows.push_back({m.name, "PASS", m.rel});
    else
      rows.push_back({m.name, "FAIL",
                      "missing " + m.marker.string() +
                          " -- run 'git submodule update --init --recursive'"});
  }
  return rows;
}

// --- toolchain --------------------------------------------------------------

// First PATH directory holding an executable non-directory named `tool`, joined
// the way shutil.which reports it (dir + '/' + tool). "" if not found.
std::string which(const std::string& tool) {
  const char* path = std::getenv("PATH");
  if (!path) return "";
  const std::string p(path);
  for (size_t i = 0; i <= p.size();) {
    size_t j = p.find(':', i);
    if (j == std::string::npos) j = p.size();
    std::string dir = p.substr(i, j - i);
    i = j + 1;
    if (dir.empty()) continue;
    std::string cand = dir.back() == '/' ? dir + tool : dir + "/" + tool;
    std::error_code ec;
    if (::access(cand.c_str(), X_OK) == 0 && !fs::is_directory(cand, ec))
      return cand;
  }
  return "";
}

// Match `^\s*(?:export\s+)?HYBRID_TOOLCHAIN\s*=\s*(.+?)\s*$`; on match set `out`
// to the value with surrounding whitespace, then double, then single quotes
// stripped (mirrors hsim._read_hybrid_toolchain).
bool parse_toolchain_line(const std::string& line, std::string& out) {
  size_t i = 0, n = line.size();
  auto skip_ws = [&] {
    while (i < n && std::isspace(static_cast<unsigned char>(line[i]))) ++i;
  };
  skip_ws();
  const std::string kw = "export";
  if (line.compare(i, kw.size(), kw) == 0 && i + kw.size() < n &&
      std::isspace(static_cast<unsigned char>(line[i + kw.size()]))) {
    i += kw.size();
    skip_ws();
  }
  const std::string key = "HYBRID_TOOLCHAIN";
  if (line.compare(i, key.size(), key) != 0) return false;
  i += key.size();
  skip_ws();
  if (i >= n || line[i] != '=') return false;
  std::string rest = line.substr(i + 1);  // everything after '='
  if (rest.empty()) return false;         // regex (.+?) needs >= 1 char
  size_t b = 0, e = rest.size();
  while (b < e && std::isspace(static_cast<unsigned char>(rest[b]))) ++b;
  while (e > b && std::isspace(static_cast<unsigned char>(rest[e - 1]))) --e;
  std::string val = strip_char(rest.substr(b, e - b), '"');
  out = strip_char(val, '\'');
  return true;
}

// HYBRID_TOOLCHAIN: env first (non-empty wins), else the first matching
// assignment in config.env. "" if neither yields a value.
std::string read_hybrid_toolchain() {
  const char* env = std::getenv("HYBRID_TOOLCHAIN");
  if (env && *env) return env;
  std::ifstream f(repo_root() / "config.env");
  if (!f) return "";
  std::string line, val;
  while (std::getline(f, line))
    if (parse_toolchain_line(line, val)) return val;
  return "";
}

std::vector<Row> doctor_toolchain() {
  struct T {
    const char* tool;
    const char* hint;
    bool warn_only;  // a missing podman warns; ninja/make fail
  };
  const T tools[] = {
      {"ninja", "needed by scripts/build_all.sh of QEMU", false},
      {"make", "needed by scripts/build_all.sh of fixtures", false},
      {"podman", "needed by scripts/build_all.sh of vsim (or docker shim)", true},
  };
  std::vector<Row> rows;
  for (const T& t : tools) {
    std::string found = which(t.tool);
    if (!found.empty())
      rows.push_back({t.tool, "PASS", found});
    else
      rows.push_back({t.tool, t.warn_only ? "WARN" : "FAIL",
                      std::string("not on PATH -- ") + t.hint});
  }

  std::string tc = read_hybrid_toolchain();
  if (tc.empty()) {
    rows.push_back({"HYBRID_TOOLCHAIN", "WARN",
                    "not set -- needed for fixture build (see config.env)"});
  } else {
    fs::path gcc = fs::path(tc) / "bin" / "riscv64-unknown-elf-gcc";
    if (fs::is_regular_file(gcc))
      rows.push_back({"riscv64-unknown-elf-gcc", "PASS", gcc.string()});
    else
      rows.push_back({"riscv64-unknown-elf-gcc", "FAIL",
                      "missing " + gcc.string() +
                          " -- check HYBRID_TOOLCHAIN=" + tc});
  }
  return rows;
}

// --- runtime ----------------------------------------------------------------

constexpr long kDefaultJobs = 8;

std::vector<Row> doctor_runtime() {
  std::vector<Row> rows;
  long nproc = sysconf(_SC_NPROCESSORS_ONLN);
  if (nproc < 1) nproc = 1;
  rows.push_back({"nproc", "INFO", std::to_string(nproc)});

  std::error_code ec;
  if (fs::is_directory("/dev/shm", ec)) {
    struct statvfs vfs{};
    unsigned long long free_gb = 0;
    if (statvfs("/dev/shm", &vfs) == 0)
      free_gb = static_cast<unsigned long long>(vfs.f_bavail) * vfs.f_frsize /
                (1024ULL * 1024 * 1024);
    rows.push_back({"/dev/shm free", free_gb >= 4 ? "PASS" : "WARN",
                    std::to_string(free_gb) + " GB"});
  } else {
    rows.push_back({"/dev/shm", "WARN",
                    "not present -- e2e fixtures will fall back to $TMPDIR"});
  }

  long suggested = std::min(nproc, kDefaultJobs);
  rows.push_back({"JOBS suggestion", "INFO",
                  std::to_string(suggested) + " (default cap = " +
                      std::to_string(kDefaultJobs) + ")"});
  return rows;
}

// --- engines (C++-only readout, after Summary) ------------------------------

// Reflects `list engines` from the same F2 discovery, in doctor's row idiom.
// INFO-tagged and printed after Summary, so it never moves the summary counts
// or the exit code. Discovery warnings surface as WARN rows here.
void print_engines_section() {
  Discovery disc = discover_engines();
  size_t w = 0;
  for (const EngineDescriptor& e : disc.engines) w = std::max(w, e.id.size());

  std::printf("\nengines:\n");
  for (const EngineDescriptor& e : disc.engines)
    std::printf("  [INFO] %s  kind=%s vlen=%s triggers=%s\n",
                ljust(e.id, w).c_str(), e.kind.c_str(), vlen_str(e.vlen).c_str(),
                join(e.triggers).c_str());
  for (const std::string& warn : disc.warnings)
    std::printf("  [WARN] %s\n", warn.c_str());
}

// The shared-mmap backing tiers (F1 resolver order) with their free space,
// plus WSL2 advice. INFO/WARN-tagged and printed after Summary like engines,
// so the carried-over report keeps byte-parity with the Python golden.
void print_mmap_section() {
  const std::vector<MmapTier> tiers = mmap_tiers();
  size_t w = 0;
  for (const MmapTier& t : tiers) w = std::max(w, t.label.size());

  std::printf("\nmmap tiers:\n");
  int n = 0;
  for (const MmapTier& t : tiers) {
    struct statvfs vfs{};
    std::string free = "missing";
    if (statvfs(t.dir.c_str(), &vfs) == 0) {
      const double gib = static_cast<double>(vfs.f_bavail) * vfs.f_frsize /
                         (1024.0 * 1024 * 1024);
      char buf[32];
      std::snprintf(buf, sizeof(buf), "free: %.1f GiB", gib);
      free = buf;
    }
    std::printf("  [INFO] tier %d  %s  %s\n", ++n, ljust(t.label, w).c_str(),
                free.c_str());
  }

  std::string proc_version;
  if (std::FILE* f = std::fopen("/proc/version", "r")) {
    char buf[512] = {};
    const size_t got = std::fread(buf, 1, sizeof(buf) - 1, f);
    proc_version.assign(buf, got);
    std::fclose(f);
  }
  std::error_code ec;
  for (const std::string& warn :
       wsl_warnings(proc_version, fs::current_path(ec).string(), tiers))
    std::printf("  [WARN] %s\n", warn.c_str());
}

struct Section {
  const char* title;
  std::vector<Row> rows;
};

}  // namespace

int cmd_doctor(const Cli&) {
  std::vector<Section> sections = {
      {"artifacts", doctor_artifacts()},
      {"submodules", doctor_submodules()},
      {"toolchain", doctor_toolchain()},
      {"runtime", doctor_runtime()},
  };

  size_t name_width = 0;
  for (const Section& s : sections)
    for (const Row& r : s.rows) name_width = std::max(name_width, r.name.size());

  int passes = 0, fails = 0, warns = 0;
  for (const Section& s : sections) {
    std::printf("%s:\n", s.title);
    for (const Row& r : s.rows) {
      if (r.status == "PASS") ++passes;
      else if (r.status == "FAIL") ++fails;
      else if (r.status == "WARN") ++warns;
      std::printf("  [%-4s] %s  %s\n", r.status.c_str(),
                  ljust(r.name, name_width).c_str(), r.detail.c_str());
    }
    std::printf("\n");
  }
  std::printf("Summary: %d PASS, %d FAIL, %d WARN\n", passes, fails, warns);

  print_engines_section();
  print_mmap_section();
  return fails > 0 ? 1 : 0;
}

