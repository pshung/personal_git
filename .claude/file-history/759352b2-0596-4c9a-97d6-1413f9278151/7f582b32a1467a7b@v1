// rt_pc_jump.S
//
// Tier-1 fixture: verifies DPC fidelity at the vsim->QEMU2 boundary.
//
// Phase A (QEMU1): slti x0, x0,  0x5A0  -> drain & exit.
// Phase B (vsim):  jump 64 bytes forward, then slti x0, x0,  0x5A1 -> drain.
//                  state_drain captures DPC = PC of insn after the exit marker.
//                  If DPC is stale (e.g., points to the linear PC after the
//                  jump source instead of after the post-jump marker), QEMU2
//                  resumes at the wrong location and never exits cleanly.
// Phase C (QEMU2): semihosting exit with code 0.

#include "semihost_exit.inc"

.section .text
.globl _start
_start:
    slti   x0, x0,  0x5A0                 // QEMU1 drains, exits

    // Phase B: jump forward 0x40 bytes; everything in between is dead code
    // that would set the wrong DPC if the jump were not taken.
    j       phase_b_landing
    .rept   15
    slti   x0, x0,  0x5A1                 // poison: would re-trigger drain
    .endr

phase_b_landing:
    slti   x0, x0,  0x5A1                 // vsim drains here; DPC must point at phase_c

phase_c:
    li      a2, 0
    SEMIHOST_EXIT a2
