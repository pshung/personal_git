// andesim -- multi-engine driver for the Andes simulators (QEMU, Verilator,
// and future backends). One C++20 binary that selects a model (fast / cycle
// / hybrid), resolves engines at runtime, and either passes through to a single
// engine or orchestrates a hybrid round-trip.
//
// This file owns argument dispatch only: parse the CLI, route to a command.
// Each subcommand below resolves to its handler as its feature lands (F1-F13);
// until then it stubs out, keeping the command surface stable.
#include <cstdio>
#include <cstdlib>
#include <exception>
#include <string>
#include <string_view>

#include "cli.hpp"
#include "dev_mode.hpp"
#include "repo_root.hpp"

namespace andes_sim {
int cmd_list(const Cli& cli);
int cmd_doctor(const Cli& cli);
int cmd_run(const Cli& cli);
}  // namespace andes_sim

namespace {

using andes_sim::Cli;
using andes_sim::cmd_doctor;
using andes_sim::cmd_list;
using andes_sim::cmd_run;
using andes_sim::is_dev_mode;

// Known command names. run/list/doctor get handlers as each feature lands; the
// rest are stable slots for unfinished ROADMAP features, kept here so `find`
// routes them to the "not yet implemented" stub rather than "unknown command",
// while never appearing in `--help` (print_usage renders only the
// run/list/doctor blocks, so the product never advertises half-built work).
// Developer build/test/state-diff tooling lives in scripts/, not the binary.
// Display strings (briefs, modes, options) live in the help model below.
struct Subcommand {
  std::string_view name;
};

constexpr Subcommand kSubcommands[] = {
    {"run"},     {"list"},   {"doctor"},
    {"profile"}, {"cluster"}, {"estimate"},
};

const Subcommand* find(std::string_view name) {
  for (const Subcommand& s : kSubcommands)
    if (s.name == name) return &s;
  return nullptr;
}

// ---- help model: the user-facing surface rendered as a command tree --------
//
// `run`'s two subcommand groups -- the modes (the composition axis) ...
struct ModeRow {
  const char* name;
  const char* brief;
};
constexpr ModeRow kRunModes[] = {
    {"fast", "QEMU only -- functional, full speed"},
    {"cycle", "one cycle-accurate engine, from reset"},
    {"hybrid", "QEMU fast-forwards, then vsim measures the ROI"},
};

// `list`'s targets. `fixtures` (internal test ELFs) is a developer target,
// shown only under ANDESIM_DEV; the product lists user-facing models/engines.
struct TargetRow {
  const char* name;
  const char* brief;
  bool dev;
};
constexpr TargetRow kListTargets[] = {
    {"models", "the modes and their engines", false},
    {"engines", "discovered cycle-accurate engines", false},
    {"fixtures", "internal test ELFs (developer target)", true},
};

// ... and `run`'s options. Each `flag` carries its own leading indent (the pc
// boundaries nest under --trigger pc). `tag` marks a required option (and WHEN
// it is required); `dev` hides it unless ANDESIM_DEV is set.
struct OptRow {
  const char* flag;  // includes its own leading indent
  const char* tag;
  const char* brief;
  bool dev;
};
constexpr OptRow kRunOpts[] = {
    {"  --mode fast|cycle|hybrid", "REQUIRED", "which mode to run", false},
    {"  --trigger marker|pc", "REQUIRED for hybrid", "the ROI delimiter", false},
    {"    --pc-start <sym|0x>", "REQUIRED for --trigger pc", "ROI start boundary", false},
    {"    --pc-end <sym|0x>", "REQUIRED for --trigger pc", "ROI end boundary", false},
    {"  --engine <id>", "", "pick an engine, e.g. vsim:ax45mpv_premium (default: the sole one)", false},
    {"  --mem-size <spec>", "", "guest RAM, e.g. 256M / 2G (hybrid: max 2G; fast: QEMU -m; cycle: ignored)", false},
    {"  --dry-run", "", "print the exact engine command(s) and exit, running nothing (fast/cycle/hybrid)", false},
    {"  --verify", "", "cross-check the hybrid run against a QEMU oracle", false},
    {"  --gdb", "", "pause at startup for a debugger (fast: QEMU stub; cycle: vsim JTAG + $ICEMAN; not hybrid)", false},
    {"  --gdb-port <port>", "", "override the --gdb port (fast 1234, cycle 9104)", false},
    {"  -- <args...>", "", "forward everything after -- verbatim to the engine (fast/cycle only; hybrid rejects -- args)", false},
};

// A major command line at column 0: `name   brief`.
void print_major(std::FILE* out, const char* name, const char* brief) {
  std::fprintf(out, "%-7s %s\n", name, brief);
}

// A subcommand/target line, indented two under its command: `  name   brief`.
void print_sub(std::FILE* out, const char* name, const char* brief) {
  std::fprintf(out, "  %-9s %s\n", name, brief);
}

// An option line: `<indent>--flag    [TAG  ]brief`, flags aligned to a column.
void print_opt(std::FILE* out, const OptRow& o) {
  if (o.tag[0])
    std::fprintf(out, "%-29s %s  %s\n", o.flag, o.tag, o.brief);
  else
    std::fprintf(out, "%-29s %s\n", o.flag, o.brief);
}

// `run`: major line, the mode subcommands, then the option list (dev options
// only under ANDESIM_DEV). Shared by the top-level tree and `run --help`.
void print_run_block(std::FILE* out) {
  print_major(out, "run", "run one simulation");
  for (const ModeRow& m : kRunModes) print_sub(out, m.name, m.brief);
  std::fputs("\n", out);
  for (const OptRow& o : kRunOpts) {
    if (o.dev && !is_dev_mode()) continue;
    print_opt(out, o);
  }
}

void print_list_block(std::FILE* out) {
  print_major(out, "list", "list what is available");
  for (const TargetRow& t : kListTargets) {
    if (t.dev && !is_dev_mode()) continue;
    print_sub(out, t.name, t.brief);
  }
}

void print_doctor_block(std::FILE* out) {
  print_major(out, "doctor", "check toolchain + fixtures are present");
}

// Top-level `andesim --help`: the whole tree -- every major command, its
// subcommands, and run's full option list, so one screen shows everything.
void print_usage(std::FILE* out) {
  std::fputs("usage: andesim <command> [options] <ELF> [-- <engine args>]\n\n",
             out);
  std::fputs("Multi-engine driver for the Andes simulators (QEMU + vsim).\n\n",
             out);
  print_run_block(out);
  std::fputs("\n", out);
  print_list_block(out);
  std::fputs("\n", out);
  print_doctor_block(out);
  std::fputs(
      "\n'andesim run --help' / 'andesim list --help' for per-command "
      "detail.\n",
      out);
}

// Per-command `andesim <cmd> --help`: the matching slice of the same tree.
void print_subcommand_help(const Subcommand& sc, std::FILE* out) {
  if (sc.name == "run") { print_run_block(out); return; }
  if (sc.name == "list") { print_list_block(out); return; }
  if (sc.name == "doctor") { print_doctor_block(out); return; }
  // A Hidden/unfinished command: a stable usage line, no advertised detail.
  std::fprintf(out, "usage: andesim %.*s [args...]\n",
               static_cast<int>(sc.name.size()), sc.name.data());
}

}  // namespace

int main(int argc, char** argv) {
  using namespace andes_sim;

  Cli cli = parse_cli(argc, argv);
  if (!cli.error.empty()) {
    std::fprintf(stderr, "andesim: %s\n", cli.error.c_str());
    return 2;
  }

  if (cli.subcommand.empty()) {  // no command, or top-level -h
    if (cli.help) {
      print_usage(stdout);
      return 0;
    }
    print_usage(stderr);
    return 2;
  }

  const Subcommand* sc = find(cli.subcommand);
  if (!sc) {
    std::fprintf(stderr, "andesim: unknown command '%s'\n\n",
                 cli.subcommand.c_str());
    print_usage(stderr);
    return 2;
  }

  if (cli.help) {
    print_subcommand_help(*sc, stdout);
    return 0;
  }

  if (cli.subcommand == "list") return cmd_list(cli);
  if (cli.subcommand == "doctor") return cmd_doctor(cli);
  if (cli.subcommand == "run") return cmd_run(cli);

  // Remaining subcommands stub out until their handler lands (run/doctor arrive
  // feature by feature). Resolve the repo root so the discovery path -- which
  // every handler relies on -- stays live and observable from the scaffold.
  std::string root;
  try {
    root = repo_root().string();
  } catch (const std::exception& e) {
    root = std::string("<unknown: ") + e.what() + ">";
  }
  std::fprintf(stderr, "andesim %s: not yet implemented (repo root: %s)\n",
               cli.subcommand.c_str(), root.c_str());
  return 3;
}
