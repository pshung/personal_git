#define GGML_CPU_FP16_TO_FP32(x) lab_fp16_to_fp32(x)
#define NOINLINE __attribute__((noinline))
#define UNUSED(x) (void)(x)

// ---- exact fp16 <-> fp32, copied from ggml/src/ggml-impl.h ----------------

static inline float fp32_from_bits(uint32_t w) {
    float f;
    memcpy(&f, &w, sizeof(f));
    return f;
}

static inline uint32_t fp32_to_bits(float f) {
    uint32_t w;
    memcpy(&w, &f, sizeof(w));
    return w;
}

float lab_fp16_to_fp32(uint16_t h) {
    const uint32_t w = (uint32_t) h << 16;
    const uint32_t sign = w & UINT32_C(0x80000000);
    const uint32_t two_w = w + w;

    const uint32_t exp_offset = UINT32_C(0xE0) << 23;
    const float exp_scale = 0x1.0p-112f;
    const float normalized_value = fp32_from_bits((two_w >> 4) + exp_offset) * exp_scale;

    const uint32_t magic_mask = UINT32_C(126) << 23;
    const float magic_bias = 0.5f;
    const float denormalized_value = fp32_from_bits((two_w >> 17) | magic_mask) - magic_bias;

    const uint32_t denormalized_cutoff = UINT32_C(1) << 27;
    const uint32_t result = sign |
        (two_w < denormalized_cutoff ? fp32_to_bits(denormalized_value) : fp32_to_bits(normalized_value));
    return fp32_from_bits(result);
}

uint16_t lab_fp32_to_fp16(float f) {
    const float scale_to_inf  = 0x1.0p+112f;
    const float scale_to_zero = 0x1.0p-110f;
    float base = (fabsf(f) * scale_to_inf) * scale_to_zero;

    const uint32_t w = fp32_to_bits(f);
    const uint32_t shl1_w = w + w;
    const uint32_t sign = w & UINT32_C(0x80000000);
    uint32_t bias = shl1_w & UINT32_C(0xFF000000);
    if (bias < UINT32_C(0x71000000)) {
        bias = UINT32_C(0x71000000);
    }

    base = fp32_from_bits((bias >> 1) + UINT32_C(0x07800000)) + base;
    const uint32_t bits = fp32_to_bits(base);
    const uint32_t exp_bits = (bits >> 13) & UINT32_C(0x00007C00);
    const uint32_t mantissa_bits = bits & UINT32_C(0x00000FFF);
    const uint32_t nonsign = exp_bits + mantissa_bits;
    return (sign >> 16) | (shl1_w > UINT32_C(0xFF000000) ? UINT16_C(0x7E00) : nonsign);
}

// ---- scalar reference, copied from ggml/src/ggml-cpu/quants.c:127 ---------

void ggml_vec_dot_q1_0_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
    const int qk = QK1_0;
    const int nb = n / qk;

    assert(n % qk == 0);
    assert(nrc == 1);
    UNUSED(nrc);
    UNUSED(bx);
    UNUSED(by);
    UNUSED(bs);

    const block_q1_0 * GGML_RESTRICT x = vx;
    const block_q8_0 * GGML_RESTRICT y = vy;

    float sumf = 0.0;

    for (int i = 0; i < nb; i++) {
        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);

        float sumi = 0.0f;

        for (int k = 0; k < 4; k++) {
            const block_q8_0 * GGML_RESTRICT yb = &y[i * 4 + k];
            const float d1 = GGML_CPU_FP16_TO_FP32(yb->d);
            int sumi_block = 0;

            const uint8_t * GGML_RESTRICT bits = &x[i].qs[k * 4];
            const int8_t  * GGML_RESTRICT qy   = yb->qs;

            for (int b = 0; b < 4; ++b, qy += 8) {
                const unsigned mask = bits[b];
                sumi_block += ((mask & 0x01) ? qy[0] : -qy[0])
                           +  ((mask & 0x02) ? qy[1] : -qy[1])
                           +  ((mask & 0x04) ? qy[2] : -qy[2])
                           +  ((mask & 0x08) ? qy[3] : -qy[3])
                           +  ((mask & 0x10) ? qy[4] : -qy[4])
                           +  ((mask & 0x20) ? qy[5] : -qy[5])
                           +  ((mask & 0x40) ? qy[6] : -qy[6])
                           +  ((mask & 0x80) ? qy[7] : -qy[7]);
            }

            sumi += d1 * sumi_block;
        }

        sumf += d0 * sumi;
    }

    *s = sumf;
}

// ---- RVV kernels, copied from ggml/src/ggml-cpu/arch/riscv/quants.c:484 ---

#if defined(__riscv_v_intrinsic)

#include <riscv_vector.h>

// fp16 -> fp32 expansion of 4 strided scales without zfh/zvfh (the RTL
// target ax45mpv_premium has neither): exact for normals and +-0, subnormal
// scales flush to zero (ggml quantizers never produce them). Verified on the
// RTL sim by vsim-demo/q1_0/probe.c.
static inline vfloat32m2_t lab_expand_fp16_x4(const uint16_t * p, ptrdiff_t stride) {
    const vuint16m1_t vh = __riscv_vlse16_v_u16m1(p, stride, 4);
    const vuint32m2_t hz = __riscv_vzext_vf2_u32m2(vh, 4);
    const vuint32m2_t sign = __riscv_vsll_vx_u32m2(__riscv_vand_vx_u32m2(hz, 0x8000, 4), 16, 4);
    vuint32m2_t mag = __riscv_vadd_vx_u32m2(
        __riscv_vsll_vx_u32m2(__riscv_vand_vx_u32m2(hz, 0x7FFF, 4), 13, 4),
        (uint32_t)112 << 23, 4);
    const vbool16_t ez = __riscv_vmseq_vx_u32m2_b16(__riscv_vand_vx_u32m2(hz, 0x7C00, 4), 0, 4);
    mag = __riscv_vmerge_vxm_u32m2(mag, 0, ez, 4);
    return __riscv_vreinterpret_v_u32m2_f32m2(__riscv_vor_vv_u32m2(sign, mag, 4));
}

// Candidate for VLEN >= 512 (correct for any VLEN >= 256): same per-group
// vl=32 dataflow as vl256, but no vector->scalar move in the block loop
// (vl256 does 4 vmv.x.s + 4 scalar fp16 converts + 4 scalar FMAs per block):
// the four group sums are packed into lanes 0..3 of one i16 vector with tiny
// slideups, the activation scales are loaded with one strided vlse16 and
// applied as a vector, and the float accumulation stays in 4 vector lanes
// until one ordered reduction at the end of the row.
NOINLINE void ggml_vec_dot_q1_0_q8_0_vl512(const int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy) {
    const int qk = QK1_0;
    const int nb = n / qk;
    assert(n % qk == 0);

    const block_q1_0 * GGML_RESTRICT x = vx;
    const block_q8_0 * GGML_RESTRICT y = vy;

    //LMUL = 1, VLMAX = 32
    const size_t vl32 = __riscv_vsetvl_e8m1(32);
    assert(vl32 == 32);
    UNUSED(vl32);

    const vint16m1_t zero = __riscv_vmv_v_x_i16m1(0, 1);
    vfloat32m2_t facc = __riscv_vfmv_v_f_f32m2(0.0f, 4);

    for (int ib = 0; ib < nb; ++ib) {
        const float d0 = GGML_CPU_FP16_TO_FP32(x[ib].d);
        const block_q8_0 * GGML_RESTRICT yb = &y[ib * 4];

        const vbool8_t m0 = __riscv_vlm_v_b8(x[ib].qs,      32);
        const vbool8_t m1 = __riscv_vlm_v_b8(x[ib].qs +  4, 32);
        const vbool8_t m2 = __riscv_vlm_v_b8(x[ib].qs +  8, 32);
        const vbool8_t m3 = __riscv_vlm_v_b8(x[ib].qs + 12, 32);
        const vint8m1_t q0 = __riscv_vle8_v_i8m1(yb[0].qs, 32);
        const vint8m1_t q1 = __riscv_vle8_v_i8m1(yb[1].qs, 32);
        const vint8m1_t q2 = __riscv_vle8_v_i8m1(yb[2].qs, 32);
        const vint8m1_t q3 = __riscv_vle8_v_i8m1(yb[3].qs, 32);
        const vint8m1_t s0 = __riscv_vmerge_vvm_i8m1(__riscv_vneg_v_i8m1(q0, 32), q0, m0, 32);
        const vint8m1_t s1 = __riscv_vmerge_vvm_i8m1(__riscv_vneg_v_i8m1(q1, 32), q1, m1, 32);
        const vint8m1_t s2 = __riscv_vmerge_vvm_i8m1(__riscv_vneg_v_i8m1(q2, 32), q2, m2, 32);
        const vint8m1_t s3 = __riscv_vmerge_vvm_i8m1(__riscv_vneg_v_i8m1(q3, 32), q3, m3, 32);

        vint16m1_t gs       = __riscv_vwredsum_vs_i8m1_i16m1(s0, zero, 32);
        const vint16m1_t r1 = __riscv_vwredsum_vs_i8m1_i16m1(s1, zero, 32);
        const vint16m1_t r2 = __riscv_vwredsum_vs_i8m1_i16m1(s2, zero, 32);
        const vint16m1_t r3 = __riscv_vwredsum_vs_i8m1_i16m1(s3, zero, 32);

        // pack the four group sums into lanes 0..3 (no vector->scalar moves);
        // all slideups run at vl=4: lanes above each offset are overwritten by
        // the later slideups, so only lane `offset` of each survives
        gs = __riscv_vslideup_vx_i16m1(gs, r1, 1, 4);
        gs = __riscv_vslideup_vx_i16m1(gs, r2, 2, 4);
        gs = __riscv_vslideup_vx_i16m1(gs, r3, 3, 4);
        const vint32m2_t gs32 = __riscv_vsext_vf2_i32m2(gs, 4);
        const vfloat32m2_t dyf = lab_expand_fp16_x4((const uint16_t *)&yb[0].d, sizeof(block_q8_0));

        // facc += d0 * (dy .* group_sums)
        const vfloat32m2_t gsf = __riscv_vfcvt_f_x_v_f32m2(gs32, 4);
        facc = __riscv_vfmacc_vf_f32m2(facc, d0, __riscv_vfmul_vv_f32m2(gsf, dyf, 4), 4);
    }

    // ordered reduction: deterministic across implementations
    const vfloat32m1_t red = __riscv_vfredosum_vs_f32m2_f32m1(facc, __riscv_vfmv_v_f_f32m1(0.0f, 1), 4);
    *s = __riscv_vfmv_f_s_f32m1_f32(red);
}

// Variant for the vsim/FPGA shootout: vl=64 merges two groups per mask/merge
// (fewer instructions) at the price of slideup/slidedown data movement. QEMU
// charges per element and prefers vl512; real hardware may prefer this one.
NOINLINE void ggml_vec_dot_q1_0_q8_0_vl512w(const int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy) {
    const int qk = QK1_0;
    const int nb = n / qk;
    assert(n % qk == 0);

    const block_q1_0 * GGML_RESTRICT x = vx;
    const block_q8_0 * GGML_RESTRICT y = vy;

    //LMUL = 1, VLMAX = 64
    const size_t vl64 = __riscv_vsetvl_e8m1(64);
    assert(vl64 == 64);
    UNUSED(vl64);

    const vint16m1_t zero = __riscv_vmv_v_x_i16m1(0, 1);
    vfloat32m2_t facc = __riscv_vfmv_v_f_f32m2(0.0f, 4);

    for (int ib = 0; ib < nb; ++ib) {
        const float d0 = GGML_CPU_FP16_TO_FP32(x[ib].d);
        const block_q8_0 * GGML_RESTRICT yb = &y[ib * 4];

        const vint8m1_t q0 = __riscv_vle8_v_i8m1(yb[0].qs, 32);
        const vint8m1_t q1 = __riscv_vle8_v_i8m1(yb[1].qs, 32);
        const vint8m1_t q2 = __riscv_vle8_v_i8m1(yb[2].qs, 32);
        const vint8m1_t q3 = __riscv_vle8_v_i8m1(yb[3].qs, 32);

        const vbool8_t m01 = __riscv_vlm_v_b8(x[ib].qs, 64);
        const vbool8_t m23 = __riscv_vlm_v_b8(x[ib].qs + 8, 64);
        const vint8m1_t q01 = __riscv_vslideup_vx_i8m1(q0, q1, 32, 64);
        const vint8m1_t q23 = __riscv_vslideup_vx_i8m1(q2, q3, 32, 64);
        const vint8m1_t s01 = __riscv_vmerge_vvm_i8m1(__riscv_vneg_v_i8m1(q01, 64), q01, m01, 64);
        const vint8m1_t s23 = __riscv_vmerge_vvm_i8m1(__riscv_vneg_v_i8m1(q23, 64), q23, m23, 64);

        const vint8m1_t s1h = __riscv_vslidedown_vx_i8m1(s01, 32, 32);
        const vint8m1_t s3h = __riscv_vslidedown_vx_i8m1(s23, 32, 32);
        vint16m1_t gs       = __riscv_vwredsum_vs_i8m1_i16m1(s01, zero, 32);
        const vint16m1_t r1 = __riscv_vwredsum_vs_i8m1_i16m1(s1h, zero, 32);
        const vint16m1_t r2 = __riscv_vwredsum_vs_i8m1_i16m1(s23, zero, 32);
        const vint16m1_t r3 = __riscv_vwredsum_vs_i8m1_i16m1(s3h, zero, 32);

        // pack the four group sums into lanes 0..3 (no vector->scalar moves);
        // all slideups run at vl=4: lanes above each offset are overwritten by
        // the later slideups, so only lane `offset` of each survives
        gs = __riscv_vslideup_vx_i16m1(gs, r1, 1, 4);
        gs = __riscv_vslideup_vx_i16m1(gs, r2, 2, 4);
        gs = __riscv_vslideup_vx_i16m1(gs, r3, 3, 4);
        const vint32m2_t gs32 = __riscv_vsext_vf2_i32m2(gs, 4);
        const vfloat32m2_t dyf = lab_expand_fp16_x4((const uint16_t *)&yb[0].d, sizeof(block_q8_0));

        // facc += d0 * (dy .* group_sums)
        const vfloat32m2_t gsf = __riscv_vfcvt_f_x_v_f32m2(gs32, 4);
        facc = __riscv_vfmacc_vf_f32m2(facc, d0, __riscv_vfmul_vv_f32m2(gsf, dyf, 4), 4);
    }

    // ordered reduction: deterministic across implementations
    const vfloat32m1_t red = __riscv_vfredosum_vs_f32m2_f32m1(facc, __riscv_vfmv_v_f_f32m1(0.0f, 1), 4);
    *s = __riscv_vfmv_f_s_f32m1_f32(red);
}

NOINLINE void ggml_vec_dot_q1_0_q8_0_vl256(const int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy) {
    const int qk = QK1_0;
    const int nb = n / qk;
    assert(n % qk == 0);

    const block_q1_0 * GGML_RESTRICT x = vx;
    const block_q8_0 * GGML_RESTRICT y = vy;

    //LMUL = 1, VLMAX = 32
    const size_t vl32 = __riscv_vsetvl_e8m1(32);
    assert(vl32 == 32);

    const vint16m1_t zero = __riscv_vmv_v_x_i16m1(0, 1);

    float sumf = 0;

    for (int ib = 0; ib < nb; ++ib) {
        const float d0 = GGML_CPU_FP16_TO_FP32(x[ib].d);

        float acc = 0;

        for (int k = 0; k < 4; ++k) {
            const block_q8_0 * GGML_RESTRICT yb = &y[ib * 4 + k];
            const vbool8_t is_not_zero = __riscv_vlm_v_b8(x[ib].qs + 4 * k, vl32);

            const vint8m1_t qy = __riscv_vle8_v_i8m1(yb->qs, vl32);
            const vint8m1_t neg_qy = __riscv_vneg_v_i8m1(qy, vl32);
            const vint8m1_t sy = __riscv_vmerge_vvm_i8m1(neg_qy, qy, is_not_zero, vl32);

            const vint16m1_t red = __riscv_vwredsum_vs_i8m1_i16m1(sy, zero, vl32);
            acc += GGML_CPU_FP16_TO_FP32(yb->d) * (float)__riscv_vmv_x_s_i16m1_i16(red);
        }

        sumf += d0 * acc;
    }

    *s = sumf;
}

NOINLINE void ggml_vec_dot_q1_0_q8_0_vl128(const int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy) {
    const int qk = QK1_0;
    const int nb = n / qk;
    assert(n % qk == 0);

    const block_q1_0 * GGML_RESTRICT x = vx;
    const block_q8_0 * GGML_RESTRICT y = vy;

    //LMUL = 2, VLMAX = 32
    const size_t vl32 = __riscv_vsetvl_e8m2(32);
    assert(vl32 == 32);

    const vint16m1_t zero = __riscv_vmv_v_x_i16m1(0, 1);

    float sumf = 0;

    for (int ib = 0; ib < nb; ++ib) {
        const float d0 = GGML_CPU_FP16_TO_FP32(x[ib].d);

        float acc = 0;

        for (int k = 0; k < 4; ++k) {
            const block_q8_0 * GGML_RESTRICT yb = &y[ib * 4 + k];
            const vbool4_t is_not_zero = __riscv_vlm_v_b4(x[ib].qs + 4 * k, vl32);

            const vint8m2_t qy = __riscv_vle8_v_i8m2(yb->qs, vl32);
            const vint8m2_t neg_qy =__riscv_vneg_v_i8m2(qy, vl32);
            const vint8m2_t sy = __riscv_vmerge_vvm_i8m2(neg_qy, qy, is_not_zero, vl32);

            const vint16m1_t red = __riscv_vwredsum_vs_i8m2_i16m1(sy, zero, vl32);
            acc += GGML_CPU_FP16_TO_FP32(yb->d) * (float)__riscv_vmv_x_s_i16m1_i16(red);
        }

        sumf += d0 * acc;
    }

    *s = sumf;
}
#endif

void ggml_vec_dot_q1_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
#if defined(__riscv_v_intrinsic)
    assert(nrc == 1);

    const size_t vlen_bits = __riscv_vlenb() * 8;

    if (vlen_bits >= 512) {
        ggml_vec_dot_q1_0_q8_0_vl512(n, s, vx, vy);
    } else if (vlen_bits >= 256) {
        ggml_vec_dot_q1_0_q8_0_vl256(n, s, vx, vy);
    } else if (vlen_bits >= 128) {
        ggml_vec_dot_q1_0_q8_0_vl128(n, s, vx, vy);
    } else {
        ggml_vec_dot_q1_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
    }
#else
    ggml_vec_dot_q1_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
#endif
}
