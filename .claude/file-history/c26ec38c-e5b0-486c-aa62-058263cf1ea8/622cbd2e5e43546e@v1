// ISA probe for sim_ax45mpv_premium: exercises every vector op class the
// Q1_0 kernels need, WITHOUT zfh/zvfh. If this runs to the end, the kernels
// can run. Expected: VLEN=512 (vlenb=64), expand lane check 1 2 -0.5 0.
#include <stdio.h>
#include <stdint.h>
#include <riscv_vector.h>

int main(void) {
    printf("vlenb=%lu\n", (unsigned long)__riscv_vlenb());

    // integer path: vlm / vle8 / vneg / vmerge / vwredsum / vslideup
    int8_t a[32];
    uint8_t m[4] = {0xAA, 0xCC, 0xF0, 0x0F};
    for (int i = 0; i < 32; i++) a[i] = (int8_t)(i - 16);
    vbool8_t vm = __riscv_vlm_v_b8(m, 32);
    vint8m1_t va = __riscv_vle8_v_i8m1(a, 32);
    vint8m1_t vs = __riscv_vmerge_vvm_i8m1(__riscv_vneg_v_i8m1(va, 32), va, vm, 32);
    vint16m1_t z = __riscv_vmv_v_x_i16m1(0, 1);
    vint16m1_t r = __riscv_vwredsum_vs_i8m1_i16m1(vs, z, 32);
    vint16m1_t r2 = __riscv_vslideup_vx_i16m1(r, r, 1, 4);
    printf("int vector ok\n");

    // fp16 -> fp32 expand without zvfh: vlse16(u16) + zext + shift/add + FTZ
    uint16_t h[4] = {0x3C00, 0x4000, 0xB800, 0x0000}; // 1.0, 2.0, -0.5, 0.0
    vuint16m1_t vh = __riscv_vlse16_v_u16m1(h, 2, 4);
    vuint32m2_t hz = __riscv_vzext_vf2_u32m2(vh, 4);
    vuint32m2_t sign = __riscv_vsll_vx_u32m2(__riscv_vand_vx_u32m2(hz, 0x8000, 4), 16, 4);
    vuint32m2_t mag = __riscv_vadd_vx_u32m2(
        __riscv_vsll_vx_u32m2(__riscv_vand_vx_u32m2(hz, 0x7FFF, 4), 13, 4),
        (uint32_t)112 << 23, 4);
    vbool16_t ez = __riscv_vmseq_vx_u32m2_b16(__riscv_vand_vx_u32m2(hz, 0x7C00, 4), 0, 4);
    mag = __riscv_vmerge_vxm_u32m2(mag, 0, ez, 4);
    vfloat32m2_t df = __riscv_vreinterpret_v_u32m2_f32m2(__riscv_vor_vv_u32m2(sign, mag, 4));
    float dchk[4];
    __riscv_vse32_v_f32m2(dchk, df, 4);
    printf("expand: %f %f %f %f (expect 1 2 -0.5 0)\n",
           (double)dchk[0], (double)dchk[1], (double)dchk[2], (double)dchk[3]);

    // fp32 vector path: vsext / vfcvt / vfmul / vfmacc / vfredosum
    vint32m2_t gi = __riscv_vsext_vf2_i32m2(r2, 4);
    vfloat32m2_t gf = __riscv_vfcvt_f_x_v_f32m2(gi, 4);
    vfloat32m2_t acc = __riscv_vfmv_v_f_f32m2(0.0f, 4);
    acc = __riscv_vfmacc_vf_f32m2(acc, 2.0f, __riscv_vfmul_vv_f32m2(gf, df, 4), 4);
    vfloat32m1_t red = __riscv_vfredosum_vs_f32m2_f32m1(acc, __riscv_vfmv_v_f_f32m1(0.0f, 1), 4);
    printf("fp32 vector ok, out=%f\n", (double)__riscv_vfmv_f_s_f32m1_f32(red));

    printf("PROBE PASS\n");
    return 0;
}
