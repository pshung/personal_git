// Minimal Q1_0 shootout on vsim (sim_ax45mpv_premium, VLEN=512, ~6 kHz).
//
// Plan (and nothing else):
//   step 1: correctness - kernel 2 (vl256) bit-exact vs kernel 1 (scalar),
//           kernel 3 (gemv, repacked weights) close to kernel 1 (it fuses
//           mul+add, so tiny rounding diff is expected)
//   step 2: cycles - rdcycle around kernel 2 (per-row loop) and kernel 3
//           (one call), same data, same output size
//
// Shape: nr=64 rows x n=1024 cols = one 64-row strip of the K=51
// V-projection matmul (2560x1024). Exit code 0 = all checks passed.
#include "q1_0.h"

#include <math.h>
#include <stdio.h>
#include <string.h>

static unsigned long rdcycle(void) {
    unsigned long r;
    asm volatile("csrr %0, mcycle" : "=r"(r));
    return r;
}

#define GN  1024                 // K (columns)
#define GNR 64                   // rows
#define GNB (GN / QK1_0)         // 8 blocks per row

static block_q1_0      x[GNR * GNB];        // original row-major weights
static block_q1_0_64x1 bricks[GNB];         // repacked weights (kernel 3)
static block_q8_0      y[GN / QK8_0];       // activations
static float ref[GNR], out2[GNR], out3[GNR];

// deterministic data, ggml-like domain (q8 in [-127,127], safe scales)
static uint64_t rng_state = 0x243F6A8885A308D3ull;

static uint64_t rng_next(void) {
    rng_state ^= rng_state << 13;
    rng_state ^= rng_state >> 7;
    rng_state ^= rng_state << 17;
    return rng_state;
}

static uint16_t rand_fp16(float lo, float hi) {
    const float v = lo + (hi - lo) * ((rng_next() >> 11) * 0x1.0p-53f);
    return lab_fp32_to_fp16(v);
}

static uint32_t f32_bits(float f) {
    uint32_t w;
    memcpy(&w, &f, sizeof(w));
    return w;
}

int main(void) {
    printf("q1_0 minimal shootout: nr=%d n=%d\n", GNR, GN);

    for (int i = 0; i < GNR * GNB; ++i) {
        x[i].d = rand_fp16(-2.0f, 2.0f);
        for (int j = 0; j < QK1_0 / 8; ++j) x[i].qs[j] = (uint8_t)rng_next();
    }
    for (int i = 0; i < GN / QK8_0; ++i) {
        y[i].d = rand_fp16(0.001f, 1.0f);
        for (int j = 0; j < QK8_0; ++j) y[i].qs[j] = (int8_t)((int)(rng_next() % 255) - 127);
    }
    q1_0_repack_64x1(x, bricks, GNR, GN);

    // ---- step 1: correctness ----------------------------------------------
    int failed = 0;

    for (int r = 0; r < GNR; ++r) {
        q1_0_dot_scalar(GN, &ref[r],  x + (size_t)r * GNB, y);
        q1_0_dot_vl256 (GN, &out2[r], x + (size_t)r * GNB, y);
    }
    q1_0_gemv_64x1(GN, out3, bricks, y, GNR);

    for (int r = 0; r < GNR; ++r) {
        if (f32_bits(out2[r]) != f32_bits(ref[r])) {          // 2 vs 1: bit-exact
            if (failed < 3) printf("FAIL vl256 row=%d ref=%f got=%f\n", r, (double)ref[r], (double)out2[r]);
            failed++;
        }
        const float d = fabsf(out3[r] - ref[r]);              // 3 vs 1: fma tolerance
        if (d > 1e-4f * (fabsf(ref[r]) + 1.0f)) {
            if (failed < 6) printf("FAIL gemv  row=%d ref=%f got=%f\n", r, (double)ref[r], (double)out3[r]);
            failed++;
        }
    }
    printf("correctness: vl256 %s, gemv %s\n", failed ? "FAIL" : "bit-exact ok", failed ? "FAIL" : "ok");

    // ---- step 2: cycles (rep0 = cold caches, rep1 = warm) -----------------
    for (int rep = 0; rep < 2; ++rep) {
        const unsigned long t0 = rdcycle();
        for (int r = 0; r < GNR; ++r) {
            q1_0_dot_vl256(GN, &out2[r], x + (size_t)r * GNB, y);
        }
        const unsigned long t1 = rdcycle();
        q1_0_gemv_64x1(GN, out3, bricks, y, GNR);
        const unsigned long t2 = rdcycle();

        const unsigned long c2 = t1 - t0, c3 = t2 - t1;
        printf("rep%d: [2] vl256 x%d rows: %lu cyc (%lu/row) | [3] gemv: %lu cyc (%lu/row) | speedup %lu.%02lux\n",
               rep, GNR, c2, c2 / GNR, c3, c3 / GNR,
               c2 / c3, (c2 % c3) * 100ul / c3);
    }

    {
        const unsigned long t0 = rdcycle();
        q1_0_repack_64x1(x, bricks, GNR, GN);
        const unsigned long t1 = rdcycle();
        printf("repack (one-time): %lu cyc\n", t1 - t0);
    }

    printf(failed ? "FAILED (%d)\n" : "ALL PASS\n", failed);
    return failed;
}
