// Unit test for the HVM placement helpers (opt_roadmap F4: weights-in-HVM).
//
// Pure, host-testable logic only:
//   - ggml_hvm_bump:     bump-allocator arithmetic (alignment + overflow->NULL)
//   - ggml_hvm_selected: tensor-name selector (substring match, off when empty)
//
// The CSR-backed window discovery and the actual HVM store are RISC-V target
// only; they are validated by the in-model run (correct tokens) and the cycle
// measurement, not here.

#include "../ggml/src/ggml-cpu/hvm.h"

#include <cstdint>
#include <cstdio>

static int failures = 0;
#define CHECK(cond)                                                        \
    do {                                                                   \
        if (!(cond)) {                                                     \
            printf("FAIL line %d: %s\n", __LINE__, #cond);                 \
            ++failures;                                                    \
        }                                                                  \
    } while (0)

int main(void) {
    const uint64_t BASE = 0x90000000ull;

    // bump: aligns the offset up, then advances by size
    {
        uint64_t off = BASE + 8;            // deliberately misaligned
        void *   p   = ggml_hvm_bump(&off, BASE + 4096, 100, 64);
        CHECK(p == (void *) (uintptr_t) (BASE + 64));  // rounded up to 64
        CHECK(off == BASE + 64 + 100);                 // advanced past block
    }

    // bump: exact fit at the window end is allowed
    {
        uint64_t off = BASE;
        void *   p   = ggml_hvm_bump(&off, BASE + 128, 128, 64);
        CHECK(p == (void *) (uintptr_t) BASE);
        CHECK(off == BASE + 128);
    }

    // bump: overflow returns NULL and does NOT advance the offset
    {
        uint64_t off = BASE;
        void *   p   = ggml_hvm_bump(&off, BASE + 64, 65, 64);
        CHECK(p == NULL);
        CHECK(off == BASE);
    }

    // bump: empty window (end == 0) never allocates
    {
        uint64_t off = 0;
        CHECK(ggml_hvm_bump(&off, 0, 1, 64) == NULL);
    }

    // selector: exact and substring match relocate
    CHECK(ggml_hvm_selected("blk.7.attn_v.weight", "blk.7.attn_v.weight"));
    CHECK(ggml_hvm_selected("blk.7.attn_v.weight", "attn_v"));
    // selector: non-match, empty and NULL selector, NULL name -> off
    CHECK(!ggml_hvm_selected("blk.7.attn_q.weight", "attn_v"));
    CHECK(!ggml_hvm_selected("blk.7.attn_v.weight", ""));
    CHECK(!ggml_hvm_selected("blk.7.attn_v.weight", NULL));
    CHECK(!ggml_hvm_selected(NULL, "attn_v"));

    if (failures == 0) {
        printf("test-hvm-place: OK\n");
        return 0;
    }
    printf("test-hvm-place: %d check(s) FAILED\n", failures);
    return 1;
}
