// ISA acceptance probe for the premium RTL: tries each FP vector op class the
// Q1_0 gemv needs, at each LMUL, in ONE run. A private trap handler SKIPS
// illegal instructions (mepc += 4) and counts them, so every case reports
// "ok" or "TRAP" instead of the first trap killing the run.
#include <stdint.h>
#include <stdio.h>
#include <riscv_vector.h>

unsigned long probe_traps;   // bumped by the skip handler

__attribute__((naked, aligned(4))) void probe_trap_handler(void) {
    asm volatile(
        "addi  sp, sp, -16\n"
        "sd    t0, 0(sp)\n"
        "sd    t1, 8(sp)\n"
        "csrr  t0, mepc\n"
        "addi  t0, t0, 4\n"        // all probed insns are 4-byte
        "csrw  mepc, t0\n"
        "la    t1, probe_traps\n"
        "ld    t0, 0(t1)\n"
        "addi  t0, t0, 1\n"
        "sd    t0, 0(t1)\n"
        "ld    t0, 0(sp)\n"
        "ld    t1, 8(sp)\n"
        "addi  sp, sp, 16\n"
        "mret\n");
}

static unsigned long check(const char * name) {
    static unsigned long last;
    const unsigned long now = probe_traps;
    iprintf("%-28s %s\n", name, now == last ? "ok" : "TRAP");
    const unsigned long delta = now - last;
    last = now;
    return delta;
}

int main(void) {
    iprintf("probe: vlenb=%lu\n", (unsigned long)__riscv_vlenb());
    asm volatile("csrw mtvec, %0" :: "r"(probe_trap_handler));

    // vector FP always uses frm (dynamic rounding); an uninitialized/reserved
    // frm makes EVERY vector-FP op illegal while integer vector works fine.
    // The BSP crt0 enables mstatus.FS but never writes fcsr - do it here.
    asm volatile("csrw fcsr, zero");

    // scalar FP warm-up: drive mstatus.FS Initial -> Dirty before any vector
    // FP. Hypothesis: this RTL gates vector-FP on FS=Dirty (in the shootout,
    // vfmv.v.f passed only after the vl256 loop had run scalar FP).
    {   volatile float wf = 1.5f;
        wf = wf * 2.0f + 0.25f;
        (void)wf; }
    check("scalar FP warm-up");

    static int32_t  ibuf[64];
    static int16_t  sbuf[64];
    static float    fbuf[64];
    for (int i = 0; i < 64; ++i) { ibuf[i] = i - 32; sbuf[i] = (int16_t)(i - 32); fbuf[i] = 0; }

    // --- int -> float converts, single width, each LMUL ---------------------
    {   vint32m1_t s = __riscv_vle32_v_i32m1(ibuf, 16);
        vfloat32m1_t f = __riscv_vfcvt_f_x_v_f32m1(s, 16);
        __riscv_vse32_v_f32m1(fbuf, f, 16); }
    check("vfcvt.f.x.v m1");

    {   vint32m2_t s = __riscv_vle32_v_i32m2(ibuf, 32);
        vfloat32m2_t f = __riscv_vfcvt_f_x_v_f32m2(s, 32);
        __riscv_vse32_v_f32m2(fbuf, f, 32); }
    check("vfcvt.f.x.v m2");

    {   vint32m4_t s = __riscv_vle32_v_i32m4(ibuf, 64);
        vfloat32m4_t f = __riscv_vfcvt_f_x_v_f32m4(s, 64);
        __riscv_vse32_v_f32m4(fbuf, f, 64); }
    check("vfcvt.f.x.v m4");

    // --- widening int16 -> float32 ------------------------------------------
    {   vint16m1_t s = __riscv_vle16_v_i16m1(sbuf, 32);
        vfloat32m2_t f = __riscv_vfwcvt_f_x_v_f32m2(s, 32);
        __riscv_vse32_v_f32m2(fbuf, f, 32); }
    check("vfwcvt.f.x.v m1->m2");

    {   vint16m2_t s = __riscv_vle16_v_i16m2(sbuf, 64);
        vfloat32m4_t f = __riscv_vfwcvt_f_x_v_f32m4(s, 64);
        __riscv_vse32_v_f32m4(fbuf, f, 64); }
    check("vfwcvt.f.x.v m2->m4");

    // --- float arithmetic at m2 / m4 ----------------------------------------
    {   vfloat32m2_t a = __riscv_vfmv_v_f_f32m2(1.5f, 32);
        a = __riscv_vfmacc_vf_f32m2(a, 2.0f, a, 32);
        __riscv_vse32_v_f32m2(fbuf, a, 32); }
    check("vfmacc.vf m2");

    {   vfloat32m4_t a = __riscv_vfmv_v_f_f32m4(1.5f, 64);
        a = __riscv_vfmacc_vf_f32m4(a, 2.0f, a, 64);
        __riscv_vse32_v_f32m4(fbuf, a, 64); }
    check("vfmacc.vf m4");

    {   vfloat32m4_t a = __riscv_vfmv_v_f_f32m4(1.5f, 64);
        a = __riscv_vfmacc_vv_f32m4(a, a, a, 64);
        __riscv_vse32_v_f32m4(fbuf, a, 64); }
    check("vfmacc.vv m4");

    {   vfloat32m4_t a = __riscv_vfmv_v_f_f32m4(3.0f, 64);
        vfloat32m4_t b = __riscv_vfmv_v_f_f32m4(1.0f, 64);
        a = __riscv_vfsub_vv_f32m4(a, b, 64);
        __riscv_vse32_v_f32m4(fbuf, a, 64); }
    check("vfsub.vv m4");

    {   vfloat32m4_t a = __riscv_vfmv_v_f_f32m4(3.0f, 64);
        a = __riscv_vfsub_vf_f32m4(a, 1.0f, 64);
        __riscv_vse32_v_f32m4(fbuf, a, 64); }
    check("vfsub.vf m4");

    // sanity: a genuinely-supported op must NOT report TRAP
    {   vint32m4_t s = __riscv_vle32_v_i32m4(ibuf, 64);
        s = __riscv_vadd_vx_i32m4(s, 3, 64);
        __riscv_vse32_v_i32m4(ibuf, s, 64); }
    check("vadd.vx m4 (control)");

#if defined(__riscv_v)
    // --- ELEN=64 / FELEN=64 / packed-FP16 acceptance (premium_max probe) ----
    // only built with -march=rv64gcv (probe_max target)
    static int64_t lbuf[8];
    static double  dbuf[8];
    static uint16_t hbuf[16];
    for (int i = 0; i < 8; ++i) { lbuf[i] = i; dbuf[i] = 0; }

    {   vint64m1_t a = __riscv_vle64_v_i64m1(lbuf, 8);
        a = __riscv_vadd_vv_i64m1(a, a, 8);
        __riscv_vse64_v_i64m1(lbuf, a, 8); }
    check("vle64/vadd/vse64 e64 m1");

    {   vfloat64m1_t d = __riscv_vfmv_v_f_f64m1(1.5, 8);
        d = __riscv_vfadd_vv_f64m1(d, d, 8);
        __riscv_vse64_v_f64m1(dbuf, d, 8); }
    check("vfadd.vv f64 m1");

    // standard zvfh encoding: SEW=16 fp widen f16 -> f32. Tests whether the
    // PACKED_FP16 knob enables ratified-encoding fp16 ops or only xandes*.
    {   for (int i = 0; i < 16; ++i) hbuf[i] = 0x3C00; // fp16 1.0
        asm volatile(
            "vsetivli x0, 8, e16, m1, ta, ma\n"
            "vle16.v   v8, (%0)\n"
            "vfwcvt.f.f.v v10, v8\n"
            "vsetivli x0, 8, e32, m1, ta, ma\n"
            "vse32.v  v10, (%1)\n"
            :: "r"(hbuf), "r"(fbuf) : "v8", "v10", "v11", "memory"); }
    check("vfwcvt.f.f.v f16->f32 (zvfh)");
#endif

    iprintf("total traps: %lu\n", probe_traps);
    return 0;
}
