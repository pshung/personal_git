def env():
    d = {}
    p = os.path.join(W, "results.env")
    if os.path.exists(p):
        for ln in open(p):
            ln = ln.strip()
            if "=" in ln:
                k, v = ln.split("=", 1); d[k] = v
    return d

def readtail(fn, n=40, grep=None):
    p = os.path.join(W, fn)
    if not os.path.exists(p): return "(log not found: %s)\n" % fn
    lines = open(p, errors="replace").read().splitlines()
    if grep:
        rx = re.compile(grep)
        lines = [l for l in lines if rx.search(l)]
    if n and len(lines) > n: lines = ["... (%d lines above) ..." % (len(lines)-n)] + lines[-n:]
    return "\n".join(lines) + "\n"

def md(*src):    return {"cell_type": "markdown", "metadata": {}, "source": list(src)}
def code(src, out_text, ec):
    outs = []
    if out_text:
        outs = [{"output_type": "stream", "name": "stdout", "text": out_text}]
    return {"cell_type": "code", "execution_count": ec, "metadata": {}, "outputs": outs, "source": src}

