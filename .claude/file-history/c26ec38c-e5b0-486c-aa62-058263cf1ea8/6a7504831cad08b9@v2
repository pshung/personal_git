-include ../Make.var

CC:=$(TOOLCHAIN_PREFIX)gcc
OBJDUMP:=$(TOOLCHAIN_PREFIX)objdump
# no zfh/zvfh: ax45mpv_premium has neither (ELEN=32); fp16 scales are
# expanded with integer vector ops, fp32 math needs zve32f
CFLAGS:= -march=rv$(XLEN)gc_zve32f -O2 -ffp-contract=off -fno-tree-vectorize

# engines: premium = VLEN 512 (Make.var default), fpga_l3 = VLEN 1024
SIM_FPGA_L3 ?= /home/nick/work/vsim_andesim/build/sim_ax46mpv_fpga_l3

all: test_q1_0 test_q1_0_v1024 test_q1_0.dump

# gemv built for VLEN=512 (i16m2/f32m4) - run on sim_ax45mpv_premium
test_q1_0: main.c q1_0.c q1_0.h
	$(CC) $(filter %.c,$^) -o $@ $(VSIM_FILES) $(CFLAGS) $(VSIM_FLAGS) $(VSIM_OPTIMIZE)

# gemv built for VLEN=1024 (i16m1/f32m2) - run on sim_ax46mpv_fpga_l3.
# NO 'c' in march: ax46mpv has Zca/Zcb/Zcmp/Zcmt but no Zcd (Zcmp reuses the
# c.fsdsp/c.fldsp encodings), so compressed FP stores trap illegal there.
test_q1_0_v1024: main.c q1_0.c q1_0.h
	$(CC) $(filter %.c,$^) -o $@ -DQ1_VLEN=1024 $(VSIM_FILES) $(CFLAGS) -march=rv$(XLEN)g_zve32f $(VSIM_FLAGS) $(VSIM_OPTIMIZE)

test_q1_0.dump: test_q1_0
	$(OBJDUMP) $< -d > $@

run: test_q1_0
	$(SIMULATOR_BIN) $<

run-1024: test_q1_0_v1024
	$(SIM_FPGA_L3) $<

clean:
	- rm -f test_q1_0 test_q1_0_v1024 probe *.o *.dump

.PHONY: clean all run run-1024
