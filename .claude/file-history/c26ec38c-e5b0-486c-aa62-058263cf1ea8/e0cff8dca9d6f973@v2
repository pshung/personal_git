#!/usr/bin/env bash
# Fast-mode bit-exact correctness check for the reproduce runbook
# (q1_0_hvm_reproduce.md): run the HVM binary and the no-HVM (repack) binary
# under andesim --mode fast (HVM backed via -readconfig, no cycle leg), greedy,
# same prompt, and confirm the generated text is byte-identical. Minutes, not
# hours. Override via env LLAMA / ANDESIM / MODEL / ENGINE.
set -e
export TMPDIR=${TMPDIR:-/home/nick/tmp}
LLAMA=${LLAMA:-/home/nick/work/llama.cpp}
ANDESIM=${ANDESIM:-/home/nick/work/andesim}
MODEL=${MODEL:-$LLAMA/models/Bonsai-4B-Q1_0.gguf}
ENGINE=${ENGINE:-vsim:ax46mpv_fpga_l3}

gen() {  # $1 = binary -> its generated continuation line
  ( cd "$ANDESIM" && ./andesim run --mode fast --runtime linux --mem-size 2000M \
      --engine "$ENGINE" "$1" -- -m "$MODEL" -no-cnv \
      --prompt "The capital of France is" -n 16 -c 512 -t 1 --temp 0 ) 2>&1 \
    | grep 'The capital of France' | head -1
}
H=$(gen "$LLAMA/bin-hvm")
B=$(gen "$LLAMA/bin-repack")
echo "HVM : $H"
echo "BASE: $B"
[ -n "$H" ] && [ "$H" = "$B" ] && echo "PASS: HVM output is bit-identical to no-HVM" \
  || { echo "FAIL: outputs differ (or empty)"; exit 1; }
