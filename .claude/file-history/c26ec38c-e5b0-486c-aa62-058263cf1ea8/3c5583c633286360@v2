// HVM (Andes high-bandwidth vector memory) bump allocator.
// Same CSR discovery flow as ../ace-tq1/hvm_util.c (the proven original),
// but printf-free: this lab must stay stdio-free (fpga_l3 hangs on stdio).
//   NDS_MHVMB    (0xFD1) = HVM base address
//   NDS_MHVM_CFG (0xFD0) bits [7:0] = log2(HVM size in bytes)
// No free. Returns NULL on overflow so main can report and bail.
#pragma once

#include <stdint.h>
#include <stddef.h>

static inline uint64_t hvm_csr_cfg(void)  { uint64_t v; asm volatile("csrr %0, 0xFD0" : "=r"(v)); return v; }
static inline uint64_t hvm_csr_base(void) { uint64_t v; asm volatile("csrr %0, 0xFD1" : "=r"(v)); return v; }

static uint64_t hvm_off_, hvm_end_;

static inline void * malloc_hvm(size_t size, size_t align) {
    if (hvm_off_ == 0) {
        hvm_off_ = hvm_csr_base();
        hvm_end_ = hvm_off_ + (1ULL << (hvm_csr_cfg() & 0xFF));
    }
    hvm_off_ = (hvm_off_ + align - 1) & ~(uint64_t)(align - 1);
    void * p = (void *)hvm_off_;
    hvm_off_ += size;
    return hvm_off_ <= hvm_end_ ? p : (void *)0;
}
