// Subprocess helpers for andes-sim.
//
// run_process spawns a child, captures its stdout, and kills it after a
// timeout -- the primitive the engine registry uses to ask `<bin> --describe`
// and the plan executor (F6) uses to run orchestrated legs. F5 extends this
// file with exec_passthrough (inherit stdio, no timeout) for fast/cycle.
#ifndef ANDES_SIM_PROCESS_HPP
#define ANDES_SIM_PROCESS_HPP

#include <string>
#include <vector>

namespace andes_sim {

struct RunResult {
  int rc = -1;                // child exit status, or -1 if killed/abnormal
  std::string out;            // captured stdout
  bool timed_out = false;     // killed because it exceeded the timeout
  bool spawn_failed = false;  // pipe/fork failed before the child ran
};

// Run argv (argv[0] resolved via PATH), capturing stdout. The child's stdin
// and stderr are redirected to /dev/null. If the child runs longer than
// timeout_ms it is SIGKILLed and timed_out is set.
RunResult run_process(const std::vector<std::string>& argv, int timeout_ms);

// Run argv to completion with the child INHERITING this process's stdout and
// stderr (its output streams straight to the terminal) and stdin from
// /dev/null; chdir to `cwd` first if non-empty. No capture, no timeout. Returns
// the child's exit code, 128+signal if it was signalled, or -1 on spawn
// failure. Used by `build` to delegate to setup.sh / build_*.sh / make.
int run_inherit(const std::vector<std::string>& argv, const std::string& cwd);

// Run argv to completion with the child INHERITING all three std streams
// (stdin, stdout, stderr) -- the transparent-passthrough mechanism behind
// `run --model fast|cycle`: the engine reads/writes the terminal directly,
// so an interactive gdbstub or semihosting console works unchanged. No chdir,
// no capture, no timeout. Returns the child's exit code, 128+signal if it was
// signalled, or -1 on spawn failure / empty argv.
int exec_passthrough(const std::vector<std::string>& argv);

}  // namespace andes_sim

#endif  // ANDES_SIM_PROCESS_HPP
