/* Minimal syscalls for a pure-vsim build (no libgloss_vh / no semihosting).
 *
 * vsim has its own console: the SimControl device (verilator/src/platform/
 * sim_control.hpp) at SIM_CONTROL_BASE.  A 1-byte write to offset 0x4 does a
 * host putchar; a <256 value written to offset 0x0 ends the run with that
 * exit code.  Routing _write/_exit there lets printf work on vsim with no
 * semihosting trap.  -lnosys supplies the remaining stubs (_read/_close/...).
 */
#define SIM_CONTROL_BASE 0xE0080000UL
#define SIM_PUTCHAR (*(volatile unsigned char *)(SIM_CONTROL_BASE + 0x4))
#define SIM_COMMAND (*(volatile unsigned int  *)(SIM_CONTROL_BASE + 0x0))

int _write(int file, char *ptr, int len)
{
  (void)file;
  for (int i = 0; i < len; i++)
    SIM_PUTCHAR = (unsigned char)ptr[i];
  return len;
}

void _exit(int code)
{
  SIM_COMMAND = (unsigned)(code & 0xff);   /* offset 0x0, <256 -> exits=code */
  for (;;) { }
}

void *_sbrk(int incr)
{
  static char heap[64 * 1024];
  static char *cur = heap;
  char *prev = cur;
  if (cur + incr > heap + sizeof(heap))
    return (void *)-1;
  cur += incr;
  return prev;
}
