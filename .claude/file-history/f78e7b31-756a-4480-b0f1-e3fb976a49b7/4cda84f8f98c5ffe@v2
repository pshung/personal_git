// Standalone extraction of the Q1_0 x Q8_0 vec_dot kernels for isolated
// build and verification. Code is copied verbatim from:
//   ggml/src/ggml-cpu/quants.c:127            ggml_vec_dot_q1_0_q8_0_generic
//   ggml/src/ggml-cpu/arch/riscv/quants.c:484 vl256/vl128 kernels + dispatcher
//   ggml/src/ggml-common.h:180                block layouts
//   ggml/src/ggml-impl.h                      exact fp16<->fp32 (table-free)
#pragma once

#include <stdint.h>
#include <stddef.h>

#define GGML_RESTRICT restrict

#define QK1_0 128
#define QK8_0 32

typedef uint16_t ggml_half;

typedef struct {
    ggml_half d;                // scale
    uint8_t   qs[QK1_0 / 8];   // sign bits: 1 -> +1, 0 -> -1
} block_q1_0;

typedef struct {
    ggml_half d;                // scale
    int8_t    qs[QK8_0];        // quants, ggml quantizer emits [-127, 127]
} block_q8_0;

_Static_assert(sizeof(block_q1_0) == sizeof(ggml_half) + QK1_0 / 8, "wrong q1_0 block size");
_Static_assert(sizeof(block_q8_0) == sizeof(ggml_half) + QK8_0,     "wrong q8_0 block size");

// ---- F4: row-parallel Nx1 repack (see q1_0_rvv_tutorial.md section 5) ------
// 64 rows x 128 cols per brick, sign planes stored column-major so column c's
// 64 bits load as one vlm mask. Same bytes as 64 block_q1_0, transposed.

#define Q1_NX1_N 64  // rows per brick; fp32 lanes: VLEN=512 m4 / VLEN=1024 m2

typedef struct {
    ggml_half d[Q1_NX1_N];                 // per-row scales
    uint8_t   qs[QK1_0][Q1_NX1_N / 8];     // [column][row bits], 8 bytes/column
} block_q1_0_64x1;

_Static_assert(sizeof(block_q1_0_64x1) == Q1_NX1_N * sizeof(block_q1_0),
               "repack must not change total size");

// ---- F5: software prefetch distance (see q1_0.c) ---------------------------
// How many bricks ahead the RVV gemv pulls into cache. 0 disables. Override at
// build time: make rv64 PFDIST=n. Kept in the header so the harness can report
// and A/B the value the kernels were built with.
#ifndef Q1_PREFETCH_DIST
#define Q1_PREFETCH_DIST 1
#endif

// src: nr rows x (n/128) blocks, row-major. dst: (nr/64) groups x (n/128)
// bricks, group-major. nr % 64 == 0, n % 128 == 0.
void repack_q1_0_to_q1_0_64x1(const block_q1_0 * GGML_RESTRICT src,
                              block_q1_0_64x1 * GGML_RESTRICT dst, int nr, int n);

// s[r] = dot(weight row r, y) for r in 0..nr-1. vx = bricks from the repack.
// _generic keeps the exact float-op order of ggml_vec_dot_q1_0_q8_0_generic,
// so its result is bit-exact vs calling that per row on the original data.
void gemv_q1_0_64x1_q8_0_generic(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr);
void gemv_q1_0_64x1_q8_0        (int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr);

float    lab_fp16_to_fp32(uint16_t h);
uint16_t lab_fp32_to_fp16(float f);

void ggml_vec_dot_q1_0_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc);
void ggml_vec_dot_q1_0_q8_0        (int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc);

// non-static in the lab so the harness can test/bench each kernel directly;
// restore `static` when pasting back into ggml
#if defined(__riscv_v_intrinsic)
void ggml_vec_dot_q1_0_q8_0_vl256 (int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy);
void ggml_vec_dot_q1_0_q8_0_vl128 (int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy);
// F4b row-parallel RVV gemv: i16/f32 LMUL picked so 64 lanes exactly fill.
// _nopf = same kernel with the F5 prefetch compiled out (dist 0); lab-only, so
// one binary can A/B "is the prefetch a pure hint" and "what does it cost".
void gemv_q1_0_64x1_q8_0_vl512      (int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr); // i16m2/f32m4
void gemv_q1_0_64x1_q8_0_vl1024     (int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr); // i16m1/f32m2
void gemv_q1_0_64x1_q8_0_vl512_nopf (int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr);
void gemv_q1_0_64x1_q8_0_vl1024_nopf(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr);
#endif
