TEST_CASE("Andes v3 / F3: resume restores PMA (pmaaddr0..15 + even pmacfg), "
          "every addr before any cfg")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_ANDES;
  for (int i = 0; i < HYBRID_PMA_CFG_NUM; ++i)  s.andes.pmacfg[i]  = 0xC0 + i;
  for (int i = 0; i < HYBRID_PMA_ADDR_NUM; ++i) s.andes.pmaaddr[i] = 0xD000 + i;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  std::vector<uint16_t> wr;
  for (const auto& op : bus.ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && ((op.value >> 16) & 1u))
      wr.push_back(static_cast<uint16_t>(op.value & 0xffffu));

  // pmaaddr0..15 = 0xBD0..0xBDF ; pmacfg slots map to even CSRs 0xBC0, 0xBC2.
  std::size_t first_cfg = wr.size(), last_addr = 0, n_addr = 0, n_cfg = 0;
  for (std::size_t i = 0; i < wr.size(); ++i) {
    const uint16_t r = wr[i];
    if (r >= 0xBD0 && r <= 0xBDF) { ++n_addr; last_addr = i; }
    if (r == 0xBC0 || r == 0xBC2) { ++n_cfg; if (i < first_cfg) first_cfg = i; }
  }
  CHECK(n_addr == 16u);
  CHECK(n_cfg == 2u);
  CHECK(last_addr < first_cfg);  // addr before cfg (mirror PMP ordering)
}

TEST_CASE("Andes caps: resume skips the CSRs the target core lacks (no hang "
          "on absent ucode/mecc_code) but still restores the supported ones")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_ANDES;
  uint64_t v = 0xB00000000ULL;
#define X(field, addr, name) s.andes.field = v++;
  HYBRID_ANDES_CSR_LIST(X)
#undef X
  for (int i = 0; i < HYBRID_PMA_ADDR_NUM; ++i) s.andes.pmaaddr[i] = 0xD000 + i;

  // ax45mpv_premium: CoDense + ILM + DLM only (DSP/ECC/PowerBrake/StackSafe/
  // perf-monitor/PMA off), matching its config.inc + the empirical probe.
  hybrid::AndesCaps premium = hybrid::AndesCaps::none();
  premium.set(hybrid::AndesGate::CODENSE);
  premium.set(hybrid::AndesGate::ILM);
  premium.set(hybrid::AndesGate::DLM);

  hybrid::ResumeDriver driver(bus, kScratch, premium);
  driver.resume(s);

  const auto ns = cmd_regnos(bus.ops);
  // Absent on premium -> must NOT be written (ucode + mecc_code are the hang
  // cases; an abstract write to an unimplemented CSR stalls the DM handshake).
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x801)));  // ucode (DSP off)
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x7C2)));  // mecc_code (ECC off)
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x7C5)));  // mpft_ctl
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x7C6)));  // mhsp_ctl
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0xBD0)));  // pmaaddr0 (PMA off)
  // Present on premium -> still restored.
  CHECK(contains_regno(ns, hybrid::regno_csr(0x800)));        // uitb  (CoDense)
  CHECK(contains_regno(ns, hybrid::regno_csr(0x7C0)));        // milmb (ILM)
  CHECK(contains_regno(ns, hybrid::regno_csr(0x7C4)));        // mxstatus (always)
}

