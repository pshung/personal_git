// ---- v5: L2C MMIO config restore ------------------------------------------
// The writable L2C config registers are written back via Program-Buffer word
// stores (`sw x5, 0(x6)`), gated on HYBRID_FLAG_L2C AND the engine actually
// having an L2C (set_l2c). A store to an absent L2C region would fault the
// Program Buffer, so an engine without one must issue nothing.

static std::size_t count_progbuf_insn(const std::vector<DmiOp>& ops, uint32_t insn)
{
  std::size_t n = 0;
  for (const auto& op : ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == hybrid::kProgbuf0
        && op.value == insn)
      ++n;
  return n;
}

