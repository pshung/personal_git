TEST_CASE("CSR restore is Abstract-Command-only: every Andes+M-ext CSR gets "
          "its own abstract write, never a Program-Buffer batch (the legacy "
          "PB csr_sweep restore path was removed -- it could not tolerate a "
          "cmderr on one CSR without corrupting the rest of the batch)")
{
  RecordingBus bus;
  bus.dmstatus_value   = (1u << 9) | (1u << 17);
  bus.abstractcs_value = 8u << 24;  // progbufsize=8: a batch would fit here

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_ANDES | HYBRID_FLAG_M_EXT;
  s.vlenb = 0;  // no V/FPR/GPR PB traffic: isolate the CSR restore path
  uint64_t v = 0xA00000000ULL;
#define X(field, addr, name) s.andes.field = v++;
  HYBRID_ANDES_CSR_LIST(X)
#undef X
#define X(field, addr, name) s.m_ext.field = v++;
  HYBRID_M_EXT_CSR_LIST(X)
#undef X

  hybrid::ResumeDriver driver(bus, kScratch);  // caps default all()
  driver.resume(s);

  // Expected supported addr list, canonical order (single source of truth).
  std::vector<uint16_t> addrs;
  hybrid::for_each_sweep_csr(s, hybrid::AndesCaps::all(),
    [&](std::size_t, uint16_t addr, const uint64_t&) { addrs.push_back(addr); });
  REQUIRE(!addrs.empty());

  // (a) every supported CSR got its own abstract write-COMMAND.
  const auto ns = cmd_regnos(bus.ops);
  for (uint16_t a : addrs) CHECK(contains_regno(ns, hybrid::regno_csr(a)));

  // (b) no Program-Buffer execution occurred at all -- with no V/FPR/GPR
  // block-load active, the only possible PB user would have been a CSR sweep.
  for (const auto& op : bus.ops)
    CHECK_FALSE((op.kind == DmiOp::Kind::Write && op.reg == kCommand
                 && op.value == hybrid::kExecProgbufCmd));
}

TEST_CASE("LG1: reset-baseline gating skips tolerant CSR writes whose drained "
          "value equals the engine reset value, still restores differing ones")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_ANDES | HYBRID_FLAG_M_EXT;
  uint64_t v = 0xA00000000ULL;
#define X(field, addr, name) s.andes.field = v++;
  HYBRID_ANDES_CSR_LIST(X)
#undef X
#define X(field, addr, name) s.m_ext.field = v++;
  HYBRID_M_EXT_CSR_LIST(X)
#undef X
  for (int i = 0; i < HYBRID_PMA_ADDR_NUM; ++i) s.andes.pmaaddr[i] = 0xD000 + i;
  for (int i = 0; i < HYBRID_PMA_CFG_NUM; ++i)  s.andes.pmacfg[i]  = 0xC0 + i;
  s.mtvec = 0x2000; s.mscratch = 0x31; s.mepc = 0x11; s.mcause = 0x2;
  s.mtval = 0x9; s.mie = 0x888; s.mip = 0x80; s.mcache_ctl = 0x3;
  s.mmisc_ctl = 0x48;

  // Baseline = the engine's own reset-state drain. Equal everywhere EXCEPT
  // uitb and mcache_ctl (the program wrote those before the handoff), so
  // only those two writes still change hart state.
  hybrid_state_v1 baseline = s;
  s.andes.uitb = 0xBEEF0;
  s.mcache_ctl = 0x10003;

  hybrid::ResumeDriver driver(bus, kScratch);  // caps default all()
  driver.set_reset_baseline(baseline);
  driver.resume(s);

  const auto ns = cmd_regnos(bus.ops);
  // Differing values must still be restored.
  CHECK(contains_regno(ns, hybrid::regno_csr(0x800)));   // uitb
  CHECK(contains_regno(ns, hybrid::regno_csr(0x7CA)));   // mcache_ctl
  // Values already equal to the engine reset value: the write is a no-op,
  // each elided abstract command saves hundreds of simulated cycles.
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x7C4)));  // mxstatus (Andes)
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x30A)));  // menvcfg (M-ext)
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0xBD0)));  // pmaaddr0
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0xBC0)));  // pmacfg0
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x341)));  // mepc
  CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(0x305)));  // mtvec

  // Skip count = every gated write except the two that differed.
  std::size_t total = 9;  // mtvec mscratch mepc mcause mtval mie mip
                          // mcache_ctl mmisc_ctl
#define X(field, addr, name) ++total;
  HYBRID_ANDES_CSR_LIST(X)
  HYBRID_M_EXT_CSR_LIST(X)
#undef X
  total += HYBRID_PMA_ADDR_NUM + HYBRID_PMA_CFG_NUM;
  CHECK(driver.baseline_skip_count() == total - 2);
}

