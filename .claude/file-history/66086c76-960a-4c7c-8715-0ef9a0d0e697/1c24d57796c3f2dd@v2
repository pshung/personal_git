  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_L2C;
  s.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0x1;  // DS220 11.8.7: CEN=1

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.set_l2c(/*present=*/true, /*base=*/0xE0500000ull);
  driver.resume(s);

  // Each config-register store is `sw x5, 0(x6)` in the Program Buffer.
  // Control + HPM Control + Way Allocation Masks = the writable config set.
  const uint32_t sw = hybrid::encode_sw(5, 6, 0);
  CHECK(count_progbuf_insn(bus.ops, sw) == 2u + HYBRID_L2C_WAYMASK_NUM);

  // The control register's address (base + 0x0008) and value (CEN=1) were
  // staged into scratch GPRs via DATA0.
  const auto d0 = find_write(bus.ops, kData0);
  bool addr_staged = false, val_staged = false;
  for (auto v : d0) {
    if (v == 0xE0500008u) addr_staged = true;
    if (v == 0x1u)        val_staged  = true;
  }
  CHECK(addr_staged);
  CHECK(val_staged);
}

TEST_CASE("resume issues NO L2C store when the engine has no L2C (default)")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_L2C;                     // producer had an L2C ...
  s.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0x1;

  hybrid::ResumeDriver driver(bus, kScratch);
  // ... but set_l2c is NOT called: this engine lacks an L2C region. A store
  // there would fault the Program Buffer, so the restore must be skipped.
  driver.resume(s);

  CHECK(count_progbuf_insn(bus.ops, hybrid::encode_sw(5, 6, 0)) == 0u);
}

TEST_CASE("resume issues NO L2C store when HYBRID_FLAG_L2C is clear")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);   // flag clear: block not live

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.set_l2c(/*present=*/true, /*base=*/0xE0500000ull);
  driver.resume(s);

  CHECK(count_progbuf_insn(bus.ops, hybrid::encode_sw(5, 6, 0)) == 0u);
}

// ---- v6: CSR write-mask gating -------------------------------------------
// When the handoff carries HYBRID_FLAG_WRITE_MASK, a mask-governed config CSR
// is restored ONLY if the producer's guest actually wrote it. An untouched
// CSR's drained value is just the producer's reset default -- restoring it
// would overwrite the engine's OWN reset value (msp_bound all-ones vs 0,
// milmb.IEN 0 vs 1, ...). Flag clear = pre-v6 file = restore everything.

TEST_CASE("v6: with a write-mask, only written Andes/M-ext CSRs are restored")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_ANDES | HYBRID_FLAG_M_EXT | HYBRID_FLAG_WRITE_MASK;
  s.andes.mxstatus = 0x11;   // written by the guest
  s.andes.mpft_ctl = 0x22;   // NOT written: producer reset default only
  s.m_ext.menvcfg  = 0x33;   // written by the guest
  s.m_ext.mseccfg  = 0x44;   // NOT written
  s.andes.pmaaddr[0] = 0x55; // written
  s.andes.pmaaddr[1] = 0x66; // NOT written
  s.mcache_ctl = 0x77;       // NOT written
  hybrid_wm_set(s.write_mask, HYBRID_WM_ANDES_BASE + HYBRID_WM_ANDES_IDX_mxstatus);
  hybrid_wm_set(s.write_mask, HYBRID_WM_M_EXT_BASE + HYBRID_WM_M_EXT_IDX_menvcfg);
  hybrid_wm_set(s.write_mask, HYBRID_WM_PMAADDR_BASE + 0);

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  const auto ns = cmd_regnos(bus.ops);
  CHECK(contains_regno(ns, hybrid::regno_csr(0x7C4)));    // mxstatus written
  CHECK(!contains_regno(ns, hybrid::regno_csr(0x7C5)));   // mpft_ctl skipped
  CHECK(contains_regno(ns, hybrid::regno_csr(0x30A)));    // menvcfg written
  CHECK(!contains_regno(ns, hybrid::regno_csr(0x747)));   // mseccfg skipped
  CHECK(contains_regno(ns, hybrid::regno_csr(0xBD0)));    // pmaaddr0 written
  CHECK(!contains_regno(ns, hybrid::regno_csr(0xBD1)));   // pmaaddr1 skipped
  CHECK(!contains_regno(ns, hybrid::regno_csr(0x7CA)));   // mcache_ctl skipped
}

TEST_CASE("v6: without HYBRID_FLAG_WRITE_MASK every governed CSR restores (pre-v6 files)")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_ANDES | HYBRID_FLAG_M_EXT;  // no write-mask flag
  s.andes.mpft_ctl = 0x22;
  s.m_ext.mseccfg  = 0x44;
  s.mcache_ctl     = 0x77;
  // write_mask bytes all zero -- must be IGNORED when the flag is clear.

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  const auto ns = cmd_regnos(bus.ops);
  CHECK(contains_regno(ns, hybrid::regno_csr(0x7C5)));   // mpft_ctl restored
  CHECK(contains_regno(ns, hybrid::regno_csr(0x747)));   // mseccfg restored
  CHECK(contains_regno(ns, hybrid::regno_csr(0x7CA)));   // mcache_ctl restored
}
