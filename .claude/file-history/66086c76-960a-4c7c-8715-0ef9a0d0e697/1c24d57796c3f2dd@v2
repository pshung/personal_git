  s.vl = 0;
  const hybrid_state_v1 baseline = s;
  s.vreg[5] = 0x77;  // one live byte -> the data sweep must run

  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);
  hybrid::ResumeDriver driver(bus, kScratch);
  driver.set_reset_baseline(baseline);
