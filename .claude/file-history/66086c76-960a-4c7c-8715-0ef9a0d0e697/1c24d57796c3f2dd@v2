TEST_CASE("resume with HYBRID_FLAG_V: PB reload sweeps v0..v31 from scratch "
          "before the architectural V-CSR restore and counter restore")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags  |= HYBRID_FLAG_V;
  s.vlenb  = 64;
  s.vl     = 16;
  s.vtype  = 0xC1;   // differs from the sweep's e8/m8 vtype (0xC3)
  s.vstart = 7;

  // L26: the scratch GPA is the runtime top-of-mmap value (kScratch), passed
  // to the driver -- no longer a fixed constant. Assert the sweep stages it.
  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  // (a) all 32 registers are reloaded as 4 LMUL=8 groups: one vle8.v per group
  //     base (v0/v8/v16/v24) covers 8 registers. The 4 loads land in any slot
  //     of the single grouped Program-Buffer execution.
  auto in_progbuf = [](const DmiOp& op, uint32_t insn) {
    return op.kind == DmiOp::Kind::Write
           && op.reg >= hybrid::kProgbuf0
           && op.reg <= hybrid::kProgbuf0 + hybrid::kProgbufMaxInsns
           && op.value == insn;
  };
  std::vector<int> missing;
  std::optional<std::size_t> first_vle_idx, last_vle_idx;
  for (uint16_t g = 0; g < 32; g += 8) {
    const uint32_t want = hybrid::encode_vle8_v(static_cast<uint8_t>(g), 7);
    std::optional<std::size_t> at;
    for (std::size_t i = 0; i < bus.ops.size(); ++i)
      if (in_progbuf(bus.ops[i], want)) { at = i; break; }
    if (!at) { missing.push_back(g); continue; }
    if (!first_vle_idx || *at < *first_vle_idx) first_vle_idx = at;
    if (!last_vle_idx  || *at > *last_vle_idx)  last_vle_idx  = at;
  }
  CHECK(missing.empty());
  REQUIRE(first_vle_idx.has_value());
  REQUIRE(last_vle_idx.has_value());

  // (b) batched sweep: the base pointer x7 is staged via a SINGLE abstract
  //     write (the scratch base); the in-buffer addi advances it per register,
  //     so there is no per-register x7 abstract write.
  auto x7_gpa_staged = [&](uint64_t gpa) {
    for (std::size_t i = 2; i < bus.ops.size(); ++i) {
      const auto& op = bus.ops[i];
      if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
          && (op.value & 0xFFFFu) == hybrid::regno_gpr(7)
          && ((op.value >> 16) & 1u)) {
        const auto& d0 = bus.ops[i - 2];
        const auto& d1 = bus.ops[i - 1];
        if (d0.reg == kData0 && d0.value == uint32_t(gpa & 0xFFFFFFFFu)
            && d1.reg == kData1 && d1.value == uint32_t(gpa >> 32))
          return true;
      }
    }
    return false;
  };
  // The base is staged once; the per-register scratch GPAs the OLD sweep poked
  // into x7 are gone -- the in-buffer addi advances x7 one LMUL=8 group
  // (8*vlenb bytes) at a time. (A second x7 write does occur, but from the
  // later architectural GPR restore, not from the sweep.)
  CHECK(x7_gpa_staged(kScratch));
  CHECK(!x7_gpa_staged(kScratch + 1ull * HYBRID_VLEN_BYTES_MAX));
  CHECK(!x7_gpa_staged(kScratch + 31ull * HYBRID_VLEN_BYTES_MAX));
  bool addi_in_pb = false;
  for (const auto& op : bus.ops)
    if (in_progbuf(op, hybrid::encode_addi(7, 7, 8 * static_cast<int32_t>(s.vlenb))))
      { addi_in_pb = true; break; }
  CHECK(addi_in_pb);

  // (c)/(d) the sweep runs before the architectural vstart restore (whose
  //     vsetvl would otherwise be clobbered) and before the mcycle restore
  //     (so the vle8.v insns cannot pollute the resumed counters).
  std::optional<std::size_t> vstart_cmd_idx, mcycle_cmd_idx;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind != DmiOp::Kind::Write || op.reg != kCommand) continue;
    const auto regno = static_cast<uint16_t>(op.value & 0xFFFFu);
    if (!vstart_cmd_idx && regno == hybrid::regno_csr(0x008)) vstart_cmd_idx = i;
    if (!mcycle_cmd_idx && regno == hybrid::regno_csr(0xB00)) mcycle_cmd_idx = i;
  }
  REQUIRE(vstart_cmd_idx.has_value());
  REQUIRE(mcycle_cmd_idx.has_value());
  CHECK(*last_vle_idx < *vstart_cmd_idx);
  CHECK(*last_vle_idx < *mcycle_cmd_idx);
}

TEST_CASE("resume restores GPRs and FPRs via abstract writes only -- no PB "
          "load-sweep, even when the V region leaves scratch room")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);  // halted + resumeack
  bus.abstractcs_value = 8u << 24;              // progbufsize = 8 (this DM)

  auto s = rv64_state(0x80001000, 0);
  s.flags  |= HYBRID_FLAG_FP;
  s.mstatus = 0x6000ULL;  // FS = Dirty: FPRs writable
  for (uint16_t i = 1; i < 32; ++i) s.gpr[i] = 0xB0000000ULL + i;
  for (int i = 0; i < 32; ++i)      s.fpr[i] = 0xF0000000ULL + i;
  s.vlenb = 64;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  // Every GPR and FPR arrives via its own abstract register write...
  const auto ns = cmd_regnos(bus.ops);
  for (uint16_t i = 1; i < 32; ++i)
    CHECK(contains_regno(ns, hybrid::regno_gpr(i)));
  for (uint16_t i = 0; i < 32; ++i)
    CHECK(contains_regno(ns, hybrid::regno_fpr(i)));

  // ...and no load instruction rides the Program Buffer (LOAD opcode 0x03 /
  // LOAD-FP 0x07 with a memory-load funct3 would be a scratch-page sweep; the
  // only legitimate PB use in this non-V state is none at all).
  for (const auto& op : bus.ops)
    CHECK_FALSE((op.kind == DmiOp::Kind::Write && op.reg == kCommand
                 && op.value == hybrid::kExecProgbufCmd));
}

TEST_CASE("B4: resume with HYBRID_FLAG_FP and drained FS=Off still writes "
          "mstatus with FS != Off so FPR abstract writes are accepted")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags  |= HYBRID_FLAG_FP;
  s.mstatus = 0;                  // FS = 00 (Off)

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  // Find the abstract write that targets mstatus (regno = 0x300) and verify
  // FS (bits 14:13) was forced non-zero. The drained mstatus has FS=Off but
  // the hart needs FS != Off to accept abstract FPR writes; the gate must
  // OR in FS=Initial without altering the wire-format state.mstatus.
  std::optional<uint32_t> mstatus_low32;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && (op.value & 0xFFFFu) == hybrid::regno_csr(0x300)
        && ((op.value >> 16) & 1u)) {
      REQUIRE(i >= 2);
      mstatus_low32 = bus.ops[i - 2].value;
      break;
    }
  }
  REQUIRE(mstatus_low32.has_value());
  CHECK((*mstatus_low32 & 0x6000u) != 0u);
}

