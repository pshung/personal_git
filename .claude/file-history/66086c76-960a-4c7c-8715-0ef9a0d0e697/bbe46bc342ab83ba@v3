TEST_CASE("HandoffController: PC-mode synthetic EXIT hit drains like marker EXIT")
{
  // PC-trigger mode populates the trigger map via add_pc_hit() instead of
  // scan_buffer(). HandoffController must dispatch on `kind` only and not
  // depend on a recorded `insn`. This is the single-test contract the PC
  // mode relies on.
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_gpr(12)] = 7;
  bus.regfile[hybrid::regno_csr(RD::kCsrDpc)] = 0x80000048;

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus);
  const auto state = h.on_retire(0x80000044);

  REQUIRE(state);
  CHECK(state->magic == HYBRID_STATE_MAGIC);
  CHECK(state->gpr[12] == 7);
  CHECK(state->pc == 0x80000048);
}

TEST_CASE("HandoffController: PC-mode hit at unrelated PC stays silent")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus);
  const auto state = h.on_retire(0x80000048);
  CHECK_FALSE(state.has_value());
  CHECK(bus.ops.empty());
}

// GPR/FPR transport is Abstract-Command-only: a full EXIT drain reads
// x1..x31 and f0..f31 one abstract read each, and never issues a PB sd/fsd
// sweep -- even under the simulator's production drain configuration.
TEST_CASE("HandoffController: full EXIT drain reads GPRs/FPRs via abstract "
          "commands, never a PB block-store sweep")
{
  RecordingBus bus;
  bus.dmstatus_value   = kDmstatusHaltedAndAcked;
  bus.abstractcs_value = 8u << 24;  // progbufsize=8
  for (uint16_t i = 1; i < 32; ++i)
    bus.regfile[hybrid::regno_gpr(i)] = 0xAB00ULL + i;
  for (uint16_t i = 0; i < 32; ++i)
    bus.regfile[hybrid::regno_fpr(i)] = 0xFB00ULL + i;

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_FP;
  input.vlenb   = 64;

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus, /*scratch_gpa=*/0x88000000);
  h.set_passthrough_input(input);

  const auto state = h.on_retire(0x80000044);
  REQUIRE(state.has_value());

  // Every GPR/FPR value arrives via its abstract read...
  for (int i = 1; i < 32; ++i)
    CHECK(state->gpr[i] == 0xAB00ULL + uint64_t(i));
  for (int i = 0; i < 32; ++i)
    CHECK(state->fpr[i] == 0xFB00ULL + uint64_t(i));
  // ...and no Program-Buffer execution occurred at all (no V state, no L2C).
  for (const auto& op : bus.ops)
    CHECK_FALSE((op.kind == hybrid::test::DmiOp::Kind::Write
                 && op.reg == RD::kCommand
                 && op.value == hybrid::kExecProgbufCmd));
}

// CSR transport is Abstract-Command-only on the drain side too (the legacy PB
// csrr+sd sweep was removed): a full EXIT drain reads every caps-supported
// Andes+M-ext CSR with its own abstract read, directly into the drained state.
TEST_CASE("HandoffController: full EXIT drain reads Andes+M-ext CSRs via "
          "abstract commands, never a PB csrr+sd sweep")
{
  RecordingBus bus;
  bus.dmstatus_value   = kDmstatusHaltedAndAcked;
  bus.abstractcs_value = 8u << 24;  // progbufsize=8

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_ANDES | HYBRID_FLAG_M_EXT;
  input.vlenb   = 0;

  // Preload the regfile so every transported CSR has a distinct value.
  std::vector<uint16_t> addrs;
  hybrid::for_each_transport_csr(input, hybrid::AndesCaps::all(),
    [&](uint16_t addr, const uint64_t&) { addrs.push_back(addr); });
  REQUIRE(!addrs.empty());
  for (std::size_t k = 0; k < addrs.size(); ++k)
    bus.regfile[hybrid::regno_csr(addrs[k])] = 0xC5000000ULL + k;

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus, /*scratch_gpa=*/0x88000000);
  h.set_passthrough_input(input);

  const auto state = h.on_retire(0x80000044);
  REQUIRE(state.has_value());

  // Every transported CSR's value landed via its own abstract read...
  std::size_t k = 0;
  hybrid::for_each_transport_csr(*state, hybrid::AndesCaps::all(),
    [&](uint16_t, const uint64_t& field) {
      CHECK(field == 0xC5000000ULL + k);
      ++k;
    });
  // ...and no Program-Buffer execution occurred at all (no V state, no L2C).
  for (const auto& op : bus.ops)
    CHECK_FALSE((op.kind == hybrid::test::DmiOp::Kind::Write
                 && op.reg == RD::kCommand
                 && op.value == hybrid::kExecProgbufCmd));
}

// #1: set_minimal_drain(true) makes an EXIT route to StateDrain's counters-only
// path -- refresh mcycle/minstret, pass everything else through from the QEMU1
// snapshot, and issue just two abstract reads instead of the full ~190.
TEST_CASE("HandoffController: minimal-drain routes EXIT to counters-only drain")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_csr(RD::kCsrMcycle)]   = 0x111;
  bus.regfile[hybrid::regno_csr(RD::kCsrMinstret)] = 0x222;

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_FP | HYBRID_FLAG_V;
  input.gpr[12] = 0xABC;  // distinctive: must pass through, never re-read

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus);
  h.set_passthrough_input(input);
  h.set_minimal_drain(true);

  const auto state = h.on_retire(0x80000044);
  REQUIRE(state);
  CHECK(state->mcycle   == 0x111);
  CHECK(state->minstret == 0x222);
  CHECK(state->gpr[12]  == 0xABC);  // passthrough; a full drain would read 0 here

  int reads = 0;
  for (const auto& op : bus.ops)
    if (op.kind == hybrid::test::DmiOp::Kind::Write && op.reg == RD::kCommand
        && ((op.value >> 16) & 1u) == 0u)
      ++reads;
  CHECK(reads == 2);
}
