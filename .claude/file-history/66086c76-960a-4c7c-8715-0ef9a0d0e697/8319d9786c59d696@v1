// V-register transport staging: the host<->guest-RAM half of the V data
// regfile transfer. The Debug Module abstract-command space has no slots for
// v0..v31 (the RISC-V Debug Spec leaves V to the Program Buffer or
// implementation-specific extensions), so vsim moves v0..v31 by executing a
// vle8.v/vse8.v sweep on the halted hart through the Program Buffer (see
// pb_v_data_sweep in program_buffer.hpp, driven by ResumeDriver on resume and
// StateDrain at drain). That sweep loads/stores the V scratch region of guest
// RAM -- the top page of the mapped span (v_scratch_gpa, L26); this header
// provides the matching host-side copy:
//
//   - stage_v_to_scratch: state.vreg[] -> scratch RAM, called before resume so
//     the ResumeDriver vle8.v sweep reads QEMU 1's V values.
//   - read_v_from_scratch: scratch RAM -> state.vreg[], called after the
//     StateDrain vse8.v sweep so the drained v0..v31 land in state.vreg[]
//     (the handoff file).
//
// The transfer is transparent to the workload: benchmark binaries issue no
// transport code, only the enter_vsim / exit_vsim markers. rt_c_v_regs.c is
// the reference fixture.
//
// Pure logic: no SystemC, no DMI bus. Easy to unit-test.

#pragma once

#include "hybrid/andes_caps.hpp"
#include "hybrid/state_abi.h"

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <span>
#include <stdexcept>

namespace hybrid
{

// Total scratch bytes needed: 32 V regs × HYBRID_VLEN_BYTES_MAX. Sized to the
// maximum supported VLEN; the actual per-reg byte count is `vlenb`. Defined in
// the shared ABI (HYBRID_V_SCRATCH_BYTES) so the driver's mmap sizing and this
// consumer agree on one count (L26/F2).
inline constexpr std::size_t kVScratchBytes = HYBRID_V_SCRATCH_BYTES;

// L26: the scratch region is the TOP kVScratchBytes of the mapped RAM span,
// not a fixed address. Scheme D parks it just above the program's declared
// RAM (the driver maps one page more than --mem-size), so no program layout
// can collide with it. This is the single source of truth for the GUEST
// address the Program-Buffer sweep (ResumeDriver/StateDrain) loads/stores
// through; the host stager below copies span-relative and needs no base.
inline constexpr auto v_scratch_gpa(uint64_t ram_base, std::size_t ram_size)
  -> uint64_t
{
  return ram_base + static_cast<uint64_t>(ram_size) - kVScratchBytes;
}

// Sentinel for "no V scratch configured". ResumeDriver/StateDrain default to
// it; a non-V handoff never consults the scratch GPA, so that is fine, but if
// a V handoff reaches the sweep with the GPA still unset the driver throws
// (loud) rather than silently transporting V through a bogus address.
inline constexpr uint64_t kVScratchGpaUnset =
  static_cast<uint64_t>(-1);

// GPR block-load prototype: x1..x31 (8 bytes each) staged in the TOP of the
// scratch page so the resume ld-sweep reads them below the V region (which
// grows up from the base). Reusing the V page keeps this single-repo; it only
// applies when the V data leaves room (gpr_scratch_fits), else the caller falls
// back to per-register abstract writes. A production version would give the GPR
// block its own scratch page instead of sharing the V one.
inline constexpr std::size_t kGprScratchBytes = 31 * 8;  // x1..x31

inline constexpr auto gpr_scratch_gpa(uint64_t v_scratch_base) -> uint64_t
{
  return v_scratch_base + kVScratchBytes - kGprScratchBytes;
}

inline constexpr auto gpr_scratch_fits(uint64_t vlenb) -> bool
{
  return static_cast<std::size_t>(32) * vlenb <= kVScratchBytes - kGprScratchBytes;
}

// FPR block-load: f0..f31 (8 bytes each) staged just BELOW the GPR block. Unlike
// x0, f0 is a real register, so all 32 f-regs ride the sweep (kFprScratchBytes =
// 32*8, not 31*8). The two blocks are disjoint and staged up front, so the FPR
// fld-sweep (early in resume) and the GPR ld-sweep (later) never collide. The V
// region grows up from the base, so the fit gate here is tighter than the GPR
// one -- V must clear both blocks.
inline constexpr std::size_t kFprScratchBytes = 32 * 8;  // f0..f31

inline constexpr auto fpr_scratch_gpa(uint64_t v_scratch_base) -> uint64_t
{
  return v_scratch_base + kVScratchBytes - kGprScratchBytes - kFprScratchBytes;
}

inline constexpr auto fpr_scratch_fits(uint64_t vlenb) -> bool
{
  return static_cast<std::size_t>(32) * vlenb
         <= kVScratchBytes - kGprScratchBytes - kFprScratchBytes;
}

// CSR block (v3/v4): the Andes V5 + M-ext CSRs the sweep transports through the
// Program Buffer ride a scratch region just BELOW the FPR block. Sized to hold
// the MAX possible set (every defined CSR); the live count is smaller (flag- and
// caps-gated) and packs contiguously from slot 0. Slots = 13 Andes scalars + PMA
// (2 pmacfg + 16 pmaaddr) + 51 M-ext, auto-counted from the shared X-macros so
// the size never drifts as CSRs are added.
inline constexpr std::size_t kCsrScratchSlots = [] {
  std::size_t n = 0;
#define X(field, addr, name) ++n;
  HYBRID_ANDES_CSR_LIST(X)
  HYBRID_M_EXT_CSR_LIST(X)
#undef X
  return n + HYBRID_PMA_CFG_NUM + HYBRID_PMA_ADDR_NUM;
}();
inline constexpr std::size_t kCsrScratchBytes = kCsrScratchSlots * 8;

inline constexpr auto csr_scratch_gpa(uint64_t v_scratch_base) -> uint64_t
{
  return v_scratch_base + kVScratchBytes - kGprScratchBytes - kFprScratchBytes
         - kCsrScratchBytes;
}

inline constexpr auto csr_scratch_fits(uint64_t vlenb) -> bool
{
  return static_cast<std::size_t>(32) * vlenb
         <= kVScratchBytes - kGprScratchBytes - kFprScratchBytes
              - kCsrScratchBytes;
}

namespace detail
{

// Byte offset of the scratch region inside a RAM span: its top page. Throws
// if the span is smaller than one scratch page (a too-small RAM mapping).
inline auto scratch_offset(std::size_t ram_size) -> std::size_t
{
  if (ram_size < kVScratchBytes)
    throw std::runtime_error(
      "v_regfile_xfer: RAM span smaller than the V scratch page");
  return ram_size - kVScratchBytes;
}

}  // namespace detail

// Walk every CSR the sweep transports, in canonical order -- Andes scalars, PMA
// ADDR, PMA CFG, then M-ext -- gated by the live block flag AND engine caps.
// Invokes fn(slot_index, csr_addr, field_ref) per transported CSR: the host
// stage copies field->scratch, the host lift copies scratch->field, and the
// ResumeDriver/StateDrain build their PB sweep's addr list -- all walking THIS
// identical order, so scratch slot i and csrs[i] always agree. State is
// templated so it binds const (stage / restore) and mutable (lift). PMA addr
// precedes cfg because the restore's TOR/NAPOT cfg consumes the addr already in
// place (mirrors the PMP/PMA restore ordering). Applies the same `(flags & FLAG)
// && caps.supports_csr(addr)` predicate every consumer of the block uses, so the
// single X-macro keeps them in lockstep.
template<typename State, typename Fn>
inline void for_each_sweep_csr(State& state, const AndesCaps& caps, Fn&& fn)
{
  std::size_t i = 0;
  if (state.flags & HYBRID_FLAG_ANDES) {
#define X(field, addr, name) \
  if (caps.supports_csr(addr)) { fn(i, uint16_t(addr), state.andes.field); ++i; }
    HYBRID_ANDES_CSR_LIST(X)
#undef X
    for (int p = 0; p < HYBRID_PMA_ADDR_NUM; ++p)
      if (caps.supports_csr(HYBRID_PMA_ADDR0_CSR + p)) {
        fn(i, uint16_t(HYBRID_PMA_ADDR0_CSR + p), state.andes.pmaaddr[p]); ++i;
      }
    for (int p = 0; p < HYBRID_PMA_CFG_NUM; ++p)
      if (caps.supports_csr(HYBRID_PMA_CFG0_CSR + 2 * p)) {
        fn(i, uint16_t(HYBRID_PMA_CFG0_CSR + 2 * p), state.andes.pmacfg[p]); ++i;
      }
  }
  if (state.flags & HYBRID_FLAG_M_EXT) {
#define X(field, addr, name) \
  if (caps.supports_csr(addr)) { fn(i, uint16_t(addr), state.m_ext.field); ++i; }
    HYBRID_M_EXT_CSR_LIST(X)
#undef X
  }
}

// Copy state.vreg[] into the span's top scratch page. Called just before vsim
// resumes the hart so the fixture can vle8.v from scratch and pick up QEMU 1's
// V values.
inline void stage_v_to_scratch(const hybrid_state_v1& state,
                               std::span<uint8_t> ram)
{
  const auto off = detail::scratch_offset(ram.size());
  // Pack at vlenb stride (drop the wire-format padding) so v0..v31 sit
  // contiguously and the Program-Buffer sweep can move 8 at a time via LMUL=8.
  const std::size_t vlenb = state.vlenb;
  for (std::size_t r = 0; r < 32; ++r)
    std::memcpy(ram.data() + off + r * vlenb,
                state.vreg + r * HYBRID_VLEN_BYTES_MAX, vlenb);
}

// Pack x1..x31 (8 bytes each) contiguously into the top kGprScratchBytes of the
// scratch page; the resume ld-sweep reads them back. state.gpr[1..31] is itself
// contiguous, so this is a single memcpy. Called before resume, gated by the
// caller on gpr_scratch_fits (the V region must leave room in the page).
inline void stage_gpr_to_scratch(const hybrid_state_v1& state,
                                 std::span<uint8_t> ram)
{
  const auto off =
    detail::scratch_offset(ram.size()) + (kVScratchBytes - kGprScratchBytes);
  std::memcpy(ram.data() + off, &state.gpr[1], 31 * 8);
}

// Pack f0..f31 (8 bytes each) contiguously into the scratch page just below the
// GPR block; the resume fld-sweep reads them back. state.fpr[0..31] is itself
// contiguous, so this is a single memcpy. Called before resume, gated by the
// caller on fpr_scratch_fits (the V region must leave room for both blocks).
inline void stage_fpr_to_scratch(const hybrid_state_v1& state,
                                 std::span<uint8_t> ram)
{
  const auto off = detail::scratch_offset(ram.size())
                   + (kVScratchBytes - kGprScratchBytes - kFprScratchBytes);
  std::memcpy(ram.data() + off, &state.fpr[0], 32 * 8);
}

// Copy the span's top scratch page into state.vreg[]. Called inside the vsim
// drain path after the fixture's prologue vse8.v has settled the (possibly
// mutated) regfile bytes into RAM.
inline void read_v_from_scratch(hybrid_state_v1& state,
                                std::span<const uint8_t> ram)
{
  const auto off = detail::scratch_offset(ram.size());
  // Unpack the vlenb-packed scratch back into the wire-strided vreg[] slots.
  // Each slot's padding (bytes vlenb..HYBRID_VLEN_BYTES_MAX) is left as-is:
  // callers pass a passthrough state whose padding is already zero (the QEMU
  // drain zero-fills it), so the full 128-byte slots stay byte-identical to the
  // oracle that --verify compares against.
  const std::size_t vlenb = state.vlenb;
  for (std::size_t r = 0; r < 32; ++r)
    std::memcpy(state.vreg + r * HYBRID_VLEN_BYTES_MAX,
                ram.data() + off + r * vlenb, vlenb);
}

// Lift `count` GPRs (x1..x[count]) out of the scratch page into state.gpr[].
// Mirror of stage_gpr_to_scratch, reading from the identical top-of-page offset:
// the drain sd-sweep stored them here from the regfile. count is < 31 when the
// sweep's base register (itself a GPR) was captured separately via an abstract
// read and excluded from the sweep, so its slot must not be lifted.
inline void read_gpr_from_scratch(hybrid_state_v1& state,
                                  std::span<const uint8_t> ram,
                                  std::size_t count)
{
  const auto off =
    detail::scratch_offset(ram.size()) + (kVScratchBytes - kGprScratchBytes);
  std::memcpy(&state.gpr[1], ram.data() + off, count * 8);
}

// Lift f0..f31 out of the scratch page into state.fpr[]. Mirror of
// stage_fpr_to_scratch; the drain fsd-sweep stored them here. No f-reg is the
// sweep's base (that is an integer GPR), so all 32 round-trip.
inline void read_fpr_from_scratch(hybrid_state_v1& state,
                                  std::span<const uint8_t> ram)
{
  const auto off = detail::scratch_offset(ram.size())
                   + (kVScratchBytes - kGprScratchBytes - kFprScratchBytes);
  std::memcpy(&state.fpr[0], ram.data() + off, 32 * 8);
}

// Pack the transported Andes+M-ext CSR values into the CSR scratch region (just
// below the FPR block) in canonical order; the resume csr_sweep ld's them into
// each CSR. Called before resume, gated per-CSR on flag + caps (for_each_sweep_
// csr), so an engine's unsupported CSRs never take a slot.
inline void stage_csr_to_scratch(const hybrid_state_v1& state,
                                 std::span<uint8_t> ram, const AndesCaps& caps)
{
  const auto base =
    detail::scratch_offset(ram.size())
    + (kVScratchBytes - kGprScratchBytes - kFprScratchBytes - kCsrScratchBytes);
  for_each_sweep_csr(state, caps,
    [&](std::size_t i, uint16_t /*addr*/, const uint64_t& value) {
      std::memcpy(ram.data() + base + i * 8, &value, 8);
    });
}

// Lift the Andes+M-ext CSR values out of the CSR scratch region into state, the
// mirror of stage_csr_to_scratch: the drain csr_sweep sd'd them here. Same
// flag+caps-gated canonical order, so slot i lands in the field it came from.
inline void read_csr_from_scratch(hybrid_state_v1& state,
                                  std::span<const uint8_t> ram,
                                  const AndesCaps& caps)
{
  const auto base =
    detail::scratch_offset(ram.size())
    + (kVScratchBytes - kGprScratchBytes - kFprScratchBytes - kCsrScratchBytes);
  for_each_sweep_csr(state, caps,
    [&](std::size_t i, uint16_t /*addr*/, uint64_t& value) {
      std::memcpy(&value, ram.data() + base + i * 8, 8);
    });
}

}  // namespace hybrid
