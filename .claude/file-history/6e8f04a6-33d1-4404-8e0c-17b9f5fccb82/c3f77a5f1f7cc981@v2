// andesim command-line parsing.
//
// The grammar is deliberately tiny and stable across all subcommands:
//
//   andesim [<cmd>] [--mode M] [--engine E] [--trigger T] [positional...]
//                   [-- <verbatim engine args...>]
//
// `run` is the default command: when the first token is not a known
// subcommand (and not a top-level help flag), the whole line parses as
// `run ...`, so `andesim --mode fast prog.elf` works without typing `run`.
//
// The single most important rule is the `--` boundary: every token after the
// first `--` is captured verbatim into `passthrough` and is NOT interpreted by
// the framework. That is what lets `fast`/`cycle` forward an engine's whole
// native CLI (e.g. `-gdb tcp::1234 -S`) untouched, so users see one simulator.
#ifndef ANDESIM_CLI_HPP
#define ANDESIM_CLI_HPP

#include <string>
#include <string_view>
#include <vector>

namespace andes_sim {

// True for the known command names (run/list/doctor/profile). The single
// source of truth shared by the parser (default-command rule) and main's
// dispatch.
bool is_subcommand(std::string_view name);

struct Cli {
  std::string subcommand;                 // e.g. "run", "list"; "" if none
  std::string model;                      // --mode fast|cycle|hybrid (field stays 'model': the concept, see list models)
  std::string engine;                     // --engine <id>
  std::string trigger;                    // --trigger marker|pc
  // Hybrid trigger args (empty => cmd_run applies the default). pc boundaries
  // are a symbol name or 0x address; the sizes stay strings here and are
  // parsed where they are used.
  std::string pc_start;                   // --pc-start (trigger pc)
  std::string pc_end;                     // --pc-end   (trigger pc)
  std::string mem_size;                   // --mem-size (guest memory; --mmap-size is a hidden alias)
  std::string runtime;                    // --runtime linux (proxy-kernel payload; "" => bare-metal ELF, the default)
  std::string kanata;                     // --kanata <file> (marker/pc ROI trace)
  std::string objdump;                    // --objdump <file> (kanata labels)
  std::string log_level;                  // --log-level 0..6 (vsim scale; "" => info)
  std::string log_file;                   // --log-file <path> (full trace capture)
  std::string step_timeout_ms;            // --step-timeout-ms (hybrid per-leg spawn timeout; "" => PlanOptions' 90000)
  std::vector<std::string> positional;    // non-flag framework args
  std::vector<std::string> passthrough;   // verbatim, everything after `--`
  bool help = false;                      // -h / --help (before `--`)
  bool dry_run = false;                   // --dry-run (run, profile)
  bool print_memmap = false;              // --print-memmap (run --mode hybrid)
  bool verify = false;                    // --verify (run --mode hybrid)
  bool gdb = false;                       // --gdb (fast: QEMU gdbstub; cycle: vsim JTAG + ICEman)
  std::string gdb_port;                   // --gdb-port (fast: default 1234; cycle: default 9104)
  // profile's report knobs (values stay strings; cmd_profile applies the
  // defaults where they are used, like mem_size/gdb_port above).
  std::string limit;                      // --limit (profile; "" => 50)
  std::string min_iters;                  // --min-iters (profile; "" => 1)
  std::string addr2line;                  // --addr2line (profile; "" => auto)
  bool raw = false;                       // --raw (profile: dump the plugin log)
  bool llm = true;                        // --llm / --no-llm (profile report format)
  bool optimize_rvv = true;               // --optimize-rvv / --no-optimize-rvv (profile)
  bool no_source = false;                 // --no-source (profile: skip addr2line)
  std::string error;                      // non-empty => parse failed
};

// Parse argv[1..] (program name skipped). The vector overload is the testable
// core; the argv overload adapts it for main().
Cli parse_cli(const std::vector<std::string>& args);
Cli parse_cli(int argc, char** argv);

}  // namespace andes_sim

#endif  // ANDESIM_CLI_HPP
