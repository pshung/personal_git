/* Diagnostic: does an in-ROI L3C MMIO read kill subsequent UART output
 * on ax46mpv_fpga_l3 hybrid? Prints A before, B after. */
#include <stdint.h>
#include <stdio.h>
#include <andesim/ROI.h>

#define L2C_BASE 0xE0500000ull

int main(void)
{
  printf("STAGE done\n"); /* pre-ROI: init stdio on the QEMU leg */

  andesim_ROI_begin();
  printf("A alive\n");
  uint32_t ctrl = *(volatile uint32_t *)(L2C_BASE + 0x08u);
  printf("B after-l3c-read ctrl=%08x\n", ctrl);
  andesim_ROI_end();
  return 0;
}
