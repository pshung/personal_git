#!/usr/bin/env bash
# crt0's mcache_ctl enable must OR into a DEFINED a0: `csrr a0, mcache_ctl`
# immediately before `ori a0, a0, 0x703`.
#
# Without ENABLE_DCACHE_COHERENCE (never defined in-tree) the only prior a0
# write is boot-entry a0, so `ori a0, a0, 0x703; csrw mcache_ctl, a0` wrote
# hartid|0x703 -- correct only by accident because both engines enter hart 0
# with a0=0. The csrr also preserves the just-set IC enable and any WARL bits
# instead of relying on 0x703 covering them.
#
# Disassembly lint: the behavior cannot be provoked end-to-end (QEMU and the
# RTL both reset a0=0 for hart 0), so assert the instruction shape instead.
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

CRT0="$ROOT/build/runtime/crt0.o"
if [ ! -f "$CRT0" ]; then
  make -C "$ROOT/runtime" >/dev/null 2>&1 || fail "runtime build failed"
fi
[ -f "$CRT0" ] || fail "no $CRT0 after runtime build"

OBJDUMP="${HYBRID_TOOLCHAIN:-$(cfg_val HYBRID_TOOLCHAIN)}/bin/riscv64-unknown-elf-objdump"
[ -x "$OBJDUMP" ] || fail "no objdump at $OBJDUMP"

dis=$("$OBJDUMP" -d "$CRT0") || fail "objdump failed"

# The enable sequence: whatever precedes `ori a0,a0,0x703` must be
# `csrr a0, mcache_ctl` (0x7ca), not the boot-entry a0.
prev=$(printf '%s\n' "$dis" | grep -B1 -E $'\tori\ta0,a0,1795$' | head -1)
[ -n "$prev" ] || fail "crt0.o has no 'ori a0,a0,0x703' mcache_ctl sequence"
printf '%s\n' "$prev" | grep -qE $'\tcsrr\ta0,(0x7ca|mcache_ctl)$' \
  || fail "a0 is undefined at the mcache_ctl ori (want 'csrr a0,0x7ca' before it, got: ${prev##*$'\t'})"

# Coherence join: before the D-cache enable, crt0 must csrs DC_COHEN
# (1<<19 = 0x80000, materialized by `lui 0x80`) and poll DC_COHSTA
# (bit 20) BOUNDED. On a coherence-manager RTL (ax46mpv_fpga_l3) a
# non-coherent D-cache corrupts data under eviction pressure (CoreMark
# CRCs fail in cycle mode); a non-CM core WARL-0s COHEN so the bounded
# poll falls through in a few cycles. An UNBOUNDED poll would hang on
# QEMU (permissive: COHEN sticks, COHSTA never sets).
printf '%s\n' "$dis" | grep -qE $'\tcsrs\tmcache_ctl,a0$|\tcsrs\t0x7ca,a0$' \
  || fail "crt0.o has no 'csrs mcache_ctl' coherence-enable (DC_COHEN)"
printf '%s\n' "$dis" | grep -qE $'\tlui\ta0,0x80$' \
  || fail "the coherence-enable does not set DC_COHEN (want lui a0,0x80)"
# Bounded: the poll loop must decrement a counter (addi rd,rd,-1, possibly
# compressed to c.addi rd,-1).
printf '%s\n' "$dis" | grep -qE $'(c\\.)?addi\t(a2|t0|t1|a1)(,(a2|t0|t1|a1))?,-1$' \
  || fail "the DC_COHSTA poll is not bounded (no counter decrement found)"

ok "crt0 mcache_ctl: bounded DC_COHEN join + csrr'd enable"
