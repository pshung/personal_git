/* Diagnostic 2: sample mcache_ctl + UART2 LSR inside the ROI into s2..s6,
 * read them back from the drained exit state (UART-independent). */
#include <stdint.h>
#include <stdio.h>
#include <andesim/ROI.h>

#define UART2 0xf0300000ull
/* vplat UART: 16550 layout, reg shift 2 (LSR at byte offset 0x14) */
#define LSR_OFF 0x14u
#define THR_OFF 0x00u

int main(void)
{
  printf("STAGE done\n"); /* init stdio on the QEMU leg */

  uint64_t mcache, lsr1, lsr2, thr_echo;
  andesim_ROI_begin();
  __asm__ volatile("csrr %0, 0x7CA" : "=r"(mcache));
  lsr1 = *(volatile uint32_t *)(UART2 + LSR_OFF);
  *(volatile uint32_t *)(UART2 + THR_OFF) = 'X';
  lsr2 = *(volatile uint32_t *)(UART2 + LSR_OFF);
  thr_echo = 0xDEADBEEFull;
  __asm__ volatile("mv s2, %0" :: "r"(mcache) : "s2");
  __asm__ volatile("mv s3, %0" :: "r"(lsr1) : "s3");
  __asm__ volatile("mv s4, %0" :: "r"(lsr2) : "s4");
  __asm__ volatile("mv s5, %0" :: "r"(thr_echo) : "s5");
  andesim_ROI_end();
  return 0;
}
