#!/usr/bin/env bash
# B4: scripts/run_e2e.sh must self-load ./config.env like the other harness
# entry points, so `scripts/test_all.sh e2e` works from a fresh shell.
#
# Repro this guards against: with QEMU_BIN_DIR/VSIM_BIN_DIR absent from the
# environment but present in ./config.env, run_e2e.sh used to die at its
# `require VSIM_QEMU` preflight ("not found: /qemu-system-riscv64") before
# reaching the test table. An exported value must still win over the file.
#
# Uses FILTER matching nothing so the run performs no builds and spawns no
# engines: reaching the final summary line proves env resolution worked.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

fail() { echo "FAIL[run_e2e_env_selfload]: $1"; exit 1; }

[ -r "$ROOT/config.env" ] || fail "no ./config.env on this host (copy config.env.example first)"

# 1. Env-scrubbed: config.env must fill QEMU_BIN_DIR/VSIM_BIN_DIR.
out=$(cd "$ROOT" && env -u QEMU_BIN_DIR -u VSIM_BIN_DIR -u VSIM_QEMU -u VSIM_PLUGIN -u VSIM_BIN \
      FILTER='^nothing-matches-this$' JOBS=1 bash scripts/run_e2e.sh 2>&1)
rc=$?
echo "$out" | grep -q "summary:" \
  || fail "env-scrubbed run never reached the summary (rc=$rc): $(echo "$out" | head -3)"

# 2. Exported values still win: a bogus exported VSIM_QEMU must fail the
#    preflight even though config.env holds a good one.
out=$(cd "$ROOT" && VSIM_QEMU=/nonexistent/qemu-system-riscv64 \
      FILTER='^nothing-matches-this$' JOBS=1 bash scripts/run_e2e.sh 2>&1)
rc=$?
[ "$rc" -ne 0 ] || fail "bogus exported VSIM_QEMU did not fail the preflight"
echo "$out" | grep -q "/nonexistent/qemu-system-riscv64" \
  || fail "preflight failure does not name the exported VSIM_QEMU"

echo "PASS: run_e2e.sh self-loads config.env; exported values win"
