#!/usr/bin/env bash
# replay_l3c.sh <tag> [state-mutator-python]  -- fresh QEMU drain + vsim resume
# for demo/cache/l3c.elf on ax46mpv_fpga_l3. Prints the vsim guest output.
set -uo pipefail
TAG=$1
MUTATE=${2:-}
SCRATCH=/tmp/claude-1002/-home-nick-work-andesim/6e8f04a6-33d1-4404-8e0c-17b9f5fccb82/scratchpad
PLAN=$(mktemp -d)
MMAP=$(mktemp -p /dev/shm hsim-shm.XXXXXX)
truncate -s 134221824 "$MMAP"
cp /tmp/tmp.5Ml52RnItS/qemu.cfg "$PLAN/qemu.cfg"
cd /home/nick/work/andesim-demo/demo/cache

timeout 60 /home/nick/work/qemu_andesim/build/qemu/qemu-system-riscv64 \
  -object memory-backend-file,id=mem,share=on,mem-path=$MMAP,size=134221824 \
  -machine andes_ae350,memory-backend=mem -cpu andes-ax46mpv,vlen=1024 \
  -nographic -semihosting-config enable=on,target=native -bios l3c.elf \
  -plugin /home/nick/work/andesim/qemu_plugin/libhybrid_handoff.so,outfile=$PLAN/state-0.bin,ilm_size=32768,dlm_size=32768,hvm_size=8388608,l2c_base=3763339264,log_level=2 \
  -readconfig $PLAN/qemu.cfg </dev/null >/dev/null 2>&1

if [ -n "$MUTATE" ]; then
  python3 -c "$MUTATE" "$PLAN/state-0.bin"
fi

timeout 120 /home/nick/work/vsim_andesim/build/sim_ax46mpv_fpga_l3 l3c.elf \
  --resume-from-qemu $PLAN/state-0.bin --handoff-out $PLAN/state-1.bin \
  --shared-mem-path $MMAP --shared-mem-size 134221824 --shared-mem-base 0x0 \
  --ilm $PLAN/state-0.bin.ilm --dlm $PLAN/state-0.bin.dlm --hvm $PLAN/state-0.bin.hvm \
  --drain-minimal --log-level 2 </dev/null >"$SCRATCH/replay-$TAG.out" 2>"$SCRATCH/replay-$TAG.err"
rc=$?
echo "== $TAG rc=$rc guest-stdout:"
grep -vE "Copyright|^Version" "$SCRATCH/replay-$TAG.out"
echo "== info lines:"
grep -E "resume=|liveness|drained at|cycles simulated" "$SCRATCH/replay-$TAG.err"
rm -f "$MMAP"; rm -rf "$PLAN"
