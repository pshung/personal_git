#!/usr/bin/env python3
"""Align two eval-callback dumps by node order; report the first divergence.

A node is `common_debug_cb_eval: <name> = (<ty>) <OP>(...) = {shape}` followed
(after the value block) by `sum = <float>`. fp reassociation across arches is
normal; only order-of-magnitude relative gaps or NaN count as divergence.
"""
import re
import sys

HDR = re.compile(r'common_debug_cb_eval:\s+(\S+) = \((\w+)\)\s+(\w+)\(')
SUM = re.compile(r'^\s*sum = (\S+)')


NUM = re.compile(r'-?\d+\.\d+')


def parse(path):
    nodes = []
    name = None
    vals = []
    with open(path, errors='replace') as f:
        for line in f:
            m = HDR.search(line)
            if m:
                name = (m.group(1), m.group(3))  # (tensor name, OP)
                vals = []
                continue
            m = SUM.match(line)
            if m and name is not None:
                nodes.append((name[0], name[1], float(m.group(1)), vals))
                name = None
                continue
            if name is not None and '[' in line or ']' in line:
                vals.extend(float(x) for x in NUM.findall(line))
    return nodes


def elem_err(hv, rv):
    """max relative element error over the preview values (aligned pairs)."""
    n = min(len(hv), len(rv))
    worst = 0.0
    worst_pair = (0.0, 0.0)
    for a, b in zip(hv[:n], rv[:n]):
        if b != b or a != a:
            return float('inf'), (a, b)
        e = abs(a - b) / max(abs(a), 1e-2)
        if e > worst:
            worst, worst_pair = e, (a, b)
    return worst, worst_pair


def main(host_path, rvv_path, rel_tol=0.02):
    h, r = parse(host_path), parse(rvv_path)
    print(f'host nodes: {len(h)}   rvv nodes: {len(r)}')
    n = min(len(h), len(r))
    shown = 0
    for i in range(n):
        hn, ho, hs, hv = h[i]
        rn, ro, rs, rv = r[i]
        if hn != rn or ho != ro:
            print(f'[{i}] GRAPH MISMATCH host={hn}/{ho} rvv={rn}/{ro}')
            return
        err, (a, b) = elem_err(hv, rv)
        if err > rel_tol:
            print(f'[{i}] {ho:14s} {hn:44s} elem_err={err:8.4f} '
                  f'(h={a:.4f} r={b:.4f}) sum h={hs:.4f} r={rs:.4f}')
            shown += 1
            if shown >= 25:
                print('... (more suppressed)')
                return
    if shown == 0:
        print('no divergence above tolerance')


if __name__ == '__main__':
    main(sys.argv[1], sys.argv[2])
