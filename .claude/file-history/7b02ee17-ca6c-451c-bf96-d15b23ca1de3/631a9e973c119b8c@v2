// Shared-mmap allocation for andesim.
//
// The caller asks for `size` bytes; we resolve a backing directory over a
// tier list (first fit wins, fit = size + 256 MiB free), allocate a sparse
// file with mkstemp+truncate, and print one status line that always names
// the chosen tier -- and, when we fell past /dev/shm, why. HSIM_MMAP_DIR
// pins a single tier (hard error if it does not fit; no fallback past it).
#ifndef ANDESIM_SHM_HPP
#define ANDESIM_SHM_HPP

#include <cstdint>
#include <functional>
#include <string>
#include <vector>

namespace andes_sim {

// Free-space headroom a tier must have beyond the requested size.
inline constexpr long long kMmapSafetyMargin = 256LL * 1024 * 1024;

// One backing-store candidate: the directory plus the label used in
// status/error messages ("/dev/shm", "~/.cache/andesim", "HSIM_MMAP_DIR=..").
struct MmapTier {
  std::string dir;
  std::string label;
};

// resolve_mmap_dir result: the chosen dir ("" on failure) and, when a tier
// was skipped, a human note saying which and why ("" when tiers[0] fit).
struct MmapDirChoice {
  std::string dir;
  std::string note;
};

// Parse "8G" / "512M" / "1024" / "1.5G" into a positive byte count. On success
// returns the count and leaves `err` empty; on failure returns 0 and sets `err`
// to the argparse-style message. Fractional values truncate (1.5G -> whole
// bytes).
long long parse_size(const std::string& spec, std::string& err);

// L26/F2: the physical shared mmap is one V-scratch page (HYBRID_V_SCRATCH_BYTES)
// larger than the program's --mem-size, so the V-register transport page sits
// just ABOVE the program's declared RAM. No program layout -- low stack, top-of-
// RAM stack, or a heap grown to the ceiling -- can reach a page past its own
// RAM, so the scratch can never be clobbered. The vsim side parks the scratch
// at the mmap's top page (v_scratch_gpa), which equals ram_base + program_bytes.
long long physical_mmap_bytes(long long program_bytes);

// The largest --mem-size whose physical mmap still fits the 2 GiB AE350 DRAM
// window (program_bytes + scratch page <= 2 GiB). --mem-size is capped here.
long long max_program_mem_bytes();

// U10b/U10e: ceiling check for `--mode fast --runtime linux`. With ram_base
// support the guest addresses the contiguous high view -- DRAM alias (2 GiB)
// + DRAM_EXT (14 GiB) from 0x8_00000000 -- so the ceiling is 16 GiB (QEMU
// AE350 refuses more anyway, but failing here beats staging first). Returns
// "" when `spec` is empty (the 1G default applies later), malformed
// (qemu_m_args owns that error), or within the window; otherwise a
// ready-to-print message. Hybrid mode keeps its own separate 2 GiB cap.
std::string fast_linux_mem_error(const std::string& spec);

// U10e: the guest RAM base fast+linux hands vlinux for a given --mem-size.
// At or below 2 GiB the historical flat-from-zero map is kept so every
// known-good run stays byte-identical; above it RAM must live in the high
// window, where DRAM_ALIAS + DRAM_EXT are contiguous from 0x8_00000000.
uint64_t fast_linux_ram_base(long long mem_bytes);

// U10f: the guest RAM base hybrid hands vlinux AND the legs (QEMU backend
// placement, vsim --shared-mem-base) for a given --mem-size. While program +
// V-scratch page fit the low 2 GiB window the flat-from-zero map is kept, so
// every recorded cycle number stays comparable; past it RAM moves to
// 0x8_00000000 (needs a BIU >= 36-bit engine; ax46mpv_fpga_l3 is 39 since
// 2026-07-29).
uint64_t hybrid_ram_base(long long mem_bytes);

// First-fit resolver over `tiers`. `probe(dir)` returns the dir's free bytes,
// or -1 when it does not exist. A tier fits when probe >= size + margin.
// On success `err` is empty; when nothing fits, returns {"", ""} and `err`
// names every tier's reason plus the HSIM_MMAP_DIR hint. Pure: no env, no
// filesystem -- testable with a fake probe.
MmapDirChoice resolve_mmap_dir(
    const std::vector<MmapTier>& tiers, long long size,
    const std::function<long long(const std::string&)>& probe,
    std::string& err);

// The andesim cache root: $XDG_CACHE_HOME/andesim, else ~/.cache/andesim,
// else "" (no HOME). Shared by the mmap tier list and the repro bundles.
std::string andesim_cache_dir();

// Build the real tier list from the environment:
//   HSIM_MMAP_DIR set -> that single pinned tier;
//   else            -> /dev/shm, then $XDG_CACHE_HOME|~/.cache + /andesim
//                      (created here so the free-space probe can see it).
std::vector<MmapTier> mmap_tiers();

// WSL2 advice for `doctor`: given /proc/version contents, the repo dir, and
// the mmap tier list, return warning lines. Empty when not on WSL2. On WSL2:
// always the .wslconfig memory= hint (tmpfs is capped by the WSL VM), plus a
// drvfs warning for the repo or any tier dir under /mnt/ (slow, and
// MAP_SHARED is not coherent across the 9p boundary). Pure -- testable.
std::vector<std::string> wsl_warnings(const std::string& proc_version,
                                      const std::string& repo_dir,
                                      const std::vector<MmapTier>& tiers);

// Convert a --mem-size spec into the fast leg's plain QEMU `-m` argv:
// {"-m", "<MiB>M"}. Empty spec -> {} with no error (QEMU as-is). Malformed
// specs and sizes that are not a whole MiB (QEMU's -m granularity) return {}
// and set `err`.
std::vector<std::string> qemu_m_args(const std::string& spec, std::string& err);

// Allocate a sparse mmap file of `size` bytes in the resolved dir (mkstemp +
// truncate), log one debug-level "[andesim] mmap <size> at <dir> (free:
// <free>)" line (plus " (fallback: <why>)" when /dev/shm was skipped), and
// return its path. On failure returns "" and sets `err`. Caller owns the
// file (unlink when done).
std::string allocate(long long size, std::string& err,
                     const std::string& prefix = "hsim-shm.");

}  // namespace andes_sim

#endif  // ANDESIM_SHM_HPP
