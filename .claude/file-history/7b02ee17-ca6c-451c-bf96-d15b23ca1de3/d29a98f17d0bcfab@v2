// Standalone replica of gated_delta_net_one_chunk's kda=false math (K=1,
// n_tokens=1), computed two ways inside ONE binary:
//   A) through the real inlined vec helpers (RVV codegen when -march has V)
//   B) plain scalar reference loops
// Divergence of A vs B in the RVV binary = standalone miscompile repro.
#include <cstdio>
#include <cstring>
#include <cmath>
#include "vec.h"

extern "C" { float ggml_table_f32_f16[1 << 16]; }

enum { SV = 128 };

static unsigned rs = 1234567;
static float frand() { rs = rs * 1664525u + 1013904223u; return ((rs >> 8) & 0xffff) / 65536.0f - 0.5f; }

static float s_init[SV * SV], q[SV], k[SV], v[SV];
static float sA[SV * SV], sB[SV * SV], attnA[SV], attnB[SV];
static float deltaA[SV], deltaB[SV];

int main() {
    for (int i = 0; i < SV * SV; ++i) s_init[i] = frand() * 0.1f;
    for (int i = 0; i < SV; ++i) { q[i] = frand(); k[i] = frand(); v[i] = frand(); }
    const float g = -1.75f, beta = 0.62f;
    const float scale = 1.0f / sqrtf((float) SV);

    // ---- A: helper-based (mirrors the kernel exactly) ----
    memcpy(sA, s_init, sizeof(sA));
    ggml_vec_scale_f32(SV * SV, sA, expf(g));
    for (int j = 0; j < SV; ++j) {
        float sum = 0.0f;
        ggml_vec_dot_f32(SV, &sum, 0, &sA[j * SV], 0, k, 0, 1);
        deltaA[j] = (v[j] - sum) * beta;
    }
    for (int j = 0; j < SV; ++j) {
        ggml_vec_mad_f32(SV, &sA[j * SV], k, deltaA[j]);
    }
    for (int j = 0; j < SV; ++j) {
        float sum = 0.0f;
        ggml_vec_dot_f32(SV, &sum, 0, &sA[j * SV], 0, q, 0, 1);
        attnA[j] = sum * scale;
    }

    // ---- B: plain scalar reference ----
    memcpy(sB, s_init, sizeof(sB));
    {
        const float e = expf(g);
        for (int i = 0; i < SV * SV; ++i) sB[i] *= e;
        for (int j = 0; j < SV; ++j) {
            float sum = 0.0f;
            for (int i = 0; i < SV; ++i) sum += sB[j * SV + i] * k[i];
            deltaB[j] = (v[j] - sum) * beta;
        }
        for (int j = 0; j < SV; ++j)
            for (int i = 0; i < SV; ++i) sB[j * SV + i] += k[i] * deltaB[j];
        for (int j = 0; j < SV; ++j) {
            float sum = 0.0f;
            for (int i = 0; i < SV; ++i) sum += sB[j * SV + i] * q[i];
            attnB[j] = sum * scale;
        }
    }

    double da = 0, db = 0, worst = 0;
    int wi = -1;
    for (int j = 0; j < SV; ++j) {
        da += attnA[j]; db += attnB[j];
        double d = fabs((double) attnA[j] - attnB[j]);
        if (d > worst) { worst = d; wi = j; }
    }
    printf("attn sums: A=%.9g B=%.9g  worst |A-B|=%g at j=%d (A=%g B=%g)\n",
           da, db, worst, wi, wi >= 0 ? attnA[wi] : 0.f, wi >= 0 ? attnB[wi] : 0.f);
    double sa = 0, sb = 0;
    for (int i = 0; i < SV * SV; ++i) { sa += sA[i]; sb += sB[i]; }
    printf("state sums: A=%.9g B=%.9g\n", sa, sb);
    return 0;
}
