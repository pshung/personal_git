            <tr><td>repack</td><td>0.818</td><td>0.829</td><td>0.815</td></tr>
            <tr><td>+ prefetch</td><td>0.528</td><td>0.529</td><td>0.519</td></tr>
            <tr><td>+ vd4dots (F9)</td><td>0.138</td><td>0.155</td><td>0.146</td></tr>
          </tbody>
