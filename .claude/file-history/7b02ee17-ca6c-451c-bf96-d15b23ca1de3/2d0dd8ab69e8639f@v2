// Unit harness for the f32 vec helpers the gated_delta_net kernel uses.
// Compile once with -march=rv64gcv (RVV branches) and once with rv64gc
// (generic), run both under qemu-user, diff the printed sums exactly.
#include <cstdio>
#include <cstring>
#include "vec.h"

// fp16 lookup table normally defined in ggml.c; unused by the f32 helpers
extern "C" { float ggml_table_f32_f16[1 << 16]; }

static float frand(unsigned & s) {
    s = s * 1664525u + 1013904223u;
    return ((s >> 8) & 0xffff) / 65536.0f - 0.5f;
}

int main() {
    const int ns[] = {7, 17, 31, 64, 100, 128, 192, 255, 256, 300, 512, 1024, 4096, 16384};
    for (int n : ns) {
        unsigned seed = 42;
        static float x[16384], y[16384], g[16384], acc[16384];
        for (int i = 0; i < 16384; ++i) {
            x[i] = frand(seed);
            y[i] = frand(seed);
            g[i] = frand(seed);
            acc[i] = frand(seed);
        }
        float dot = 0.0f;
        ggml_vec_dot_f32(n, &dot, 0, x, 0, y, 0, 1);

        static float mad[16384];
        memcpy(mad, acc, sizeof(mad));
        ggml_vec_mad_f32(n, mad, x, 0.3125f);

        static float scl[16384];
        memcpy(scl, acc, sizeof(scl));
        ggml_vec_scale_f32(n, scl, 1.0f / 3.0f);

        static float mul[16384];
        memcpy(mul, acc, sizeof(mul));
        ggml_vec_mul_f32(n, mul, mul, g);   // in-place, as the kernel calls it

        double smad = 0, sscl = 0, smul = 0;
        for (int i = 0; i < n; ++i) { smad += mad[i]; sscl += scl[i]; smul += mul[i]; }
        printf("n=%3d dot=%.9g mad=%.9g scale=%.9g mul=%.9g\n",
               n, dot, smad, sscl, smul);
    }
    return 0;
}
