#!/usr/bin/env bash
# F1 (ROADMAP_hvm): vsim's --hvm backdoor load must land in the RTL HVM SRAM
# banks and SURVIVE elaboration (sc_start) + sim.reset(), so the guest reads
# the loaded content through the 0x90000000 subordinate-port aperture (hart
# load -> mem_bfm -> interconnect -> hvm_bfm -> HVM SRAM; the transport
# itself uses backdoor pokes on this side).
#
#   Run 1: --hvm with a pattern .bin -> hvm_readback exits 0.
#   Run 2 (negative control): no --hvm -> HVM is reset-empty -> the SAME
#          fixture exits nonzero (proves the probe really reads HVM).
#
# Premium-engine geometry (the default VSIM_BIN): 256KB, 2 banks, bank =
# addr[17]. The pattern offsets mirror hvm_readback.c's probes: bank0 head
# 0x0 / tail 0x1FFFC, bank1 head 0x20000 / tail 0x3FFFC -- head+tail of BOTH
# banks pins the backdoor's bank split and row/lane byte order (R2).
#
# Required environment (auto-detected with sensible defaults):
#   VSIM_BIN   sim_ax45mpv_premium
#   VSIM_ELF   the hvm_readback fixture (FIXTURE=hvm_readback)

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
. "$SCRIPT_DIR/../lib/paths.sh"

FIXTURE="${FIXTURE:-hvm_readback}"
hybrid_resolve_paths

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

put_word_le() {  # $1 file, $2 byte offset, $3 32-bit value
  local v=$3 bytes="" i
  for i in 0 8 16 24; do
    bytes+=$(printf '\\x%02x' $(( (v >> i) & 0xff )))
  done
  # shellcheck disable=SC2059
  printf "$bytes" | dd of="$1" bs=1 seek="$2" conv=notrunc status=none
}

truncate -s 262144 "$WORK/hvm.bin"
put_word_le "$WORK/hvm.bin" 0           $((0x48564D30))   # bank0 head "HVM0"
put_word_le "$WORK/hvm.bin" $((0x1FFFC)) $((0x48564D31))  # bank0 tail "HVM1"
put_word_le "$WORK/hvm.bin" $((0x20000)) $((0x48564D32))  # bank1 head "HVM2"
put_word_le "$WORK/hvm.bin" $((0x3FFFC)) $((0x48564D33))  # bank1 tail "HVM3"

# --- Run 1: loaded HVM -> probe passes ---
timeout 600 "$VSIM_BIN" --hvm "$WORK/hvm.bin" "$VSIM_ELF" >"$WORK/run1.log" 2>&1
RC=$?
if [ "$RC" -ne 0 ]; then
  echo "FAIL[vsim_hvm_load]: probe exit=$RC (1=bank0 head, 2=bank0 tail," \
       "3=bank1 head, 4=bank1 tail)"
  tail -15 "$WORK/run1.log"
  exit 1
fi

# --- Run 2: negative control, empty HVM -> the same probe must FAIL ---
timeout 600 "$VSIM_BIN" "$VSIM_ELF" >"$WORK/run2.log" 2>&1
RC=$?
if [ "$RC" -eq 0 ]; then
  echo "FAIL[vsim_hvm_load]: probe passed with NO --hvm (reads are not hitting HVM)"
  tail -15 "$WORK/run2.log"
  exit 1
fi

# --- Describe gating: hvm_size advertises the HVM TRANSPORT, so it must be
# non-zero only when the wrapper implements the set_hvm/get_hvm backdoor
# pair (the ax46 F3 regression lesson: config has the memory, wrapper has no
# backdoor -> must report 0 or the driver would pass --hvm and load_image
# would throw). Field extraction rides the shared hybrid_describe_int.
if [ "$(hybrid_describe_int hvm_size)" != 262144 ]; then
  echo "FAIL[vsim_hvm_load]: premium --describe does not report hvm_size 262144"
  exit 1
fi
AX46="$(dirname "$VSIM_BIN")/sim_ax46mpv_advanced"
if [ -x "$AX46" ]; then
  if [ "$(hybrid_describe_int hvm_size "$AX46")" != 0 ]; then
    echo "FAIL[vsim_hvm_load]: ax46 (no set_hvm/get_hvm backdoor) must describe hvm_size 0"
    exit 1
  fi
fi

echo "PASS[vsim_hvm_load]"
