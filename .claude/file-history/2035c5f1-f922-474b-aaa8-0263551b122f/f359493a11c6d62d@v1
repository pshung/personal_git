#if _NDS_ILM_SIZE_KB > 0
#define SIZE _NDS_ILM_SIZE_KB
  /**
   * @brief Set ILM (Instruction Local Memory) content with ECC/parity code
   * generation
   *
   * This function loads instruction data into the ILM and automatically
   * generates and appends ECC or parity codes based on the ILM_ECC_TYPE
   * configuration.
   *
   * Reference: external/ax45mpv_premium/testbench/ae350_tb.sv lines 1813-1853
   *
   * Supported configurations:
   * - rv32i + ecc: Appends 7-bit ECC code to bits [38:32]
   * - rv32i + parity: Appends 4-bit parity to bits [35:32]
   * - rv64i + ecc: Appends 8-bit ECC code to bits [71:64]
   * - rv64i + parity: Appends 8-bit parity to bits [71:64]
   * - none: No code generation, data written as-is
   *
   * @tparam SIZE ILM size in bytes (must match NDS_ILM_SIZE_KB * 1024)
   * @param data Vector of bytes to load into ILM (little-endian)
   */
  void set_ilm(const std::vector<uint8_t>& data)
  {
    if (data.size() > SIZE) {
      throw std::runtime_error("ILM data size (" + std::to_string(data.size())
                               + " bytes) exceeds ILM capacity ("
                               + std::to_string(SIZE) + " bytes)");
    }

    constexpr bool is_64bit = (NDS_ILM_DATA_WIDTH == 64);
    constexpr size_t word_size = is_64bit ? 8 : 4;
    constexpr size_t word_count = SIZE / word_size;
    using word_t = std::conditional_t<is_64bit, uint64_t, uint32_t>;

    spdlog::info("Setting ILM content: size={} bytes, XLEN={}, ECC_TYPE={}",
                 SIZE, NDS_XLEN, NDS_ILM_ECC_TYPE);

    auto& mem =
      this
        ->rootp
#ifdef _NDS_IO_ILM_TL_UL
        ->ae350_vcpu_cluster_subsystem__DOT__gen_tl_ul_core0_ram0__DOT__u_ilm_tl_ul_core0_ram0__DOT__ram_inst__DOT__mem;
#else
        ->ae350_vcpu_cluster_subsystem__DOT__u_cluster__DOT__u_complex0__DOT__u_core0__DOT__u_ilm_ram0__DOT__ram_inst__DOT__mem;
#endif // _NDS_IO_ILM_TL_UL

    for (size_t i = 0; i < word_count; ++i) {
      const size_t byte_idx = i * word_size;

      // Read word (handle partial data with zero-fill)
      word_t word = 0;
      for (size_t j = 0; j < word_size && byte_idx + j < data.size(); ++j) {
        word |= static_cast<word_t>(data[byte_idx + j]) << (j * 8);
      }

      // Generate and append ECC code
#if _NDS_ILM_ECC_TYPE_INT == 2
#if _NDS_ILM_DATA_WIDTH == 64
      VL_SET_WQ(mem[i], word);
      mem[i][2] = ecc::ecc64_gen(word);
#else // _NDS_ILM_DATA_WIDTH == 32
      mem[i] = (ecc::ecc32_gen(word) << 32) | word;
#endif
#else // no ECC
      mem[i] = word;
#endif
    }

    spdlog::info("ILM loaded: {} x {}-bit words", word_count, word_size * 8);
  }
#undef SIZE
#endif // _NDS_ILM_SIZE_KB > 0

