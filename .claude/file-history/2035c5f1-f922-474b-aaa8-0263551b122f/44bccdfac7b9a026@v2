// Unit tests for the minimal JSON parser (driver/json.hpp).
//
// The parser exists because the framework may depend only on libc++ + the
// shared ABI header -- no third-party JSON library. It must handle the engine
// descriptor shape (objects, string/number values, arrays of strings, one
// nested object) plus the usual literals and whitespace.
#include <string>

#include "engine_descriptor.hpp"
#include "json.hpp"
#include "test_check.hpp"

using namespace andes_sim;

int main() {
  // A representative engine descriptor.
  const char* doc = R"({
    "id": "verilator:ax45mpv_premium",
    "type": "verilator",
    "kind": "cycle-accurate",
    "vlen": 512, "xlen": 64,
    "triggers": ["marker", "pc", "icount"],
    "roles": ["standalone", "accurate-leg"],
    "state": ["resume", "drain"],
    "invoke": {
      "standalone": ["{bin}", "{elf}"],
      "accurate-leg": ["{bin}", "--resume-from-qemu", "{state_in}"]
    },
    "result": "stderr:cycles"
  })";

  json::Parsed p = json::parse(doc);
  CHECK(p.ok);
  CHECK(p.value.is_object());

  const json::Value& v = p.value;
  CHECK(v.find("id") != nullptr);
  CHECK(v.find("id")->as_string() == "verilator:ax45mpv_premium");
  CHECK(v.find("type")->as_string() == "verilator");
  CHECK(v.find("vlen")->is_number());
  CHECK(v.find("vlen")->as_int() == 512);
  CHECK(v.find("xlen")->as_int() == 64);
  CHECK(v.find("missing") == nullptr);

  // arrays of strings
  const json::Value* trig = v.find("triggers");
  CHECK(trig && trig->is_array());
  std::vector<std::string> trigs = trig->as_string_array();
  CHECK(trigs.size() == 3);
  CHECK(trigs[0] == "marker" && trigs[2] == "icount");

  // nested object + nested array
  const json::Value* inv = v.find("invoke");
  CHECK(inv && inv->is_object());
  const json::Value* leg = inv->find("accurate-leg");
  CHECK(leg && leg->is_array());
  CHECK(leg->as_string_array().size() == 3);
  CHECK(leg->as_string_array()[1] == "--resume-from-qemu");

  // literals + escapes + whitespace tolerance
  {
    json::Parsed q = json::parse(R"({"a":true,"b":false,"c":null,"d":-3.5})");
    CHECK(q.ok);
    CHECK(q.value.find("a")->type == json::Value::Type::Bool);
    CHECK(q.value.find("a")->b == true);
    CHECK(q.value.find("c")->type == json::Value::Type::Null);
    CHECK(q.value.find("d")->is_number());
  }
  {
    json::Parsed q = json::parse(R"("a\tb\"c")");
    CHECK(q.ok);
    CHECK(q.value.is_string());
    CHECK(q.value.str == "a\tb\"c");
  }
  {
    json::Parsed q = json::parse("   [ 1 , 2 ,3 ]  ");
    CHECK(q.ok);
    CHECK(q.value.is_array());
    CHECK(q.value.arr.size() == 3);
  }

  // --- descriptor_from_json: RVV hardware params (vlen/dlen/elen/xlen) ---
  {
    json::Parsed q = json::parse(R"({
      "id": "verilator:x", "type": "verilator",
      "vlen": 512, "dlen": 256, "elen": 32, "xlen": 64
    })");
    CHECK(q.ok);
    EngineDescriptor d;
    CHECK(descriptor_from_json(q.value, d).empty());
    CHECK(d.vlen == 512);
    CHECK(d.dlen == 256);
    CHECK(d.elen == 32);
    CHECK(d.xlen == 64);
  }
  {  // params absent -> 0 ("not reported"), not an error
    json::Parsed q = json::parse(R"({"id": "qemu", "type": "qemu"})");
    CHECK(q.ok);
    EngineDescriptor d;
    CHECK(descriptor_from_json(q.value, d).empty());
    CHECK(d.vlen == 0 && d.dlen == 0 && d.elen == 0 && d.xlen == 0);
  }

  // --- descriptor_from_json: andes_csrs (engine's supported Andes CSR list) ---
  {
    json::Parsed q = json::parse(R"({
      "id": "verilator:x", "type": "verilator",
      "andes_csrs": ["uitb", "jvt", "milmb", "mdlmb"]
    })");
    CHECK(q.ok);
    EngineDescriptor d;
    CHECK(descriptor_from_json(q.value, d).empty());
    CHECK(d.andes_csrs.size() == 4);
    CHECK(d.andes_csrs[0] == "uitb");
    CHECK(d.andes_csrs[3] == "mdlmb");
  }
  {  // andes_csrs absent -> empty (verify compares all Andes CSRs), not an error
    json::Parsed q = json::parse(R"({"id": "qemu", "type": "qemu"})");
    CHECK(q.ok);
    EngineDescriptor d;
    CHECK(descriptor_from_json(q.value, d).empty());
    CHECK(d.andes_csrs.empty());
  }

  // --- descriptor_from_json: ilm_size/dlm_size (LM content transport F3) ---
  {  // byte counts of the engine's hart-0 local memories
    json::Parsed q = json::parse(R"({
      "id": "verilator:x", "type": "verilator",
      "ilm_size": 65536, "dlm_size": 32768
    })");
    CHECK(q.ok);
    EngineDescriptor d;
    CHECK(descriptor_from_json(q.value, d).empty());
    CHECK(d.ilm_size == 65536);
    CHECK(d.dlm_size == 32768);
  }
  {  // absent -> 0 (engine without local memories), not an error
    json::Parsed q = json::parse(R"({"id": "qemu", "type": "qemu"})");
    CHECK(q.ok);
    EngineDescriptor d;
    CHECK(descriptor_from_json(q.value, d).empty());
    CHECK(d.ilm_size == 0 && d.dlm_size == 0);
  }

  // malformed inputs fail (do not crash, ok=false)
  for (const char* bad : {"{", "{\"a\":}", "[1,2", "tru", "\"unterminated",
                          "{\"a\" 1}", ""}) {
    json::Parsed q = json::parse(bad);
    CHECK(!q.ok);
  }

  return andes_sim::test::report("json parse");
}
