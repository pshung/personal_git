// EngineDescriptor: the parsed result of an engine's `--describe` (or its
// sidecar <bin>.json). This struct IS the contract that QEMU, Verilator, and
// future engines (alioth, sid) speak to join the framework -- see
// docs/engine_interface.md. The framework keeps zero per-engine code; every
// capability it needs comes from here.
#ifndef ANDESIM_ENGINE_DESCRIPTOR_HPP
#define ANDESIM_ENGINE_DESCRIPTOR_HPP

#include <string>
#include <string_view>
#include <vector>

#include "json.hpp"

namespace andes_sim {

// One role's argv template, e.g. role "accurate-leg" -> {"{bin}",
// "--resume-from-qemu", "{state_in}", ...}. {placeholders} are filled by the
// plan executor (F6).
struct EngineInvoke {
  std::string role;
  std::vector<std::string> argv;
};

struct EngineDescriptor {
  std::string id;                       // "qemu", "verilator:ax45mpv_premium"
  std::string type;                     // qemu | verilator | alioth | sid
  std::string kind;                     // functional | cycle-accurate
  long vlen = 0;                        // RVV params; 0 = not reported
  long dlen = 0;
  long elen = 0;
  long xlen = 0;
  std::vector<std::string> triggers;    // marker | pc
  std::vector<std::string> roles;       // standalone | fast-leg | accurate-leg
  std::vector<std::string> state;       // resume | drain (hybrid_state_v1 caps)
  std::vector<std::string> andes_csrs;  // Andes CSRs this engine implements; the
                                        // --verify gate (empty = compare all)
  std::vector<EngineInvoke> invoke;     // argv template per role
  std::string result;                   // stderr:<re> | state.mcycle

  // Filled by the registry, not present in the JSON:
  std::string bin_path;                 // resolved path to the binary
  std::string source;                   // built-in | --describe | sidecar

  const std::vector<std::string>* invoke_for(std::string_view role) const {
    for (const EngineInvoke& iv : invoke)
      if (iv.role == role) return &iv.argv;
    return nullptr;
  }
};

// Build a descriptor from parsed JSON. Returns "" on success or an error
// message naming the first problem (id and type are required).
inline std::string descriptor_from_json(const json::Value& v,
                                        EngineDescriptor& out) {
  if (!v.is_object()) return "descriptor is not a JSON object";

  const json::Value* id = v.find("id");
  if (!id || !id->is_string() || id->str.empty()) return "missing string 'id'";
  out.id = id->as_string();

  const json::Value* type = v.find("type");
  if (!type || !type->is_string()) return "missing string 'type'";
  out.type = type->as_string();

  if (const json::Value* x = v.find("kind")) out.kind = x->as_string();
  if (const json::Value* x = v.find("vlen")) out.vlen = x->as_int();
  if (const json::Value* x = v.find("dlen")) out.dlen = x->as_int();
  if (const json::Value* x = v.find("elen")) out.elen = x->as_int();
  if (const json::Value* x = v.find("xlen")) out.xlen = x->as_int();
  if (const json::Value* x = v.find("triggers")) out.triggers = x->as_string_array();
  if (const json::Value* x = v.find("roles")) out.roles = x->as_string_array();
  if (const json::Value* x = v.find("state")) out.state = x->as_string_array();
  if (const json::Value* x = v.find("andes_csrs"))
    out.andes_csrs = x->as_string_array();
  if (const json::Value* x = v.find("result")) out.result = x->as_string();

  if (const json::Value* inv = v.find("invoke"); inv && inv->is_object()) {
    for (size_t k = 0; k < inv->keys.size(); ++k)
      out.invoke.push_back({inv->keys[k], inv->vals[k].as_string_array()});
  }
  return "";
}

}  // namespace andes_sim

#endif  // ANDESIM_ENGINE_DESCRIPTOR_HPP
