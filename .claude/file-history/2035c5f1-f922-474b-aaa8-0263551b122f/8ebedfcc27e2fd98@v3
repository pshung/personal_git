#!/usr/bin/env bash
# LM transport (F0/F1) + HVM transport (F2) contract: the QEMU plugin drains
# ILM/DLM/HVM CONTENT into raw sidecar files next to the state outfile. The
# lm_drain fixture writes known patterns into the hart-0 LM slave ports (ILM
# 0xA0000000, DLM 0xA0200000) and the HVM aperture (0x90000000) at the first
# and last word of each drained span; the plugin, given the *_size= args,
# must write <outfile>.ilm (65536 B), .dlm (32768 B) and .hvm (262144 B)
# carrying those patterns. A run WITHOUT the size args (the no-LM/HVM-engine
# default) must produce NO sidecar files. QEMU's default HVM is 1 byte
# (hvm_size_pow_2=0), so both runs sync the geometry via -global -- the raw
# analog of the driver's -readconfig path, which already carries it.
#
# Required environment (auto-detected with sensible defaults):
#   VSIM_QEMU    qemu-system-riscv64
#   VSIM_PLUGIN  libhybrid_handoff.so
#   VSIM_ELF     the lm_drain fixture (FIXTURE=lm_drain)

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
. "$SCRIPT_DIR/../lib/paths.sh"

FIXTURE="${FIXTURE:-lm_drain}"
hybrid_resolve_paths

SHARED_SIZE=$((128 * 1024 * 1024))
SHARED_MEM=$(mktemp -p /dev/shm vsim-plugin-lm-shared.XXXXXX)
STATE_DIR=$(mktemp -d)
STATE_QEMU="$STATE_DIR/state.bin"
QEMU_LOG=$(mktemp)
trap 'rm -f "$SHARED_MEM" "$QEMU_LOG"; rm -rf "$STATE_DIR"' EXIT
truncate -s "$SHARED_SIZE" "$SHARED_MEM"

run_qemu() {  # $1 = extra plugin args appended after outfile ("" for none)
  set +e
  "$VSIM_QEMU" \
    -object "memory-backend-file,id=mem,share=on,mem-path=$SHARED_MEM,size=$SHARED_SIZE" \
    -machine andes_ae350,memory-backend=mem \
    -global driver=riscv.andes.ae350.soc,property=hvm_size_pow_2,value=18 \
    -cpu andes-ax45mpv,vlen=512 \
    -nographic \
    -semihosting-config enable=on,target=native \
    -bios "$VSIM_ELF" \
    -plugin "$VSIM_PLUGIN,outfile=$STATE_QEMU$1" >"$QEMU_LOG" 2>&1
  RC=$?
  set -e
}

check_word() {  # $1 file, $2 byte offset, $3 expected LE word (8 hex digits)
  local got
  got=$(od -An -tx4 -j "$2" -N4 "$1" | tr -d ' \n')
  if [ "$got" != "$3" ]; then
    echo "FAIL[plugin_lm_drain]: $1 @ offset $2 = '$got', want '$3'"
    exit 1
  fi
}

# --- Run 1: sizes given -> sidecars written with the fixture's patterns ---
run_qemu ",ilm_size=65536,dlm_size=32768,hvm_size=262144"
if [ "$RC" -ne 200 ]; then
  echo "FAIL[plugin_lm_drain]: expected QEMU exit=200 on drain, got $RC"
  echo "--- qemu log ---"; cat "$QEMU_LOG"
  exit 1
fi
for spec in "$STATE_QEMU.ilm:65536" "$STATE_QEMU.dlm:32768" \
            "$STATE_QEMU.hvm:262144"; do
  path="${spec%:*}"; want="${spec#*:}"
  if [ ! -f "$path" ]; then
    echo "FAIL[plugin_lm_drain]: missing sidecar $path"; exit 1
  fi
  size=$(stat -c%s "$path")
  if [ "$size" -ne "$want" ]; then
    echo "FAIL[plugin_lm_drain]: $path size=$size want=$want"; exit 1
  fi
done
check_word "$STATE_QEMU.ilm" 0     494c4d30   # "ILM0" at window start
check_word "$STATE_QEMU.ilm" 65532 494c4d31   # "ILM1" at last drained word
check_word "$STATE_QEMU.dlm" 0     444c4d30   # "DLM0" at window start
check_word "$STATE_QEMU.dlm" 32764 444c4d31   # "DLM1" at last drained word
check_word "$STATE_QEMU.hvm" 0      48564d30  # "HVM0" at window start
check_word "$STATE_QEMU.hvm" 262140 48564d31  # "HVM1" at last drained word

# --- Run 2: no size args (default 0 = no-LM/HVM engine) -> NO sidecar files ---
rm -f "$STATE_QEMU" "$STATE_QEMU.ilm" "$STATE_QEMU.dlm" "$STATE_QEMU.hvm"
run_qemu ""
if [ "$RC" -ne 200 ]; then
  echo "FAIL[plugin_lm_drain]: (no-size run) expected exit=200, got $RC"
  echo "--- qemu log ---"; cat "$QEMU_LOG"
  exit 1
fi
if [ -e "$STATE_QEMU.ilm" ] || [ -e "$STATE_QEMU.dlm" ] \
   || [ -e "$STATE_QEMU.hvm" ]; then
  echo "FAIL[plugin_lm_drain]: sidecar files written without *_size args"
  exit 1
fi

echo "PASS[plugin_lm_drain]"
