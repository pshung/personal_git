/* F2 debug probe v2 (not committed): enable ILM/DLM like real TCM firmware,
 * then discriminate.
 *   exit 5: milmb.EN write did not stick
 *   exit 6: slave-port read misses with EN on -> set_ilm poke wiped/wrong array
 *   exit 1: slave-port sees it, hart-local does not -> local-view routing
 *   exit 0: both views see the pattern
 */
#include <stdint.h>

#define RD(a) (*(volatile uint32_t *)(uintptr_t)(a))

int main(void)
{
  uint64_t v;
  __asm__ volatile("csrr %0, 0x7c0" : "=r"(v));
  __asm__ volatile("csrw 0x7c0, %0" :: "r"(v | 1));   /* milmb.EN=1 */
  __asm__ volatile("csrr %0, 0x7c1" : "=r"(v));
  __asm__ volatile("csrw 0x7c1, %0" :: "r"(v | 1));   /* mdlmb.EN=1 */
  __asm__ volatile("fence" ::: "memory");

  __asm__ volatile("csrr %0, 0x7c0" : "=r"(v));
  if (!(v & 1)) return 5;
  if (RD(0xA0000010u) != 0x494C4D30u) return 6;
  if (RD(0x000010u)   != 0x494C4D30u) return 1;
  return 0;
}
