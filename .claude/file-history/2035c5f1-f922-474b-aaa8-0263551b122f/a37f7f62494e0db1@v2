#!/usr/bin/env bash
# B13 lint: the plugin's atomic state writer must use mkstemp (or
# mkostemp / g_mkstemp), not a getpid()-based tmp filename.
#
# Under heavy PID churn (test runner forking 128 QEMUs per minute on a
# 128-core host) PID reuse can shadow a still-open tmp from a sibling
# leg. mkstemp adds a 6-char random suffix and atomically reserves the
# inode, eliminating the race window.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SRC="$SCRIPT_DIR/../../qemu_plugin/hybrid_handoff.c"

fail() { echo "FAIL[plugin_atomic_write_mkstemp]: $1"; exit 1; }

[ -r "$SRC" ] || fail "cannot read $SRC"

# The tmp-file mechanics live in write_blob_atomic (shared by the state file
# and the LM sidecars); write_state_atomic must route through it. Inspect only
# those two function bodies so unrelated getpid() uses elsewhere in the file
# are not in scope.
blob=$(awk '/^static int write_blob_atomic/,/^}/' "$SRC")
[ -n "$blob" ] || fail "write_blob_atomic body not located"

if echo "$blob" | grep -q "getpid()"; then
  fail "write_blob_atomic still composes tmp filename with getpid(); use mkstemp"
fi

if ! echo "$blob" | grep -qE "mkstemp|g_mkstemp|mkostemp"; then
  fail "write_blob_atomic does not call mkstemp; PID collisions possible"
fi

state=$(awk '/^static int write_state_atomic/,/^}/' "$SRC")
[ -n "$state" ] || fail "write_state_atomic body not located"

if ! echo "$state" | grep -qE "write_blob_atomic|mkstemp|g_mkstemp|mkostemp"; then
  fail "write_state_atomic bypasses write_blob_atomic; PID collisions possible"
fi

echo "[plugin_atomic_write_mkstemp] PASS"
