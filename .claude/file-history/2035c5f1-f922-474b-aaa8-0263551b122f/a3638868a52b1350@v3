/* LM-load probe (ILM/DLM transport F2): vsim's --ilm/--dlm backdoor load must
 * be visible to the guest AFTER elaboration (sc_start) and sim.reset(). Like
 * real TCM firmware, the probe first ENABLES the local memories (premium RTL
 * resets milmb/mdlmb.EN=0 -- measured, not spec'd), then reads the pattern
 * words the harness placed in the .bin files through the HART-LOCAL view --
 * premium geometry: ILM 0x0..0xFFFF (64KB), DLM 0x200000..0x207FFF (32KB).
 * The ILM head probe sits at 0x10, not 0x0, so no pointer is the C NULL
 * address. Exit code names the first failure; 0 = all four words intact. The
 * same binary doubles as the negative control: with no --ilm/--dlm the TCM is
 * reset-empty and this exits nonzero. */
#include "runtime/rt_c_helpers.h"

#include <stdint.h>

#define RD(a) (*(volatile uint32_t *)(uintptr_t)(a))

int main(void)
{
  uint64_t v;
  enable_ilm();
  enable_dlm();

  __asm__ volatile("csrr %0, 0x7c0" : "=r"(v));
  if (!(v & 1)) return 5;                       /* EN write did not stick */

  if (RD(0x000010u) != 0x494C4D30u) return 1;   /* ILM head ("ILM0") */
  if (RD(0x00FFFCu) != 0x494C4D31u) return 2;   /* ILM tail ("ILM1") */
  if (RD(0x200000u) != 0x444C4D30u) return 3;   /* DLM head ("DLM0") */
  if (RD(0x207FFCu) != 0x444C4D31u) return 4;   /* DLM tail ("DLM1") */
  return 0;
}
