// LM-content drain fixture (ILM/DLM transport F0/F1, HVM transport F2):
// write known patterns into the hart-0 local-memory SLAVE PORT windows (ILM
// 0xA0000000, DLM 0xA0200000) and the HVM subordinate-port aperture
// (0x90000000, AE350 memmap), then hit the ROI entry marker so the QEMU
// plugin drains. Verifies the plugin captures the content into the
// <outfile>.ilm / .dlm / .hvm sidecar files (plugin args *_size=).
//
// The LM slave port dispatches into the same mask_ilm/mask_dlm RAM the
// hart's local view uses (andes_ae350.c subport_ops), and works regardless
// of milmb/mdlmb.EN -- so this fixture needs no CSR setup. HVM is plain RAM
// (no enable bit), but its QEMU default size is 1 BYTE (hvm_size_pow_2=0):
// the harness must pass -global hvm_size_pow_2 to give the stores a target.
// Patterns land at the window start AND at the last word of the drained
// span (offset size-4), so a short drain fails the end-of-span check.

#include "semihost_exit.inc"
#include "runtime/memory_map.h"

.section .text
.globl _start
_start:
    li      t0, HART0_ILM_BASE      // hart-0 ILM slave port
    li      t1, 0x494C4D30          // "ILM0": first word of the window
    sw      t1, 0(t0)
    li      t2, 0xFFFC              // last word of the 64 KB drained span
    add     t2, t0, t2
    li      t1, 0x494C4D31          // "ILM1"
    sw      t1, 0(t2)

    li      t0, HART0_DLM_BASE      // hart-0 DLM slave port
    li      t1, 0x444C4D30          // "DLM0": first word of the window
    sw      t1, 0(t0)
    li      t2, 0x7FFC              // last word of the 32 KB drained span
    add     t2, t0, t2
    li      t1, 0x444C4D31          // "DLM1"
    sw      t1, 0(t2)

    li      t0, HVM_BASE            // HVM subordinate-port aperture
    li      t1, 0x48564D30          // "HVM0": first word of the window
    sw      t1, 0(t0)
    li      t2, 0x3FFFC             // last word of the 256 KB drained span
    add     t2, t0, t2
    li      t1, 0x48564D31          // "HVM1"
    sw      t1, 0(t2)

    fence   rw, rw
    slti    x0, x0, 0x5A0           // ROI entry: QEMU drains, exits 200
    slti    x0, x0, 0x5A1           // exit marker (unused in this drain-only test)
    li      a0, 0
    SEMIHOST_EXIT a0
