import json

TOKENS = [
    ("andes_sim/roi.h", "andes_sim/ROI.h"),
    ("andes_sim_roi_begin", "andes_sim_ROI_begin"),
    ("andes_sim_roi_end", "andes_sim_ROI_end"),
]
NBS = [
    "docs/andes_sim_tutorial.ipynb",
    "docs/andes_sim_demo.ipynb",
    "docs/andes_sim_gemm_tutorial.ipynb",
    "docs/andes_sim_memory_tutorial.ipynb",
    "docs/andes_sim_cosim_tutorial.ipynb",
    "docs/andes_sim_limitations.ipynb",
]
for nb in NBS:
    with open(nb, encoding="utf-8") as f:
        txt = f.read()
    counts = {old: txt.count(old) for old, _ in TOKENS}
    for old, new in TOKENS:
        txt = txt.replace(old, new)
    json.loads(txt)  # validate JSON still parses
    with open(nb, "w", encoding="utf-8") as f:
        f.write(txt)
    print(nb, counts)
