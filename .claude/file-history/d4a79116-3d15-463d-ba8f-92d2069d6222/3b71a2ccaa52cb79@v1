// Validate the lone-ELF positional shape the standalone models require: print
// the diagnostic and return 2 on a violation, else 0. Split out so `cycle`
// can reject a missing/extra ELF BEFORE paying for engine discovery (which
// spawns a --describe subprocess per Verilator build). `model` labels the error.
int check_one_elf(const Cli& cli, const char* model) {
  if (cli.positional.empty()) {
    std::fprintf(stderr, "andes-sim run --model %s: missing ELF\n", model);
    return 2;
  }
  if (cli.positional.size() > 1) {
    std::fprintf(stderr,
                 "andes-sim run --model %s: unexpected argument '%s' "
                 "(engine args go after --)\n",
                 model, cli.positional[1].c_str());
    return 2;
  }
  return 0;
}

// The standalone-passthrough spine shared by `fast` and `cycle`: both take a
// single ELF, then exec the resolved engine standalone with `extra` (model
// flags the framework forwards, e.g. fast's -m) followed by the post-`--`
// args verbatim (inherit stdio, no timeout, propagate exit code). The only
// per-model differences -- which engine, and how it is selected -- are resolved
// by the caller; `model` here only labels the positional diagnostics.
int run_standalone(const Cli& cli, const EngineDescriptor& eng,
                   const char* model,
                   const std::vector<std::string>& extra = {}) {
  if (int rc = check_one_elf(cli, model)) return rc;
  std::vector<std::string> args = extra;
  args.insert(args.end(), cli.passthrough.begin(), cli.passthrough.end());
  std::string err;
  int rc = run_passthrough(eng, "standalone", cli.positional[0], args, err);
  if (!err.empty()) std::fprintf(stderr, "andes-sim run: %s\n", err.c_str());
  return rc;
}

// `run --model fast`: QEMU alone, functional, transparent passthrough. Needs
// only the built-in qemu descriptor, so it resolves that directly rather than
// discover_engines(), which would spawn a --describe subprocess per Verilator
// build only to discard them all here.
int run_fast(const Cli& cli) {
  // fast is QEMU-only; an explicit engine must name it.
  if (!cli.engine.empty() && cli.engine != "qemu") {
    std::fprintf(stderr,
                 "andes-sim run --model fast: engine must be 'qemu', got '%s'\n",
                 cli.engine.c_str());
    return 2;
  }
  // --mem-size forwards a plain `-m`; QEMU validates it (as-is, no mmap, no
  // default injected). It precedes the post-`--` args, so a user's own -m wins.
  std::string err;
  const std::vector<std::string> mem = qemu_m_args(cli.mem_size, err);
  if (!err.empty()) {
    std::fprintf(stderr, "andes-sim run --model fast: %s\n", err.c_str());
    return 2;
  }
  return run_standalone(cli, builtin_qemu(), "fast", mem);
}

// Defined below run_accurate; --cosim on the cycle model dispatches to it.
int run_cosim_lockstep(const Cli& cli, const EngineDescriptor& eng);

// `run --model cycle`: one cycle-accurate engine alone, from reset (no QEMU,
// no --resume-from-qemu), transparent passthrough -- cycles surface in the
// engine's own output. Unlike fast, this must discover the Verilator build(s)
// to resolve the engine (explicit --engine, else the sole one).
int run_accurate(const Cli& cli) {
  // Reject a missing/extra ELF before discovery so a CLI typo does not spawn a
  // --describe subprocess per Verilator build only to fail on the argument.
  if (int rc = check_one_elf(cli, "cycle")) return rc;
  // --mem-size is validated but has nothing to size: the cycle engine always
  // models its full DRAM window. Say so instead of silently ignoring it.
  if (!cli.mem_size.empty()) {
    std::string se;
    if (parse_size(cli.mem_size, se); !se.empty()) {
      std::fprintf(stderr, "andes-sim run --model cycle: --mem-size: %s\n",
                   se.c_str());
      return 2;
    }
    std::fprintf(stderr,
                 "[andes-sim] --mem-size: the cycle engine models its full "
                 "DRAM window; nothing to size\n");
  }
  Discovery disc = discover_engines();
  std::string err;
  const EngineDescriptor* eng =
      resolve_accurate_engine(disc.engines, cli.engine, err);
  if (!eng) {
    std::fprintf(stderr, "andes-sim run --model cycle: %s\n", err.c_str());
    // Surface why an expected engine may be absent (failed --describe, etc.).
    for (const std::string& w : disc.warnings)
      std::fprintf(stderr, "andes-sim: skipped engine: %s\n", w.c_str());
    return 2;
  }
  // --cosim on the cycle model = lock-step DV co-sim against a QEMU oracle,
  // not a plain standalone run.
  if (cli.cosim) return run_cosim_lockstep(cli, *eng);
  return run_standalone(cli, *eng, "cycle");
}

// Parse --cosim-max-records: empty => 0 (unbounded; the oracle runs to program
// exit and defines the record count). Returns false + sets err on a bad value.
bool parse_cosim_max(const std::string& s, unsigned long long& out,
                     std::string& err) {
  out = 0;
  if (s.empty()) return true;
  char* end = nullptr;
  out = std::strtoull(s.c_str(), &end, 10);
  if (!end || *end != '\0') {
    err = "--cosim-max-records: want a non-negative integer, got '" + s + "'";
    return false;
  }
  return true;
}

// `run --model cycle --cosim`: lock-step DV co-sim (cosim_redesign F6, usage
// 1). Two independent boots of the same ELF -- the QEMU oracle (golden) and
// the vsim DUT -- each drain one full record per execution attempt from the
// arm pc; the streams are aligned by attempt index and diffed to localize the
// first diverging instruction. No handoff, no shared mmap. The oracle runs
// first (MHz-fast, defines the record count K); the DUT is then bounded to K
// so a diverged hart cannot run away.
int run_cosim_lockstep(const Cli& cli, const EngineDescriptor& eng) {
  auto fail = [](const std::string& msg) {
    std::fprintf(stderr, "andes-sim run --model cycle --cosim: %s\n",
                 msg.c_str());
    return 2;
  };
  if (int rc = check_one_elf(cli, "cycle")) return rc;

  std::error_code ec;
  const fs::path elf = fs::absolute(cli.positional[0], ec);
  if (ec || !fs::is_regular_file(elf, ec))
    return fail("ELF not found: " + cli.positional[0]);
  const std::string elf_path = elf.string();

  // Arm pc: --pc-start (symbol or 0x addr) overrides the ELF entry default.
  std::string err;
  uint64_t arm_pc = 0;
  if (cli.pc_start.empty()) {
    arm_pc = elf_entry(elf_path, err);
    if (!err.empty()) return fail(err);
  } else {
    const std::string hex = resolve_pc(elf_path, cli.pc_start, err);
    if (!err.empty()) return fail(err);
    arm_pc = std::strtoull(hex.c_str(), nullptr, 16);
  }
  char arm_buf[32];
  std::snprintf(arm_buf, sizeof(arm_buf), "0x%llx",
                static_cast<unsigned long long>(arm_pc));

  unsigned long long max_records = 0;
  if (!parse_cosim_max(cli.cosim_max_records, max_records, err))
    return fail(err);

  // Workdir for the two record streams (removed on exit).
  const fs::path wd =
      fs::temp_directory_path() /
      ("andes-cosim-ls-" + std::to_string(::getpid()));
  fs::create_directories(wd, ec);
  const std::string oracle_stream = (wd / "oracle.ckpts").string();
  const std::string dut_stream = (wd / "dut.ckpts").string();
  auto cleanup = [&] { fs::remove_all(wd, ec); };

  // Lock-step is slow on the DUT (a DMI step + full drain per attempt, tens
  // of attempts/s); give both legs a generous ceiling. --cosim-max-records
  // bounds the work; the timeout is only the runaway backstop.
  constexpr int kTimeoutMs = 1800 * 1000;

  // ---- Leg 1: QEMU oracle (golden). Standalone andes machine + the
  // lock-step plugin; outfile IS the record stream. vlen syncs from the DUT
  // engine so the V-state widths match. ----
  const std::string plugin = [&] {
    if (const char* p = std::getenv("VSIM_PLUGIN"); p && *p) return std::string(p);
    return default_plugin_path().string();
  }();
  std::string plugin_arg = plugin + ",outfile=" + oracle_stream +
                           ",lockstep_pc=" + arm_buf;
  if (max_records != 0)
    plugin_arg += ",lockstep_max=" + std::to_string(max_records);

  const std::string vlen = std::to_string(synced_vlen(eng.vlen));
  std::vector<std::string> qemu_argv = {
      builtin_qemu().bin_path, "-machine", "andes_ae350", "-cpu",
      "andes-ax45mpv,vlen=" + vlen, "-nographic", "-semihosting-config",
      "enable=on,target=native", "-bios", elf_path, "-plugin", plugin_arg};

  std::fprintf(stderr,
               "[andes-sim] cosim lock-step: oracle (QEMU) boots from reset, "
               "arms at %s\n",
               arm_buf);
  const RunResult qr = run_process(qemu_argv, kTimeoutMs);
  if (qr.spawn_failed) { cleanup(); return fail("oracle: failed to spawn QEMU"); }
  if (qr.timed_out) { cleanup(); return fail("oracle: timed out"); }
  if (!qr.out.empty()) std::fwrite(qr.out.data(), 1, qr.out.size(), stdout);

  const StateStream oracle = read_state_stream(oracle_stream);
  if (!oracle.ok()) { cleanup(); return fail("oracle: " + oracle.error); }
  if (oracle.records.empty()) {
    cleanup();
    return fail("oracle produced no records (arm pc " + std::string(arm_buf) +
                " never reached?)");
  }
  const unsigned long long k = oracle.records.size();
  std::fprintf(stderr,
               "[andes-sim] cosim lock-step: oracle drained %llu record(s); "
               "DUT (vsim) bounded to the same\n",
               k);

  // ---- Leg 2: vsim DUT, bounded to the oracle's K records. ----
  std::vector<std::string> vsim_argv = {
      eng.bin_path,         elf_path,
      "--cosim-lockstep",   "--cosim-out",
      dut_stream,           "--cosim-arm-pc",
      arm_buf,              "--cosim-max-records",
      std::to_string(k)};
  const RunResult vr = run_process(vsim_argv, kTimeoutMs);
  if (vr.spawn_failed) { cleanup(); return fail("DUT: failed to spawn vsim"); }
  if (vr.timed_out) { cleanup(); return fail("DUT: timed out"); }
  if (!vr.out.empty()) std::fwrite(vr.out.data(), 1, vr.out.size(), stdout);

  const StateStream dut = read_state_stream(dut_stream);
  if (!dut.ok()) { cleanup(); return fail("DUT: " + dut.error); }

  // ---- Compare ----
  const LockstepResult cmp = compare_lockstep_streams(oracle.records, dut.records);
  cleanup();

  if (!cmp.diverged) {
    std::printf(
        "[cosim] PASS: %zu records match (lock-step, 1 attempt/record)\n",
        cmp.matched);
    return 0;
  }

  if (!cmp.length_mismatch.empty()) {
    std::fprintf(stderr, "[cosim] FAIL: %s\n", cmp.length_mismatch.c_str());
    std::fprintf(stderr,
                 "        first divergence is a control-flow split at attempt "
                 "%zu (after %zu matching)\n",
                 cmp.record, cmp.matched);
    return 1;
  }

  const std::string osym = symbolize(elf_path, cmp.oracle_pc);
  const std::string dsym = symbolize(elf_path, cmp.dut_pc);
  std::fprintf(stderr,
               "[cosim] FAIL: first divergence at attempt %zu (after %zu "
               "matching)\n",
               cmp.record, cmp.matched);
  std::fprintf(stderr, "        pc  vsim=0x%llx  qemu=0x%llx%s%s\n",
               static_cast<unsigned long long>(cmp.dut_pc),
               static_cast<unsigned long long>(cmp.oracle_pc),
               dsym.empty() ? "" : ("   (" + dsym + ")").c_str(),
               (!osym.empty() && osym != dsym) ? (" oracle=(" + osym + ")").c_str()
                                               : "");
  for (const FieldDiff& d : cmp.diff.diffs)
    std::fprintf(stderr, "        %-8s vsim=0x%llx  qemu=0x%llx\n",
                 d.field.c_str(), d.got, d.ref);
  return 1;
}

// `run --model hybrid`: orchestrate a QEMU1 fast-forward -> vsim measure+drain
// handoff (no QEMU2). The trigger (marker|pc|icount) delimits the ROI; the cycle
// figure is the vsim mcycle minus QEMU1's drained mcycle. Replaces the Python
// driver's tests/e2e.sh delegation with a single window-cycle line.
int run_hybrid(const Cli& cli) {
  // Single diagnostic sink for the early-validation returns: prefix + exit 2.
  auto fail = [](const std::string& msg) {
    std::fprintf(stderr, "andes-sim run --model hybrid: %s\n", msg.c_str());
    return 2;
  };

  if (int rc = check_one_elf(cli, "hybrid")) return rc;

  // Resolve to an absolute, existing path: a clean error beats a downstream
  // spawn failure, and pc-trigger resolution reads the ELF's .symtab.
  std::error_code ec;
  const fs::path elf = fs::absolute(cli.positional[0], ec);
  if (ec || !fs::is_regular_file(elf, ec))
    return fail("ELF not found: " + cli.positional[0]);
  const std::string elf_path = elf.string();

  // Validate everything cheap BEFORE the expensive engine discovery, so a CLI
  // mistake fails fast without spawning a --describe per Verilator build.
  std::string err;
  const Trigger trig = hybrid_trigger(cli, elf_path, err);
  if (!err.empty()) return fail(err);

  // --verify needs a boundary the oracle can arm on; the icount window's
  // off-by-one semantics differ between the legs (see verify_oracle.md).
  if (cli.verify && trig.kind != "marker" && trig.kind != "pc")
    return fail("--verify supports --trigger marker|pc");

  // --cosim needs the same entry boundary for the oracle to arm on.
  if (cli.cosim && trig.kind != "marker" && trig.kind != "pc")
    return fail("--cosim supports --trigger marker|pc");
  unsigned long long cosim_interval = 10000;  // default per cosim_roi.md
  if (cli.cosim && !cli.cosim_interval.empty()) {
    char* end = nullptr;
    cosim_interval = std::strtoull(cli.cosim_interval.c_str(), &end, 10);
    if (!end || *end != '\0' || cli.cosim_interval.empty() ||
        cosim_interval == 0)
      return fail("--cosim-interval: want a positive integer, got '" +
                  cli.cosim_interval + "'");
  }

  std::vector<std::string> vsim_extras = vsim_extra_args(cli, trig.kind, err);
  if (!err.empty()) return fail(err);

  long long mem = 128LL * 1024 * 1024;  // shared mmap; --mem-size overrides
  if (!cli.mem_size.empty()) {
    std::string se;
    mem = parse_size(cli.mem_size, se);
    if (!se.empty()) return fail("--mem-size: " + se);
    // Early cap: QEMU's AE350 DRAM window is 2 GiB and the backend doubles as
    // guest RAM here. The physical mmap reserves one V-scratch page above the
    // program's RAM (L26/F2), so the usable --mem-size is 2 GiB minus that
    // page. Failing now beats allocating a huge mmap file first and letting
    // QEMU die late.
    if (mem > max_program_mem_bytes())
      return fail("--mem-size " + cli.mem_size +
                  " exceeds the AE350 DRAM window (2G minus the V-scratch "
                  "reservation)");
  }

  // L26/F3: refuse a run whose static image would extend into the reserved
  // V-transport scratch page. Scheme D parks the scratch in the TOP page of the
  // physical mmap; a PT_LOAD segment reaching there means the ELF was linked for
  // more RAM than --mem-size grants, and QEMU would load it straight onto the
  // scratch -> silent corruption. Derive the page's start from
  // physical_mmap_bytes (the same sizing the mmap uses) rather than a bare
  // `mem`, so the threshold tracks the reservation shape instead of relying on
  // the +page/-page adjustments cancelling. ram_base is the fixed andes_ae350
  // DRAM base (0; see L10). Skipped when the ELF cannot be read -- downstream
  // reports it.
  {
    std::string e;
    const uint64_t top = elf_load_top(elf_path, e);
    const uint64_t scratch_gpa =
        static_cast<uint64_t>(physical_mmap_bytes(mem)) - HYBRID_V_SCRATCH_BYTES;
    if (e.empty() && top > scratch_gpa) {
      char msg[256];
      std::snprintf(msg, sizeof(msg),
                    "ELF static image ends at 0x%llx, overlapping the reserved "
                    "V-transport scratch page at 0x%llx (ram_base + --mem-size)"
                    "; raise --mem-size or shrink the image",
                    static_cast<unsigned long long>(top),
                    static_cast<unsigned long long>(scratch_gpa));
      return fail(msg);
    }
  }

  // qemu is the built-in fast leg; resolve the accurate (vsim) leg by --engine
  // or the sole cycle-accurate engine (reusing the F8 selector).
  Discovery disc = discover_engines();
  const EngineDescriptor* acc =
      resolve_accurate_engine(disc.engines, cli.engine, err);
  if (!acc) {
    std::fprintf(stderr, "andes-sim run --model hybrid: %s\n", err.c_str());
    for (const std::string& w : disc.warnings)
      std::fprintf(stderr, "andes-sim: skipped engine: %s\n", w.c_str());
    return 2;
  }

  // ISA sync: both legs must agree on the base ISA width (rv32 engines
  // cannot share architectural state with the rv64 fast leg).
  if (std::string hw = hybrid_hw_check(*acc); !hw.empty()) return fail(hw);

  Plan plan;
  plan.elf = elf_path;
  plan.mem_size = mem;
  Step qemu_step{"qemu", "fast-leg", trig};
  Step vsim_step{acc->id, "accurate-leg", trig};
  vsim_step.extra_args = std::move(vsim_extras);  // kanata + warmup, validated
  if (cli.cosim) {
    // Orthogonal to the trigger: the vsim leg drains a resumable checkpoint
    // to the <state_out>.ckpts stream every N retires (run_plan reads them
    // back).
    vsim_step.extra_args.push_back("--hybrid-cosim");
    vsim_step.extra_args.push_back(std::to_string(cosim_interval));
  }
  plan.steps = {qemu_step, vsim_step};

  // Banner to stderr so the window-cycle result stands alone on stdout.
  // vlen is the synced value the fast leg inherits from the engine.
  std::fprintf(stderr,
               "[andes-sim] model=hybrid engine=%s vlen=%ld trigger=%s fixture=%s\n",
               acc->id.c_str(), synced_vlen(acc->vlen), trig.kind.c_str(),
               elf.stem().string().c_str());

  const PlanResult r = run_plan(plan, disc.engines);
  if (!r.ok()) {
    std::fprintf(stderr, "andes-sim run --model hybrid: %s\n", r.error.c_str());
    return 1;
  }
  // Relay each leg's stdout verbatim: the program's own prints (QEMU1 phase-1
  // output, then anything the ROI wrote on vsim) belong to the user.
  for (const PhaseResult& p : r.phases)
    if (!p.out.empty()) std::fwrite(p.out.data(), 1, p.out.size(), stdout);
  // phases[0] = QEMU1 drain, [1] = vsim drain; the kernel/window figure is the
  // vsim mcycle delta. Suppressed under --cosim: every checkpoint adds a DMI
  // halt + drain + resume to the vsim leg, so the delta no longer measures
  // the kernel (a --cosim run answers "where diverged", not "how many cycles").
  if (!cli.cosim) {
    const unsigned long long q_mc = r.phases[0].mcycle;
    const unsigned long long v_mc = r.phases[1].mcycle;
    std::printf("[%s window_cycles] %llu  (vsim mcycle=%llu - qemu mcycle=%llu)\n",
                trig.kind.c_str(), v_mc - q_mc, v_mc, q_mc);
  }

  // --verify (verify_oracle F4, default off): re-run the ELF on pure QEMU
  // with the plugin draining at the ROI exit boundary, sampling at vsim's
  // halt pc, and diff the two drains in-process. The oracle plan gets its
  // own fresh mmap: reusing the main run's would boot the oracle on the
  // hybrid run's leftover memory. Its stdout is dropped -- the program's
  // output was already relayed from the main run.
  if (cli.verify) {
    char pcbuf[32];
    std::snprintf(pcbuf, sizeof(pcbuf), "0x%llx",
                  static_cast<unsigned long long>(r.phases[1].st.pc));
    Trigger vtrig;
    vtrig.kind = "verify-" + trig.kind;
    if (trig.kind == "pc") vtrig.params["exit_pc"] = trig.params.at("exit_pc");
    vtrig.params["drain_pc"] = pcbuf;

    Plan vplan;
    vplan.elf = elf_path;
    vplan.mem_size = mem;
    vplan.steps = {Step{"qemu", "fast-leg", vtrig}};

    std::fprintf(stderr,
                 "[andes-sim] verify: oracle leg (pure QEMU drains at the ROI "
                 "exit, pc=%s)\n",
                 pcbuf);
    const PlanResult vr = run_plan(vplan, disc.engines);
    if (!vr.ok()) {
      std::fprintf(stderr, "andes-sim run --verify: %s\n", vr.error.c_str());
      return 1;
    }
    const DiffReport d = diff_states(vr.phases[0].st, r.phases[1].st);
    print_diff_report(d);
    if (!d.ok()) {
      std::fprintf(stderr,
                   "andes-sim run --verify: vsim drain diverges from the "
                   "QEMU oracle\n");
      return 1;
    }
    std::printf("[verify] PASS: vsim drain matches the QEMU oracle\n");
  }

  // --cosim (cosim_roi F4, default off, dev): re-run the ELF on pure QEMU
  // with the plugin draining at the vsim checkpoints' retire deltas, then
  // diff checkpoint k against checkpoint k and the final drains. minstret is
  // restored from the entry state on resume, so `checkpoint.minstret -
  // entry.minstret` is the exact post-entry retire count -- both engines
  // sample the SAME architectural points, and the first mismatching window
  // brackets the divergence. Fresh mmap for the oracle (clean memory);
  // stdout dropped (already relayed from the main run).
  //
  // --cosim-refine (cosim_redesign F7): when set, after the coarse window is
  // found the driver re-runs QEMU1->vsim with explicit targets subdividing it
  // ~16x per pass (the vsim leg finishes at the last target, so each pass is
  // bounded), re-running the oracle at the vsim leg's achieved deltas, until
  // the window shrinks to the halt slack. QEMU1 is deterministic, so each pass
  // re-derives the same entry state -- no mmap snapshot needed.
  if (cli.cosim) {
    const unsigned long long m0 = r.phases[0].st.minstret;

    // Flatten a leg's checkpoints + final drain into (state, absolute-delta)
    // lists. False on a zero/non-ascending delta (a corrupt leg).
    auto collect = [&](const PhaseResult& leg,
                       std::vector<hybrid_state_v1>& states,
                       std::vector<unsigned long long>& deltas) -> bool {
      states.clear();
      deltas.clear();
      for (const hybrid_state_v1& c : leg.checkpoints) {
        const unsigned long long d = c.minstret - m0;
        if (d == 0 || (!deltas.empty() && d <= deltas.back())) return false;
        states.push_back(c);
        deltas.push_back(d);
      }
      const unsigned long long df = leg.st.minstret - m0;
      if (df == 0 || (!deltas.empty() && df <= deltas.back())) return false;
      states.push_back(leg.st);
      deltas.push_back(df);
      return true;
    };

    auto join = [](const auto& xs) {
      std::string s;
      for (size_t i = 0; i < xs.size(); ++i)
        s += (i ? ":" : "") + std::to_string(xs[i]);
      return s;
    };

    // Oracle: pure QEMU draining at the given absolute deltas. Returns its
    // states (checkpoints + final, length == counts.size()) or nullopt.
    auto run_oracle = [&](const std::vector<unsigned long long>& counts)
        -> std::optional<std::vector<hybrid_state_v1>> {
      Trigger ot;
      ot.kind = "cosim-" + trig.kind;
      if (trig.kind == "pc") ot.params["enter_pc"] = trig.params.at("enter_pc");
      ot.params["counts"] = join(counts);
      Plan op;
      op.elf = elf_path;
      op.mem_size = mem;
      op.steps = {Step{"qemu", "fast-leg", ot}};
      const PlanResult orr = run_plan(op, disc.engines);
      if (!orr.ok()) {
        std::fprintf(stderr, "andes-sim run --cosim: %s\n", orr.error.c_str());
        return std::nullopt;
      }
      std::vector<hybrid_state_v1> os = orr.phases[0].checkpoints;
      os.push_back(orr.phases[0].st);
      if (os.size() != counts.size()) {
        std::fprintf(stderr,
                     "andes-sim run --cosim: oracle returned %zu states, "
                     "want %zu\n",
                     os.size(), counts.size());
        return std::nullopt;
      }
      return os;
    };

    // First index where two aligned state lists differ (trap cause excluded:
    // the hybrid ROI is trap-free by contract).
    auto first_div = [](const std::vector<hybrid_state_v1>& os,
                        const std::vector<hybrid_state_v1>& vs)
        -> std::optional<size_t> {
      for (size_t i = 0; i < os.size() && i < vs.size(); ++i)
        if (!diff_states(os[i], vs[i]).ok()) return i;
      return std::nullopt;
    };

    // ---- pass 1: the interval checkpoints from the main hybrid run ----
    std::vector<hybrid_state_v1> vstates;
    std::vector<unsigned long long> vdeltas;
    if (!collect(r.phases[1], vstates, vdeltas)) {
      std::fprintf(stderr,
                   "andes-sim run --cosim: non-ascending vsim checkpoint "
                   "deltas (corrupt leg?)\n");
      return 1;
    }
    std::fprintf(stderr,
                 "[andes-sim] cosim: oracle leg (pure QEMU, %zu sample(s))\n",
                 vdeltas.size());
    const auto ostates = run_oracle(vdeltas);
    if (!ostates) return 1;

    auto div = first_div(*ostates, vstates);
    if (!div) {
      std::printf("[cosim] PASS: %zu checkpoint(s) + final state match the "
                  "QEMU oracle (interval %llu, %llu ROI retires)\n",
                  vstates.size() - 1, cosim_interval, vdeltas.back());
      std::printf("PASS: --model hybrid --trigger %s (%s)\n",
                  trig.kind.c_str(), elf.stem().string().c_str());
      return 0;
    }

    // Coarse diverging window (lo, hi]; div_v/div_o are the states at hi.
    unsigned long long lo = (*div == 0) ? 0 : vdeltas[*div - 1];
    unsigned long long hi = vdeltas[*div];
    hybrid_state_v1 div_v = vstates[*div];
    hybrid_state_v1 div_o = (*ostates)[*div];
    DiffReport div_diff = diff_states(div_o, div_v);

    // ---- refine: subdivide (lo, hi] until it reaches the halt-slack floor.
    // Targets must stay >= kSpacing apart so the vsim halt overshoot cannot
    // reorder the achieved deltas; below that the haltreq checkpoint cannot
    // resolve further (use --model cycle --cosim for exact single-stepping).
    if (cli.cosim_refine) {
      constexpr unsigned long long kSpacing = 8;
      constexpr int kFanout = 16;
      int pass = 1;
      while (hi - lo > kSpacing) {
        const std::vector<uint64_t> targets =
            subdivide_window(lo, hi, kFanout, kSpacing);
        if (targets.size() < 2) break;
        std::fprintf(stderr,
                     "[andes-sim] cosim-refine pass %d: window (%llu, %llu], "
                     "%zu probes\n",
                     ++pass, lo, hi, targets.size());

        Step q{"qemu", "fast-leg", trig};
        Step v{acc->id, "accurate-leg", trig};
        v.extra_args = {"--hybrid-cosim-at", join(targets)};
        Plan p;
        p.elf = elf_path;
        p.mem_size = mem;
        p.steps = {q, v};
        const PlanResult pr = run_plan(p, disc.engines);
        if (!pr.ok()) {
          std::fprintf(stderr, "andes-sim run --cosim-refine: %s\n",
                       pr.error.c_str());
          return 1;
        }
        std::vector<hybrid_state_v1> rv;
        std::vector<unsigned long long> rd;
        if (!collect(pr.phases[1], rv, rd)) {
          std::fprintf(stderr,
                       "andes-sim run --cosim-refine: non-ascending vsim "
                       "deltas (halt slack exceeded the probe spacing?)\n");
          break;  // report the best window found so far
        }
        const auto ro = run_oracle(rd);
        if (!ro) return 1;
        const auto rdiv = first_div(*ro, rv);
        if (!rdiv) break;  // no narrower split resolved; keep current window

        const unsigned long long nlo = (*rdiv == 0) ? lo : rd[*rdiv - 1];
        const unsigned long long nhi = rd[*rdiv];
        if (nhi >= hi && nlo <= lo) break;  // no progress
        lo = nlo;
        hi = nhi;
        div_v = rv[*rdiv];
        div_o = (*ro)[*rdiv];
        div_diff = diff_states(div_o, div_v);
      }
    }

    // ---- report the (narrowed) diverging window ----
    print_diff_report(div_diff);
    const std::string sym = symbolize(elf_path, div_v.pc);
    std::fprintf(stderr,
                 "[cosim] FAIL: divergence in retires %llu..%llu after entry "
                 "(%llu insn window)%s\n",
                 lo, hi, hi - lo, cli.cosim_refine ? ", narrowed" : "");
    std::fprintf(stderr, "        at retire ~%llu: pc vsim=0x%llx qemu=0x%llx%s\n",
                 hi, static_cast<unsigned long long>(div_v.pc),
                 static_cast<unsigned long long>(div_o.pc),
                 sym.empty() ? "" : ("   (" + sym + ")").c_str());
    if (cli.cosim_refine && hi - lo > 8)
      std::fprintf(stderr,
                   "        (window at the halt-slack floor; for the exact "
                   "instruction use --model cycle --cosim on a reset testbench)\n");
    return 1;
  }

  std::printf("PASS: --model hybrid --trigger %s (%s)\n", trig.kind.c_str(),
              elf.stem().string().c_str());
  return 0;
}

}  // namespace

int cmd_run(const Cli& cli) {
  if (cli.model.empty()) {
    std::fprintf(stderr,
                 "andes-sim run: --model fast|cycle|hybrid is required\n");
    return 2;
  }
  if (!find_model(cli.model)) {
    std::fprintf(stderr,
                 "andes-sim run: unknown model '%s' (want fast|cycle|hybrid)\n",
                 cli.model.c_str());
    return 2;
  }
  // --verify re-runs the workload against a QEMU oracle -- only the hybrid
  // composition has a second engine to check.
  if (cli.verify && cli.model != "hybrid") {
    std::fprintf(stderr,
                 "andes-sim run: --verify requires --model hybrid (the %s "
                 "model has nothing to cross-check)\n",
                 cli.model.c_str());
    return 2;
  }
  // --cosim cross-checks against a QEMU oracle: hybrid (ROI window checkpoints)
  // or cycle (lock-step from reset). The fast model is QEMU itself -- nothing
  // to check.
  if (cli.cosim && cli.model == "fast") {
    std::fprintf(stderr,
                 "andes-sim run: --cosim requires --model hybrid or cycle "
                 "(fast is QEMU itself, nothing to cross-check)\n");
    return 2;
  }
  if (cli.cosim && cli.verify) {
    std::fprintf(stderr,
                 "andes-sim run: --verify and --cosim are exclusive (--cosim "
                 "already cross-checks the final state)\n");
    return 2;
  }
  // --cosim-interval is the hybrid ROI knob; --cosim-max-records is the
  // cycle lock-step knob. Each requires --cosim and its own model.
  if (!cli.cosim && !cli.cosim_interval.empty()) {
    std::fprintf(stderr, "andes-sim run: --cosim-interval requires --cosim\n");
    return 2;
  }
  if (!cli.cosim_interval.empty() && cli.model != "hybrid") {
    std::fprintf(stderr,
                 "andes-sim run: --cosim-interval applies to --model hybrid "
                 "(cycle lock-step uses --cosim-max-records)\n");
    return 2;
  }
  if (!cli.cosim_max_records.empty() && !(cli.cosim && cli.model == "cycle")) {
    std::fprintf(stderr,
                 "andes-sim run: --cosim-max-records requires --model cycle "
                 "--cosim (lock-step)\n");
    return 2;
  }
  // --cosim-refine narrows the hybrid ROI window; it has no meaning for the
  // cycle lock-step (already exact) or without --cosim.
  if (cli.cosim_refine && !(cli.cosim && cli.model == "hybrid")) {
    std::fprintf(stderr,
                 "andes-sim run: --cosim-refine requires --model hybrid "
                 "--cosim (cycle lock-step is already instruction-exact)\n");
    return 2;
  }
  if (cli.model == "fast") return run_fast(cli);
  if (cli.model == "cycle") return run_accurate(cli);
  return run_hybrid(cli);  // model validated above; only hybrid remains
}

