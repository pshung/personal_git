"""F2 RED: orchestrator.plan loads csr_oneshot.yaml into a 2-step Session.

The CSR one-shot mirrors today's rt_shared_mem.sh handoff:
  step 0: qemu  -- drains on CSR enter
  step 1: vsim  -- resumes, runs ROI, drains on CSR exit
(The former step 2 -- qemu resumes + runs to completion -- was removed with
the vsim -> QEMU2 handback; see remove_qemu2.md.)

The orchestrator's first responsibility is to parse this plan; the spawn loop
that consumes it lands in F8.
"""
from __future__ import annotations

from pathlib import Path

from orchestrator.plan import Session, Step, load_plan


_EXAMPLE = (
    Path(__file__).resolve().parents[1] / "examples" / "csr_oneshot.yaml"
)


def test_csr_oneshot_yaml_yields_two_steps() -> None:
    session = load_plan(_EXAMPLE)

    assert isinstance(session, Session)
    assert len(session.steps) == 2
    assert all(isinstance(s, Step) for s in session.steps)
    assert [s.model for s in session.steps] == ["qemu", "vsim"]
