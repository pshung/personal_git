#!/usr/bin/env bash
# Sequentially execute every tutorial notebook against the live build.
# Sequential is required: notebooks chdir to repo root and write shared
# scratch files (hello.c, gemm.c, highmem.c) that would race if parallel.
set -u
cd /home/nick/work/hybrid_sim
JUP=/tmp/nbenv/bin/jupyter
PY=/tmp/nbenv/bin/python
OUTDIR=/tmp/nbresults
mkdir -p "$OUTDIR"
SUMMARY="$OUTDIR/SUMMARY.txt"
: > "$SUMMARY"

NBS=(
  docs/andes_sim_tutorial.ipynb
  docs/andes_sim_demo.ipynb
  docs/andes_sim_gemm_tutorial.ipynb
  docs/andes_sim_memory_tutorial.ipynb
  docs/andes_sim_cosim_tutorial.ipynb
  docs/andes_sim_limitations.ipynb
  docs/competition_landscape.ipynb
)

for nb in "${NBS[@]}"; do
  base=$(basename "$nb" .ipynb)
  out="$OUTDIR/${base}.out.ipynb"
  log="$OUTDIR/${base}.log"
  echo "===== $nb =====" | tee -a "$SUMMARY"
  start=$SECONDS
  timeout 1200 "$JUP" nbconvert --to notebook --execute --allow-errors \
    --ExecutePreprocessor.kernel_name=nbenv --ExecutePreprocessor.timeout=600 \
    --output "$out" "$nb" > "$log" 2>&1
  rc=$?
  dur=$((SECONDS-start))
  # parse the executed notebook for error outputs
  "$PY" - "$out" "$nb" "$rc" "$dur" >> "$SUMMARY" <<'PY'
import json,sys
out,src,rc,dur=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
try:
    nb=json.load(open(out))
except Exception as e:
    print(f"  PARSE-FAIL ({e}); nbconvert rc={rc}, {dur}s -- likely timeout/crash before write")
    print("  HEALTH: fail")
    sys.exit()
cells=nb['cells']; code=[c for c in cells if c['cell_type']=='code']
errs=[]
for i,c in enumerate(code):
    for o in c.get('outputs',[]):
        if o.get('output_type')=='error':
            src_lines=''.join(c['source']).strip().splitlines()
            errs.append((i, o.get('ename',''), (o.get('evalue','') or '')[:120], (src_lines[0] if src_lines else '')[:80]))
print(f"  cells={len(cells)} code={len(code)} rc={rc} {dur}s errors={len(errs)}")
for i,en,ev,s in errs:
    print(f"    [code#{i}] {en}: {ev}  | src: {s}")
print(f"  HEALTH: {'pass' if (rc==0 and not errs) else ('partial' if errs and len(errs)<len(code) else 'fail')}")
PY
  echo "" >> "$SUMMARY"
done
echo "ALL_NOTEBOOKS_DONE" >> "$SUMMARY"
