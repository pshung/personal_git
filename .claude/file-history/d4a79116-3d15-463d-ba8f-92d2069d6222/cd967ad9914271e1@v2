#!/usr/bin/env bash
set -uo pipefail
cd /home/nick/work/hybrid_sim
set -a; . ./config.env; set +a
JUP=/tmp/nbenv/bin/jupyter
total=0
for nb in tutorial demo gemm_tutorial memory_tutorial cosim_tutorial limitations; do
  src="docs/andes_sim_${nb}.ipynb"
  "$JUP" nbconvert --to notebook --execute --allow-errors \
    --ExecutePreprocessor.kernel_name=nbenv --ExecutePreprocessor.timeout=600 \
    --output "exec_${nb}.ipynb" --output-dir=/tmp "$src" >/tmp/nbconv_${nb}.log 2>&1
  errs=$(python3 -c "import json; nb=json.load(open('/tmp/exec_${nb}.ipynb')); print(sum(1 for c in nb['cells'] if c.get('cell_type')=='code' for o in c.get('outputs',[]) if o.get('output_type')=='error'))" 2>/dev/null || echo "PARSE_FAIL")
  echo "${nb}: errors=${errs}"
  [ "$errs" = "0" ] || total=$((total+1))
done
echo "NOTEBOOKS_WITH_ERRORS=${total}"
