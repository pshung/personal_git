#!/usr/bin/env bash
# RED test: the `demo` subcommand and `list demos` choice are removed.
# hsim is now the orchestrator -- bash demos under tests/demos/ are gone,
# and `./hsim run --mode ...` covers every switching mode directly.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
HSIM="$ROOT/hsim"

fail() { echo "[FAIL] $*" >&2; exit 1; }
ok()   { echo "[ok] $*"; }

[ -x "$HSIM" ] || fail "missing executable: $HSIM"

cd "$ROOT"

# 1. ./hsim demo <anything> -> argparse rejects the subcommand.
set +e
out=$("$HSIM" demo T1 2>&1); rc=$?
set -e
[ "$rc" -ne 0 ] || fail "./hsim demo T1 should fail, got rc=0:"$'\n'"$out"
echo "$out" | grep -qE "invalid choice|unrecognized" \
  || fail "./hsim demo should be rejected as unknown subcommand:"$'\n'"$out"
ok "./hsim demo T1 -> rc=$rc with unknown-subcommand error"

# 2. ./hsim demo --help -> same rejection (argparse parses positional first).
set +e
out=$("$HSIM" demo --help 2>&1); rc=$?
set -e
[ "$rc" -ne 0 ] || fail "./hsim demo --help should fail, got rc=0:"$'\n'"$out"
ok "./hsim demo --help -> rc=$rc"

# 3. ./hsim --help no longer lists 'demo' as a subcommand.
out=$("$HSIM" --help 2>&1) || fail "./hsim --help non-zero: $out"
echo "$out" | grep -qE "^[[:space:]]+demo[[:space:]]" \
  && fail "./hsim --help still lists 'demo' subcommand:"$'\n'"$out"
ok "./hsim --help no longer lists 'demo' subcommand"

# 4. ./hsim list demos -> argparse rejects the choice.
set +e
out=$("$HSIM" list demos 2>&1); rc=$?
set -e
[ "$rc" -ne 0 ] || fail "./hsim list demos should fail, got rc=0:"$'\n'"$out"
echo "$out" | grep -qE "invalid choice|unrecognized" \
  || fail "list demos should report 'invalid choice':"$'\n'"$out"
ok "./hsim list demos -> rc=$rc (invalid choice)"

# 5. ./hsim list --help shows only 'fixtures' and 'modes' choices.
out=$("$HSIM" list --help 2>&1) || fail "./hsim list --help non-zero: $out"
echo "$out" | grep -qE "fixtures.*modes|modes.*fixtures" \
  || fail "list --help should list fixtures and modes:"$'\n'"$out"
echo "$out" | grep -qE "\bdemos\b" \
  && fail "list --help should not mention 'demos':"$'\n'"$out"
ok "./hsim list --help lists only fixtures + modes"

echo "PASS test_hsim_demo_removed"
