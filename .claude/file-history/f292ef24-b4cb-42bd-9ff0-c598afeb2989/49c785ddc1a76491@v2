TEST_CASE("B17: cleared cmderr surfaces via diagnostic side-channel")
{
  // The restore tail's clear_cmderr_if_set() swallows any sticky cmderr
  // from earlier per-register failures so the resume can proceed. Without
  // a side channel, a partially-broken restore is invisible. Pin the
  // contract: when a CSR write fails (sticky cmderr -> PB fallback path
  // also clears it... but with no PB fallback for tolerant CSRs, the
  // tail-clear is the surviving signal), the driver records the last
  // observed non-zero cmderr in last_observed_cmderr() / records a
  // non-zero clear count.
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);
  // Force the mtvec abstract write to fail. mtvec goes through
  // write_csr_tolerant which intentionally does NOT take the PB
  // fallback; it just clears cmderr at the end. So the failure
  // is only visible via the side channel.
  bus.fail_csr_write = 0x305;  // CSR mtvec

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(rv64_state(0x80001000, 0));

  CHECK(driver.cmderr_clear_count() > 0u);
  CHECK(driver.last_observed_cmderr() != 0u);
}

TEST_CASE("B9: write_csr_abstract_or_pb busy-poll precedes cmderr inspection")
{
  // The B9 audit claimed write_csr_abstract_or_pb reads abstractcs without
  // first polling busy. In fact write_64bit_register -> write_register_abstract
  // calls poll_until_clear(busy) before returning, so by the time the cmderr
  // check runs, busy is already clear. This test pins that contract: between
  // every kCommand write and the next kAbstractcs read, the recorded ops
  // must include at least one kAbstractcs read (the busy poll). If a future
  // refactor regresses by removing the chained poll, this test fails.
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(rv64_state(0x80001000, 0xdeadbeef));

  // Walk ops; between each kCommand write and the very next kAbstractcs
  // read by an unrelated caller, there must be at least one kAbstractcs
  // read (the busy poll from write_register_abstract).
  bool saw_cmd = false;
  std::size_t reads_since_cmd = 0;
  bool all_cmds_had_abstractcs_poll = true;
  for (const auto& op : bus.ops) {
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand) {
      if (saw_cmd && reads_since_cmd == 0)
        all_cmds_had_abstractcs_poll = false;
      saw_cmd = true;
      reads_since_cmd = 0;
    } else if (saw_cmd && op.kind == DmiOp::Kind::Read
               && op.reg == kAbstractcs) {
      ++reads_since_cmd;
    }
  }
  CHECK(all_cmds_had_abstractcs_poll);
  // The final kCommand write must also be followed by an abstractcs read.
  CHECK(reads_since_cmd > 0u);
}

TEST_CASE("L6: S-mode resume writes dcsr.prv = state.priv before resumereq")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.priv = 1;  // S-mode at the drain boundary

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  // Exactly one write-COMMAND must target dcsr (0x7B0). The driver
  // read-modify-writes dcsr; the recording bus answers 0 for the read, so
  // the DATA0 staged two ops earlier is exactly the prv field.
  std::vector<std::size_t> idx;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && (op.value & 0xffffu) == kCsrDcsr
        && ((op.value >> 16) & 1u) != 0u) {
      idx.push_back(i);
    }
  }
  REQUIRE(idx.size() == 1);
  REQUIRE(idx[0] >= 2);
  const auto& d0 = bus.ops[idx[0] - 2];
  CHECK(d0.kind == DmiOp::Kind::Write);
  CHECK(d0.reg == kData0);
  CHECK((d0.value & 0x3u) == 1u);

  // The dcsr write must land before resumereq (bit 30 of dmcontrol).
  std::size_t resume_idx = bus.ops.size();
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind == DmiOp::Kind::Write && op.reg == kDmcontrol
        && ((op.value >> 30) & 1u) != 0u) {
      resume_idx = i;
      break;
    }
  }
  CHECK(idx[0] < resume_idx);
}

