// ResumeDriver translates a hybrid_state_v1 into a sequence of DMI register
// ops against the RISC-V Debug Module. The orchestration is testable in
// isolation by injecting a recording bus.

#include "hybrid/abstract_command.hpp"
#include "hybrid/program_buffer.hpp"
#include "hybrid/resume_driver.hpp"
#include "hybrid/state_abi.h"
#include "hybrid/v_regfile_xfer.hpp"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include <cstdint>
#include <deque>
#include <optional>
#include <set>
#include <unordered_map>
#include <vector>

namespace {

// DMI register addresses from RISC-V Debug Spec 1.0.
constexpr uint8_t kDmcontrol  = 0x10;
constexpr uint8_t kDmstatus   = 0x11;
constexpr uint8_t kAbstractcs = 0x16;
constexpr uint8_t kCommand    = 0x17;
constexpr uint8_t kData0      = 0x04;
constexpr uint8_t kData1      = 0x05;

// CSR numbers from Debug Spec.
constexpr uint16_t kCsrDpc  = 0x7B1;
constexpr uint16_t kCsrDcsr = 0x7B0;

// L26: the V scratch GPA is a runtime value (mmap top page) passed to the
// driver. Tests pass this distinctive stand-in and assert the sweep uses it.
constexpr uint64_t kScratch = 0x07FFF000ull;  // 128 MiB mmap top page

struct DmiOp
{
  enum class Kind
  {
    Write,
    Read,
  };
  Kind kind;
  uint8_t reg;
  uint32_t value;  // for writes only
};

struct RecordingBus final : hybrid::DmiBus
{
  std::vector<DmiOp> ops;

  // Test-controlled response values for reads.
  uint32_t dmstatus_value = 0;       // bit 9: allhalted, bit 17: allresumeack
  uint32_t abstractcs_value = 0;     // fallback when queue is empty
  std::deque<uint32_t> abstractcs_queue; // queued reads drain first

  // When set, an abstract write-COMMAND to this CSR regno raises a sticky
  // cmderr (cleared by the W1C abstractcs write the driver issues on its PB
  // fallback). Models real hardware and -- unlike positional queueing -- is
  // robust to however many unrelated abstract ops precede the targeted write.
  std::optional<uint16_t> fail_csr_write;

  // One-shot: when true, the NEXT kExecProgbufCmd write raises sticky cmderr
  // (so exec_progbuf throws after its post-exec abstractcs poll). The flag
  // re-arms to false after firing - tests can flip it back on to fail a
  // later PB exec.
  bool fail_next_pb_exec = false;

  // Mini register file: abstract write-COMMANDs latch the staged DATA0/DATA1
  // into regfile[regno]; abstract read-COMMANDs load it back so read-modify-
  // write-verify sequences observe their own writes. Regnos in warl_ignore
  // model WARL fields the hart pins (the write is recorded but discarded),
  // e.g. dcsr.prv on a core without S/U modes.
  std::unordered_map<uint16_t, uint64_t> regfile;
  std::set<uint16_t> warl_ignore;

  void write(uint8_t reg, uint32_t value) override
  {
    ops.push_back({DmiOp::Kind::Write, reg, value});
    if (reg == kData0) staged_data0_ = value;
    if (reg == kData1) staged_data1_ = value;
    if (reg == kAbstractcs && (value & kCmderrMask) != 0u)
      cmderr_sticky_ = false;  // W1C clear
    if (reg == kCommand && fail_csr_write) {
      const auto regno    = static_cast<uint16_t>(value & 0xFFFFu);
      const bool is_write = ((value >> 16) & 1u) != 0u;
      if (is_write && regno == hybrid::regno_csr(*fail_csr_write))
        cmderr_sticky_ = true;
    }
    if (reg == kCommand && value != hybrid::kExecProgbufCmd) {
      const auto regno    = static_cast<uint16_t>(value & 0xFFFFu);
      const bool is_write = ((value >> 16) & 1u) != 0u;
      if (is_write) {
        if (!warl_ignore.count(regno))
          regfile[regno] = (uint64_t{staged_data1_} << 32) | staged_data0_;
      } else {
        const auto it = regfile.find(regno);
        const uint64_t v = (it == regfile.end()) ? 0u : it->second;
        pending_data0_ = static_cast<uint32_t>(v);
        pending_data1_ = static_cast<uint32_t>(v >> 32);
      }
    }
    if (reg == kCommand && value == hybrid::kExecProgbufCmd
        && fail_next_pb_exec) {
      cmderr_sticky_ = true;
      fail_next_pb_exec = false;
    }
  }

  auto read(uint8_t reg) -> uint32_t override
  {
    ops.push_back({DmiOp::Kind::Read, reg, 0});
    if (reg == kDmstatus) return dmstatus_value;
    if (reg == kData0)   return pending_data0_;
    if (reg == kData1)   return pending_data1_;
    if (reg == kAbstractcs) {
      if (cmderr_sticky_) return kCmderrMask;
      if (!abstractcs_queue.empty()) {
        auto v = abstractcs_queue.front();
        abstractcs_queue.pop_front();
        return v;
      }
      return abstractcs_value;
    }
    return 0;
  }

private:
  static constexpr uint32_t kCmderrMask = 0x7u << 8;
  bool cmderr_sticky_ = false;
  uint32_t staged_data0_  = 0;
  uint32_t staged_data1_  = 0;
  uint32_t pending_data0_ = 0;
  uint32_t pending_data1_ = 0;
};

auto rv64_state(uint64_t pc, uint64_t x10) -> hybrid_state_v1
{
  hybrid_state_v1 s{};
  s.magic = HYBRID_STATE_MAGIC;
  s.version = HYBRID_STATE_VERSION;
  s.flags = HYBRID_FLAG_RV64;
  s.pc = pc;
  s.priv = 3;
  s.gpr[10] = x10;
  return s;
}

auto find_write(const std::vector<DmiOp>& ops, uint8_t reg)
  -> std::vector<uint32_t>
{
  std::vector<uint32_t> values;
  for (const auto& op : ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == reg)
      values.push_back(op.value);
  return values;
}

auto count_writes_to(const std::vector<DmiOp>& ops, uint8_t reg) -> std::size_t
{
  std::size_t n = 0;
  for (const auto& op : ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == reg) ++n;
  return n;
}

}  // namespace

TEST_CASE("resume halts the hart before any abstract command")
{
  RecordingBus bus;
  // dmstatus answers halted+resumeack so poll loops finish on the first read.
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(rv64_state(/*pc=*/0x80001000, /*x10=*/0xdeadbeef));

  // The first write must prime dmactive (DM out of reset) BEFORE haltreq is
  // accepted; the second write must add haltreq while keeping dmactive set.
  REQUIRE(bus.ops.size() >= 2);

  const auto& prime = bus.ops[0];
  CHECK(prime.kind == DmiOp::Kind::Write);
  CHECK(prime.reg == kDmcontrol);
  CHECK((prime.value & 1u) == 1u);                  // dmactive
  CHECK(((prime.value >> 31) & 1u) == 0u);          // haltreq NOT yet set

  const auto& halt = bus.ops[1];
  CHECK(halt.kind == DmiOp::Kind::Write);
  CHECK(halt.reg == kDmcontrol);
  CHECK((halt.value & 1u) == 1u);                   // dmactive still set
  CHECK(((halt.value >> 31) & 1u) == 1u);           // haltreq
}

TEST_CASE("resume programs x1..x31 via DATA0/DATA1 + COMMAND, skipping x0")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0xdeadbeef);
  for (int i = 0; i < 32; ++i) s.gpr[i] = 0xa00000000ULL + i;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  std::vector<uint32_t> cmds;
  for (const auto& op : bus.ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand)
      cmds.push_back(op.value);

  CHECK(cmds.size() >= 31);

  for (int i = 1; i < 32; ++i) {
    const auto expect =
      hybrid::access_register_command(hybrid::regno_gpr(i),
                                      hybrid::AarSize::Bits64, /*write=*/true);
    CHECK(cmds[i - 1] == expect);
  }

  for (const auto& cmd : cmds) {
    const uint16_t regno = cmd & 0xffffu;
    CHECK(regno != hybrid::regno_gpr(0));
  }
}

TEST_CASE("resume writes DPC = state.pc")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  constexpr uint64_t pc = 0x12345678'9ABCDEF0ULL;
  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(rv64_state(pc, 0));

  // Look for the COMMAND write that targets CSR DPC (regno=0x7B1).
  std::vector<std::size_t> dpc_cmd_indices;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && (op.value & 0xffffu) == kCsrDpc) {
      dpc_cmd_indices.push_back(i);
    }
  }
  REQUIRE(dpc_cmd_indices.size() == 1);

  // Immediately preceding writes must set DATA0=low32(pc), DATA1=high32(pc).
  const auto cmd_idx = dpc_cmd_indices[0];
  REQUIRE(cmd_idx >= 2);
  const auto& d0 = bus.ops[cmd_idx - 2];
  const auto& d1 = bus.ops[cmd_idx - 1];
  CHECK(d0.kind == DmiOp::Kind::Write);
  CHECK(d0.reg == kData0);
  CHECK(d0.value == uint32_t(pc & 0xffffffffu));
  CHECK(d1.kind == DmiOp::Kind::Write);
  CHECK(d1.reg == kData1);
  CHECK(d1.value == uint32_t((pc >> 32) & 0xffffffffu));
}

TEST_CASE("resume issues resumereq after register programming")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(rv64_state(0x80001000, 0));

  // The last DMCONTROL write must clear haltreq and set resumereq.
  const auto dmctl_writes = find_write(bus.ops, kDmcontrol);
  REQUIRE(dmctl_writes.size() >= 2);
  const auto last = dmctl_writes.back();
  CHECK((last & 1u) == 1u);                  // dmactive still on
  CHECK(((last >> 31) & 1u) == 0u);          // haltreq cleared
  CHECK(((last >> 30) & 1u) == 1u);          // resumereq set
}

TEST_CASE("resume polls DMSTATUS for halted before programming registers")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(rv64_state(0x80001000, 0));

  // At least one DMSTATUS read happened, and it occurred before the first
  // DATA0/DATA1 write.
  std::optional<std::size_t> first_dmstatus_read;
  std::optional<std::size_t> first_data_write;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind == DmiOp::Kind::Read && op.reg == kDmstatus
        && !first_dmstatus_read)
      first_dmstatus_read = i;
    if (op.kind == DmiOp::Kind::Write && op.reg == kData0 && !first_data_write)
      first_data_write = i;
  }
  REQUIRE(first_dmstatus_read);
  REQUIRE(first_data_write);
  CHECK(*first_dmstatus_read < *first_data_write);
}

TEST_CASE("resume rejects a state with wrong magic")
{
  RecordingBus bus;
  hybrid::ResumeDriver driver(bus, kScratch);

  hybrid_state_v1 bad{};
  bad.version = HYBRID_STATE_VERSION;
  bad.magic = 0xDEADBEEFu;
  CHECK_THROWS(driver.resume(bad));
}

TEST_CASE("resume issues exactly one COMMAND per programmed register")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(rv64_state(0x80001000, 0));

  // x1..x31 + DPC at minimum (x0 skipped). We do not yet program FPR/CSR/V.
  CHECK(count_writes_to(bus.ops, kCommand) >= 32u);
}

namespace {

auto cmd_regnos(const std::vector<DmiOp>& ops) -> std::vector<uint16_t>
{
  std::vector<uint16_t> ns;
  for (const auto& op : ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand)
      ns.push_back(static_cast<uint16_t>(op.value & 0xffffu));
  return ns;
}

auto contains_regno(const std::vector<uint16_t>& ns, uint16_t regno) -> bool
{
  for (auto n : ns) if (n == regno) return true;
  return false;
}

}  // namespace

TEST_CASE("resume does NOT program the S-mode CSRs medeleg/mideleg/satp (nor "
          "mstatus without FP/V) via DM Abstract Commands; those fields are "
          "pass-through-merged at drain time instead")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.mstatus = 0x1800ULL;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  const auto ns = cmd_regnos(bus.ops);
  // mcycle(0xb00)/minstret(0xb02) are restored by resume (F-T2.4), mscratch
  // (0x340) since L23, and mepc(0x341)/mcause(0x342)/mtval(0x343)/mip(0x344)/
  // mie(0x304) since L24 -- none of those belong in this "must not program"
  // list. It now covers mstatus(0x300, restored only under FP/V; this state
  // has neither) plus the S-mode CSRs medeleg(0x302)/mideleg(0x303)/satp(0x180)
  // that the M-only default engine does not implement; those stay drain-time
  // pass-through. PMP, by contrast, IS now mirrored for every privilege level
  // -- see the dedicated L6/L2 (S/U) and L2 (M-mode) PMP tests below.
  for (uint16_t csr : {0x300, 0x302, 0x303, 0x180})
    CHECK_FALSE(contains_regno(ns, hybrid::regno_csr(csr)));
}

TEST_CASE("resume with HYBRID_FLAG_FP programs f0..f31 via Abstract Commands")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags  |= HYBRID_FLAG_FP;
  s.mstatus = 0x6000ULL;  // mstatus.FS = Dirty: FPRs are writable
  for (int i = 0; i < 32; ++i) s.fpr[i] = 0xf000000000000000ULL + i;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  const auto ns = cmd_regnos(bus.ops);
  for (uint16_t i = 0; i < 32; ++i)
    CHECK(contains_regno(ns, hybrid::regno_fpr(i)));
}

TEST_CASE("resume with HYBRID_FLAG_FP: mstatus written before FPR Abstract Commands")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags  |= HYBRID_FLAG_FP;
  s.mstatus = 0x6000ULL;
  s.fpr[0]  = 0xdeadbeefcafef00dULL;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  std::optional<std::size_t> mstatus_cmd_idx;
  std::optional<std::size_t> f0_cmd_idx;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind != DmiOp::Kind::Write || op.reg != kCommand) continue;
    const auto regno = static_cast<uint16_t>(op.value & 0xFFFFu);
    if (!mstatus_cmd_idx && regno == hybrid::regno_csr(0x300))
      mstatus_cmd_idx = i;
    if (!f0_cmd_idx && regno == hybrid::regno_fpr(0))
      f0_cmd_idx = i;
  }
  REQUIRE(mstatus_cmd_idx.has_value());
  REQUIRE(f0_cmd_idx.has_value());
  CHECK(*mstatus_cmd_idx < *f0_cmd_idx);
}

TEST_CASE("resume with HYBRID_FLAG_FP: FPR writes carry the state value via DATA0/DATA1")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags  |= HYBRID_FLAG_FP;
  s.mstatus = 0x6000ULL;
  s.fpr[7]  = 0x0123456789ABCDEFULL;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  std::optional<std::size_t> f7_cmd_idx;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && (op.value & 0xFFFFu) == hybrid::regno_fpr(7)) {
      f7_cmd_idx = i;
      break;
    }
  }
  REQUIRE(f7_cmd_idx.has_value());
  REQUIRE(*f7_cmd_idx >= 2);
  const auto& d0 = bus.ops[*f7_cmd_idx - 2];
  const auto& d1 = bus.ops[*f7_cmd_idx - 1];
  CHECK(d0.kind == DmiOp::Kind::Write);
  CHECK(d0.reg == kData0);
  CHECK(d0.value == uint32_t(s.fpr[7] & 0xFFFFFFFFu));
  CHECK(d1.kind == DmiOp::Kind::Write);
  CHECK(d1.reg == kData1);
  CHECK(d1.value == uint32_t(s.fpr[7] >> 32));
}

TEST_CASE("L20: resume with HYBRID_FLAG_FP restores fcsr via abstract "
          "command, after the mstatus.FS enable")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags  |= HYBRID_FLAG_FP;
  s.mstatus = 0x6000ULL;
  s.fcsr    = 0x21;  // frm=RTZ(1) << 5 | fflags=NX

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  std::optional<std::size_t> mstatus_cmd_idx, fcsr_cmd_idx;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind != DmiOp::Kind::Write || op.reg != kCommand) continue;
    const auto regno = static_cast<uint16_t>(op.value & 0xFFFFu);
    if (!mstatus_cmd_idx && regno == hybrid::regno_csr(0x300))
      mstatus_cmd_idx = i;
    if (!fcsr_cmd_idx && regno == hybrid::regno_csr(0x003))
      fcsr_cmd_idx = i;
  }
  REQUIRE(mstatus_cmd_idx.has_value());
  REQUIRE(fcsr_cmd_idx.has_value());
  CHECK(*mstatus_cmd_idx < *fcsr_cmd_idx);

  // The fcsr value rides DATA0/DATA1 of that abstract write.
  REQUIRE(*fcsr_cmd_idx >= 2);
  const auto& d0 = bus.ops[*fcsr_cmd_idx - 2];
  const auto& d1 = bus.ops[*fcsr_cmd_idx - 1];
  CHECK(d0.kind == DmiOp::Kind::Write);
  CHECK(d0.reg == kData0);
  CHECK(d0.value == 0x21u);
  CHECK(d1.kind == DmiOp::Kind::Write);
  CHECK(d1.reg == kData1);
  CHECK(d1.value == 0u);
}

TEST_CASE("L20: resume without HYBRID_FLAG_FP issues no fcsr write")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.fcsr = 0x21;  // present in the file but FP not flagged live

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  CHECK_FALSE(contains_regno(cmd_regnos(bus.ops), hybrid::regno_csr(0x003)));
}

TEST_CASE("L23: resume restores mscratch (software scratch CSR) via an "
          "abstract command, carrying the drained value on DATA0/DATA1")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.mscratch = 0xCAFEBABEDEADBEEFULL;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  // Find the write-COMMAND targeting mscratch (0x340); its value rides the
  // DATA0/DATA1 written immediately before (same shape as the fcsr restore).
  std::optional<std::size_t> ms_cmd_idx;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && (op.value & 0xFFFFu) == hybrid::regno_csr(0x340)
        && ((op.value >> 16) & 1u)) {
      ms_cmd_idx = i;
      break;
    }
  }
  REQUIRE(ms_cmd_idx.has_value());
  REQUIRE(*ms_cmd_idx >= 2);
  const auto& d0 = bus.ops[*ms_cmd_idx - 2];
  const auto& d1 = bus.ops[*ms_cmd_idx - 1];
  CHECK(d0.kind == DmiOp::Kind::Write);
  CHECK(d0.reg == kData0);
  CHECK(d0.value == uint32_t(s.mscratch & 0xFFFFFFFFu));
  CHECK(d1.kind == DmiOp::Kind::Write);
  CHECK(d1.reg == kData1);
  CHECK(d1.value == uint32_t(s.mscratch >> 32));
}

TEST_CASE("L24: resume restores mepc/mcause/mtval/mip/mie via abstract "
          "commands, each carrying its drained value on DATA0/DATA1")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.mepc   = 0x1111111122222222ULL;
  s.mcause = 0x8000000000000007ULL;  // machine timer interrupt cause encoding
  s.mtval  = 0x3333333344444444ULL;
  s.mip    = 0x0000000000000080ULL;  // MTIP
  s.mie    = 0x0000000000000888ULL;  // MTIE | MEIE | MSIE

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  // Each CSR gets a write-COMMAND (bit 16 set) carrying its value on the
  // DATA0/DATA1 written immediately before (same shape as fcsr/mscratch).
  const std::pair<uint16_t, uint64_t> want[] = {
    {0x341, s.mepc}, {0x342, s.mcause}, {0x343, s.mtval},
    {0x344, s.mip},  {0x304, s.mie},
  };
  for (const auto& [csr, val] : want) {
    std::optional<std::size_t> cmd_idx;
    for (std::size_t i = 0; i < bus.ops.size(); ++i) {
      const auto& op = bus.ops[i];
      if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
          && (op.value & 0xFFFFu) == hybrid::regno_csr(csr)
          && ((op.value >> 16) & 1u)) {
        cmd_idx = i;
        break;
      }
    }
    REQUIRE(cmd_idx.has_value());
    REQUIRE(*cmd_idx >= 2);
    const auto& d0 = bus.ops[*cmd_idx - 2];
    const auto& d1 = bus.ops[*cmd_idx - 1];
    CHECK(d0.reg == kData0);
    CHECK(d0.value == uint32_t(val & 0xFFFFFFFFu));
    CHECK(d1.reg == kData1);
    CHECK(d1.value == uint32_t(val >> 32));
  }
}

TEST_CASE("Andes cache fix: resume restores mcache_ctl + mmisc_ctl via "
          "abstract commands, each carrying its drained value on DATA0/DATA1")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.mcache_ctl = 0x703ULL;  // crt0's I-cache + D-cache + prefetch enable
  s.mmisc_ctl  = 0x40ULL;

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  // Each Andes setup CSR gets a write-COMMAND (bit 16 set) carrying its value
  // on the DATA0/DATA1 written immediately before (same shape as fcsr/mscratch).
  const std::pair<uint16_t, uint64_t> want[] = {
    {0x7CA, s.mcache_ctl}, {0x7D0, s.mmisc_ctl},
  };
  for (const auto& [csr, val] : want) {
    std::optional<std::size_t> cmd_idx;
    for (std::size_t i = 0; i < bus.ops.size(); ++i) {
      const auto& op = bus.ops[i];
      if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
          && (op.value & 0xFFFFu) == hybrid::regno_csr(csr)
          && ((op.value >> 16) & 1u)) {
        cmd_idx = i;
        break;
      }
    }
    REQUIRE(cmd_idx.has_value());
    REQUIRE(*cmd_idx >= 2);
    const auto& d0 = bus.ops[*cmd_idx - 2];
    const auto& d1 = bus.ops[*cmd_idx - 1];
    CHECK(d0.reg == kData0);
    CHECK(d0.value == uint32_t(val & 0xFFFFFFFFu));
    CHECK(d1.reg == kData1);
    CHECK(d1.value == uint32_t(val >> 32));
  }
}

