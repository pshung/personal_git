TEST_CASE("L6/L2: S/U resume mirrors the producer's PMP block, addr before cfg")
{
  // With PMP implemented and no matching entry, every S/U access faults
  // (priv spec v1.10) -- an S/U ROI cannot even fetch its first insn on the
  // vsim side unless the producer's PMP block is mirrored in.
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.priv = 0;  // U-mode
  for (int i = 0; i < HYBRID_PMP_ADDR_NUM; ++i) s.pmpaddr[i] = 0xb000 + i;
  s.pmpcfg[0] = 0x1f;  // entry 0: NAPOT, RWX

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  std::vector<uint16_t> regnos;
  for (const auto& op : bus.ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && ((op.value >> 16) & 1u) != 0u)
      regnos.push_back(static_cast<uint16_t>(op.value & 0xffffu));

  // All 64 pmpaddr CSRs (0x3B0..0x3EF) and the 8 even pmpcfg CSRs
  // (0x3A0,0x3A2,..,0x3AE -- odd ones do not exist on RV64) are written.
  std::size_t first_cfg = regnos.size(), last_addr = 0;
  std::size_t n_addr = 0, n_cfg = 0, n_odd_cfg = 0;
  for (std::size_t i = 0; i < regnos.size(); ++i) {
    const auto r = regnos[i];
    if (r >= 0x3B0 && r <= 0x3EF) { ++n_addr; last_addr = i; }
    if (r >= 0x3A0 && r <= 0x3AF) {
      if ((r & 1u) != 0u) ++n_odd_cfg;
      else { ++n_cfg; if (i < first_cfg) first_cfg = i; }
    }
  }
  CHECK(n_addr == 64u);
  CHECK(n_cfg == 8u);
  CHECK(n_odd_cfg == 0u);
  // cfg activates the entries, so every addr write must precede every cfg
  // write (a cfg-locked entry would discard the addr that follows it).
  CHECK(last_addr < first_cfg);
}

TEST_CASE("L2: M-mode resume also mirrors the producer's PMP block, addr "
          "before cfg, so a locked region stays enforced inside the ROI")
{
  // Pre-fix, an M-mode handoff skipped PMP entirely: M-mode bypasses *unlocked*
  // entries so the ROI still fetched, but a *locked* region the producer set up
  // was then silently unenforced in the measured window (L2). Mirror PMP for
  // M-mode too -- M ignores the unlocked entries and honors the locked ones,
  // exactly as real hardware does.
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.priv = 3;  // M-mode handoff
  for (int i = 0; i < HYBRID_PMP_ADDR_NUM; ++i) s.pmpaddr[i] = 0xb000 + i;
  s.pmpcfg[0] = 0x9f;  // entry 0: LOCKED (L=bit7) NAPOT RWX

  hybrid::ResumeDriver driver(bus, kScratch);
  driver.resume(s);

  std::vector<uint16_t> regnos;
  for (const auto& op : bus.ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == kCommand
        && ((op.value >> 16) & 1u) != 0u)
      regnos.push_back(static_cast<uint16_t>(op.value & 0xffffu));

  // Same shape as the S/U mirror: all 64 pmpaddr (0x3B0..0x3EF) and the 8 even
  // pmpcfg (0x3A0..0x3AE; odd ones do not exist on RV64), addr before cfg.
  std::size_t first_cfg = regnos.size(), last_addr = 0;
  std::size_t n_addr = 0, n_cfg = 0, n_odd_cfg = 0;
  for (std::size_t i = 0; i < regnos.size(); ++i) {
    const auto r = regnos[i];
    if (r >= 0x3B0 && r <= 0x3EF) { ++n_addr; last_addr = i; }
    if (r >= 0x3A0 && r <= 0x3AF) {
      if ((r & 1u) != 0u) ++n_odd_cfg;
      else { ++n_cfg; if (i < first_cfg) first_cfg = i; }
    }
  }
  CHECK(n_addr == 64u);
  CHECK(n_cfg == 8u);
  CHECK(n_odd_cfg == 0u);
  CHECK(last_addr < first_cfg);
}

TEST_CASE("L6: resume aborts loudly when the hart pins dcsr.prv (no S/U)")
{
  // An M-only core (e.g. NDS_NUM_PRIVILEGE_LEVELS=1 RTL) WARL-pins
  // dcsr.prv to 3. Silently resuming would measure the ROI in the wrong
  // privilege; the driver must verify its write took and throw instead.
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);
  bus.regfile[hybrid::regno_csr(kCsrDcsr)] = 0x40000003ULL;  // reset: prv=M
  bus.warl_ignore.insert(hybrid::regno_csr(kCsrDcsr));

  auto s = rv64_state(0x80001000, 0);
  s.priv = 1;

  hybrid::ResumeDriver driver(bus, kScratch);
  CHECK_THROWS_AS(driver.resume(s), std::runtime_error);
}

TEST_CASE("L26: resume of V state with the scratch GPA unset throws (no silent "
          "transport through a bogus address)")
{
  RecordingBus bus;
  bus.dmstatus_value = (1u << 9) | (1u << 17);

  auto s = rv64_state(0x80001000, 0);
  s.flags |= HYBRID_FLAG_V;
  s.vlenb = 16;

  // Default ctor leaves scratch_gpa = kVScratchGpaUnset; a non-V resume would
  // be fine, but a V resume must fail loudly rather than sweep from garbage.
  hybrid::ResumeDriver driver(bus);
  CHECK_THROWS_AS(driver.resume(s), std::runtime_error);

  // The same V state resumes cleanly once a real scratch GPA is supplied.
  RecordingBus bus2;
  bus2.dmstatus_value = (1u << 9) | (1u << 17);
  hybrid::ResumeDriver ok(bus2, kScratch);
  CHECK_NOTHROW(ok.resume(s));
}
