// Unit tests for the oracle differential compare (driver/state_diff.hpp).
//
// Policy under test (docs/archive/verify_oracle.md): strictly compare what vsim's exit
// drain freshly reads (pc, GPRs; FPRs under FLAG_FP; V CSRs + vreg bytes
// under FLAG_V) plus the identity fields; SKIP the passthrough M-CSRs/PMP
// (vsim copies them from QEMU1's entry snapshot, so they cannot equal the
// oracle's exit values by construction); MASK the counters (engines count
// differently by design).
#include "state_diff.hpp"

#include "hybrid/state_abi.h"
#include "test_check.hpp"

using namespace andes_sim;

namespace {

// A fully populated reference state (FP + V live).
hybrid_state_v1 base_state() {
  hybrid_state_v1 s{};
  s.magic = HYBRID_STATE_MAGIC;
  s.version = HYBRID_STATE_VERSION;
  s.flags = HYBRID_FLAG_RV64 | HYBRID_FLAG_FP | HYBRID_FLAG_V;
  s.hart_id = 0;
  s.priv = 3;
  s.pc = 0x100240;
  for (int i = 0; i < 32; ++i) s.gpr[i] = 0x1000 + i;
  s.gpr[0] = 0;
  for (int i = 0; i < 32; ++i) s.fpr[i] = 0x2000 + i;
  s.fcsr = 0x21;  // frm=RTZ | fflags=NX (L20)
  s.vstart = 0;
  s.vtype = 0xd0;
  s.vl = 16;
  s.vlenb = 64;
  s.vxsat = 0;
  s.vxrm = 1;
  s.vcsr = 2;
  for (int i = 0; i < 32 * HYBRID_VLEN_BYTES_MAX; ++i)
    s.vreg[i] = static_cast<uint8_t>(i * 7);
  s.mcycle = 1000;
  s.minstret = 900;
  s.mstatus = 0xa00002200ull;
  s.mepc = 0x5555;
  s.satp = 0x9999;
  s.pmpaddr[3] = 0x77;
  return s;
}

// Fields strictly compared for a FP+V state (hybrid policy): 6 identity/pc +
// 4 mepc/mcause/mtval/mie (L24) + 1 mscratch (L23) + 32 gpr + 32 fpr +
// fcsr (L20) + 7 V scalars + 32 vregs.
constexpr int kFullCompared = 6 + 4 + 1 + 32 + 33 + 7 + 32;

// An RV64-only state with the Andes block live (HYBRID_FLAG_ANDES), every
// transported Andes CSR carrying a distinct sentinel.
hybrid_state_v1 andes_state() {
  hybrid_state_v1 s{};
  s.magic = HYBRID_STATE_MAGIC;
  s.version = HYBRID_STATE_VERSION;
  s.flags = HYBRID_FLAG_RV64 | HYBRID_FLAG_ANDES;
  s.priv = 3;
  s.pc = 0x100240;
  for (int i = 0; i < 32; ++i) s.gpr[i] = 0x1000 + i;
  s.gpr[0] = 0;
  uint64_t v = 0xA000;
#define X(field, addr, name) s.andes.field = v++;
  HYBRID_ANDES_CSR_LIST(X)
#undef X
  for (int i = 0; i < HYBRID_PMA_CFG_NUM; ++i) s.andes.pmacfg[i] = 0xB000 + i;
  for (int i = 0; i < HYBRID_PMA_ADDR_NUM; ++i) s.andes.pmaaddr[i] = 0xC000 + i;
  return s;
}

// Andes block compared fields: 13 scalars - 4 verify-excluded (msp_bound,
// msp_base, milmb, mdlmb; engine-reset-divergent, see state_diff.cpp) +
// pmacfg[2] + pmaaddr[16] = 27.
constexpr int kAndesCompared =
    (13 - 4) + HYBRID_PMA_CFG_NUM + HYBRID_PMA_ADDR_NUM;

}  // namespace

int main() {
  {  // identical states -> ok, full field count
    const hybrid_state_v1 a = base_state();
    const DiffReport r = diff_states(a, a);
    CHECK(r.ok());
    CHECK(r.compared == kFullCompared);
  }

  {  // a GPR mismatch is caught and named
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.gpr[5] = 0xdead;
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "x5");
    CHECK(r.diffs[0].ref == 0x1005);
    CHECK(r.diffs[0].got == 0xdead);
  }

  {  // pc mismatch
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.pc = ref.pc + 4;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "pc");
  }

  {  // counters are masked: mcycle/minstret may differ
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.mcycle = 999999;
    got.minstret = 888888;
    CHECK(diff_states(ref, got).ok());
  }

  {  // passthrough M-CSRs/PMP are skipped, not compared. mepc/mcause/mtval/mie
     // left this set in L24 and mscratch in L23 (they now round-trip and are
     // strictly compared); mip stays here (hardware-driven pending bits).
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.mstatus = 0x1;
    got.mtvec = 0x3;
    got.medeleg = 0x7;
    got.mideleg = 0x8;
    got.mip = 0x9;
    got.satp = 0xb;
    got.pmpcfg[0] = 0xc;
    got.pmpaddr[63] = 0xd;
    CHECK(diff_states(ref, got).ok());
  }

  {  // L23: mscratch round-trips (restored at resume, re-read at drain), so the
     // hybrid verify policy compares it.
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.mscratch = 0xdead;
    const DiffReport hy = diff_states(ref, got);
    CHECK(!hy.ok());
    CHECK(hy.diffs.size() == 1);
    CHECK(hy.diffs[0].field == "mscratch");
  }

  {  // L24: mepc/mcause/mtval/mie round-trip through the hybrid handoff, so the
     // hybrid policy compares each. mip is restored + re-read but EXCLUDED from
     // verify (its pending bits are hardware/platform-driven and diverge
     // between QEMU's functional clock and vsim's cycle-accurate one).
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    {
      hybrid_state_v1 got = ref;
      got.mepc = 0xbad;
      const DiffReport hy = diff_states(ref, got);
      CHECK(hy.diffs.size() == 1);
      CHECK(hy.diffs[0].field == "mepc");
    }
    {
      hybrid_state_v1 got = ref;
      got.mtval = 0xbad;
      const DiffReport hy = diff_states(ref, got);
      CHECK(hy.diffs.size() == 1);
      CHECK(hy.diffs[0].field == "mtval");
    }
    {
      hybrid_state_v1 got = ref;
      got.mie = 0xbad;
      const DiffReport hy = diff_states(ref, got);
      CHECK(hy.diffs.size() == 1);
      CHECK(hy.diffs[0].field == "mie");
    }
    {  // mip excluded from verify.
      hybrid_state_v1 got = ref;
      got.mip = 0xbad;
      CHECK(diff_states(ref, got).ok());
    }
  }

  {  // no FLAG_FP -> FPRs not compared, count shrinks
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.fpr[7] = 0xbad;
    got.vtype = 0xbad;  // V block also off
    const DiffReport r = diff_states(ref, got);
    CHECK(r.ok());
    // identity/pc + gpr + mscratch (L23) + mepc/mcause/mtval/mie (L24)
    CHECK(r.compared == 6 + 32 + 1 + 4);
  }

  {  // FPR mismatch under FLAG_FP
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.fpr[31] = 0;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "f31");
  }

  {  // fcsr mismatch under FLAG_FP (L20)
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.fcsr = 0;  // restore lost: vsim drained the reset value
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "fcsr");
  }

  {  // V scalar CSR mismatch
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.vl = 8;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "vl");
  }

  {  // vreg byte mismatch names the register and byte offset
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.vreg[3 * HYBRID_VLEN_BYTES_MAX + 7] ^= 0xff;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "v3[7]");
    CHECK(r.diffs[0].ref == ref.vreg[3 * HYBRID_VLEN_BYTES_MAX + 7]);
  }

  {  // identity mismatch (flags) is caught
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.flags = HYBRID_FLAG_RV64;
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    bool saw_flags = false;
    for (const FieldDiff& d : r.diffs) saw_flags |= d.field == "flags";
    CHECK(saw_flags);
  }

  {  // multiple mismatches all reported
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.gpr[1] = 1;
    got.gpr[2] = 2;
    got.pc = 4;
    CHECK(diff_states(ref, got).diffs.size() == 3);
  }

  {  // field count for an RV64-only state: identity/pc + gpr + the round-trip
     // M-CSRs mscratch (L23) and mepc/mcause/mtval/mie (L24) = 5 extra.
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;  // no FP/V to keep the count simple
    const DiffReport r = diff_states(ref, ref);
    CHECK(r.compared == 6 + 32 + 5);  // + mscratch/mepc/mcause/mtval/mie
    CHECK(r.ok());
  }

  {  // mcause mismatch caught (L24: hybrid compares it)
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.mcause = 2;  // illegal-instruction vs ref's 0
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "mcause");
    CHECK(r.diffs[0].got == 2);
  }

  {  // mstatus stays EXCLUDED (dirty/impl-defined bits).
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.mstatus = 0x1;
    CHECK(diff_states(ref, got).ok());
  }

  {  // Andes block (v3): identical states match, with the full extra field count.
    const hybrid_state_v1 a = andes_state();
    const DiffReport r = diff_states(a, a);
    CHECK(r.ok());
    CHECK(r.compared == 6 + 32 + 5 + kAndesCompared);  // base RV64 set + andes
  }

  {  // each representative COMPARED Andes CSR is caught + named (milmb/mdlmb are
     // verify-excluded -- see the dedicated block above)
    const hybrid_state_v1 ref = andes_state();
    const std::pair<const char*, uint64_t hybrid_andes_csr::*> probes[] = {
      {"uitb", &hybrid_andes_csr::uitb},            // F1 CoDense
      {"jvt", &hybrid_andes_csr::jvt},              // F1 Zcmt
      {"mxstatus", &hybrid_andes_csr::mxstatus},    // F2
      {"ucode", &hybrid_andes_csr::ucode},          // F4 DSP
      {"mecc_code", &hybrid_andes_csr::mecc_code},  // F5 memory system
      {"mpft_ctl", &hybrid_andes_csr::mpft_ctl},    // F6
      {"mhsp_ctl", &hybrid_andes_csr::mhsp_ctl},    // F7
      {"mcountermask_m", &hybrid_andes_csr::mcountermask_m},  // F8
    };
    for (const auto& [name, member] : probes) {
      hybrid_state_v1 got = ref;
      got.andes.*member ^= 0xDEAD;
      const DiffReport r = diff_states(ref, got);
      CHECK(r.diffs.size() == 1);
      CHECK(r.diffs[0].field == name);
    }
  }

  {  // F3 PMA: a pmacfg and a pmaaddr mismatch are each caught + named
    const hybrid_state_v1 ref = andes_state();
    {
      hybrid_state_v1 got = ref;
      got.andes.pmacfg[1] = 0xbad;
      const DiffReport r = diff_states(ref, got);
      CHECK(r.diffs.size() == 1);
      CHECK(r.diffs[0].field == "pmacfg1");
    }
    {
      hybrid_state_v1 got = ref;
      got.andes.pmaaddr[5] = 0xbad;
      const DiffReport r = diff_states(ref, got);
      CHECK(r.diffs.size() == 1);
      CHECK(r.diffs[0].field == "pmaaddr5");
    }
  }

  {  // without HYBRID_FLAG_ANDES the block is NOT compared (zero or stale)
    hybrid_state_v1 ref = andes_state();
    ref.flags = HYBRID_FLAG_RV64;  // clear ANDES
    hybrid_state_v1 got = ref;
    got.andes.uitb = 0xbad;
    got.andes.pmaaddr[0] = 0xbad;
    CHECK(diff_states(ref, got).ok());
  }

  {  // msp_bound/msp_base are engine-reset-divergent (QEMU resets them to
     // all-ones; a vsim core without HW stack protection drains 0), so verify
     // EXCLUDES them like mip -- still transported, just not strict-compared.
    const hybrid_state_v1 ref = andes_state();
    hybrid_state_v1 got = ref;
    got.andes.msp_bound = 0;
    got.andes.msp_base = 0;
    CHECK(diff_states(ref, got).ok());
  }

  {  // milmb/mdlmb are the ILM/DLM base+enable CSRs. The base address matches
     // across engines, but the enable bit (bit 0) is HW-presence state: the vsim
     // RTL has the local memories and drains EN=1, while QEMU models none and
     // drains EN=0. Same engine-reset-divergent class as msp_bound/msp_base, so
     // verify EXCLUDES them -- still transported, just not strict-compared.
    const hybrid_state_v1 ref = andes_state();
    hybrid_state_v1 got = ref;
    got.andes.milmb ^= 0x1;  // flip the enable bit only (base unchanged)
    got.andes.mdlmb ^= 0x1;
    CHECK(diff_states(ref, got).ok());
  }

  {  // mnvec is engine-reset-divergent: QEMU resets it to 0, the Andes RTL
     // resets it to the hart's reset vector (0x100000 seen live on both
     // engines) and WARL-holds it, so a trap-free ROI always false-diffs.
     // Same class as msp_bound/msp_base: transported, not strict-compared.
    hybrid_state_v1 ref = andes_state();
    ref.flags |= HYBRID_FLAG_M_EXT;
    hybrid_state_v1 got = ref;
    got.m_ext.mnvec = 0x100000;                  // engine reset vector
    CHECK(diff_states(ref, got).ok());
    got.m_ext.mcountinhibit = 0xbad;             // control: M-ext IS compared
    CHECK(!diff_states(ref, got).ok());
  }

  {  // S4 Andes caps: a CSR the engine does NOT implement is verify-excluded.
     // vsim never restored/re-read it (the resume/drain gate), so comparing it
     // against the QEMU oracle would false-diff. The supported list comes from
     // the engine's --describe andes_csrs.
    const hybrid_state_v1 ref = andes_state();
    hybrid_state_v1 got = ref;
    got.andes.ucode ^= 0xDEAD;

    // engine lacks ucode -> excluded, no diff.
    CHECK(diff_states(ref, got, {"uitb", "milmb"}).ok());
    // engine has ucode -> the diff IS reported.
    const DiffReport in = diff_states(ref, got, {"ucode"});
    CHECK(in.diffs.size() == 1);
    CHECK(in.diffs[0].field == "ucode");
    // empty list (default) = compare all (state-diff subcommand / no engine info).
    CHECK(diff_states(ref, got).diffs.size() == 1);
  }

  {  // S4 Andes caps: the PMA block is excluded via the "pmaaddr"/"pmacfg" markers
    const hybrid_state_v1 ref = andes_state();
    hybrid_state_v1 got = ref;
    got.andes.pmaaddr[0] ^= 0xDEAD;
    CHECK(diff_states(ref, got, {"uitb"}).ok());  // no PMA support -> excluded
    const DiffReport in = diff_states(ref, got, {"pmaaddr"});
    CHECK(in.diffs.size() == 1);
    CHECK(in.diffs[0].field == "pmaaddr0");
  }

  {  // v5: L2C Control Register RW bits round-trip (restored at resume, re-read
     // at drain), so the hybrid policy compares them and names a mismatch.
    hybrid_state_v1 ref{};
    ref.magic = HYBRID_STATE_MAGIC;
    ref.version = HYBRID_STATE_VERSION;
    ref.flags = HYBRID_FLAG_RV64 | HYBRID_FLAG_L2C;
    ref.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0x1;  // CEN=1
    hybrid_state_v1 got = ref;
    got.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0x0;  // transport lost the enable
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "l2c.ctrl");
  }

  {  // v5: INITSTATUS[14] is read-only status (a real L2C model drives it, the
     // QEMU RAM stub does not), so it is masked out of the compare.
    hybrid_state_v1 ref{};
    ref.magic = HYBRID_STATE_MAGIC;
    ref.version = HYBRID_STATE_VERSION;
    ref.flags = HYBRID_FLAG_RV64 | HYBRID_FLAG_L2C;
    ref.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0x1;                    // INITSTATUS=0
    hybrid_state_v1 got = ref;
    got.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0x1 | (1ull << 14);     // INITSTATUS=1
    CHECK(diff_states(ref, got).ok());
  }

  {  // v5: with HYBRID_FLAG_L2C clear the L2C block is not live, so it is skipped.
    hybrid_state_v1 ref{};
    ref.magic = HYBRID_STATE_MAGIC;
    ref.version = HYBRID_STATE_VERSION;
    ref.flags = HYBRID_FLAG_RV64;  // no L2C flag
    ref.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0x1;
    hybrid_state_v1 got = ref;
    got.l2c.reg[HYBRID_L2C_OFF_CONTROL / 8] = 0xdead;  // differs, but not compared
    CHECK(diff_states(ref, got).ok());
  }

  {  // v6: with a write-mask, an UNWRITTEN CSR is not compared -- its drained
     // value is only QEMU's reset default, which may legitimately differ from
     // the engine's RTL reset value the re-read returns.
    hybrid_state_v1 ref = andes_state();
    ref.flags |= HYBRID_FLAG_WRITE_MASK;   // mask live, all bits clear
    hybrid_state_v1 got = ref;
    got.andes.mxstatus ^= 0xF00;           // reset-divergent, but unwritten
    got.andes.pmaaddr[2] ^= 0xF00;
    CHECK(diff_states(ref, got).ok());
  }

  {  // v6: a WRITTEN CSR still compares -- and a mismatch is named.
    hybrid_state_v1 ref = andes_state();
    ref.flags |= HYBRID_FLAG_WRITE_MASK;
    hybrid_wm_set(ref.write_mask,
                  HYBRID_WM_ANDES_BASE + HYBRID_WM_ANDES_IDX_mxstatus);
    hybrid_state_v1 got = ref;
    got.andes.mxstatus ^= 0xF00;
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "mxstatus");
  }

  {  // v6: flag clear (pre-v6 file) -> compare everything, the old behavior.
    hybrid_state_v1 ref = andes_state();   // no WRITE_MASK flag
    hybrid_state_v1 got = ref;
    got.andes.mxstatus ^= 0xF00;
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "mxstatus");
  }

  return andes_sim::test::report("state_diff");
}
