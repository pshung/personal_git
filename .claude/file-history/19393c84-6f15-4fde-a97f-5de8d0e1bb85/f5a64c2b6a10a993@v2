// Write-mask drain fixture (v6): exercise each CSR-write tracking case, then
// hit the ROI entry marker so the QEMU plugin drains. Verifies the plugin
// records WHICH mask-governed CSRs the guest wrote (HYBRID_FLAG_WRITE_MASK +
// hybrid_state_v1.write_mask[]).
//
// Every write is read-modify-write-same (csrr then csrw of the same value):
// architecturally a no-op, but an unmistakable WRITE instruction for the
// translate-time decoder. The mmisc_ctl access is a pure read (csrr = csrrs
// rs1=x0) and must NOT set its bit.

#include "semihost_exit.inc"

.section .text
.globl _start
_start:
    csrr    t0, 0x7C4               // mxstatus: read...
    csrw    0x7C4, t0               // ...write back same value  -> bit SET
    csrr    t1, 0x7CA               // mcache_ctl: read...
    csrw    0x7CA, t1               // ...write back same value  -> bit SET
    csrr    t2, 0x7D0               // mmisc_ctl: PURE READ      -> bit CLEAR
    slti    x0, x0, 0x5A0           // ROI entry: QEMU drains, exits 200
    slti    x0, x0, 0x5A1           // exit marker (unused in this drain-only test)
    li      a0, 0
    SEMIHOST_EXIT a0
