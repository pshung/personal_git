// L2C drain fixture (v5): write a known value to the L2 cache controller
// Control Register (MMIO), then hit the ROI entry marker so the QEMU plugin
// drains. Verifies the plugin captures the L2C MMIO register window into
// hybrid_state_v1 (HYBRID_FLAG_L2C + hybrid_l2c.reg[]).
//
// The L2C block is at 0xE0500000 (DS220 24.2); the Control Register is at
// offset 0x0008 (DS220 11.8.7). QEMU's andes_ae350 machine backs the region
// with RAM, so the `sw` lands there and the plugin's physical-address read
// picks it up at the handoff.

#include "semihost_exit.inc"

.section .text
.globl _start
_start:
    li      t0, 0xE0500008          // L2C Control Register
    li      t1, 0xA5                // CEN=1 (bit 0) + distinctive config bits
    sw      t1, 0(t0)               // write into QEMU's L2C region
    fence   rw, rw
    slti    x0, x0, 0x5A0           // ROI entry: QEMU drains, exits 200
    slti    x0, x0, 0x5A1           // vsim exit marker (unused in this drain-only test)
    li      a0, 0
    SEMIHOST_EXIT a0
