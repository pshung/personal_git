// Unit tests for hybrid/write_mask.h (ABI v6): the CSR write-mask slot map,
// set/test helpers, and the translate-time CSR-write instruction decoder.
// Golden instruction words come from riscv64-unknown-elf-as (Andes toolchain).

#include "hybrid/write_mask.h"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include <cstdint>

TEST_CASE("v6: slot map layout is the wire contract")
{
  CHECK(HYBRID_WM_ANDES_BASE == 0);
  CHECK(HYBRID_WM_ANDES_COUNT == 13);
  CHECK(HYBRID_WM_PMACFG_BASE == 13);
  CHECK(HYBRID_WM_PMAADDR_BASE == 15);
  CHECK(HYBRID_WM_M_EXT_BASE == 31);
  CHECK(HYBRID_WM_M_EXT_COUNT == 51);
  CHECK(HYBRID_WM_MCACHE_CTL == 82);
  CHECK(HYBRID_WM_MMISC_CTL == 83);
  CHECK(HYBRID_WM_SLOT_COUNT == 84);
}

TEST_CASE("v6: set/test helpers cover both mask words")
{
  uint64_t m[2] = {0, 0};
  CHECK(hybrid_wm_test(m, 0) == 0);
  hybrid_wm_set(m, 0);                    // word 0, bit 0
  hybrid_wm_set(m, 63);                   // word 0, bit 63
  hybrid_wm_set(m, 64);                   // word 1, bit 0
  hybrid_wm_set(m, HYBRID_WM_MMISC_CTL);  // slot 83: word 1, bit 19
  CHECK(hybrid_wm_test(m, 0) == 1);
  CHECK(hybrid_wm_test(m, 63) == 1);
  CHECK(hybrid_wm_test(m, 64) == 1);
  CHECK(hybrid_wm_test(m, HYBRID_WM_MMISC_CTL) == 1);
  CHECK(hybrid_wm_test(m, 1) == 0);
  CHECK(hybrid_wm_test(m, HYBRID_WM_MCACHE_CTL) == 0);
  CHECK(m[0] == ((1ull << 0) | (1ull << 63)));
  CHECK(m[1] == ((1ull << 0) | (1ull << (83 - 64))));
}

TEST_CASE("v6: CSR-write decode -- golden encodings from riscv64-elf-as")
{
  uint16_t csr = 0;

  // csrw mxstatus,t0 (csrrw x0, 0x7C4, t0): csrrw ALWAYS writes.
  CHECK(hybrid_wm_insn_csr_write(0x7C429073u, &csr) == 1);
  CHECK(csr == 0x7C4);

  // csrr t2,mmisc_ctl (csrrs t2, 0x7D0, x0): rs1=x0 -> pure read.
  CHECK(hybrid_wm_insn_csr_write(0x7D0023F3u, &csr) == 0);

  // csrs mxstatus,t0 (csrrs x0, 0x7C4, t0): rs1!=x0 -> writes.
  CHECK(hybrid_wm_insn_csr_write(0x7C42A073u, &csr) == 1);
  CHECK(csr == 0x7C4);

  // csrc msp_bound,t3 (csrrc x0, 0x7C7, t3): rs1!=x0 -> writes.
  CHECK(hybrid_wm_insn_csr_write(0x7C7E3073u, &csr) == 1);
  CHECK(csr == 0x7C7);

  // csrwi mmisc_ctl,0 (csrrwi x0, 0x7D0, 0): csrrwi ALWAYS writes, even uimm=0.
  CHECK(hybrid_wm_insn_csr_write(0x7D005073u, &csr) == 1);
  CHECK(csr == 0x7D0);

  // csrsi mxstatus,0 (csrrsi x0, 0x7C4, 0): uimm=0 -> pure read.
  CHECK(hybrid_wm_insn_csr_write(0x7C406073u, &csr) == 0);

  // csrsi mxstatus,5 (csrrsi x0, 0x7C4, 5): uimm!=0 -> writes.
  CHECK(hybrid_wm_insn_csr_write(0x7C42E073u, &csr) == 1);
  CHECK(csr == 0x7C4);

  // Non-CSR SYSTEM insns are not writes: ebreak / ecall / wfi / mret.
  CHECK(hybrid_wm_insn_csr_write(0x00100073u, &csr) == 0);  // ebreak
  CHECK(hybrid_wm_insn_csr_write(0x00000073u, &csr) == 0);  // ecall
  CHECK(hybrid_wm_insn_csr_write(0x10500073u, &csr) == 0);  // wfi
  CHECK(hybrid_wm_insn_csr_write(0x30200073u, &csr) == 0);  // mret

  // Non-SYSTEM opcode: sw x5,8(x6).
  CHECK(hybrid_wm_insn_csr_write(0x00532423u, &csr) == 0);
}

TEST_CASE("v6: CSR address -> slot mapping")
{
  // Andes scalars ride the X-macro order: mxstatus is slot 0, msp_bound 7,
  // ucode 12 (the DSP-side-effect slot producers set unconditionally).
  CHECK(hybrid_wm_slot_for_csr(0x7C4) == HYBRID_WM_ANDES_BASE + HYBRID_WM_ANDES_IDX_mxstatus);
  CHECK(hybrid_wm_slot_for_csr(0x7C4) == 0);
  CHECK(hybrid_wm_slot_for_csr(0x7C7) == 7);    // msp_bound
  CHECK(hybrid_wm_slot_for_csr(0x801) == 12);   // ucode
  // PMA: pmacfg0/2 + the pmaaddr range.
  CHECK(hybrid_wm_slot_for_csr(0xBC0) == HYBRID_WM_PMACFG_BASE + 0);
  CHECK(hybrid_wm_slot_for_csr(0xBC2) == HYBRID_WM_PMACFG_BASE + 1);
  CHECK(hybrid_wm_slot_for_csr(0xBC1) == -1);   // odd pmacfg: RV32-only, not transported
  CHECK(hybrid_wm_slot_for_csr(0xBD0) == HYBRID_WM_PMAADDR_BASE + 0);
  CHECK(hybrid_wm_slot_for_csr(0xBDF) == HYBRID_WM_PMAADDR_BASE + 15);
  CHECK(hybrid_wm_slot_for_csr(0xBE0) == -1);   // past the pmaaddr range
  // M-ext block: menvcfg heads the list.
  CHECK(hybrid_wm_slot_for_csr(0x30A) == HYBRID_WM_M_EXT_BASE + HYBRID_WM_M_EXT_IDX_menvcfg);
  CHECK(hybrid_wm_slot_for_csr(0x30A) == 31);
  // The two loose machine-setup CSRs.
  CHECK(hybrid_wm_slot_for_csr(0x7CA) == HYBRID_WM_MCACHE_CTL);
  CHECK(hybrid_wm_slot_for_csr(0x7D0) == HYBRID_WM_MMISC_CTL);
  // Not mask-governed: mstatus, mepc, mtvec, fcsr, pmpcfg0, dcsr.
  CHECK(hybrid_wm_slot_for_csr(0x300) == -1);
  CHECK(hybrid_wm_slot_for_csr(0x341) == -1);
  CHECK(hybrid_wm_slot_for_csr(0x305) == -1);
  CHECK(hybrid_wm_slot_for_csr(0x003) == -1);
  CHECK(hybrid_wm_slot_for_csr(0x3A0) == -1);
  CHECK(hybrid_wm_slot_for_csr(0x7B0) == -1);
}

TEST_CASE("v6: combined insn -> slot filter (the producer's translate-time gate)")
{
  // csrw mxstatus,t0 -> slot 0.
  CHECK(hybrid_wm_slot_for_insn(0x7C429073u) == 0);
  // csrw mcache_ctl,t1 -> the mcache_ctl slot.
  CHECK(hybrid_wm_slot_for_insn(0x7CA31073u) == HYBRID_WM_MCACHE_CTL);
  // csrr t2,mmisc_ctl -> a read: no slot.
  CHECK(hybrid_wm_slot_for_insn(0x7D0023F3u) == -1);
  // csrw pmaaddr0,t0 -> first pmaaddr slot.
  CHECK(hybrid_wm_slot_for_insn(0xBD029073u) == HYBRID_WM_PMAADDR_BASE);
  // csrw mstatus,t0 -> a write, but mstatus is not mask-governed.
  CHECK(hybrid_wm_slot_for_insn(0x30029073u) == -1);
  // csrw menvcfg (0x30A) -> M-ext slot 31.
  CHECK(hybrid_wm_slot_for_insn(0x30A29073u) == 31);
}
