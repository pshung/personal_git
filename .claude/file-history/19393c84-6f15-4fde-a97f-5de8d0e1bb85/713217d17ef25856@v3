// Compile-time layout lock for hybrid_state_v1. The ABI is a wire contract,
// so any offset or size drift must break every consumer at compile time.

#ifndef HYBRID_STATE_ABI_CHECK_H
#define HYBRID_STATE_ABI_CHECK_H

#include "hybrid/state_abi.h"

// C++20 has static_assert; C11+ has _Static_assert. Pick the one that exists.
#ifndef __cplusplus
#  define static_assert _Static_assert
#endif

static_assert(offsetof(struct hybrid_state_v1, magic)    == 0,    "magic@0");
static_assert(offsetof(struct hybrid_state_v1, version)  == 4,    "version@4");
static_assert(offsetof(struct hybrid_state_v1, flags)    == 8,    "flags@8");
static_assert(offsetof(struct hybrid_state_v1, hart_id)  == 12,   "hart_id@12");
static_assert(offsetof(struct hybrid_state_v1, pc)       == 16,   "pc@16");
static_assert(offsetof(struct hybrid_state_v1, priv)     == 24,   "priv@24");

static_assert(offsetof(struct hybrid_state_v1, gpr)      == 32,   "gpr@32");
static_assert(offsetof(struct hybrid_state_v1, fpr)      == 288,  "fpr@288");

static_assert(offsetof(struct hybrid_state_v1, mstatus)  == 544,  "mstatus@544");
static_assert(offsetof(struct hybrid_state_v1, mepc)     == 552,  "mepc@552");
static_assert(offsetof(struct hybrid_state_v1, mtvec)    == 560,  "mtvec@560");
static_assert(offsetof(struct hybrid_state_v1, mcause)   == 568,  "mcause@568");
static_assert(offsetof(struct hybrid_state_v1, mtval)    == 576,  "mtval@576");
static_assert(offsetof(struct hybrid_state_v1, mscratch) == 584,  "mscratch@584");
static_assert(offsetof(struct hybrid_state_v1, medeleg)  == 592,  "medeleg@592");
static_assert(offsetof(struct hybrid_state_v1, mideleg)  == 600,  "mideleg@600");
static_assert(offsetof(struct hybrid_state_v1, mip)      == 608,  "mip@608");
static_assert(offsetof(struct hybrid_state_v1, mie)      == 616,  "mie@616");
static_assert(offsetof(struct hybrid_state_v1, mcycle)   == 624,  "mcycle@624");
static_assert(offsetof(struct hybrid_state_v1, minstret) == 632,  "minstret@632");
static_assert(offsetof(struct hybrid_state_v1, satp)     == 640,  "satp@640");

static_assert(offsetof(struct hybrid_state_v1, pmpcfg)   == 648,  "pmpcfg@648");
static_assert(offsetof(struct hybrid_state_v1, pmpaddr)  == 776,  "pmpaddr@776");

static_assert(offsetof(struct hybrid_state_v1, vstart)   == 1288, "vstart@1288");
static_assert(offsetof(struct hybrid_state_v1, vtype)    == 1296, "vtype@1296");
static_assert(offsetof(struct hybrid_state_v1, vl)       == 1304, "vl@1304");
static_assert(offsetof(struct hybrid_state_v1, vlenb)    == 1312, "vlenb@1312");
static_assert(offsetof(struct hybrid_state_v1, vreg)     == 1320, "vreg@1320");

// vreg occupies 32 * HYBRID_VLEN_BYTES_MAX bytes; vxsat/vxrm/vcsr follow
// it (consuming 24 bytes from the original 256-byte reserved trailer); the
// reserved trailer keeps the total struct size unchanged.
static_assert(offsetof(struct hybrid_state_v1, vxsat)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX,
              "vxsat follows vreg[32 * HYBRID_VLEN_BYTES_MAX]");
static_assert(offsetof(struct hybrid_state_v1, vxrm)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 8,
              "vxrm follows vxsat");
static_assert(offsetof(struct hybrid_state_v1, vcsr)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 16,
              "vcsr follows vxrm");
static_assert(offsetof(struct hybrid_state_v1, fcsr)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 24,
              "fcsr follows vcsr (L20)");
static_assert(offsetof(struct hybrid_state_v1, mcache_ctl)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 32,
              "mcache_ctl follows fcsr (Andes cache-enable CSR)");
static_assert(offsetof(struct hybrid_state_v1, mmisc_ctl)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 40,
              "mmisc_ctl follows mcache_ctl");
// v3: the Andes CSR block follows mmisc_ctl, before reserved.
static_assert(offsetof(struct hybrid_state_v1, andes)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 48,
              "andes block follows mmisc_ctl");
static_assert(sizeof(struct hybrid_andes_csr) == 31 * 8,
              "13 scalar Andes CSRs + pmacfg[2] + pmaaddr[16] = 31 * uint64_t");
static_assert(offsetof(struct hybrid_andes_csr, mxstatus) == 0,
              "mxstatus heads the Andes block (X-macro order)");
static_assert(offsetof(struct hybrid_andes_csr, pmacfg) == 13 * 8,
              "pmacfg follows the 13 scalar Andes CSRs");
static_assert(offsetof(struct hybrid_andes_csr, pmaaddr) == 15 * 8,
              "pmaaddr follows pmacfg[2]");
// v4: the M-ext CSR block follows the Andes block, before reserved.
static_assert(sizeof(struct hybrid_m_ext_csr) == HYBRID_M_EXT_CSR_NUM * 8,
              "hybrid_m_ext_csr is HYBRID_M_EXT_CSR_NUM scalar uint64_t");
static_assert(offsetof(struct hybrid_state_v1, m_ext)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 48 + 248,
              "m_ext block follows the andes block");
// v5: the L2C MMIO register window follows the M-ext block, before reserved.
static_assert(sizeof(struct hybrid_l2c) == HYBRID_L2C_REG_WINDOW_BYTES,
              "hybrid_l2c is the 0x0000..0x0527 register window (165 * uint64_t)");
static_assert(HYBRID_L2C_REG_WINDOW_BYTES == 1320,
              "L2C window 0x0000..0x0527 inclusive = 1320 bytes = 165 * 8");
static_assert(offsetof(struct hybrid_state_v1, l2c)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 48 + 248
                   + HYBRID_M_EXT_CSR_NUM * 8,
              "l2c block follows the m_ext block");
// v6: write_mask[2] follows the l2c block, carved from reserved (64 -> 48),
// so the total size is unchanged from v5.
static_assert(offsetof(struct hybrid_state_v1, write_mask)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 48 + 248
                   + HYBRID_M_EXT_CSR_NUM * 8 + HYBRID_L2C_REG_WINDOW_BYTES,
              "write_mask follows the l2c block");
static_assert(offsetof(struct hybrid_state_v1, reserved)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 48 + 248
                   + HYBRID_M_EXT_CSR_NUM * 8 + HYBRID_L2C_REG_WINDOW_BYTES
                   + 16,
              "reserved follows write_mask[2]");
static_assert(sizeof(struct hybrid_state_v1)
                == 1320 + 32 * HYBRID_VLEN_BYTES_MAX + 360
                   + HYBRID_M_EXT_CSR_NUM * 8 + HYBRID_L2C_REG_WINDOW_BYTES,
              "hybrid_state_v1 v6 total size (48 trailer + 248 andes + 408 "
              "m_ext + 1320 l2c + 16 write_mask + 48 reserved)");

static_assert(HYBRID_VLEN_BYTES_MAX == 128,
              "HYBRID_VLEN_BYTES_MAX covers VLEN up to 1024 bits (L11); "
              "changing it shifts every offset after vreg and needs a "
              "version bump");
static_assert(HYBRID_PMP_CFG_NUM    == 16,  "pmpcfg slot count");
static_assert(HYBRID_PMP_ADDR_NUM   == 64,  "pmpaddr entry count");

#endif  // HYBRID_STATE_ABI_CHECK_H
