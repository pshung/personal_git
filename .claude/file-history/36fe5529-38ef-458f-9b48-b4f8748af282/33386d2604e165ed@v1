":h provider-python Since 2023/01/30
" :checkhealth  # to check plugin issues.
" :CocConfig # to open configuration file.
let mapleader="."
set nocompatible
filetype plugin on
syntax on

"plugin manger: junegunn/vim-plug
"default installed under .local/share/nvim/plugged
"call plug#begin('~/.local/share/nvim/site/autoload/plug.vim')
call plug#begin(has('nvim') ? stdpath('data') . '/plugged' : '~/.vim/plugged')
Plug 'sindrets/diffview.nvim'
" code completion
Plug 'neoclide/coc.nvim', {'branch': 'release'}
" fzf binary
Plug 'junegunn/fzf', {'do': {-> fzf#install() } }
" fzf for vim
Plug 'junegunn/fzf.vim'
" homepage for vim, bookmark, (MRU)Most-Recently-Used
Plug 'mhinz/vim-startify'
" two-character motion
Plug 'justinmk/vim-sneak'
" terminal in floating window
" reference https://codevion.github.io/#!vim/floaterm.md
Plug 'voldikss/vim-floaterm'
" Tag viewer for program structure.
Plug 'preservim/tagbar'
" Personal wiki
Plug 'vimwiki/vimwiki'
" Toggle line number automatically when it's meaningfulness..
Plug 'jeffkreeftmeijer/vim-numbertoggle'
" comment code
Plug 'tpope/vim-commentary'

"write markdown in vim, https://jdhao.github.io/2019/01/15/markdown_edit_preview_nvim/
Plug 'honza/vim-snippets'



" To be studied
" diffview.nvim


call plug#end()



"""""""""""""""""""""Setting: coc-snippet"""""""""""""""""""""""""
" Use <C-l> for trigger snippet expand.
imap <C-l> <Plug>(coc-snippets-expand)

" Use <C-j> for select text for visual placeholder of snippet.
vmap <C-j> <Plug>(coc-snippets-select)

" Use <C-j> for jump to next placeholder, it's default of coc.nvim
let g:coc_snippet_next = '<c-j>'

" Use <C-k> for jump to previous placeholder, it's default of coc.nvim
let g:coc_snippet_prev = '<c-k>'

" Use <C-j> for both expand and jump (make expand higher priority.)
imap <C-j> <Plug>(coc-snippets-expand-jump)

" Use <leader>x for convert visual selected code to snippet
xmap <leader>x  <Plug>(coc-convert-snippet)
"""""""""""""""""""""Setting: vimwiki"""""""""""""""""""""""""
nnoremap <Leader>tl <Plug>VimwikiToggleListItem

"""""""""""""""""""""Setting: vim fzf"""""""""""""""""""""""""
nnoremap <C-p> :Files<Cr>
nnoremap <Leader>b :Buffers<Cr>
"""""""""""""""""""""Setting: vim startify"""""""""""""""""""""""""
let g:startify_bookmarks = [
  \ { 'z': '~/.config/nvim/init.vim' },
  \ ]

let g:startify_lists = [
      \ { 'header': ['   Bookmarks'],       'type': 'bookmarks' },
      \ { 'header': ['   MRU '. getcwd()], 'type': 'dir' },
      \ { 'header': ['   MRU'],            'type': 'files' },
      \ { 'header': ['   Sessions'],       'type': 'sessions' },
      \ ]

"""""""""""""""""""""Setting: vim sneak"""""""""""""""""""""""""
let g:sneak#label = 1
"""""""""""""""""""""Setting: vim coc-nvim"""""""""""""""""""""""""
" reference: https://codevion.github.io/#!vim/coc.md
" include coc-nvim key binding. reference: https://github.com/neoclide/coc.nvim#example-vim-configuration
source ~/.coc_binding_vimrc
let g:coc_global_extensions = ['coc-snippets', 'coc-pairs', 'coc-spell-checker']


" :CocConfig # open coc configuration file
"""""""""""""""""""""Setting: vim floaterm"""""""""""""""""""""""""
let g:floaterm_keymap_new = '<Leader>ft'
let g:floaterm_keymap_toggle = '<Leader>t'
let g:floaterm_width = 1.0
let g:floaterm_height = 1.0

hi Floaterm guibg=black
hi FloatermBorder guibg=orange guifg=cyan
"""""""""""""""""""""Setting: vim tagbar"""""""""""""""""""""""""
nmap <F12> :TagbarToggle<CR>
let g:tagbar_ctags_bin="/home/nick/usr/bin/ctags"

""""""""""""""""""""""""""""""""""""""""""""""""""""
" Disable mouse function.
set mouse=
" Show relative line number
" Reference: https://jeffkreeftmeijer.com/vim-number/
set number relativenumber

" Avoid using 'Esc' key, use 'jj' instead.
inoremap jj <esc>
inoremap <esc> <nop>

" ignore case
set ignorecase

" Insert date in wiki.
map <leader>D :put =strftime('== %Y-%m-%d ==')<CR>

" include llvm vimrc
source ~/.llvm_vimrc

" Add llvm tablegen syntax highlight
augroup filetypedetect
    "au BufRead,BufNewFile *.td set filetype=tablegen
    au BufRead,BufNewFile *.ll set filetype=llvm
    "au BufRead,BufNewFile *.mlir set filetype=mlir
augroup END

" Syntax highligh for coc.nvim config file
autocmd FileType json syntax match Comment +\/\/.\+$+



