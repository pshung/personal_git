#!/usr/bin/env bash
# Contract: tests/e2e.sh is a self-contained QEMU+vsim handoff harness and must
# NOT shell out to the andesim driver. Differential oracle verification lives in
# the product path `andesim run --verify` (see test_andes_sim_verify.sh), so
# e2e.sh carries no `andesim state-diff` call and no VERIFY=1 leg. Comments may
# still mention the driver for context -- only an executable dependency fails.
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

E2E="$ROOT/tests/e2e.sh"

# The driver is invoked via the resolved $ANDESIM_BIN path; its absence proves
# e2e.sh no longer depends on the product binary.
if grep -q 'ANDESIM_BIN' "$E2E"; then
  fail "e2e.sh must not invoke the andesim driver:"$'\n'"$(grep -n 'ANDESIM_BIN' "$E2E")"
fi
ok "e2e.sh invokes no andesim binary (ANDESIM_BIN absent)"

if grep -q 'state-diff' "$E2E"; then
  fail "e2e.sh must not call 'andesim state-diff':"$'\n'"$(grep -n 'state-diff' "$E2E")"
fi
ok "e2e.sh has no state-diff call"

if grep -q 'VERIFY' "$E2E"; then
  fail "e2e.sh must carry no VERIFY leg (moved to 'andesim run --verify'):"$'\n'"$(grep -n 'VERIFY' "$E2E")"
fi
ok "e2e.sh has no VERIFY leg"

ok "e2e.sh is a self-contained handoff harness (no andesim dependency)"
