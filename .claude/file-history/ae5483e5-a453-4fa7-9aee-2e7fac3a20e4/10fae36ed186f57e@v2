# Out-of-tree build for the andesim QEMU TCG plugins. Standalone from the vsim
# CMake build because the plugins link against host QEMU's headers + glib,
# neither of which exist inside the vsim build container. Plugin sources live
# here and build here -- they are never committed into the QEMU source tree.
#
# Usage:
#   make QEMU_ROOT=/local/nick/qemu_v5
#
# Output (in this directory):
#   libhybrid_handoff.so  -- hybrid QEMU<->vsim handoff plugin (product)
#   libhotloops.so        -- hot inner-loop detector (developer profiling tool)

QEMU_ROOT ?= /local/nick/qemu_v5
CC        ?= gcc

GLIB_CFLAGS := $(shell pkg-config --cflags glib-2.0)
GLIB_LIBS   := $(shell pkg-config --libs   glib-2.0)

CFLAGS  := -O2 -fPIC -Wall -Wextra -std=c11
HYBRID_INCLUDE ?= ../include
INCLUDES := -I$(HYBRID_INCLUDE) -I$(QEMU_ROOT)/include/qemu $(GLIB_CFLAGS)
LDFLAGS := -shared
LIBS    := $(GLIB_LIBS)

.PHONY: all clean check-qemu-header

all: libhybrid_handoff.so libhotloops.so

# Both plugins compile against QEMU's plugin API header; fail early with a clear
# message if QEMU_ROOT is wrong rather than a cryptic missing-header error
# mid-compile. Order-only prerequisite: runs first, never forces a relink.
check-qemu-header:
	@if [ ! -f $(QEMU_ROOT)/include/qemu/qemu-plugin.h ]; then \
	    echo "error: qemu-plugin.h not under $(QEMU_ROOT)/include/qemu/"; \
	    echo "       set QEMU_ROOT=<path> on the make command line"; \
	    exit 1; \
	fi

libhybrid_handoff.so: hybrid_handoff.c bbv_emit.c bbv_emit.h \
                     $(HYBRID_INCLUDE)/hybrid/state_abi.h \
                     $(HYBRID_INCLUDE)/hybrid/state_abi_check.h \
                     $(HYBRID_INCLUDE)/hybrid/insn_match.h | check-qemu-header
	$(CC) $(CFLAGS) $(INCLUDES) $(LDFLAGS) -o $@ hybrid_handoff.c bbv_emit.c $(LIBS)

# hotloops is standalone: it needs only qemu-plugin.h + glib, not HYBRID_INCLUDE.
libhotloops.so: hotloops.c | check-qemu-header
	$(CC) $(CFLAGS) -I$(QEMU_ROOT)/include/qemu $(GLIB_CFLAGS) $(LDFLAGS) -o $@ hotloops.c $(LIBS)

clean:
	rm -f libhybrid_handoff.so libhotloops.so
