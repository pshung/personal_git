// Unit tests for hybrid_trigger (F9): CLI selection -> ROI Trigger, including
// pc-boundary resolution against a real fixture's .symtab and the icount
// defaults. Pure (no spawn). rt_pc_jump.elf defines `phase_b_landing` (0x100042)
// and `phase_c` (0x100046). Plain assert-and-count harness.
#include <string>
#include <vector>

#include "cli.hpp"
#include "engine_descriptor.hpp"
#include "hybrid.hpp"
#include "plan.hpp"
#include "repo_root.hpp"
#include "test_check.hpp"

using namespace andes_sim;
using andes_sim::test::check_eq;

namespace {
Cli mk(const std::vector<std::string>& args) { return parse_cli(args); }
}  // namespace

int main() {
  const std::string elf =
      (repo_root() / "tests" / "fixtures" / "rt_pc_jump.elf").string();

  // --- hybrid_hw_check: ISA sync guard -- the fast leg (QEMU) is rv64 ---
  {
    EngineDescriptor d;  // an rv32 engine (e.g. vsim:d23) cannot pair with it
    d.id = "vsim:d23";
    d.xlen = 32;
    const std::string err = hybrid_hw_check(d);
    CHECK(!err.empty());
    CHECK(err.find("vsim:d23") != std::string::npos);
    CHECK(err.find("rv64") != std::string::npos);
  }
  {
    EngineDescriptor d;  // matching xlen passes
    d.id = "vsim:ax45mpv_premium";
    d.xlen = 64;
    CHECK(hybrid_hw_check(d).empty());
  }
  {
    EngineDescriptor d;  // an engine that reports no xlen is accepted as-is
    d.id = "vsim:x";
    CHECK(hybrid_hw_check(d).empty());
  }

  // No --trigger defaults to marker (the repo's documented default), no params.
  {
    std::string err;
    Trigger t = hybrid_trigger(mk({"run", "--mode", "hybrid"}), elf, err);
    CHECK(err.empty());
    CHECK(t.kind == "marker");
    CHECK(t.params.empty());
  }

  // pc: a symbol start and a 0x end both resolve; stored as 0x-prefixed hex.
  {
    std::string err;
    Trigger t = hybrid_trigger(
        mk({"run", "--mode", "hybrid", "--trigger", "pc", "--pc-start",
            "phase_b_landing", "--pc-end", "0x100046"}),
        elf, err);
    CHECK(err.empty());
    CHECK(t.kind == "pc");
    CHECK(t.params.at("enter_pc") == "0x100042");
    CHECK(t.params.at("exit_pc") == "0x100046");
  }

  // pc requires both boundaries.
  {
    std::string err;
    hybrid_trigger(mk({"run", "--mode", "hybrid", "--trigger", "pc",
                       "--pc-start", "phase_b_landing"}),
                   elf, err);
    CHECK(!err.empty());
  }

  // pc with an undefined symbol is an error naming the symbol.
  {
    std::string err;
    hybrid_trigger(mk({"run", "--mode", "hybrid", "--trigger", "pc",
                       "--pc-start", "nope_sym", "--pc-end", "phase_c"}),
                   elf, err);
    CHECK(!err.empty());
    CHECK(err.find("nope_sym") != std::string::npos);
  }

  // icount defaults to 10000 (qemu) / 5000 (vsim).
  {
    std::string err;
    Trigger t = hybrid_trigger(
        mk({"run", "--mode", "hybrid", "--trigger", "icount"}), elf, err);
    CHECK(err.empty());
    CHECK(t.kind == "icount");
    CHECK(t.params.at("qemu_icount") == "10000");
    CHECK(t.params.at("vsim_icount") == "5000");
  }

  // icount honors explicit counts.
  {
    std::string err;
    Trigger t = hybrid_trigger(
        mk({"run", "--mode", "hybrid", "--trigger", "icount", "--qemu-icount",
            "123", "--vsim-icount", "45"}),
        elf, err);
    CHECK(err.empty());
    CHECK(t.params.at("qemu_icount") == "123");
    CHECK(t.params.at("vsim_icount") == "45");
  }

  // simpoint is not wired yet (F11) -- a clear error, not a silent marker fallback.
  {
    std::string err;
    hybrid_trigger(mk({"run", "--mode", "hybrid", "--trigger", "simpoint"}),
                   elf, err);
    CHECK(!err.empty());
  }

  // An unknown trigger is an error.
  {
    std::string err;
    hybrid_trigger(mk({"run", "--mode", "hybrid", "--trigger", "bogus"}), elf,
                   err);
    CHECK(!err.empty());
  }

  // --- vsim_extra_args: user-forwarded vsim-leg flags, validated by trigger ---
  {
    std::string err;
    // warmup only -- valid for any trigger.
    check_eq(vsim_extra_args(
                 mk({"run", "--mode", "hybrid", "--vsim-warmup-icount", "50"}),
                 "icount", err),
             {"--vsim-warmup-icount", "50"}, "warmup");
    CHECK(err.empty());
    // a 0 (or absent) warmup contributes nothing.
    CHECK(vsim_extra_args(
              mk({"run", "--mode", "hybrid", "--vsim-warmup-icount", "0"}),
              "marker", err)
              .empty());
    CHECK(err.empty());
    CHECK(vsim_extra_args(mk({"run", "--mode", "hybrid"}), "marker", err).empty());
    CHECK(err.empty());

    // kanata (marker/pc): --kanata <f> --kanata-roi.
    check_eq(
        vsim_extra_args(mk({"run", "--mode", "hybrid", "--kanata", "k.txt"}),
                        "marker", err),
        {"--kanata", "k.txt", "--kanata-roi"}, "kanata");
    CHECK(err.empty());
    // kanata + objdump.
    check_eq(vsim_extra_args(mk({"run", "--mode", "hybrid", "--kanata",
                                 "k.txt", "--objdump", "o.txt"}),
                             "pc", err),
             {"--kanata", "k.txt", "--kanata-roi", "--objdump", "o.txt"},
             "kanata-objdump");
    CHECK(err.empty());
    // kanata THEN warmup -- the e2e.sh ordering.
    check_eq(vsim_extra_args(mk({"run", "--mode", "hybrid", "--kanata",
                                 "k.txt", "--vsim-warmup-icount", "9"}),
                             "marker", err),
             {"--kanata", "k.txt", "--kanata-roi", "--vsim-warmup-icount", "9"},
             "kanata-warmup");
    CHECK(err.empty());

    // --kanata is marker/pc only -- rejected under icount.
    vsim_extra_args(mk({"run", "--mode", "hybrid", "--kanata", "k.txt"}),
                    "icount", err);
    CHECK(!err.empty());
    // --objdump requires --kanata.
    vsim_extra_args(mk({"run", "--mode", "hybrid", "--objdump", "o.txt"}),
                    "marker", err);
    CHECK(!err.empty());
  }

  return andes_sim::test::report("hybrid");
}
