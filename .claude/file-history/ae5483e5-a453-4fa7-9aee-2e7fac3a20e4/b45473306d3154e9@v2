// The release/developer surface switch.
//
// $ANDES_SIM_DEV (any non-empty value) reveals developer-only surface that the
// release product hides: the developer-command section in `--help` (build,
// test, state-diff) and developer-only `list` targets (fixtures -- internal
// test ELFs, not user workloads). The default, env-unset, is the clean release
// view.
#ifndef ANDES_SIM_DEV_MODE_HPP
#define ANDES_SIM_DEV_MODE_HPP

#include <cstdlib>

namespace andes_sim {

inline bool is_dev_mode() {
  const char* d = std::getenv("ANDES_SIM_DEV");
  return d && *d;
}

}  // namespace andes_sim

#endif  // ANDES_SIM_DEV_MODE_HPP
