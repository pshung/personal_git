// hotloops -- hot inner-loop detector for baremetal RISC-V ELFs.
//
// C++ replacement for QEMU/scripts/hotloops.sh. Runs a baremetal ELF under
// qemu-system-{arch} with the hotloops TCG plugin and prints a sorted table
// (or LLM-ready Markdown report) of detected backward branches.
//
// Usage: hotloops [opts] <elf>
//
// Options:
//   --arch <riscv32|riscv64|auto>   Target arch (default: auto)
//   --qemu <path>                   Override qemu-system binary
//   --plugin <path>                 Override hotloops plugin .so
//   --machine <name>                -M <name> (default: andes_ae350)
//   --cpu <spec>                    -cpu <spec>
//   --qemu-config <file>            -readconfig <file>
//   --cwd <dir>                     chdir before launching QEMU
//   --qemu-arg <arg>                Extra arg forwarded to QEMU (repeatable)
//   --limit <N>                     Top-N loops to print (default: 50)
//   --min-iters <N>                 Drop loops with fewer than N iters (default: 1)
//   --objdump <path>                Override objdump
//   --addr2line <path>              Override addr2line
//   --no-source                     Disable source file:line resolution
//   --raw                           Print raw plugin log, no formatting
//   --optimize-rvv / --no-optimize-rvv  RVV-only filter (default: on)
//   --llm / --no-llm                LLM Markdown report vs. plain table (default: on)
//   -h | --help                     Show this help

