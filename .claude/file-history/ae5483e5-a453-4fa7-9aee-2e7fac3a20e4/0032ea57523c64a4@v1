// The pure core of `run --mode hybrid`: turn the CLI selection into a Trigger.
//
// Split out from cmd_run.cpp so it is unit-testable without spawning qemu/vsim.
// pc-mode boundaries are resolved against the ELF .symtab here (via elf_syms),
// so the live path in cmd_run only has to build the 2-step plan and run it.
#ifndef ANDES_SIM_HYBRID_HPP
#define ANDES_SIM_HYBRID_HPP

#include <string>
#include <vector>

#include "cli.hpp"
#include "engine_descriptor.hpp"
#include "plan.hpp"

namespace andes_sim {

// Build the ROI Trigger for a hybrid run from `cli` + `elf` (the ELF is needed
// to resolve pc-mode symbol boundaries). Defaults: trigger=marker; icount counts
// 10000 (qemu) / 5000 (vsim) -- matching the Python golden's argparse. The pc
// boundaries are stored as "0x"-prefixed hex in params (enter_pc/exit_pc); the
// icount counts as qemu_icount/vsim_icount. On a missing/unresolvable pc
// boundary, an unsupported (simpoint, F11) or unknown trigger, returns a Trigger
// with empty kind and sets `err`.
Trigger hybrid_trigger(const Cli& cli, const std::string& elf, std::string& err);

// Build the vsim accurate-leg's user-forwarded extra args (verbatim tokens
// appended after the trigger args). Two groups, in tests/e2e.sh order: kanata
// ROI visualization (`--kanata <f> --kanata-roi [--objdump <f>]`) then the
// warmup window (`--vsim-warmup-icount <K>`). `kind` is the trigger kind, used
// to validate: --kanata is marker/pc only; --objdump requires --kanata. On a
// violation returns {} and sets `err`. An empty/zero warmup and absent kanata
// yield an empty list (the common case).
std::vector<std::string> vsim_extra_args(const Cli& cli, const std::string& kind,
                                         std::string& err);

// ISA-sync guard for the accurate-leg engine: the hybrid fast leg is a 64-bit
// QEMU, so an engine reporting xlen != 64 cannot share architectural state
// with it. Returns "" when the pairing is valid, else the diagnostic. An
// engine that reports no xlen (0) is accepted as-is.
std::string hybrid_hw_check(const EngineDescriptor& acc);

}  // namespace andes_sim

#endif  // ANDES_SIM_HYBRID_HPP
