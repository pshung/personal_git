#!/usr/bin/env bash
# Build the out-of-tree QEMU TCG plugins under qemu_plugin/:
#   libhybrid_handoff.so  -- hybrid QEMU<->vsim handoff plugin (product)
#   libhotloops.so        -- hot inner-loop detector (developer profiling tool)
#
# Thin wrapper over qemu_plugin/Makefile that defaults QEMU_ROOT to the in-repo
# QEMU submodule, so the plugin headers resolve without the Makefile's hardcoded
# fallback path. Plugin sources live in qemu_plugin/, never inside QEMU.
#
# Usage:
#   scripts/build_qemu_plugin.sh [make-target...]   # e.g. clean, libhotloops.so
#
# Env:
#   QEMU_ROOT   QEMU tree providing include/qemu/qemu-plugin.h
#               (default: <repo>/QEMU)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
QEMU_ROOT="${QEMU_ROOT:-$ROOT/QEMU}"

if [[ ! -f "$QEMU_ROOT/include/qemu/qemu-plugin.h" ]]; then
  echo "missing $QEMU_ROOT/include/qemu/qemu-plugin.h" >&2
  echo "  run 'git submodule update --init --recursive', or set QEMU_ROOT=<path>" >&2
  exit 1
fi

# make -C qemu_plugin chdirs first, so QEMU_ROOT must be absolute (it is above).
exec make -C "$ROOT/qemu_plugin" QEMU_ROOT="$QEMU_ROOT" "$@"
