#!/usr/bin/env bash
# Option bug-hunt battery. Each case: tag, run, show rc + salient output.
cd /home/nick/work/andesim
BIN=./andesim
HELLO=tests/fixtures/rt_c_hello.elf
GEMM=tests/fixtures/rt_c_matmul.elf   # _start=0x100000 matmul_kernel=0x10007c main=0x1000d8

run() {
  local tag="$1"; shift
  local out rc
  out="$("$BIN" "$@" 2>&1)"; rc=$?
  printf '\n### %s  [rc=%d]\n' "$tag" "$rc"
  printf '$ andesim %s\n' "$*"
  # show only andesim-emitted lines (drop engine banners/program output noise)
  printf '%s\n' "$out" | grep -iE 'andesim|hsim|error|invalid|exceed|require|unknown|missing|window_cycles|verify|PASS|FAIL|dry-run|command [0-9]' | head -8
}

echo "========== GROUP 1: mem-size =========="
run "1 fast mem 99G (cap?)"      run --mode fast --mem-size 99G --dry-run "$HELLO"
run "2 fast mem 0"               run --mode fast --mem-size 0 --dry-run "$HELLO"
run "3 fast mem -5"              run --mode fast --mem-size -5 --dry-run "$HELLO"
run "4 fast mem 1023 (<1MiB)"    run --mode fast --mem-size 1023 --dry-run "$HELLO"
run "5 fast mem 1.5M"            run --mode fast --mem-size 1.5M --dry-run "$HELLO"
run "6 fast mem 1024 (=example)" run --mode fast --mem-size 1024 --dry-run "$HELLO"
run "7 fast mem 8G ok"           run --mode fast --mem-size 8G --dry-run "$HELLO"
run "8 hybrid mem 99G"           run --mode hybrid --trigger marker --mem-size 99G --dry-run "$HELLO"
run "9 hybrid mem 1024"          run --mode hybrid --trigger marker --mem-size 1024 --dry-run "$HELLO"
run "10 cycle mem 8G"            run --mode cycle --mem-size 8G --dry-run "$HELLO"
run "11 cycle mem 1024"          run --mode cycle --mem-size 1024 --dry-run "$HELLO"
run "12 fast mem 1M (min ok)"    run --mode fast --mem-size 1M --dry-run "$HELLO"

echo "========== GROUP 2: pc range =========="
run "13 pc zero-len main..main"  run --mode hybrid --trigger pc --pc-start main --pc-end main --dry-run "$GEMM"
run "14 pc reversed main.._start" run --mode hybrid --trigger pc --pc-start main --pc-end _start --dry-run "$GEMM"
run "15 pc reversed addr"        run --mode hybrid --trigger pc --pc-start 0x2000 --pc-end 0x1000 --dry-run "$GEMM"
run "16 pc bad sym"              run --mode hybrid --trigger pc --pc-start nope_sym --pc-end main --dry-run "$GEMM"
run "17 pc missing end"          run --mode hybrid --trigger pc --pc-start main --dry-run "$GEMM"
run "18 pc missing both"         run --mode hybrid --trigger pc --dry-run "$GEMM"
run "19 pc valid"               run --mode hybrid --trigger pc --pc-start _start --pc-end main --dry-run "$GEMM"

echo "========== GROUP 3: trigger/flag misuse =========="
run "20 hybrid no trigger"       run --mode hybrid --dry-run "$HELLO"
run "21 hybrid trigger foo"      run --mode hybrid --trigger foo --dry-run "$HELLO"
run "22 fast --trigger marker"   run --mode fast --trigger marker --dry-run "$HELLO"
run "23 fast --pc-start main"    run --mode fast --pc-start main --dry-run "$HELLO"
run "24 cycle --verify"          run --mode cycle --verify --dry-run "$HELLO"
run "25 hybrid --gdb"            run --mode hybrid --trigger marker --gdb --dry-run "$HELLO"
run "26 fast --gdb-port noGDB"   run --mode fast --gdb-port 1234 --dry-run "$HELLO"
run "27 objdump w/o kanata"      run --mode hybrid --trigger marker --objdump /tmp/x.dump --dry-run "$HELLO"
run "28 kanata w/ pc ok"         run --mode hybrid --trigger pc --pc-start _start --pc-end main --kanata /tmp/k.log --dry-run "$GEMM"

echo "========== GROUP 4: engine selection =========="
run "29 cycle engine qemu64"     run --mode cycle --engine qemu64 --dry-run "$HELLO"
run "30 cycle engine nosuch"     run --mode cycle --engine nosuch --dry-run "$HELLO"
run "31 fast engine vsim"        run --mode fast --engine vsim:ax45mpv_premium --dry-run "$HELLO"
run "32 hybrid engine d23 rv32"  run --mode hybrid --trigger marker --engine vsim:d23 --dry-run "$HELLO"
run "33 cycle d23 on rv64 elf"   run --mode cycle --engine vsim:d23 --dry-run "$HELLO"

echo "========== GROUP 5: parse/positional =========="
run "34 fast no ELF"             run --mode fast --dry-run
run "35 fast extra positional"   run --mode fast --dry-run "$HELLO" "$GEMM"
run "36 fast missing ELF file"   run --mode fast --dry-run /no/such.elf
run "37 run no --mode"           run --dry-run "$HELLO"
run "38 --mode=fast (= form)"    run --mode=fast --dry-run "$HELLO"
run "39 dup --mode last wins"    run --mode fast --mode cycle --dry-run "$HELLO"
run "40 fast --mem-size novalue" run --mode fast --mem-size
run "41 empty --engine"          run --mode fast --engine "" --dry-run "$HELLO"
run "42 empty --trigger"         run --mode hybrid --trigger "" --dry-run "$HELLO"
echo "========== END =========="
