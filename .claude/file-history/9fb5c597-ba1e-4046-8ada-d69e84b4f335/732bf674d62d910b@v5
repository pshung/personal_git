#!/usr/bin/env python3
"""Render docs/csr_coverage.ipynb from the coverage CSV, in spec-table order.

Walks tests/andes_csr/csr_coverage.csv in committed row order -- the AndeStar V5
SPA Chapter 5 table order (extract_csr_inventory.py reads the summary tables top
to bottom) -- and emits a Jupyter notebook (markdown cells, one per PDF table) so
a human can review it side by side with the spec.

Every CSR gets ONE of three plain statuses:
  [x] done     -> the handoff handles it on the current engine; the test is named
  [~] blocked  -> we WANT it, but this engine lacks the mode/extension; what is
                  missing is named
  [-] N/A      -> we do NOT transport it by design; why is named

Regenerate after re-running classify_csr_coverage.py or editing the maps below.

Usage: render_csr_matrix.py            # writes docs/csr_coverage.ipynb
"""
from __future__ import annotations

import csv
import json
from collections import Counter
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
COV = ROOT / "tests/andes_csr/csr_coverage.csv"
OUT = ROOT / "docs/csr_coverage.ipynb"

TABLE = {
    "M-std":   "Table 5 - RISC-V Standard Machine Mode CSRs",
    "M-andes": "Table 6 - AndeStar V5 Machine Mode CSRs",
    "D-std":   "Table 7 - AndeStar V5 Debug Mode CSRs",
    "S-std":   "Table 8 - RISC-V Standard Supervisor Mode CSRs",
    "S-andes": "Table 9 - AndeStar V5 Supervisor Mode CSRs",
    "U-std":   "Table 10 - RISC-V Standard User Mode CSRs",
    "U-andes": "Table 11 - AndeStar V5 User Mode CSRs",
    "H-std":   "Table 12 - RISC-V Standard Hypervisor Mode CSRs",
}

# --- DONE: handled on the premium engine. value -> the test / how it is proven.
DONE = {
    # round-trip self-checked by a dedicated fixture
    "mscratch": "rt_csr_survival.S", "mepc": "rt_csr_survival.S",
    "mcause": "rt_csr_survival.S", "mtval": "rt_csr_survival.S",
    "mie": "rt_csr_survival.S", "fcsr": "rt_c_fcsr.c",
    "mcountinhibit": "rt_m_ext_counters.S", "mhpmevent3~6": "rt_m_ext_counters.S",
    "mcounterinten": "rt_m_ext_counters.S",
    "tselect": "rt_m_ext_trigcause.S", "tdata2": "rt_m_ext_trigcause.S",
    "mcontext": "rt_m_ext_trigcause.S",
    # restored across the handoff, but value NOT strict-compared (the reason in ()).
    "mhpmcounter3~6": "rt_m_ext_counters.S (value not compared: HW counter)",
    "mdcause": "rt_m_ext_trigcause.S (value not compared: vsim HW-set)",
    "mcontrol/tdata1": "rt_m_ext_trigcause.S (value not compared: trigger default differs)",
    "tcontrol": "rt_m_ext_trigcause.S (value not compared: trigger default differs)",
    "mstatus": "handoff suite (value not compared: passthrough, equal by construction)",
    "mtvec": "handoff suite (value not compared: passthrough, equal by construction)",
    "mip": "handoff suite (value not compared: HW-driven pending bits)",
    "mcycle": "handoff suite (value not compared: cycle measurement)",
    "minstret": "handoff suite (value not compared: instret measurement)",
    "mcache_ctl": "handoff suite (boot-static: restored, not re-drained)",
    "mmisc_ctl": "handoff suite (boot-static: restored, not re-drained)",
    "msp_bound": "test_andes_caps_parity.sh + handoff suite (value not compared: reset differs)",
    "msp_base": "test_andes_caps_parity.sh + handoff suite (value not compared: reset differs)",
}
ANDES9 = {"mxstatus", "mpft_ctl", "mclk_ctl", "milmb", "mdlmb", "mecc_code",
          "mhsp_ctl", "mcountermask_m", "uitb", "jvt", "ucode"}

# --- BLOCKED: in the v4 ABI, but premium (M-only) lacks the mode/extension.
#     value -> what is missing (and whether a built engine has it).
_GATE_GROUPS = {
    "U-mode (e.g. d23)": ["menvcfg", "mcounteren", "mcountermask_u", "mcounterwen",
                          "uzobctl", "ucctlbeginaddr", "sleepvalue", "umisc_ctl"],
    "S-mode (e.g. d23)": ["mcountermask_s", "mslideleg", "medeleg", "mideleg"],
    "S-mode paging (e.g. d23)": ["satp"],
    "ePMP / Smepmp (no built engine yet)": ["mseccfg"],
    "Smrnmi / resumable NMI (no built engine yet)": [
        "mnscratch", "mnepc", "mncause", "mnstatus", "mnvec", "mrnxvec"],
    "exception save-levels (no built engine yet)": [
        "msavestatus", "msaveepc1", "msavecause1", "msaveepc2", "msavecause2",
        "msavedcause1", "msavedcause2"],
    "CLIC (no built engine yet)": ["mtvt", "mintthresh", "mcirq_entry"],
    "Smstateen (no built engine yet)": ["mstateen0", "mstateen1", "mstateen2", "mstateen3"],
    "CCTL CSRs (no built engine yet)": ["mcctlbeginaddr", "mcctldata"],
    "PPI peripheral interface (no built engine yet)": ["mppib"],
    "fast IO interface (no built engine yet)": ["mfiob"],
}
BLOCKED = {name: feat for feat, names in _GATE_GROUPS.items() for name in names}

# --- N/A reason per excluded decision; per-CSR override where the bucket is
#     imprecise (an MRW CSR that is WARL-fixed / hardwired, not truly read-only).
NA = {
    "CONST_RO": "constant: engine derives it (RO or WARL-fixed), nothing to exchange",
    "EXCL_RV32": "RV32-only shadow (this is an RV64 core)",
    "EXCL_SIDEFX": "side-effecting: read/write performs an action, not state",
    "EXCL_W1C_HW": "write-1-clear, hardware-driven (like mip)",
    "EXCL_INDIRECT": "indirect-access mechanism (miselect/mireg), not a register",
    "EXCL_NEXT": "U-mode N-ext trap state (trap-free ROI; usually absent)",
    "EXCL_DEBUG": "Debug-mode CSR the handoff itself drives",
    "EXCL_MODE": "S-mode / Hypervisor: outside the M / M+U envelope",
    "EXCL_RO": "read-only",
    "EXCL_TRAP": "trap-cause latch, live only after a trap",
}
NA_OVERRIDE = {
    "misa": "MRW but WARL-fixed to the engine's ISA; engine derives it, nothing to exchange",
    "tdata3": "MRW but hardwired to 0 (spec: always return 0)",
    "tinfo": "MRW but a read-only trigger-info register",
}


def status(name: str, dec: str):
    """(bucket, detail). bucket in {done, blocked, na}."""
    n = name.lower().replace("ﬂ", "fl").replace("ﬁ", "fi")
    if n in ("fflags", "frm"):
        return "done", "rt_c_fcsr.c (packed in fcsr)"
    if name in DONE:
        return "done", DONE[name]
    if name in BLOCKED:
        return "blocked", "needs " + BLOCKED[name]
    if dec == "TRANSPORT_NOW":
        if name.startswith(("pmpcfg", "pmpaddr")):
            return "done", "handoff suite (M-mode PMP pass-through)"
        if name.startswith(("pmacfg", "pmaaddr")):
            return "done", "test_andes_caps_parity.sh + handoff suite (Andes PMA block)"
        if name in ANDES9:
            return "done", "test_andes_caps_parity.sh + handoff suite (Andes block)"
        return "done", "handoff suite"
    if dec in ("NEW", "NEW_TRIG", "NEW_UDELTA"):
        return "blocked", "needs a capable engine"
    return "na", NA_OVERRIDE.get(name, NA[dec])


MARK = {"done": "[x] done", "blocked": "[~] blocked", "na": "[-] N/A"}

INTRO = """# Andes V5 CSR hybrid-handoff coverage

Review sheet for **every CSR in `AndeStar_V5_SPA_UM164_V1.7`**, in the PDF's
Chapter 5 summary-table order (Table 5 -> 12, sections top to bottom) so it reads
side by side with the spec. Envelope: bare-metal, single-hart, M-mode or
M+U-mode, trap-free ROI.

Auto-generated by `scripts/render_csr_matrix.py` from
`tests/andes_csr/csr_coverage.csv`; do not hand-edit. The guard
`tests/andes_csr/check_coverage.py` fails CI on any drift between the spec
inventory, the matrix data, and `include/hybrid/state_abi.h`.

## Status

Every CSR is exactly one of:

| status | meaning | the `detail` column shows |
|--------|---------|---------------------------|
| `[x] done` | the handoff handles it on the current engine (`ax45mpv_premium`) | **which test** proves it (or `handoff suite`); `(value not compared: ...)` when it is transported but, for a stated reason, not strict-compared |
| `[~] blocked` | we WANT to transport it, but this engine lacks the mode/extension | **what is missing** (e.g. `needs U-mode (e.g. d23)`, `needs CLIC (no built engine yet)`) |
| `[-] N/A` | we do NOT transport it, by design | **why** (read-only/WARL, RV32-only, side-effecting, S/H mode, ...) |

`priv` is the spec's read/write class. Some MRW CSRs are still `N/A` because the
implementation WARL-fixes or hardwires them (e.g. `misa` is pinned to the ISA),
so there is no state to exchange.
"""


def md_cell(src: str) -> dict:
    return {"cell_type": "markdown", "metadata": {}, "source": src.splitlines(keepends=True)}


def main() -> int:
    rows = list(csv.DictReader(COV.open()))
    cells = [md_cell(INTRO)]

    c = Counter(status(r["name"], r["decision"])[0] for r in rows)
    summ = ["## Counts\n\n", "| status | CSRs |\n", "|--------|------|\n"]
    for k in ("done", "blocked", "na"):
        summ.append(f"| {MARK[k]} | {c.get(k, 0)} |\n")
    summ.append(f"| **total** | **{len(rows)}** |\n")
    cells.append(md_cell("".join(summ)))

    cur_mode = cur_sec = None
    buf: list = []

    def flush():
        if buf:
            cells.append(md_cell("".join(buf)))

    for r in rows:
        if r["mode"] != cur_mode:
            flush(); buf.clear()
            cur_mode, cur_sec = r["mode"], None
            buf.append(f"## {TABLE.get(cur_mode, cur_mode)}\n")
        if r["section"] != cur_sec:
            cur_sec = r["section"]
            buf.append(f"\n### {cur_sec}\n\n")
            buf.append("| addr | name | priv | status | detail (test / missing / why) |\n")
            buf.append("|------|------|------|--------|-------------------------------|\n")
        st, detail = status(r["name"], r["decision"])
        buf.append(f"| `{r['addr']}` | {r['name']} | {r['priv']} | {MARK[st]} | {detail} |\n")
    flush()

    nb = {
        "cells": cells,
        "metadata": {
            "kernelspec": {"display_name": "Python 3", "language": "python",
                           "name": "python3"},
            "language_info": {"name": "python"},
        },
        "nbformat": 4, "nbformat_minor": 5,
    }
    OUT.write_text(json.dumps(nb, indent=1, ensure_ascii=False) + "\n")
    print(f"wrote {OUT} ({len(rows)} CSRs; "
          + ", ".join(f"{k}={c.get(k, 0)}" for k in ('done', 'blocked', 'na')) + ")")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
