// Unit tests for VsimFilter (the cycle-mode presentation filter): banner and
// [info] suppression, cycle-count lifting, and program-output pass-through.
// Pure -- no spawn. Plain assert-and-count harness.
#include "vsim_filter.hpp"

#include <string_view>

#include "test_check.hpp"

using andes_sim::parse_cycles_line;
using andes_sim::VsimFilter;
using Dest = andes_sim::VsimFilter::Dest;

int main() {
  // --- parse_cycles_line: lift the count, ignore every other [info] line ---
  CHECK(parse_cycles_line("[info] 3573 cycles simulated") == 3573u);
  CHECK(parse_cycles_line("[info] 0 cycles simulated") == 0u);
  // the neighbouring timing line has digits but is NOT a cycle count
  CHECK(!parse_cycles_line("[info] 0.354s elapsed, 10093.220Hz").has_value());
  CHECK(!parse_cycles_line("[info] loading segment: addr=0x100000").has_value());
  CHECK(!parse_cycles_line("hello").has_value());

  // --- stderr: drop [info], lift the cycle count, keep real diagnostics ---
  {
    VsimFilter f;
    CHECK(f.classify(2, "[info] loading segment: addr=0x100000") == Dest::kDrop);
    CHECK(f.classify(2, "[info] hart 0 reset vector: 0x100000") == Dest::kDrop);
    CHECK(!f.cycles().has_value());  // none seen yet
    CHECK(f.classify(2, "[info] 3573 cycles simulated") == Dest::kDrop);
    CHECK(f.cycles() == 3573u);  // ...lifted, not relayed
    CHECK(f.classify(2, "[info] 0.354s elapsed, 10093.220Hz") == Dest::kDrop);
    // real diagnostics (above info level) survive to stderr
    CHECK(f.classify(2, "[warn] something odd") == Dest::kStderr);
    CHECK(f.classify(2, "[error] boom") == Dest::kStderr);
  }

  // --- stdout: drop the banner (+ its trailing blank), keep program output ---
  {
    VsimFilter f;
    CHECK(f.classify(1, "Copyright (C) 2013-2026 Andes Technology Corporation. "
                        "All rights reserved.") == Dest::kDrop);
    CHECK(f.classify(1, "Version : fcf5ecb") == Dest::kDrop);
    CHECK(f.classify(1, "") == Dest::kDrop);          // banner's trailing blank
    CHECK(f.classify(1, "hello") == Dest::kStdout);   // first real output
    // Past the banner everything passes -- even a blank line, or a "Version :"
    // the program itself prints (no longer mistaken for the banner).
    CHECK(f.classify(1, "") == Dest::kStdout);
    CHECK(f.classify(1, "Version : my-app 2.0") == Dest::kStdout);
  }

  // --- no cycle line at all -> cycles() stays empty ---
  {
    VsimFilter f;
    f.classify(2, "[info] hart 0 reset vector: 0x100000");
    CHECK(!f.cycles().has_value());
  }

  return andes_sim::test::report("vsim-filter");
}
