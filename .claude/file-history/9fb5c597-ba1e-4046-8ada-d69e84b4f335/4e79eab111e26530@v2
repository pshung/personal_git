#!/usr/bin/env bash
cd /home/nick/work/andesim
BIN=./andesim
HELLO=tests/fixtures/rt_c_hello.elf
GEMM=tests/fixtures/rt_c_matmul.elf   # _start=0x100000 matmul_kernel=0x10007c main=0x1000d8
E=vsim:ax45mpv_premium

run() {
  local tag="$1"; shift
  local out rc
  out="$("$BIN" "$@" 2>&1)"; rc=$?
  printf '\n### %s  [rc=%d]\n' "$tag" "$rc"
  printf '$ andesim %s\n' "$*"
  printf '%s\n' "$out" | grep -iE 'andesim|hsim|error|invalid|exceed|require|unknown|missing|window|verify|PASS|FAIL|dry-run|command [0-9]|hybrid-(enter|exit)|enter_pc|exit_pc|-m ' | head -10
}

echo "========== pc-range WITH --engine (unmask) =========="
run "R13 zero-len main==main"   run --mode hybrid --engine $E --trigger pc --pc-start main --pc-end main --dry-run "$GEMM"
run "R14 reversed main.._start" run --mode hybrid --engine $E --trigger pc --pc-start main --pc-end _start --dry-run "$GEMM"
run "R15 reversed addr 2k..1k"  run --mode hybrid --engine $E --trigger pc --pc-start 0x2000 --pc-end 0x1000 --dry-run "$GEMM"
run "R19 valid _start..main"    run --mode hybrid --engine $E --trigger pc --pc-start _start --pc-end main --dry-run "$GEMM"
run "R19b same addr via 0x"     run --mode hybrid --engine $E --trigger pc --pc-start 0x100000 --pc-end 0x100000 --dry-run "$GEMM"

echo "========== mem-size boundary / overflow / whitespace =========="
run "M1 hybrid 2G (over cap?)"  run --mode hybrid --engine $E --trigger marker --mem-size 2G --dry-run "$HELLO"
run "M2 hybrid 1G ok"           run --mode hybrid --engine $E --trigger marker --mem-size 1G --dry-run "$HELLO"
run "M3 fast '8 G' wsp"         run --mode fast --mem-size "8 G" --dry-run "$HELLO"
run "M4 fast 8g lower"          run --mode fast --mem-size 8g --dry-run "$HELLO"
run "M5 fast overflow 1e20 G"   run --mode fast --mem-size 99999999999999999999G --dry-run "$HELLO"
run "M6 fast 4096T huge"        run --mode fast --mem-size 4096T --dry-run "$HELLO"
run "M7 hybrid overflow"        run --mode hybrid --engine $E --trigger marker --mem-size 99999999999999999999G --dry-run "$HELLO"

echo "========== verify + dry-run interplay =========="
run "V1 hybrid verify+dryrun"   run --mode hybrid --engine $E --trigger marker --verify --dry-run "$HELLO"

echo "========== real fast 99G (no cap) -> what does QEMU do? =========="
out="$($BIN run --mode fast --mem-size 99G "$HELLO" 2>&1)"; rc=$?
printf '\n### REAL fast 99G [rc=%d]\n' "$rc"
printf '%s\n' "$out" | head -6
echo "========== END =========="
