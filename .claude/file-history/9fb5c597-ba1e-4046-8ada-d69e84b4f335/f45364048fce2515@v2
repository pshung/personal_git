#!/usr/bin/env bash
cd /home/nick/work/andesim
BIN=./andesim
HELLO=tests/fixtures/rt_c_hello.elf
GEMM=tests/fixtures/rt_c_matmul.elf
E=vsim:ax45mpv_premium

run() {
  local tag="$1" t="$2"; shift 2
  local out rc
  out="$(timeout "$t" "$BIN" "$@" 2>&1)"; rc=$?
  printf '\n### %s  [rc=%d%s]\n' "$tag" "$rc" "$([ $rc -eq 124 ] && echo ' TIMEOUT')"
  printf '$ andesim %s\n' "$*"
  printf '%s\n' "$out" | grep -iE 'window_cycles|verify|PASS|FAIL|diverge|error|hello|result|sum|andesim run' | head -8
}

echo "===== FAST baselines ====="
run "fast hello"        60 run --mode fast "$HELLO"
run "fast gemm"         60 run --mode fast "$GEMM"

echo "===== CYCLE (whole program, from reset) ====="
run "cycle hello"      150 run --mode cycle --engine $E "$HELLO"

echo "===== HYBRID marker ====="
run "hybrid hello mk"  150 run --mode hybrid --engine $E --trigger marker "$HELLO"
run "hybrid gemm mk"   150 run --mode hybrid --engine $E --trigger marker "$GEMM"

echo "===== HYBRID pc ====="
run "hybrid gemm pc"   150 run --mode hybrid --engine $E --trigger pc --pc-start _start --pc-end main "$GEMM"

echo "===== HYBRID marker --verify (premium; milmb/mdlmb fix) ====="
run "hybrid gemm verify" 200 run --mode hybrid --engine $E --trigger marker --verify "$GEMM"
echo "===== END ====="
