#!/usr/bin/env bash
cd /home/nick/work/andesim
BIN=./andesim
HELLO=tests/fixtures/rt_c_hello.elf
GEMM=tests/fixtures/rt_c_matmul.elf
RV32=tests/fixtures/rv32_c_hello.elf
E=vsim:ax45mpv_premium

run() {
  local tag="$1"; shift
  local out rc
  out="$("$BIN" "$@" 2>&1)"; rc=$?
  printf '\n### %s  [rc=%d]\n' "$tag" "$rc"
  printf '$ andesim %s\n' "$*"
  printf '%s\n' "$out"
}
# compact: only andesim/error/cmd lines
runc() {
  local tag="$1"; shift
  local out rc
  out="$("$BIN" "$@" 2>&1)"; rc=$?
  printf '\n### %s  [rc=%d]\n' "$tag" "$rc"
  printf '$ andesim %s\n' "$*"
  printf '%s\n' "$out" | grep -iE 'andesim|error|warn|FOOBAR|MARKER_SENTINEL|riscv32|riscv64|rv[0-9]|qemu-system|-cpu|command [0-9]|dry-run|ignore|drop|unknown' | head -10
}

echo "===== K: hybrid silently drops post---- args? (look for FOOBAR_SENTINEL) ====="
runc "K1 hybrid -- FOOBAR" run --mode hybrid --engine $E --trigger marker --dry-run "$HELLO" -- FOOBAR_SENTINEL --jtag-port 9
echo "  (fast forwards them, for contrast:)"
runc "K2 fast -- FOOBAR"   run --mode fast --dry-run "$HELLO" -- FOOBAR_SENTINEL

echo "===== B: post---- -cpu wins in fast ====="
runc "B1 fast -- -cpu ax45" run --mode fast --dry-run "$HELLO" -- -cpu andes-ax45mpv

echo "===== C: explicit qemu32 vs rv64 ELF (warn) ====="
runc "C1 fast eng qemu32 rv64elf" run --mode fast --engine qemu32 --dry-run "$HELLO"

echo "===== D: auto rv32 ELF -> qemu-system-riscv32 ====="
runc "D1 fast rv32 auto" run --mode fast --dry-run "$RV32"

echo "===== A: verify in pc mode ====="
out="$(timeout 200 "$BIN" run --mode hybrid --engine $E --trigger pc --pc-start _start --pc-end main --verify "$GEMM" 2>&1)"; rc=$?
printf '\n### A1 hybrid gemm pc --verify [rc=%d]\n' "$rc"
printf '%s\n' "$out" | grep -iE 'verify|state-diff|window|PASS|FAIL|diverge' | head

echo "===== misc smoke: help / unknown subcmd / list ====="
runc "S1 run --help"      run --help
runc "S2 unknown subcmd"  frobnicate
runc "S3 list (no arg)"   list
echo "===== END ====="
