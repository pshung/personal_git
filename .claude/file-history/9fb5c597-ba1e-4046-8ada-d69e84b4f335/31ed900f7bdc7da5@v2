// Tests the config.inc-macro -> AndesCaps binding (andes_caps_from_config).
// The real _NDS_* macros come from the build-generated cpu_config.hpp; here we
// define them ourselves with ax45mpv_premium's values, so the #if mapping is
// unit-tested with controlled inputs and no Verilator build is needed.
//
// premium config.inc: CoDense + ILM + DLM on; DSP/ECC/PowerBrake/StackSafe/
// perf-monitor/PMA off.
#define _NDS_DSP_SUPPORT_INT         0
#define _NDS_CODENSE_SUPPORT_INT     1
#define _NDS_POWERBRAKE_SUPPORT_INT  0
#define _NDS_STACKSAFE_SUPPORT_INT   0
#define _NDS_PERFORMANCE_MONITOR_INT 0
#define _NDS_PMA_ENTRIES             0
#define _NDS_ILM_SIZE_KB             1024
#define _NDS_DLM_SIZE_KB             1024
#define _NDS_DCACHE_ECC_TYPE_INT     0
#define _NDS_ICACHE_ECC_TYPE_INT     0
#define _NDS_ILM_ECC_TYPE_INT        0
#define _NDS_DLM_ECC_TYPE_INT        0

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/andes_caps_config.hpp"

using hybrid::AndesGate;

TEST_CASE("premium config.inc macros -> CoDense + ILM + DLM gates only")
{
  const auto c = hybrid::andes_caps_from_config();

  CHECK(c.gate_on(AndesGate::CODENSE));
  CHECK(c.gate_on(AndesGate::ILM));
  CHECK(c.gate_on(AndesGate::DLM));

  CHECK_FALSE(c.gate_on(AndesGate::DSP));
  CHECK_FALSE(c.gate_on(AndesGate::ECC));
  CHECK_FALSE(c.gate_on(AndesGate::POWERBRAKE));
  CHECK_FALSE(c.gate_on(AndesGate::STACKSAFE));
  CHECK_FALSE(c.gate_on(AndesGate::PMA));
  CHECK_FALSE(c.gate_on(AndesGate::PERF_MONITOR));
}

TEST_CASE("the binding reaches the right CSR-level conclusion for premium")
{
  const auto c = hybrid::andes_caps_from_config();
  CHECK_FALSE(c.supports_csr(0x801));  // ucode    (DSP off)  -- the hang case
  CHECK_FALSE(c.supports_csr(0x7C2));  // mecc_code (ECC off) -- the hang case
  CHECK(c.supports_csr(0x800));        // uitb     (CoDense on)
  CHECK(c.supports_csr(0x7C0));        // milmb    (ILM on)
  CHECK(c.supports_csr(0x7C4));        // mxstatus (always)
}
