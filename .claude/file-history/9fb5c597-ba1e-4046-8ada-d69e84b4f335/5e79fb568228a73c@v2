/* Self-test: every public header must compile clean as C and lock its
 * layout. Including state_abi.h pulls in state_abi_check.h, whose
 * _Static_assert set is the wire-format offset lock. If this TU compiles,
 * the C consumer (the QEMU TCG plugin) sees a consistent ABI. */
#include "hybrid/state_abi.h"
#include "hybrid/state_abi_check.h"
#include "hybrid/insn_match.h"
#include "hybrid/handoff_site.h"
#include "hybrid/v_drain_policy.h"
#include "hybrid/reg_names.h"

/* Touch one symbol from each header so the TU is not vacuous. */
int abi_compile_check_c(void);
int abi_compile_check_c(void)
{
  struct hybrid_state_v1 s;
  hybrid_handoff_kind k = HYBRID_HANDOFF_NONE;
  HandoffSite site = {HYBRID_HANDOFF_ENTER, 0x1000u, 4u};
  (void) s;
  (void) hybrid_match_handoff_insn(HYBRID_MARKER_ENTER_INSN, &k);
  (void) compute_handoff_pc(&site);
  (void) hybrid_v_drain_policy(1, 1, HYBRID_VLEN_BYTES_MAX);
  (void) hybrid_gpr_names[0];
  (void) hybrid_fpr_names[0];
  return (int) k;
}
