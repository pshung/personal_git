// rt_andes_data.S (THROWAWAY) -- data-only bisection probe.
// Only CSRs that are pure architectural data (no execution side effect in a
// cycle-accurate engine): mecc_code, mcountermask_m, uitb, jvt, ucode,
// msp_bound, msp_base, PMA. Excludes the 6 control CSRs (mxstatus, mpft_ctl,
// mclk_ctl, milmb, mdlmb, mhsp_ctl) that can gate the clock / throttle / trap.
// If this PASSES, the earlier timeout was a control-CSR effect, not a transport
// bug. If it still hangs, the DMI restore itself is the suspect.

.section .text
.globl _start
_start:
    li      t0, 0x0000000000000007
    csrw    0x7c2, t0               // mecc_code
    li      t0, 0x0000000000000004
    csrw    0x7d1, t0               // mcountermask_m
    li      t0, 0x0000000000001000
    csrw    0x800, t0               // uitb
    li      t0, 0x0000000000002040
    csrw    0x017, t0               // jvt
    li      t0, 0x0000000000000001
    csrw    0x801, t0               // ucode
    li      t0, 0x00000000DEAD0000
    csrw    0x7c7, t0               // msp_bound
    li      t0, 0x00000000BA5E0000
    csrw    0x7c8, t0               // msp_base
    li      t0, 0x0000000000000018
    csrw    0xbc0, t0               // pmacfg0
    li      t0, 0x0000000000000024
    csrw    0xbc2, t0               // pmacfg2
    li      t0, 0x00000000000ABCDE
    csrw    0xbd0, t0               // pmaaddr0
    li      t0, 0x00000000000ABCD1
    csrw    0xbd1, t0               // pmaaddr1

    slti    x0, x0, 0x5A0
    slti    x0, x0, 0x5A1

    li      t0, 0xe0080000
    sw      x0, 0(t0)
1:  j       1b
