#!/usr/bin/env bash
# Compile the public headers as both C11 and C++20. A pass means the wire
# contract (state_abi_check.h's offset static_asserts) holds and every header
# is self-contained from the repo root. Zero external deps -- runs anywhere a
# host gcc/g++ exists.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CC="${CC:-cc}"
CXX="${CXX:-c++}"

"$CC"  -std=c11   -I"$ROOT" -c "$ROOT/tests/abi_compile_check.c"   -o /dev/null
"$CXX" -std=c++20 -I"$ROOT" -c "$ROOT/tests/abi_compile_check.cpp" -o /dev/null
echo "abi-compile-check OK (C11 + C++20, layout locked)"
