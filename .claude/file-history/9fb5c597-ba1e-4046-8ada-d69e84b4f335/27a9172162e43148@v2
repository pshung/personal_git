// Andes-CSR capability gating.
//
// A core implements an Andes custom CSR only when the matching feature is
// configured into it (config.inc). Restoring a CSR the target core lacks can
// hang the DMI handshake -- observed on ax45mpv_premium for ucode (no DSP) and
// mecc_code (no ECC). So the resume/drain loops transport only the CSRs the
// target core supports, decided here from the core's feature gates.
//
// This header is Verilator/SystemC-free: it maps a CSR address to its gate and
// answers "does a core with these gates support this CSR". The binding of each
// gate to the core's compiled-in `_NDS_*` config macros lives in the sim binary
// (see andes_caps_from_config), so this stays unit-testable in isolation.
#ifndef ANDES_HYBRID_ANDES_CAPS_HPP
#define ANDES_HYBRID_ANDES_CAPS_HPP

#include <cstdint>
#include <string>
#include <vector>

#include "hybrid/state_abi.h"

namespace hybrid {

// The hardware feature that gates each Andes CSR. ALWAYS = unconditionally
// present (a base Andes V5 machine CSR every core has; never gated off).
enum class AndesGate : uint8_t {
  ALWAYS = 0,
  DSP,
  CODENSE,
  POWERBRAKE,
  STACKSAFE,
  ECC,
  PMA,
  ILM,
  DLM,
  PERF_MONITOR,
};

// Map an Andes CSR (by address) to the feature gate that enables it. Addresses
// are the HYBRID_ANDES_CSR_LIST scalars plus the PMA block. A CSR with no
// custom-extension gate is ALWAYS (a base machine CSR every Andes core has).
// Maintainer note: a CSR added to HYBRID_ANDES_CSR_LIST that needs gating must
// get a case here, else it defaults to ALWAYS (transported unconditionally).
constexpr AndesGate andes_gate_for(uint16_t csr_addr)
{
  switch (csr_addr) {
    case 0x801: return AndesGate::DSP;           // ucode (DSP overflow flag)
    case 0x800: return AndesGate::CODENSE;        // uitb  (CoDense table base)
    case 0x017: return AndesGate::CODENSE;        // jvt   (Zcmt/CoDense)
    case 0x7C5: return AndesGate::POWERBRAKE;     // mpft_ctl
    case 0x7C2: return AndesGate::ECC;            // mecc_code
    case 0x7C6:                                   // mhsp_ctl
    case 0x7C7:                                   // msp_bound
    case 0x7C8: return AndesGate::STACKSAFE;      // msp_base
    case 0x7C0: return AndesGate::ILM;            // milmb (ILM base)
    case 0x7C1: return AndesGate::DLM;            // mdlmb (DLM base)
    case 0x7D1: return AndesGate::PERF_MONITOR;   // mcountermask_m
    default:
      // PMA cfg (0xBC0, 0xBC2) and addr (0xBD0..0xBDF) blocks.
      if (csr_addr == HYBRID_PMA_CFG0_CSR || csr_addr == HYBRID_PMA_CFG0_CSR + 2)
        return AndesGate::PMA;
      if (csr_addr >= HYBRID_PMA_ADDR0_CSR &&
          csr_addr < HYBRID_PMA_ADDR0_CSR + HYBRID_PMA_ADDR_NUM)
        return AndesGate::PMA;
      return AndesGate::ALWAYS;                    // mxstatus 0x7C4, mclk_ctl 0x7DF
  }
}

// The set of Andes feature gates a target core has on. Built from the core's
// compiled-in config (config.inc) in the sim binary and injected into the
// resume/drain loops, so they transport only the CSRs the core implements.
// Default = every gate on (all(): no gating, the prior unconditional behavior).
struct AndesCaps {
  uint32_t gate_mask = ~0u;

  static constexpr AndesCaps all()  { return AndesCaps{~0u}; }
  static constexpr AndesCaps none() { return AndesCaps{0u}; }

  constexpr void set(AndesGate g, bool on = true)
  {
    const uint32_t bit = 1u << static_cast<unsigned>(g);
    if (on) gate_mask |= bit;
    else    gate_mask &= ~bit;
  }

  constexpr bool gate_on(AndesGate g) const
  {
    return (gate_mask >> static_cast<unsigned>(g)) & 1u;
  }

  // ALWAYS-gated CSRs are present on every core regardless of the mask.
  constexpr bool supports_csr(uint16_t csr_addr) const
  {
    const AndesGate g = andes_gate_for(csr_addr);
    return g == AndesGate::ALWAYS || gate_on(g);
  }
};

// The Andes scalar CSR names this core supports, for the --describe card.
// Iterates HYBRID_ANDES_CSR_LIST (the single source of truth for the set).
inline std::vector<std::string> supported_andes_csr_names(const AndesCaps& caps)
{
  std::vector<std::string> out;
#define X(field, addr, name) if (caps.supports_csr(addr)) out.push_back(name);
  HYBRID_ANDES_CSR_LIST(X)
#undef X
  // PMA group markers (whole pmacfg[]/pmaaddr[] blocks share one gate), so a
  // consumer can include/exclude PMA without listing all 18 entries.
  if (caps.supports_csr(HYBRID_PMA_CFG0_CSR))  out.push_back("pmacfg");
  if (caps.supports_csr(HYBRID_PMA_ADDR0_CSR)) out.push_back("pmaaddr");
  return out;
}

}  // namespace hybrid

#endif  // ANDES_HYBRID_ANDES_CAPS_HPP
