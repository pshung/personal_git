#include "hybrid/state_abi_check.h"
#include "hybrid/insn_match.h"
#include "hybrid/handoff_site.h"
#include "hybrid/v_drain_policy.h"
#include "hybrid/reg_names.h"

int abi_compile_check_cpp();
int abi_compile_check_cpp()
{
  hybrid_state_v1 s{};
  hybrid_handoff_kind k = HYBRID_HANDOFF_NONE;
  HandoffSite site{HYBRID_HANDOFF_EXIT, 0x2000u, 4u};
  (void) s;
  (void) hybrid_match_handoff_insn(HYBRID_MARKER_EXIT_INSN, &k);
  (void) compute_handoff_pc(&site);
  (void) hybrid_v_drain_policy(0, 0, 0);
  (void) hybrid_gpr_names[31];
  (void) hybrid_fpr_names[31];
  return static_cast<int>(k);
}
