#!/usr/bin/env bash
# Runtime-lib F4 contract: the vplat fixtures are built THROUGH the shipped
# library (-B build/runtime -specs=andesim.specs), not from the runtime
# sources, so the e2e/vplat suites continuously regression-test the same
# artifacts users link against. `make -C tests/fixtures` must self-build
# the runtime lib even from a clean build/runtime/.
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

# shellcheck disable=SC1091
. "$ROOT/config.env" 2>/dev/null
export HYBRID_TOOLCHAIN="${HYBRID_TOOLCHAIN:?config.env missing}"

SIM="$ROOT/verilator/build/sim_ax45mpv_premium"
[ -x "$SIM" ] || fail "cycle engine not built: $SIM"

rm -rf "$ROOT/build/runtime"
make -C "$ROOT/tests/fixtures" vplat_hello.elf >/dev/null \
  || fail "vplat fixture build failed from clean build/runtime"

[ -f "$ROOT/build/runtime/libandesim_runtime.a" ] \
  || fail "fixture build did not go through build/runtime/ (library not produced)"

OUT=$(timeout 120 "$SIM" "$ROOT/tests/fixtures/vplat_hello.elf" </dev/null 2>&1); RC=$?
printf '%s\n' "$OUT" | grep -q 'hello from vplat' \
  || fail "cycle: missing 'hello from vplat' in: $OUT"
[ "$RC" -eq 0 ] || fail "cycle: exit code $RC != 0 (output: $OUT)"

ok "F4 vplat fixtures build through build/runtime/ (specs path, self-building)"
