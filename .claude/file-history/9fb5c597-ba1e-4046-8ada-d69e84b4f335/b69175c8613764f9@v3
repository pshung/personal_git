// Resolve a per-host setting the way setup.sh and the test harness do: the
// environment wins, else the first `KEY=value` assignment in the gitignored
// per-host config.env. This lets `./andesim` find the external qemu/vsim
// (QEMU_BIN_DIR / VSIM_BIN_DIR) without a prior `source ./setup.sh`, matching
// how cmd_doctor already resolves HYBRID_TOOLCHAIN.
#ifndef ANDESIM_CONFIG_ENV_HPP
#define ANDESIM_CONFIG_ENV_HPP

#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <string>
#include <string_view>

#include "repo_root.hpp"

namespace andes_sim {

// $key (non-empty) wins; else the first `key=value` line in `config_file`
// (leading whitespace and `# comment` lines ignored). Empty string if neither
// yields a value; a missing config file is not an error.
inline std::string config_env_value(std::string_view key,
                                    const std::filesystem::path& config_file) {
  const std::string k{key};
  if (const char* e = std::getenv(k.c_str()); e && *e) return e;

  std::ifstream f(config_file);
  if (!f) return "";
  const std::string prefix = k + "=";
  std::string line;
  while (std::getline(f, line)) {
    const std::size_t b = line.find_first_not_of(" \t");
    if (b == std::string::npos || line[b] == '#') continue;
    if (line.compare(b, prefix.size(), prefix) != 0) continue;
    std::string val = line.substr(b + prefix.size());
    val.erase(val.find_last_not_of(" \t\r") + 1);  // right-trim (npos+1 == 0)
    return val;
  }
  return "";
}

// Same, against the repo's own config.env.
inline std::string config_env_value(std::string_view key) {
  return config_env_value(key, repo_root() / "config.env");
}

}  // namespace andes_sim

#endif  // ANDESIM_CONFIG_ENV_HPP
