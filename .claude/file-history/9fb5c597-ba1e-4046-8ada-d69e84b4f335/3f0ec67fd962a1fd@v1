// Oracle differential compare (verify_oracle F2): field-wise diff of two
// drained hybrid_state_v1 records -- the QEMU oracle's exit-boundary drain
// (ref) against the hybrid run's vsim drain (got).
//
// Compare policy, fixed by what vsim's drain freshly reads (state_drain.hpp
// drain_with_passthrough):
//   strict:  magic/version/flags/hart_id/priv (identity), pc, gpr[0..31],
//            mepc/mcause (round-trip), mscratch (L23) + mtval/mie (L24) --
//            round-trip M-mode CSRs restored at resume + re-read at drain;
//            fpr[0..31] under FLAG_FP; vstart/vtype/vl/vlenb/vxsat/vxrm/vcsr
//            and the vreg bytes under FLAG_V.
//   skipped: mstatus, mtvec, medeleg, mideleg, mip, satp, pmpcfg[], pmpaddr[].
//            mtvec/medeleg/mideleg/satp/PMP are passthrough on the vsim side
//            (copied from QEMU1's ENTRY snapshot, never re-read). mip IS
//            re-read but excluded here -- its pending bits are hardware-driven
//            and diverge between the engines' clocks. mstatus is excluded for
//            its dirty/impl-defined bits.
//   masked:  mcycle, minstret -- the engines count cycles/insns differently
//            by design.
#ifndef ANDESIM_STATE_DIFF_HPP
#define ANDESIM_STATE_DIFF_HPP

#include <string>
#include <vector>

#include "hybrid/state_abi.h"

namespace andes_sim {

// One strictly-compared field that differs: "pc", "x5", "f31", "vl",
// "v3[7]" (register + byte offset), "flags", ...
struct FieldDiff {
  std::string field;
  unsigned long long ref = 0;
  unsigned long long got = 0;
};

struct DiffReport {
  int compared = 0;  // count of strictly compared fields
  std::vector<FieldDiff> diffs;
  bool ok() const { return diffs.empty(); }
};

DiffReport diff_states(const hybrid_state_v1& ref, const hybrid_state_v1& got);

// Print `r` as "[state-diff] ..." lines: one per mismatch, then the
// PASS/FAIL verdict. Shared by the state-diff subcommand and run --verify.
void print_diff_report(const DiffReport& r);

}  // namespace andes_sim

#endif  // ANDESIM_STATE_DIFF_HPP
