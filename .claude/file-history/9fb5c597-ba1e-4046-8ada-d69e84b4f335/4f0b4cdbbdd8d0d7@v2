#!/usr/bin/env bash
# Fast TDD loop: compile + run the 4 header-only unit harnesses across both repos.
set -u
SCRATCH=/tmp/claude-1002/-home-nick-work-andesim/9fb5c597-ba1e-4046-8ada-d69e84b4f335/scratchpad
V=/home/nick/work/vsim_andesim
A=/home/nick/work/andesim
DT=$V/external/doctest/doctest
ABI=$V/external/andesim_abi
SRC=$V/src
rc=0
run_vsim() {
  local t=$1
  if ! g++ -std=c++20 -I "$ABI" -I "$SRC" -I "$DT" "$V/tests/hybrid/$t.test.cpp" -o "$SCRATCH/t_$t" 2>"$SCRATCH/err_$t"; then
    echo "$t: COMPILE FAIL"; head -8 "$SCRATCH/err_$t"; rc=1; return
  fi
  local out; out=$("$SCRATCH/t_$t" 2>&1)
  if echo "$out" | grep -q "SUCCESS"; then echo "$t: $(echo "$out" | grep -oE 'assertions:.*passed' | head -1)"
  else echo "$t: FAIL"; echo "$out" | grep -E "ERROR|FAILED|failed" | head -6; rc=1; fi
}
run_vsim state_abi
run_vsim resume_driver
run_vsim state_drain
# driver state_diff (plain assert harness)
if g++ -std=c++20 -I "$A/driver" -I "$A/include" "$A/driver/state_diff_test.cpp" "$A/driver/state_diff.cpp" -o "$SCRATCH/t_diff" 2>"$SCRATCH/err_diff"; then
  out=$("$SCRATCH/t_diff" 2>&1)
  if echo "$out" | grep -q "passed"; then echo "state_diff: $out"; else echo "state_diff: FAIL"; echo "$out" | tail -6; rc=1; fi
else echo "state_diff: COMPILE FAIL"; head -8 "$SCRATCH/err_diff"; rc=1; fi
# plugin compile check (C, against vendored qemu-plugin.h if present)
exit $rc
