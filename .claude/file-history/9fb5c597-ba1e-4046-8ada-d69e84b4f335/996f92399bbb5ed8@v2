// F6 integration acceptance: a real 2-step hybrid plan, end to end.
//
// Unlike plan_test.cpp (pure, fake descriptors), this discovers the real
// engines, builds a marker-trigger [qemu fast-leg -> verilator accurate-leg] plan
// on a fixture ELF, and runs it through run_plan -- spawning actual QEMU + vsim
// and threading the drained hybrid_state_v1 between them. It asserts the
// done-when: the plan succeeds and the vsim leg's mcycle exceeds the qemu leg's
// (vsim restores qemu's mcycle then counts real cycles, so the delta is the
// measured kernel's cycle count). There is no QEMU2 leg -- handback was removed.
//
// Requires built artifacts (qemu, vsim, plugin, the fixture). Run by
// tests/andes_sim/test_andes_sim_f6.sh. ELF overridable via argv[1].
#include <cstdio>
#include <string>
#include <vector>

#include "engine_registry.hpp"
#include "plan.hpp"
#include "repo_root.hpp"
#include "run_plan.hpp"
#include "test_check.hpp"

using namespace andes_sim;

int main(int argc, char** argv) {
  const std::string elf =
      argc > 1 ? std::string(argv[1])
               : (repo_root() / "tests" / "fixtures" / "handoff_roundtrip.elf")
                     .string();

  const Discovery disc = discover_engines();

  // Pick the first cycle-accurate engine that can play the accurate leg.
  const EngineDescriptor* vsim = nullptr;
  for (const EngineDescriptor& e : disc.engines)
    if (e.type == "vsim" && e.invoke_for("accurate-leg")) {
      vsim = &e;
      break;
    }
  CHECK(vsim != nullptr);
  if (!vsim) return andes_sim::test::report("plan-itest");

  std::printf("[f6-itest] elf=%s engine=%s\n", elf.c_str(), vsim->id.c_str());

  Plan plan;
  plan.elf = elf;
  plan.mem_size = 128LL * 1024 * 1024;  // program RAM; run_plan adds the
                                        // L26/F2 V-scratch page for the mmap
  plan.steps = {
      {"qemu64", "fast-leg", {"marker", {}}},
      {vsim->id, "accurate-leg", {"marker", {}}},
  };

  const PlanResult r = run_plan(plan, disc.engines);
  if (!r.ok())
    std::fprintf(stderr, "[f6-itest] run_plan error: %s\n", r.error.c_str());
  CHECK(r.ok());
  CHECK(r.phases.size() == 2);

  if (r.phases.size() == 2) {
    const unsigned long long q = r.phases[0].mcycle;
    const unsigned long long v = r.phases[1].mcycle;
    std::printf(
        "[f6-itest] qemu1 mcycle=%llu  vsim mcycle=%llu  kernel_cycles=%llu\n",
        q, v, v - q);
    CHECK(v > q);  // vsim measured a non-empty ROI
    CHECK(r.phases[1].minstret >= r.phases[0].minstret);
    CHECK(!r.phases[1].out.empty());  // leg stdout surfaced (vsim banner at minimum)
  }

  return andes_sim::test::report("plan-itest");
}
