// The three models andesim composes from engines. A model says *which*
// engines run and *how* they combine; the concrete engine(s) are resolved
// separately (built-in qemu, or a discovered verilator:<cfg>).
//
//   fast      = QEMU alone (functional), transparent passthrough.
//   cycle     = one Verilator alone, pure from reset, transparent passthrough.
//   hybrid    = QEMU fast-forwards, Verilator measures the ROI (+ a trigger).
#ifndef ANDESIM_MODELS_HPP
#define ANDESIM_MODELS_HPP

#include <string_view>

namespace andes_sim {

struct Model {
  std::string_view name;
  std::string_view engines;  // engine composition, for `list models`
  std::string_view notes;
};

inline constexpr Model kModels[] = {
    {"fast", "qemu64 | qemu32", "functional"},
    {"cycle", "vsim:<cfg>", "cycle-accurate"},
    {"hybrid", "qemu64 -> vsim",
     "QEMU fast-forwards, vsim measures the ROI; "
     "pick --trigger marker|pc"},
};

inline const Model* find_model(std::string_view name) {
  for (const Model& m : kModels)
    if (m.name == name) return &m;
  return nullptr;
}

}  // namespace andes_sim

#endif  // ANDESIM_MODELS_HPP
