// EX1: discover_engines() picks its vsim scan dir from $VSIM_BIN_DIR (the
// external prebuilt vsim build, mirroring $QEMU_BIN_DIR), falling back to the
// in-tree verilator/build only when unset. Pure environment logic, no
// subprocess -- so it is unit-testable here without a real vsim.
#include <cstdlib>
#include <filesystem>

#include "engine_registry.hpp"
#include "repo_root.hpp"
#include "test_check.hpp"

namespace fs = std::filesystem;

int main() {
  using namespace andes_sim;

  // VSIM_BIN_DIR set -> exactly that dir (external, like QEMU_BIN_DIR).
  setenv("VSIM_BIN_DIR", "/opt/vsim_andesim/build", /*overwrite=*/1);
  CHECK(vsim_scan_dir() == fs::path("/opt/vsim_andesim/build"));

  // Empty VSIM_BIN_DIR is treated as unset -> legacy in-tree fallback.
  setenv("VSIM_BIN_DIR", "", /*overwrite=*/1);
  CHECK(vsim_scan_dir() == repo_root() / "verilator" / "build");

  // Unset -> legacy in-tree fallback.
  unsetenv("VSIM_BIN_DIR");
  CHECK(vsim_scan_dir() == repo_root() / "verilator" / "build");

  return andes_sim::test::report("engine-registry");
}
