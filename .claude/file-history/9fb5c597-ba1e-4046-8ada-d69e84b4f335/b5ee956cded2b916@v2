// Presentation filter for a cycle-accurate engine's raw output.
//
// `run --mode cycle` runs vsim standalone, which is chatty: it prints a startup
// banner (Copyright / Version) on stdout -- interleaved with the program's own
// stdout -- and verbose `[info]` log lines on stderr, including the headline
// "<N> cycles simulated" count. The user wants only the program's output and
// that count (restated as andesim's own one-line result), with vsim's banner
// and log hidden.
//
// VsimFilter classifies each output line, in arrival order, into drop / stdout /
// stderr, and lifts the cycle count out of the otherwise-hidden log so the
// driver can re-print it under its own [andesim] prefix. The logic is pure (no
// I/O); the spawn/relay loop that feeds it lives in process.cpp.
#ifndef ANDESIM_VSIM_FILTER_HPP
#define ANDESIM_VSIM_FILTER_HPP

#include <cstdint>
#include <optional>
#include <string_view>

namespace andes_sim {

// Lift the count from vsim's "<N> cycles simulated" log line, e.g.
// "[info] 3573 cycles simulated" -> 3573. Returns nullopt for any other line.
// Matches on the "<digits> cycles simulated" shape, tolerant of the leading
// "[info]" tag and surrounding spaces, so it never mistakes the neighbouring
// "[info] 0.354s elapsed, ...Hz" timing line for a count.
std::optional<uint64_t> parse_cycles_line(std::string_view line);

// Decides how each line of a cycle-accurate engine's output is presented.
// Feed lines in arrival order with their source stream (1 = stdout, 2 = stderr),
// excluding the trailing newline:
//   - vsim's startup banner (Copyright / Version, plus its trailing blank line)
//     is dropped,
//   - every `[info]` log line is dropped,
//   - the "<N> cycles simulated" line is dropped but its count is lifted into
//     cycles() for the driver to re-print, and
//   - everything else passes through -- the program's own stdout, and any real
//     diagnostic vsim logs above info level ([warn]/[error]/...) on stderr.
// Stateful: it tracks when the banner has ended (the first real stdout line), so
// a "Version :" the program itself prints later is NOT mistaken for the banner.
class VsimFilter {
 public:
  enum class Dest { kDrop, kStdout, kStderr };

  Dest classify(int stream, std::string_view line);

  // The lifted "N cycles simulated" count, once a matching line has been seen.
  std::optional<uint64_t> cycles() const { return cycles_; }

 private:
  std::optional<uint64_t> cycles_;
  bool seen_program_output_ = false;  // stdout: false until the banner ends
};

}  // namespace andes_sim

#endif  // ANDESIM_VSIM_FILTER_HPP
