// rt_m_ext_trigcause.S
//
// v4 M-ext transport, Debug-trigger section. The trigger CSRs the premium
// engine implements (TRIGGER gate; NDS_NUM_TRIGGER=2) that hold plain,
// cross-engine-consistent state must round-trip across the QEMU1 -> vsim
// handoff.
//
// Covered (HYBRID_M_EXT_CSR_LIST):
//   tselect   -- trigger select index
//   tdata2    -- trigger data 2 (match value/address)
//   mcontext  -- machine context (written at a width every engine keeps)
//
// Deliberately NOT self-checked (transported but engine-divergent, so excluded
// from the cross-engine --verify in driver/state_diff.cpp):
//   mdcause   -- vsim models it as HW-set; a direct write drains back 0
//   tdata1    -- trigger type/info defaults differ between QEMU and vsim
//   tcontrol  -- trigger control defaults differ
// and tdata1 is never armed here (tselect/tdata2/mcontext alone cannot fire a
// trigger), so resuming the producer's default tdata1 is inert.
//
// Assertion: in-ROI self-check (restore) -- a regressed restore hangs the
// fixture -> harness timeout/FAIL.

.section .text
.globl _start
_start:
    li      a4, 0x0000000000000001   // select trigger 1 (premium has 2: 0,1)
    csrw    0x7A0, a4                // tselect
    li      a5, 0x0000000080001000   // trigger data 2 (inert without tdata1 match)
    csrw    0x7A2, a5                // tdata2
    li      a6, 0x0000000000000002   // mcontext: low bit only (every engine keeps it)
    csrw    0x7A8, a6                // mcontext

    slti    x0, x0, 0x5A0            // ENTER ROI -> hand off to vsim

    csrr    a0, 0x7A0
    bne     a0, a4, regress          // tselect restore lost? spin -> FAIL
    csrr    a0, 0x7A2
    bne     a0, a5, regress          // tdata2
    csrr    a0, 0x7A8
    bne     a0, a6, regress          // mcontext

    slti    x0, x0, 0x5A1            // EXIT ROI -> vsim drains, exits 200

    li      t0, 0xe0080000
    sw      x0, 0(t0)
1:  j       1b

regress:
    j       regress                  // a restored CSR is wrong: hang -> FAIL
