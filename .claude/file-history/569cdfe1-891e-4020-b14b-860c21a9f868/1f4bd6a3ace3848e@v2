// Tests the config-macro -> platform-cache binding for a build whose RTL
// has the block configured OUT. ax46mpv_advanced's macro shape (from
// build/Vax46mpv_advanced/obj_sc/Vax46mpv_advanced_config.h): the config
// system emits the L3C knobs -- including the register base -- but the
// cache size is 0, so the register block is absent from the RTL and a
// Program-Buffer access to it would fault. The gate must stay OFF on
// size 0 even with the base defined; base/size must read 0 so nothing
// downstream arms.
#define _NDS_L2C_CACHE_SIZE_KB 0
#define _NDS_L3C_CACHE_SIZE_KB 0
#define _NDS_L3C_REG_BASE 0x00000000E0500000

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/shared_cache_config.hpp"

TEST_CASE("size-0 build reads as no platform cache (ax46mpv_advanced shape)")
{
  CHECK(hybrid::shared_cache_level() == 0);
  CHECK(hybrid::shared_cache_base() == 0ull);
  CHECK(hybrid::shared_cache_size_kb() == 0u);
}
