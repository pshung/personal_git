// Platform shared-cache (L2C/L3C) transport gate, bound from the core's
// compiled-in config macros (_NDS_*, supplied by the build-generated
// per-engine V<engine>_config.h). The 45-series exposes the block as the
// L2C (_NDS_L2C_*, DS220 ch. 11.8); the 46/66-series, whose cores carry
// private L2s, exposes the SAME register layout as the L3C (_NDS_L3C_*,
// DS295 ch. 11.7 -- Control 0x0008, HPM Control 0 0x0010, WAYMASK0 0x0300).
// Every offset the hybrid transport touches is identical, so resume/drain
// treat the two as one "platform cache"; this binder is the ONE place that
// knows which macros name it on a given build.
//
// PRECONDITION: the _NDS_* macros must already be in scope (include this
// AFTER cpu_config.hpp -- same contract as andes_caps_config.hpp). Absent
// macros read as "no platform cache", never a compile error. A size-0
// build (the block configured out of the RTL) also reads as absent: a
// Program-Buffer access to the missing region would fault.
#pragma once

#include <cstdint>

namespace hybrid
{

// 0 = no platform cache in this build, 2 = L2C (DS220), 3 = L3C (DS295).
constexpr int shared_cache_level()
{
#if defined(_NDS_L2C_CACHE_SIZE_KB) && defined(_NDS_L2C_REG_BASE)
  if ((_NDS_L2C_CACHE_SIZE_KB) > 0)
    return 2;
#endif
#if defined(_NDS_L3C_CACHE_SIZE_KB) && defined(_NDS_L3C_REG_BASE)
  if ((_NDS_L3C_CACHE_SIZE_KB) > 0)
    return 3;
#endif
  return 0;
}

// MMIO register base of the platform cache; 0 when absent.
constexpr uint64_t shared_cache_base()
{
#if defined(_NDS_L2C_CACHE_SIZE_KB) && defined(_NDS_L2C_REG_BASE)
  if ((_NDS_L2C_CACHE_SIZE_KB) > 0)
    return static_cast<uint64_t>(_NDS_L2C_REG_BASE);
#endif
#if defined(_NDS_L3C_CACHE_SIZE_KB) && defined(_NDS_L3C_REG_BASE)
  if ((_NDS_L3C_CACHE_SIZE_KB) > 0)
    return static_cast<uint64_t>(_NDS_L3C_REG_BASE);
#endif
  return 0;
}

// Cache size in KiB; 0 when absent.
constexpr uint32_t shared_cache_size_kb()
{
#if defined(_NDS_L2C_CACHE_SIZE_KB) && defined(_NDS_L2C_REG_BASE)
  if ((_NDS_L2C_CACHE_SIZE_KB) > 0)
    return static_cast<uint32_t>(_NDS_L2C_CACHE_SIZE_KB);
#endif
#if defined(_NDS_L3C_CACHE_SIZE_KB) && defined(_NDS_L3C_REG_BASE)
  if ((_NDS_L3C_CACHE_SIZE_KB) > 0)
    return static_cast<uint32_t>(_NDS_L3C_CACHE_SIZE_KB);
#endif
  return 0;
}

}  // namespace hybrid
