/* Ground-truth probe of the platform shared-cache register block at
 * 0xE0500000 (L3C on ax66, L2C on 45-series). 32-bit accesses only --
 * the same width the hybrid transport's program-buffer sw/lwu uses.
 * Prints every step so a mid-probe bus fault still leaves evidence. */
#include <stdint.h>
#include <stdio.h>

#define BASE 0xE0500000ull

static inline uint32_t rd(uint32_t off)
{
  return *(volatile uint32_t *)(BASE + off);
}
static inline void wr(uint32_t off, uint32_t v)
{
  *(volatile uint32_t *)(BASE + off) = v;
}

int main(void)
{
  printf("PROBE start\n");

  /* Configuration register (RO): [63:32] IP-ID, [15:7] SIZE, [19:16] ECC */
  printf("CFG.lo   %08x\n", rd(0x00));
  printf("CFG.hi   %08x\n", rd(0x04)); /* expect 0x0C105010 on ax66 L3C */

  printf("CTRL     %08x\n", rd(0x08));
  printf("HPMCTL0  %08x\n", rd(0x10));
  for (int i = 0; i < 5; i++)
    printf("WM%d      %08x\n", i, rd(0x300 + 8 * i));

  /* write/read-back: HPM_CTL0 then the five transported way masks */
  wr(0x10, 0x21u);
  printf("HPMCTL0 w21   -> %08x\n", rd(0x10));
  static const uint32_t pat[5] = {0x00FFu, 0xFF00u, 0xA5A5u, 0x5A5Au, 0x0F0Fu};
  for (int i = 0; i < 5; i++) {
    wr(0x300 + 8 * i, pat[i]);
    printf("WM%d w%04x -> %08x\n", i, pat[i], rd(0x300 + 8 * i));
  }

  /* CONTROL: RMW the RW tuning fields only (PFTHRES[2:1]=2, IPFDPT[4:3]=1),
   * keep CEN and everything else as reset left them. */
  uint32_t c = rd(0x08);
  wr(0x08, (c & ~0x1Eu) | (2u << 1) | (1u << 3));
  printf("CTRL rmw      -> %08x (was %08x)\n", rd(0x08), c);

  /* restore reset-ish values */
  wr(0x08, c);
  wr(0x10, 0);
  for (int i = 0; i < 5; i++)
    wr(0x300 + 8 * i, 0xFFFFu);
  printf("restored: CTRL %08x HPMCTL0 %08x WM0 %08x\n",
         rd(0x08), rd(0x10), rd(0x300));

  printf("PROBE done\n");
  return 0;
}
