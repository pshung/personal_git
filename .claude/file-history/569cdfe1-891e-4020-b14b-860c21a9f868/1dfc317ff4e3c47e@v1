// Unit tests for the F6 phase-plan executor's pure core:
//   - build_argv  (driver/argv.hpp)     invoke-template placeholder fill
//   - plan_argvs  (driver/run_plan.hpp) state-file threading across steps
//
// These cover everything in run_plan EXCEPT the live spawn loop, which the
// integration acceptance (tests/andes_sim/test_andes_sim_f6.sh -> a real
// 2-step qemu+vsim run) exercises. Plain assert-and-count harness; run by that
// same f6 script. No QEMU2 leg exists -- handback was removed.
#include <filesystem>
#include <fstream>
#include <iterator>
#include <map>
#include <string>
#include <vector>

#include "argv.hpp"
#include "engine_descriptor.hpp"
#include "plan.hpp"
#include "process.hpp"
#include "run_plan.hpp"
#include "test_check.hpp"

using namespace andes_sim;
using andes_sim::test::check_eq;

namespace {

// The canonical drain templates (what builtin_qemu() and vsim --describe ship).
const std::vector<std::string> kQemuFastLeg = {
    "{bin}",
    "-object", "memory-backend-file,id=mem,share=on,mem-path={mmap},size={mmap_size}",
    "-machine", "andes_ae350,memory-backend=mem",
    "-cpu", "{qemu_cpu},vlen={vlen}",
    "-nographic",
    "-semihosting-config", "enable=on,target=native",
    "-bios", "{elf}",
    "-plugin", "{plugin},outfile={state_out}{trigger}",
};

const std::vector<std::string> kVsimAccurateLeg = {
    "{bin}", "{elf}",
    "--resume-from-qemu", "{state_in}",
    "--handoff-out", "{state_out}",
    "--shared-mem-path", "{mmap}",
    "--shared-mem-size", "{mmap_size}",
    "--shared-mem-base", "{mmap_base}",
};

EngineDescriptor fake(const std::string& id, const std::string& bin,
                      const std::string& role,
                      const std::vector<std::string>& tmpl) {
  EngineDescriptor d;
  d.id = id;
  d.bin_path = bin;
  d.invoke.push_back({role, tmpl});
  return d;
}

}  // namespace

int main() {
  // --- build_argv: every placeholder filled, including substring + repeat ---
  {
    std::string err;
    std::map<std::string, std::string> ctx = {
        {"bin", "/q"},      {"elf", "/e"},     {"plugin", "/p"},
        {"mmap", "/m"},     {"mmap_size", "134217728"}, {"state_out", "/s0"},
        {"trigger", ""},  // marker: no plugin suffix
        {"vlen", "512"},
        {"qemu_cpu", "andes-ax45mpv"},
    };
    std::vector<std::string> got = build_argv(kQemuFastLeg, ctx, err);
    CHECK(err.empty());
    check_eq(got,
             {"/q", "-object",
              "memory-backend-file,id=mem,share=on,mem-path=/m,size=134217728",
              "-machine", "andes_ae350,memory-backend=mem", "-cpu",
              "andes-ax45mpv,vlen=512", "-nographic", "-semihosting-config",
              "enable=on,target=native", "-bios", "/e", "-plugin",
              "/p,outfile=/s0"},
             "qemu");
  }
  {
    std::string err;
    std::map<std::string, std::string> ctx = {
        {"bin", "/v"},  {"elf", "/e"},  {"state_in", "/s0"},
        {"state_out", "/s1"}, {"mmap", "/m"}, {"mmap_size", "134217728"},
        {"mmap_base", "0x0"},
    };
    std::vector<std::string> got = build_argv(kVsimAccurateLeg, ctx, err);
    CHECK(err.empty());
    check_eq(got,
             {"/v", "/e", "--resume-from-qemu", "/s0", "--handoff-out", "/s1",
              "--shared-mem-path", "/m", "--shared-mem-size", "134217728",
              "--shared-mem-base", "0x0"},
             "vsim");
  }
  // a repeated placeholder expands every occurrence
  {
    std::string err;
    std::vector<std::string> got =
        build_argv({"a={x},b={y},a2={x}"}, {{"x", "1"}, {"y", "2"}}, err);
    CHECK(err.empty());
    check_eq(got, {"a=1,b=2,a2=1"}, "repeat");
  }
  // an unknown placeholder is an error, not a silent empty fill
  {
    std::string err;
    std::vector<std::string> got = build_argv({"{bogus}"}, {{"x", "1"}}, err);
    CHECK(got.empty());
    CHECK(!err.empty());
  }

  // --- plan_argvs: thread state files across a 2-step hybrid plan ---
  std::vector<EngineDescriptor> engines = {
      fake("qemu", "/qbin", "fast-leg", kQemuFastLeg),
      fake("vsim:test", "/vbin", "accurate-leg", kVsimAccurateLeg),
  };
  Plan plan;
  plan.elf = "/e";
  plan.mem_size = 134217728;
  plan.steps = {
      {"qemu", "fast-leg", {"marker", {}}},
      {"vsim:test", "accurate-leg", {"marker", {}}},
  };
  RuntimeCtx rc;
  rc.mmap_path = "/mm";
  rc.mem_size = 134217728;
  rc.mmap_base = "0x0";
  rc.plugin_path = "/pl";

  {
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(plan, engines, "/wd", rc, err);
    CHECK(err.empty());
    CHECK(argvs.size() == 2);
    if (argvs.size() == 2) {
      // step 0 (qemu): drains to state-0.bin; no state_in referenced
      check_eq(argvs[0],
               {"/qbin", "-object",
                "memory-backend-file,id=mem,share=on,mem-path=/mm,size=134217728",
                "-machine", "andes_ae350,memory-backend=mem", "-cpu",
                "andes-ax45mpv,vlen=512", "-nographic", "-semihosting-config",
                "enable=on,target=native", "-bios", "/e", "-plugin",
                "/pl,outfile=/wd/state-0.bin,log_level=2"},
               "step0");
      // step 1 (vsim): resumes from step 0's drain, drains to state-1.bin
      check_eq(argvs[1],
               {"/vbin", "/e", "--resume-from-qemu", "/wd/state-0.bin",
                "--handoff-out", "/wd/state-1.bin", "--shared-mem-path", "/mm",
                "--shared-mem-size", "134217728", "--shared-mem-base", "0x0"},
               "step1");
    }
  }
  // --- plan_argvs: the fast leg inherits the accurate-leg engine's vlen ---
  // (hw-config sync: the engine descriptor's vlen fills {vlen} in the QEMU
  // -cpu template; an engine that reports none falls back to 512 -- covered
  // by the default plan above, whose vsim:test has no vlen.)
  {
    std::vector<EngineDescriptor> engines128 = engines;
    engines128[1].vlen = 128;  // e.g. vsim:ax66_makatau
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(plan, engines128, "/wd", rc, err);
    CHECK(err.empty());
    CHECK(argvs.size() == 2);
    if (argvs.size() == 2) {
      bool found = false;
      for (const std::string& a : argvs[0])
        if (a == "andes-ax45mpv,vlen=128") found = true;
      CHECK(found);
    }
  }

  // --- plan_argvs: LM content transport wiring (ROADMAP_ilm_dlm F3) ---
  // When the accurate-leg engine reports local memories (ilm_size/dlm_size,
  // bytes), the fast (QEMU) leg's plugin token grows the sidecar-drain args
  // and the vsim leg gets --ilm/--dlm pointing at the sidecars next to its
  // state_in. The no-LM case (sizes 0) is already locked by the exact
  // check_eq on step0/step1 above: no ilm/dlm token anywhere.
  {
    std::vector<EngineDescriptor> lm = engines;
    lm[1].ilm_size = 65536;
    lm[1].dlm_size = 32768;
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(plan, lm, "/wd", rc, err);
    CHECK(err.empty());
    CHECK(argvs.size() == 2);
    if (argvs.size() == 2) {
      bool plugin_has_lm = false;
      for (const std::string& a : argvs[0])
        if (a ==
            "/pl,outfile=/wd/state-0.bin,ilm_size=65536,dlm_size=32768,"
            "log_level=2")
          plugin_has_lm = true;
      CHECK(plugin_has_lm);
      bool has_ilm = false, has_dlm = false;
      for (size_t k = 0; k + 1 < argvs[1].size(); ++k) {
        if (argvs[1][k] == "--ilm" && argvs[1][k + 1] == "/wd/state-0.bin.ilm")
          has_ilm = true;
        if (argvs[1][k] == "--dlm" && argvs[1][k + 1] == "/wd/state-0.bin.dlm")
          has_dlm = true;
      }
      CHECK(has_ilm);
      CHECK(has_dlm);
    }
  }
  // ILM-only engine: each memory gates independently, no --dlm anywhere
  {
    std::vector<EngineDescriptor> lm = engines;
    lm[1].ilm_size = 65536;  // dlm_size stays 0
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(plan, lm, "/wd", rc, err);
    CHECK(err.empty());
    if (argvs.size() == 2) {
      bool plugin_has = false;
      for (const std::string& a : argvs[0])
        if (a == "/pl,outfile=/wd/state-0.bin,ilm_size=65536,log_level=2")
          plugin_has = true;
      CHECK(plugin_has);
      for (const std::string& a : argvs[1]) CHECK(a != "--dlm");
    }
  }

  // --- render_argv: a shell-quoted, copy-pasteable command line ---
  // Safe tokens (qemu's comma/equals args, paths) pass through untouched;
  // empty, spaces, and quotes get POSIX single-quoting so the line is runnable.
  {
    CHECK(render_argv({"qemu", "-cpu", "andes-ax45mpv,vlen=512"}) ==
          "qemu -cpu andes-ax45mpv,vlen=512");
    CHECK(render_argv({"-object",
                       "memory-backend-file,id=mem,mem-path=/m,size=134217728"}) ==
          "-object memory-backend-file,id=mem,mem-path=/m,size=134217728");
    CHECK(render_argv({"-readconfig", "/tmp/a b/qemu.cfg"}) ==
          "-readconfig '/tmp/a b/qemu.cfg'");
    CHECK(render_argv({"x", ""}) == "x ''");
    CHECK(render_argv({"it's"}) == "'it'\\''s'");
  }

  // --- stage_qemu_cfg: a clean probe writes the cfg; a failed probe falls back ---
  // The accurate engine's `--print-qemu-config` stdout becomes workdir/qemu.cfg;
  // any probe failure (engine lacks the flag -> non-zero exit, timeout, empty)
  // yields "" so the fast leg keeps its default -cpu.
  {
    namespace fs = std::filesystem;
    const fs::path dir = fs::temp_directory_path() / "andesim-fa2-stage";
    fs::remove_all(dir);
    fs::create_directories(dir);

    RunResult ok;
    ok.rc = 0;
    ok.out = "[global]\ndriver = \"andes-ax45mpv-riscv-cpu\"\nproperty = \"v\"\n";
    const std::string p = stage_qemu_cfg(dir.string(), ok);
    CHECK(p == (dir / "qemu.cfg").string());
    {
      std::ifstream f(p);
      const std::string c((std::istreambuf_iterator<char>(f)),
                          std::istreambuf_iterator<char>());
      CHECK(c == ok.out);
    }

    RunResult unknown_flag;  // engine without --print-qemu-config: parser throws
    unknown_flag.rc = 1;
    unknown_flag.out = "Unrecognized option: --print-qemu-config\n";
    CHECK(stage_qemu_cfg(dir.string(), unknown_flag).empty());

    RunResult timed_out;
    timed_out.timed_out = true;
    CHECK(stage_qemu_cfg(dir.string(), timed_out).empty());

    RunResult empty_out;  // exit 0 but nothing emitted -> nothing to load
    empty_out.rc = 0;
    CHECK(stage_qemu_cfg(dir.string(), empty_out).empty());

    fs::remove_all(dir);
  }

  // --- plan_argvs: the fast leg's -cpu model follows the accurate engine ---
  // The engine's --print-qemu-config names its CPU driver ("andes-ax66-riscv-
  // cpu"); the staged readconfig globals only apply to THAT driver, and e.g.
  // andes-ax45mpv silently keeps vlen=512 when asked for 128 (found live:
  // ax66 --verify FAIL on vlenb ref=0x40 got=0x10). So {qemu_cpu} is filled
  // from the parsed cfg; engines without the hook keep the family default.
  {
    CHECK(qemu_cpu_from_cfg("[global]\ndriver = \"andes-ax66-riscv-cpu\"\n"
                            "property = \"m\"\nvalue = \"on\"\n") ==
          "andes-ax66");
    CHECK(qemu_cpu_from_cfg("[global]\ndriver = \"andes-ax45mpv-riscv-cpu\"\n") ==
          "andes-ax45mpv");
    CHECK(qemu_cpu_from_cfg("").empty());                 // no cfg -> default
    CHECK(qemu_cpu_from_cfg("[machine]\naia = \"x\"\n").empty());  // no driver

    std::vector<EngineDescriptor> engines_cpu = engines;
    engines_cpu[1].vlen = 128;
    RuntimeCtx rcpu = rc;
    rcpu.qemu_cpu = "andes-ax66";
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(plan, engines_cpu, "/wd", rcpu, err);
    CHECK(err.empty());
    CHECK(argvs.size() == 2);
    if (argvs.size() == 2) {
      bool found = false;
      for (const std::string& a : argvs[0])
        if (a == "andes-ax66,vlen=128") found = true;
      CHECK(found);
    }
    // no qemu_cpu (engine lacks the hook) -> the family default fills in
    // (the vlen sync is independent and still follows the engine's 128)
    RuntimeCtx rdef = rc;
    std::vector<std::vector<std::string>> argvs2 =
        plan_argvs(plan, engines_cpu, "/wd", rdef, err);
    CHECK(err.empty());
    if (argvs2.size() == 2) {
      bool found = false;
      for (const std::string& a : argvs2[0])
        if (a == "andes-ax45mpv,vlen=128") found = true;
      CHECK(found);
    }
  }

  // --- plan_argvs: hw_engine_id syncs a plan with NO accurate leg ---
  // The --verify oracle plan is QEMU-only, but it must model the same
  // hardware as the main run's accurate engine (found live: the ax66 oracle
  // ran at the family default vlen=512 -> vlenb ref=0x40 vs got=0x10, and
  // without H -> mideleg ref=0 vs the pinned 0x1444). hw_engine_id names
  // that engine; the vlen (and ISA-cfg) sync reads it when no accurate-leg
  // step is present.
  {
    std::vector<EngineDescriptor> engines_hw = engines;
    engines_hw[1].vlen = 128;
    Plan vplan;
    vplan.elf = "/e";
    vplan.mem_size = 134217728;
    vplan.steps = {{"qemu", "fast-leg", {"marker", {}}}};
    vplan.hw_engine_id = "vsim:test";
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(vplan, engines_hw, "/wd", rc, err);
    CHECK(err.empty());
    CHECK(argvs.size() == 1);
    if (argvs.size() == 1) {
      bool found = false;
      for (const std::string& a : argvs[0])
        if (a == "andes-ax45mpv,vlen=128") found = true;
      CHECK(found);
    }
  }

  // --- plan_argvs: a QEMU readconfig cfg is injected into the fast leg only ---
  // The engine's config.inc, distilled to a QEMU `-readconfig` cfg, makes the
  // QEMU producer match the accurate engine's ISA. Only the fast (QEMU) leg
  // gets `-readconfig <cfg>`; the vsim accurate leg never does. An empty cfg
  // injects nothing (fallback to the descriptor's default -cpu).
  {
    RuntimeCtx rcfg = rc;
    rcfg.qemu_cfg = "/wd/qemu.cfg";
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(plan, engines, "/wd", rcfg, err);
    CHECK(err.empty());
    CHECK(argvs.size() == 2);
    if (argvs.size() == 2) {
      bool fast_has = false;
      for (size_t k = 0; k + 1 < argvs[0].size(); ++k)
        if (argvs[0][k] == "-readconfig" && argvs[0][k + 1] == "/wd/qemu.cfg")
          fast_has = true;
      CHECK(fast_has);
      for (const std::string& a : argvs[1]) CHECK(a != "-readconfig");
    }
  }
  // empty qemu_cfg (the default rc) injects no -readconfig on either leg
  {
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(plan, engines, "/wd", rc, err);
    CHECK(err.empty());
    if (argvs.size() == 2)
      for (const std::vector<std::string>& a : argvs)
        for (const std::string& tok : a) CHECK(tok != "-readconfig");
  }

  // --- leg_trigger_args: a trigger's per-role argv contribution ---
  {
    std::string err;
    // marker drives nothing into the argv; the plugin/vsim detect markers.
    LegTriggerArgs marker = leg_trigger_args({"marker", {}}, "fast-leg", err);
    CHECK(err.empty());
    CHECK(marker.plugin_suffix.empty());
    CHECK(marker.extra.empty());

    // pc: qemu gets the enter_pc plugin suffix; vsim gets the exit-pc tokens.
    const Trigger pc = {"pc", {{"enter_pc", "0x10"}, {"exit_pc", "0x20"}}};
    LegTriggerArgs pf = leg_trigger_args(pc, "fast-leg", err);
    CHECK(err.empty());
    CHECK(pf.plugin_suffix == ",enter_pc=0x10");
    CHECK(pf.extra.empty());
    LegTriggerArgs pa = leg_trigger_args(pc, "accurate-leg", err);
    CHECK(err.empty());
    CHECK(pa.plugin_suffix.empty());
    check_eq(pa.extra, {"--hybrid-exit-pc", "0x20"}, "pc-acc");

    // a role outside fast-leg/accurate-leg carries no trigger args
    LegTriggerArgs none = leg_trigger_args(pc, "standalone", err);
    CHECK(err.empty());
    CHECK(none.plugin_suffix.empty());
    CHECK(none.extra.empty());

    // unknown trigger kind / missing required param are errors
    leg_trigger_args({"bogus", {}}, "fast-leg", err);
    CHECK(!err.empty());
    leg_trigger_args({"pc", {}}, "fast-leg", err);
    CHECK(!err.empty());

    // verify oracle leg (verify_oracle F4): qemu drains at the ROI exit,
    // sampling at vsim's drained pc (drain_pc).
    const Trigger vm = {"verify-marker", {{"drain_pc", "0x100072"}}};
    LegTriggerArgs vmf = leg_trigger_args(vm, "fast-leg", err);
    CHECK(err.empty());
    CHECK(vmf.plugin_suffix == ",exit_marker=1,drain_pc=0x100072");
    CHECK(vmf.extra.empty());
    const Trigger vp = {"verify-pc",
                        {{"exit_pc", "0x20"}, {"drain_pc", "0x28"}}};
    LegTriggerArgs vpf = leg_trigger_args(vp, "fast-leg", err);
    CHECK(err.empty());
    CHECK(vpf.plugin_suffix == ",exit_pc=0x20,drain_pc=0x28");
    leg_trigger_args({"verify-marker", {}}, "fast-leg", err);
    CHECK(!err.empty());  // missing drain_pc
    leg_trigger_args({"verify-pc", {{"drain_pc", "0x28"}}}, "fast-leg", err);
    CHECK(!err.empty());  // missing exit_pc
  }

  // --- plan_argvs: pc trigger threads enter_pc (qemu) + exit_pc (vsim) ---
  {
    Plan p = plan;
    const Trigger pc = {"pc", {{"enter_pc", "0x100000"}, {"exit_pc", "0x100042"}}};
    p.steps[0].trigger = pc;
    p.steps[1].trigger = pc;
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(p, engines, "/wd", rc, err);
    CHECK(err.empty());
    CHECK(argvs.size() == 2);
    if (argvs.size() == 2) {
      // qemu: enter_pc folded into the single -plugin token (its last arg)
      CHECK(argvs[0].back() ==
            "/pl,outfile=/wd/state-0.bin,enter_pc=0x100000,log_level=2");
      // vsim: --hybrid-exit-pc appended verbatim after the filled template
      check_eq(argvs[1],
               {"/vbin", "/e", "--resume-from-qemu", "/wd/state-0.bin",
                "--handoff-out", "/wd/state-1.bin", "--shared-mem-path", "/mm",
                "--shared-mem-size", "134217728", "--shared-mem-base", "0x0",
                "--hybrid-exit-pc", "0x100042"},
               "pc-step1");
    }
  }

  // --- plan_argvs: Step.extra_args append AFTER trigger args (e2e.sh order) ---
  {
    Plan p = plan;
    const Trigger pc = {"pc", {{"enter_pc", "0x100000"}, {"exit_pc", "0x100042"}}};
    p.steps[0].trigger = pc;
    p.steps[1].trigger = pc;
    p.steps[1].extra_args = {"--kanata", "k.txt"};
    std::string err;
    std::vector<std::vector<std::string>> argvs =
        plan_argvs(p, engines, "/wd", rc, err);
    CHECK(err.empty());
    if (argvs.size() == 2) {
      const std::vector<std::string>& v = argvs[1];
      CHECK(v.size() >= 4);
      // tail order: ... --hybrid-exit-pc 0x100042 --kanata k.txt
      CHECK(v[v.size() - 4] == "--hybrid-exit-pc");
      CHECK(v[v.size() - 3] == "0x100042");
      CHECK(v[v.size() - 2] == "--kanata");
      CHECK(v.back() == "k.txt");
    }
  }

  // unknown engine id is an error
  {
    Plan bad = plan;
    bad.steps[0].engine_id = "nope";
    std::string err;
    CHECK(plan_argvs(bad, engines, "/wd", rc, err).empty());
    CHECK(!err.empty());
  }
  // a role the engine has no template for is an error
  {
    Plan bad = plan;
    bad.steps[1].role = "no-such-role";
    std::string err;
    CHECK(plan_argvs(bad, engines, "/wd", rc, err).empty());
    CHECK(!err.empty());
  }

  // plan_step_rc_error: a drain leg that exits 0 ran the workload to completion
  // without ever reaching its ROI boundary -- the trigger never fired. The
  // message must say so and name the trigger kind, not just the bare
  // "expected exit 200, got 0" the user cannot act on.
  {
    const Step s{"qemu", "fast-leg", {"marker", {}}};
    const std::string m = plan_step_rc_error(0, s, 200, 0);
    CHECK(m.find("plan step 0") != std::string::npos);
    CHECK(m.find("marker") != std::string::npos);
    CHECK(m.find("without reaching") != std::string::npos);
  }
  // a genuine non-zero failure (engine crash, not a clean completion) keeps the
  // bare line -- no false "trigger never fired" claim.
  {
    const Step s{"qemu", "fast-leg", {"marker", {}}};
    const std::string m = plan_step_rc_error(1, s, 200, 139);
    CHECK(m.find("expected exit 200, got 139") != std::string::npos);
    CHECK(m.find("without reaching") == std::string::npos);
  }

  return andes_sim::test::report("plan");
}
