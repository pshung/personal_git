// Tests the config-macro -> platform-cache binding for an L2C build (the
// 45-series shape, e.g. ax45mpv_premium_full / ax45mpv_mp2: no private L2,
// the platform cache at 0xE0500000 is the L2C). Separate TU per macro
// profile -- same scheme as the andes_caps_config tests.
#define _NDS_L2C_CACHE_SIZE_KB 32
#define _NDS_L2C_REG_BASE 0x00000000E0500000

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/shared_cache_config.hpp"

TEST_CASE("L2C macros gate the platform cache on (45-series shape)")
{
  CHECK(hybrid::shared_cache_level() == 2);
  CHECK(hybrid::shared_cache_base() == 0xE0500000ull);
  CHECK(hybrid::shared_cache_size_kb() == 32u);
}
