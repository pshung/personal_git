-include ../../Make.var

all: cache_on.elf cache_off.elf l2c.elf l3c.elf cache_on.dump cache_off.dump

cache_on.elf: main.c
	$(CC) $(CFLAGS) $< -o $@

cache_off.elf: main.c
	$(CC) $(CFLAGS) -DCACHE_OFF $< -o $@

# One source, two shared-cache tests: the block is the L2C on 45-series
# engines and the L3C on 46/66-series (same registers, same transport);
# the build name matches what `andesim list engines` calls that engine's
# CACHE, and check.sh runs the matching one.
l2c.elf: l2c.c
	$(CC) $(CFLAGS) $< -o $@

l3c.elf: l2c.c
	$(CC) $(CFLAGS) -DSHC_L3 $< -o $@

cache_on.dump: cache_on.elf
	$(OBJDUMP) -d $< > $@

cache_off.dump: cache_off.elf
	$(OBJDUMP) -d $< > $@

# The standard modes run the cached (default) build.
cache-fast: cache_on.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

cache-cycle: cache_on.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

cache-hybrid-marker: cache_on.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

cache-hybrid-pc: cache_on.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start cache_kernel --pc-end cache_roi_end \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

# The headline comparison partner: the SAME kernel, caches disabled by the
# program before the ROI. Hybrid only -- see main.c on why there is no
# cache-off-cycle target.
cache-off-hybrid-marker: cache_off.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

# Platform-cache (L2C/L3C) MMIO transport tests. Hybrid only BY DESIGN:
# fast never leaves QEMU's RAM stub and cycle never leaves the RTL, so
# only hybrid crosses the boundary these tests exist to check. Not part
# of `run`: each needs an engine whose RTL has that cache -- check.sh
# picks the leg from the engine's CACHE column (L2:*/L3:*) and SKIPs
# (naming the blocking layer) when it shows "-".
cache-l2c-hybrid-marker: l2c.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

cache-l3c-hybrid-marker: l3c.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: cache-fast cache-cycle cache-hybrid-marker cache-hybrid-pc cache-off-hybrid-marker

# Self-asserting: both hybrid figures parsed, off/on ratio must clear
# RATIO_MIN (default 2); plus the engine-gated L2C/L3C transport leg.
check: cache_on.elf cache_off.elf l2c.elf l3c.elf
	@ANDESIM_BIN="$(ANDESIM_BIN)" ENGINE="$(ENGINE)" bash check.sh

clean:
	- rm -f cache_on.elf cache_off.elf l2c.elf l3c.elf cache_on.dump cache_off.dump

.PHONY: all run check clean cache-fast cache-cycle cache-hybrid-marker \
        cache-hybrid-pc cache-off-hybrid-marker cache-l2c-hybrid-marker \
        cache-l3c-hybrid-marker
