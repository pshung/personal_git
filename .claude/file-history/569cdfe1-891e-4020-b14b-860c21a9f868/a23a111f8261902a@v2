// Tests the config-macro -> platform-cache binding for an L3C build. A
// separate TU per macro profile (the _NDS_* macros are global per
// translation unit -- same scheme as the andes_caps_config tests).
//
// ax66_makatau's macro shape, from build/Vax66_makatau/obj_sc/Vax66_config.h:
// the 66-series cores carry private L2s (PL2C), so the platform cache at
// 0xE0500000 is the L3C. No _NDS_L2C_* macros exist in this generation.
#define _NDS_L3C_CACHE_SIZE_KB 512
#define _NDS_L3C_REG_BASE 0x00000000e0500000

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/shared_cache_config.hpp"

TEST_CASE("L3C macros gate the platform cache on (ax66_makatau shape)")
{
  CHECK(hybrid::shared_cache_level() == 3);
  CHECK(hybrid::shared_cache_base() == 0xE0500000ull);
  CHECK(hybrid::shared_cache_size_kb() == 512u);
}
