// Pure-logic test for derive_roi_kanata_gate(): given a CsrTrigger and a
// resume PC, return the kanata LoopGate that frames the ROI.
// - pc-mode: caller passes explicit_exit_pc, that wins.
// - csr-mode: the helper picks the unique HYBRID_HANDOFF_EXIT PC from the
//   trigger; 0 or >1 raises.

#include "hybrid/csr_trigger.hpp"
#include "hybrid/kanata_roi.hpp"
#include "pipeview/kanata_logger.hpp"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include <cstdint>
#include <stdexcept>

TEST_CASE("derive_roi_kanata_gate: csr-mode picks the unique EXIT PC")
{
  hybrid::CsrTrigger trig;
  trig.add_pc_hit(0x80000000, HYBRID_HANDOFF_ENTER);
  trig.add_pc_hit(0x80000100, HYBRID_HANDOFF_EXIT);

  const auto gate =
    hybrid::derive_roi_kanata_gate(trig, /*resume_pc=*/0x80000004,
                                   /*explicit_exit_pc=*/std::nullopt);
  CHECK(gate.start_pc == 0x80000004);
  CHECK(gate.end_pc == 0x80000100);
  CHECK(gate.skip_iters == 0);
  CHECK(gate.record_iters == 1);
}

TEST_CASE("derive_roi_kanata_gate: pc-mode honors explicit_exit_pc")
{
  hybrid::CsrTrigger trig;  // empty (PC-mode skips scan in vsim)

  const auto gate =
    hybrid::derive_roi_kanata_gate(trig, /*resume_pc=*/0x80000010,
                                   /*explicit_exit_pc=*/0x80000200);
  CHECK(gate.start_pc == 0x80000010);
  CHECK(gate.end_pc == 0x80000200);
  CHECK(gate.skip_iters == 0);
  CHECK(gate.record_iters == 1);
}

TEST_CASE("derive_roi_kanata_gate: explicit_exit_pc wins over scanned EXITs")
{
  hybrid::CsrTrigger trig;
  trig.add_pc_hit(0x80000100, HYBRID_HANDOFF_EXIT);
  trig.add_pc_hit(0x80000200, HYBRID_HANDOFF_EXIT);

  const auto gate =
    hybrid::derive_roi_kanata_gate(trig, /*resume_pc=*/0x80000004,
                                   /*explicit_exit_pc=*/0x80000300);
  CHECK(gate.end_pc == 0x80000300);
}

TEST_CASE("derive_roi_kanata_gate: csr-mode with zero EXIT PCs throws")
{
  hybrid::CsrTrigger trig;
  trig.add_pc_hit(0x80000000, HYBRID_HANDOFF_ENTER);  // no EXIT

  CHECK_THROWS_AS(
    hybrid::derive_roi_kanata_gate(trig, 0x80000004, std::nullopt),
    std::runtime_error);
}

TEST_CASE("derive_roi_kanata_gate: csr-mode with multiple EXIT PCs throws")
{
  hybrid::CsrTrigger trig;
  trig.add_pc_hit(0x80000100, HYBRID_HANDOFF_EXIT);
  trig.add_pc_hit(0x80000200, HYBRID_HANDOFF_EXIT);

  CHECK_THROWS_AS(
    hybrid::derive_roi_kanata_gate(trig, 0x80000004, std::nullopt),
    std::runtime_error);
}
