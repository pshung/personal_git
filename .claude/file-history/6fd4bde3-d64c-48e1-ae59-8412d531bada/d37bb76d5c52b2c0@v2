// Pure helper: pick the kanata window for a hybrid ROI run.
//
// - start_pc is the PC where vsim resumes execution (from QEMU 1's drain).
// - end_pc is taken from explicit_exit_pc when set (pc-mode forwards the
//   --hybrid-exit-pc CLI value), otherwise the unique HYBRID_HANDOFF_EXIT
//   PC scanned by the CsrTrigger (csr-mode). 0 or >1 exit hits in csr-mode
//   raise -- the caller is expected to redirect to pc-mode with explicit
//   --pc-end. The returned skip/record produce a single-shot window
//   (LoopGate semantics: open on first fetch of start_pc, close on first
//   retire of end_pc).

#pragma once

#include "hybrid/csr_trigger.hpp"
#include "hybrid/insn_match.h"

#include <cstdint>
#include <optional>
#include <stdexcept>
#include <string>

namespace hybrid
{

struct RoiKanataGate
{
  uint64_t start_pc;
  uint64_t end_pc;
  uint64_t skip_iters;
  uint64_t record_iters;
};

inline auto derive_roi_kanata_gate(
  const CsrTrigger& trigger, uint64_t resume_pc,
  std::optional<uint64_t> explicit_exit_pc) -> RoiKanataGate
{
  uint64_t end_pc = 0;
  if (explicit_exit_pc) {
    end_pc = *explicit_exit_pc;
  } else {
    const auto exits = trigger.pcs_of_kind(HYBRID_HANDOFF_EXIT);
    if (exits.empty()) {
      throw std::runtime_error(
        "--kanata-roi: no csrwi 0x7C0,1 (EXIT) marker found in ELF -- "
        "use --mode pc with --pc-end");
    }
    if (exits.size() > 1) {
      throw std::runtime_error(
        "--kanata-roi: " + std::to_string(exits.size())
        + " csrwi 0x7C0,1 (EXIT) markers in ELF -- "
          "use --mode pc with an explicit --pc-end to disambiguate");
    }
    end_pc = exits.front();
  }
  return RoiKanataGate{resume_pc, end_pc, /*skip=*/0u, /*record=*/1u};
}

}  // namespace hybrid
