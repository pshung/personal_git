// Hybrid ROI single-shot kanata window. csr-mode requires a unique exit
// csrwi 0x7C0,1 so the recorded window is reproducible across runs; the
// 0/>1 throws push the user to pc-mode where they pick the exit explicitly.

#pragma once

#include "hybrid/csr_trigger.hpp"
#include "hybrid/insn_match.h"
#include "pipeview/kanata_logger.hpp"

#include <cstdint>
#include <optional>
#include <stdexcept>
#include <string>

namespace hybrid
{

inline auto derive_roi_kanata_gate(
  const CsrTrigger& trigger, uint64_t resume_pc,
  std::optional<uint64_t> explicit_exit_pc) -> kanata::LoopGate
{
  uint64_t end_pc = 0;
  if (explicit_exit_pc) {
    end_pc = *explicit_exit_pc;
  } else {
    const auto exits = trigger.pcs_of_kind(HYBRID_HANDOFF_EXIT);
    if (exits.empty()) {
      throw std::runtime_error(
        "--kanata-roi: no csrwi 0x7C0,1 (EXIT) marker found in ELF -- "
        "use --mode pc with --pc-end");
    }
    if (exits.size() > 1) {
      throw std::runtime_error(
        "--kanata-roi: " + std::to_string(exits.size())
        + " csrwi 0x7C0,1 (EXIT) markers in ELF -- "
          "use --mode pc with an explicit --pc-end to disambiguate");
    }
    end_pc = exits.front();
  }
  return kanata::LoopGate{resume_pc, end_pc, /*skip=*/0u, /*record=*/1u};
}

}  // namespace hybrid
