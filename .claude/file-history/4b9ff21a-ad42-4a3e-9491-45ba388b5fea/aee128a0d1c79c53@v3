{
  RecordingBus bus;
  prime_snapshot_bus(bus, /*mcycle=*/0x7777, /*minstret=*/0x6666);
  bus.regfile[hybrid::regno_csr(RD::kCsrDpc)] = 0x80000060;

  hybrid::IcountTrigger trigger{/*target=*/3};
  hybrid::HandoffController h(std::move(trigger), bus);  // CTAD -> NullObserver

  std::optional<hybrid_state_v1> drained;
  for (int i = 0; i < 3; ++i) {
    drained = h.on_retire(0x80000000, [](uint8_t) -> uint64_t { return 0u; });
  }
  REQUIRE(drained);
  CHECK(drained->mcycle_at_measure_start   == 0u);
  CHECK(drained->minstret_at_measure_start == 0u);
}
