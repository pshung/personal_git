#!/usr/bin/env bash
# F21: `./hsim run ... --vsim-warmup-icount K` is parsed and forwarded
# through to vsim, regardless of --mode.
#
# 1. `./hsim run --help` advertises --vsim-warmup-icount.
# 2. `./hsim run <elf> --mode csr --vsim-warmup-icount 1000` exits 0 and
#    its e2e log shows the [warmup] snapshot line printed by tests/e2e.sh
#    (only emitted when WARMUP_ICOUNT is set and the snapshot fields are
#    populated in the drained state).

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
HSIM="$ROOT/hsim"
ELF="$ROOT/tests/fixtures/rt_c_v_matmul.elf"

. "$SCRIPT_DIR/../lib/log.sh"

[ -x "$HSIM" ] || fail "missing executable: $HSIM"
[ -f "$ELF" ]  || fail "missing fixture: $ELF (run ./hsim build)"

cd "$ROOT"

# 1. --help mentions the flag.
out=$("$HSIM" run --help 2>&1) || fail "run --help exit nonzero: $out"
echo "$out" | grep -q -- "--vsim-warmup-icount" \
  || fail "run --help missing --vsim-warmup-icount:\n$out"
ok "hsim run --help advertises --vsim-warmup-icount"

# 2. CSR mode + warmup: round-trip passes and tests/e2e.sh prints a
# [warmup] line carrying the populated snapshot fields.
set +e
out=$(timeout 180 "$HSIM" run "$ELF" --mode csr --vsim-warmup-icount 1000 2>&1)
rc=$?
set -e
[ "$rc" -eq 0 ] || { echo "$out"; fail "hsim run rc=$rc (expected 0)"; }
echo "$out" | grep -qE 'warmup\] K=1000 mcycle_at_measure_start=[1-9]' \
  || { echo "$out"; fail "missing [<fixture> warmup] line with non-zero snapshot"; }
ok "hsim --mode csr --vsim-warmup-icount 1000 forwarded; snapshot populated"

echo "PASS test_hsim_warmup_arg"
