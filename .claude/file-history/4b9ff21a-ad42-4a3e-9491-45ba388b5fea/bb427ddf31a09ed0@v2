"""Shared warmup-snapshot invariant checker for the hybrid e2e scripts.

Used by:
  tests/hybrid/test_vsim_warmup_icount_arg.sh
  tests/hybrid/e2e_warmup_csr.sh
  tests/hybrid/e2e_warmup_pc.sh
  tests/hybrid/e2e_warmup_icount.sh

Reads the F13 warmup snapshot pair (mcycle_at_measure_start /
minstret_at_measure_start) and the drained mcycle/minstret from one or
two state files, then asserts the post-warmup-wave invariants. Field
offsets come from the `HybridStateV1` ctypes mirror so any future ABI
shuffle breaks here at parse time instead of as silent zeros.

Usage:
  python3 tests/lib/warmup_assert.py <STATE_VSIM> --k K [--tol TOL]
  python3 tests/lib/warmup_assert.py <STATE_QEMU> <STATE_VSIM> --k K \
      [--m M] [--tol TOL]

  One-file mode (test_vsim_warmup_icount_arg.sh): asserts the vsim drain's
  snapshot fields are both > 0 (plumbing test, no relational checks).

  Two-file mode (e2e_warmup_csr/pc/icount.sh): asserts
    qemu_mcycle    < snapshot_mcycle < vsim_mcycle
    qemu_minstret  < snapshot_minstret < vsim_minstret
    |snapshot_minstret - qemu_minstret - K| <= TOL
  and (when --m is set, icount mode) also
    |vsim_minstret - qemu_minstret - M| <= TOL
"""
from __future__ import annotations

import argparse
import struct
import sys
from pathlib import Path

# tests/lib/ -> tools/orchestrator/ for HybridStateV1's field offsets.
_TOOLS_ORCHESTRATOR = (
    Path(__file__).resolve().parents[2] / "tools"
)
sys.path.insert(0, str(_TOOLS_ORCHESTRATOR))
from orchestrator.abi import HybridStateV1  # noqa: E402


def _u64(buf: bytes, field_name: str) -> int:
    """Read a uint64_t from `buf` at HybridStateV1.<field_name>.offset."""
    offset = getattr(HybridStateV1, field_name).offset
    return struct.unpack_from("<Q", buf, offset)[0]


def _read_snapshot(vsim_path: Path) -> tuple[int, int, int, int]:
    """Return (mcycle, minstret, mcycle@measure, minstret@measure)."""
    buf = vsim_path.read_bytes()
    return (
        _u64(buf, "mcycle"),
        _u64(buf, "minstret"),
        _u64(buf, "mcycle_at_measure_start"),
        _u64(buf, "minstret_at_measure_start"),
    )


def _one_file_mode(state_vsim: Path, k: int) -> int:
    _, _, ms_mc, ms_mi = _read_snapshot(state_vsim)
    print(f"[warmup] mcycle_at_measure_start={ms_mc} "
          f"minstret_at_measure_start={ms_mi} K={k}")
    failures = []
    if ms_mc <= 0:
        failures.append(
            f"mcycle_at_measure_start expected > 0 with K={k}, got {ms_mc}"
        )
    if ms_mi <= 0:
        failures.append(
            f"minstret_at_measure_start expected > 0 with K={k}, got {ms_mi}"
        )
    if failures:
        for line in failures: print(f"FAIL: {line}", file=sys.stderr)
        return 1
    return 0


def _two_file_mode(state_qemu: Path, state_vsim: Path,
                   k: int, m: int | None, tol: int) -> int:
    q_buf = state_qemu.read_bytes()
    q_mc = _u64(q_buf, "mcycle")
    q_mi = _u64(q_buf, "minstret")
    v_mc, v_mi, ms_mc, ms_mi = _read_snapshot(state_vsim)
    print(f"  qemu1: mcycle={q_mc} minstret={q_mi}")
    print(f"  vsim:  mcycle={v_mc} minstret={v_mi}")
    suffix = f"  (K={k}, M={m})" if m is not None else f"  (K={k})"
    print(f"  snap:  mcycle={ms_mc} minstret={ms_mi}{suffix}")

    failures: list[str] = []
    if not (q_mc < ms_mc):
        failures.append(f"snapshot mcycle {ms_mc} not > qemu1 mcycle {q_mc}")
    if not (ms_mc < v_mc):
        failures.append(f"snapshot mcycle {ms_mc} not < final mcycle {v_mc}")
    snap_delta = ms_mi - q_mi
    if abs(snap_delta - k) > tol:
        failures.append(
            f"snapshot minstret delta {snap_delta} not within +-{tol} of K={k}"
        )
    if not (v_mi > ms_mi):
        failures.append(
            f"final minstret {v_mi} not > snapshot minstret {ms_mi}"
        )
    if m is not None:
        total_delta = v_mi - q_mi
        if abs(total_delta - m) > tol:
            failures.append(
                f"vsim minstret delta {total_delta} not within +-{tol} of M={m}"
            )
        measure_delta = v_mi - ms_mi
        if abs(measure_delta - (m - k)) > tol:
            failures.append(
                f"measure-window insns {measure_delta} not within +-{tol} "
                f"of M-K={m - k}"
            )

    if failures:
        for line in failures: print(f"FAIL: {line}", file=sys.stderr)
        return 1

    print(f"  measure window: {v_mc - ms_mc} cycles, "
          f"{v_mi - ms_mi} insns")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("paths", nargs="+", type=Path,
                        help="STATE_VSIM (one-file) or STATE_QEMU STATE_VSIM")
    parser.add_argument("--k", type=int, required=True,
                        help="warmup target (--vsim-warmup-icount K)")
    parser.add_argument("--m", type=int, default=None,
                        help="vsim --hybrid-icount M (icount mode only)")
    parser.add_argument("--tol", type=int, default=5,
                        help="absolute insn-count tolerance (default: 5)")
    args = parser.parse_args(argv)

    if len(args.paths) == 1:
        if args.m is not None:
            parser.error("--m is only valid in two-file mode (need STATE_QEMU)")
        return _one_file_mode(args.paths[0], args.k)
    if len(args.paths) == 2:
        return _two_file_mode(args.paths[0], args.paths[1],
                              args.k, args.m, args.tol)
    parser.error("expected 1 or 2 state-file paths")
    return 2


if __name__ == "__main__":
    sys.exit(main())
