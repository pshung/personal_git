#!/usr/bin/env bash
# HVM transport F3 (ROADMAP_hvm): the driver arms the HVM content transport
# from the accurate engine's descriptor, exactly like ILM/DLM --
#   fast leg   : plugin args gain ",hvm_size=<bytes>" (sidecar drain)
#   accurate leg: argv gains "--hvm <state_in>.hvm"   (backdoor load)
# and an engine describing hvm_size=0 must arm NEITHER. Asserted through
# `--dry-run`, which prints the exact argvs without running engines.
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"     # fail/ok + vsim_bin_dir
. "$SCRIPT_DIR/../lib/paths.sh"   # hybrid_describe_int

bash "$ROOT/scripts/build_driver.sh" >/dev/null 2>&1 || fail "build_driver.sh failed"
BIN="$ROOT/build/andesim"
[ -x "$BIN" ] || fail "missing andesim binary: $BIN"
elf=$(ls "$ROOT"/tests/fixtures/handoff_roundtrip.elf 2>/dev/null \
      || ls "$ROOT"/tests/fixtures/*.elf 2>/dev/null | head -1)
[ -n "$elf" ] || fail "no fixture ELF under tests/fixtures"

BINDIR=$(vsim_bin_dir)
PREMIUM="$BINDIR/sim_ax45mpv_premium"
if [ ! -x "$PREMIUM" ]; then
  ok "SKIP: no sim_ax45mpv_premium under $BINDIR (set VSIM_BIN_DIR)"
  exit 0
fi

# The engine's own advertised size is the wiring's source of truth.
HVM_SIZE=$(hybrid_describe_int hvm_size "$PREMIUM")
[ -n "$HVM_SIZE" ] && [ "$HVM_SIZE" -gt 0 ] \
  || fail "premium --describe lacks a non-zero hvm_size (vsim F1 regression?)"

out=$(timeout 60 env VSIM_BIN_DIR="$BINDIR" "$BIN" run --mode hybrid \
      --trigger marker --engine vsim:ax45mpv_premium "$elf" --dry-run 2>&1); rc=$?
[ "$rc" -eq 0 ] || fail "hybrid --dry-run exit $rc: $out"

printf '%s\n' "$out" | grep -q "hvm_size=$HVM_SIZE" \
  || fail "fast-leg plugin args lack hvm_size=$HVM_SIZE: $out"
printf '%s\n' "$out" | grep -q -- '--hvm' \
  || fail "accurate-leg argv lacks --hvm <state>.hvm: $out"
printf '%s\n' "$out" | grep -q 'ilm_size=' \
  || fail "LM wiring regressed (no ilm_size= in plugin args): $out"
ok "premium: plugin hvm_size=$HVM_SIZE + accurate-leg --hvm armed"

# Negative (deterministic): an engine that describes NO hvm_size must arm
# neither side. Proven with a fake engine so the case never depends on how a
# real engine happens to be built (a rebuilt wrapper gaining the HVM backdoor
# used to break a hardcoded "ax46 has no HVM" assumption here).
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/engines"
cat >"$TMP/engines/nohvm" <<'EOF'
#!/bin/sh
[ "$1" = "--describe" ] || exit 1
printf '%s\n' '{"id":"vsim:nohvm","type":"vsim","kind":"cycle-accurate","xlen":64,"vlen":512,"roles":["standalone","accurate-leg"],"state":["resume","drain"],"invoke":{"standalone":["{bin}","{elf}"],"accurate-leg":["{bin}","{elf}","--resume-from-qemu","{state_in}","--handoff-out","{state_out}","--shared-mem-path","{mmap}","--shared-mem-size","{mmap_size}","--shared-mem-base","{mmap_base}"]}}'
EOF
chmod +x "$TMP/engines/nohvm"
out=$(timeout 60 env ANDESIM_ENGINES_DIR="$TMP/engines" "$BIN" run --mode hybrid \
      --trigger marker "$elf" --dry-run 2>&1); rc=$?
[ "$rc" -eq 0 ] || fail "fake hvm-less hybrid --dry-run exit $rc: $out"
printf '%s\n' "$out" | grep -q 'hvm_size=' \
  && fail "hvm-less engine must not arm the plugin hvm drain: $out"
printf '%s\n' "$out" | grep -q -- '--hvm' \
  && fail "hvm-less engine must not get --hvm: $out"
ok "fake hvm-less engine: hvm transport stays off (describe has no hvm_size)"

# Real-engine consistency: whatever ax46's OWN --describe advertises is what
# the wiring must arm (line 29: the descriptor is the source of truth). This
# stays correct across engine rebuilds with either HVM capability.
AX46="$BINDIR/sim_ax46mpv_advanced"
if [ -x "$AX46" ]; then
  AX46_HVM=$(hybrid_describe_int hvm_size "$AX46")
  : "${AX46_HVM:=0}"
  out=$(timeout 60 env VSIM_BIN_DIR="$BINDIR" "$BIN" run --mode hybrid \
        --trigger marker --engine vsim:ax46mpv_advanced "$elf" --dry-run 2>&1); rc=$?
  [ "$rc" -eq 0 ] || fail "ax46 hybrid --dry-run exit $rc: $out"
  if [ "$AX46_HVM" -gt 0 ]; then
    printf '%s\n' "$out" | grep -q "hvm_size=$AX46_HVM" \
      || fail "ax46 describes hvm_size=$AX46_HVM but the plugin drain is not armed: $out"
    printf '%s\n' "$out" | grep -q -- '--hvm' \
      || fail "ax46 describes hvm_size=$AX46_HVM but --hvm is missing: $out"
    ok "ax46: hvm transport armed to match its describe (hvm_size=$AX46_HVM)"
  else
    printf '%s\n' "$out" | grep -q 'hvm_size=' \
      && fail "ax46 (describe hvm_size=0) must not arm the plugin hvm drain: $out"
    printf '%s\n' "$out" | grep -q -- '--hvm' \
      && fail "ax46 (describe hvm_size=0) must not get --hvm: $out"
    ok "ax46: hvm transport stays off (describe hvm_size=0)"
  fi
else
  ok "SKIP ax46 consistency: no sim_ax46mpv_advanced under $BINDIR"
fi

echo "PASS[andes_sim_hvm_wiring]"
