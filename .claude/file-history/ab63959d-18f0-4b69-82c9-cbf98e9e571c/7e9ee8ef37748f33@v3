// printf-append onto a std::string (the renderers' one formatting primitive).
#if defined(__GNUC__)
__attribute__((format(printf, 2, 3)))
#endif
void appendf(std::string& out, const char* fmt, ...) {
  va_list ap;
  va_start(ap, fmt);
  va_list ap2;
  va_copy(ap2, ap);
  int n = vsnprintf(nullptr, 0, fmt, ap);
  va_end(ap);
  if (n < 0) {
    va_end(ap2);
    return;
  }
  std::string buf(static_cast<size_t>(n) + 1, '\0');
  vsnprintf(buf.data(), buf.size(), fmt, ap2);
  va_end(ap2);
  buf.resize(static_cast<size_t>(n));
  out += buf;
}

const std::set<std::string> kCallMnemonics = {"jal", "jalr", "c.jal", "c.jalr"};

}  // namespace

std::vector<LoopEdge> parse_plugin_log(const std::string& text) {
  std::vector<LoopEdge> rows;
  static const std::regex re(
      R"(\s*(0x[0-9a-fA-F]+)\s*,\s*(0x[0-9a-fA-F]+)\s*,\s*(\d+))");
  std::istringstream ss(text);
  std::string line;
  while (std::getline(ss, line)) {
    std::smatch m;
    if (!std::regex_search(line, m, re)) continue;
    rows.push_back({std::stoull(m[1], nullptr, 16),
                    std::stoull(m[2], nullptr, 16), std::stoull(m[3])});
  }
  return rows;
}

Disasm parse_disasm(const std::string& raw) {
  Disasm m;
  std::istringstream ss(raw);
  // Matches: optional leading whitespace, hex digits, colon, whitespace,
  // then mnemonic. Works for both GNU and LLVM objdump.
  static const std::regex re(R"(^\s*([0-9a-fA-F]+):\s+(\S+)(?:\s+(.*))?$)");
  std::string line;
  while (std::getline(ss, line)) {
    while (!line.empty() && (line.back() == '\r' || line.back() == '\n'))
      line.pop_back();
    std::smatch sm;
    if (!std::regex_match(line, sm, re)) continue;
    uint64_t pc;
    try {
      pc = std::stoull(sm[1], nullptr, 16);
    } catch (...) {
      continue;
    }
    std::string mn = sm[2];
    std::string ops = sm.size() > 3 ? sm[3].str() : "";
    while (!ops.empty() && (ops.back() == ' ' || ops.back() == '\t'))
      ops.pop_back();
    m[pc] = {std::move(mn), std::move(ops)};
  }
  return m;
}

bool is_rvv(const std::string& mnemonic) {
  if (mnemonic.size() < 2) return false;
  char lo = static_cast<char>(
      tolower(static_cast<unsigned char>(mnemonic[0])));
  return lo == 'v' && std::isalpha(static_cast<unsigned char>(mnemonic[1]));
}

std::vector<RvvInsn> rvv_in_range(const Disasm& disasm, uint64_t s,
                                  uint64_t e) {
  std::vector<RvvInsn> out;
  auto it = disasm.lower_bound(s);
  while (it != disasm.end() && it->first <= e) {
    if (is_rvv(it->second.mnemonic))
      out.push_back({it->first, it->second.mnemonic, it->second.operands});
    ++it;
  }
  return out;
}

std::vector<CallInsn> calls_in_range(const Disasm& disasm, uint64_t s,
                                     uint64_t e) {
  std::vector<CallInsn> out;
  static const std::regex callee_re("<([^>]+)>");
  auto it = disasm.lower_bound(s);
  while (it != disasm.end() && it->first <= e) {
    std::string lo = it->second.mnemonic;
    std::transform(lo.begin(), lo.end(), lo.begin(),
                   [](unsigned char c) { return tolower(c); });
    if (kCallMnemonics.count(lo)) {
      std::smatch m;
      std::string target = "(indirect)";
      if (std::regex_search(it->second.operands, m, callee_re)) target = m[1];
      out.push_back({it->first, it->second.mnemonic, target});
    }
    ++it;
  }
  return out;
}

std::vector<LoopEdge> filter_loops(std::vector<LoopEdge> rows, int min_iters,
                                   bool rvv_only, const Disasm& disasm,
                                   int limit) {
  rows.erase(std::remove_if(rows.begin(), rows.end(),
                            [&](const LoopEdge& r) {
                              return r.iters <
                                     static_cast<uint64_t>(min_iters);
                            }),
             rows.end());
  if (rvv_only) {
    rows.erase(std::remove_if(rows.begin(), rows.end(),
                              [&](const LoopEdge& r) {
                                return rvv_in_range(disasm, r.start, r.end)
                                    .empty();
                              }),
               rows.end());
  }
  std::sort(rows.begin(), rows.end(),
            [](const LoopEdge& a, const LoopEdge& b) {
              return a.iters > b.iters;
            });
  if (static_cast<int>(rows.size()) > limit)
    rows.resize(static_cast<size_t>(limit));
  return rows;
}

std::vector<Loop> build_loops(const std::vector<LoopEdge>& rows, int limit) {
  std::vector<Loop> loops;
  int n = std::min(static_cast<int>(rows.size()), limit);
  loops.reserve(static_cast<size_t>(n));
  for (int i = 0; i < n; ++i)
    loops.push_back({"L" + std::to_string(i + 1),
                     rows[static_cast<size_t>(i)].start,
                     rows[static_cast<size_t>(i)].end,
                     rows[static_cast<size_t>(i)].iters,
                     -1,
                     {}});

  // Parent: the smallest enclosing range; identical ranges never nest.
  for (int i = 0; i < n; ++i) {
    int best = -1;
    uint64_t best_sz = UINT64_MAX;
    for (int j = 0; j < n; ++j) {
      if (j == i) continue;
      if (loops[j].start == loops[i].start && loops[j].end == loops[i].end)
        continue;
      if (loops[j].start <= loops[i].start && loops[i].end <= loops[j].end) {
        uint64_t sz = loops[j].end - loops[j].start;
        if (sz < best_sz) {
          best = j;
          best_sz = sz;
        }
      }
    }
    loops[static_cast<size_t>(i)].parent = best;
  }
  for (int i = 0; i < n; ++i)
    if (loops[static_cast<size_t>(i)].parent >= 0)
      loops[static_cast<size_t>(loops[static_cast<size_t>(i)].parent)]
          .children.push_back(i);

  return loops;
}

uint64_t measure_ret_pc(const Disasm& disasm, uint64_t fn_entry,
                        uint64_t fn_end) {
  uint64_t ret_pc = fn_end - 4;  // safe default (standard ret is 4 bytes)
  auto it = disasm.lower_bound(fn_end);
  if (it != disasm.begin()) {
    --it;
    if (it->first >= fn_entry) ret_pc = it->first;
  }
  return ret_pc;
}

std::string src_basename(const std::string& s) {
  if (s.empty()) return "";
  // "path:line[ (extra)]" -> "basename(path):line[ ...]"
  auto sp = s.find(' ');
  std::string head = (sp != std::string::npos) ? s.substr(0, sp) : s;
  std::string tail = (sp != std::string::npos) ? s.substr(sp) : "";
  auto slash = head.rfind('/');
  return ((slash != std::string::npos) ? head.substr(slash + 1) : head) + tail;
}

std::pair<std::string, int> parse_file_line(const std::string& s) {
  if (s.empty() || s.rfind("??", 0) == 0) return {"", 0};
  static const std::regex re(R"(^(.+?):(\d+)(?::\d+)?(?:\s|$))");
  std::smatch m;
  if (!std::regex_search(s, m, re)) return {"", 0};
  return {m[1], std::stoi(m[2])};
}

std::string render_llm(const std::vector<Loop>& loops,
                       const std::vector<LoopSyms>& syms, uint64_t total_iters,
                       const std::string& target_name, const Disasm& disasm,
                       int min_iters, bool rvv_filter) {
  std::string out;
  if (loops.empty()) return out;

  auto pct = [&](uint64_t n) -> double {
    return total_iters ? 100.0 * static_cast<double>(n) /
                             static_cast<double>(total_iters)
                       : 0.0;
  };

  // Header + TL;DR
  {
    const Loop& top = loops[0];
    const LoopSyms& ts = syms[0];
    auto rvv = rvv_in_range(disasm, top.start, top.end);
    std::string rvv_str;
    if (!rvv.empty()) {
      std::vector<std::string> uniq;
      for (const auto& r : rvv)
        if (std::find(uniq.begin(), uniq.end(), r.mn) == uniq.end())
          uniq.push_back(r.mn);
      rvv_str = "RVV (";
      for (size_t i = 0; i < std::min(uniq.size(), size_t{3}); ++i) {
        if (i) rvv_str += ", ";
        rvv_str += uniq[i];
      }
      if (uniq.size() > 3)
        rvv_str += ", +" + std::to_string(uniq.size() - 3) + " more";
      rvv_str += ")";
    } else {
      rvv_str = "scalar";
    }
    std::string src_s = src_basename(ts.src_start);
    if (src_s.empty()) src_s = "?";
    std::string nest_str = top.parent >= 0
                               ? "nested inside " +
                                     loops[static_cast<size_t>(top.parent)].id
                               : "top-level (no parent loop)";
    std::string child_str;
    if (!top.children.empty()) {
      child_str = "and contains " + std::to_string(top.children.size()) +
                  " inner loop(s): ";
      for (size_t i = 0; i < top.children.size(); ++i) {
        if (i) child_str += ", ";
        child_str += loops[static_cast<size_t>(top.children[i])].id;
      }
    } else {
      child_str = "and contains no inner loop";
    }
    appendf(out, "# HotIterationLoop Report\n");
    appendf(out, "target:           %s\n", target_name.c_str());
    appendf(out, "total_iters:      %llu\n", (unsigned long long)total_iters);
    appendf(out, "reported_loops:   %zu\n", loops.size());
    appendf(out, "min_iters:        %d\n", min_iters);
    appendf(out, "rvv_filter:       %s\n", rvv_filter ? "on" : "off");
    appendf(out, "\n## TL;DR\n");
    appendf(out,
            "Hottest loop is %s in `%s` (%s), %llu iters = %.1f%% of total. "
            "Body is %s. It is %s, %s.\n",
            top.id.c_str(), ts.fn_name.c_str(), src_s.c_str(),
            (unsigned long long)top.iters, pct(top.iters), rvv_str.c_str(),
            nest_str.c_str(), child_str.c_str());
    appendf(out, "\n## Loops\n");
  }

  for (size_t idx = 0; idx < loops.size(); ++idx) {
    const Loop& loop = loops[idx];
    const LoopSyms& ls = syms[idx];
    appendf(out, "\n### %s%s  (%.1f%% of total)\n", loop.id.c_str(),
            idx == 0 ? " [hottest]" : "", pct(loop.iters));
    appendf(out, "iters:        %llu\n", (unsigned long long)loop.iters);
    appendf(out, "function:     %s -> %s\n", ls.sym_start.c_str(),
            ls.sym_end.c_str());

    // measure: whole enclosing function (entry -> ret).
    if (ls.fn_entry != 0 && ls.fn_end != 0) {
      uint64_t ret_pc = measure_ret_pc(disasm, ls.fn_entry, ls.fn_end);
      appendf(out,
              "measure:      --pc-start 0x%llx --pc-end 0x%llx"
              "  (all of %s: entry -> ret)\n",
              (unsigned long long)ls.fn_entry, (unsigned long long)ret_pc,
              ls.fn_name.c_str());
    }

    const std::string& sf = ls.src_start;
    const std::string& se = ls.src_end;
    if (!sf.empty() && !se.empty() && sf == se)
      appendf(out, "source:       %s\n", src_basename(sf).c_str());
    else
      appendf(out, "source:       %s -> %s\n",
              (sf.empty() ? "?" : src_basename(sf)).c_str(),
              (se.empty() ? "?" : src_basename(se)).c_str());

    if (!ls.code_snippet.empty()) {
      std::string snippet = ls.code_snippet;
      if (snippet.size() > 200) snippet = snippet.substr(0, 197) + "...";
      appendf(out, "code:         %s\n", snippet.c_str());
    }

    auto rvv = rvv_in_range(disasm, loop.start, loop.end);
    if (!rvv.empty()) {
      appendf(out, "rvv:          yes (%zu insn%s)\n", rvv.size(),
              rvv.size() == 1 ? "" : "s");
      appendf(out, "rvv_insns:\n");
      for (size_t i = 0; i < std::min(rvv.size(), size_t{8}); ++i)
        appendf(out, "  - 0x%llx  %-10s %s\n", (unsigned long long)rvv[i].pc,
                rvv[i].mn.c_str(), rvv[i].ops.c_str());
      if (rvv.size() > 8)
        appendf(out, "  - ... (%zu more)\n", rvv.size() - 8);
    } else {
      appendf(out, "rvv:          no\n");
    }

    appendf(out, "parent:       %s\n",
            loop.parent >= 0 ? loops[static_cast<size_t>(loop.parent)].id.c_str()
                             : "-");
    if (!loop.children.empty()) {
      appendf(out, "children:     [");
      for (size_t i = 0; i < loop.children.size(); ++i) {
        if (i) appendf(out, ", ");
        appendf(out, "%s",
                loops[static_cast<size_t>(loop.children[i])].id.c_str());
      }
      appendf(out, "]\n");
    } else {
      appendf(out, "children:     []\n");
    }

    auto callees = calls_in_range(disasm, loop.start, loop.end);
    if (!callees.empty()) {
      appendf(out, "calls:\n");
      for (size_t i = 0; i < std::min(callees.size(), size_t{8}); ++i)
        appendf(out, "  - 0x%llx  %s -> %s\n",
                (unsigned long long)callees[i].pc, callees[i].mn.c_str(),
                callees[i].target.c_str());
      if (callees.size() > 8)
        appendf(out, "  - ... (%zu more)\n", callees.size() - 8);
    } else {
      appendf(out, "calls:        []\n");
    }
  }
  return out;
}

std::string render_table(const std::vector<LoopEdge>& rows,
                         const std::vector<LoopSyms>& syms, int min_iters,
                         bool rvv_filter) {
  std::string out;
  bool have_src = false;
  for (const auto& s : syms)
    if (!s.src_start.empty() || !s.src_end.empty()) have_src = true;

  auto srcpair = [&](const LoopSyms& s) -> std::string {
    std::string a = src_basename(s.src_start), b = src_basename(s.src_end);
    if (!a.empty() && a == b) return a;
    return (a.empty() ? "?" : a) + " -> " + (b.empty() ? "?" : b);
  };

  appendf(out, "# hot loops (iters >= %d", min_iters);
  if (rvv_filter) appendf(out, ", RVV-only");
  appendf(out, "), sorted desc, top %zu\n", rows.size());

  size_t w_iter = 5;  // strlen("iters")
  for (const auto& r : rows) {
    char buf[24];
    snprintf(buf, sizeof(buf), "%llu", (unsigned long long)r.iters);
    w_iter = std::max(w_iter, strlen(buf));
  }
  const size_t w_pc = 18;
  size_t w_sym = 8;  // strlen("location")
  for (const auto& s : syms)
    w_sym = std::max(w_sym, s.sym_start.size() + 4 + s.sym_end.size());

  if (have_src) {
    appendf(out, "%*s | %-*s -> %-*s | %-*s | source\n",
            static_cast<int>(w_iter), "iters", static_cast<int>(w_pc),
            "start_pc", static_cast<int>(w_pc), "end_pc",
            static_cast<int>(w_sym), "location");
  } else {
    appendf(out, "%*s | %-*s -> %-*s | location\n", static_cast<int>(w_iter),
            "iters", static_cast<int>(w_pc), "start_pc",
            static_cast<int>(w_pc), "end_pc");
  }
  size_t sep = w_iter + 3 + w_pc + 4 + w_pc + 3 + w_sym;
  if (have_src) sep += 3 + 12;
  appendf(out, "%s\n", std::string(sep, '-').c_str());

  for (size_t i = 0; i < rows.size(); ++i) {
    const LoopEdge& r = rows[i];
    std::string loc = syms[i].sym_start + " -> " + syms[i].sym_end;
    if (have_src)
      appendf(out, "%*llu | 0x%016llx -> 0x%016llx | %-*s | %s\n",
              static_cast<int>(w_iter), (unsigned long long)r.iters,
              (unsigned long long)r.start, (unsigned long long)r.end,
              static_cast<int>(w_sym), loc.c_str(), srcpair(syms[i]).c_str());
    else
      appendf(out, "%*llu | 0x%016llx -> 0x%016llx | %s\n",
              static_cast<int>(w_iter), (unsigned long long)r.iters,
              (unsigned long long)r.start, (unsigned long long)r.end,
              loc.c_str());
  }
  return out;
}

std::vector<std::string> profile_qemu_argv(const ProfileQemuArgs& a) {
  std::vector<std::string> argv = {
      a.qemu_bin,
      "-plugin",
      a.plugin_so + ",limit=" + std::to_string(a.limit) +
          ",min_iters=" + std::to_string(a.min_iters),
      "-d", "plugin", "-D", a.log_path,
      "-M", "andes_ae350",
      "-cpu", a.cpu,
      "-nographic", "-semihosting",
      "-bios", a.elf,
  };
  if (!a.mem_size.empty()) {
    argv.push_back("-m");
    argv.push_back(a.mem_size);
  }
  if (!a.readconfig.empty()) {
    argv.push_back("-readconfig");
    argv.push_back(a.readconfig);
  }
  argv.insert(argv.end(), a.passthrough.begin(), a.passthrough.end());
  return argv;
}

