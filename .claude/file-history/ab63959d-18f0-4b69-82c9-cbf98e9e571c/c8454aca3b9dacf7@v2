int cmd_profile(const Cli& cli) {
  auto fail = [](const std::string& msg) {
    std::fprintf(stderr, "andesim profile: %s\n", msg.c_str());
    return 2;
  };

  // profile is not `run`: reject run-only flags loudly instead of silently
  // ignoring them (a silently dropped --trigger would look like a hung ROI).
  {
    const struct {
      bool set;
      const char* flag;
    } runonly[] = {
        {!cli.model.empty(), "--mode"},
        {!cli.trigger.empty(), "--trigger"},
        {!cli.pc_start.empty(), "--pc-start"},
        {!cli.pc_end.empty(), "--pc-end"},
        {cli.verify, "--verify"},
        {!cli.kanata.empty(), "--kanata"},
        {cli.gdb, "--gdb"},
        {!cli.gdb_port.empty(), "--gdb-port"},
        {cli.print_memmap, "--print-memmap"},
    };
    for (const auto& r : runonly)
      if (r.set)
        return fail(std::string(r.flag) +
                    " is not a profile option (profile runs the whole "
                    "program under QEMU; see 'andesim profile --help')");
  }

  if (cli.positional.empty())
    return fail("missing ELF (the workload to profile)");
  if (cli.positional.size() > 1)
    return fail("unexpected argument '" + cli.positional[1] +
                "' (extra QEMU args go after --)");

  int limit = 0, min_iters = 0;
  if (!parse_knob(cli.limit, 50, limit))
    return fail("--limit must be a positive integer, got '" + cli.limit + "'");
  if (!parse_knob(cli.min_iters, 1, min_iters))
    return fail("--min-iters must be a positive integer, got '" +
                cli.min_iters + "'");

  // Absolute, existing ELF (QEMU's -bios resolves relative paths against its
  // data dir, not the CWD) -- the same up-front check run's abs_elf does.
  std::error_code ec;
  const fs::path abs = fs::absolute(cli.positional[0], ec);
  if (ec || !fs::is_regular_file(abs))
    return fail("ELF not found: " + cli.positional[0]);
  const std::string elf = abs.string();

  // The engine pick: exactly hybrid's -- --engine or the sole cycle-accurate
  // engine, with the same errors (naming the discovered candidates).
  Discovery disc = discover_engines();
  std::string err;
  const EngineDescriptor* acc =
      resolve_accurate_engine(disc.engines, cli.engine, err);
  if (!acc) {
    std::fprintf(stderr, "andesim profile: %s\n", err.c_str());
    for (const std::string& w : disc.warnings)
      std::fprintf(stderr, "andesim: skipped engine: %s\n", w.c_str());
    return 2;
  }
  if (std::string e = elf_engine_arch_error(elf, *acc); !e.empty())
    return fail(e);

  // QEMU follows the engine's width (the arch guard above already pinned the
  // ELF to it; an unreadable ELF falls back to the ELF's own class, then 64).
  const int elf_w = elf_xlen(elf);
  const int xlen = acc->xlen ? static_cast<int>(acc->xlen)
                             : (elf_w ? elf_w : 64);
  const EngineDescriptor qemu = builtin_qemu_arch(xlen);
  const std::string plugin = profile_plugin_path().string();

  Workdir wd;
  if (wd.path.empty()) return fail(wd.error);

  // engine -> QEMU cfg, the same probe + staging the hybrid fast leg uses.
  // "" cfg = tolerant fallback (family-default -cpu), but SAY so: matching
  // the engine's ISA is the whole point of profiling through an engine.
  const RunResult probe =
      run_process({acc->bin_path, "--print-qemu-config"}, 5000);
  const std::string cfg = stage_qemu_cfg(wd.path, probe);
  std::string cpu_model = cfg.empty() ? std::string() : qemu_cpu_from_cfg(probe.out);
  if (cpu_model.empty()) cpu_model = "andes-ax45mpv";
  if (cfg.empty())
    log_line(kLogWarn,
             "[andesim] profile: engine %s gave no --print-qemu-config; "
             "falling back to -cpu %s (the profiled ISA may not match the "
             "engine)",
             acc->id.c_str(), cpu_model.c_str());

  ProfileQemuArgs qa;
  qa.qemu_bin = qemu.bin_path;
  qa.plugin_so = plugin;
  qa.log_path = wd.path + "/plugin.log";
  qa.limit = limit;
  qa.min_iters = min_iters;
  qa.cpu = cpu_model + ",vlen=" + std::to_string(synced_vlen(acc->vlen));
  qa.mem_size = cli.mem_size;  // forwarded as plain -m; QEMU validates it
  qa.readconfig = cfg;
  qa.elf = elf;
  qa.passthrough = cli.passthrough;
  const std::vector<std::string> argv = profile_qemu_argv(qa);

  if (cli.dry_run)
    return print_dry_run({argv}, {"profile [" + acc->id + "]"});

  log_line(kLogDebug, "[andesim] profile engine=%s cpu=%s fixture=%s",
           acc->id.c_str(), qa.cpu.c_str(), abs.stem().string().c_str());

  // Spawn-time checks, AFTER --dry-run so the preview needs no built QEMU.
  if (!fs::is_regular_file(qemu.bin_path) ||
      ::access(qemu.bin_path.c_str(), X_OK) != 0)
    return fail("qemu not found/executable: " + qemu.bin_path +
                " (set QEMU_BIN_DIR in config.env, or source ./setup.sh)");
  if (!fs::is_regular_file(plugin))
    return fail("plugin not built: " + plugin + " (make -C qemu_plugin)");

  log_line(kLogTrace, "[andesim] exec profile [%s]: %s", acc->id.c_str(),
           render_argv(argv).c_str());
  const int rc = exec_passthrough(argv);
  if (rc == -1) return fail("failed to spawn " + qemu.bin_path);
  if (rc != 0)
    log_line(kLogWarn,
             "[andesim] profile: qemu exited rc=%d; the report covers what "
             "ran",
             rc);

  std::string log_text;
  {
    std::ifstream f(qa.log_path);
    std::stringstream ss;
    ss << f.rdbuf();
    log_text = ss.str();
  }

  if (cli.raw) {
    std::fputs(log_text.c_str(), stdout);
    return 0;
  }

  auto all_rows = parse_plugin_log(log_text);
  if (all_rows.empty()) {
    std::fprintf(stderr, "andesim profile: no backward edges observed\n");
    return 0;
  }
  uint64_t total_iters = 0;
  for (const auto& r : all_rows) total_iters += r.iters;

  // Disassembly (the RVV filter + the report's rvv/calls sections need it).
  const std::string objdump = resolve_objdump(cli.objdump);
  Disasm disasm;
  if (!objdump.empty() && (cli.optimize_rvv || cli.llm))
    disasm = parse_disasm(
        run_process({objdump, "-d", "--no-show-raw-insn", elf}, 60000).out);
  if (objdump.empty() && cli.optimize_rvv)
    log_line(kLogWarn,
             "[andesim] profile: no objdump found; the RVV filter drops "
             "every loop -- install a riscv objdump or pass "
             "--no-optimize-rvv");

  auto rows = filter_loops(all_rows, min_iters, cli.optimize_rvv, disasm,
                           limit);
  if (rows.empty()) {
    std::fprintf(stderr, "andesim profile: no loops with iters >= %d%s\n",
                 min_iters,
                 cli.optimize_rvv ? " containing RVV instructions" : "");
    return 0;
  }

  // Source resolution (addr2line), unless --no-source.
  std::map<uint64_t, std::string> src_map;
  if (!cli.no_source) {
    const std::string a2l = !cli.addr2line.empty()
                                ? cli.addr2line
                                : find_first({"llvm-addr2line", "addr2line",
                                              "riscv64-unknown-elf-addr2line",
                                              "riscv32-unknown-elf-addr2line",
                                              "riscv64-linux-gnu-addr2line"});
    std::vector<uint64_t> pcs;
    for (const auto& r : rows) {
      pcs.push_back(r.start);
      pcs.push_back(r.end);
    }
    std::sort(pcs.begin(), pcs.end());
    pcs.erase(std::unique(pcs.begin(), pcs.end()), pcs.end());
    src_map = resolve_sources(a2l, elf, pcs);
  }

  std::string report;
  if (cli.llm) {
    const auto loops = build_loops(rows, limit);
    std::vector<LoopSyms> syms;
    syms.reserve(loops.size());
    for (const auto& l : loops)
      syms.push_back(make_syms(elf, l.start, l.end, src_map));
    report = render_llm(loops, syms, total_iters, abs.filename().string(),
                        disasm, min_iters, cli.optimize_rvv);
  } else {
    std::vector<LoopSyms> syms;
    syms.reserve(rows.size());
    for (const auto& r : rows)
      syms.push_back(make_syms(elf, r.start, r.end, src_map));
    report = render_table(rows, syms, min_iters, cli.optimize_rvv);
  }
  std::fputs(report.c_str(), stdout);
  return 0;
}

