// The bundled hot-loop plugin under the repo root (the profile counterpart of
// default_plugin_path's hybrid plugin).
fs::path profile_plugin_path() {
  return repo_root() / "qemu_plugin" / "libhotIterationLoop.so";
}

// Does `cmd` resolve to an executable (absolute/relative path, or via PATH)?
bool cmd_exists(const std::string& cmd) {
  if (cmd.find('/') != std::string::npos)
    return ::access(cmd.c_str(), X_OK) == 0;
  const char* path_env = std::getenv("PATH");
  if (!path_env) return false;
  std::istringstream ss(path_env);
  std::string dir;
  while (std::getline(ss, dir, ':'))
    if (!dir.empty() && ::access((dir + "/" + cmd).c_str(), X_OK) == 0)
      return true;
  return false;
}

std::string find_first(const std::vector<std::string>& cands) {
  for (const auto& c : cands)
    if (cmd_exists(c)) return c;
  return "";
}

// The cross objdump chain: --objdump wins, else $HYBRID_TOOLCHAIN (env or
// config.env) so RISC-V vendor extensions (RVV, Andes custom) decode
// correctly -- generic llvm-objdump on old distros may not know RVV.
std::string resolve_objdump(const std::string& override_path) {
  if (!override_path.empty()) return override_path;
  std::vector<std::string> cands;
  if (const std::string tc = config_env_value("HYBRID_TOOLCHAIN"); !tc.empty()) {
    cands.push_back(tc + "/bin/riscv64-unknown-elf-objdump");
    cands.push_back(tc + "/bin/riscv32-unknown-elf-objdump");
  }
  cands.insert(cands.end(), {"riscv64-unknown-elf-objdump",
                             "riscv32-unknown-elf-objdump", "llvm-objdump",
                             "objdump"});
  return find_first(cands);
}

// Write lines to argv's stdin; capture its stdout. Used for addr2line, which
// takes one hex address per input line.
std::string capture_with_stdin(const std::vector<std::string>& argv,
                               const std::string& input) {
  if (argv.empty()) return "";
  int in_fds[2], out_fds[2];
  if (pipe(in_fds) != 0) return "";
  if (pipe(out_fds) != 0) {
    close(in_fds[0]);
    close(in_fds[1]);
    return "";
  }
  pid_t pid = fork();
  if (pid < 0) {
    close(in_fds[0]); close(in_fds[1]);
    close(out_fds[0]); close(out_fds[1]);
    return "";
  }
  if (pid == 0) {
    close(in_fds[1]);
    close(out_fds[0]);
    dup2(in_fds[0], STDIN_FILENO);
    dup2(out_fds[1], STDOUT_FILENO);
    if (FILE* devnull = std::fopen("/dev/null", "w"))
      dup2(fileno(devnull), STDERR_FILENO);
    close(in_fds[0]);
    close(out_fds[1]);
    std::vector<char*> cargv;
    cargv.reserve(argv.size() + 1);
    for (const auto& a : argv) cargv.push_back(const_cast<char*>(a.c_str()));
    cargv.push_back(nullptr);
    execvp(cargv[0], cargv.data());
    _exit(127);
  }
  close(in_fds[0]);
  close(out_fds[1]);
  const char* p = input.data();
  size_t rem = input.size();
  while (rem > 0) {
    ssize_t w = write(in_fds[1], p, rem);
    if (w < 0) break;
    p += w;
    rem -= static_cast<size_t>(w);
  }
  close(in_fds[1]);
  std::string out;
  char buf[4096];
  ssize_t n;
  while ((n = read(out_fds[0], buf, sizeof(buf))) > 0)
    out.append(buf, static_cast<size_t>(n));
  close(out_fds[0]);
  int status = 0;
  waitpid(pid, &status, 0);
  return out;
}

// addr2line every pc in `pcs` against `elf_path`; unknown ("??") lines drop
// out, so absent keys mean "no source info".
std::map<uint64_t, std::string> resolve_sources(
    const std::string& addr2line_bin, const std::string& elf_path,
    const std::vector<uint64_t>& pcs) {
  std::map<uint64_t, std::string> result;
  if (addr2line_bin.empty() || pcs.empty()) return result;
  std::string input;
  for (uint64_t pc : pcs) {
    char buf[20];
    std::snprintf(buf, sizeof(buf), "0x%llx\n", (unsigned long long)pc);
    input += buf;
  }
  const std::string out =
      capture_with_stdin({addr2line_bin, "-e", elf_path}, input);
  std::istringstream ss(out);
  std::string line;
  size_t idx = 0;
  while (std::getline(ss, line) && idx < pcs.size()) {
    while (!line.empty() && (line.back() == '\r' || line.back() == '\n'))
      line.pop_back();
    if (!line.empty() && line.find("??") == std::string::npos)
      result[pcs[idx]] = line;
    ++idx;
  }
  return result;
}

// The trimmed text of `path`'s line `lineno` ("" when unreadable).
std::string read_source_line(const std::string& path, int lineno) {
  if (path.empty() || lineno <= 0 || !fs::is_regular_file(path)) return "";
  std::ifstream f(path);
  std::string line;
  for (int i = 1; std::getline(f, line); ++i) {
    if (i != lineno) continue;
    while (!line.empty() && (line.back() == '\r' || line.back() == '\n' ||
                             line.back() == ' ' || line.back() == '\t'))
      line.pop_back();
    auto s = line.find_first_not_of(" \t");
    return (s != std::string::npos) ? line.substr(s) : line;
  }
  return "";
}

// Symbol lookups (delegate to elf_syms; the ELF is small and OS-page-cached).
std::string sym_at(const std::string& elf, uint64_t pc) {
  std::string s = symbolize(elf, pc);
  if (!s.empty()) return s;
  char buf[20];
  std::snprintf(buf, sizeof(buf), "0x%llx", (unsigned long long)pc);
  return buf;
}

std::string sym_func_at(const std::string& elf, uint64_t pc) {
  std::string s = symbolize(elf, pc);
  auto p = s.find('+');
  return (p != std::string::npos) ? s.substr(0, p) : s;
}

// Fill one loop's LoopSyms from the ELF + the resolved source map.
LoopSyms make_syms(const std::string& elf, uint64_t start, uint64_t end,
                   const std::map<uint64_t, std::string>& src_map) {
  LoopSyms s;
  s.sym_start = sym_at(elf, start);
  s.sym_end = sym_at(elf, end);
  s.fn_name = sym_func_at(elf, start);
  auto [fe, fx] = fn_range(elf, start);
  s.fn_entry = fe;
  s.fn_end = fx;
  if (auto it = src_map.find(start); it != src_map.end()) s.src_start = it->second;
  if (auto it = src_map.find(end); it != src_map.end()) s.src_end = it->second;
  auto [path, lineno] = parse_file_line(s.src_start);
  s.code_snippet = read_source_line(path, lineno);
  return s;
}

// A "" -> `def` positive-int knob (--limit, --min-iters).
bool parse_knob(const std::string& v, int def, int& out) {
  if (v.empty()) {
    out = def;
    return true;
  }
  try {
    size_t pos = 0;
    out = std::stoi(v, &pos);
    return pos == v.size() && out > 0;
  } catch (...) {
    return false;
  }
}

// mkdtemp workdir holding the staged qemu.cfg + the plugin log; removed on
// scope exit (the report is the product; there is nothing to keep).
struct Workdir {
  std::string path;
  std::string error;
  Workdir() {
    char tmpl[] = "/tmp/andesim-profile.XXXXXX";
    if (::mkdtemp(tmpl))
      path = tmpl;
    else
      error = "cannot create the profile workdir under /tmp";
  }
  ~Workdir() {
    if (path.empty()) return;
    std::error_code ec;
    fs::remove_all(path, ec);
  }
};

