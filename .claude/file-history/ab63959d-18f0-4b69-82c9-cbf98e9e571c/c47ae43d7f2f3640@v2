// Profile core -- the pure logic behind `andesim profile` (hot inner-loop
// detection via the hotIterationLoop TCG plugin).
//
// Everything here is data-in/data-out: plugin-log text -> loop edges,
// objdump text -> a disassembly map, filters/nesting on plain structs, and
// renderers that RETURN the report as a string. All process IO (QEMU spawn,
// objdump/addr2line, ELF symbolization) stays in cmd_profile.cpp, which
// precomputes per-loop symbol/source strings into LoopSyms so the renderers
// need no filesystem access -- that is what makes them unit-testable.
#ifndef ANDESIM_PROFILE_HPP
#define ANDESIM_PROFILE_HPP

#include <cstdint>
#include <map>
#include <string>
#include <utility>
#include <vector>

namespace andes_sim {

// One backward edge observed by the plugin: header pc, tail pc, iterations.
struct LoopEdge {
  uint64_t start = 0;
  uint64_t end = 0;
  uint64_t iters = 0;
};

// One disassembled instruction (objdump -d --no-show-raw-insn).
struct InsnInfo {
  std::string mnemonic;
  std::string operands;
};
using Disasm = std::map<uint64_t, InsnInfo>;

struct RvvInsn {
  uint64_t pc;
  std::string mn, ops;
};
struct CallInsn {
  uint64_t pc;
  std::string mn, target;
};

// A loop after nesting: parent/children reference loops in the SAME vector by
// index (-1 = top-level), so the vector stays copyable.
struct Loop {
  std::string id;  // "L1".."Ln", hottest first
  uint64_t start = 0, end = 0, iters = 0;
  int parent = -1;
  std::vector<int> children;
};

// Per-loop symbol/source strings, precomputed by the caller (ELF + addr2line
// IO) so the renderers stay pure. Empty string = unknown.
struct LoopSyms {
  std::string sym_start;     // "name+0xoff" or raw "0x<pc>" at loop.start
  std::string sym_end;       // same at loop.end
  std::string fn_name;       // bare function name at loop.start
  uint64_t fn_entry = 0;     // fn_range(loop.start); 0,0 = unknown
  uint64_t fn_end = 0;
  std::string src_start;     // full addr2line "path:line" at loop.start
  std::string src_end;       // same at loop.end
  std::string code_snippet;  // trimmed source text at src_start
};

// The plugin's `-d plugin -D <file>` log -> edges. Header/garbage lines are
// skipped; rows are `0x<start>, 0x<end>, <iters>`.
std::vector<LoopEdge> parse_plugin_log(const std::string& text);

// `objdump -d --no-show-raw-insn` text -> pc-keyed instruction map. Works for
// both GNU and LLVM objdump; label lines carry no colon-after-hex and drop out.
Disasm parse_disasm(const std::string& raw);

// RVV mnemonic heuristic: 'v' followed by a letter (vadd.vv, vsetvli, ...).
bool is_rvv(const std::string& mnemonic);

// The RVV / call instructions inside [s, e] (inclusive).
std::vector<RvvInsn> rvv_in_range(const Disasm& disasm, uint64_t s, uint64_t e);
std::vector<CallInsn> calls_in_range(const Disasm& disasm, uint64_t s,
                                     uint64_t e);

// Drop rows below min_iters (and, when rvv_only, rows whose body holds no RVV
// instruction), sort by iterations desc, truncate to limit.
std::vector<LoopEdge> filter_loops(std::vector<LoopEdge> rows, int min_iters,
                                   bool rvv_only, const Disasm& disasm,
                                   int limit);

// Assign ids L1..Ln (row order; rows arrive hottest-first) and compute
// nesting: parent = the smallest strictly-enclosing range (identical ranges
// excluded), children = the inverse.
std::vector<Loop> build_loops(const std::vector<LoopEdge>& rows, int limit);

// The `measure:` window's end: the last disassembled pc inside
// [fn_entry, fn_end), falling back to fn_end - 4 when the disasm has none.
uint64_t measure_ret_pc(const Disasm& disasm, uint64_t fn_entry,
                        uint64_t fn_end);

// "path:line[ extra]" -> "basename:line[ extra]".
std::string src_basename(const std::string& s);

// "path:line[:col]" -> {path, line}; {"", 0} for empty / "??" strings.
std::pair<std::string, int> parse_file_line(const std::string& s);

// The LLM-ready Markdown report. `loops` must be non-empty; `syms` is
// parallel to `loops`; `target_name` is the ELF basename shown as target:.
std::string render_llm(const std::vector<Loop>& loops,
                       const std::vector<LoopSyms>& syms, uint64_t total_iters,
                       const std::string& target_name, const Disasm& disasm,
                       int min_iters, bool rvv_filter);

// The plain aligned table. `syms` is parallel to `rows`; the source column
// appears only when some row has source info.
std::string render_table(const std::vector<LoopEdge>& rows,
                         const std::vector<LoopSyms>& syms, int min_iters,
                         bool rvv_filter);

// Everything the QEMU launch needs, resolved by the caller (engine registry,
// --print-qemu-config probe, CLI flags). Empty mem_size/readconfig omit the
// corresponding args.
struct ProfileQemuArgs {
  std::string qemu_bin;
  std::string plugin_so;
  std::string log_path;  // -d plugin -D <log_path>
  int limit = 50;
  int min_iters = 1;
  std::string cpu;  // full -cpu value, e.g. "andes-ax45mpv,vlen=512"
  std::string mem_size;
  std::string readconfig;
  std::string elf;
  std::vector<std::string> passthrough;  // extra QEMU args, verbatim
};

// The full qemu-system argv for one profile run.
std::vector<std::string> profile_qemu_argv(const ProfileQemuArgs& a);

}  // namespace andes_sim

#endif  // ANDESIM_PROFILE_HPP
