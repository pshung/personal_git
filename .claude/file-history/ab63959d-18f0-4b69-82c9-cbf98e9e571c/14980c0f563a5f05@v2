// Repo-root discovery for andesim.
//
// The driver shells out to repo scripts (scripts/build_*.sh), reads fixtures
// (tests/fixtures/), and scans the engines dir -- all relative to the repo
// root. The root is found from the executable's own location via
// /proc/self/exe, so it works regardless of the caller's CWD and for both
// layouts: build/andesim during development and a repo-root andesim after
// the F14 swap.
#ifndef ANDESIM_REPO_ROOT_HPP
#define ANDESIM_REPO_ROOT_HPP

#include <climits>
#include <filesystem>
#include <stdexcept>
#include <string>

#include <unistd.h>

namespace andes_sim {

// Absolute path to this executable, resolved through /proc/self/exe.
inline std::filesystem::path exe_path() {
  char buf[PATH_MAX];
  ssize_t n = ::readlink("/proc/self/exe", buf, sizeof(buf) - 1);
  if (n < 0) throw std::runtime_error("readlink(/proc/self/exe) failed");
  buf[n] = '\0';
  return std::filesystem::path(buf);
}

// Nearest ancestor of the executable that looks like this repo's root,
// identified by two stable markers that travel together: the setup.sh build
// entry point and the shared ABI header. Throws if no such ancestor exists.
inline std::filesystem::path repo_root() {
  namespace fs = std::filesystem;
  // Pure function of /proc/self/exe and the on-disk layout, both stable for the
  // life of the process, so compute it once. (If discovery fails the throwing
  // initializer just re-runs on the next call.)
  static const fs::path root = [] {
    fs::path start = exe_path().parent_path();
    for (fs::path p = start;; p = p.parent_path()) {
      if (fs::exists(p / "setup.sh") &&
          fs::exists(p / "include" / "hybrid" / "state_abi.h"))
        return p;
      if (p == p.root_path()) break;
    }
    throw std::runtime_error("repo root not found above " + start.string());
  }();
  return root;
}

// The bundled QEMU plugins' default locations under the repo root -- the
// single source for the in-repo paths. Callers that honor a $VSIM_PLUGIN
// override apply it themselves (cmd_doctor's artifact table, run_plan's
// resolve_plugin).
inline std::filesystem::path default_plugin_path() {
  return repo_root() / "qemu_plugin" / "libhybrid_handoff.so";
}

// The hot-loop detector plugin `andesim profile` loads.
inline std::filesystem::path profile_plugin_path() {
  return repo_root() / "qemu_plugin" / "libhotIterationLoop.so";
}

}  // namespace andes_sim

#endif  // ANDESIM_REPO_ROOT_HPP
