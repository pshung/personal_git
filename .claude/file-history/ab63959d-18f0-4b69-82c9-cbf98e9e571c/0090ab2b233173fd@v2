// Placeholder substitution for engine invoke templates (minus QEMU2). The
// argv *shape* lives in each engine's `invoke` template (from
// `--describe`, see docs/engine_interface.md) and build_argv fills the
// {placeholders} from a context map. The framework thus keeps zero per-engine
// argv code: a new engine ships its own template.
#ifndef ANDESIM_ARGV_HPP
#define ANDESIM_ARGV_HPP

#include <cctype>
#include <cstdio>
#include <cstring>
#include <map>
#include <string>
#include <vector>

namespace andes_sim {

// POSIX shell-quote one arg so a rendered command line is copy-pasteable. A
// token of only safe characters passes through; anything else (empty, spaces,
// quotes, globs) is wrapped in single quotes with embedded `'` escaped as
// '\''. Used by render_argv for the --dry-run command preview.
inline std::string shell_quote(const std::string& s) {
  if (!s.empty()) {
    bool safe = true;
    for (char c : s)
      if (!std::isalnum(static_cast<unsigned char>(c)) &&
          !std::strchr("_@%+=:,./-", c)) {
        safe = false;
        break;
      }
    if (safe) return s;
  }
  std::string out = "'";
  for (char c : s) out += (c == '\'') ? "'\\''" : std::string(1, c);
  out += "'";
  return out;
}

// Join an argv into one shell-quoted line (each token via shell_quote).
inline std::string render_argv(const std::vector<std::string>& argv) {
  std::string out;
  for (size_t i = 0; i < argv.size(); ++i) {
    if (i) out += ' ';
    out += shell_quote(argv[i]);
  }
  return out;
}

// Print the dry-run preview: the exact command(s) andesim WOULD spawn, each
// shell-quoted and labeled, executing nothing. Shared by run and profile so
// the preview format is identical; `labels[i]` annotates `argvs[i]` (e.g.
// "standalone [qemu64]", "profile [vsim:x]"). Always returns 0 -- a dry run
// reports the plan, it does not run it.
inline int print_dry_run(const std::vector<std::vector<std::string>>& argvs,
                         const std::vector<std::string>& labels) {
  std::printf("[andesim] dry-run: %zu command(s), not executed\n", argvs.size());
  for (size_t i = 0; i < argvs.size(); ++i) {
    std::printf("# command %zu/%zu: %s\n", i + 1, argvs.size(),
                labels[i].c_str());
    std::printf("%s\n", render_argv(argvs[i]).c_str());
  }
  return 0;
}

// Substitute every "{key}" in `tmpl`'s args with `ctx.at(key)`. A key may
// appear anywhere in an arg (so "mem-path={mmap},size={mmap_size}" expands in
// one arg) and more than once. Recognised keys come from `ctx`; a "{key}" with
// no matching ctx entry is an error (returns {} and sets `err`). On success
// `err` is cleared and the fully-resolved argv is returned.
std::vector<std::string> build_argv(const std::vector<std::string>& tmpl,
                                    const std::map<std::string, std::string>& ctx,
                                    std::string& err);

}  // namespace andes_sim

#endif  // ANDESIM_ARGV_HPP
