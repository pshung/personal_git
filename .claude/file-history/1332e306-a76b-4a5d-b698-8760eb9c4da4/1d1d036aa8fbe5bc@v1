{ system }:
let
  bsv = import ../default.nix;
  lib = bsv.lib;

  name =
    {
      "aarch64-linux" = "aarch64-linux-gnu";
      "x86_64-linux" = "x86_64-linux-gnu";
    }
    .${system};

  build = self;
  host = self;

  rockylinux_8_4 = bsv.legacyPackages.${system}.rockylinux_8_4;

  self = {
    recurseForDerivations = true;

    inherit name;

    libdir = "${self.prefix}/lib${self.libdirSuffix}";
    libdirSuffix = "64";
    prefix = "/usr/local";
    rustTarget =
      {
        "aarch64-linux" = "aarch64-unknown-linux-gnu";
        "x86_64-linux" = "x86_64-unknown-linux-gnu";
      }
      .${system};
    system = system;
    triple =
      {
        "aarch64-linux" = "aarch64-unknown-linux-gnu";
        "x86_64-linux" = "x86_64-pc-linux-gnu";
      }
      .${system};

    CC = "gcc";
    CXX = "g++";
    AR = "ar";
    STRIP = "strip";
    CFLAGS = "-O2 -fPIC";
    CXXFLAGS = self.CFLAGS;
    LDFLAGS = "-Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now";
    CPATH = "${self.prefix}/include:/usr/include";
    EXEEXT = "";
    LIBRARY_PATH = "${self.libdir}:/usr/lib64";
    PATH = "/usr/local/bin:/usr/bin:/bin";
    PKG_CONFIG_PATH = "${self.libdir}/pkgconfig:/usr/lib64/pkgconfig";

    ca-certificates = lib.bwrapDerivation {
      name = "${self.system}.${self.name}.ca-certificates";

      root = [ rockylinux_8_4.docker-image ];

      env = rockylinux_8_4.docker-image.env;

      builder = lib.bashBuilder ''
        mkdir --parents $out/etc
        cp --archive ${rockylinux_8_4.docker-image}/etc/{pki,ssl} $out/etc
      '';

      system = self.system;
    };

    gconv-modules = lib.bwrapDerivation {
      name = "${self.system}.${self.name}.gconv-modules";

      root = [ rockylinux_8_4.docker-image ];

      env = rockylinux_8_4.docker-image.env;

      builder = lib.bashBuilder ''
        mkdir --parents $out/usr/lib64/gconv
        cp --archive ${rockylinux_8_4.docker-image}/usr/lib64/gconv/. $out/usr/lib64/gconv
      '';

      system = self.system;
    };

    glibc-devel = lib.bwrapDerivation {
      name = "${self.system}.${self.name}.glibc-devel";

      root = [ rockylinux_8_4.docker-image ];

      env = rockylinux_8_4.docker-image.env;

      builder = lib.bashBuilder ''
        rpm --install --verbose ${rockylinux_8_4.rpms.cpio}

        mkdir --parents $out && cd $out

        rpm2cpio ${rockylinux_8_4.rpms.glibc-devel} | cpio --extract --make-directories --verbose
        rpm2cpio ${rockylinux_8_4.rpms.glibc-headers} | cpio --extract --make-directories --verbose
        rpm2cpio ${rockylinux_8_4.rpms.glibc-static} | cpio --extract --make-directories --verbose
        rpm2cpio ${rockylinux_8_4.rpms.kernel-headers} | cpio --extract --make-directories --verbose

        rm --recursive --force $out/usr/share
      '';

      system = self.system;
    };

    libxcrypt = lib.bwrapDerivation {
      name = "${self.system}.${self.name}.libxcrypt";

      root = [ rockylinux_8_4.docker-image ];

      env = rockylinux_8_4.docker-image.env;

      builder = lib.bashBuilder ''
        rpm --install --verbose ${rockylinux_8_4.rpms.cpio}

        mkdir --parents $out && cd $out

        rpm2cpio ${rockylinux_8_4.rpms.libxcrypt} | cpio --extract --make-directories --verbose
        rpm2cpio ${rockylinux_8_4.rpms.libxcrypt-devel} | cpio --extract --make-directories --verbose
        rpm2cpio ${rockylinux_8_4.rpms.libxcrypt-static} | cpio --extract --make-directories --verbose

        mv $out/lib64/libcrypt.{a,so,so.1,so.1.1.0} $out/usr/lib64/
        rm --recursive --force $out/lib64
        rm --recursive --force $out/usr/share
      '';

      system = self.system;
    };

    libz = lib.bwrapDerivation {
      name = "${self.system}.${self.name}.libz";

      root = [ rockylinux_8_4.docker-image ];

      env = rockylinux_8_4.docker-image.env;

      builder = lib.bashBuilder ''
        rpm --install --verbose ${rockylinux_8_4.rpms.cpio}

        rpm2cpio ${rockylinux_8_4.rpms.zlib} | cpio --extract --make-directories --verbose

        install -Dm755 usr/lib64/libz.so.1 $out/usr/lib64/libz.so.1
      '';

      system = self.system;
    };

    stage0 = {
      name = "${self.name}.stage0";

      inherit (self)
        libdir
        libdirSuffix
        prefix
        system
        triple
        CC
        CXX
        CFLAGS
        CXXFLAGS
        LDFLAGS
        PATH
        ;

      stdenv-minimal = rockylinux_8_4.mkImage {
        name = "${system}.${self.stage0.name}.stdenv-minimal";
        rpms = rockylinux_8_4.minimalRpms;
      };

      stdenv-nocc = rockylinux_8_4.mkImage {
        name = "${system}.${self.stage0.name}.stdenv-nocc";
        rpms = rockylinux_8_4.minimalRpms ++ rockylinux_8_4.stdenvNoCCRpms;
      };

      stdenv-base = rockylinux_8_4.mkImage {
        name = "${system}.${self.stage0.name}.stdenv-base";
        rpms = rockylinux_8_4.minimalRpms ++ rockylinux_8_4.glibcDevelRpms ++ rockylinux_8_4.coreutilsRpms;
      };

      stdenv = rockylinux_8_4.mkImage {
        name = "${system}.${self.stage0.name}.stdenv";
        rpms = rockylinux_8_4.minimalRpms ++ rockylinux_8_4.stdenvRpms;
      };

      binutils = import ./binutils/default.nix {
        inherit bsv;
        build = self.stage0;
        host = self.stage0;
        target = self;
      };

      m4 = import ./m4/default.nix {
        inherit bsv;
        build = self.stage0;
      };

      gmp = import ./gmp/default.nix {
        inherit bsv;
        build = self.stage0;
      };

      mpfr = import ./mpfr/default.nix {
        inherit bsv;
        build = self.stage0;
      };

      mpc = import ./mpc/default.nix {
        inherit bsv;
        build = self.stage0;
      };

      isl = import ./isl/default.nix {
        inherit bsv;
        build = self.stage0;
      };
    };

    gcc = import ./gcc/default.nix {
      inherit bsv;
      build = self.stage0;
      host = self;
      target = self;
    };

    stage1 = {
      name = "${self.name}.stage1";

      inherit (self)
        libdir
        libdirSuffix
        prefix
        system
        triple
        CC
        CXX
        CFLAGS
        CXXFLAGS
        LDFLAGS
        PATH
        ;

      stdenv-nocc = self.stage0.stdenv-nocc;

      "${self.name}-toolchain" = lib.strictUnion {
        name = "${self.system}.${self.stage1.name}.x86_64-linux-gnu-toolchain";
        paths = [
          self.stage0.binutils
          self.gcc
          self.glibc-devel
        ];
      };

      stdenv = lib.strictUnion {
        name = "${self.system}.${self.stage1.name}.stdenv";
        paths = [
          self.stage1.stdenv-nocc
          self.stage1."${self.name}-toolchain"
        ];
      };
    };

    binutils = import ./binutils/default.nix {
      inherit bsv;
      build = self.stage1;
      host = self;
    };

