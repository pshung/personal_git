    stdenv-base = rockylinux_8_4.mkImage {
      name = "${self.system}.${self.name}.stdenv-base";
      rpms = rockylinux_8_4.onlyGlibcRpms;

      postCommand = ''
        ln --symbolic --force "$(realpath --canonicalize-missing --relative-to /usr/bin ${self.prefix}/bin/bash)" $out/usr/bin/sh
        ln --symbolic --force "$(realpath --canonicalize-missing --relative-to /usr/bin ${self.prefix}/bin/env)" $out/usr/bin/env
      '';
    };

    stdenv-nocc = lib.strictUnion {
      name = "${self.system}.${self.name}.stdenv-nocc";
      paths = [
        self.stdenv-base
        self.bash
        self.bzip2
        self.coreutils
        self.diffutils
        self.findutils
        self.gawk
        self.grep
        self.gzip
        self.make
        self.ncurses
        self.patch
        self.readline
        self.sed
        self.tar
        self.xz
      ];

      unsafeDiscardReferences.out = true;
    };

    "${name}-toolchain" = lib.strictUnion {
      name = "${self.system}.${self.name}.${self.name}-toolchain";
      paths = [
        self.binutils
        self.gcc
        self.glibc-devel
      ];
    };

    stdenv = lib.strictUnion {
      name = "${self.system}.${self.name}.stdenv";

      paths = [
        self.stdenv-nocc
        self.binutils
        self.gcc
        self.glibc-devel
