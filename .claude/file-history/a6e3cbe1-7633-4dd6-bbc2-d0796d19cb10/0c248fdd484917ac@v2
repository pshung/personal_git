#!/usr/bin/env bash
# cc.sh -- cyclomatic complexity of C/C++ functions.
#
# Usage:
#   tools/cc.sh <file> [function-pattern]
#
#   tools/cc.sh src/hybrid/resume_driver.hpp
#   tools/cc.sh src/hybrid/resume_driver.hpp resume
#   tools/cc.sh src/hybrid/state_drain.hpp 'drain_.*ext'
#
# function-pattern is a case-insensitive regex on the function name; omit it to
# list every function, sorted by complexity descending.
#
# Needs: pip install lizard
set -uo pipefail

[ $# -ge 1 ] || { sed -n '2,13p' "${BASH_SOURCE[0]}"; exit 2; }
[ -f "$1" ] || { echo "cc.sh: no such file: $1" >&2; exit 2; }

FILE="$1" PATTERN="${2:-}" python3 - <<'PY'
import os, re, sys
import lizard

path, pattern = os.environ["FILE"], os.environ["PATTERN"]
rx = re.compile(pattern, re.IGNORECASE) if pattern else None

fns = [f for f in lizard.analyze_file(path).function_list
       if rx is None or rx.search(f.name)]
if not fns:
    print(f"cc.sh: no function matches '{pattern}' in {path}", file=sys.stderr)
    sys.exit(1)

fns.sort(key=lambda f: -f.cyclomatic_complexity)
print(f"{'CC':>4} {'NLOC':>5} {'params':>6}  {'lines':>13}  function")
print("-" * 78)
for f in fns:
    span = f"{f.start_line}-{f.end_line}"
    print(f"{f.cyclomatic_complexity:>4} {f.nloc:>5} {f.parameter_count:>6}  {span:>13}  {f.name}")
print("-" * 78)
print(f"{len(fns)} function(s) in {path}")
PY
