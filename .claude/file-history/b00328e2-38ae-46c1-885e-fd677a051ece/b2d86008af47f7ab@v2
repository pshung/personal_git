#!/usr/bin/env bash
# Does fast mode actually USE more than 2 GiB? --mem-size 3G, and deliberately
# NO --no-mmap so the run needs ~2030 MiB -- i.e. it can only succeed if the
# extended DRAM window is reachable. Prediction from mm.c:38 (g_mmap_top =
# mem_size - 8MiB, a flat map from address 0): the mmap arena lands at
# 0xBF800000 which is unmapped device/hole space in AE350, so this should fault
# or garbage, NOT work.
export TMPDIR=/home/nick/tmp
LLAMA=/home/nick/work/llama.cpp
ANDESIM=/home/nick/work/andesim

cd "$ANDESIM" || exit 1
./andesim run --mode fast --runtime linux --mem-size 3G \
  --engine vsim:ax46mpv_fpga_l3 "$LLAMA/bin-prefetch" -- \
  -m "$LLAMA/models/Bonsai-8B-Q1_0.gguf" -no-cnv \
  --prompt "The capital of France is" -n 4 -c 512 -t 1 --temp 0
echo "FAST3G: exited $?"
