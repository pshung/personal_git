#!/usr/bin/env bash
# Wait for bin-prefetch, then run Bonsai-8B under andesim fast mode.
# Gate for the hybrid cycle measurement: does 8B fit the 2 GiB guest RAM and
# produce correct text?
export TMPDIR=/home/nick/tmp
LLAMA=/home/nick/work/llama.cpp
ANDESIM=/home/nick/work/andesim
MODEL=$LLAMA/models/Bonsai-8B-Q1_0.gguf
ENGINE=vsim:ax46mpv_fpga_l3

for i in $(seq 1 180); do
  [ -f "$LLAMA/bin-prefetch" ] && break
  sleep 10
done
if [ ! -f "$LLAMA/bin-prefetch" ]; then
  echo "GATE-FAIL: bin-prefetch never appeared (build failed?)"
  exit 1
fi
echo "GATE: bin-prefetch ready, starting fast mode 8B"

cd "$ANDESIM" || exit 1
./andesim run --mode fast --runtime linux --mem-size 2G \
  --engine "$ENGINE" "$LLAMA/bin-prefetch" -- \
  -m "$MODEL" -no-cnv --prompt "The capital of France is" \
  -n 8 -c 512 -t 1 --temp 0
echo "GATE: fast mode exited $?"
