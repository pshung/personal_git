#!/usr/bin/env bash
# 8B fast-mode gate, attempt 2: --no-mmap so the file mapping and the
# CPU_REPACK buffer do not both occupy guest RAM.
export TMPDIR=/home/nick/tmp
LLAMA=/home/nick/work/llama.cpp
ANDESIM=/home/nick/work/andesim
MODEL=$LLAMA/models/Bonsai-8B-Q1_0.gguf
ENGINE=vsim:ax46mpv_fpga_l3

cd "$ANDESIM" || exit 1
./andesim run --mode fast --runtime linux --mem-size 2G \
  --engine "$ENGINE" "$LLAMA/bin-prefetch" -- \
  -m "$MODEL" -no-cnv --no-mmap --prompt "The capital of France is" \
  -n 8 -c 512 -t 1 --temp 0
echo "GATE2: fast mode exited $?"
