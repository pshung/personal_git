#!/usr/bin/env bash
# Bonsai-8B hybrid cycle measurement, ROI = MUL_MAT #51 = blk.7.attn_v.weight
# [4096 x 1024] (the 8B twin of the 4B [2560 x 1024] baseline node).
# --no-mmap is REQUIRED: with mmap the file mapping and the CPU_REPACK buffer
# both sit in guest RAM (1099 + 931 MiB) and blow the 2 GiB cap.
#   $1 = variant suffix (prefetch | baseline), default prefetch
export TMPDIR=/home/nick/tmp
LLAMA=/home/nick/work/llama.cpp
ANDESIM=/home/nick/work/andesim
MODEL=$LLAMA/models/Bonsai-8B-Q1_0.gguf
ENGINE=vsim:ax46mpv_fpga_l3
V=${1:-prefetch}

cd "$ANDESIM" || exit 1
./andesim run --mode hybrid --trigger marker --runtime linux --mem-size 2097148K \
  --engine "$ENGINE" --step-timeout-ms 14400000 "$LLAMA/bin-$V" -- \
  -m "$MODEL" -no-cnv --no-mmap --prompt "The capital of France is" \
  -n 8 -c 512 -t 1
echo "HYBRID-$V: exited $?"
