#!/usr/bin/env bash
# Same idea as llama.cpp/verify.sh but for the d4 A/B: prefetch vs d4 must
# generate byte-identical text under andesim fast mode (greedy).
set -e
export TMPDIR=${TMPDIR:-/home/nick/tmp}
LLAMA=/home/nick/work/llama.cpp
ANDESIM=/home/nick/work/andesim
MODEL=$LLAMA/models/Bonsai-4B-Q1_0.gguf
ENGINE=vsim:ax46mpv_fpga_l3
PROMPT="The capital of France is"

gen() {
  ( cd "$ANDESIM" && ./andesim run --mode fast --runtime linux --mem-size 2000M \
      --engine "$ENGINE" "$1" -- -m "$MODEL" -no-cnv \
      --prompt "$PROMPT" -n 16 -c 512 -t 1 --temp 0 ) 2>&1 \
    | grep "$PROMPT" | head -1
}
P=$(gen "$LLAMA/bin-prefetch")
D=$(gen "$LLAMA/bin-d4")
echo "PREFETCH: $P"
echo "D4      : $D"
[ -n "$P" ] && [ "$P" = "$D" ] && echo "PASS: d4 output is bit-identical to the shipped kernel" \
  || { echo "FAIL: outputs differ (or empty)"; exit 1; }
