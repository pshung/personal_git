// Minimal Q1_0 x Q8_0 kernel set:
//   1. q1_0_dot_scalar   - scalar reference (the judge, always correct)
//   2. q1_0_dot_vl256    - ORIGINAL production RVV kernel (per-row vec_dot,
//                          vwredsum + vmv.x.s per 32-group)
//   3. q1_0_gemv_64x1    - OPTIMIZED row-parallel kernel (F4b): 64 rows in
//                          the lanes, zero reductions, needs repacked weights
//   4. q1_0_gemm_64x1    - GEMM (F4c): M activation rows at once; each sign
//                          mask is loaded once and reused for all M
// plus the one-time weight repack the optimized kernels eat.
//
// Full multi-VLEN harness lives in llama.cpp/kernel-lab/. This is the slim
// vsim shootout copy.
#pragma once

#include <stdint.h>
#include <stddef.h>

#define QK1_0 128
#define QK8_0 32

typedef uint16_t ggml_half;

typedef struct {
    ggml_half d;                // scale
    uint8_t   qs[QK1_0 / 8];   // 128 sign bits: 1 -> +d, 0 -> -d
} block_q1_0;

typedef struct {
    ggml_half d;                // scale
    int8_t    qs[QK8_0];        // quants in [-127, 127]
} block_q8_0;

// 64 rows x 128 cols, sign planes column-major: qs[c] = column c's 64 bits,
// one per row -> one vlm mask load. Same bytes as 64 block_q1_0, transposed.
#define Q1_NX1_N 64

typedef struct {
    ggml_half d[Q1_NX1_N];
    uint8_t   qs[QK1_0][Q1_NX1_N / 8];
} block_q1_0_64x1;

_Static_assert(sizeof(block_q1_0)      == 18,                            "q1_0 block size");
_Static_assert(sizeof(block_q1_0_64x1) == Q1_NX1_N * sizeof(block_q1_0), "repack keeps size");

float    lab_fp16_to_fp32(uint16_t h);
uint16_t lab_fp32_to_fp16(float f);

// 1. scalar reference: one row dot, n = K (multiple of 128)
void q1_0_dot_scalar(int n, float * s, const block_q1_0 * x, const block_q8_0 * y);

// 2. original kernel: same job, production RVV (VLEN >= 256)
void q1_0_dot_vl256(int n, float * s, const block_q1_0 * x, const block_q8_0 * y);

// weights for kernel 3: nr rows (multiple of 64) -> (nr/64)*(n/128) bricks
void q1_0_repack_64x1(const block_q1_0 * src, block_q1_0_64x1 * dst, int nr, int n);

// 3. optimized kernel: s[0..nr-1] = all row dots at once (VLEN >= 512:
//    i16 m2 / f32 m4 -> 64 lanes exactly full on VLEN=512)
void q1_0_gemv_64x1(int n, float * s, const block_q1_0_64x1 * bricks, const block_q8_0 * y, int nr);

// 4. GEMM: M activation rows against the same bricks. y = M contiguous
//    activation rows (n/QK8_0 blocks each), s = M rows of nr floats.
//    M-tile is a register-budget build constant: 4 at Q1_VLEN>=1024, 2 at 512
//    (M must be a multiple of it).
void q1_0_gemm_64x1(int n, int M, float * s, const block_q1_0_64x1 * bricks, const block_q8_0 * y, int nr);

// ---- 5. nds.vd4dots variant (xandesvdot) ----------------------------------
// Same row-parallel idea, different sign-bit order. vd4dots consumes 4 int8
// weights per i32 lane, so a lane (= a row) must hold 4 CONSECUTIVE columns,
// not one column of 64 rows. Sign plane is therefore grouped by 4 columns:
// bit index (4*row + colofs) inside a 32-byte plane -> one vlm + one vmerge
// builds the +-1 int8 operand. Same total bytes as block_q1_0_64x1.
typedef struct {
    ggml_half d[Q1_NX1_N];
    uint8_t   qs[QK1_0 / 4][Q1_NX1_N * 4 / 8];
} block_q1_0_64d4;

_Static_assert(sizeof(block_q1_0_64d4) == Q1_NX1_N * sizeof(block_q1_0), "d4 repack keeps size");

void q1_0_repack_64d4(const block_q1_0 * src, block_q1_0_64d4 * dst, int nr, int n);

// same output as q1_0_gemv_64x1, computed with nds.vd4dots.vv (VLEN >= 1024)
// ya = the same activation quants as y[].qs, but in one contiguous 4-byte
// aligned array (n bytes). Needed because vd4dots eats 4 activations per lane
// and this core traps on a misaligned 32-bit vector element load, while
// block_q8_0.qs always sits at offset 2. A real kernel gets this for free from
// the activation quantize step; only the scales still come from y[].d.
void q1_0_gemv_64d4(int n, float * s, const block_q1_0_64d4 * bricks, const block_q8_0 * y, const int8_t * ya, int nr);

// same kernel, hand-scheduled: one asm block per 16 columns, 2 accumulators
void q1_0_gemv_64d4_v2(int n, float * s, const block_q1_0_64d4 * bricks, const block_q8_0 * y, const int8_t * ya, int nr);

// isolation variants (see q1_0_d4.c): v3 = v2 with lw+vmv.v.x broadcast;
// nodot = v3 with the dot replaced by vadd (WRONG results, timing only)
void q1_0_gemv_64d4_v3(int n, float * s, const block_q1_0_64d4 * bricks, const block_q8_0 * y, const int8_t * ya, int nr);
void q1_0_gemv_64d4_nodot(int n, float * s, const block_q1_0_64d4 * bricks, const block_q8_0 * y, const int8_t * ya, int nr);
