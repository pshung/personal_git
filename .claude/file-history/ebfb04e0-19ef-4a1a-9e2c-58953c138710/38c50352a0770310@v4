  function rng(seed) {
    var s = seed >>> 0;
    return function () {
      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }

  /* ---- lane grids ---- */
  document.querySelectorAll("[data-rows]").forEach(function (el) {
    var rows = +el.dataset.rows, cols = +el.dataset.cols;
    var rnd = rng(+el.dataset.seed || 1);
    var cw = 13, chh = 4;
    el.style.gridTemplateColumns = "repeat(" + cols + ", " + cw + "px)";
    el.style.gridAutoRows = chh + "px";
    var mode = el.dataset.hl, hs = +el.dataset.hlStart, sp = +el.dataset.hlSpan || 1;
    var frag = document.createDocumentFragment();
    for (var r = 0; r < rows; r++) {
      for (var c = 0; c < cols; c++) {
        var d = document.createElement("span");
        var on = mode === "col" ? (c >= hs && c < hs + sp) : (r >= hs && r < hs + sp);
        d.className = "c " + (rnd() > 0.5 ? "p" : "m") + (on ? " on" : "");
        frag.appendChild(d);
      }
    }
    el.appendChild(frag);

    var hl = document.createElement("span");
    hl.className = "hl a";
    var tag = document.createElement("span");
    tag.className = "hl-tag";
    tag.textContent = el.dataset.hlTag || "";

    if (mode === "col") {
      hl.style.left = (hs * cw - 1) + "px";
      hl.style.top = "-1px";
      hl.style.width = (sp * cw + 2) + "px";
      hl.style.height = (rows * chh + 2) + "px";
      tag.style.left = ((hs + sp) * cw + 8) + "px";
      tag.style.top = "2px";
    } else {
      hl.style.left = "-1px";
      hl.style.top = (hs * chh - 1) + "px";
      hl.style.width = (cols * cw + 2) + "px";
      hl.style.height = (sp * chh + 2) + "px";
      tag.style.left = "0";
      tag.style.top = (hs * chh + 12) + "px";
    }
    el.style.position = "relative";
    el.appendChild(hl);
    el.appendChild(tag);
  });

  /* ---- register strips ---- */
  document.querySelectorAll("[data-reg]").forEach(function (el) {
    var kind = el.dataset.reg;
    var n = +el.dataset.lanes || 0;
    var rnd = rng(+el.dataset.seed || 3);

    if (kind === "w" || kind === "a" || kind === "nib") {
      for (var i = 0; i < n; i++) {
        var lane = document.createElement("span");
        lane.className = "lane";
        var acts = ["-9", "24", "7", "-3"];
        for (var b = 0; b < 4; b++) {
          var cell = document.createElement("span");
          if (kind === "a") {
            cell.className = "b a";
            cell.textContent = acts[b];
          } else if (kind === "nib") {
            var one = rnd() > 0.5;
            cell.className = "b " + (one ? "p" : "m");
            cell.textContent = one ? "1" : "0";
          } else {
            var pos = rnd() > 0.5;
            cell.className = "b " + (pos ? "p" : "m");
            cell.textContent = pos ? "+1" : "-1";
          }
          lane.appendChild(cell);
        }
        el.appendChild(lane);
      }
    } else if (kind === "acc") {
      for (var j = 0; j < n; j++) {
        var l2 = document.createElement("span");
        l2.className = "lane acc";
        var c2 = document.createElement("span");
        c2.className = "b";
        c2.textContent = "row " + j;
        l2.appendChild(c2);
        el.appendChild(l2);
      }
    } else if (kind === "tile") {
      var labels = (el.dataset.labels || "").split(",");
      var wmul = +el.dataset.w || 1;
      var k = el.dataset.kind || "w";
      for (var t = 0; t < labels.length; t++) {
        var lt = document.createElement("span");
        lt.className = "lane" + (k === "acc" ? " acc" : "");
        var ct = document.createElement("span");
        ct.className = "b" + (k === "a" ? " a" : (k === "acc" ? "" : " p"));
        ct.style.width = (wmul * 50 + (wmul - 1) * 4 - 2) + "px";
        ct.textContent = labels[t];
        lt.appendChild(ct);
        el.appendChild(lt);
      }
    }
  });

  document.querySelectorAll("[data-collapse]").forEach(function (el) {
    var n = +el.dataset.collapse;
    for (var i = 0; i < n; i++) {
      var v = document.createElement("span");
      v.className = "v";
      el.appendChild(v);
    }
  });

  /* ---- ladder bars ---- */
  var rows = document.querySelectorAll(".lrow");
  function drawBars() {
    rows.forEach(function (r) {
      var frac = +r.dataset.cyc / +r.dataset.max;
      r.querySelector(".lbar").style.width = Math.max(frac * 100, 1.5) + "%";
    });
  }
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce) { drawBars(); } else { requestAnimationFrame(function () { setTimeout(drawBars, 120); }); }

  /* ---- reveal + scroll spy ---- */
  var secs = document.querySelectorAll("main .sec");
  var links = {};
  document.querySelectorAll(".nav a").forEach(function (a) { links[a.getAttribute("href").slice(1)] = a; });

  if ("IntersectionObserver" in window) {
    var spy = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        Object.keys(links).forEach(function (k) { links[k].classList.remove("on"); });
        var a = links[e.target.id];
        if (a) a.classList.add("on");
      });
    }, { rootMargin: "-15% 0px -75% 0px" });
    secs.forEach(function (s) { spy.observe(s); });
  }
})();
</script>
