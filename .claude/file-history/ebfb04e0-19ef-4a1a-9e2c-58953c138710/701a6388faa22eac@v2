// Minimal probe: does this machine execute nds.vd4dots.vv (XAndesVDot)?
// Expected: "vd4dots ok sum=496" (0*0+1*1+...+31*31 spread over 8 i32 lanes,
// here we only check lane 0 = 0*0+1*1+2*2+3*3 = 14).
#include <riscv_vector.h>

int printf(const char *, ...);

int main(void) {
    signed char w[64], a[64];
    for (int i = 0; i < 64; ++i) { w[i] = (signed char) i; a[i] = 1; }

    const size_t vl32 = 16;   // 16 i32 lanes = 64 bytes, fits m1 at VLEN>=512
    vint32m1_t acc = __riscv_vmv_v_x_i32m1(0, vl32);
    vint8m1_t  vw  = __riscv_vle8_v_i8m1(w, 64);
    vint8m1_t  va  = __riscv_vle8_v_i8m1(a, 64);

    asm volatile("vsetvli t0, zero, e32, m1, ta, ma\n\t"
                 "nds.vd4dots.vv %0, %1, %2"
                 : "+vr"(acc) : "vr"(vw), "vr"(va) : "t0");

    int out[16];
    __riscv_vse32_v_i32m1(out, acc, vl32);
    printf("vd4dots ok lane0=%d lane1=%d\n", out[0], out[1]);  // want 6 and 22
    return 0;
}
