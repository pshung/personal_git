#!/usr/bin/env python3
"""Inline the subsetted faces for the Summit proposal page and force pure ASCII."""
import base64, pathlib, re

HERE = pathlib.Path(__file__).parent
SRC = HERE / "summit.src.html"
OUT = HERE / "summit_proposal.html"

FACES = [
    ("GothicSub",   "gothic-bk.woff2", 400, "normal"),
    ("GothicSub",   "gothic-dm.woff2", 700, "normal"),
    ("CantSub",     "cant-r.woff2",    400, "normal"),
    ("CantSub",     "cant-b.woff2",    700, "normal"),
    ("AdwMonoSub",  "mono-r.woff2",    400, "normal"),
    ("AdwMonoSub",  "mono-b.woff2",    700, "normal"),
]

css = []
for family, fname, weight, style in FACES:
    b64 = base64.b64encode((HERE / "fonts2" / fname).read_bytes()).decode()
    css.append(
        '@font-face{font-family:"%s";font-style:%s;font-weight:%d;font-display:swap;'
        'src:url(data:font/woff2;base64,%s) format("woff2");}' % (family, style, weight, b64)
    )

html = SRC.read_text().replace("/*@FONTS@*/", "\n".join(css))

# The subset covers U+0020-007E only; anything outside it would silently fall
# back to another face. Keep &amp; &lt; &gt; - those are real markup escapes.
subs = [
    ("&nbsp;&bull;&nbsp;", "  |  "),
    ("&nbsp;&mdash;&nbsp;", " - "),
    (" &mdash; ", " - "),
    ("&mdash;", "-"),
    ("&bull;", "/"),
    ("&nbsp;&nbsp;", "  "),
    ("&nbsp;", " "),
]
for a, b in subs:
    html = html.replace(a, b)

OUT.write_text(html)

body = re.sub(r"src:url\(data:font/woff2;base64,[^)]*\)", "src:url(...)", html)
bad = sorted({c for c in body if ord(c) > 126 and c not in "\n\t"})
ents = sorted(set(re.findall(r"&[a-zA-Z][a-zA-Z0-9]+;", body)))
print("out:", OUT.name, f"{OUT.stat().st_size/1024:.0f} KB")
print("non-ascii:", bad or "none")
print("entities:", ents or "none")
