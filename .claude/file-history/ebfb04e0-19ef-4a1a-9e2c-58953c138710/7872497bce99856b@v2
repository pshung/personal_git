// Standalone timing of the Q1_0 repack inner loop, copied verbatim from
// ggml/src/ggml-cpu/repack.cpp:repack_q1_0_to_q1_0_64_bl so the measured work
// is the real work. Host x86 only - the point is ops/weight, not RISC-V cycles.
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <chrono>
#include <vector>

#define QK1_0 128
typedef uint16_t ggml_half;

struct block_q1_0   { ggml_half d;     uint8_t qs[QK1_0 / 8]; };
struct block_q1_0x64{ ggml_half d[64]; uint8_t qs[QK1_0][64 / 8]; };

static_assert(sizeof(block_q1_0x64) == 64 * sizeof(block_q1_0), "size");

template <bool D4> static inline int sign_bit(int c, int j) {
    return D4 ? (c / 4) * 256 + 4 * j + (c % 4)
              : c * 64 + j;
}

template <bool D4>
static void repack(block_q1_0x64 * dst, const block_q1_0 * src, int nrow, int nblocks) {
    memset(dst, 0, (size_t) (nrow / 64) * nblocks * sizeof(block_q1_0x64));
    for (int b = 0; b < nrow; b += 64) {
        block_q1_0x64 * out = dst + (size_t) (b / 64) * nblocks;
        for (int j = 0; j < 64; ++j) {
            const block_q1_0 * row = src + (size_t) (b + j) * nblocks;
            for (int ib = 0; ib < nblocks; ++ib) {
                out[ib].d[j] = row[ib].d;
                uint8_t * planes = (uint8_t *) out[ib].qs;
                for (int c = 0; c < QK1_0; ++c) {
                    const uint8_t bit = (row[ib].qs[c / 8] >> (c % 8)) & 1;
                    const int     bi  = sign_bit<D4>(c, j);
                    planes[bi / 8] |= (uint8_t) (bit << (bi % 8));
                }
            }
        }
    }
}

int main(int argc, char ** argv) {
    // one ffn_gate-sized tensor from Bonsai-4B: ne0=2560 (K), ne1=9728 (rows)
    const int ne0 = 2560, nrow = argc > 1 ? atoi(argv[1]) : 9728;
    const int nblocks = ne0 / QK1_0;
    const long long weights = (long long) ne0 * nrow;

    std::vector<block_q1_0>    src((size_t) nrow * nblocks);
    std::vector<block_q1_0x64> dst((size_t) (nrow / 64) * nblocks);
    for (size_t i = 0; i < src.size(); ++i) {
        src[i].d = 0x3C00;
        for (int k = 0; k < 16; ++k) src[i].qs[k] = (uint8_t) (i * 31 + k * 7);
    }

    for (int pass = 0; pass < 2; ++pass) {
        const bool d4 = pass == 1;
        auto t0 = std::chrono::steady_clock::now();
        if (d4) repack<true >(dst.data(), src.data(), nrow, nblocks);
        else    repack<false>(dst.data(), src.data(), nrow, nblocks);
        auto t1 = std::chrono::steady_clock::now();
        double s = std::chrono::duration<double>(t1 - t0).count();
        printf("%-8s %lld weights in %6.3f s  =  %6.1f M weights/s  (%.2f ns/weight)\n",
               d4 ? "Q1_D4" : "default", weights, s, weights / s / 1e6, s / weights * 1e9);
    }
    return 0;
}
