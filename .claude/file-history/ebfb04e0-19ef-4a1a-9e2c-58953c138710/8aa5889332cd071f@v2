// Freestanding probe (no libc startup): does this machine execute
// nds.vd4dots.vv? Prints "D4 6 22" on success. Build with -nostdlib.
#include <riscv_vector.h>

static long sys_write(long fd, const char * buf, long n) {
    register long a0 asm("a0") = fd, a1 asm("a1") = (long) buf, a2 asm("a2") = n;
    register long a7 asm("a7") = 64;   // __NR_write
    asm volatile("ecall" : "+r"(a0) : "r"(a1), "r"(a2), "r"(a7) : "memory");
    return a0;
}

static void sys_exit(long c) {
    register long a0 asm("a0") = c;
    register long a7 asm("a7") = 93;   // __NR_exit
    asm volatile("ecall" : : "r"(a0), "r"(a7));
    __builtin_unreachable();
}

static char * putdec(char * p, int v) {
    char t[12]; int n = 0;
    if (v == 0) { *p++ = '0'; return p; }
    if (v < 0)  { *p++ = '-'; v = -v; }
    while (v) { t[n++] = (char) ('0' + v % 10); v /= 10; }
    while (n) { *p++ = t[--n]; }
    return p;
}

void _start(void) {
    signed char w[64], a[64];
    for (int i = 0; i < 64; ++i) { w[i] = (signed char) i; a[i] = 1; }

    const size_t vl32 = 16;   // 16 i32 lanes = 64 bytes (m1 at VLEN >= 512)
    vint32m1_t acc = __riscv_vmv_v_x_i32m1(0, vl32);
    vint8m1_t  vw  = __riscv_vle8_v_i8m1(w, 64);
    vint8m1_t  va  = __riscv_vle8_v_i8m1(a, 64);

#ifndef NO_D4
    asm volatile("vsetvli t0, zero, e32, m1, ta, ma\n\t"
                 "nds.vd4dots.vv %0, %1, %2"
                 : "+vr"(acc) : "vr"(vw), "vr"(va) : "t0");
#else
    asm volatile("vsetvli t0, zero, e32, m1, ta, ma\n\t"
                 "vadd.vv %0, %1, %2"
                 : "+vr"(acc) : "vr"(vw), "vr"(va) : "t0");
#endif

    int out[16];
    __riscv_vse32_v_i32m1(out, acc, vl32);

    char buf[64], * p = buf;
    *p++ = 'D'; *p++ = '4'; *p++ = ' ';
    p = putdec(p, out[0]); *p++ = ' ';
    p = putdec(p, out[1]); *p++ = '\n';
    sys_write(1, buf, p - buf);
    sys_exit(0);
}
