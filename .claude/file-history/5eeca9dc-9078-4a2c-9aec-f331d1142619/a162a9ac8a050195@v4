/* Trap glue shared by all C-level round-trip fixtures.
 *
 * crt0.S calls init_mtvec() directly, BEFORE the .init_array walk, so
 * the trap vector is live before any C++ static constructor runs;
 * trap.S's m_trap_entry tail-calls handle_trap on every exception or
 * interrupt. vplat_syscalls.c routes syscalls through direct MMIO
 * (UART + SimControl/HTIF), not through `ecall`, so there's no
 * syscall-dispatch table here. Any trap is treated as a fatal error:
 * print a diagnostic and exit.
 */

#ifdef __cplusplus
extern "C"
{
#endif

#include <stdint.h>
#include <stdio.h>

#include "ecall_hook.h"
#include "htif_client.h"

#define WRITE_ERROR(format, ...) \
  fprintf(stderr, "\033[31m[ERROR] " format "\033[0m\n", ##__VA_ARGS__)

#define CAUSE_ECALL_FROM_M_MODE 11UL

__attribute__((used, noreturn)) void _exit(int exit_status);

/* Raw, unbuffered emergency print: goes straight to the UART MMIO register,
 * bypassing stdio (fprintf/vfprintf can themselves be mid-fault, or the
 * app's libc state can be in a shape a trap handler shouldn't trust). */
static void raw_print_hex(const char* label, unsigned long v)
{
  for (const char* p = label; *p; ++p)
    htif_uart_putc(*p);
  htif_uart_putc('0');
  htif_uart_putc('x');
  char digits[2 * sizeof(unsigned long)];
  int n = 0;
  do {
    int nib = v & 0xf;
    digits[n++] = (char) (nib < 10 ? '0' + nib : 'a' + nib - 10);
    v >>= 4;
  } while (v);
  while (n > 0)
    htif_uart_putc(digits[--n]);
  htif_uart_putc('\r');
  htif_uart_putc('\n');
}

void exception_handler(void* tf)
{
  /* XLEN-wide so rv64 mepc/mtval are not truncated and the format is warning-
   * free on both ABIs (unsigned long is 32-bit on ilp32, 64-bit on lp64). */
  unsigned long mcause, mdcause, mepc, mtval;

  asm volatile("csrr %0, mcause" : "=r"(mcause));
  asm volatile("csrr %0, mdcause" : "=r"(mdcause));
  asm volatile("csrr %0, mepc" : "=r"(mepc));
  asm volatile("csrr %0, mtval" : "=r"(mtval));

  raw_print_hex("mcause=", mcause);
  raw_print_hex("mepc=", mepc);
  raw_print_hex("mtval=", mtval);

  const unsigned long intbit = 1UL << (__riscv_xlen - 1);  /* mcause MSB */

  WRITE_ERROR("Trap occurred!");
  WRITE_ERROR("mcause: 0x%lx", mcause);
  WRITE_ERROR("mdcause: 0x%lx", mdcause);
  WRITE_ERROR("mepc: 0x%lx", mepc);
  WRITE_ERROR("mtval: 0x%lx", mtval);
  if (tf) {
    const unsigned long* regs = (const unsigned long*) tf;
    WRITE_ERROR("ra: 0x%lx", regs[1]);
    WRITE_ERROR("a0: 0x%lx", regs[10]);
  }

  if ((mcause & intbit) == 0) {
    WRITE_ERROR("Exception code: %lu", mcause);
  } else {
    WRITE_ERROR("Interrupt occurred! Cause: %lu", mcause & ~intbit);
  }

  /* _exit() (unlike exit()) does not flush stdio buffers; without this,
   * the diagnostic above is silently lost whenever stderr is
   * fully-buffered (e.g. not a tty under the vlinux syscall stdio path). */
  fflush(stderr);

  _exit((int) mcause);
}

__attribute__((weak)) int handle_ecall(unsigned long* regs)
{
  (void) regs;
  return 0;
}

void handle_trap(unsigned long cause, void* tf)
{
  if (cause == CAUSE_ECALL_FROM_M_MODE && handle_ecall((unsigned long*) tf))
    return;
  exception_handler(tf);
}

extern void m_trap_entry(void);

/* Called by name from crt0.S (not via .init_array: the direct reference
 * is also what extracts this object from libandesim_runtime.a). */
void init_mtvec(void)
{
  uintptr_t handler_address = (uintptr_t) &m_trap_entry;
  asm volatile("csrw mtvec, %0" : : "r"(handler_address));
}

#ifdef __cplusplus
}
#endif
