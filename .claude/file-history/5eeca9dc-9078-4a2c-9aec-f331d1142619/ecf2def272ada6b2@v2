// A tiny fs helper shared by anything that needs a private scratch directory
// for staged files (currently: --runtime linux's manifest staging).
#ifndef ANDESIM_TEMPDIR_HPP
#define ANDESIM_TEMPDIR_HPP

#include <string>

namespace andes_sim {

// Create a fresh, uniquely-named directory under the system temp dir
// (mkdtemp): "<system temp dir>/<prefix>-XXXXXX". Returns its path, or ""
// on failure. Not cleaned up by this call -- the caller owns its lifetime.
std::string make_temp_dir(const std::string& prefix);

}  // namespace andes_sim

#endif  // ANDESIM_TEMPDIR_HPP
