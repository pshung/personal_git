/* Linker script for vlinux, the M-mode proxy-kernel skeleton
 * (ROADMAP_LINUX_RUNTIME.md). Load base 0x0200_0000, per the roadmap's
 * "Guest memory map" table: vlinux owns 0x0200_0000 .. 0x0220_0000
 * (2 MiB) for its own text/data/bss AND its stack, kept clear of the
 * app image (which links below 0x0200_0000) and the mmap arena (which
 * grows down from just below the app's initial stack, above vlinux).
 *
 * Structurally the same shape as ../andesim.ld (see that file for why
 * each piece is where it is); only the base address, the added
 * .manifest section, and the stack address differ. Not merged with
 * andesim.ld: the two link completely different kinds of images (an
 * arbitrary user program spanning up to the whole DRAM window, vs a
 * fixed 2 MiB kernel region) and evolve independently.
 */

ENTRY(_start)

SECTIONS {
    . = 0x02000000;
    /* vlinux's own region start, for the U3 loader's overlap check --
     * PROVIDE(_stack = ...) below is the matching end bound. One source of
     * truth: loader.c reads these symbols instead of duplicating the
     * addresses as C constants. */
    PROVIDE(_vlinux_base = .);

    .text : {
        *(.text.init)
        *(.text*)
    }

    .rodata : {
        *(.rodata*)
        *(.srodata*)
    }

    /* Fixed home for the manifest struct so U2's `objcopy
     * --update-section .manifest=<blob>` has a stable target. */
    .manifest : {
        KEEP(*(.manifest))
    }

    .preinit_array : {
        PROVIDE_HIDDEN(__preinit_array_start = .);
        KEEP(*(.preinit_array))
        PROVIDE_HIDDEN(__preinit_array_end = .);
    }
    .init_array : {
        PROVIDE_HIDDEN(__init_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
        KEEP(*(.init_array .ctors))
        PROVIDE_HIDDEN(__init_array_end = .);
    }
    .fini_array : {
        PROVIDE_HIDDEN(__fini_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.fini_array.*) SORT_BY_INIT_PRIORITY(.dtors.*)))
        KEEP(*(.fini_array .dtors))
        PROVIDE_HIDDEN(__fini_array_end = .);
    }
    .eh_frame : { KEEP(*(.eh_frame)) }
    .gcc_except_table : { *(.gcc_except_table*) }

    .data : {
        *(.data*)
        *(.sdata*)
    }
    _edata = .;

    .bss : {
        *(.bss*)
        *(.sbss*)
        *(COMMON)
    }
    _end = .;

    /* Stack top = end of vlinux's 2 MiB region (roadmap memory-map
     * table); crt0.S reads this via the weak _stack symbol. */
    PROVIDE(_stack = 0x02200000);
}
