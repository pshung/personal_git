// Small text/CLI-value helpers shared across the command implementations.
// Header-only; no dependencies beyond the standard library.
#ifndef ANDESIM_STRUTIL_HPP
#define ANDESIM_STRUTIL_HPP

#include <string>
#include <vector>

namespace andes_sim {

// A "" -> `def` positive-int CLI knob (e.g. --limit, --min-iters,
// --step-timeout-ms): empty string keeps the default; otherwise the whole
// string must parse as a positive integer or this returns false.
inline bool parse_positive_int(const std::string& v, int def, int& out) {
  if (v.empty()) {
    out = def;
    return true;
  }
  try {
    size_t pos = 0;
    out = std::stoi(v, &pos);
    return pos == v.size() && out > 0;
  } catch (...) {
    return false;
  }
}

// Left-justify `s` to width `w` (pad with spaces; never truncate).
inline std::string ljust(std::string s, size_t w) {
  if (s.size() < w) s.append(w - s.size(), ' ');
  return s;
}

// Join `v` with `sep` between elements.
inline std::string join(const std::vector<std::string>& v, const char* sep = ",") {
  std::string s;
  for (size_t k = 0; k < v.size(); ++k) {
    if (k) s += sep;
    s += v[k];
  }
  return s;
}

// Engine HW width param (VLEN/DLEN/ELEN/XLEN) for display: a positive width
// prints as its number, 0/absent "-".
inline std::string vlen_str(long v) {
  return v > 0 ? std::to_string(v) : std::string("-");
}

}  // namespace andes_sim

#endif  // ANDESIM_STRUTIL_HPP
