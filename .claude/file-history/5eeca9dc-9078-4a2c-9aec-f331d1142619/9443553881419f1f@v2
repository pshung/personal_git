/* U7 contract (ROADMAP_LINUX_RUNTIME.md): file-backed MAP_PRIVATE mmap --
 * llama.cpp's default GGUF load path. mmap a host file, checksum it,
 * partially munmap (llama unmaps unused tail ranges), verify the
 * remainder is intact, then confirm mremap is refused (ENOMEM) rather
 * than corrupting anything.
 *
 * File size: the roadmap's own illustrative figure is 64 MB, sized for
 * the fast leg. This fixture also runs on the cycle-accurate leg, where
 * each window round trip costs real simulated cycles (see U6's 10M-loop
 * lesson) -- measured directly (256 KB, ~258 round trips, hung past a
 * 600s timeout; 4 KB, ~6 round trips, completed in 435s, matching the
 * ~7min glibc-startup baseline U4/U5/U6 already measured almost exactly):
 * 16 KB is large enough to span ~9 window chunks each way -- still
 * meaningfully multi-chunk, not a single round trip -- while leaving
 * comfortable cycle-leg headroom.
 */
#define _GNU_SOURCE
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>

#define FILE_SIZE (16 * 1024)

static unsigned checksum(const unsigned char* p, size_t n)
{
  unsigned c = 0;
  for (size_t i = 0; i < n; ++i) c = c * 131 + p[i];
  return c;
}

int main(void)
{
  setvbuf(stdout, NULL, _IONBF, 0); /* see rt_linux_file.c: no tty here */

  const char* path = "rt_linux_mmap_test.tmp";
  unsigned char* pattern = malloc(FILE_SIZE);
  if (!pattern) {
    printf("MMAP: malloc(pattern) failed\n");
    _exit(1);
  }
  for (size_t i = 0; i < FILE_SIZE; ++i) pattern[i] = (unsigned char) (i * 37 + 11);
  unsigned want = checksum(pattern, FILE_SIZE);

  FILE* f = fopen(path, "w");
  if (!f) {
    printf("MMAP: fopen(w) failed\n");
    _exit(1);
  }
  if (fwrite(pattern, 1, FILE_SIZE, f) != FILE_SIZE) {
    printf("MMAP: short write\n");
    _exit(1);
  }
  fclose(f);

  int fd = open(path, O_RDONLY);
  if (fd < 0) {
    printf("MMAP: open failed\n");
    _exit(1);
  }

  void* map = mmap(NULL, FILE_SIZE, PROT_READ, MAP_PRIVATE, fd, 0);
  if (map == MAP_FAILED) {
    printf("MMAP: mmap failed errno=%d\n", errno);
    _exit(1);
  }

  unsigned got = checksum((const unsigned char*) map, FILE_SIZE);
  if (got != want) {
    printf("MMAP: checksum mismatch want=%u got=%u\n", want, got);
    _exit(1);
  }
  printf("MMAP: checksum ok (%u)\n", got);

  /* Partial unmap: llama.cpp unmaps unused tail ranges. The first half
   * must stay valid and unchanged. */
  if (munmap((char*) map + FILE_SIZE / 2, FILE_SIZE / 2) != 0) {
    printf("MMAP: partial munmap failed\n");
    _exit(1);
  }
  unsigned got_half = checksum((const unsigned char*) map, FILE_SIZE / 2);
  unsigned want_half = checksum(pattern, FILE_SIZE / 2);
  if (got_half != want_half) {
    printf("MMAP: first half corrupted after partial munmap\n");
    _exit(1);
  }
  printf("MMAP: partial munmap ok, remaining half intact\n");

  if (munmap(map, FILE_SIZE / 2) != 0) {
    printf("MMAP: full munmap failed\n");
    _exit(1);
  }
  printf("MMAP: full munmap ok\n");

  void* map2 = mmap(NULL, FILE_SIZE, PROT_READ, MAP_PRIVATE, fd, 0);
  if (map2 == MAP_FAILED) {
    printf("MMAP: second mmap failed\n");
    _exit(1);
  }
  errno = 0;
  void* remapped = mremap(map2, FILE_SIZE, FILE_SIZE * 2, 0);
  if (remapped != MAP_FAILED || errno != ENOMEM) {
    printf("MMAP: mremap unexpected result errno=%d\n", errno);
    _exit(1);
  }
  printf("MMAP: mremap correctly ENOMEM\n");

  free(pattern);
  close(fd);
  printf("mmap ok\n");
  _exit(0);
}
