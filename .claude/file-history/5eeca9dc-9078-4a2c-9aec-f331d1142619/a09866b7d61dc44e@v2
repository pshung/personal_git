/* rt_linux_argv: a -nostdlib Linux-ABI test fixture for
 * ROADMAP_LINUX_RUNTIME.md U3 (vlinux's ELF loader + initial stack + auxv).
 *
 * No libc, no crt0: a naked _start reads argc/argv/envp/auxv straight off
 * the incoming sp -- the Linux process-startup ABI vlinux's stack builder
 * produces -- and issues raw `ecall`s for write(1,...)/exit_group, the same
 * 2 syscalls U3's minimal ecall dispatch handles. It links against nothing,
 * so it needs no glibc/linux toolchain (that arrives at U4); the ordinary
 * bare-metal HYBRID_TOOLCHAIN builds it, same as every other asm fixture.
 *
 * Prints "argv[N]=<value>" per argv entry, then "AT_PAGESZ=<value>", then
 * exit_group(0).
 */

#define SYS_write 64
#define SYS_exit_group 94
#define AUXV_AT_PAGESZ 6

static long sys3(long nr, long a0, long a1, long a2)
{
  register long a7 asm("a7") = nr;
  register long r0 asm("a0") = a0;
  register long r1 asm("a1") = a1;
  register long r2 asm("a2") = a2;
  asm volatile("ecall" : "+r"(r0) : "r"(a7), "r"(r1), "r"(r2) : "memory");
  return r0;
}

static void wr(const char* s, long n)
{
  sys3(SYS_write, 1, (long) s, n);
}

static long len(const char* s)
{
  long n = 0;
  while (s[n]) ++n;
  return n;
}

/* Decimal-format `v` into buf (no libc itoa); returns the string length. */
static int fmt_u(unsigned long v, char* buf)
{
  char tmp[20];
  int n = 0;
  if (v == 0) tmp[n++] = '0';
  while (v) {
    tmp[n++] = (char) ('0' + (v % 10));
    v /= 10;
  }
  for (int i = 0; i < n; ++i) buf[i] = tmp[n - 1 - i];
  return n;
}

void start_c(long* sp)
{
  long argc = sp[0];
  char** argv = (char**) &sp[1];
  char** e = argv + argc + 1; /* argv's own NULL terminator, then envp */
  while (*e) ++e;
  long* auxv = (long*) (e + 1); /* envp's own NULL terminator, then auxv */

  for (long i = 0; i < argc; ++i) {
    char nbuf[20];
    int nlen = fmt_u((unsigned long) i, nbuf);
    wr("argv[", 5);
    wr(nbuf, nlen);
    wr("]=", 2);
    wr(argv[i], len(argv[i]));
    wr("\n", 1);
  }

  for (long* a = auxv; a[0]; a += 2) {
    if (a[0] == AUXV_AT_PAGESZ) {
      char nbuf[20];
      int nlen = fmt_u((unsigned long) a[1], nbuf);
      wr("AT_PAGESZ=", 10);
      wr(nbuf, nlen);
      wr("\n", 1);
    }
  }

  sys3(SYS_exit_group, 0, 0, 0);
  for (;;)
    ; /* unreachable: exit_group does not return */
}

__attribute__((naked)) void _start(void)
{
  asm volatile("mv a0, sp\n"
               "call start_c\n");
}
