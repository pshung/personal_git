/* ecall dispatch: the "Set 1" syscalls a static glibc needs from _start to
 * printf+malloc+exit (ROADMAP_LINUX_RUNTIME.md U4). Reuses vplat's own
 * _write/_exit (already linked into vlinux via ../vplat_syscalls.c) and
 * mm.c's brk/mmap arenas rather than adding a second UART/SimControl path
 * or memory manager.
 *
 * Unknown syscalls are NOT fatal: glibc is designed to tolerate some optional
 * syscalls being unavailable (ROADMAP_LINUX_RUNTIME.md's own risk note about
 * riscv_hwprobe falling back to generic code), so an unimplemented number
 * prints once (grep-able) and returns -ENOSYS, same as real Linux would for
 * a syscall the running kernel does not implement -- it does not trap.
 */
#include "../ecall_hook.h"

#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <sys/types.h>

#include "mm.h"

extern ssize_t _write(int fd, const void* ptr, size_t len);
extern void _exit(int status) __attribute__((noreturn));

/* trap.S register-save-frame slot indices (see ecall_hook.h). */
#define REG_A0 10
#define REG_A1 11
#define REG_A2 12
#define REG_A3 13
#define REG_A4 14
#define REG_A5 15
#define REG_A7 17
#define REG_MEPC 32

#define SYS_write 64
#define SYS_writev 66
#define SYS_exit 93
#define SYS_exit_group 94
#define SYS_set_tid_address 96
#define SYS_set_robust_list 99
#define SYS_sched_yield 124
#define SYS_sched_getaffinity 123
#define SYS_sigaltstack 132
#define SYS_rt_sigaction 134
#define SYS_rt_sigprocmask 135
#define SYS_uname 160
#define SYS_getpid 172
#define SYS_getuid 174
#define SYS_geteuid 175
#define SYS_getgid 176
#define SYS_getegid 177
#define SYS_gettid 178
#define SYS_fcntl 25
#define SYS_ioctl 29
#define SYS_mprotect 226
#define SYS_munmap 215
#define SYS_mmap 222
#define SYS_brk 214
#define SYS_tgkill 131
#define SYS_rseq 293
#define SYS_prlimit64 261
#define SYS_getrandom 278

#define EINVAL 22
#define ENOTTY 25
#define ENOSYS 38

/* struct utsname (glibc's sys/utsname.h): 6 x char[65]. Defined locally --
 * vlinux is built with the bare-metal HYBRID_TOOLCHAIN, which has no such
 * header (there is no "Linux" to report from on a freestanding target). */
struct vlinux_utsname {
  char sysname[65];
  char nodename[65];
  char release[65];
  char version[65];
  char machine[65];
  char domainname[65];
};

struct vlinux_iovec {
  void* iov_base;
  unsigned long iov_len;
};

/* One bit per syscall number (0..511): "print vlinux: ENOSYS <nr> once" --
 * the diagnostic should not repeat if the same unimplemented syscall is
 * hit again later. */
static unsigned char g_enosys_seen[64];

static int enosys_already_seen(unsigned long nr)
{
  if (nr >= 512) return 0; /* out of the table's range: always print */
  const unsigned long byte = nr / 8, bit = nr % 8;
  if (g_enosys_seen[byte] & (unsigned char) (1u << bit)) return 1;
  g_enosys_seen[byte] |= (unsigned char) (1u << bit);
  return 0;
}

static long sys_writev(int fd, const struct vlinux_iovec* iov, int iovcnt)
{
  long total = 0;
  for (int i = 0; i < iovcnt; ++i) {
    const ssize_t n = _write(fd, iov[i].iov_base, iov[i].iov_len);
    if (n < 0) return total ? total : n;
    total += n;
    if ((size_t) n < iov[i].iov_len) break; /* short write */
  }
  return total;
}

static void sys_uname(struct vlinux_utsname* u)
{
  /* release MUST be >= the binary's "GNU/Linux 4.15.0" .note requirement
   * (ROADMAP_LINUX_RUNTIME.md) or glibc aborts at startup. */
  static const char sysname[] = "Linux";
  static const char release[] = "6.1.0-andesim";
  static const char version[] = "#1 SMP PREEMPT andesim";
  static const char machine[] = "riscv64";
  int i;
  for (i = 0; sysname[i]; ++i) u->sysname[i] = sysname[i];
  u->sysname[i] = '\0';
  u->nodename[0] = '\0';
  for (i = 0; release[i]; ++i) u->release[i] = release[i];
  u->release[i] = '\0';
  for (i = 0; version[i]; ++i) u->version[i] = version[i];
  u->version[i] = '\0';
  for (i = 0; machine[i]; ++i) u->machine[i] = machine[i];
  u->machine[i] = '\0';
  u->domainname[0] = '\0';
}

int handle_ecall(unsigned long* regs)
{
  const unsigned long nr = regs[REG_A7];
  long ret = 0;

  switch (nr) {
    case SYS_write:
      ret = _write((int) regs[REG_A0], (const void*) regs[REG_A1],
                  (size_t) regs[REG_A2]);
      break;
    case SYS_writev:
      ret = sys_writev((int) regs[REG_A0],
                       (const struct vlinux_iovec*) regs[REG_A1],
                       (int) regs[REG_A2]);
      break;
    case SYS_exit:
    case SYS_exit_group:
      _exit((int) regs[REG_A0]); /* noreturn */

    case SYS_brk:
      ret = sys_brk(regs[REG_A0]);
      break;
    case SYS_mmap:
      ret = sys_mmap(regs[REG_A0], regs[REG_A1], (long) regs[REG_A2],
                     (long) regs[REG_A3], (long) regs[REG_A4],
                     (long) regs[REG_A5]);
      break;
    case SYS_munmap:
      ret = sys_munmap(regs[REG_A0], regs[REG_A1]);
      break;
    case SYS_mprotect:
      ret = sys_mprotect(regs[REG_A0], regs[REG_A1], (long) regs[REG_A2]);
      break;

    case SYS_set_tid_address:
      ret = 1; /* the fixed "tid" every getpid/gettid call also reports */
      break;
    case SYS_set_robust_list:
      ret = 0;
      break;
    case SYS_rseq:
      ret = -ENOSYS; /* deliberate: restartable sequences, glibc falls back */
      break;

    case SYS_uname:
      sys_uname((struct vlinux_utsname*) regs[REG_A0]);
      ret = 0;
      break;

    case SYS_getpid:
    case SYS_gettid:
      ret = 1;
      break;
    case SYS_getuid:
    case SYS_geteuid:
    case SYS_getgid:
    case SYS_getegid:
      ret = 0;
      break;

    case SYS_prlimit64: {
      /* {rlim_cur, rlim_max}, both u64 -- old_limit is regs[REG_A3]; report
       * unlimited rather than modeling real per-resource limits. */
      unsigned long* old_limit = (unsigned long*) regs[REG_A3];
      if (old_limit) {
        old_limit[0] = ~0ul; /* RLIM_INFINITY */
        old_limit[1] = ~0ul;
      }
      ret = 0;
      break;
    }
    case SYS_getrandom: {
      unsigned char* buf = (unsigned char*) regs[REG_A0];
      const unsigned long len = regs[REG_A1];
      unsigned long seed;
      asm volatile("csrr %0, mcycle" : "=r"(seed)); /* see stack.c: mcycle,
                                                       * not rdcycle/rdtime */
      for (unsigned long i = 0; i < len; ++i) {
        seed = seed * 6364136223846793005ul + 1442695040888963407ul;
        buf[i] = (unsigned char) (seed >> 33);
      }
      ret = (long) len;
      break;
    }

    case SYS_sched_getaffinity: {
      const unsigned long cpusetsize = regs[REG_A1];
      unsigned char* mask = (unsigned char*) regs[REG_A2];
      if (cpusetsize < 1) {
        ret = -EINVAL;
        break;
      }
      mask[0] = 0x1; /* 1 cpu, bit 0 */
      for (unsigned long i = 1; i < cpusetsize; ++i) mask[i] = 0;
      ret = (long) cpusetsize;
      break;
    }
    case SYS_sched_yield:
      ret = 0; /* nothing else to yield to (single-threaded) */
      break;

    case SYS_rt_sigaction:
    case SYS_rt_sigprocmask:
    case SYS_sigaltstack:
      ret = 0; /* recorded nowhere: no signal delivery exists to honor them */
      break;
    case SYS_tgkill:
      _exit(128 + (int) regs[REG_A2]); /* noreturn: a fatal signal to self */

    case SYS_ioctl:
      ret = -ENOTTY; /* every fd here is UART/SimControl, never a real tty */
      break;
    case SYS_fcntl:
      ret = 0; /* basic: accept every fd-flag query/set as a no-op success */
      break;

    default:
      if (!enosys_already_seen(nr)) printf("vlinux: ENOSYS %lu\n", nr);
      ret = -ENOSYS;
      break;
  }

  regs[REG_A0] = (unsigned long) ret;
  regs[REG_MEPC] += 4; /* skip the ecall on return */
  return 1;
}
