#ifndef VLINUX_MANIFEST_H
#define VLINUX_MANIFEST_H

#include <stdint.h>

/* .manifest section wire format (ROADMAP_LINUX_RUNTIME.md U1/U2). This
 * default instance ships inside vlinux.elf as built; U2's driver-side
 * `objcopy --update-section .manifest=<blob>` overwrites it per run with
 * the real app_path/mem_size (argv/envp arrive in a later manifest
 * version once U3 needs them). */
#define VLINUX_MANIFEST_MAGIC   0x584c4e56u /* "VNLX" */
#define VLINUX_MANIFEST_VERSION 1u

struct vlinux_manifest {
  uint32_t magic;
  uint32_t version;
  uint64_t mem_size;
  char     app_path[256];
};

#endif /* VLINUX_MANIFEST_H */
