/* Minimal ecall dispatch (ROADMAP_LINUX_RUNTIME.md U3 scope: only what the
 * loader/stack test fixture needs to prove itself -- write + exit(_group).
 * The full syscall table is U4. Reuses vplat's own _write/_exit (already
 * linked into vlinux via ../vplat_syscalls.c) rather than adding a second
 * UART/SimControl path.
 */
#include "../ecall_hook.h"

#include <stddef.h>
#include <sys/types.h>

extern ssize_t _write(int fd, const void* ptr, size_t len);
extern void _exit(int status) __attribute__((noreturn));

/* trap.S register-save-frame slot indices (see ecall_hook.h). */
#define REG_A0 10
#define REG_A1 11
#define REG_A2 12
#define REG_A7 17
#define REG_MEPC 32

#define SYS_write 64
#define SYS_exit 93
#define SYS_exit_group 94

int handle_ecall(unsigned long* regs)
{
  switch (regs[REG_A7]) {
    case SYS_write:
      regs[REG_A0] = (unsigned long) _write((int) regs[REG_A0],
                                            (const void*) regs[REG_A1],
                                            (size_t) regs[REG_A2]);
      break;
    case SYS_exit:
    case SYS_exit_group:
      _exit((int) regs[REG_A0]); /* noreturn */
    default:
      return 0; /* not handled: falls through to the fatal trap diagnostic */
  }
  regs[REG_MEPC] += 4; /* skip the ecall on return */
  return 1;
}
