/* See loader.h. Reads the app ELF via newlib's ordinary open/read/lseek --
 * already wired to HTIF by ../vplat_syscalls.c (the same file I/O vplat
 * uses), so this file carries no HTIF-specific code at all. */
#include "loader.h"

#include <elf.h>
#include <fcntl.h>
#include <stdint.h>
#include <string.h>
#include <unistd.h>

#define LOADER_MAX_PHDRS 32

/* vlinux's own region bounds (runtime/linux/vlinux.ld): one source of
 * truth, not duplicated here as magic addresses. */
extern char _vlinux_base[];
extern char _stack[];

static int overlaps_vlinux(uint64_t vaddr, uint64_t memsz)
{
  const uint64_t base = (uint64_t) (uintptr_t) _vlinux_base;
  const uint64_t end = (uint64_t) (uintptr_t) _stack;
  return vaddr < end && (vaddr + memsz) > base;
}

static int read_full(int fd, void* buf, size_t len)
{
  char* p = (char*) buf;
  while (len > 0) {
    ssize_t n = read(fd, p, len);
    if (n <= 0) return -1;
    p += n;
    len -= (size_t) n;
  }
  return 0;
}

int load_elf(const char* path, struct loaded_elf* out)
{
  int fd = open(path, O_RDONLY);
  if (fd < 0) return -1;

  Elf64_Ehdr eh;
  if (read_full(fd, &eh, sizeof(eh)) < 0) goto fail;
  if (eh.e_ident[EI_MAG0] != ELFMAG0 || eh.e_ident[EI_MAG1] != ELFMAG1 ||
      eh.e_ident[EI_MAG2] != ELFMAG2 || eh.e_ident[EI_MAG3] != ELFMAG3 ||
      eh.e_ident[EI_CLASS] != ELFCLASS64 || eh.e_machine != EM_RISCV)
    goto fail;
  if (eh.e_phnum == 0 || eh.e_phnum > LOADER_MAX_PHDRS) goto fail;

  Elf64_Phdr phdrs[LOADER_MAX_PHDRS];
  if (lseek(fd, (off_t) eh.e_phoff, SEEK_SET) < 0) goto fail;
  if (read_full(fd, phdrs, (size_t) eh.e_phnum * sizeof(Elf64_Phdr)) < 0)
    goto fail;

  uint64_t phdr_vaddr = 0;
  uint64_t image_end = 0;
  for (unsigned i = 0; i < eh.e_phnum; ++i) {
    const Elf64_Phdr* ph = &phdrs[i];
    if (ph->p_type != PT_LOAD) continue;
    if (overlaps_vlinux(ph->p_vaddr, ph->p_memsz)) goto fail;

    if (lseek(fd, (off_t) ph->p_offset, SEEK_SET) < 0) goto fail;
    if (read_full(fd, (void*) (uintptr_t) ph->p_vaddr, ph->p_filesz) < 0)
      goto fail;
    if (ph->p_memsz > ph->p_filesz)
      memset((void*) (uintptr_t) (ph->p_vaddr + ph->p_filesz), 0,
             ph->p_memsz - ph->p_filesz);

    /* AT_PHDR: the program headers' address AS LOADED. Find the PT_LOAD
     * segment whose FILE range covers e_phoff and translate by the same
     * offset -- the segment does not necessarily start at the link base
     * (ld backs up to fit the ELF header + phdrs on the same page). */
    if (phdr_vaddr == 0 && eh.e_phoff >= ph->p_offset &&
        eh.e_phoff < ph->p_offset + ph->p_filesz)
      phdr_vaddr = ph->p_vaddr + (eh.e_phoff - ph->p_offset);

    const uint64_t seg_end = ph->p_vaddr + ph->p_memsz;
    if (seg_end > image_end) image_end = seg_end;
  }
  if (phdr_vaddr == 0) goto fail; /* no PT_LOAD covered the phdrs: malformed */

  close(fd);
  out->entry = eh.e_entry;
  out->phdr_vaddr = phdr_vaddr;
  out->phnum = eh.e_phnum;
  out->phentsize = eh.e_phentsize;
  out->image_end = image_end;
  return 0;

fail:
  close(fd);
  return -1;
}
