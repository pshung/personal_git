/* vlinux skeleton (U1): boot, banner, manifest reader.
 *
 * crt0.o (shared with vplat, see ../crt0.S) has already enabled the
 * icache/dcache, mstatus.FS/VS and mmisc_ctl.UNA, and installed the
 * fatal-trap handler before calling here. U1 only reads the built-in
 * default manifest and reports it; loading an app ELF from app_path is
 * U3.
 */

#include <stdint.h>
#include <stdio.h>

#include "manifest.h"

__attribute__((section(".manifest"), used)) const struct vlinux_manifest
  g_manifest = {
    .magic = VLINUX_MANIFEST_MAGIC,
    .version = VLINUX_MANIFEST_VERSION,
    .mem_size = 1024ull * 1024 * 1024,
    .app_path = "",
  };

int main(void)
{
  printf("vlinux: boot ok mem=%uM\n", (unsigned) (g_manifest.mem_size >> 20));
  return 0;
}
