/* rt_linux_glibc_hello: the U4 acceptance fixture (ROADMAP_LINUX_RUNTIME.md
 * "Proves loader+stack ... before glibc" (U3) is followed by proving a REAL
 * static glibc binary reaches main(), works, and exits cleanly. Deliberately
 * ordinary -- argv, a 1 MiB heap allocation (glibc's malloc, needs brk/mmap
 * to actually work), printf+fflush (stdio through the vlinux write() path),
 * and a specific exit code. Output is deterministic (no printed pointer
 * values) so the test can match it exactly.
 */
#include <stdio.h>
#include <stdlib.h>

int main(int argc, char** argv)
{
  void* p = malloc(1024 * 1024);
  printf("argv[0]=%s malloc=%s\n", argc > 0 ? argv[0] : "(none)",
        p ? "ok" : "FAIL");
  fflush(stdout);
  exit(42);
}
