#!/usr/bin/env bash
# vsim flag contract: every literal `--xxx` flag the driver hardcodes onto
# the accurate-leg's command line must actually exist in the built vsim
# engine's own --help output. Same "closed loop that catches driver/vsim
# drift" pattern as test_andes_sim_print_memmap.sh's layer 3, applied to
# the hybrid leg's CLI surface instead of its memory map.
#
# Written after a real bug: `driver/hybrid.cpp`'s vsim_extra_args()
# unconditionally sent `--kanata-roi` (a flag that has never existed in
# vsim) alongside `--kanata`, so every hybrid --kanata run failed with
# "Unrecognized option: --kanata-roi". Nothing caught it: hybrid_test.cpp
# only checked the driver's own argv-building in isolation (never invoked
# vsim), and the one e2e path that would have caught it sits behind an
# unset-by-default KANATA_FILE env var. This test invokes the REAL vsim
# --help and cross-checks the REAL constructed command line (via
# --dry-run), so a similarly-invented flag on ANY hybrid CLI knob -- not
# just kanata -- fails here instead of only at real-run time.
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

bash "$ROOT/scripts/build_driver.sh" >/dev/null 2>&1 || fail "build_driver.sh failed"
BIN="$ROOT/build/andesim"
[ -x "$BIN" ] || fail "missing driver binary: $BIN"
ELF="$ROOT/tests/fixtures/rt_c_hello.elf"
[ -f "$ELF" ] || fail "missing fixture: $ELF"

BINDIR=$(vsim_bin_dir)
SIM=$(ls "$BINDIR"/sim_* 2>/dev/null | head -1)
if [ -z "$SIM" ] || [ ! -x "$SIM" ]; then
  ok "SKIP: no built vsim engine under $BINDIR (set VSIM_BIN_DIR)"
  exit 0
fi
base=$(basename "$SIM"); base=${base#sim_}
id="vsim:${base}"

# The flags vsim itself advertises (the "Usage:" long-option column).
known=$("$SIM" --help 2>&1 | grep -oE -- '--[a-zA-Z][a-zA-Z-]*')

# The accurate-leg's constructed command line, exercising every dedicated
# hybrid flag the driver has (kanata + objdump; --verify pulls in the
# non---drain-minimal branch too).
KANATA_TMP=$(mktemp -d); trap 'rm -rf "$KANATA_TMP"' EXIT
out=$(VSIM_BIN_DIR="$BINDIR" "$BIN" run --mode hybrid --trigger marker \
      --engine "$id" --dry-run --kanata "$KANATA_TMP/k.txt" \
      --objdump "$KANATA_TMP/o.txt" --verify "$ELF" 2>&1)
line=$(printf '%s\n' "$out" | grep '^/.*sim_')
[ -n "$line" ] || fail "no accurate-leg command line in dry-run output: $out"

fail_count=0
for flag in $(printf '%s\n' "$line" | grep -oE -- '--[a-zA-Z][a-zA-Z-]*'); do
  printf '%s\n' "$known" | grep -qx -- "$flag" || {
    echo "[FAIL] driver sends $flag, but $SIM --help does not advertise it" >&2
    fail_count=$((fail_count + 1))
  }
done
[ "$fail_count" -eq 0 ] || fail "$fail_count driver-hardcoded vsim flag(s) unrecognized by $base -- see above"

ok "vsim flags contract: every driver-hardcoded accurate-leg flag exists in $base --help"
