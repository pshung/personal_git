/* See mm.h. Two independent bump allocators (brk grows up from the app's
 * image end; mmap grows down from just below the app's stack) sharing
 * vlinux's own region bounds (_vlinux_base/_stack, vlinux.ld) as their
 * far walls -- the same linker symbols loader.c's overlap check uses, one
 * source of truth.
 */
#include "mm.h"

#include <string.h>

#define PAGE_SIZE 4096ul

#define MAP_ANONYMOUS 0x20 /* asm-generic/mman-common.h */

#define ENOMEM 12 /* asm-generic/errno-base.h */
#define EINVAL 22
#define ENOSYS 38

extern char _vlinux_base[]; /* brk's ceiling */
extern char _stack[];       /* mmap's floor (== vlinux's own end) */

static uint64_t g_brk_start;   /* app image end: brk's floor */
static uint64_t g_brk_cur;
static uint64_t g_brk_ceiling; /* _vlinux_base */
static uint64_t g_mmap_top;    /* next allocation lands just below this */
static uint64_t g_mmap_floor;  /* _stack */

void mm_init(uint64_t app_image_end, uint64_t mem_size)
{
  g_brk_start = app_image_end;
  g_brk_cur = app_image_end;
  g_brk_ceiling = (uint64_t) (uintptr_t) _vlinux_base;
  g_mmap_floor = (uint64_t) (uintptr_t) _stack;
  g_mmap_top = mem_size - (8ull * 1024 * 1024); /* stack.c's STACK_RESERVE */
}

long sys_brk(unsigned long addr)
{
  if (addr == 0) return (long) g_brk_cur;
  if (addr < g_brk_start || addr > g_brk_ceiling)
    return (long) g_brk_cur; /* Linux brk(2): failure returns the OLD break */
  g_brk_cur = addr;
  return (long) g_brk_cur;
}

long sys_mmap(unsigned long addr, unsigned long length, long prot, long flags,
             long fd, long offset)
{
  (void) addr;
  (void) prot; /* every page is already RWX -- no MMU to restrict with */
  (void) fd;
  (void) offset;
  if (!(flags & MAP_ANONYMOUS)) return -ENOSYS; /* file-backed: U7 */
  if (length == 0) return -EINVAL;

  const uint64_t need = ((uint64_t) length + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);
  if (need > g_mmap_top - g_mmap_floor) return -ENOMEM;
  g_mmap_top -= need;
  memset((void*) (uintptr_t) g_mmap_top, 0, need);
  return (long) g_mmap_top;
}

long sys_munmap(unsigned long addr, unsigned long length)
{
  (void) addr;
  (void) length;
  return 0;
}

long sys_mprotect(unsigned long addr, unsigned long length, long prot)
{
  (void) addr;
  (void) length;
  (void) prot;
  return 0;
}
