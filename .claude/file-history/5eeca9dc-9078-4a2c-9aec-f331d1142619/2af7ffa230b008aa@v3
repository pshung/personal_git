// `--runtime linux` manifest staging (U2, ROADMAP_LINUX_RUNTIME.md).
//
// A linux-runtime run boots a per-run COPY of vlinux.elf (the U1 proxy
// kernel) whose .manifest section has been stamped with this run's app path
// + mem size via `objcopy --update-section`. The app ELF itself is never
// booted directly -- vlinux loads it (from U3 onward).
#ifndef ANDESIM_MANIFEST_HPP
#define ANDESIM_MANIFEST_HPP

#include <cstdint>
#include <string>
#include <vector>

namespace andes_sim {

// Serialize the .manifest section blob (runtime/linux/manifest.h's
// struct vlinux_manifest) for one linux-runtime run. `app_path` must fit the
// struct's fixed-size field (incl. NUL terminator); on overflow returns {}
// and sets err. `extra_argv` becomes the app's argv[1..] (argv[0] is always
// app_path) -- more than VLINUX_MANIFEST_ARGV_MAX_COUNT entries, or entries
// whose encoded (NUL-separated) bytes exceed VLINUX_MANIFEST_ARGV_BYTES, is
// an error, same no-silent-truncation discipline as the app_path overflow
// case.
std::vector<uint8_t> build_manifest_blob(const std::string& app_path,
                                         uint64_t mem_size,
                                         const std::vector<std::string>& extra_argv,
                                         std::string& err);

// The `objcopy --update-section` argv that stamps `blob_path`'s bytes into
// `vlinux_elf`'s .manifest section, in place. Pure -- testable without
// spawning.
std::vector<std::string> manifest_objcopy_argv(const std::string& objcopy_bin,
                                               const std::string& blob_path,
                                               const std::string& vlinux_elf);

// Stage a per-run vlinux.elf carrying this run's manifest: copy the built
// runtime/linux/vlinux.elf into a fresh temp workdir as vlinux-run.elf, write
// the manifest blob, and objcopy --update-section it in place. Needs
// build/runtime/linux/vlinux.elf (scripts/build_all.sh vlinux) and
// HYBRID_TOOLCHAIN (env or config.env, for objcopy). The workdir is NOT
// cleaned up here -- the caller's -bios points at the returned path for the
// life of the run (see ROADMAP_LINUX_RUNTIME.md U2 for the tradeoff: fast's
// transparent exec_passthrough never returns to clean up after itself, the
// same way run_plan's own staged qemu.cfg is never revisited post-spawn).
// Returns the staged ELF's path, or "" and sets `err`.
std::string stage_linux_runtime(const std::string& app_elf_abs,
                                uint64_t mem_size,
                                const std::vector<std::string>& extra_argv,
                                std::string& err);

}  // namespace andes_sim

#endif  // ANDESIM_MANIFEST_HPP
