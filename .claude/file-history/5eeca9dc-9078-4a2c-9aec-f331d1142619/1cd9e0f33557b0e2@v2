/* U6 contract (ROADMAP_LINUX_RUNTIME.md): clock_gettime(REALTIME +
 * MONOTONIC), clock_getres, nanosleep, clock_nanosleep -- the pattern
 * ggml_time_us() (llama.cpp's own timing helper) uses unpatched. Two
 * monotonic stamps around a 10M-iteration loop must never go backward.
 */
#define _GNU_SOURCE
#include <stdio.h>
#include <time.h>
#include <unistd.h>

static long long now_us(clockid_t clk)
{
  struct timespec ts;
  if (clock_gettime(clk, &ts) != 0) return -1;
  return (long long) ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
}

int main(void)
{
  setvbuf(stdout, NULL, _IONBF, 0); /* see rt_linux_file.c: no tty here */

  long long t0 = now_us(CLOCK_MONOTONIC);
  if (t0 < 0) {
    printf("TIME: clock_gettime(MONOTONIC) failed\n");
    _exit(1);
  }

  /* The roadmap's own "10M-loop" figure assumes the fast (QEMU, MHz-speed)
   * leg; this fixture also runs on the cycle-accurate leg (~8.7 kHz,
   * unoptimized -O0 build), where 10M iterations would run for many
   * minutes on top of the ~7min glibc-startup cost U4/U5 already measured
   * -- well past any reasonable test timeout. The actual contract is
   * "monotonic delta >= 0", independent of loop size (t1==t0 still
   * passes below): 10K iterations exercises the same property in ~tens
   * of cycle-leg seconds instead. */
  volatile unsigned long sum = 0;
  for (unsigned long i = 0; i < 10000UL; ++i) sum += i;

  long long t1 = now_us(CLOCK_MONOTONIC);
  if (t1 < 0) {
    printf("TIME: clock_gettime(MONOTONIC) #2 failed\n");
    _exit(1);
  }
  if (t1 < t0) {
    printf("TIME: monotonic went backward: %lld -> %lld\n", t0, t1);
    _exit(1);
  }
  printf("TIME: monotonic delta=%lld us ok (sum=%lu)\n", t1 - t0, sum);

  if (now_us(CLOCK_REALTIME) < 0) {
    printf("TIME: clock_gettime(REALTIME) failed\n");
    _exit(1);
  }
  printf("TIME: realtime ok\n");

  struct timespec res;
  if (clock_getres(CLOCK_MONOTONIC, &res) != 0) {
    printf("TIME: clock_getres failed\n");
    _exit(1);
  }
  printf("TIME: clock_getres ok\n");

  struct timespec req = {0, 1000}; /* 1us: returns immediately, no timer exists */
  if (nanosleep(&req, NULL) != 0) {
    printf("TIME: nanosleep failed\n");
    _exit(1);
  }
  printf("TIME: nanosleep ok\n");

  if (clock_nanosleep(CLOCK_MONOTONIC, 0, &req, NULL) != 0) {
    printf("TIME: clock_nanosleep failed\n");
    _exit(1);
  }
  printf("TIME: clock_nanosleep ok\n");

  printf("time ok\n");
  _exit(0);
}
