  // Returns all committed PCs from all cores and all issue slots
  // Result: vector[core_id] contains vector of committed PCs for that core
  // Each inner vector has 0-2 entries depending on how many instructions
  // committed (ax46mpv is 2-issue)
  std::vector<std::vector<uint64_t>> get_committed_pc()
  {
    std::vector<std::vector<uint64_t>> result(_NDS_NHART);

    // Core 0 - 2 issue slots
    if (this->rootp->WB_I0_RETIRE_C0) {
      result[0].push_back(this->rootp->WB_I0_PC_C0);
    }
    if (this->rootp->WB_I1_RETIRE_C0) {
      result[0].push_back(this->rootp->WB_I1_PC_C0);
    }

#if _NDS_NHART > 1
    // Core 1 - 2 issue slots
    if (this->rootp->WB_I0_RETIRE_C1) {
      result[1].push_back(this->rootp->WB_I0_PC_C1);
    }
    if (this->rootp->WB_I1_RETIRE_C1) {
      result[1].push_back(this->rootp->WB_I1_PC_C1);
    }
#endif

    return result;
  }

  // Returns last PC values from all issue slots (no retire check)
  // Result: vector[core_id] contains all PC values from that core's issue slots
  // Always returns 2 entries per core (may contain stale values if slot didn't
  // commit)
  std::vector<std::vector<uint64_t>> get_last_committed_pc()
  {
#if _NDS_NHART > 1
    return {{this->rootp->WB_I0_PC_C0, this->rootp->WB_I1_PC_C0},
            { this->rootp->WB_I0_PC_C1,
              this->rootp->WB_I1_PC_C1 }};
#else
    return {{this->rootp->WB_I0_PC_C0, this->rootp->WB_I1_PC_C0}};
#endif
  }

  // ---- LM/HVM content backdoors (LM transport ROADMAP_ilm_dlm, HVM
  // transport ROADMAP_hvm). Hart-0 memories, zero sim cycles
  // (hierarchical-reference copies). The kCpuCan* authorities in
  // simulator.hpp detect these members, so their presence is what makes
  // --describe advertise the sizes and the driver arm the sidecars.
  // Bank interleave per this config's generated testbench ae350_tb.sv
  // (ilm_ram_init/dlm_ram_init): low word-address bits select the bank.
  static_assert(_NDS_ILM_ECC_TYPE_INT == 0 && _NDS_DLM_ECC_TYPE_INT == 0
                  && _NDS_ILM_DATA_WIDTH == 64 && _NDS_DLM_DATA_WIDTH == 64,
                "lm_banked_*64 assumes plain 64-bit LM rows; a reconfigured "
                "ax46mpv needs the ax45mpv_premium-style ECC code ladder");

#if _NDS_ILM_SIZE_KB > 0
  void set_ilm(const std::vector<uint8_t>& data)
  {
    constexpr size_t bytes = _NDS_ILM_SIZE_KB * 1024;
    if (data.size() > bytes)
      throw std::runtime_error("ILM data size (" + std::to_string(data.size())
                               + " bytes) exceeds ILM capacity ("
                               + std::to_string(bytes) + " bytes)");
    lm_banked_write64(
      data, bytes,
      this->rootp
        ->ae350_vcpu_cluster_subsystem__DOT__u_cluster__DOT__u_complex0__DOT__u_core0__DOT__u_ilm_ram0__DOT__ram_inst__DOT__mem,
      this->rootp
        ->ae350_vcpu_cluster_subsystem__DOT__u_cluster__DOT__u_complex0__DOT__u_core0__DOT__u_ilm_ram1__DOT__ram_inst__DOT__mem);
  }

  std::vector<uint8_t> get_ilm()
  {
    constexpr size_t bytes = _NDS_ILM_SIZE_KB * 1024;
    return lm_banked_read64(
      bytes,
      this->rootp
        ->ae350_vcpu_cluster_subsystem__DOT__u_cluster__DOT__u_complex0__DOT__u_core0__DOT__u_ilm_ram0__DOT__ram_inst__DOT__mem,
      this->rootp
        ->ae350_vcpu_cluster_subsystem__DOT__u_cluster__DOT__u_complex0__DOT__u_core0__DOT__u_ilm_ram1__DOT__ram_inst__DOT__mem);
  }
#endif // _NDS_ILM_SIZE_KB > 0

