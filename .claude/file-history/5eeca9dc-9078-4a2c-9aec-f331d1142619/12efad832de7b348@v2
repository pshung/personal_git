#!/usr/bin/env bash
# U1 contract (ROADMAP_LINUX_RUNTIME.md): vlinux.elf boots on both fast
# (QEMU) and cycle (vsim) from reset with its built-in default manifest
# (no app configured) -- prints a boot banner and exits 0. There is no
# driver --runtime flag yet (that's U2): vlinux.elf runs as a plain
# standalone ELF, the same invocation style as
# tests/vplat/test_vplat_f1.sh (cycle) + f2.sh (fast).
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

# shellcheck disable=SC1091
. "$ROOT/config.env" 2>/dev/null
export HYBRID_TOOLCHAIN="${HYBRID_TOOLCHAIN:?config.env missing}"

BIN="$ROOT/build/andesim"
ELF="$ROOT/build/runtime/linux/vlinux.elf"
SIM="$(vsim_bin_dir)/sim_ax45mpv_premium"
[ -x "$BIN" ] || fail "driver not built: $BIN"
[ -x "$SIM" ] || fail "cycle engine not found (source ./setup.sh): $SIM"

make -C "$ROOT/runtime/linux" || fail "vlinux build failed"
[ -f "$ELF" ] || fail "missing $ELF"

OUT=$(timeout 60 "$BIN" run --mode fast "$ELF" </dev/null 2>&1); RC=$?
printf '%s\n' "$OUT" | grep -Eq 'vlinux: boot ok mem=[0-9]+M' \
  || fail "fast: missing boot banner in: $OUT"
[ "$RC" -eq 0 ] || fail "fast: exit code $RC != 0 (output: $OUT)"

OUT=$(timeout 120 "$SIM" "$ELF" </dev/null 2>&1); RC=$?
printf '%s\n' "$OUT" | grep -Eq 'vlinux: boot ok mem=[0-9]+M' \
  || fail "cycle: missing boot banner in: $OUT"
[ "$RC" -eq 0 ] || fail "cycle: exit code $RC != 0 (output: $OUT)"

ok "U1 vlinux.elf boots on fast and cycle (banner + exit 0)"
