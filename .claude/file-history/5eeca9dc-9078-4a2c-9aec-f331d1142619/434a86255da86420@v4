#ifndef VLINUX_LOADER_H
#define VLINUX_LOADER_H

#include <stdint.h>

/* What the app's ELF header/program headers hand to the initial-stack
 * builder (stack.h) and the memory manager (mm.h): the entry point, the
 * AT_PHDR/AT_PHENT/AT_PHNUM triple auxv requires (computed from the LOADED,
 * not file, locations), and the highest loaded address -- the brk arena's
 * floor. */
struct loaded_elf {
  uint64_t entry;
  uint64_t phdr_vaddr;
  uint32_t phnum;
  uint32_t phentsize;
  uint64_t image_end; /* max(p_vaddr + p_memsz) over every PT_LOAD segment */
};

/* Load `path`'s PT_LOAD segments into memory and zero each segment's BSS
 * tail. Rejects any segment that would overlap vlinux's own region, the
 * V-transport scratch page (mem_size's top HYBRID_V_SCRATCH_BYTES --
 * ROADMAP_LINUX_RUNTIME.md U9: real and reserved under hybrid, though the
 * check runs unconditionally since it is harmless and always correct
 * under fast/cycle too, where nothing lives there), or the HTIF SimControl
 * MMIO window. On success fills `out` and returns 0; on any failure
 * (open/read/lseek error, bad ELF magic/class/machine, no PT_LOAD, an
 * overlapping segment, malformed headers) returns -1. */
int load_elf(const char* path, uint64_t mem_size, struct loaded_elf* out);

#endif /* VLINUX_LOADER_H */
