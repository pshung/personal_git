/* AT_FDCWD (fcntl.h): openat/fstatat/faccessat/statx's "use my cwd"
 * dirfd. Numerically identical on guest and host (Linux UAPI constant,
 * not architecture-specific), so it forwards to the host calls as-is. */
#define AT_FDCWD (-100)

