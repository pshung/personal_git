/* U5 contract (ROADMAP_LINUX_RUNTIME.md): fopen/fwrite/fclose then fopen/
 * fseek/ftell/fread/fclose exercise openat/write/close/lseek/read/fstat
 * through ordinary glibc stdio. Explicit syscall() probes cover the rest
 * of the roadmap's "File I/O syscall set" directly and deterministically
 * (stdio alone does not necessarily reach fstatat/statx/faccessat/getcwd/
 * pread64/readlinkat/getdents64).
 *
 * _GNU_SOURCE: struct statx/STATX_* and SYS_statx are declared only under
 * __USE_GNU (glibc's sys/stat.h), not implied by -std=gnu11 alone.
 */
#define _GNU_SOURCE
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/syscall.h>
#include <unistd.h>

int main(void)
{
  /* Unbuffered stdout: isatty(1) is false here (no tty ioctl exists on
   * this relay), so glibc fully-buffers stdout by default and every
   * printf below would sit unflushed until exit() -- which, per
   * ROADMAP_LINUX_RUNTIME.md U4's documented gap, may never get that far.
   * _exit() below (not return/exit()) is the other half of routing around
   * that unrelated, already-tracked issue: this fixture tests U5's file
   * I/O, not U4's exit()-handler-list bug. */
  setvbuf(stdout, NULL, _IONBF, 0);

  const char* path = "rt_linux_file_test.tmp";
  const char payload[] = "0123456789abcdefghijklmnopqrstuvwxyz";

  FILE* f = fopen(path, "w");
  if (!f) {
    printf("FILEIO: fopen(w) failed\n");
    _exit(1);
  }
  if (fwrite(payload, 1, sizeof payload, f) != sizeof payload) {
    printf("FILEIO: short write\n");
    _exit(1);
  }
  fclose(f);

  f = fopen(path, "r");
  if (!f) {
    printf("FILEIO: fopen(r) failed\n");
    _exit(1);
  }
  if (fseek(f, 0, SEEK_END) != 0) {
    printf("FILEIO: fseek(END) failed\n");
    _exit(1);
  }
  long size = ftell(f);
  if (size != (long) sizeof payload) {
    printf("FILEIO: ftell=%ld want %u\n", size, (unsigned) sizeof payload);
    _exit(1);
  }
  if (fseek(f, 0, SEEK_SET) != 0) {
    printf("FILEIO: fseek(SET) failed\n");
    _exit(1);
  }

  char back[sizeof payload];
  memset(back, 0, sizeof back);
  size_t r = fread(back, 1, sizeof back, f);
  fclose(f);
  if (r != sizeof payload || memcmp(payload, back, sizeof payload) != 0) {
    printf("FILEIO: readback mismatch (%u)\n", (unsigned) r);
    _exit(1);
  }
  printf("FILEIO: stdio size=%ld ok\n", size);

  /* Direct syscall probes: the rest of the roadmap's File I/O set. open()
   * on riscv64 compiles down to openat(AT_FDCWD, ...) too -- same syscall,
   * already proven by the stdio path above, reused here for a plain fd. */
  int fd = open(path, O_RDONLY);
  if (fd < 0) {
    printf("FILEIO: open failed\n");
    _exit(1);
  }

  struct stat st;
  if (fstat(fd, &st) != 0 || st.st_size != (long) sizeof payload) {
    printf("FILEIO: fstat failed or wrong size\n");
    _exit(1);
  }
  printf("FILEIO: fstat size=%ld ok\n", (long) st.st_size);

  char buf4[4];
  long pr = syscall(SYS_pread64, fd, buf4, 4, 4);
  if (pr != 4 || memcmp(buf4, payload + 4, 4) != 0) {
    printf("FILEIO: pread64 failed\n");
    _exit(1);
  }
  printf("FILEIO: pread64 ok\n");
  close(fd);

  struct stat st2;
  if (syscall(SYS_newfstatat, AT_FDCWD, path, &st2, 0) != 0 ||
      st2.st_size != (long) sizeof payload) {
    printf("FILEIO: fstatat failed\n");
    _exit(1);
  }
  printf("FILEIO: fstatat ok\n");

#ifdef SYS_statx
  struct statx stx;
  memset(&stx, 0, sizeof stx);
  if (syscall(SYS_statx, AT_FDCWD, path, 0, STATX_BASIC_STATS, &stx) != 0 ||
      stx.stx_size != (unsigned long) sizeof payload) {
    printf("FILEIO: statx failed\n");
    _exit(1);
  }
  printf("FILEIO: statx ok\n");
#endif

  if (syscall(SYS_faccessat, AT_FDCWD, path, F_OK, 0) != 0) {
    printf("FILEIO: faccessat failed\n");
    _exit(1);
  }
  printf("FILEIO: faccessat ok\n");

  char cwd[256];
  long cwdlen = syscall(SYS_getcwd, cwd, sizeof cwd);
  if (cwdlen <= 0) {
    printf("FILEIO: getcwd failed\n");
    _exit(1);
  }
  printf("FILEIO: getcwd ok len=%ld\n", cwdlen);

  char linkbuf[16];
  long rl = syscall(SYS_readlinkat, AT_FDCWD, path, linkbuf, sizeof linkbuf);
  if (rl >= 0 || errno != EINVAL) {
    printf("FILEIO: readlinkat unexpected result %ld errno=%d\n", rl, errno);
    _exit(1);
  }
  printf("FILEIO: readlinkat correctly EINVAL\n");

  int dfd = open(".", O_RDONLY | O_DIRECTORY);
  if (dfd >= 0) {
    char dbuf[64];
    errno = 0;
    long gd = syscall(SYS_getdents64, dfd, dbuf, sizeof dbuf);
    if (gd >= 0 || errno != ENOSYS) {
      printf("FILEIO: getdents64 unexpected result %ld errno=%d\n", gd, errno);
      _exit(1);
    }
    printf("FILEIO: getdents64 correctly ENOSYS\n");
    close(dfd);
  } else {
    printf("FILEIO: open(.) O_DIRECTORY failed, skipping getdents64 probe\n");
  }

  printf("file io ok\n");
  _exit(0);
}
