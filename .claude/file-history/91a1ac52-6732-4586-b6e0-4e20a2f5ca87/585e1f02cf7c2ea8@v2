// break_mret_in_roi.S
//
// Bug: executing mret inside the ROI redirects execution to mepc, abandoning
// the rest of the ROI code.  Because L24 restores mepc into vsim at resume,
// mret jumps to whatever mepc was set to before the handoff.  If mepc points
// outside the ROI (or before the exit marker), vsim never reaches the exit
// marker and times out.
//
// This test sets mepc to &regress (an infinite-loop label) before the ROI.
// After resume, vsim's mepc = &regress.  The mret inside the ROI jumps there.
// vsim loops forever and never reaches the exit marker.
//
// Expected outcome:
//   Plain hybrid run: vsim TIMEOUT -> harness FAIL.
//   VERIFY=1:         not applicable (vsim never exits).
//
// On an M-only core (ax45mpv_premium) mstatus.MPP is WARL-pinned to M-mode,
// so mret stays in M-mode and interrupts remain disabled (mstatus.MPIE = 0).
//
// Real-world trigger: trap handlers that execute mret to return from an
// exception they handled before the handoff, e.g. an NMI handler.
//
// Scope: bare-metal, no async interrupts.

.section .text
.globl _start
_start:
    // Point mepc at the regress spin loop before the ROI.
    // QEMU1 drains mepc = &regress; ResumeDriver restores it (L24).
    la   t0, regress
    csrw mepc, t0

    slti x0, x0, 0x5A0          // ENTER ROI
    // mepc has been restored to &regress by vsim's ResumeDriver (L24).
    mret                         // PC = mepc = &regress  <- THE BUG
    // Everything below is unreachable.

    slti x0, x0, 0x5A1          // EXIT MARKER - NEVER REACHED

    li   t0, 0xe0080000         // SimControl exit (standalone path; never reached)
    sw   x0, 0(t0)
1:  j    1b

regress:
    j    regress                // mret lands here -> infinite loop -> timeout
