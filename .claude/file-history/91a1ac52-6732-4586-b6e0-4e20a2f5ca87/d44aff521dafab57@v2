// break_mcycle_write.S
//
// Bug: writing mcycle inside the ROI silently corrupts the reported cycle
// figure.  The cycle delta = (drained mcycle) - (mcycle_at_measure_start).
// If the ROI resets mcycle to zero, the drained value is near-zero regardless
// of how much real work the ROI did; the delta underflows (if a warmup
// baseline was captured) or collapses to near-zero (default, no warmup).
//
// Nothing in the hybrid runtime prevents a bare-metal program from writing
// mcycle.  A performance-measurement library that resets the counter at the
// start of a timed region would trigger this silently.
//
// Expected outcome:
//   Plain hybrid run: completes normally, reported cycles << actual ROI work.
//   VERIFY=1: also completes, but cycle fields are masked so no compare fires.
//   The wrong number is invisible unless the user inspects the raw state file.
//
// Scope: bare-metal, no async interrupts.

.section .text
.globl _start
_start:
    // Burn some cycles pre-ROI so QEMU1's drained mcycle is non-trivial.
    li   t0, 0
    li   t1, 10000
pre_loop:
    addi t0, t0, 1
    blt  t0, t1, pre_loop

    slti x0, x0, 0x5A0          // ENTER ROI

    csrw mcycle, zero            // reset the cycle counter <- THE BUG
    // mcycle is now 0 (or 1).  StateDrain re-reads it at the exit marker.
    // The reported window_cycles = (near-zero) - (entry baseline) = WRONG.

    // ROI work: 10000-iteration loop that should cost ~30000+ RTL cycles.
    li   t0, 0
    li   t1, 10000
roi_loop:
    addi t0, t0, 1
    mul  t2, t0, t0             // mul to stretch pipeline (result discarded)
    blt  t0, t1, roi_loop

    slti x0, x0, 0x5A1          // EXIT ROI

    li   t0, 0xe0080000
    sw   x0, 0(t0)
1:  j    1b
