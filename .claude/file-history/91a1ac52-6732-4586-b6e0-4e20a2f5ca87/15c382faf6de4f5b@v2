// break_verify_diverge.S
//
// Bug: code inside the ROI that branches on (mcycle - minstret) will diverge
// between a hybrid run and the VERIFY=1 oracle.
//
// Mechanism:
//   vsim (RTL): counts actual clock cycles including pipeline stalls and cache
//               miss penalties.  For 1000 cache-striding loads:
//               mcycle_delta >> minstret_delta (stall cycles accumulate).
//   QEMU oracle: models CPI=1 for most instructions; mcycle_delta ≈ minstret_delta.
//
// The overhead = (mcycle_delta - minstret_delta) reliably separates the two:
//   QEMU oracle:  overhead ≈ 0  -> branch NOT taken -> a0 = 0xAAAA
//   vsim:         overhead >> 0 -> branch taken     -> a0 = 0xBBBB
//
// --verify then fires: "[state-diff] x10: ref=0xAAAA... got=0xBBBB..."
//
// The plain hybrid run always produces one fixed result (vsim is deterministic).
// Only --verify exposes the divergence.
//
// Scope: bare-metal, no async interrupts.

.section .text
.globl _start
_start:
    // Stash minstret and mcycle just before the ROI so we can compute deltas
    // inside the ROI (both are restored from QEMU1 drain = same baseline).
    csrr s0, minstret
    csrr s1, mcycle

    slti x0, x0, 0x5A0          // ENTER ROI
    // s0 = entry minstret, s1 = entry mcycle (restored from QEMU1 drain).

    // 1000 loads with 64-byte stride across the low 64 KB of DRAM.
    // Each load is a cold cache miss in vsim (L1 D-cache thrashing).
    // QEMU counts 1 cycle per instruction; vsim counts ~50+ stall cycles per miss.
    li   t0, 0                  // loop counter
    li   t1, 1000
    li   t2, 0                  // load address (starts at 0x00000000 = valid DRAM)
cache_stride_loop:
    lw   zero, 0(t2)            // cache-miss load; stalls vsim pipeline
    addi t2, t2, 64             // next cache line
    addi t0, t0, 1
    blt  t0, t1, cache_stride_loop

    csrr a0, mcycle
    csrr a1, minstret
    sub  a0, a0, s1             // mcycle_delta
    sub  a1, a1, s0             // minstret_delta
    sub  a0, a0, a1             // overhead = mcycle_delta - minstret_delta

    // QEMU oracle:  overhead ≈ 0 (CPI=1 model)
    // vsim:         overhead >> 0 (real cache-miss stall cycles)
    bnez a0, stalled
    li   a0, 0xAAAAAAAAAAAAAAAA  // oracle path: no stall overhead
    j    done
stalled:
    li   a0, 0xBBBBBBBBBBBBBBBB // hybrid path: stall cycles observed

done:
    slti x0, x0, 0x5A1          // EXIT ROI
    // --verify: oracle a0=0xAAAA, hybrid a0=0xBBBB -> FAIL

    li   t0, 0xe0080000
    sw   x0, 0(t0)
1:  j    1b
