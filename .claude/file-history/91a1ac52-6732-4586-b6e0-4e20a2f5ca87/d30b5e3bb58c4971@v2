// break_vscratch_top.S
//
// L26 scheme-D guard: proves the V-transport scratch sits ABOVE the program's
// declared RAM, not on its top page.
//
// This fixture stores a sentinel at 0x07FFF000 -- the LAST page of a default
// 128 MiB program RAM (ceiling 0x08000000). It then enters the ROI (handing
// off to vsim, which advertises V and so runs the V-register transport even
// though this program never executes a V instruction) and reads the sentinel
// back inside the ROI.
//
//   - Scheme A (F1: scratch = top page of the program's RAM): the transport
//     would write v0..v31 to 0x07FFF000 and clobber the sentinel -> the in-ROI
//     check fails, the fixture spins, the harness times out (FAIL).
//   - Scheme D (F2: mmap is one page larger than --mem-size, scratch at the
//     ceiling 0x08000000): 0x07FFF000 is untouched -> sentinel survives ->
//     fixture reaches the exit marker and exits cleanly (PASS).
//
// Must be run with the default 128 MiB program RAM (the 0x07FFF000 literal
// assumes ceiling 0x08000000) on a V-capable engine, e.g.
//   andes-sim run --model hybrid --engine vsim:ax45mpv_premium
//       --trigger marker tests/fixtures/break_vscratch_top.elf
//
// Scope: bare-metal, no async interrupts.

.section .text
.globl _start
_start:
    li      t0, 0x07FFF000          // last page of the 128 MiB program RAM
    li      t1, 0xA5A5F00DCAFEBABE
    sd      t1, 0(t0)               // sentinel in the program's top page

    slti    x0, x0, 0x5A0           // ENTER ROI -> hand off to vsim

    ld      t2, 0(t0)               // reload after the V transport ran
    bne     t2, t1, regress         // clobbered (scheme A)? spin -> harness FAIL

    slti    x0, x0, 0x5A1           // EXIT ROI (scheme D: sentinel survived)

    li      t0, 0xe0080000          // SimControl exit for the standalone path
    sw      x0, 0(t0)
1:  j       1b

regress:
    j       regress                 // scratch landed on the top page -> hang
