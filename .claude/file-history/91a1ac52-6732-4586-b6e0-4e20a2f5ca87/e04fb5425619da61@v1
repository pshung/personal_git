// Unit tests for the oracle differential compare (driver/state_diff.hpp).
//
// Policy under test (verify_oracle.md): strictly compare what vsim's exit
// drain freshly reads (pc, GPRs; FPRs under FLAG_FP; V CSRs + vreg bytes
// under FLAG_V) plus the identity fields; SKIP the passthrough M-CSRs/PMP
// (vsim copies them from QEMU1's entry snapshot, so they cannot equal the
// oracle's exit values by construction); MASK the counters (engines count
// differently by design).
#include "state_diff.hpp"

#include "hybrid/state_abi.h"
#include "test_check.hpp"

using namespace andes_sim;

namespace {

// A fully populated reference state (FP + V live).
hybrid_state_v1 base_state() {
  hybrid_state_v1 s{};
  s.magic = HYBRID_STATE_MAGIC;
  s.version = HYBRID_STATE_VERSION;
  s.flags = HYBRID_FLAG_RV64 | HYBRID_FLAG_FP | HYBRID_FLAG_V;
  s.hart_id = 0;
  s.priv = 3;
  s.pc = 0x100240;
  for (int i = 0; i < 32; ++i) s.gpr[i] = 0x1000 + i;
  s.gpr[0] = 0;
  for (int i = 0; i < 32; ++i) s.fpr[i] = 0x2000 + i;
  s.fcsr = 0x21;  // frm=RTZ | fflags=NX (L20)
  s.vstart = 0;
  s.vtype = 0xd0;
  s.vl = 16;
  s.vlenb = 64;
  s.vxsat = 0;
  s.vxrm = 1;
  s.vcsr = 2;
  for (int i = 0; i < 32 * HYBRID_VLEN_BYTES_MAX; ++i)
    s.vreg[i] = static_cast<uint8_t>(i * 7);
  s.mcycle = 1000;
  s.minstret = 900;
  s.mstatus = 0xa00002200ull;
  s.mepc = 0x5555;
  s.satp = 0x9999;
  s.pmpaddr[3] = 0x77;
  return s;
}

// Fields strictly compared for a FP+V state: 6 identity/pc + 32 gpr +
// 32 fpr + fcsr (L20) + 7 V scalars + 32 vregs.
constexpr int kFullCompared = 6 + 32 + 33 + 7 + 32;

}  // namespace

int main() {
  {  // identical states -> ok, full field count
    const hybrid_state_v1 a = base_state();
    const DiffReport r = diff_states(a, a);
    CHECK(r.ok());
    CHECK(r.compared == kFullCompared);
  }

  {  // a GPR mismatch is caught and named
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.gpr[5] = 0xdead;
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "x5");
    CHECK(r.diffs[0].ref == 0x1005);
    CHECK(r.diffs[0].got == 0xdead);
  }

  {  // pc mismatch
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.pc = ref.pc + 4;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "pc");
  }

  {  // counters are masked: mcycle/minstret/warmup snapshots may differ
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.mcycle = 999999;
    got.minstret = 888888;
    got.mcycle_at_measure_start = 7;
    got.minstret_at_measure_start = 8;
    CHECK(diff_states(ref, got).ok());
  }

  {  // passthrough M-CSRs/PMP are skipped, not compared
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.mstatus = 0x1;
    got.mepc = 0x2;
    got.mtvec = 0x3;
    got.mcause = 0x4;
    got.mtval = 0x5;
    got.mscratch = 0x6;
    got.medeleg = 0x7;
    got.mideleg = 0x8;
    got.mip = 0x9;
    got.mie = 0xa;
    got.satp = 0xb;
    got.pmpcfg[0] = 0xc;
    got.pmpaddr[63] = 0xd;
    CHECK(diff_states(ref, got).ok());
  }

  {  // no FLAG_FP -> FPRs not compared, count shrinks
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.fpr[7] = 0xbad;
    got.vtype = 0xbad;  // V block also off
    const DiffReport r = diff_states(ref, got);
    CHECK(r.ok());
    CHECK(r.compared == 6 + 32);
  }

  {  // FPR mismatch under FLAG_FP
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.fpr[31] = 0;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "f31");
  }

  {  // fcsr mismatch under FLAG_FP (L20)
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.fcsr = 0;  // restore lost: vsim drained the reset value
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "fcsr");
  }

  {  // V scalar CSR mismatch
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.vl = 8;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "vl");
  }

  {  // vreg byte mismatch names the register and byte offset
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.vreg[3 * HYBRID_VLEN_BYTES_MAX + 7] ^= 0xff;
    const DiffReport r = diff_states(ref, got);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "v3[7]");
    CHECK(r.diffs[0].ref == ref.vreg[3 * HYBRID_VLEN_BYTES_MAX + 7]);
  }

  {  // identity mismatch (flags) is caught
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.flags = HYBRID_FLAG_RV64;
    const DiffReport r = diff_states(ref, got);
    CHECK(!r.ok());
    bool saw_flags = false;
    for (const FieldDiff& d : r.diffs) saw_flags |= d.field == "flags";
    CHECK(saw_flags);
  }

  {  // multiple mismatches all reported
    const hybrid_state_v1 ref = base_state();
    hybrid_state_v1 got = ref;
    got.gpr[1] = 1;
    got.gpr[2] = 2;
    got.pc = 4;
    CHECK(diff_states(ref, got).diffs.size() == 3);
  }

  // ---- cosim_redesign F6: lock-step trap-cause comparison ----

  {  // compare_trap_cause adds mepc + mcause to the compared set
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;  // no FP/V to keep the count simple
    const DiffReport off = diff_states(ref, ref, /*compare_trap_cause=*/false);
    const DiffReport on = diff_states(ref, ref, /*compare_trap_cause=*/true);
    CHECK(on.compared == off.compared + 2);
    CHECK(on.ok());
  }

  {  // mcause mismatch caught only with trap-cause on
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.mcause = 2;  // illegal-instruction vs ref's 0
    CHECK(diff_states(ref, got, /*compare_trap_cause=*/false).ok());
    const DiffReport r = diff_states(ref, got, /*compare_trap_cause=*/true);
    CHECK(!r.ok());
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "mcause");
    CHECK(r.diffs[0].got == 2);
  }

  {  // mepc mismatch caught with trap-cause on
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.mepc = ref.mepc + 4;
    const DiffReport r = diff_states(ref, got, /*compare_trap_cause=*/true);
    CHECK(r.diffs.size() == 1);
    CHECK(r.diffs[0].field == "mepc");
  }

  {  // mtval and mstatus stay EXCLUDED even with trap-cause on
     // (implementation-defined; would false-positive across engines)
    hybrid_state_v1 ref = base_state();
    ref.flags = HYBRID_FLAG_RV64;
    hybrid_state_v1 got = ref;
    got.mtval = 0xdeadbeef;
    got.mstatus = 0x1;
    CHECK(diff_states(ref, got, /*compare_trap_cause=*/true).ok());
  }

  return andes_sim::test::report("state_diff");
}
