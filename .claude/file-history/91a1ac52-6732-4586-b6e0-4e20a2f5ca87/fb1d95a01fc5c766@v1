// LockstepSession (cosim_redesign F4): the vsim side of lock-step DV
// co-sim. The whole session is DMI-driven -- halt at reset, single-step to
// the arm pc, then one drain_full record per execution attempt -- so record
// boundaries are exact (no haltreq slack) and traps align by construction:
// a step that traps re-enters debug mode at the handler entry, which is
// exactly where the QEMU oracle's next pre-execution callback drains.

#pragma once

#include "hybrid/dmi_poll.hpp"
#include "hybrid/resume_driver.hpp"
#include "hybrid/state_abi.h"
#include "hybrid/state_drain.hpp"
#include "hybrid/step_driver.hpp"

#include <cstdint>
#include <cstdio>
#include <functional>
#include <stdexcept>
#include <string>
#include <utility>

namespace hybrid
{

class LockstepSession
{
public:
  using RD = ResumeDriver;

  struct Config
  {
    uint64_t arm_pc = 0;
    // 0 = unbounded: the stop check (program exit) is the only terminator.
    uint64_t max_records = 0;
    // Steps allowed between the boot halt and DPC == arm_pc. The reset
    // vector normally IS the arm pc (zero pre-steps); the budget bounds a
    // mis-specified arm pc instead of stepping forever.
    uint64_t pre_arm_step_budget = 1'000'000;
  };

  // sink(record, k): k counts from 0; record k = state before execution
  // attempt k+1. stop(): polled between records; true ends the session
  // (e.g. SimControl reported program exit).
  using Sink      = std::function<void(const hybrid_state_v1&, uint64_t)>;
  using StopCheck = std::function<bool()>;

  LockstepSession(DmiBus& bus, Config cfg, Sink sink, StopCheck stop)
      : bus_{bus},
        drain_{bus},
        step_{bus},
        cfg_{cfg},
        sink_{std::move(sink)},
        stop_{std::move(stop)}
  {}

  // Returns the number of records written.
  auto run() -> uint64_t
  {
    // dmactive 0->1 in its own write, then haltreq (Debug Spec).
    bus_.write(RD::kDmcontrol, RD::kDmcontrolDmactive);
    bus_.write(RD::kDmcontrol,
               RD::kDmcontrolDmactive | RD::kDmcontrolHaltreq);
    poll_until_set(bus_, RD::kDmstatus, RD::kDmstatusAllhalted,
                   "LockstepSession boot halt");
    step_.enable();

    // Pre-arm: step until the next instruction IS the arm pc.
    uint64_t budget = cfg_.pre_arm_step_budget;
    while (read_register_64(bus_, regno_csr(RD::kCsrDpc),
                            "LockstepSession dpc") != cfg_.arm_pc) {
      if (budget-- == 0)
        throw std::runtime_error(
          "LockstepSession: arm pc 0x" + to_hex(cfg_.arm_pc)
          + " not reached within the pre-arm step budget ("
          + std::to_string(cfg_.pre_arm_step_budget)
          + " steps); wrong --cosim-arm-pc?");
      step_.step_one();
    }

    uint64_t records = 0;
    for (;;) {
      sink_(drain_.drain_full(), records);
      ++records;
      if (cfg_.max_records != 0 && records >= cfg_.max_records) break;
      if (stop_()) break;
      step_.step_one();
    }
    step_.disable();
    return records;
  }

private:
  static auto to_hex(uint64_t v) -> std::string
  {
    char buf[19];
    std::snprintf(buf, sizeof(buf), "%llx",
                  static_cast<unsigned long long>(v));
    return buf;
  }

  DmiBus& bus_;
  StateDrain drain_;
  StepDriver step_;
  Config cfg_;
  Sink sink_;
  StopCheck stop_;
};

}  // namespace hybrid
