// Oracle differential compare. See state_diff.hpp for the policy.
#include "state_diff.hpp"

#include <cstdio>
#include <string>

#include "cli.hpp"
#include "state.hpp"

namespace andes_sim {

namespace {

void cmp(DiffReport& r, const std::string& field, unsigned long long ref,
         unsigned long long got) {
  ++r.compared;
  if (ref != got) r.diffs.push_back({field, ref, got});
}

}  // namespace

DiffReport diff_states(const hybrid_state_v1& ref, const hybrid_state_v1& got,
                       bool compare_trap_cause) {
  DiffReport r;

  cmp(r, "magic", ref.magic, got.magic);
  cmp(r, "version", ref.version, got.version);
  cmp(r, "flags", ref.flags, got.flags);
  cmp(r, "hart_id", ref.hart_id, got.hart_id);
  cmp(r, "priv", ref.priv, got.priv);
  cmp(r, "pc", ref.pc, got.pc);

  // mepc/mcause: compared in BOTH policies. In the trap-free hybrid ROI they
  // round-trip (L24: restored at resume, re-read at drain); in the lock-step
  // trap path they are the trap-cause pair that reveals a divergent trap (the
  // handler pc shows on the next record). mtval/mstatus stay out of lock-step
  // (implementation-defined on a real trap / dirty bits -> false positives).
  cmp(r, "mepc", ref.mepc, got.mepc);
  cmp(r, "mcause", ref.mcause, got.mcause);

  // Round-trip M-mode CSRs, hybrid policy only: mscratch (L23) and mtval/mie
  // (L24) are restored at resume and re-read at drain, so a trap-free ROI must
  // match the oracle on them. The lock-step path is reset-vs-reset
  // (implementation-defined reset values), so it excludes them. mip is excluded
  // in BOTH: its pending bits are hardware/platform-driven (timer/external) and
  // diverge between QEMU's functional clock and vsim's cycle clock even with no
  // trap (it still round-trips into the drained record, just not the verifier).
  if (!compare_trap_cause) {
    cmp(r, "mscratch", ref.mscratch, got.mscratch);
    cmp(r, "mtval", ref.mtval, got.mtval);
    cmp(r, "mie", ref.mie, got.mie);
  }

  for (int i = 0; i < 32; ++i)
    cmp(r, "x" + std::to_string(i), ref.gpr[i], got.gpr[i]);

  if (ref.flags & HYBRID_FLAG_FP) {
    for (int i = 0; i < 32; ++i)
      cmp(r, "f" + std::to_string(i), ref.fpr[i], got.fpr[i]);
    cmp(r, "fcsr", ref.fcsr, got.fcsr);  // L20: frm + sticky fflags
  }

  if (ref.flags & HYBRID_FLAG_V) {
    cmp(r, "vstart", ref.vstart, got.vstart);
    cmp(r, "vtype", ref.vtype, got.vtype);
    cmp(r, "vl", ref.vl, got.vl);
    cmp(r, "vlenb", ref.vlenb, got.vlenb);
    cmp(r, "vxsat", ref.vxsat, got.vxsat);
    cmp(r, "vxrm", ref.vxrm, got.vxrm);
    cmp(r, "vcsr", ref.vcsr, got.vcsr);

    // One compared "field" per vector register; report the first differing
    // byte as "v<i>[<byte>]".
    for (int i = 0; i < 32; ++i) {
      ++r.compared;
      const uint8_t* a = &ref.vreg[static_cast<size_t>(i) * HYBRID_VLEN_BYTES_MAX];
      const uint8_t* b = &got.vreg[static_cast<size_t>(i) * HYBRID_VLEN_BYTES_MAX];
      for (int j = 0; j < HYBRID_VLEN_BYTES_MAX; ++j) {
        if (a[j] != b[j]) {
          r.diffs.push_back({"v" + std::to_string(i) + "[" +
                                 std::to_string(j) + "]",
                             a[j], b[j]});
          break;
        }
      }
    }
  }

  return r;
}

void print_diff_report(const DiffReport& r) {
  for (const FieldDiff& d : r.diffs)
    std::printf("[state-diff] %s: ref=0x%llx got=0x%llx\n", d.field.c_str(),
                d.ref, d.got);
  if (r.ok()) {
    std::printf(
        "[state-diff] PASS: %d fields match (counters and passthrough CSRs "
        "excluded)\n",
        r.compared);
  } else {
    std::printf("[state-diff] FAIL: %zu mismatch(es) (%d fields compared)\n",
                r.diffs.size(), r.compared);
  }
}

// `andes-sim state-diff <ref.bin> <got.bin>` -- the file-based surface of
// diff_states for shell harnesses (tests/e2e.sh VERIFY=1). rc: 0 match,
// 1 mismatch, 2 usage/read error.
int cmd_state_diff(const Cli& cli) {
  if (cli.positional.size() != 2) {
    std::fputs("usage: andes-sim state-diff <ref.bin> <got.bin>\n", stderr);
    return 2;
  }
  const StateFile ref = read_state_file(cli.positional[0]);
  if (!ref.ok()) {
    std::fprintf(stderr, "andes-sim state-diff: %s\n", ref.error.c_str());
    return 2;
  }
  const StateFile got = read_state_file(cli.positional[1]);
  if (!got.ok()) {
    std::fprintf(stderr, "andes-sim state-diff: %s\n", got.error.c_str());
    return 2;
  }
  const DiffReport r = diff_states(ref.st, got.st);
  print_diff_report(r);
  return r.ok() ? 0 : 1;
}

}  // namespace andes_sim
