// Oracle differential compare (verify_oracle F2): field-wise diff of two
// drained hybrid_state_v1 records -- the QEMU oracle's exit-boundary drain
// (ref) against the hybrid run's vsim drain (got).
//
// Compare policy, fixed by what vsim's drain freshly reads (state_drain.hpp
// drain_with_passthrough):
//   strict:  magic/version/flags/hart_id/priv (identity), pc, gpr[0..31],
//            mscratch (L23: round-trips through the hybrid handoff -- restored
//            at resume, re-read at drain; hybrid policy only); fpr[0..31]
//            under FLAG_FP; vstart/vtype/vl/vlenb/vxsat/vxrm/vcsr and the
//            vreg bytes under FLAG_V.
//   skipped: mstatus, mepc, mtvec, mcause, mtval, medeleg, mideleg, mip, mie,
//            satp, pmpcfg[], pmpaddr[] -- passthrough on the vsim side (copied
//            from QEMU1's ENTRY snapshot, never re-read), so comparing them
//            would test entry-vs-exit. (mscratch left this set in L23.)
//   masked:  mcycle, minstret, mcycle/minstret_at_measure_start -- the
//            engines count cycles/insns differently by design.
#ifndef ANDES_SIM_STATE_DIFF_HPP
#define ANDES_SIM_STATE_DIFF_HPP

#include <string>
#include <vector>

#include "hybrid/state_abi.h"

namespace andes_sim {

// One strictly-compared field that differs: "pc", "x5", "f31", "vl",
// "v3[7]" (register + byte offset), "flags", ...
struct FieldDiff {
  std::string field;
  unsigned long long ref = 0;
  unsigned long long got = 0;
};

struct DiffReport {
  int compared = 0;  // count of strictly compared fields
  std::vector<FieldDiff> diffs;
  bool ok() const { return diffs.empty(); }
};

// compare_trap_cause (cosim_redesign F6, lock-step): also compare mepc and
// mcause -- the well-defined trap fields that reveal a mishandled trap. Still
// EXCLUDES mtval (implementation-defined for illegal insns) and mstatus
// (dirty-bit differences), which would false-positive across QEMU vs RTL.
// Default false preserves the hybrid-ROI policy above (trap CSRs passthrough).
DiffReport diff_states(const hybrid_state_v1& ref, const hybrid_state_v1& got,
                       bool compare_trap_cause = false);

// Print `r` as "[state-diff] ..." lines: one per mismatch, then the
// PASS/FAIL verdict. Shared by the state-diff subcommand and run --verify.
void print_diff_report(const DiffReport& r);

}  // namespace andes_sim

#endif  // ANDES_SIM_STATE_DIFF_HPP
