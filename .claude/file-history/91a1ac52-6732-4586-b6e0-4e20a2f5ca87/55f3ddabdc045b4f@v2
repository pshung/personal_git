// Glues CsrTrigger and StateDrain. The simulator's run-loop calls on_retire
// once per committed PC; the controller decides via the trigger map whether
// to drain state and returns the populated hybrid_state_v1 if so. The
// caller (simulator.hpp) is responsible for writing the file and exiting
// with EXIT_HANDOFF_TO_QEMU.

#pragma once

#include "hybrid/csr_trigger.hpp"
#include "hybrid/insn_match.h"
#include "hybrid/measure_start_snapshot.hpp"
#include "hybrid/resume_driver.hpp"
#include "hybrid/state_abi.h"
#include "hybrid/state_drain.hpp"

#include <cstdint>
#include <functional>
#include <optional>
#include <stdexcept>
#include <utility>
#include <vector>

namespace hybrid
{

template<typename Trigger, typename Observer = NullObserver>
class HandoffController
{
public:
  // scratch_gpa (L26): forwarded to StateDrain for the V dump sweep; defaults
  // to the unset sentinel (non-V drains never read it). The simulator passes
  // the real mmap-top-page GPA.
  HandoffController(Trigger trigger, DmiBus& bus,
                    uint64_t scratch_gpa = kVScratchGpaUnset)
      : trigger_{std::move(trigger)}, drain_{bus, scratch_gpa}
  {}

  HandoffController(Trigger trigger, DmiBus& bus, Observer observer,
                    uint64_t scratch_gpa = kVScratchGpaUnset)
      : trigger_{std::move(trigger)},
        drain_{bus, scratch_gpa},
        observer_{std::move(observer)}
  {}

  // Snapshot of the QEMU 1 input state. When set, drain merges FP/CSR/V
  // fields from the snapshot into the freshly drained GPRs+PC, avoiding
  // a per-field DM Abstract Command on every handoff.
  void set_passthrough_input(hybrid_state_v1 input)
  {
    passthrough_ = input;
  }

  // cosim_roi F2: every `interval` retires, drain a resumable checkpoint and
  // hand it to `sink` (k counts from 1). The caller writes the numbered file;
  // the hart keeps running. Requires the passthrough snapshot (checkpoints
  // reuse drain_checkpoint, which needs the QEMU1 flags/CSR slots).
  using CosimSink = std::function<void(const hybrid_state_v1&, uint64_t)>;
  void enable_cosim(uint64_t interval, CosimSink sink)
  {
    cosim_interval_ = interval;
    cosim_next_     = interval;
    cosim_sink_     = std::move(sink);
  }

  // cosim_redesign F3: explicit ascending retire targets instead of an
  // interval. Each target drains a checkpoint to `sink`; the LAST target
  // FINISHES the run -- its drain is also returned from on_retire so the
  // caller writes the final state file and exits, without waiting for the
  // exit trigger (which still wins if it fires earlier).
  void enable_cosim_targets(std::vector<uint64_t> targets, CosimSink sink)
  {
    if (targets.empty())
      throw std::runtime_error(
        "HandoffController cosim: explicit target list must not be empty");
    cosim_targets_ = std::move(targets);
    cosim_next_    = cosim_targets_.front();
    cosim_sink_    = std::move(sink);
  }

  // Read-only view of the underlying trigger. Used by the ROI kanata-gate
  // derivation, which needs to read scanned EXIT PCs without consuming them.
  auto trigger() const -> const Trigger& { return trigger_; }

  // Read-only view of the observer slot. F16 (StateDrain) reads the warmup
  // snapshot from here when copying into the ABI struct.
  auto observer() const -> const Observer& { return observer_; }
  auto observer() -> Observer& { return observer_; }

  auto on_retire(uint64_t pc) -> std::optional<hybrid_state_v1>
  {
    if constexpr (requires { trigger_.observe_commit(); }) {
      trigger_.observe_commit();
    }
    if constexpr (requires { observer_.observe_commit(); }) {
      observer_.observe_commit();
    }
    const auto hit = trigger_.lookup(pc);
    // Only EXIT drains; entry is QEMU's job, vsim ignores ENTER. Every
    // non-exit retire advances the cosim checkpoint counter instead.
    if (!hit || hit->kind != HYBRID_HANDOFF_EXIT)
      return maybe_cosim_checkpoint();
    push_warmup_snapshot();
    if (passthrough_) return drain_.drain_with_passthrough(*passthrough_);
    return drain_.drain();
  }

private:
  // F16: push warmup snapshot into the drain right before it runs so the
  // returned state carries mcycle_at_measure_start / minstret_at_measure_start.
  // The if-constexpr branch compiles away for NullObserver (no accessors).
  void push_warmup_snapshot()
  {
    if constexpr (requires { observer_.mcycle_at_measure_start(); }) {
      drain_.set_warmup_snapshot(observer_.mcycle_at_measure_start(),
                                 observer_.minstret_at_measure_start());
    }
  }

  // Monotonic target (not modulo) so the slack retires that commit while a
  // checkpoint's haltreq propagates are simply absorbed into the next window.
  // Returns a state only in targets mode at the LAST target (run finishes).
  auto maybe_cosim_checkpoint() -> std::optional<hybrid_state_v1>
  {
    const bool targets_mode = !cosim_targets_.empty();
    const bool targets_done = targets_mode
      && cosim_target_idx_ >= cosim_targets_.size();
    if ((cosim_interval_ == 0 && !targets_mode) || targets_done)
      return std::nullopt;
    if (++cosim_retires_ < cosim_next_) return std::nullopt;
    if (!passthrough_)
      throw std::runtime_error(
        "HandoffController cosim: checkpoints require the QEMU passthrough "
        "snapshot (set_passthrough_input)");
    push_warmup_snapshot();

    if (targets_mode && cosim_target_idx_ + 1 == cosim_targets_.size()) {
      // Last explicit target: drain WITHOUT resuming -- this record both
      // goes to the sink and ends the run as the final state.
      ++cosim_target_idx_;
      const auto state = drain_.drain_with_passthrough(*passthrough_);
      cosim_sink_(state, ++cosim_count_);
      return state;
    }

    if (targets_mode)
      cosim_next_ = cosim_targets_[++cosim_target_idx_];
    else
      cosim_next_ += cosim_interval_;
    cosim_sink_(drain_.drain_checkpoint(*passthrough_), ++cosim_count_);
    return std::nullopt;
  }

  Trigger trigger_;
  StateDrain drain_;
  Observer observer_{};
  std::optional<hybrid_state_v1> passthrough_;
  uint64_t cosim_interval_ = 0;  // 0 + empty targets = cosim disabled
  std::vector<uint64_t> cosim_targets_;
  std::size_t cosim_target_idx_ = 0;
  uint64_t cosim_retires_  = 0;
  uint64_t cosim_next_     = 0;
  uint64_t cosim_count_    = 0;
  CosimSink cosim_sink_;
};

// CTAD: the old `HandoffController(trigger, bus)` call sites must still
// deduce `Observer = NullObserver`. The default-arg form of CTAD cannot
// see template defaults, so spell them out as deduction guides.
template<typename Trigger>
HandoffController(Trigger, DmiBus&)
  -> HandoffController<Trigger, NullObserver>;

template<typename Trigger, typename Observer>
HandoffController(Trigger, DmiBus&, Observer)
  -> HandoffController<Trigger, Observer>;

}  // namespace hybrid
