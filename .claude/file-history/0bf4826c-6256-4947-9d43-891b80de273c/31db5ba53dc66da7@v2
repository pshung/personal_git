#!/usr/bin/env bash
# F4 contract: `build` (delegates to setup.sh / scripts/build_*.sh / make).
#
#   1. `build --dry-run [--what T]` prints the underlying commands and matches
#      `python3 hsim build --dry-run [--what T]` byte-for-byte (rc included) for
#      every target (default + all/qemu/vsim/plugin/simpoint/fixtures).
#   2. A real `build --what plugin` delegates faithfully: it spawns
#      `make -C qemu_plugin` with the child's stdio inherited, emits the
#      [andes-sim] banner, and returns the SAME exit code as the golden. (Whether
#      the build is green is environment-dependent -- in a checkout without the
#      QEMU plugin headers both drivers fail identically; F4 guarantees identical
#      delegation, not a green build. The banner only shows on real runs, so it
#      is not parity-scoped and uses the new driver name.)
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

BIN="$ROOT/build/andes-sim"
GOLDEN="$ROOT/hsim"

bash "$ROOT/scripts/build_driver.sh" >/dev/null 2>&1 || fail "build_driver.sh failed"
[ -x "$BIN" ] || fail "missing executable: $BIN"

# 1. dry-run parity for every target (default form + each explicit --what)
check_dry() {  # $@ = build args after the subcommand
  local g n grc nrc
  g=$(cd "$ROOT" && "$GOLDEN" build "$@" 2>&1);  grc=$?
  n=$(cd "$ROOT" && "$BIN" build "$@" 2>&1);      nrc=$?
  [ "$grc" = "$nrc" ] || fail "build $* rc differs: golden=$grc new=$nrc"
  [ "$g" = "$n" ] || {
    diff <(printf '%s\n' "$g") <(printf '%s\n' "$n") >&2
    fail "build $* dry-run output differs from golden"
  }
}
check_dry --dry-run
for w in all qemu vsim plugin simpoint fixtures; do
  check_dry --dry-run --what "$w"
done

# 2. a real build delegates faithfully (same rc as golden, banner, inherited stdio)
g=$(cd "$ROOT" && "$GOLDEN" build --what plugin 2>&1);  grc=$?
n=$(cd "$ROOT" && "$BIN" build --what plugin 2>&1);      nrc=$?
[ "$grc" = "$nrc" ] || fail "real build --what plugin rc differs: golden=$grc new=$nrc"
echo "$n" | grep -qF "[andes-sim] make -C qemu_plugin QEMU_ROOT=./QEMU" \
  || fail "real build did not emit the plugin banner:"$'\n'"$n"
# the spawned make's own output reached us -> the child inherited our stdio
echo "$n" | grep -q '^make:' \
  || fail "delegated make output was not inherited:"$'\n'"$n"

ok "F4 build"
