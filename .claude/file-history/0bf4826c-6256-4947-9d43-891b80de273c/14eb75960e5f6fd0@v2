/* Tier-2 fixture: the "no redundant ELF reload" rule (2-phase: QEMU1 -> vsim).
 *
 *   QEMU 1: seeds `static uint32_t buf[N]` in .bss with a deterministic
 *           pattern.
 *   vsim:   crosses the enter_vsim/exit_vsim boundary without touching buf,
 *           then drains. The exit_vsim "memory" clobber anchors the phase-1
 *           seed stores so the compiler cannot drop them.
 *
 * Without the rule, vsim's elf_loader `std::fill_n(memsz - filesz, 0)` over
 * the PT_LOAD covering .bss would wipe the phase-1 seed; with the rule, the
 * shared mmap retains the bytes across the QEMU1 -> vsim handoff.
 *
 * (The old phase-3 QEMU2 read-back + verify was removed with the QEMU2 leg,
 * so the fixture now exercises the seed + drain path only.)
 *
 * Memory layout: buf lives in .bss inside the shared mmap (allocated by
 * the linker right after .data; see rt_c.ld). Stack is at 0x00700000. */

#include "runtime/rt_c_helpers.h"

#include <stdint.h>

#define N 64

static uint32_t buf[N];

static uint32_t pattern(int i)
{
  return (uint32_t)((uint32_t) i * 0xDEADBEEFu + 0x12345678u);
}

int main(void)
{
  for (int i = 0; i < N; i++)
    buf[i] = pattern(i);

  enter_vsim();
  /* Phase 2: no-op. The whole point is to verify that crossing the
   * vsim boundary does not zero .bss. */
  exit_vsim();

  return 0;
}
