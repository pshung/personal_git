// B7: doctest for the QEMU-plugin V-drain decision function.
//
// The plugin's V-state drain used to gate on `v->vlenb` (the register
// handle truthiness) AND `s.vlenb > 0`. The combination silently omits
// the V block whenever the stub advertises some V state but not vlenb,
// confusing "stub broke" with "V disabled at runtime". This test pins
// the four-case truth table: SKIP when no V at all, ABORT when partial,
// SKIP when V advertised but disabled (vlenb=0), OK otherwise.

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/v_drain_policy.h"

TEST_CASE("no V advertised at all -> SKIP")
{
  CHECK(hybrid_v_drain_policy(/*has_vlenb=*/0, /*has_other_v=*/0,
                              /*vlenb_value=*/0)
        == HYBRID_V_DRAIN_SKIP);
}

TEST_CASE("vlenb missing but vtype/vl/etc advertised -> ABORT")
{
  // The "broken stub" case the original gate hid. Don't silently emit a
  // zero-filled V block: the resume side then restores garbage V state.
  CHECK(hybrid_v_drain_policy(/*has_vlenb=*/0, /*has_other_v=*/1,
                              /*vlenb_value=*/0)
        == HYBRID_V_DRAIN_ABORT);
}

TEST_CASE("vlenb advertised but value=0 -> SKIP (V disabled at runtime)")
{
  // QEMU may expose the V feature in XML even when V is not enabled in
  // the CPU at runtime; vlenb then reads 0. Treat as "no V live".
  CHECK(hybrid_v_drain_policy(/*has_vlenb=*/1, /*has_other_v=*/1,
                              /*vlenb_value=*/0)
        == HYBRID_V_DRAIN_SKIP);
}

TEST_CASE("vlenb advertised, value>0 -> OK")
{
  CHECK(hybrid_v_drain_policy(/*has_vlenb=*/1, /*has_other_v=*/1,
                              /*vlenb_value=*/16)
        == HYBRID_V_DRAIN_OK);
  CHECK(hybrid_v_drain_policy(/*has_vlenb=*/1, /*has_other_v=*/1,
                              /*vlenb_value=*/64)
        == HYBRID_V_DRAIN_OK);
}

TEST_CASE("vlenb advertised alone (no other V) is still ABORT-equivalent: "
          "policy treats vlenb-only as no V context")
{
  // Edge case: stub advertises vlenb but no other V regs. This is
  // unusual; treat as SKIP since we have no V data to actually drain.
  // (Documented behaviour, not a runtime failure mode QEMU emits.)
  CHECK(hybrid_v_drain_policy(/*has_vlenb=*/1, /*has_other_v=*/0,
                              /*vlenb_value=*/16)
        == HYBRID_V_DRAIN_SKIP);
}
