#include "cli.hpp"

namespace andes_sim {
namespace {

// Try to read an option's value at args[i]. Supports both `--flag value`
// (consumes the next token, advancing i) and `--flag=value`.
//   returns  1 = matched, `out` set
//            0 = this token is not `flag`
//           -1 = matched `--flag` but no value follows
int match_opt(const std::vector<std::string>& args, size_t& i,
              const std::string& flag, std::string& out) {
  const std::string& a = args[i];
  if (a == flag) {
    if (i + 1 >= args.size()) return -1;
    out = args[++i];
    return 1;
  }
  const std::string pfx = flag + "=";
  if (a.size() >= pfx.size() && a.compare(0, pfx.size(), pfx) == 0) {
    out = a.substr(pfx.size());
    return 1;
  }
  return 0;
}

}  // namespace

Cli parse_cli(const std::vector<std::string>& args) {
  Cli c;
  if (args.empty()) return c;  // no subcommand; caller prints usage

  // First token is the subcommand, unless it is a top-level help request.
  if (args[0] == "-h" || args[0] == "--help") {
    c.help = true;
    return c;
  }
  c.subcommand = args[0];

  for (size_t i = 1; i < args.size(); ++i) {
    const std::string& a = args[i];

    if (a == "--") {  // the passthrough boundary: rest is verbatim
      c.has_passthrough = true;
      for (size_t j = i + 1; j < args.size(); ++j) c.passthrough.push_back(args[j]);
      break;
    }
    if (a == "-h" || a == "--help") {
      c.help = true;
      continue;
    }

    int r;
    if ((r = match_opt(args, i, "--model", c.model)) != 0) {
      if (r < 0) { c.error = "missing value for --model"; return c; }
      continue;
    }
    if ((r = match_opt(args, i, "--engine", c.engine)) != 0) {
      if (r < 0) { c.error = "missing value for --engine"; return c; }
      continue;
    }
    if ((r = match_opt(args, i, "--trigger", c.trigger)) != 0) {
      if (r < 0) { c.error = "missing value for --trigger"; return c; }
      continue;
    }

    if (a.size() > 1 && a[0] == '-') {
      c.error = "unknown option: " + a;
      return c;
    }
    c.positional.push_back(a);
  }

  return c;
}

Cli parse_cli(int argc, char** argv) {
  std::vector<std::string> args;
  args.reserve(argc > 1 ? static_cast<size_t>(argc - 1) : 0);
  for (int i = 1; i < argc; ++i) args.emplace_back(argv[i]);
  return parse_cli(args);
}

}  // namespace andes_sim
