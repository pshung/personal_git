// A small, dependency-free JSON reader for andes-sim.
//
// The framework may depend only on libc++ + the shared ABI header, so it
// cannot pull in a third-party JSON library. This parser covers exactly what
// engine descriptors (and later cluster/meta files) need: objects, arrays,
// strings (with the standard escapes), numbers, and the true/false/null
// literals. It is strict -- trailing junk is an error -- and never throws or
// crashes on malformed input; it reports `ok=false` instead.
#ifndef ANDES_SIM_JSON_HPP
#define ANDES_SIM_JSON_HPP

#include <cstdint>
#include <string>
#include <string_view>
#include <vector>

namespace andes_sim::json {

// Object members are held as parallel keys[]/vals[] rather than a
// vector<pair<string,Value>>: std::vector supports an incomplete value type
// (needed for this recursive struct), but std::pair does not.
struct Value {
  enum class Type { Null, Bool, Number, String, Array, Object };
  Type type = Type::Null;
  bool b = false;
  double num = 0;
  std::string str;
  std::vector<Value> arr;          // array elements
  std::vector<std::string> keys;   // object member names (parallel to vals)
  std::vector<Value> vals;         // object member values

  bool is_object() const { return type == Type::Object; }
  bool is_array() const { return type == Type::Array; }
  bool is_string() const { return type == Type::String; }
  bool is_number() const { return type == Type::Number; }

  // Object member lookup; nullptr if not an object or key absent.
  const Value* find(std::string_view key) const {
    if (type != Type::Object) return nullptr;
    for (size_t k = 0; k < keys.size(); ++k)
      if (keys[k] == key) return &vals[k];
    return nullptr;
  }

  std::string as_string(const std::string& dflt = "") const {
    return type == Type::String ? str : dflt;
  }
  long as_int(long dflt = 0) const {
    return type == Type::Number ? static_cast<long>(num) : dflt;
  }
  // For arrays of strings; non-string elements are skipped.
  std::vector<std::string> as_string_array() const {
    std::vector<std::string> out;
    if (type == Type::Array)
      for (const Value& e : arr)
        if (e.type == Type::String) out.push_back(e.str);
    return out;
  }
};

struct Parsed {
  bool ok = false;
  Value value;
  std::string error;
};

namespace detail {

struct Parser {
  std::string_view s;
  size_t i = 0;
  std::string err;

  bool fail(const char* m) {
    if (err.empty()) err = m;
    return false;
  }
  void skip_ws() {
    while (i < s.size() &&
           (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r'))
      ++i;
  }

  static void encode_utf8(uint32_t cp, std::string& out) {
    if (cp < 0x80) {
      out.push_back(static_cast<char>(cp));
    } else if (cp < 0x800) {
      out.push_back(static_cast<char>(0xC0 | (cp >> 6)));
      out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
    } else {
      out.push_back(static_cast<char>(0xE0 | (cp >> 12)));
      out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
      out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
    }
  }

  bool parse_string(std::string& out) {
    if (i >= s.size() || s[i] != '"') return fail("expected string");
    ++i;
    while (i < s.size()) {
      char c = s[i++];
      if (c == '"') return true;
      if (c == '\\') {
        if (i >= s.size()) return fail("dangling escape");
        char e = s[i++];
        switch (e) {
          case '"': out.push_back('"'); break;
          case '\\': out.push_back('\\'); break;
          case '/': out.push_back('/'); break;
          case 'b': out.push_back('\b'); break;
          case 'f': out.push_back('\f'); break;
          case 'n': out.push_back('\n'); break;
          case 'r': out.push_back('\r'); break;
          case 't': out.push_back('\t'); break;
          case 'u': {
            if (i + 4 > s.size()) return fail("bad \\u escape");
            uint32_t cp = 0;
            for (int k = 0; k < 4; ++k) {
              char h = s[i++];
              cp <<= 4;
              if (h >= '0' && h <= '9') cp |= static_cast<uint32_t>(h - '0');
              else if (h >= 'a' && h <= 'f') cp |= static_cast<uint32_t>(h - 'a' + 10);
              else if (h >= 'A' && h <= 'F') cp |= static_cast<uint32_t>(h - 'A' + 10);
              else return fail("bad hex in \\u escape");
            }
            encode_utf8(cp, out);
            break;
          }
          default: return fail("bad escape char");
        }
      } else {
        out.push_back(c);
      }
    }
    return fail("unterminated string");
  }

  bool parse_number(Value& out) {
    size_t start = i;
    if (i < s.size() && s[i] == '-') ++i;
    while (i < s.size() && s[i] >= '0' && s[i] <= '9') ++i;
    if (i < s.size() && s[i] == '.') {
      ++i;
      while (i < s.size() && s[i] >= '0' && s[i] <= '9') ++i;
    }
    if (i < s.size() && (s[i] == 'e' || s[i] == 'E')) {
      ++i;
      if (i < s.size() && (s[i] == '+' || s[i] == '-')) ++i;
      while (i < s.size() && s[i] >= '0' && s[i] <= '9') ++i;
    }
    if (i == start) return fail("invalid number");
    std::string tok(s.substr(start, i - start));
    try {
      out.type = Value::Type::Number;
      out.num = std::stod(tok);
    } catch (...) {
      return fail("unparseable number");
    }
    return true;
  }

  bool parse_lit(std::string_view lit, Value v, Value& out) {
    if (s.substr(i, lit.size()) != lit) return fail("invalid literal");
    i += lit.size();
    out = std::move(v);
    return true;
  }

  bool parse_array(Value& out) {
    ++i;  // consume '['
    out.type = Value::Type::Array;
    skip_ws();
    if (i < s.size() && s[i] == ']') { ++i; return true; }
    while (true) {
      Value e;
      if (!parse_value(e)) return false;
      out.arr.push_back(std::move(e));
      skip_ws();
      if (i >= s.size()) return fail("unterminated array");
      if (s[i] == ',') { ++i; skip_ws(); continue; }
      if (s[i] == ']') { ++i; return true; }
      return fail("expected ',' or ']'");
    }
  }

  bool parse_object(Value& out) {
    ++i;  // consume '{'
    out.type = Value::Type::Object;
    skip_ws();
    if (i < s.size() && s[i] == '}') { ++i; return true; }
    while (true) {
      skip_ws();
      std::string key;
      if (!parse_string(key)) return false;
      skip_ws();
      if (i >= s.size() || s[i] != ':') return fail("expected ':'");
      ++i;
      Value val;
      if (!parse_value(val)) return false;
      out.keys.push_back(std::move(key));
      out.vals.push_back(std::move(val));
      skip_ws();
      if (i >= s.size()) return fail("unterminated object");
      if (s[i] == ',') { ++i; continue; }
      if (s[i] == '}') { ++i; return true; }
      return fail("expected ',' or '}'");
    }
  }

  bool parse_value(Value& out) {
    skip_ws();
    if (i >= s.size()) return fail("unexpected end of input");
    char c = s[i];
    if (c == '"') {
      out.type = Value::Type::String;
      return parse_string(out.str);
    }
    if (c == '{') return parse_object(out);
    if (c == '[') return parse_array(out);
    if (c == 't') { Value v; v.type = Value::Type::Bool; v.b = true; return parse_lit("true", std::move(v), out); }
    if (c == 'f') { Value v; v.type = Value::Type::Bool; v.b = false; return parse_lit("false", std::move(v), out); }
    if (c == 'n') { Value v; v.type = Value::Type::Null; return parse_lit("null", std::move(v), out); }
    if (c == '-' || (c >= '0' && c <= '9')) return parse_number(out);
    return fail("unexpected character");
  }
};

}  // namespace detail

inline Parsed parse(std::string_view text) {
  detail::Parser p{};
  p.s = text;
  Parsed result;
  p.skip_ws();
  if (!p.parse_value(result.value)) {
    result.ok = false;
    result.error = p.err.empty() ? "parse error" : p.err;
    return result;
  }
  p.skip_ws();
  if (p.i != p.s.size()) {
    result.ok = false;
    result.error = "trailing characters after JSON value";
    return result;
  }
  result.ok = true;
  return result;
}

}  // namespace andes_sim::json

#endif  // ANDES_SIM_JSON_HPP
