#!/usr/bin/env bash
# F4 contract: `build` (delegates to setup.sh / scripts/build_*.sh / make).
#
#   1. `build --dry-run [--what T]` prints the underlying commands and matches
#      `python3 hsim build --dry-run [--what T]` byte-for-byte (rc included) for
#      every target (default + all/qemu/vsim/plugin/simpoint/fixtures).
#   2. A real `build --what plugin` SUCCEEDS (rc 0): it spawns
#      `make -C qemu_plugin` with an absolute QEMU_ROOT (CWD-independent, like
#      setup.sh), inherits the child's stdio, emits the [andes-sim] banner, and
#      the golden agrees on the exit code. (The banner only shows on real runs,
#      so it is not parity-scoped and uses the new driver name.)
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

BIN="$ROOT/build/andes-sim"
GOLDEN="$ROOT/hsim"

bash "$ROOT/scripts/build_driver.sh" >/dev/null 2>&1 || fail "build_driver.sh failed"
[ -x "$BIN" ] || fail "missing executable: $BIN"

# 1. dry-run parity for every target (default form + each explicit --what)
check_dry() {  # $@ = build args after the subcommand
  local g n grc nrc
  g=$(cd "$ROOT" && "$GOLDEN" build "$@" 2>&1);  grc=$?
  n=$(cd "$ROOT" && "$BIN" build "$@" 2>&1);      nrc=$?
  [ "$grc" = "$nrc" ] || fail "build $* rc differs: golden=$grc new=$nrc"
  [ "$g" = "$n" ] || {
    diff <(printf '%s\n' "$g") <(printf '%s\n' "$n") >&2
    fail "build $* dry-run output differs from golden"
  }
}
check_dry --dry-run
for w in all qemu vsim plugin simpoint fixtures; do
  check_dry --dry-run --what "$w"
done

# 2. a real plugin build succeeds even when a REBUILD is needed. Force the .so
#    stale so make runs the compile recipe -- that recipe is where the old
#    relative QEMU_ROOT=./QEMU failed the header check (./QEMU resolves under
#    make's -C dir). An absolute QEMU_ROOT must make it compile clean (rc 0).
touch "$ROOT/qemu_plugin/hybrid_handoff.c"  # invalidate libhybrid_handoff.so
n=$(cd "$ROOT" && "$BIN" build --what plugin 2>&1);  nrc=$?
[ "$nrc" = "0" ] || { printf '%s\n' "$n" >&2; fail "real build --what plugin failed (rc=$nrc)"; }
echo "$n" | grep -qE '^\[andes-sim\] make -C qemu_plugin QEMU_ROOT=.*/QEMU$' \
  || fail "real build did not emit the plugin banner:"$'\n'"$n"
echo "$n" | grep -q '^cc ' \
  || fail "plugin was not actually recompiled (recipe skipped?):"$'\n'"$n"

ok "F4 build"
