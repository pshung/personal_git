// Placeholder substitution for engine invoke templates. See argv.hpp.
#include "argv.hpp"

namespace andes_sim {
namespace {

// Expand every "{key}" in `s` from `ctx`. A "{" with no closing "}" is a
// literal. An unknown key sets `err` and returns false (out is undefined).
bool subst(const std::string& s, const std::map<std::string, std::string>& ctx,
           std::string& out, std::string& err) {
  out.clear();
  for (size_t i = 0; i < s.size();) {
    if (s[i] != '{') {
      out += s[i++];
      continue;
    }
    const size_t close = s.find('}', i + 1);
    if (close == std::string::npos) {  // unbalanced brace: keep literally
      out += s[i++];
      continue;
    }
    const std::string key = s.substr(i + 1, close - i - 1);
    const auto it = ctx.find(key);
    if (it == ctx.end()) {
      err = "unknown placeholder '{" + key + "}'";
      return false;
    }
    out += it->second;
    i = close + 1;
  }
  return true;
}

}  // namespace

std::vector<std::string> build_argv(const std::vector<std::string>& tmpl,
                                    const std::map<std::string, std::string>& ctx,
                                    std::string& err) {
  std::vector<std::string> out;
  out.reserve(tmpl.size());
  for (const std::string& arg : tmpl) {
    std::string filled;
    if (!subst(arg, ctx, filled, err)) return {};
    out.push_back(std::move(filled));
  }
  err.clear();
  return out;
}

}  // namespace andes_sim
