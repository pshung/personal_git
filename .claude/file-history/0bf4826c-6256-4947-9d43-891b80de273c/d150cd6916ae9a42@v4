// andes-sim -- multi-engine driver for the Andes simulators (QEMU, Verilator,
// and future backends). One C++20 binary that selects a model (fast / accurate
// / hybrid), resolves engines at runtime, and either passes through to a single
// engine or orchestrates a hybrid round-trip.
//
// This file owns argument dispatch only: parse the CLI, route to a command.
// Each subcommand below resolves to its handler as its feature lands (F1-F13);
// until then it stubs out, keeping the command surface stable.
#include <cstdio>
#include <exception>
#include <string>
#include <string_view>

#include "cli.hpp"
#include "repo_root.hpp"

namespace andes_sim {
int cmd_list(const Cli& cli);
int cmd_doctor(const Cli& cli);
}  // namespace andes_sim

namespace {

using andes_sim::Cli;

struct Subcommand {
  std::string_view name;
  std::string_view brief;
};

// The full command surface. Names are fixed from F0 so usage, dispatch, and
// tests are stable; handlers arrive feature by feature.
constexpr Subcommand kSubcommands[] = {
    {"build", "build artifacts (qemu, vsim, plugin, simpoint, fixtures, driver)"},
    {"run", "run one simulation (--model fast|accurate|hybrid)"},
    {"test", "run the end-to-end suite"},
    {"list", "list fixtures|models|engines"},
    {"doctor", "check environment health"},
    {"profile", "profile a workload into a basic-block vector"},
    {"cluster", "cluster a BBV into SimPoint phases"},
    {"archive", "snapshot a drained state into a replayable dir"},
    {"replay", "replay a snapshot"},
    {"estimate", "whole-program cycle estimate (run --model hybrid --trigger simpoint)"},
};

const Subcommand* find(std::string_view name) {
  for (const Subcommand& s : kSubcommands)
    if (s.name == name) return &s;
  return nullptr;
}

void print_usage(std::FILE* out) {
  std::fputs("usage: andes-sim <cmd> [args...]\n\n", out);
  std::fputs("Multi-engine driver for the Andes simulators (QEMU + Verilator).\n\n",
             out);
  std::fputs("commands:\n", out);
  for (const Subcommand& s : kSubcommands)
    std::fprintf(out, "  %-9.*s  %.*s\n", static_cast<int>(s.name.size()),
                 s.name.data(), static_cast<int>(s.brief.size()), s.brief.data());
}

void print_subcommand_help(const Subcommand& sc, std::FILE* out) {
  std::fprintf(out, "usage: andes-sim %.*s [args...]\n\n",
               static_cast<int>(sc.name.size()), sc.name.data());
  std::fprintf(out, "%.*s\n", static_cast<int>(sc.brief.size()), sc.brief.data());
  if (sc.name == "run") {
    std::fputs(
        "\nselection:\n"
        "  --model fast|accurate|hybrid       which composition to run\n"
        "  --engine <id>                      pick a specific engine "
        "(e.g. verilator:ax45mpv_premium)\n"
        "  --trigger csr|pc|icount|simpoint   ROI delimiter (hybrid only)\n"
        "  -- <args...>                       forward everything after -- "
        "verbatim to the engine\n",
        out);
  } else if (sc.name == "list") {
    std::fputs("\ntargets: fixtures | models | engines\n", out);
  }
}

}  // namespace

int main(int argc, char** argv) {
  using namespace andes_sim;

  Cli cli = parse_cli(argc, argv);
  if (!cli.error.empty()) {
    std::fprintf(stderr, "andes-sim: %s\n", cli.error.c_str());
    return 2;
  }

  if (cli.subcommand.empty()) {  // no command, or top-level -h
    if (cli.help) {
      print_usage(stdout);
      return 0;
    }
    print_usage(stderr);
    return 2;
  }

  const Subcommand* sc = find(cli.subcommand);
  if (!sc) {
    std::fprintf(stderr, "andes-sim: unknown command '%s'\n\n",
                 cli.subcommand.c_str());
    print_usage(stderr);
    return 2;
  }

  if (cli.help) {
    print_subcommand_help(*sc, stdout);
    return 0;
  }

  if (cli.subcommand == "list") return cmd_list(cli);
  if (cli.subcommand == "doctor") return cmd_doctor(cli);

  // Remaining subcommands stub out until their feature lands. Resolve the repo
  // root so the discovery path stays live and observable.
  std::string root;
  try {
    root = repo_root().string();
  } catch (const std::exception& e) {
    root = std::string("<unknown: ") + e.what() + ">";
  }
  std::fprintf(stderr, "andes-sim %s: not yet implemented (repo root: %s)\n",
               cli.subcommand.c_str(), root.c_str());
  return 3;
}
