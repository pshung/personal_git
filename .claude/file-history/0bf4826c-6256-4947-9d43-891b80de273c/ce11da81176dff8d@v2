/* Tier-2 C-level fixture: 16x16x16 GEMM (2-phase: QEMU1 -> vsim).
 *
 *   QEMU 1: init_matrices -- fills A and B with deterministic patterns.
 *   vsim:   matmul_kernel -- pure C = A * B, no syscalls (phase-2 rule).
 *           C is written to .bss inside the ROI; the exit_vsim "memory"
 *           clobber anchors the stores so the kernel is not eliminated.
 *           vsim drains at the exit marker and exits 200.
 *
 * (The old phase-3 QEMU2 print + independent re-verify was removed with the
 * QEMU2 leg; the fixture now validates that the GEMM kernel runs and drains.)
 *
 * Cross-phase memory survival
 *   Matrices sit in .bss. The "no redundant ELF reload" rule keeps phase-1
 *   .bss writes intact through the shared memory-backend-file.
 */
#include "runtime/rt_c_helpers.h"

#include <stdint.h>

#define N 16

static int32_t A[N * N];
static int32_t B[N * N];
static int32_t C[N * N];

#define AT(M, i, j) ((M)[(i) *N + (j)])

static void init_matrices(void)
{
  for (int i = 0; i < N; i++) {
    for (int j = 0; j < N; j++) {
      AT(A, i, j) = (int32_t) ((i + j) % 7);
      AT(B, i, j) = (int32_t) ((i * 3 + j) % 5);
    }
  }
}

static void matmul_kernel(void)
{
  for (int i = 0; i < N; i++) {
    for (int j = 0; j < N; j++) {
      int32_t s = 0;
      for (int k = 0; k < N; k++) {
        s += AT(A, i, k) * AT(B, k, j);
      }
      AT(C, i, j) = s;
    }
  }
}

int main(void)
{
  /* Phase 1 (QEMU 1): seed inputs. */
  init_matrices();

  enter_vsim();

  /* Phase 2 (vsim): GEMM kernel only. No syscalls. */
  matmul_kernel();

  exit_vsim();

  return 0;
}
