#!/usr/bin/env bash
# Bench: CSR restore via per-CSR Abstract Commands vs batched PB csr_sweep.
# Runs the two hybrid legs (same as tests/e2e.sh) per variant and extracts
# the new "hybrid: resume=" cycle line from the vsim log.
#
# Variants:
#   A  abstract restore, --no-reset-baseline   (transport-everything, today's mechanism)
#   B  PB sweep restore, --no-reset-baseline   (HYBRID_RESTORE_CSR_SWEEP=1)
#   C  abstract restore + reset baseline       (the shipped default, for context)
set -euo pipefail

FIXTURE="${FIXTURE:-rt_csr_survival}"
QEMU_CPU="${QEMU_CPU:-andes-ax45mpv,vlen=512}"
TIMEOUT="${TIMEOUT:-300}"

. /home/nick/work/andesim/config.env
. /home/nick/work/andesim/tests/lib/paths.sh
hybrid_resolve_paths

VLEN_BYTES_MAX=128
PROGRAM_SIZE=$((128 * 1024 * 1024))
SHARED_SIZE=$((PROGRAM_SIZE + 32 * VLEN_BYTES_MAX))

run_variant() {  # $1=name  $2=sweep(0|1)  $3=baseline(0|1)
    local name=$1 sweep=$2 baseline=$3
    local shared state_q state_v log
    shared=$(mktemp -p /dev/shm csrbench.XXXXXX)
    state_q=$(mktemp); state_v=$(mktemp); log=$BENCH_DIR/vsim_$name.log
    truncate -s "$SHARED_SIZE" "$shared"

    "$VSIM_QEMU" \
      -object "memory-backend-file,id=mem,share=on,mem-path=$shared,size=$SHARED_SIZE" \
      -machine andes_ae350,memory-backend=mem \
      -cpu "$QEMU_CPU" -nographic \
      -semihosting-config enable=on,target=native \
      -bios "$VSIM_ELF" \
      -plugin "$VSIM_PLUGIN,outfile=$state_q" </dev/null >/dev/null 2>&1 || rc=$?
    [ "${rc:-0}" -ne 200 ] && { echo "FAIL[$name]: QEMU1 rc=${rc:-0}"; return 1; }
    rc=0

    local extra=() env_prefix=(env -u HYBRID_RESTORE_CSR_SWEEP)
    [ "$baseline" = 0 ] && extra+=(--no-reset-baseline)
    [ "$sweep" = 1 ] && env_prefix=(env HYBRID_RESTORE_CSR_SWEEP=1)

    local t0 t1
    t0=$(date +%s.%N)
    "${env_prefix[@]}" timeout "$TIMEOUT" "$VSIM_BIN" "$VSIM_ELF" \
      --resume-from-qemu "$state_q" \
      --handoff-out "$state_v" \
      --shared-mem-path "$shared" \
      --shared-mem-size "$SHARED_SIZE" \
      --shared-mem-base 0x00000000 "${extra[@]}" </dev/null >"$log" 2>&1 || rc=$?
    t1=$(date +%s.%N)
    [ "${rc:-0}" -ne 200 ] && { echo "FAIL[$name]: vsim rc=${rc:-0}"; tail -5 "$log"; return 1; }

    read_u64() { od -A n -j "$1" -N 8 -t u8 "$2" | tr -d ' \n'; }
    local kc=$(( $(read_u64 624 "$state_v") - $(read_u64 624 "$state_q") ))
    local resume_line
    resume_line=$(grep "hybrid: resume=" "$log" || echo "MISSING-RESUME-LINE")
    echo "[$name] wall=$(printf '%.1f' "$(echo "$t1 - $t0" | bc)")s kernel_cycles=$kc"
    echo "[$name] $resume_line"
    rm -f "$shared" "$state_q" "$state_v"
}

BENCH_DIR="${BENCH_DIR:-$(mktemp -d)}"
mkdir -p "$BENCH_DIR"
echo "logs in $BENCH_DIR"
run_variant A 0 0
run_variant B 1 0
run_variant C 0 1
