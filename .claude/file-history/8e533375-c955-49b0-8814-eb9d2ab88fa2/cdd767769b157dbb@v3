#!/usr/bin/env python3
"""Pull the real kernels out of the repo and render them for the page.

The stage sections used to carry a hand-written sketch of each inner loop.
A sketch drifts. These blocks are extracted from the source at build time, so
what the page shows is what the compiler sees, with the file and line to check.
"""
import os, pathlib, re, sys

REPO = pathlib.Path(os.environ.get("LLAMA_REPO", "/home/nick/work/llama.cpp"))

RISCV = "ggml/src/ggml-cpu/arch/riscv"
SNIPPETS = {
    "s01": (RISCV + "/quants.c", "ggml_vec_dot_q1_0_q8_0_vl256"),
    "s02": (RISCV + "/repack.cpp", "q1_gemv_64x1_vl1024"),
    "s03": (RISCV + "/repack.cpp", "q1_prefetch_block"),
    "s04dot": (RISCV + "/repack.cpp", "q1_vd4dots_x4_m2"),
    "s04": (RISCV + "/repack.cpp", "q1_gemv_64d4_vl1024"),
    "act_q": ("ggml/src/ggml-cpu/repack.cpp", "ggml_quantize_mat_q8_0_4x1_generic"),
    "act_g": (RISCV + "/repack.cpp", "q1_gemm_64d4_vl1024"),
}

# what each block is here to show; asserted, so a rename breaks the build
MUST_CONTAIN = {
    "s01": ["__riscv_vsetvl_e8m1(32)", "vwredsum"],
    "s02": ["vint16m1_t sumi", "__riscv_vlm_v_b16"],
    "s03": ["__builtin_prefetch", "always_inline"],
    "s04dot": ["nds.vd4dots.vv", "vsetvli"],
    "s04": ["q1_vd4dots_x4_m2", "__riscv_vlm_v_b4"],
    "act_q": ["blck_size_interleave", "src_id"],
    "act_g": ["__riscv_vnsrl_wx_u16mf2", "de-interleaved"],
}

HOT = ("q1_vd4dots_x4_m2", "nds.vd4dots.vv")
BAD = ("vwredsum",)


def extract(rel, name):
    """The whole function, from its definition line to the closing brace."""
    src = (REPO / rel).read_text().splitlines()
    start = None
    for i, line in enumerate(src):
        if re.match(r"^[A-Za-z_].*\b%s\s*\(" % re.escape(name), line) and ";" not in line:
            start = i
            break
    if start is None:
        sys.exit("%s not found in %s" % (name, rel))
    # take the decoration and the one-line label above it, if any:
    # "static inline __attribute__((always_inline))" is load-bearing here
    while start > 0:
        prev = src[start - 1].strip()
        if prev.startswith("//"):
            start -= 1
        elif prev and not prev.startswith("#") and prev[-1] not in ";}{":
            start -= 1
        else:
            break
    for j in range(start, len(src)):
        if src[j] == "}":
            return "\n".join(src[start:j + 1]), start + 1
    sys.exit("%s: no closing brace" % name)


def esc(t):
    return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def colour(code):
    out = []
    for line in code.split("\n"):
        body, sep, comment = line.partition("//")
        body = esc(body)
        for word in HOT:
            body = body.replace(esc(word), '<span class="hot">%s</span>' % esc(word))
        for word in BAD:
            body = re.sub(r"(__riscv_\w*%s\w*)" % word,
                          r'<span class="bad">\1</span>', body)
        body = re.sub(r"(?<!>)(__riscv_v\w+)", r'<span class="op">\1</span>', body)
        out.append(body + ('<span class="cm">//%s</span>' % esc(comment) if sep else ""))
    return "\n".join(out)


def block(key):
    rel, name = SNIPPETS[key]
    code, line = extract(rel, name)
    for need in MUST_CONTAIN[key]:
        if need not in code:
            sys.exit("%s: %r missing - did the kernel change?" % (name, need))
    return ('<p class="srchead">%s<span>:%d</span></p>\n<div class="ops src">%s</div>'
            % (rel, line, colour(code)))


def pair(a, b):
    return block(a) + "\n" + block(b)


if __name__ == "__main__":
    for k in SNIPPETS:
        rel, name = SNIPPETS[k]
        code, line = extract(rel, name)
        print("%-7s %-32s %s:%d  %d lines" % (k, name, rel.split("/")[-1], line,
                                              code.count("\n") + 1))
