"""The built page must be well-formed and must actually contain the new figures."""
import pathlib, re
from html.parser import HTMLParser

import example as ex

PAGE = pathlib.Path(__file__).parent / "q1_kernel_walkthrough.html"
VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
        "param", "source", "track", "wbr", "path", "rect", "circle", "use", "stop"}


class Balance(HTMLParser):
    def __init__(self):
        super().__init__()
        self.stack, self.errors = [], []

    def handle_starttag(self, tag, attrs):
        if tag not in VOID:
            self.stack.append((tag, self.getpos()))

    def handle_endtag(self, tag):
        if tag in VOID:
            return
        if not self.stack:
            self.errors.append("stray </%s> at %s" % (tag, self.getpos()))
        elif self.stack[-1][0] != tag:
            self.errors.append("</%s> closes <%s> opened at %s"
                               % (tag, self.stack[-1][0], self.stack[-1][1]))
            self.stack.pop()
        else:
            self.stack.pop()


def page():
    return PAGE.read_text()


def test_the_document_tags_are_balanced():
    b = Balance()
    b.feed(page())
    assert b.errors == []
    assert [t for t, _ in b.stack] == []


def test_the_worked_example_section_is_in_the_page():
    p = page()
    assert 'id="example"' in p
    assert p.count('<svg class="fig"') == 6
    assert '<a href="#example">Worked example</a>' in p


def test_the_figures_carry_the_computed_numbers():
    p = page()
    for v in ex.y_ref():
        assert ">%d</text>" % v in p
    for b in ex.plane_major_bytes():
        assert "0x%02X" % b in p


def test_the_page_no_longer_carries_the_non_optimization_material():
    p = page()
    for gone in ('id="traps"', 'id="left"', "Did not work", "Trap 01", "Trap 02",
                 "Trap 03", "never repacked", "Why it was skipped",
                 "fails the repack gate", "instruction-issue floor"):
        assert gone not in p, gone


def test_every_nav_link_points_at_a_real_section():
    p = page()
    ids = set(re.findall(r'<section class="sec" id="([^"]+)"', p))
    ids |= set(re.findall(r'<(?:header|section)[^>]*id="([^"]+)"', p))
    for href in re.findall(r'<a href="#([^"]+)">', p):
        assert href in ids, href


def test_the_typography_stays_inside_the_subsetted_font():
    p = re.sub(r"src:url\(data:font/woff2;base64,[^)]*\)", "", page())
    bad = {c for c in p if ord(c) > 126 and c not in "\n\t"}
    assert bad == set()
