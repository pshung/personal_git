#!/usr/bin/env python3
"""Apply the blockers a first-time reader hit, from the fresh-eyes review.

Every one of these is a term, a fact or a definition that the page used before
it supplied it, or supplied only behind a disclosure.
"""
import pathlib, sys

SRC = pathlib.Path(__file__).parent / "q1_page.src.html"
s = SRC.read_text()


def sub(old, new, why):
    global s
    if s.count(old) != 1:
        sys.exit("%s: anchor matched %d times" % (why, s.count(old)))
    s = s.replace(old, new)
    print("  ok  %s" % why)


# 1. decode and prefill carry every number on the page and were defined last,
#    inside a disclosure. Define them before the first pair of numbers.
sub('''      fixing that.
    </p>''',
    '''      fixing that.
    </p>
    <p class="standfirst" style="margin-top:1rem">
      Two things are being timed throughout, and they are not the same shape of work.
      <b>Decode</b> is generating text: one token at a time, so the weight matrix is
      multiplied by <b>a single activation vector</b> and every weight is read once and used
      once. <b>Prefill</b> is reading the prompt: the same matrix meets <b>four activation
      vectors at once</b>, so every weight read is used four times. That difference decides
      which changes help which, all the way down.
    </p>''',
    "decode and prefill defined in the opening")

# 2. VLEN, the cache sizes, the layer count and K are load-bearing from the
#    first figure onwards; the spec sheet is an appendix.
sub('''    <!--@FIGPROB@-->''',
    '''    <dl class="spec hero-spec">
      <dt>core</dt><dd>Andes AX46MPV, 1 hart</dd>
      <dt>vector unit</dt><dd>VLEN = 1024 bit</dd>
      <dt>caches</dt><dd>32 KB L1, <b>no L2</b>, 2 MB L3, 64 B lines</dd>
      <dt>model</dt><dd>qwen3, 36 layers, K = 2560</dd>
    </dl>
    <p class="cap" style="max-width:74ch">
      Every number here is a <b>cycle count</b> from a cycle-accurate RTL simulation, not a
      wall-clock time. The full spec sheet is in the appendix.
    </p>

    <!--@FIGPROB@-->''',
    "the target's load-bearing facts moved into the opening")

# 3. which axis is K, and what a tile and a node are: used from figure one
sub('''        <p class="cap">One block is <b>one row, 128 columns</b>. Rows sit one after another in memory.</p>''',
    '''        <p class="cap">One block is <b>one row, 128 columns</b>. Rows sit one after another in memory.</p>
        <p class="cap">
          <b>Columns are K</b>, the dimension the matmul sums over; <b>rows are outputs</b>,
          one output value per row. So a weight matrix here is
          <code>[K x rows]</code> = <code>[2560 x 1024]</code> for the node measured on this
          page. A <b>node</b> is one <code>MUL_MAT</code> in ggml's graph - one of these
          matrices multiplied once. A <b>tile</b> is the working unit every kernel below is
          scored on: <b>64 rows x 128 columns = 8,192 weights</b>. Stage 02 packs exactly that
          into one struct; stage 01 has no such grouping, so the tile is used there purely as
          a common yardstick.
        </p>''',
    "K axis, node and tile defined where the format is")

# 4. "there is no arithmetic left to optimize" against stage 04's 256 MACs
sub('''          work</strong>, and <strong>how many instructions it takes to feed them</strong>.
        </p>''',
    '''          work</strong>, and <strong>how many instructions it takes to feed them</strong>.
        </p>
        <p>
          One thing this sets up, so it does not read as a contradiction later: stage 04 does
          issue real int8 multiplies, by +1 and -1. That is arithmetic nobody needs. It wins
          anyway, because the one instruction doing it replaces four, and
          <strong>instructions are what cost here</strong>, not multiplies.
        </p>''',
    "the apparent contradiction with stage 04 answered up front")


# 6. stage 03's reason was entirely inside a disclosure
sub('''        <p>Decode stalls on weight loads. Each block is 18 cache lines, read once, never reused.</p>''',
    '''        <p>Decode stalls on weight loads. Each block is 1152 B = <b>18 cache lines</b>, read
          once and never reused, and the core's own prefetcher has only <b>4 entries</b> with
          no L2 behind the L1 - it cannot run far enough ahead.</p>''',
    "stage 03's cause surfaced out of its disclosure")

# 7. why prefill gains 5.23x from the repack while decode gains 2.09x
sub('''        <span class="v"><b>2.09x</b> &nbsp; Store the weights by column instead of by row, so
        one load fills 64 lanes with 64 different output rows. The horizontal reduction
        disappears.</span>''',
    '''        <span class="v"><b>2.09x</b> decode, <b>5.23x</b> prefill &nbsp; Store the weights by
        column instead of by row, so one load fills 64 lanes with 64 different output rows.
        The horizontal reduction disappears. Prefill gains more because it reuses each weight
        four times, so removing the reduction leaves it with almost nothing but useful
        work.</span>''',
    "the decode/prefill gap at stage 02 explained where it first appears")

# 8. the hero claimed bit-identical without the qualifier the appendix carries
sub('''        <dt>Output</dt>
        <dd>bit-identical</dd>''',
    '''        <dt>Output vs stage 02</dt>
        <dd>bit-identical</dd>''',
    "the bit-identical claim qualified")

SRC.write_text(s)
print("\n%d bytes" % len(s))
