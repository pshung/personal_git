def extract(rel, name):
    """The whole function, from its definition line to the closing brace."""
    src = (REPO / rel).read_text().splitlines()
    start = None
    for i, line in enumerate(src):
        if re.match(r"^[A-Za-z_].*\b%s\s*\(" % re.escape(name), line) and ";" not in line:
            start = i
            break
    if start is None:
        sys.exit("%s not found in %s" % (name, rel))
    # take the decoration and the one-line label above it, if any:
    # "static inline __attribute__((always_inline))" is load-bearing here
    while start > 0:
        prev = src[start - 1].strip()
        if prev.startswith("//"):
            start -= 1
        elif prev and not prev.startswith("#") and prev[-1] not in ";}{":
            start -= 1
        else:
            break
    for j in range(start, len(src)):
        if src[j] == "}":
            return "\n".join(src[start:j + 1]), start + 1
    sys.exit("%s: no closing brace" % name)


def esc(t):
    return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def colour(line):
    body, sep, comment = line.partition("//")
    body = esc(body)
    for word in HOT:
        body = body.replace(esc(word), '<span class="hot">%s</span>' % esc(word))
    for word in BAD:
        body = re.sub(r"(__riscv_\w*%s\w*)" % word,
                      r'<span class="bad">\1</span>', body)
    body = re.sub(r"(?<!>)(__riscv_v\w+)", r'<span class="op">\1</span>', body)
    return body + ('<span class="cm">//%s</span>' % esc(comment) if sep else "")


def annotate(code, key):
    """Put each note on its own line above the line it is about, indented to
    match it. One whole line, so the test can lift them back out and compare
    what is left against the repo."""
    lines = code.split("\n")
    notes = {}
    for needle, text in NOTES[key]:
        hits = [i for i, l in enumerate(lines) if needle in l]
        if len(hits) != 1:
            sys.exit("%s: %r matches %d lines" % (key, needle, len(hits)))
        notes[hits[0]] = text
    out = []
    for i, line in enumerate(lines):
        if i in notes:
            pad = line[:len(line) - len(line.lstrip())]
            out.append('<span class="an">%s-> %s</span>' % (pad, esc(notes[i])))
        out.append(colour(line))
    return "\n".join(out)


def legend(key):
    rows = "".join("<dt>%s</dt><dd><b>%s</b> %s</dd>" % (esc(tok), esc(val), esc(why))
                   for tok, (val, why) in CONSTANTS[key].items())
    return '<dl class="consts">%s</dl>' % rows


def block(key):
    rel, name = SNIPPETS[key]
    code, line = extract(rel, name)
    for need in MUST_CONTAIN[key]:
        if need not in code:
            sys.exit("%s: %r missing - did the kernel change?" % (name, need))
    return ('<p class="srchead">%s<span>:%d</span></p>\n<div class="ops src">%s</div>\n%s'
            % (rel, line, annotate(code, key), legend(key)))


def pair(a, b):
    return block(a) + "\n" + block(b)


