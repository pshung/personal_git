# --- figure 5: four columns in one instruction ------------------------------

def fig_vd4dots():
    LH, BW, GAP = 28, 24, 10
    GW = BW * 4 + GAP                    # one 32-bit lane = 4 bytes
    X0 = 172
    W = X0 + N * GW + 30
    p = []
    nib = d4_plane_bytes(0)

    def lane_axis(y, label, sub):
        p.append(txt(X0 - 14, y + LH / 2 + 3, label, 12, "var(--ink)", anchor="end",
                     weight=600))
        p.append(txt(X0 - 14, y + LH / 2 + 17, sub, 10, "var(--muted)", anchor="end",
                     font=DISP))

    def quad(x, y, vals, kinds):
        p.append(rect(x - 2, y - 3, BW * 4 + 4, LH + 6, "none", "var(--rule)", 4))
        for k in range(4):
            p.append(cell(x + k * BW + 1, y, BW - 2, LH, vals[k], kinds[k], 10.5, rx=2))

    # memory: each byte covers exactly the two lanes it feeds
    p.append(txt(X0 - 14, 22, "in memory", 12, "var(--ink)", anchor="end", weight=600))
    p.append(txt(X0 - 14, 36, "4 bytes, 8 nibbles", 10, "var(--muted)", anchor="end",
                 font=DISP))
    for i, b in enumerate(nib):
        p.append(cell(X0 + i * 2 * GW + 2, 8, 2 * GW - 4 - GAP, 28, "0x%02X" % b,
                      "hi", 12.5))
        p.append(txt(X0 + i * 2 * GW + GW - GAP / 2, 50, "rows %d-%d" % (2 * i, 2 * i + 1),
                     10, "var(--muted)"))
    p.append(txt(X0 - 14, 50, "one nibble per row", 10, "var(--muted)", anchor="end",
                 font=DISP))

    y1 = 92
    for j in range(N):
        p.append(txt(X0 + j * GW + (GW - GAP) / 2, y1 - 10, "lane %d = row %d" % (j, j),
                     9.5, "var(--muted)"))
    lane_axis(y1, "v12 weights", "one i32 lane = 4 bytes")
    for j in range(N):
        quad(X0 + j * GW, y1, ["+1" if BITS[j][k] else "-1" for k in range(4)],
             ["p" if BITS[j][k] else "m" for k in range(4)])

    y2 = y1 + 58
    lane_axis(y2, "v16 activations", "the same 4 quants everywhere")
    for j in range(N):
        quad(X0 + j * GW, y2, [str(X[k]) for k in range(4)], ["acc"] * 4)

    y3 = y2 + 50
    p.append(rect(X0 - 2, y3, N * GW - GAP + 4, 28, "var(--code-bg)", "var(--plus)",
                  4, 1.3))
    p.append(txt(X0 + (N * GW - GAP) / 2, y3 + 18,
                 "nds.vd4dots.vv v8, v12, v16   --   8 lanes x 4 columns = 32 MACs "
                 "in one instruction", 11.5, "var(--ink)"))

    y4 = y3 + 46
    lane_axis(y4, "v8 accumulator", "i32, one row per lane")
    for j, v in enumerate(d4_partials(0)):
        p.append(cell(X0 + j * GW, y4, GW - GAP, LH, str(v), "hi", 13))
    p.append(txt(X0 + (N * GW - GAP) / 2, y4 + LH + 24,
                 "identical to column c3 of the table above -- four steps folded "
                 "into one", 12, "var(--good)", font=DISP, weight=700))
    return svg(W, y4 + LH + 40, "".join(p))


def render_all():
    return "".join([fig_matrix(), fig_baseline(), fig_permute(), fig_repacked_step(),
                    fig_running_table(), fig_vd4dots()])


