def figbox(fig, label, right, cap, wide=True):
    return ('<div class="figbox%s">\n<div class="panel-label"><span>%s</span>'
            '<span class="r">%s</span></div>\n<div class="figframe">%s</div>\n'
            '<p class="cap">%s</p>\n</div>\n'
            % (" wide" if wide else "", label, right, fig, cap))


def section():
    y = y_ref()
    terms = " ".join("%+d" % term(0, c) for c in range(N))
    return """<!-- ============ WORKED EXAMPLE ============ -->
<section class="sec" id="example">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Before the stages</p>
      <h2>The same problem at 8 x 8, small enough to check by hand</h2>
      <div class="prose">
        <p>
          The real tile is 64 rows by 128 columns, which is too big to draw. So here is the
          identical problem shrunk to <strong>8 rows by 8 columns</strong>. Every number in
          the figures below is real arithmetic, not an illustration: you can add them up
          yourself, and each layout has to reach the same answer.
        </p>
      </div>
    </div>

%s
    <h3 style="margin-top:2.8rem">The problem: one output is spread across eight lanes</h3>
    <div class="prose" style="margin-top:.6rem">
      <p>
        The file stores <strong>one row per byte</strong>. So one mask load fills the lanes
        with one row's eight columns. The eight products are all correct - but they sit in
        eight different lanes, and <code>y[0]</code> is their <em>sum</em>. Adding numbers
        that live in different lanes is a <strong>horizontal reduction</strong>, and it is
        serial.
      </p>
    </div>

%s
    <h3 style="margin-top:2.8rem">The fix: store the matrix by column, not by row</h3>
    <div class="prose" style="margin-top:.6rem">
      <p>
        Write the same 64 bits into the same 8 bytes in a different order. Byte <em>c</em>
        now holds <strong>column c</strong>: its bit <em>r</em> is row <em>r</em>. That is
        the entire repack. No weight is added, dropped or changed.
      </p>
    </div>

%s
%s
%s
    <h3 style="margin-top:2.8rem">Then fold four columns into one instruction</h3>
    <div class="prose" style="margin-top:.6rem">
      <p>
        Permute once more so each lane's <strong>four bytes</strong> are that row's next four
        columns. Now the core's own 4-way dot product does in one instruction what the loop
        above took four steps to do.
      </p>
    </div>

%s
    <div class="pull">
      <p>
        None of this changed the arithmetic. <code>y</code> is <code>%s</code> in every
        figure. The same 64 bits in a different order turned a sum <strong>across lanes</strong>
        into a sum <strong>along the loop</strong>, and that is the whole optimization.
      </p>
    </div>

    <p class="nextup"><b>Now at real size</b>
      64 rows instead of 8, 128 columns instead of 8, and a machine with 128 lanes instead of
      8. The five stages that follow are this same picture, measured.
    </p>
  </div>
</section>
""" % (
        figbox(fig_matrix(), "The example",
               "y = W x, 8 rows x 8 columns",
               "Weights are one bit each: <b>set means +1, clear means -1</b>, so the kernel "
               "never multiplies by a weight - it only <b>adds or subtracts</b> the "
               "activation. Row 0 is <code>%s</code>, which is <b>%d</b>. "
               "Check any row you like; these are the numbers every figure below has to "
               "reproduce." % (terms, y[0]), wide=False),
        figbox(fig_baseline(), "Stage 01 layout, one step",
               "lane = column",
               "Three problems, all caused by the layout. The reduction is <b>serial</b>: 3 "
               "steps here, 7 on the real 128-lane machine. It yields <b>one</b> output, so "
               "the other 7 rows have not started. And only 8 of the machine's 128 lanes were "
               "ever busy."),
        figbox(fig_permute(), "The repack",
               "same 8 bytes, permuted",
               "Follow either traced bit. It never changes value - only its address changes. "
               "The two arrows cross because a transpose is exactly what this is."),
        figbox(fig_repacked_step(), "Stage 02 layout, one step",
               "lane = row",
               "Lane <em>j</em> is now output row <em>j</em>, and it stays row <em>j</em> for "
               "the whole loop. Folding column <em>c</em> into the accumulator is a plain "
               "<b>vertical add inside each lane</b>: no lane ever has to look at another "
               "lane."),
        figbox(fig_running_table(), "Eight steps of that loop",
               "the accumulator, column by column",
               "The last column is <b>%s</b> - the same y as the first figure, reached with "
               "<b>zero horizontal reductions</b>. That is the 2.09x in stage 02."
               % ", ".join(str(v) for v in y)),
        figbox(fig_vd4dots(), "Stage 04 layout, one instruction",
               "lane = row, 4 bytes = 4 columns",
               "At real size this is the lucky part: 64 i32 lanes is 64 rows, and the same "
