        p.append(cell(X0 + gw + 24, yy + 1.5, 46, CH - 3, str(v), "hi" if r in (0, 2) else "acc", 13))
    return svg(X0 + gw + 82, Y0 + N * CH + 12, "".join(p))


# --- figure 2: the baseline step, with the reduction drawn out --------------

def fig_baseline():
    LW, LH = 52, 30
    X0 = 152
    rows = []
    p = []
    rm = row_major_bytes()

    def lane_row(y, label, sub, vals, kinds, size=12.5):
        p.append(txt(X0 - 12, y + LH / 2 + 4, label, 12, "var(--ink)", anchor="end",
                     weight=600))
        if sub:
            p.append(txt(X0 - 12, y + LH / 2 + 18, sub, 10, "var(--muted)", anchor="end",
                         font=DISP))
        for i, v in enumerate(vals):
            p.append(cell(X0 + i * LW + 2, y, LW - 4, LH, v, kinds[i], size))

    p.append(txt(X0 - 12, 26, "in memory", 12, "var(--ink)", anchor="end", weight=600))
    p.append(txt(X0 - 12, 40, "one byte per row", 10, "var(--muted)", anchor="end",
                 font=DISP))
    for i, b in enumerate(rm):
        k = "hi" if i == 0 else "acc"
        p.append(cell(X0 + i * LW + 2, 12, LW - 4, LH, "0x%02X" % b, k, 12.5))
        p.append(txt(X0 + i * LW + LW / 2, 56, "row %d" % i, 9.5,
                     "var(--ink)" if i == 0 else "var(--muted)"))
    p.append(arrow(X0 + LW / 2, 62, X0 + LW / 2, 86, "var(--ink)", 1.4))
    p.append(txt(X0 + LW + 10, 76, "vlm.v v0, qs[0]", 11, "var(--ink)", anchor="start"))

    y1 = 116
    lane_row(y1, "v0  mask", "bit 0 first", list(bitstring(rm[0])),
             ["p" if BITS[0][c] else "m" for c in range(N)])
    lane_row(y1 + 46, "v8  activations", "vle8.v", [str(v) for v in X], ["acc"] * N)
    lane_row(y1 + 92, "v10 = +x or -x", "vmerge.vvm",
             ["%+d" % term(0, c) for c in range(N)],
             ["p" if BITS[0][c] else "m" for c in range(N)])

    p.append(txt(X0 - 12, y1 + 6, "lane", 10, "var(--muted)", anchor="end", font=DISP))
    for c in range(N):
        p.append(txt(X0 + c * LW + LW / 2, y1 - 6, str(c), 10, "var(--muted)"))
    p.append(txt(X0 + N * LW - 4, y1 - 24, "lane c holds COLUMN c of row 0", 11.5,
                "var(--minus)", anchor="end", font=DISP, weight=700))

    # the reduction tree
    ty = y1 + 138
    levels = reduction_tree(0)
    p.append(txt(X0 - 12, ty + 20, "vwredsum", 12, "var(--plus)", anchor="end",
                 weight=600))
    p.append(txt(X0 - 12, ty + 34, "3 serial steps", 10, "var(--muted)", anchor="end",
                 font=DISP))
    p.append(txt(X0 - 12, ty + 46, "7 at VLEN=1024", 10, "var(--muted)", anchor="end",
                 font=DISP))
    prev_centres = [X0 + c * LW + LW / 2 for c in range(N)]
    prev_y = y1 + 92 + LH
    for li, level in enumerate(levels[1:], start=1):
        yy = ty + (li - 1) * 46
        w = LW * (2 ** li)
        centres = []
        for i, v in enumerate(level):
            cx = X0 + i * w + w / 2
            centres.append(cx)
            p.append(line(prev_centres[2 * i], prev_y, prev_centres[2 * i], yy - 8,
                          "var(--rule)", 1))
            p.append(line(prev_centres[2 * i + 1], prev_y, prev_centres[2 * i + 1],
                          yy - 8, "var(--rule)", 1))
            p.append(line(prev_centres[2 * i], yy - 8, prev_centres[2 * i + 1], yy - 8,
                          "var(--rule)", 1))
            p.append(line(cx, yy - 8, cx, yy, "var(--rule)", 1))
            last = li == len(levels) - 1
            p.append(cell(cx - 26, yy, 52, 28, str(v), "hi" if last else "acc",
                          13.5 if last else 12.5))
        prev_centres, prev_y = centres, yy + 28
    fy = ty + (len(levels) - 2) * 46
    p.append(arrow(X0 + N * LW / 2 + 32, fy + 14, X0 + N * LW / 2 + 74, fy + 14,
                   "var(--ink)", 1.4))
    p.append(txt(X0 + N * LW / 2 + 80, fy + 18, "y[0] = 27", 13, "var(--ink)",
                 anchor="start", weight=600))
    p.append(txt(X0 + N * LW / 2 + 80, fy + 34, "ONE number.", 10.5, "var(--plus)",
                 anchor="start", font=DISP, weight=700))
    p.append(txt(X0 + N * LW / 2 + 80, fy + 47, "Now do it 7 more times.", 10.5,
                 "var(--muted)", anchor="start", font=DISP))
    return svg(X0 + N * LW + 60, fy + 62, "".join(p))


# --- figure 3: the same 64 bits, two byte orders ----------------------------

def fig_permute():
    BW, BH = 76, 34
    X0 = 132
    TRACE = [(2, 5), (6, 1)]             # (row, column) bits we follow across
    COL = ["var(--plus)", "var(--good)"]
    p = []
    rm, pm = row_major_bytes(), plane_major_bytes()

    def strip(y, label, sub, vals, tag, marks):
        """marks: [(byte, bit)] to open a bit lens for.  Returns lens x centres."""
        hot = {b for b, _ in marks}
        p.append(txt(X0 - 16, y + 14, label, 12.5, "var(--ink)", anchor="end",
                     weight=600))
        p.append(txt(X0 - 16, y + 30, sub, 10.5, "var(--muted)", anchor="end", font=DISP))
        for i, b in enumerate(vals):
            p.append(cell(X0 + i * BW + 2, y, BW - 4, BH, "0x%02X" % b,
                          "hi" if i in hot else "acc", 13))
            p.append(txt(X0 + i * BW + BW / 2, y + BH + 14, tag % i, 10,
                         "var(--ink)" if i in hot else "var(--muted)"))
        out = []
        for n, (byte, bit) in enumerate(marks):
            bx = X0 + byte * BW
            p.append(rect(bx + 2, y + BH + 21, BW - 4, 17, "var(--surface-2)",
                          COL[n], 3, 1.2))
            for k, ch in enumerate(bitstring(vals[byte])):
                cx = bx + 5 + (BW - 10) * (k + 0.5) / N
                p.append(txt(cx, y + BH + 33.5, ch, 9.5,
                             COL[n] if k == bit else "var(--muted)",
                             weight=700 if k == bit else None))
            out.append(bx + 5 + (BW - 10) * (bit + 0.5) / N)
        return out

    W = X0 + N * BW + 40
    p.append(txt(W / 2, 20, "the repack: the bit at row r, column c moves from "
                 "byte r bit c  to  byte c bit r", 12.5, "var(--ink)", font=DISP,
                 weight=700))
    top = strip(40, "row-major", "as the file stores it", rm, "row %d", TRACE)
    bot = strip(216, "plane-major", "as the kernel wants it", pm, "col %d",
                [(c, r) for r, c in TRACE])
    for n, (r, c) in enumerate(TRACE):
        p.append(txt(top[n], 128, "W[row %d][col %d] = %+d" % (r, c, w(r, c)), 10.5,
                     COL[n], font=DISP, weight=700))
        p.append(arrow(top[n], 138, bot[n], 206, COL[n], 1.7))
        p.append(txt(bot[n], 306, "same bit, byte %d bit %d" % (c, r), 10.5, COL[n],
                     font=DISP, weight=700))
    p.append(txt(W / 2, 336, "Same 64 bits, same 8 bytes. Nothing added, nothing "
                 "dropped -- the two arrows cross because this is a transpose.", 12,
                 "var(--ink-2)", font=DISP))
    return svg(W, 352, "".join(p))


