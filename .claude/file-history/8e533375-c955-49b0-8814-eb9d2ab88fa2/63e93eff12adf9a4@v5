"""The built page must be well-formed and must actually contain the new figures."""
import pathlib, re
from html.parser import HTMLParser

import example as ex

PAGE = pathlib.Path(__file__).parent / "q1_kernel_walkthrough.html"
VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
        "param", "source", "track", "wbr", "path", "rect", "circle", "use", "stop"}


class Balance(HTMLParser):
    def __init__(self):
        super().__init__()
        self.stack, self.errors = [], []

    def handle_starttag(self, tag, attrs):
        if tag not in VOID:
            self.stack.append((tag, self.getpos()))

    def handle_endtag(self, tag):
        if tag in VOID:
            return
        if not self.stack:
            self.errors.append("stray </%s> at %s" % (tag, self.getpos()))
        elif self.stack[-1][0] != tag:
            self.errors.append("</%s> closes <%s> opened at %s"
                               % (tag, self.stack[-1][0], self.stack[-1][1]))
            self.stack.pop()
        else:
            self.stack.pop()


def page():
    return PAGE.read_text()


def test_the_document_tags_are_balanced():
    b = Balance()
    b.feed(page())
    assert b.errors == []
    assert [t for t, _ in b.stack] == []


def test_the_page_reads_from_high_level_to_low():
    p = page()
    order = re.findall(r'<section class="sec" id="([^"]+)"', p)
    assert order == ["moves", "problem", "s01", "s02", "s03", "s04", "s05",
                     "results", "token", "method", "machine"], order
    # the problem picture comes before the first section, in the hero
    assert p.index('class="figbox') < p.index('<section class="sec"')
    assert p.count('<svg class="fig"') == 6      # 3 in the section, 3 in stages
    assert '<a href="#moves">The four changes</a>' in p
    assert "lanegrid" not in p                   # no random-noise grids left
    assert not re.search(r'data-reg="(?!tile)', p)   # nor 8-lane sample strips
    assert "data-seed" not in p                  # nothing drawn from a seed


def visible_blocks(body):
    """Blocks a reader meets without opening anything."""
    body = re.sub(r"<details.*?</details>", "", body, flags=re.S)
    return len(re.findall(r'<(?:div|p|ul|table|h3)\s[^>]*class="(?:beats|prose|panels'
                          r'|cards|ops|tally|pull|nextup|sec-head|stage-head|tablewrap'
                          r'|budget|ladder|kv)', body))


def test_no_section_dumps_more_than_seven_blocks_at_once():
    p = page()
    secs = [(m.group(1), m.start())
            for m in re.finditer(r'<section class="sec" id="([^"]+)"', p)]
    heavy = {}
    for i, (name, pos) in enumerate(secs):
        stop = secs[i + 1][1] if i + 1 < len(secs) else p.index("<footer")
        n = visible_blocks(p[pos:stop])
        if n > 7:
            heavy[name] = n
    assert not heavy, heavy


def test_every_disclosure_is_labelled_and_closed():
    p = page()
    opens = re.findall(r'<details class="more">\s*<summary>([^<]+)</summary>', p)
    assert len(opens) == p.count("<details"), "a details without a summary"
    assert p.count("<details") == p.count("</details>")
    assert all(len(t.strip()) > 10 for t in opens), opens


def test_the_figures_carry_the_numbers_the_module_owns():
    p = page()
    for s in ex.STAGES:
        assert "{:,}".format(s["ops_per_tile"]) in p
        assert "%d of %d" % (s["lanes_busy"], s["vlmax"]) in p


def test_the_page_no_longer_carries_the_non_optimization_material():
    p = page()
    for gone in ('id="traps"', 'id="left"', "Did not work", "Trap 01", "Trap 02",
                 "Trap 03", "never repacked", "Why it was skipped",
                 "fails the repack gate", "instruction-issue floor"):
        assert gone not in p, gone


def test_every_nav_link_points_at_a_real_section():
    p = page()
    ids = set(re.findall(r'<section class="sec" id="([^"]+)"', p))
    ids |= set(re.findall(r'<(?:header|section)[^>]*id="([^"]+)"', p))
    for href in re.findall(r'<a href="#([^"]+)">', p):
        assert href in ids, href


def test_the_typography_stays_inside_the_subsetted_font():
    p = re.sub(r"src:url\(data:font/woff2;base64,[^)]*\)", "", page())
    bad = {c for c in p if ord(c) > 126 and c not in "\n\t"}
    assert bad == set()
