"""The figures claim things about the machine; those claims must agree.

Nothing here checks arithmetic a reader would do by hand - the figures are
meant to be looked at, not computed. What is checked is that the drawn areas
and the printed numbers come from the same constants, so a picture can never
disagree with its own caption.
"""
import re

import example as ex


def test_ops_per_tile_agrees_with_the_pages_weights_per_op():
    # the stage tallies elsewhere on the page say 6.4, 21.3 and 64.0
    assert [round(ex.macs_per_op(s), 1) for s in ex.STAGES] == [6.4, 21.3, 64.0]


def test_one_step_covers_the_weights_its_lanes_can_hold():
    for s in ex.STAGES:
        assert ex.step_cells(s) == s["lanes_busy"] * s["per_lane"]


def test_a_step_advances_one_output_per_row_it_touches():
    for s in ex.STAGES:
        assert s["outputs"] == s["step_rows"]


def test_only_the_baseline_wastes_lanes():
    assert ex.lane_fraction(ex.STAGES[0]) == 0.25
    assert all(ex.lane_fraction(s) == 1.0 for s in ex.STAGES[1:])


def test_the_lane_bar_fills_exactly_the_busy_fraction():
    for s in ex.STAGES:
        bar = ex.lane_bar(0, 0, 800, 30, s)
        widths = [float(m) for m in re.findall(r'(?<![-\w])width="([\d.]+)"', bar)]
        assert widths[0] == 800                      # the register
        assert abs(widths[1] - 800 * ex.lane_fraction(s)) < 0.01


def test_the_tile_shading_is_the_real_fraction_of_the_tile():
    for s in ex.STAGES:
        body = ex.tile_map(0, 0, ex.TILE_COLS * 4.0, ex.TILE_ROWS * 4.0, s)
        # the shaded step is the third rect drawn, after tile + its background
        rects = re.findall(r'<rect x="[-\d.]+" y="[-\d.]+" width="([\d.]+)" '
                           r'height="([\d.]+)"', body)
        w, h = float(rects[1][0]), float(rects[1][1])
        assert w == max(s["step_cols"] * 4.0, 2.5)
        assert h == max(s["step_rows"] * 4.0, 3)


def test_the_output_matrix_has_one_dot_per_row_of_the_tile():
    for s in ex.STAGES:
        dots = ex.output_dots(0, 0, 12, s)
        assert dots.count("<rect") == ex.TILE_ROWS
        assert dots.count("var(--good)") == s["outputs"]


def test_the_figures_print_only_numbers_this_module_owns():
    svg = ex.render_all()
    for s in ex.STAGES:
        assert "{:,}".format(s["ops_per_tile"]) in svg
        assert "%d of %d" % (s["lanes_busy"], s["vlmax"]) in svg
    assert "163,840" in svg
    assert all(ord(c) < 127 for c in svg)            # the font subset is ASCII
    assert "&" not in svg.replace("&amp;", "")


def test_each_box_carries_exactly_one_figure():
    for box in (ex.box_problem(), ex.box_compare(), ex.box_layout()):
        assert box.count('<svg class="fig"') == 1
        assert box.startswith('<div class="figbox')
        assert "8x8" not in box


def test_each_stage_figure_shows_that_stages_own_numbers():
    for i, s in enumerate(ex.STAGES[:2]):
        fig = ex.fig_stage(i)
        assert "%d of %d lanes" % (s["lanes_busy"], s["vlmax"]) in fig
        assert "one step: %d x %d" % (s["step_rows"], s["step_cols"]) in fig
        assert "%d of 64" % s["outputs"] in fig
