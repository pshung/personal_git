#!/usr/bin/env python3
"""Reorder the page so it reads highest level first.

Before: machine specs, then measurement method, then the format, then five
stages, then results.  A reader met ten numbers before learning what was slow.

After:  the problem in one picture (hero), the four changes and what each one
bought, then the format, then the stages, then the measurements.  Anything
that supports the numbers rather than telling the story moves to the end.
"""
import pathlib, re, sys

SRC = pathlib.Path(__file__).parent / "q1_page.src.html"
s = SRC.read_text()


def once(pattern, repl, why, flags=re.S):
    global s
    s, n = re.subn(pattern, repl, s, flags=flags)
    if n != 1:
        sys.exit("%s: matched %d times, expected 1" % (why, n))
    print("  ok  %s" % why)


# --- 1. split main into its marked sections --------------------------------

marks = [(m.start(), m.group(1).strip())
         for m in re.finditer(r"<!-- =+ ([A-Z0-9 ]+?) =+ -->", s)]
end = s.index("\n</main>")
head, tail = s[:marks[0][0]], s[end:]
blocks = {}
for i, (pos, name) in enumerate(marks):
    stop = marks[i + 1][0] if i + 1 < len(marks) else end
    blocks[name] = s[pos:stop]
print("sections found:", ", ".join(blocks))

LADDER = re.search(r'    <div class="ladder">.*?</p>\n', head, re.S)
assert LADDER, "ladder block not found in the hero"
ladder = LADDER.group(0)
head = head.replace(ladder, "")

# the hero's four-stat bar says the same thing the sections below say
head, n = re.subn(r'    <dl class="statbar">.*?</dl>\n\n', "", head, flags=re.S)
assert n == 1, "statbar"

# --- 2. hero: one claim, one number, one picture ---------------------------

head = re.sub(
    r'    <p class="standfirst">.*?</p>\n',
    """    <p class="standfirst">
      A 4-billion-parameter model where every weight is <b>a single bit</b>, running on one
      RISC-V core with a 1024-bit vector unit. The stock kernel filled <b>32 of the 128
      lanes</b>, then collapsed even those into one number. Everything below comes from
      fixing that.
    </p>

    <dl class="statbar">
      <div class="stat hi">
        <dt>One matmul node, decode</dt>
        <dd>12.34<span class="unit">x</span></dd>
      </div>
      <div class="stat">
        <dt>Weight bytes moved</dt>
        <dd>unchanged</dd>
      </div>
      <div class="stat">
        <dt>Output</dt>
        <dd>bit-identical</dd>
      </div>
    </dl>

    <!--@FIGPROB@-->
""", head, flags=re.S)
assert "<!--@FIGPROB@-->" in head, "hero rewrite"
print("  ok  hero reduced to one claim, one number, one figure")

# --- 3. the new high-level section -----------------------------------------

MOVES = """<!-- ============ THE MOVES ============ -->
<section class="sec" id="moves">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">The whole story, once</p>
      <h2>Four changes, and what each one bought</h2>
      <div class="prose">
        <p>
          Two of them moved the weight bits around. That is what the picture below shows, and
          it is where most of the speedup is. The other two never touched the layout.
        </p>
      </div>
    </div>

    <ul class="kv">
      <li>
        <span class="k">02&ensp;Repack</span>
        <span class="v"><b>2.09x</b> &nbsp; Store the weights by column instead of by row, so
        one load fills 64 lanes with 64 different output rows. The horizontal reduction
        disappears.</span>
      </li>
      <li>
        <span class="k">03&ensp;Prefetch</span>
        <span class="v"><b>1.54x</b> &nbsp; Ask for the next weight block before the current one
        is finished. Decode only - prefill already reuses its weights.</span>
      </li>
      <li>
        <span class="k">04&ensp;vd4dots</span>
        <span class="v"><b>3.04x</b> &nbsp; Permute once more so each lane holds four columns,
        and let the core's own 4-way dot product do all four at once.</span>
      </li>
      <li>
        <span class="k">05&ensp;vtype</span>
        <span class="v"><b>1.26x</b> &nbsp; Stop switching element width inside the loop. No
        arithmetic changed; only the generated code did.</span>
      </li>
    </ul>

    <!--@FIGCMP@-->
    <p class="nextup"><b>Everything after this is detail</b>
      The next section is the file format the kernel starts from. After that, one section per
      change, in the order they were made.
    </p>
  </div>
</section>

"""

# --- 4. put the layout figure where the format is explained ----------------

blocks["PROBLEM"] = blocks["PROBLEM"].replace("\n<!--@EXAMPLE@-->", "")
assert "<!--@EXAMPLE@-->" not in blocks["PROBLEM"]
blocks["PROBLEM"] = blocks["PROBLEM"].replace(
    "    </div>\n  </div>\n</section>",
    "    </div>\n\n    <!--@FIGLAY@-->\n  </div>\n</section>", 1)
assert "<!--@FIGLAY@-->" in blocks["PROBLEM"], "layout figure slot"
print("  ok  layout figure moved next to the format")

# --- 5. the ladder charts belong with the results --------------------------

blocks["RESULTS"] = blocks["RESULTS"].replace(
    '    <div class="tablewrap">',
    ladder.rstrip("\n") + "\n\n    <div class=\"tablewrap\">", 1)
assert 'class="ladder"' in blocks["RESULTS"], "ladder move"
print("  ok  ladder charts moved into the results")

# --- 6. measurement support becomes an appendix ----------------------------

blocks["METHOD"] = blocks["METHOD"].replace(
    "<p class=\"eyebrow\">How we measure</p>",
    "<p class=\"eyebrow\">Appendix &mdash; how the numbers were taken</p>", 1)
blocks["THE MACHINE"] = blocks["THE MACHINE"].replace(
    "<p class=\"eyebrow\">Where this runs</p>",
    "<p class=\"eyebrow\">Appendix &mdash; the target</p>", 1)

ORDER = ["PROBLEM", "STAGE 01", "STAGE 02", "STAGE 03", "STAGE 04", "STAGE 05",
         "RESULTS", "PER TOKEN", "METHOD", "THE MACHINE"]
assert set(ORDER) == set(blocks), (set(ORDER) ^ set(blocks))
s = head + MOVES + "".join(blocks[k] for k in ORDER) + tail

# --- 7. nav follows the new order ------------------------------------------

NAV = """    <a href="#moves">The four changes</a>
    <a href="#problem">The format</a>
    <a href="#s01">01 Baseline</a>
    <a href="#s02">02 Repack</a>
    <a href="#s03">03 Prefetch</a>
    <a href="#s04">04 vd4dots</a>
    <a href="#s05">05 vtype</a>
    <a href="#results">Results</a>
    <a href="#token">Per token</a>
    <a href="#method">How we measured</a>
"""
once(r'  <div class="nav-inner">\n.*?\n  </div>',
     '  <div class="nav-inner">\n' + NAV + "  </div>", "nav rebuilt")

SRC.write_text(s)
print("\nnew order: hero, moves, %s" % ", ".join(ORDER))
print("%d bytes" % len(s))
