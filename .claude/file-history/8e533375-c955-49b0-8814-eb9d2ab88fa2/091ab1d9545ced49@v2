#!/usr/bin/env python3
"""Render each generated figure to PNG so it can be inspected, not assumed.

rsvg-convert has no CSS custom properties, so the light-theme token values
are substituted in first.  This is a check harness only; the page itself
keeps the var() references and follows the reader's theme.
"""
import json, pathlib, re, subprocess, sys

HERE = pathlib.Path(__file__).parent
LIGHT = {
    "--ground": "#E7EAEE", "--surface": "#FBFCFD", "--surface-2": "#F1F4F7",
    "--ink": "#111820", "--ink-2": "#39434F", "--muted": "#6B7683",
    "--rule": "#C9D1DA", "--rule-2": "#DFE4EA", "--minus": "#2E4A78",
    "--plus": "#B4610F", "--good": "#1F6A4F", "--code-bg": "#EDF1F5",
    "--f-display": "DejaVu Sans", "--f-body": "DejaVu Sans",
    "--f-mono": "DejaVu Sans Mono", "--on-fill": "#FFFFFF",
}


def resolve(svg):
    def sub(m):
        return LIGHT.get(m.group(1), "#f0f")
    return re.sub(r"var\((--[a-z0-9-]+)\)", sub, svg)


def main():
    figs = json.loads((HERE / "figs.json").read_text())
    want = sys.argv[1:] or list(figs)
    for name in want:
        body = resolve(figs[name])
        m = re.search(r'viewBox="0 0 ([\d.]+) ([\d.]+)"', body)
        w, h = float(m.group(1)), float(m.group(2))
        doc = ('<svg xmlns="http://www.w3.org/2000/svg" width="%g" height="%g" '
               'viewBox="0 0 %g %g"><rect width="100%%" height="100%%" fill="#FBFCFD"/>'
               "%s</svg>" % (w, h, w, h, re.sub(r"^<svg[^>]*>|</svg>$", "", body)))
        src = HERE / ("fig_%s.svg" % name)
        png = HERE / ("fig_%s.png" % name)
        src.write_text(doc)
        subprocess.run(["rsvg-convert", "-z", "2", "-o", str(png), str(src)], check=True)
        print("%-9s %4.0f x %4.0f -> %s" % (name, w, h, png.name))


if __name__ == "__main__":
    main()
