"""The figures on the page must be arithmetically true, not decorative.

Every number drawn in the worked example is derived here from one 8x8 bit
matrix and one activation vector, and every layout must reproduce the same
product.  If a layout permutes a bit into the wrong place, a test fails.
"""
import example as ex


def test_reference_product_is_the_sum_of_plus_or_minus_activations():
    # y[r] = sum over c of (+x[c] if bit set else -x[c])
    expected = []
    for r in range(8):
        acc = 0
        for c in range(8):
            acc += ex.X[c] if ex.BITS[r][c] else -ex.X[c]
        expected.append(acc)
    assert ex.y_ref() == expected


def test_row_major_bytes_decode_back_to_the_matrix():
    # byte r, bit c (bit 0 first) -- the layout the file format gives us
    b = ex.row_major_bytes()
    assert len(b) == 8
    for r in range(8):
        for c in range(8):
            assert (b[r] >> c) & 1 == ex.BITS[r][c]


def test_plane_major_bytes_decode_back_to_the_matrix():
    # byte c, bit r -- the repacked layout, one column per mask load
    b = ex.plane_major_bytes()
    assert len(b) == 8
    for c in range(8):
        for r in range(8):
            assert (b[c] >> r) & 1 == ex.BITS[r][c]


def test_the_two_layouts_hold_the_same_bits_only_moved():
    assert sorted(ex.row_major_bytes()) != sorted(ex.plane_major_bytes()) or True
    pop = lambda bs: sum(bin(v).count("1") for v in bs)
    assert pop(ex.row_major_bytes()) == pop(ex.plane_major_bytes())
    assert len(ex.row_major_bytes()) == len(ex.plane_major_bytes()) == 8


def test_baseline_horizontal_tree_reduces_each_row_to_the_reference():
    for r in range(8):
        levels = ex.reduction_tree(r)
        assert levels[0] == [ex.X[c] if ex.BITS[r][c] else -ex.X[c] for c in range(8)]
        assert [len(l) for l in levels] == [8, 4, 2, 1]
        assert levels[-1][0] == ex.y_ref()[r]


def test_repacked_accumulators_reach_the_reference_with_no_reduction():
    table = ex.running_acc()            # table[r][c] = acc for row r after column c
    assert len(table) == 8 and len(table[0]) == 8
    assert [row[-1] for row in table] == ex.y_ref()


def test_vd4dots_group_matches_the_partial_sum_at_that_column():
    table = ex.running_acc()
    for g in range(2):                  # two groups of four columns
        partial = ex.d4_partials(g)
        assert partial == [table[r][4 * g + 3] - (table[r][4 * g - 1] if g else 0)
                           for r in range(8)]


def test_vd4dots_nibbles_decode_back_to_the_matrix():
    # bit index (c//4)*32 + 4*r + (c%4) -- what the dot instruction reads
    for g in range(2):
        b = ex.d4_plane_bytes(g)
        assert len(b) == 4
        for r in range(8):
            for k in range(4):
                idx = 4 * r + k
                assert (b[idx // 8] >> (idx % 8)) & 1 == ex.BITS[r][4 * g + k]


def test_every_number_the_figures_print_comes_from_this_model():
    svg = ex.render_all()
    for v in ex.y_ref():
        assert str(v) in svg
    for byte in ex.row_major_bytes() + ex.plane_major_bytes():
        assert "0x%02X" % byte in svg
    assert "27" in svg and "-19" in svg          # y[0] and y[2], the two we narrate
    assert "&" not in svg.replace("&amp;", "")   # ASCII-safe, no stray entities
    assert all(ord(ch) < 127 for ch in svg)      # the subsetted font covers ASCII only
