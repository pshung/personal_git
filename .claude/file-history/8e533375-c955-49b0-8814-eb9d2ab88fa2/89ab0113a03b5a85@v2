#!/usr/bin/env python3
"""Drop the sections that are not about the optimization itself."""
import pathlib, re, sys

SRC = pathlib.Path(__file__).parent / "q1_page.src.html"
html = SRC.read_text()
before = len(html)

CUTS = [
    ("traps section",
     r"<!-- =+ TRAPS =+ -->.*?</section>\n\n(?=<!-- =+ RESULTS)"),
    ("what is left section",
     r"<!-- =+ WHAT IS LEFT =+ -->.*?</section>\n\n(?=</main>)"),
    ("instruction-issue floor card",
     r'\s*<div class="card">\s*<p class="tagline">Correction on the record</p>.*?</div>\n(?=\s*</div>)'),
]
for name, pat in CUTS:
    html, n = re.subn(pat, "", html, flags=re.S)
    if n != 1:
        sys.exit("cut %r matched %d times, expected 1" % (name, n))
    print("cut  %-30s" % name)

# the results cards container held two cards, one is gone
html = html.replace(
    '<div class="cards c2">\n      <div class="card">\n        <p class="tagline">Outlier, both ways</p>',
    '<div class="cards">\n      <div class="card">\n        <p class="tagline">Outlier, both ways</p>')

SRC.write_text(html)
print("%d -> %d bytes" % (before, len(html)))
for word in ("trap", "Trap", "fails", "fault", "bug", "never repacked", "skipped"):
    hits = [l for l in html.splitlines() if word in l]
    if hits:
        print("  still present: %-16s %d line(s)" % (word, len(hits)))
        for h in hits[:3]:
            print("     ", h.strip()[:100])
