                 anchor="start"))
    p.append(txt(ox, ty + 134, "outputs moved", 10, "var(--muted)", anchor="start",
                 font=DISP))
    return svg(W, H, "".join(p))


def render_all():
    return (fig_problem() + fig_layout() + fig_compare()
            + fig_stage(0) + fig_stage(1))


# --- the page section -------------------------------------------------------

def figbox(fig, label, right, cap):
    return ('<div class="figbox wide">\n<div class="panel-label"><span>%s</span>'
            '<span class="r">%s</span></div>\n<div class="figframe">%s</div>\n'
            '<p class="cap">%s</p>\n</div>\n' % (label, right, fig, cap))


def section():
    return """<!-- ============ THE LANES ============ -->
<section class="sec" id="lanes">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Where the problem is</p>
      <h2>Only 32 of the machine's 128 lanes were ever doing work</h2>
      <div class="prose">
        <p>
          The vector unit is 1024 bits wide. At one byte per element that is
          <strong>128 lanes in a single register</strong>. The stock kernel fills 32 of them,
          and then destroys even that work by adding the 32 lanes together into one number.
          Every figure below is drawn to scale, so the empty space is the actual empty space.
        </p>
      </div>
    </div>

%s
    <h3 style="margin-top:2.8rem">The layout causes it, not the code</h3>
    <div class="prose" style="margin-top:.6rem">
      <p>
        A Q1_0 block is <strong>one row of 128 columns</strong>. So a mask load can only ever
        reach columns that belong to the same row, and a row is one output. To fill the lanes
        with 64 different outputs instead, the bits have to be stored by column.
      </p>
    </div>

%s
    <h3 style="margin-top:2.8rem">What one step gets you, in each layout</h3>
    <div class="prose" style="margin-top:.6rem">
      <p>
        Same tile, same weights, same 8,192 multiplies. The only difference is how much of it
        one instruction can carry.
      </p>
    </div>

%s
    <div class="pull">
      <p>
        Nothing here made the arithmetic cheaper - there was never any arithmetic to make
        cheaper. <strong>The entire speedup is lanes that stopped being empty</strong>, and
        instructions that stopped throwing their result away.
      </p>
    </div>

    <p class="nextup"><b>The five stages</b>
      What follows is how each of those three pictures was reached, and what each one measured
      on the machine.
    </p>
  </div>
</section>
""" % (
        figbox(fig_problem(), "Stage 01, one step", "drawn to scale",
               "The bar is a real register: 128 lanes at <code>VLEN=1024</code>, "
               "<b>96 of them empty</b>. Then <code>vwredsum</code> adds the 32 busy lanes "
               "together, one pair at a time, and what comes out is a single number. "
               "This node does that <b>163,840 times</b>."),
        figbox(fig_layout(), "Why the lanes stay empty", "same 1152 bytes, reordered",
