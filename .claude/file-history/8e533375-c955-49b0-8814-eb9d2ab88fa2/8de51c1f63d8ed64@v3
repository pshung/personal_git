    p.append(txt(X + busy_w / 2, fy + 34, "vwredsum", 13, "var(--plus)", weight=600))
    p.append(txt(X + busy_w + 30, fy + 24, "adds across the lanes, one pair at a "
                 "time - a serial tree", 11, "var(--muted)", anchor="start",
                 font=DISP))
    p.append(rect(X + busy_w / 2 - 34, by, 68, 26, "var(--surface)", "var(--ink)",
