# --- figure 2: why -- one mask load can only reach one row ------------------

def fig_layout():
    W = 1010
    X, CW, H = 150, 3.6, 26                # 128 bit cells at 3.6px
    p = []

    def strip(y, title, sub, cells, hot, tile_stage, note):
        p.append(txt(X - 16, y + 15, title, 12.5, "var(--ink)", anchor="end",
                     weight=600))
        p.append(txt(X - 16, y + 30, sub, 10, "var(--muted)", anchor="end",
                     font=DISP))
        p.append(rect(X, y, cells * CW, H, "var(--surface-2)", "var(--rule)", 3, 1))
        p.append(rect(X, y, hot * CW, H, "var(--minus)", "none", 3))
        for i in range(8, cells, 8):
            p.append(line(X + i * CW, y + 1, X + i * CW, y + H - 1,
                          "var(--rule)", .5).replace("/>", ' opacity=".5"/>'))
        p.append(rect(X, y, cells * CW, H, "none", "var(--rule)", 3, 1))
        p.append(brace(X, X + hot * CW, y + H + 2, note, "var(--minus)"))
        tx = X + cells * CW + 62
        p.append(tile_map(tx, y - 10, 200, 100, tile_stage, "var(--minus)"))
        p.append(txt(tx + 100, y - 18, "the 64 x 128 tile", 10, "var(--muted)",
                     font=DISP))
        p.append(arrow(X + hot * CW / 2, y + H + 34, tx - 14, y + 40,
                       "var(--minus)", 1.5))
        return tx

    p.append(txt(X, 20, "what a single mask load can reach", 12.5, "var(--ink)",
                 anchor="start", font=DISP, weight=700))
    tx = strip(48, "block_q1_0", "the first 128 bits of qs", 128, 32, STAGES[0],
               "vlm.v reaches 32 bits -- 32 columns of row r")
    p.append(txt(tx + 100, 108, "one row of the tile, 32 weights", 11,
                 "var(--minus)", font=DISP, weight=700))

    p.append(line(X - 120, 154, W - 30, 154, "var(--rule-2)", 1))
    tx = strip(190, "block_q1_0x64", "transposed", 128, 64,
               STAGES[1], "vlm.v reaches 64 bits -- 64 rows of column c")
    p.append(txt(tx + 100, 250, "one weight from every output row", 11,
                 "var(--minus)", font=DISP, weight=700))
    p.append(txt(X, 306, "Both strips are the same 128 bits of the same block. Row-major "
                 "they are one row, so they can only feed one output. Plane-major they are "
                 "two whole columns.", 11.5, "var(--ink-2)", anchor="start", font=DISP))
    return svg(W, 326, "".join(p))


# --- figure 3: the three layouts side by side -------------------------------

def fig_compare():
    W = 1010
    XL, XB, BW = 16, 152, 240              # label, lane bar
    XT, TW, TH = 430, 240, 120             # tile map
    XO = 700                               # output dots
    XN = 826                               # numbers
    ROW, TOP = 158, 74
    p = []

    heads = [(XB, BW, "lanes busy in one register"),
             (XT, TW, "what one step covers of the tile"),
             (XO, 104, "output rows advanced"),
             (XN, 164, "vector ops to finish the tile")]
    for x, w, t in heads:
        p.append(txt(x + w / 2, 26, t, 10.5, "var(--muted)", font=DISP, weight=700))
        p.append(line(x, 38, x + w, 38, "var(--rule-2)", 1))

    worst = max(s["ops_per_tile"] for s in STAGES)
    for i, s in enumerate(STAGES):
        y = TOP + i * ROW
        if i:
            p.append(line(XL, y - 26, W - 16, y - 26, "var(--rule-2)", 1))
        p.append(txt(XL, y + 8, s["key"], 21, "var(--ink)", anchor="start",
                     font=DISP, weight=700))
        p.append(txt(XL, y + 26, s["name"], 12, "var(--ink-2)", anchor="start",
                     font=DISP, weight=700))
        p.append(txt(XL, y + 42, s["kernel"], 9.5, "var(--muted)", anchor="start"))

        p.append(lane_bar(XB, y, BW, 30, s))
        pct = 100 * lane_fraction(s)
        p.append(txt(XB, y + 48, "%d of %d" % (s["lanes_busy"], s["vlmax"]), 12,
                     "var(--ink)", anchor="start"))
        p.append(txt(XB + BW, y + 48, "%.0f%%" % pct, 12,
                     "var(--plus)" if pct < 100 else "var(--good)", anchor="end",
                     font=DISP, weight=700))
        if s["per_lane"] > 1:
            p.append(txt(XB, y + 63, "and 4 columns per lane", 10, "var(--good)",
                         anchor="start", font=DISP, weight=700))

        plural = lambda n, w: "%d %s%s" % (n, w, "" if n == 1 else "s")
        p.append(tile_map(XT, y - 4, TW, TH, s))
        p.append(txt(XT, y + TH + 8, "%s x %s" % (plural(s["step_rows"], "row"),
                                                  plural(s["step_cols"], "col")),
                     11, "var(--ink)", anchor="start"))
        p.append(txt(XT + TW, y + TH + 8, s["reduction"], 10.5,
                     "var(--plus)" if s["outputs"] == 1 else "var(--good)",
                     anchor="end", font=DISP, weight=700))

        p.append(output_dots(XO, y - 4, 13, s))
        p.append(txt(XO, y + 108, "%d of %d" % (s["outputs"], TILE_ROWS), 12,
                     "var(--good)" if s["outputs"] > 1 else "var(--plus)",
                     anchor="start"))

        p.append(txt(XN, y + 18, "{:,}".format(s["ops_per_tile"]), 24,
                     "var(--ink)", anchor="start", font=DISP, weight=700))
        p.append(rect(XN, y + 30, 164 * s["ops_per_tile"] / worst, 8,
                      "var(--good)" if i else "var(--plus)", "none", 2))
        p.append(txt(XN, y + 58, "%.1f weights per op" % macs_per_op(s), 11,
                     "var(--ink-2)", anchor="start"))
        if i:
            p.append(txt(XN, y + 74, "%.1fx fewer than 01"
                         % (worst / s["ops_per_tile"]), 11, "var(--good)",
                         anchor="start", font=DISP, weight=700))
    return svg(W, TOP + len(STAGES) * ROW - 10, "".join(p))


# --- the vd4dots operand, at its real width ---------------------------------

def fig_operand():
    LANES, LW, LH = 64, 11, 28
    X, W = 132, 1010
    BAR = LANES * LW
    p = []

    # one pattern tile per register = one lane; far smaller than 64 x 4 rects
    defs = ["<defs>"]
    for pid, colour, split in [("q1w", "var(--plus)", True),
                               ("q1a", "var(--minus)", True),
                               ("q1acc", "var(--good)", False)]:
        cells = ('<rect x=".3" width="%g" height="1" fill="%s"/>'
                 '<rect x="%g" width="%g" height="1" fill="%s" opacity=".72"/>'
                 % (LW / 2 - .6, colour, LW / 2 + .3, LW / 2 - .6, colour)
                 if split else
                 '<rect x=".6" width="%g" height="1" fill="%s"/>' % (LW - 1.2, colour))
        defs.append('<pattern id="%s" width="%g" height="1" '
                    'patternUnits="userSpaceOnUse">%s</pattern>' % (pid, LW, cells))
    defs.append("</defs>")
    p.append("".join(defs))

    def reg(y, name, sub, pid, tail):
        p.append(txt(X - 14, y + 16, name, 12.5, "var(--ink)", anchor="end",
                     weight=600))
        p.append(txt(X - 14, y + 31, sub, 10, "var(--muted)", anchor="end",
                     font=DISP))
        p.append('<rect x="%g" y="%g" width="%g" height="%g" fill="url(#%s)"/>'
                 % (X, y, BAR, LH, pid))
        p.append(rect(X, y, BAR, LH, "none", "var(--rule)", 3, 1))
        p.append(txt(X + BAR + 12, y + 18, tail, 10.5, "var(--muted)",
                     anchor="start", font=DISP))

    p.append(txt(X, 20, "e32/m2 at VLEN=1024 is 64 lanes -- and the same registers "
                 "seen as bytes are 64 rows x 4 columns", 12.5, "var(--ink)",
                 anchor="start", font=DISP, weight=700))

    reg(36, "v12", "weights, i8", "q1w", "256 bytes")

    # blow lane 0 up right underneath, so the guides stay short and cross nothing
    zx, zy, zw = X, 84, 56
    p.append(line(X, 36 + LH, zx, zy, "var(--rule)", 1, "3 3"))
    p.append(line(X + LW, 36 + LH, zx + 4 * zw, zy, "var(--rule)", 1, "3 3"))
    for k in range(4):
        p.append(rect(zx + k * zw + 1, zy, zw - 2, 28, "var(--plus)", "none", 3))
        p.append(txt(zx + k * zw + zw / 2, zy + 19, "c+%d" % k if k else "col c",
                     11, "var(--on-fill)"))
    p.append(txt(zx + 4 * zw + 18, zy + 19, "lane 0 of v12 -- one row's next four "
                 "columns", 11.5, "var(--ink)", anchor="start", font=DISP,
                 weight=700))

    reg(152, "v16", "activations, i8", "q1a", "the same 4, everywhere")
    reg(212, "v8", "accumulator, i32", "q1acc", "64 output rows")
    p.append(txt(X, 278, "64 lanes x 4 columns = 256 multiply-accumulates, in one "
                 "instruction", 12.5, "var(--good)", anchor="start", font=DISP,
                 weight=700))
    return svg(W, 294, "".join(p))


# --- a compact per-stage version, for the stage sections --------------------

def fig_stage(idx):
    s = STAGES[idx]
    X, BW, TW, TH = 104, 330, 256, 128
    W, H = 520, 268
    p = []
    p.append(txt(X - 12, 26, "register", 11.5, "var(--ink)", anchor="end",
                 weight=600))
    p.append(lane_bar(X, 14, BW, 26, s))
    p.append(txt(X, 56, "%d of %d lanes" % (s["lanes_busy"], s["vlmax"]), 11,
                 "var(--ink)", anchor="start"))
    pct = 100 * lane_fraction(s)
    p.append(txt(X + BW, 56, "%.0f%% busy" % pct, 11,
                 "var(--plus)" if pct < 100 else "var(--good)", anchor="end",
                 font=DISP, weight=700))

    ty = 84
    p.append(txt(X - 12, ty + 12, "the tile", 11.5, "var(--ink)", anchor="end",
                 weight=600))
    p.append(txt(X - 12, ty + 26, "64 x 128", 10, "var(--muted)", anchor="end",
                 font=DISP))
    p.append(tile_map(X, ty, TW, TH, s))
    p.append(txt(X, ty + TH + 16, "one step: %d x %d"
                 % (s["step_rows"], s["step_cols"]), 11, "var(--ink)",
