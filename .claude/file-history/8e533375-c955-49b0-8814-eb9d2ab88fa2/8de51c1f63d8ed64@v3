#!/usr/bin/env python3
"""Figures drawn at the machine's real size, so the waste is visible as area.

The point of this page is lane utilization: a 1024-bit vector unit is 128
byte-lanes wide, and the stock kernel fills 32 of them.  Shrinking that to a
toy size hides exactly the thing worth seeing, so every figure here is drawn
at 128 lanes and a 64 x 128 weight tile, to scale.  No figure asks the reader
to compute anything.
"""

VLEN = 1024
TILE_ROWS, TILE_COLS = 64, 128
TILE_MACS = TILE_ROWS * TILE_COLS          # 8192 weight multiplies per tile

# One entry per layout on the page.  ops_per_tile is measured from the
# generated code; macs_per_op is derived from it, never typed.
STAGES = [
    dict(key="01", name="baseline", kernel="ggml_vec_dot_q1_0",
         vlmax=128, lanes_busy=32, per_lane=1,
         step_rows=1, step_cols=32, outputs=1, ops_per_tile=1280,
         reduction="+ serial reduction"),
    dict(key="02", name="repack", kernel="block_q1_0x64",
         vlmax=64, lanes_busy=64, per_lane=1,
         step_rows=64, step_cols=1, outputs=64, ops_per_tile=384,
         reduction="no reduction"),
    dict(key="04", name="vd4dots", kernel="nds.vd4dots.vv",
         vlmax=64, lanes_busy=64, per_lane=4,
         step_rows=64, step_cols=4, outputs=64, ops_per_tile=128,
         reduction="no reduction"),
]


def macs_per_op(stage):
    return TILE_MACS / stage["ops_per_tile"]


def lane_fraction(stage):
    return stage["lanes_busy"] / stage["vlmax"]


def step_cells(stage):
    return stage["step_rows"] * stage["step_cols"]


# --- svg helpers ------------------------------------------------------------

MONO = 'font-family="var(--f-mono)"'
DISP = 'font-family="var(--f-display)"'


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def txt(x, y, s, size=12, fill="var(--ink)", anchor="middle", font=MONO,
        weight=None):
    wt = ' font-weight="%s"' % weight if weight else ""
    return ('<text x="%g" y="%g" %s font-size="%g" fill="%s" text-anchor="%s"%s>'
            "%s</text>" % (x, y, font, size, fill, anchor, wt, esc(s)))


def rect(x, y, w, h, fill="none", stroke="none", rx=0, sw=1, dash=None):
    d = ' stroke-dasharray="%s"' % dash if dash else ""
    return ('<rect x="%g" y="%g" width="%g" height="%g" rx="%g" fill="%s" '
            'stroke="%s" stroke-width="%g"%s/>' % (x, y, w, h, rx, fill, stroke,
                                                   sw, d))


def line(x1, y1, x2, y2, stroke="var(--rule)", sw=1, dash=None):
    d = ' stroke-dasharray="%s"' % dash if dash else ""
    return ('<path d="M%g %gL%g %g" stroke="%s" stroke-width="%g" fill="none"%s/>'
            % (x1, y1, x2, y2, stroke, sw, d))


def arrow(x1, y1, x2, y2, stroke="var(--muted)", sw=1.4):
    import math
    a = math.atan2(y2 - y1, x2 - x1)
    hl, hw = 7.0, 3.6
    bx, by = x2 - hl * math.cos(a), y2 - hl * math.sin(a)
    return (line(x1, y1, bx, by, stroke, sw)
            + '<path d="M%g %gL%g %gL%g %gZ" fill="%s"/>'
              % (x2, y2, bx + hw * math.sin(a), by - hw * math.cos(a),
                 bx - hw * math.sin(a), by + hw * math.cos(a), stroke))


def brace(x1, x2, y, label, colour="var(--muted)", size=10.5, down=True):
    """A flat bracket under (or over) a span, with a centred label."""
    t = 5 if down else -5
    p = [line(x1, y, x1, y + t, colour, 1), line(x2, y, x2, y + t, colour, 1),
         line(x1, y + t, x2, y + t, colour, 1)]
    p.append(txt((x1 + x2) / 2, y + t + (12 if down else -5), label, size, colour,
                 font=DISP, weight=700))
    return "".join(p)


def svg(w, h, body):
    return ('<svg class="fig" viewBox="0 0 %g %g" width="%g" height="%g" '
            'role="img" preserveAspectRatio="xMidYMid meet">%s</svg>'
            % (w, h, w, h, body))


# --- shared components ------------------------------------------------------

def lane_bar(x, y, w, h, stage, show_sub=True):
    """The vector register at scale: every lane drawn, busy ones filled."""
    n, busy = stage["vlmax"], stage["lanes_busy"]
    slot = w / n
    p = [rect(x, y, w, h, "var(--surface-2)", "var(--rule)", 3, 1)]
    p.append(rect(x, y, slot * busy, h, "var(--plus)", "none", 3))
    # lane ticks: every lane if they are wide enough to see, else every 8th
    step = 1 if slot >= 4 else 8
    for i in range(step, n, step):
        col = "var(--on-fill)" if i < busy else "var(--rule)"
        op = ' opacity=".45"' if i < busy else ' opacity=".55"'
        p.append(line(x + i * slot, y + 1, x + i * slot, y + h - 1, col, .6).replace(
            "/>", "%s/>" % op))
    if show_sub and stage["per_lane"] > 1:
        for i in range(n):
            for k in range(1, stage["per_lane"]):
                cx = x + (i + k / stage["per_lane"]) * slot
                p.append(line(cx, y + h * .3, cx, y + h * .7,
                              "var(--on-fill)", .5).replace("/>", ' opacity=".5"/>'))
    p.append(rect(x, y, w, h, "none", "var(--rule)", 3, 1))
    return "".join(p)


def tile_map(x, y, w, h, stage, mark="var(--plus)"):
    """The 64 x 128 weight tile, with what one step touches shaded."""
    cw, ch = w / TILE_COLS, h / TILE_ROWS
    p = [rect(x, y, w, h, "var(--surface-2)", "var(--rule)", 2, 1)]
    for c in range(16, TILE_COLS, 16):
        p.append(line(x + c * cw, y, x + c * cw, y + h, "var(--rule-2)", .6))
    for r in range(16, TILE_ROWS, 16):
        p.append(line(x, y + r * ch, x + w, y + r * ch, "var(--rule-2)", .6))
    sw_, sh = stage["step_cols"] * cw, stage["step_rows"] * ch
    p.append(rect(x, y, max(sw_, 2.5), max(sh, 3), mark, "none", 0))
    p.append(rect(x - 1, y - 1, max(sw_, 2.5) + 2, max(sh, 3) + 2, "none", mark, 1, 1.4))
    p.append(rect(x, y, w, h, "none", "var(--rule)", 2, 1))
    return "".join(p)


def output_dots(x, y, cell, stage, cols=8):
    """64 output rows as a dot matrix; filled = advanced by this one step."""
    p = []
    for i in range(TILE_ROWS):
        r, c = divmod(i, cols)
        on = i < stage["outputs"]
        p.append(rect(x + c * cell, y + r * cell, cell - 2, cell - 2,
                      "var(--good)" if on else "var(--surface-2)",
                      "none" if on else "var(--rule-2)", 1.5, 1))
    return "".join(p)


