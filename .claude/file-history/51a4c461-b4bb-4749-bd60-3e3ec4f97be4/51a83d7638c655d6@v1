// Reader for a drained hybrid_state_v1 file -- the C++ analog of
// orchestrator.abi.validate_state_file + hsim._read_state_mcycle. Header-only:
// it #includes the shared ABI directly, so mcycle/minstret/flags/vlenb are
// struct members with no hand-copied offsets.
#ifndef ANDESIM_STATE_HPP
#define ANDESIM_STATE_HPP

#include <cstdio>
#include <vector>
#include <string>

#include "hybrid/state_abi.h"

namespace andes_sim {

struct StateFile {
  hybrid_state_v1 st{};
  std::string error;  // empty => valid; non-empty describes the rejection
  bool ok() const { return error.empty(); }
};

// Read `path` and validate it (in order): byte size == sizeof(hybrid_state_v1),
// magic == HYBRID_STATE_MAGIC, version == HYBRID_STATE_VERSION. On any failure
// `error` is set and `st` is unspecified; otherwise `st` holds the full state.
inline StateFile read_state_file(const std::string& path) {
  StateFile r;
  std::FILE* f = std::fopen(path.c_str(), "rb");
  if (!f) {
    r.error = path + ": cannot open";
    return r;
  }
  std::fseek(f, 0, SEEK_END);
  const long sz = std::ftell(f);
  std::rewind(f);
  if (sz != static_cast<long>(sizeof(hybrid_state_v1))) {
    r.error = path + ": size " + std::to_string(sz) + " != expected " +
              std::to_string(sizeof(hybrid_state_v1));
    std::fclose(f);
    return r;
  }
  const size_t n = std::fread(&r.st, 1, sizeof(r.st), f);
  std::fclose(f);
  if (n != sizeof(r.st)) {
    r.error = path + ": short read";
    return r;
  }

  char buf[256];
  if (r.st.magic != HYBRID_STATE_MAGIC) {
    std::snprintf(buf, sizeof(buf), "%s: magic 0x%08x != expected 0x%08x",
                  path.c_str(), r.st.magic, HYBRID_STATE_MAGIC);
    r.error = buf;
    return r;
  }
  if (r.st.version != HYBRID_STATE_VERSION) {
    std::snprintf(buf, sizeof(buf), "%s: version %u != expected %u",
                  path.c_str(), r.st.version, HYBRID_STATE_VERSION);
    r.error = buf;
    return r;
  }
  return r;
}

struct StateStream {
  std::vector<hybrid_state_v1> records;
  std::string error;  // empty => valid
  bool ok() const { return error.empty(); }
};

// Read a `.ckpts` checkpoint stream: concatenated hybrid_state_v1 records
// (cosim_redesign F3). Rejects a size that is not a whole number of records
// and any record failing the magic/version check (1-based index in the
// error). An empty file is a valid empty stream.
inline StateStream read_state_stream(const std::string& path) {
  StateStream r;
  std::FILE* f = std::fopen(path.c_str(), "rb");
  if (!f) {
    r.error = path + ": cannot open";
    return r;
  }
  std::fseek(f, 0, SEEK_END);
  const long sz = std::ftell(f);
  std::rewind(f);
  if (sz < 0 || sz % static_cast<long>(sizeof(hybrid_state_v1)) != 0) {
    r.error = path + ": size " + std::to_string(sz) +
              " is not a whole number of " +
              std::to_string(sizeof(hybrid_state_v1)) + "-byte records";
    std::fclose(f);
    return r;
  }
  const size_t count = static_cast<size_t>(sz) / sizeof(hybrid_state_v1);
  for (size_t k = 1; k <= count; ++k) {
    hybrid_state_v1 st{};
    if (std::fread(&st, 1, sizeof(st), f) != sizeof(st)) {
      r.error = path + ": short read at record " + std::to_string(k);
      break;
    }
    if (st.magic != HYBRID_STATE_MAGIC) {
      r.error = path + ": record " + std::to_string(k) + ": bad magic";
      break;
    }
    if (st.version != HYBRID_STATE_VERSION) {
      r.error = path + ": record " + std::to_string(k) + ": version " +
                std::to_string(st.version) + " != expected " +
                std::to_string(HYBRID_STATE_VERSION);
      break;
    }
    r.records.push_back(st);
  }
  std::fclose(f);
  if (!r.ok()) r.records.clear();
  return r;
}

}  // namespace andes_sim

#endif  // ANDESIM_STATE_HPP
