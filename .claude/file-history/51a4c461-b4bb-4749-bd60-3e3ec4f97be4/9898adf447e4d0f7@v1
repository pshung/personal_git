// Each leg's drain file, threaded forward (leg i+1 resumes from leg i's).
std::string state_path(const std::string& workdir, size_t i) {
  return workdir + "/state-" + std::to_string(i) + ".bin";
}

const EngineDescriptor* find_engine(const std::vector<EngineDescriptor>& engines,
                                    const std::string& id) {
  for (const EngineDescriptor& e : engines)
    if (e.id == id) return &e;
  return nullptr;
}

// $VSIM_PLUGIN else the in-repo default (matches the e2e harness / hsim).
std::string resolve_plugin(const std::string& override_path) {
  if (!override_path.empty()) return override_path;
  if (const char* p = std::getenv("VSIM_PLUGIN"); p && *p) return p;
  return default_plugin_path().string();
}

}  // namespace

std::string plan_step_rc_error(size_t step, const Step& s, int expect_rc,
                               int got_rc) {
  std::string m = "plan step " + std::to_string(step) + ": expected exit " +
                  std::to_string(expect_rc) + ", got " + std::to_string(got_rc);
  // A drain step (expect_rc is the handoff/drain code) that exits 0 ran the ELF
  // to completion without ever hitting its ROI boundary -- the marker/pc
  // trigger never fired. This is THE common "unmarked ELF / wrong trigger"
  // mistake; name the kind so the fix is obvious, not a bare exit code.
  if (got_rc == 0 && expect_rc == kDrainRc)
    m += " -- the " + s.role + " ran to completion without reaching its " +
         s.trigger.kind +
         " trigger boundary (the ROI never drained; check the ELF actually "
         "reaches the " +
         s.trigger.kind + ")";
  return m;
}

LegTriggerArgs leg_trigger_args(const Trigger& t, const std::string& role,
                                std::string& err) {
  err.clear();
  LegTriggerArgs out;
  if (t.kind == "marker") return out;  // markers detected by plugin/vsim, not argv

  const bool fast = role == "fast-leg";
  const bool accurate = role == "accurate-leg";
  if (!fast && !accurate) return out;  // other roles carry no trigger args

  // Required-param lookup. A missing key is a caller bug; surface it (don't
  // throw) so plan_argvs can report which step failed.
  auto param = [&](const char* key) -> const std::string* {
    auto it = t.params.find(key);
    if (it == t.params.end()) {
      err = "trigger '" + t.kind + "' missing param '" + key + "'";
      return nullptr;
    }
    return &it->second;
  };

  if (t.kind == "pc") {
    if (fast) {
      if (const std::string* p = param("enter_pc"))
        out.plugin_suffix = ",enter_pc=" + *p;
    } else if (const std::string* p = param("exit_pc")) {
      out.extra = {"--hybrid-exit-pc", *p};
    }
    return out;
  }
  if (t.kind == "icount") {
    if (fast) {
      if (const std::string* p = param("qemu_icount"))
        out.plugin_suffix = ",icount=" + *p;
    } else if (const std::string* p = param("vsim_icount")) {
      out.extra = {"--hybrid-icount", *p};
    }
    return out;
  }

  // verify oracle leg (verify_oracle F4): a pure-QEMU drain at the ROI exit
  // boundary, sampling at vsim's actual halt pc (drain_pc -- the DMI halt
  // lands a few insns past the trigger, and the comparison is only valid at
  // the same architectural point). qemu-only: the oracle plan has no
  // accurate leg.
  if (t.kind == "verify-marker" || t.kind == "verify-pc") {
    if (!fast) return out;
    std::string suffix = ",exit_marker=1";
    if (t.kind == "verify-pc") {
      const std::string* p = param("exit_pc");
      if (!p) return out;
      suffix = ",exit_pc=" + *p;
    }
    if (const std::string* p = param("drain_pc"))
      out.plugin_suffix = suffix + ",drain_pc=" + *p;
    return out;
  }

  // cosim oracle leg (cosim_roi F4): pure QEMU arms at the ROI entry and
  // drains at the vsim checkpoints' retire deltas (`counts`, pre-joined
  // "a:b:c"; the last entry is the final exit-state drain). qemu-only: the
  // oracle plan has no accurate leg.
  if (t.kind == "cosim-marker" || t.kind == "cosim-pc") {
    if (!fast) return out;
    std::string suffix = ",cosim_marker=1";
    if (t.kind == "cosim-pc") {
      const std::string* p = param("enter_pc");
      if (!p) return out;
      suffix = ",cosim_pc=" + *p;
    }
    if (const std::string* p = param("counts"))
      out.plugin_suffix = suffix + ",cosim_counts=" + *p;
    return out;
  }

  err = "unknown trigger kind '" + t.kind + "'";
  return out;
}

std::vector<std::vector<std::string>> plan_argvs(
    const Plan& plan, const std::vector<EngineDescriptor>& engines,
    const std::string& workdir, const RuntimeCtx& ctx, std::string& err) {
  std::vector<std::vector<std::string>> out;
  out.reserve(plan.steps.size());
  std::string prev_state_out;  // empty for the cold first leg

  // hw-config sync: {vlen} comes from the accurate-leg engine's descriptor.
  long vlen = 0;
  for (const Step& s : plan.steps)
    if (s.role == "accurate-leg")
      if (const EngineDescriptor* e = find_engine(engines, s.engine_id))
        if (e->vlen > 0) vlen = e->vlen;
  const std::string vlen_str = std::to_string(synced_vlen(vlen));

  for (size_t i = 0; i < plan.steps.size(); ++i) {
    const Step& step = plan.steps[i];
    const EngineDescriptor* eng = find_engine(engines, step.engine_id);
    if (!eng) {
      err = "plan step " + std::to_string(i) + ": unknown engine '" +
            step.engine_id + "'";
      return {};
    }
    const std::vector<std::string>* tmpl = eng->invoke_for(step.role);
    if (!tmpl) {
      err = "plan step " + std::to_string(i) + ": engine '" + step.engine_id +
            "' has no invoke template for role '" + step.role + "'";
      return {};
    }

    std::string trig_err;
    const LegTriggerArgs lt = leg_trigger_args(step.trigger, step.role, trig_err);
    if (!trig_err.empty()) {
      err = "plan step " + std::to_string(i) + ": " + trig_err;
      return {};
    }

    const std::string state_out = state_path(workdir, i);
    const std::map<std::string, std::string> m = {
        {"bin", eng->bin_path},
        {"elf", plan.elf},
        {"plugin", ctx.plugin_path},
        {"mmap", ctx.mmap_path},
        {"mmap_size", std::to_string(ctx.mem_size)},
        {"mmap_base", ctx.mmap_base},
        {"state_in", prev_state_out},
        {"state_out", state_out},
        {"trigger", lt.plugin_suffix},  // qemu plugin comma-suffix (empty for marker)
        {"vlen", vlen_str},
    };
    std::vector<std::string> argv = build_argv(*tmpl, m, err);
    if (!err.empty()) {
      err = "plan step " + std::to_string(i) + ": " + err;
      return {};
    }
    // Trigger's vsim tokens, then user-forwarded per-leg flags -- both verbatim
    // after the filled template (matches tests/e2e.sh's ordering).
    argv.insert(argv.end(), lt.extra.begin(), lt.extra.end());
    argv.insert(argv.end(), step.extra_args.begin(), step.extra_args.end());
    out.push_back(std::move(argv));
    prev_state_out = state_out;
  }
  err.clear();
  return out;
}

PlanResult run_plan(const Plan& plan,
                    const std::vector<EngineDescriptor>& engines,
                    const PlanOptions& opts) {
  PlanResult res;
  if (plan.steps.empty()) {
    res.error = "plan has no steps";
    return res;
  }

  // Acquire the shared mmap: allocate one (and own it) when none is pinned.
  std::string mmap_path = plan.mmap_path;
  const bool own_mmap = mmap_path.empty();
  if (own_mmap) {
    std::string err;
    // L26/F2: back the mmap with one V-scratch page above the program's RAM.
    mmap_path = allocate(physical_mmap_bytes(plan.mem_size), err);
    if (mmap_path.empty()) {
      res.error = err;
      return res;
    }
  }

  // A private dir for the threaded drain files.
  std::error_code ec;
  fs::path workdir = fs::temp_directory_path(ec) / "andesim-plan-XXXXXX";
  std::string tmpl = workdir.string();
  std::vector<char> tbuf(tmpl.begin(), tmpl.end());
  tbuf.push_back('\0');
  const char* made = ::mkdtemp(tbuf.data());
  if (!made) {
    if (own_mmap) ::unlink(mmap_path.c_str());
    res.error = "failed to create plan work dir";
    return res;
  }
  const std::string wd = made;

  RuntimeCtx ctx;
  ctx.mmap_path = mmap_path;
  // L26/F2: the legs (QEMU backend size, vsim --shared-mem-size) see the
  // PHYSICAL window -- program RAM plus the V-scratch page. The program's own
  // linker script still uses only --mem-size, so the scratch page sits above
  // everything it can address.
  ctx.mem_size = physical_mmap_bytes(plan.mem_size);
  ctx.plugin_path = resolve_plugin(opts.plugin_path);  // mmap_base keeps its "0x0" default

  std::string err;
  const std::vector<std::vector<std::string>> argvs =
      plan_argvs(plan, engines, wd, ctx, err);
  if (!err.empty()) {
    res.error = err;
  } else {
    for (size_t i = 0; i < argvs.size(); ++i) {
      const RunResult r = run_process(argvs[i], opts.timeout_ms);
      if (r.spawn_failed) {
        res.error = "plan step " + std::to_string(i) + ": failed to spawn";
        break;
      }
      if (r.timed_out) {
        res.error = "plan step " + std::to_string(i) + ": timed out after " +
                    std::to_string(opts.timeout_ms) + " ms";
        break;
      }
      if (r.rc != opts.expect_rc) {
        res.error = plan_step_rc_error(i, plan.steps[i], opts.expect_rc, r.rc);
        break;
      }
      const StateFile sf = read_state_file(state_path(wd, i));
      if (!sf.ok()) {
        res.error = "plan step " + std::to_string(i) + ": " + sf.error;
        break;
      }
      // cosim checkpoints (`<state_out>.ckpts` stream, cosim_redesign F3):
      // read them back now, before the workdir teardown deletes the file.
      std::vector<hybrid_state_v1> ckpts;
      const std::string stream_p = state_path(wd, i) + ".ckpts";
      if (fs::exists(stream_p, ec)) {
        StateStream cs = read_state_stream(stream_p);
        if (!cs.ok()) {
          res.error = "plan step " + std::to_string(i) + ": " + cs.error;
          break;
        }
        ckpts = std::move(cs.records);
      }
      res.phases.push_back(
          {sf.st.mcycle, sf.st.minstret, r.out, sf.st, std::move(ckpts)});
    }
  }

  fs::remove_all(wd, ec);
  if (own_mmap) ::unlink(mmap_path.c_str());
  return res;
}

}  // namespace andes_sim
