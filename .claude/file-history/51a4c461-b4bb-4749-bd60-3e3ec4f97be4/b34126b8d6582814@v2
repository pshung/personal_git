// Unit tests for the F5 infra helpers:
//   - parse_size          (driver/shm.hpp)   size-spec parsing
//   - exec_passthrough    (driver/process.hpp) exit-code propagation
//   - run_process         (driver/process.hpp) timeout kill + capture
//   - read_state_file     (driver/state.hpp)  hybrid_state_v1 read + validate
//
// Plain assert-and-count harness (no doctest); each CHECK bumps a failure
// counter and the process exits non-zero if any failed. Run by
// tests/andes_sim/test_andes_sim_f5.sh.
#include <cstdint>
#include <cstdlib>
#include <string>
#include <vector>

#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

#include "hybrid/state_abi.h"
#include "process.hpp"
#include "shm.hpp"
#include "state.hpp"
#include "test_check.hpp"

using namespace andes_sim;

int main() {
  // --- parse_size: <number>[K|M|G|T] -> byte count ---
  {
    std::string err;
    CHECK(parse_size("1024", err) == 1024 && err.empty());
    CHECK(parse_size("128M", err) == 128LL * 1024 * 1024);
    CHECK(parse_size("512M", err) == 512LL * 1024 * 1024);
    CHECK(parse_size("8G", err) == 8LL * 1024 * 1024 * 1024);
    CHECK(parse_size("1T", err) == 1LL * 1024 * 1024 * 1024 * 1024);
    // fractional value truncates like Python int(float(num) * mult)
    CHECK(parse_size("1.5G", err) ==
          static_cast<long long>(1.5 * 1024 * 1024 * 1024));
    // suffix is case-insensitive and surrounding whitespace is tolerated
    CHECK(parse_size("  64m  ", err) == 64LL * 1024 * 1024);
    // malformed specs return 0 and set err
    for (const char* bad : {"", "8X", "0", "abc", "-4", "1.2.3"}) {
      err.clear();
      CHECK(parse_size(bad, err) == 0 && !err.empty());
    }
  }

  // --- L26/F2: the physical shared mmap reserves one V-scratch page ABOVE the
  //     program's --mem-size, so the scratch sits past the program's declared
  //     RAM (scheme D: no program layout can collide). ---
  {
    CHECK(physical_mmap_bytes(128LL * 1024 * 1024)
          == 128LL * 1024 * 1024 + HYBRID_V_SCRATCH_BYTES);
    CHECK(physical_mmap_bytes(0) == HYBRID_V_SCRATCH_BYTES);
    // The largest --mem-size keeps physical within the 2 GiB AE350 DRAM window.
    CHECK(max_program_mem_bytes()
          == 2LL * 1024 * 1024 * 1024 - HYBRID_V_SCRATCH_BYTES);
    // A program exactly at the cap maps the full DRAM window, no more.
    CHECK(physical_mmap_bytes(max_program_mem_bytes())
          == 2LL * 1024 * 1024 * 1024);
  }

  // --- resolve_mmap_dir: first-fit over backing-store tiers ---
  {
    const long long kFit = 1024 + kMmapSafetyMargin;  // exactly enough
    std::vector<MmapTier> tiers = {{"/shm", "/dev/shm"},
                                   {"/cache", "~/.cache/andesim"}};
    std::string err;

    // tier 1 fits -> chosen, no fallback note
    {
      auto probe = [&](const std::string&) -> long long { return kFit; };
      MmapDirChoice c = resolve_mmap_dir(tiers, 1024, probe, err);
      CHECK(c.dir == "/shm" && c.note.empty() && err.empty());
    }
    // tier 1 too small -> tier 2 with a note naming tier 1 and its free space
    {
      auto probe = [&](const std::string& d) -> long long {
        return d == "/shm" ? 4096 : kFit;
      };
      MmapDirChoice c = resolve_mmap_dir(tiers, 1024, probe, err);
      CHECK(c.dir == "/cache" && err.empty());
      CHECK(c.note.find("/dev/shm") != std::string::npos);
      CHECK(c.note.find("too small") != std::string::npos);
    }
    // tier 1 missing (probe -1) -> tier 2 with a "missing" note
    {
      auto probe = [&](const std::string& d) -> long long {
        return d == "/shm" ? -1 : kFit;
      };
      MmapDirChoice c = resolve_mmap_dir(tiers, 1024, probe, err);
      CHECK(c.dir == "/cache" && err.empty());
      CHECK(c.note.find("missing") != std::string::npos);
    }
    // nothing fits -> "" and an error naming every tier + the override hint
    {
      auto probe = [&](const std::string&) -> long long { return 4096; };
      MmapDirChoice c = resolve_mmap_dir(tiers, 1024, probe, err);
      CHECK(c.dir.empty() && !err.empty());
      CHECK(err.find("/dev/shm") != std::string::npos);
      CHECK(err.find("~/.cache/andesim") != std::string::npos);
      CHECK(err.find("HSIM_MMAP_DIR") != std::string::npos);
    }
    // a single pinned tier that does not fit -> hard error (no fallback)
    {
      std::vector<MmapTier> pin = {{"/pin", "HSIM_MMAP_DIR='/pin'"}};
      auto probe = [&](const std::string&) -> long long { return 4096; };
      MmapDirChoice c = resolve_mmap_dir(pin, 1024, probe, err);
      CHECK(c.dir.empty() && err.find("HSIM_MMAP_DIR") != std::string::npos);
    }
  }

  // --- qemu_m_args: --mem-size spec -> the fast leg's plain `-m` argv ---
  // QEMU's -m takes MiB (plain number) or M/G suffixes, so we convert the
  // byte count to MiB and reject sizes that are not a whole MiB.
  {
    std::string err;
    const std::vector<std::string> want256 = {"-m", "256M"};
    CHECK(qemu_m_args("256M", err) == want256 && err.empty());
    const std::vector<std::string> want2g = {"-m", "2048M"};
    CHECK(qemu_m_args("2G", err) == want2g && err.empty());
    // raw bytes work when they are a whole MiB
    CHECK(qemu_m_args("134217728", err) ==
          std::vector<std::string>({"-m", "128M"}));
    // empty spec -> no args (QEMU as-is), no error
    CHECK(qemu_m_args("", err).empty() && err.empty());
    // not a whole MiB -> error
    CHECK(qemu_m_args("1000", err).empty() && !err.empty());
    err.clear();
    // malformed spec -> error
    CHECK(qemu_m_args("8X", err).empty() && !err.empty());
  }

  // --- mmap_tiers: env -> candidate list ---
  {
    // HSIM_MMAP_DIR pins a single tier
    setenv("HSIM_MMAP_DIR", "/pinned/dir", 1);
    std::vector<MmapTier> t = mmap_tiers();
    CHECK(t.size() == 1 && t[0].dir == "/pinned/dir");
    CHECK(t[0].label.find("HSIM_MMAP_DIR") != std::string::npos);
    unsetenv("HSIM_MMAP_DIR");

    // default: /dev/shm first, then a disk-backed cache dir (XDG-aware),
    // which mmap_tiers creates so the free-space probe can see it
    char cache_tmpl[] = "/tmp/andesim-cache.XXXXXX";
    CHECK(mkdtemp(cache_tmpl) != nullptr);
    setenv("XDG_CACHE_HOME", cache_tmpl, 1);
    t = mmap_tiers();
    CHECK(t.size() == 2 && t[0].dir == "/dev/shm");
    const std::string want_cache = std::string(cache_tmpl) + "/andesim";
    CHECK(t[1].dir == want_cache);
    struct stat sb;
    CHECK(stat(want_cache.c_str(), &sb) == 0 && S_ISDIR(sb.st_mode));
    unsetenv("XDG_CACHE_HOME");
    std::string rmcmd = "rm -rf " + std::string(cache_tmpl);
    CHECK(system(rmcmd.c_str()) == 0);
  }

  // --- wsl_warnings: doctor advice for WSL2 hosts ---
  {
    const std::vector<MmapTier> tiers = {{"/dev/shm", "/dev/shm"},
                                         {"/home/u/.cache/andesim",
                                          "~/.cache/andesim"}};
    // not WSL -> no advice
    CHECK(wsl_warnings("Linux version 6.9-arch1", "/home/u/repo", tiers)
              .empty());
    // WSL2 -> the .wslconfig memory hint, at least
    {
      auto w = wsl_warnings("Linux version 5.15.x-microsoft-standard-WSL2",
                            "/home/u/repo", tiers);
      CHECK(!w.empty());
      bool has_wslconfig = false;
      for (const std::string& s : w)
        if (s.find(".wslconfig") != std::string::npos) has_wslconfig = true;
      CHECK(has_wslconfig);
    }
    // repo or a tier dir under /mnt/ (drvfs) -> a dedicated warning
    {
      auto w = wsl_warnings("microsoft-standard-WSL2", "/mnt/c/work/repo",
                            tiers);
      bool has_mnt = false;
      for (const std::string& s : w)
        if (s.find("/mnt/") != std::string::npos) has_mnt = true;
      CHECK(has_mnt);
    }
    {
      std::vector<MmapTier> pin = {{"/mnt/d/scratch", "HSIM_MMAP_DIR"}};
      auto w = wsl_warnings("microsoft-standard-WSL2", "/home/u/repo", pin);
      bool has_mnt = false;
      for (const std::string& s : w)
        if (s.find("/mnt/") != std::string::npos) has_mnt = true;
      CHECK(has_mnt);
    }
  }

  // --- exec_passthrough: forwards the child's exit code ---
  {
    CHECK(exec_passthrough({"sh", "-c", "exit 0"}) == 0);
    CHECK(exec_passthrough({"sh", "-c", "exit 7"}) == 7);
    CHECK(exec_passthrough({"sh", "-c", "exit 42"}) == 42);
    // a binary that cannot be exec'd reports 127 (exec failure)
    CHECK(exec_passthrough({"/nonexistent/andesim-xyz"}) == 127);
    // empty argv: nothing to run
    CHECK(exec_passthrough({}) == -1);
  }

  // --- run_process: a slow child is killed at the timeout ---
  {
    RunResult r = run_process({"sh", "-c", "sleep 5"}, 150);
    CHECK(r.timed_out);
    CHECK(r.rc == -1);
  }
  // --- run_process: a fast child's stdout is captured and rc propagated ---
  {
    RunResult r = run_process({"sh", "-c", "printf hello; exit 3"}, 2000);
    CHECK(!r.timed_out);
    CHECK(r.rc == 3);
    CHECK(r.out == "hello");
  }

  // --- read_state_file: round-trip a known-good hybrid_state_v1 ---
  {
    hybrid_state_v1 st{};
    st.magic = HYBRID_STATE_MAGIC;
    st.version = HYBRID_STATE_VERSION;
    st.flags = HYBRID_FLAG_RV64 | HYBRID_FLAG_V;
    st.mcycle = 123456;
    st.minstret = 7890;
    st.vlenb = 64;

    char path[] = "/tmp/andesim-state.XXXXXX";
    int fd = mkstemp(path);
    CHECK(fd >= 0);
    CHECK(write(fd, &st, sizeof(st)) == static_cast<ssize_t>(sizeof(st)));
    close(fd);

    StateFile good = read_state_file(path);
    CHECK(good.ok());
    CHECK(good.error.empty());
    CHECK(good.st.mcycle == 123456);
    CHECK(good.st.minstret == 7890);
    CHECK(good.st.flags == (HYBRID_FLAG_RV64 | HYBRID_FLAG_V));
    CHECK(good.st.vlenb == 64);

    // a bad magic is rejected
    st.magic = 0xdeadbeefu;
    int fd2 = open(path, O_WRONLY | O_TRUNC);
    CHECK(fd2 >= 0);
    CHECK(write(fd2, &st, sizeof(st)) == static_cast<ssize_t>(sizeof(st)));
    close(fd2);
    CHECK(!read_state_file(path).ok());

    // a truncated file (wrong size) is rejected
    st.magic = HYBRID_STATE_MAGIC;
    int fd3 = open(path, O_WRONLY | O_TRUNC);
    CHECK(fd3 >= 0);
    CHECK(write(fd3, &st, 16) == 16);
    close(fd3);
    CHECK(!read_state_file(path).ok());

    unlink(path);
  }
  // a missing file is rejected (not a crash)
  CHECK(!read_state_file("/nonexistent/andesim-no-such-state").ok());

  return andes_sim::test::report("infra");
}
