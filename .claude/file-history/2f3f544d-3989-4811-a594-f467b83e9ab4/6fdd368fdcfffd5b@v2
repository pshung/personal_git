// sim_control.hpp #include's htif/sys_call.hpp *inside* the SimControl class
// body (see that file's own header comment), so sys_call.hpp's own <sys/
// stat.h>/<fcntl.h>/<unistd.h> includes land at class scope instead of global
// scope unless something already pulled them in at global scope first -- the
// production build gets this for free via an earlier transitive include;
// a standalone test does not, so pull them in explicitly, first.
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

#include "platform/sim_control.hpp"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include <array>
#include <cstdint>
#include <cstring>

namespace {

// Mirrors the real ax66_makatau bug: its guest programs place DRAM (stack,
// heap, globals -- including the HTIF magicmem struct) at an "alias" base
// (RAM_ALIAS_BASE, 0x800000000 in production) instead of the primary base
// (0x0) every other engine uses. Small synthetic bases here keep the backing
// buffer tiny; the bug reproduces at any base gap, not just the real one.
constexpr uint64_t kPrimaryBase = 0x0;
constexpr uint64_t kAliasBase = 0x2000;
// Must cover both the correct offset and the bug's wrongly-computed offset,
// so a still-buggy dispatch()/guest_va_to_host() reads/writes a wrong-but-
// in-bounds location instead of corrupting unrelated memory.
constexpr uint64_t kBufEnd = 0x2fff;

struct Fixture
{
  SimpleMemory<64> mem{"mem", MemoryRegion{kPrimaryBase, kBufEnd},
                      MemoryRegion{kAliasBase, kAliasBase + 0xff}};
  sc_core::sc_signal<sc_dt::sc_uint<31>> int_trigger{"int_trigger"};
  sc_core::sc_clock clk{"clk", sc_core::sc_time{1, sc_core::SC_NS}};
  SimControl<64> sim_control{"sim_control", MemoryRegion{0xe0080000, 0xe0080fff},
                             mem, int_trigger, clk};

  // One 64-bit HTIF command write, as the guest's htif_syscall() does: the
  // command's low 48 bits are the guest's pointer to its magicmem struct.
  void send_htif_command(uint64_t payload)
  {
    std::array<uint8_t, 8> bytes;
    std::memcpy(bytes.data(), &payload, 8);
    tlm::tlm_generic_payload gp;
    gp.set_command(tlm::TLM_WRITE_COMMAND);
    gp.set_address(0xe0080000 + HTIF_CMD_OFFSET);
    gp.set_data_ptr(bytes.data());
    gp.set_data_length(bytes.size());
    gp.set_response_status(tlm::TLM_INCOMPLETE_RESPONSE);
    sc_core::sc_time delay = sc_core::SC_ZERO_TIME;
    sim_control.b_transport(gp, delay);
  }
};

}  // namespace

TEST_CASE("dispatch resolves the guest's magicmem pointer through the alias region")
{
  Fixture f;

  // Guest's magicmem struct: an unrecognized syscall number (99), so
  // dispatch() takes the deterministic "invalid syscall" path and writes
  // back -1 regardless of which (right or wrong) location it reads from --
  // this isolates the test to pointer resolution, not syscall behavior.
  uint64_t magicmem[8] = {99, 0, 0, 0, 0, 0, 0, 0};
  std::memcpy(f.mem.data.data() + 0x40, magicmem, sizeof(magicmem));

  // The guest thinks its struct lives at kAliasBase + 0x40.
  f.send_htif_command(kAliasBase + 0x40);

  uint64_t at_real_location;
  std::memcpy(&at_real_location, f.mem.data.data() + 0x40, 8);
  CHECK(at_real_location == static_cast<uint64_t>(-1));
}

TEST_CASE("handle_gettimeofday resolves the guest's tv pointer through the alias region")
{
  Fixture f;

  // Outer magicmem struct lives at a plain primary-region address (0x40),
  // deliberately not under test here, so this case isolates
  // guest_va_to_host() (used for the *inner* tv pointer) from dispatch()'s
  // own magicmem pointer math (covered by the test case above).
  uint64_t magicmem[8] = {5 /* VH_SYS_GETTIMEOFDAY */, kAliasBase + 0x80, 0,
                          0, 0, 0, 0, 0};
  std::memcpy(f.mem.data.data() + 0x40, magicmem, sizeof(magicmem));

  f.send_htif_command(0x40);

  uint64_t tv_sec;
  std::memcpy(&tv_sec, f.mem.data.data() + 0x80, 8);
  CHECK(tv_sec > 1'700'000'000);  // any real wall-clock time is well past this
}
