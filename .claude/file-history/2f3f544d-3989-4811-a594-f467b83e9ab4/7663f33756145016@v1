cpus:
  # binary_name:
  #  rtl_package: path to the RTL package dir; absolute, or relative to the
  #               project source root (e.g. external/ax66eng or ../shared/cpu)
  #  cpp_wrapper: name of the C++ wrapper class in src/cpu_wrappers/[wrapper].hpp
  #  config: path to the CPU configuration file
  #  config_dir: directory containing config.inc
  #  libaceasim_path: optional, /path/to/your/libaceasim.a , support asim if given
  #  pipeline_view: false , if you want to disable exposing internal signals,
  #                 default is true
  ax45mpv_premium:
    cpu_series: 45
    rtl_package: external/ax45mpv_premium
    cpp_wrapper: ax45mpv_premium_cpu_cluster_subsystem
    config: data/configs/ax45mpv_premium_full.cfg
    config_dir: andes_ip/kv_core/top/hdl
    config_inc_filter: grep '^`define NDS_'
    extra_verilator_flags: --threads 8 --unroll-count 256
  ax46mpv_advanced:
    cpu_series: 46
    rtl_package: external/ax46mpv_advanced
    cpp_wrapper: ax46mpv_cpu_cluster_subsystem
    config: data/configs/ax46mpv_advanced.cfg
    config_dir: andes_ip/kv_core/top/hdl
    config_inc_filter: grep '^`define NDS_'
    extra_verilator_flags: --threads 8 --unroll-count 256
  d45:
    cpu_series: 45
    rtl_package: external/d45
    cpp_wrapper: d45_cpu_cluster_subsystem
    config: data/configs/d45.cfg
    config_dir: andes_ip/kv_core/top/hdl
    config_inc_filter: grep '^`define NDS_'
    extra_verilator_flags: --threads 8 --unroll-count 256
