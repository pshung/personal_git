#include "cli.hpp"

#include "options.hpp"

namespace andes_sim {
namespace {

// Read a value option at args[i]. Both spellings: `--flag value` (consumes the
// next token, advancing i) and `--flag=value`.
//   returns  true  = `out` set
//            false = the token is `--flag` and nothing follows it
bool read_value(const std::vector<std::string>& args, size_t& i,
                const std::string& flag, std::string& out) {
  const std::string& a = args[i];
  if (a == flag) {
    if (i + 1 >= args.size()) return false;
    out = args[++i];
    return true;
  }
  out = a.substr(flag.size() + 1);  // the caller matched `--flag=`
  return true;
}

// The option name in a token, i.e. everything before a `=`.
std::string_view option_name(const std::string& tok) {
  const size_t eq = tok.find('=');
  return eq == std::string::npos ? std::string_view(tok)
                                 : std::string_view(tok).substr(0, eq);
}

}  // namespace

bool is_subcommand(std::string_view name) {
  return name == "run" || name == "list" || name == "doctor" ||
         name == "profile";
}

Cli parse_cli(const std::vector<std::string>& args) {
  Cli c;
  if (args.empty()) return c;  // no subcommand; caller prints usage

  // First token is the subcommand, unless it is a top-level help request.
  if (args[0] == "-h" || args[0] == "--help") {
    c.help = true;
    return c;
  }

  // `run` is the default command: any other first token is `run`'s own
  // first argument (a flag or the ELF), not a subcommand.
  size_t first = 1;
  if (is_subcommand(args[0])) {
    c.subcommand = args[0];
  } else {
    c.subcommand = "run";
    first = 0;
  }
  const unsigned bit = cmd_bit(c.subcommand);

  for (size_t i = first; i < args.size(); ++i) {
    const std::string& a = args[i];

    if (a == "--") {  // the passthrough boundary: rest is verbatim
      for (size_t j = i + 1; j < args.size(); ++j) c.passthrough.push_back(args[j]);
      break;
    }

    const std::string_view name = option_name(a);
    const Option* o = find_option(name, bit);
    if (o) {
      // A row exists, but not for this command: say so, and say where the
      // option does live. Silently swallowing it is how `run --limit 5` used
      // to look like it had done something.
      if (!(o->cmds & bit)) {
        c.error = wrong_command_error(*o, c.subcommand);
        return c;
      }
      if (o->arity == Arity::Switch && name.size() == a.size()) {
        c.*(o->on) = o->sets;
        continue;
      }
      if (o->arity == Arity::Value) {
        if (!read_value(args, i, o->flag, c.*(o->str))) {
          c.error = std::string("missing value for ") + o->flag;
          return c;
        }
        continue;
      }
      // A switch written `--verify=1`: not a spelling the tool takes.
    }

    if (a.size() > 1 && a[0] == '-') {
      c.error = "unknown option: " + a;
      return c;
    }
    c.positional.push_back(a);
  }

  return c;
}

Cli parse_cli(int argc, char** argv) {
  std::vector<std::string> args;
  args.reserve(argc > 1 ? static_cast<size_t>(argc - 1) : 0);
  for (int i = 1; i < argc; ++i) args.emplace_back(argv[i]);
  return parse_cli(args);
}

}  // namespace andes_sim
