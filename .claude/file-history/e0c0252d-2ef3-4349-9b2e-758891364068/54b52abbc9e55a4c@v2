const std::vector<Option>& options() { return table(); }

unsigned cmd_bit(std::string_view subcommand) {
  if (subcommand == "run") return kRunCmd;
  if (subcommand == "profile") return kProfileCmd;
  if (subcommand == "list") return kListCmd;
  if (subcommand == "doctor") return kDoctorCmd;
  return 0;
}

const Option* find_option(std::string_view name, unsigned bit) {
  const Option* elsewhere = nullptr;
  for (const Option& o : table()) {
    if (o.arity == Arity::Boundary || name != o.flag) continue;
    if (o.cmds & bit) return &o;
    if (!elsewhere) elsewhere = &o;
  }
  return elsewhere;
}

std::string wrong_command_error(const Option& o, const std::string& subcommand) {
  static const struct {
    unsigned bit;
    const char* name;
  } kNames[] = {{kRunCmd, "run"},
                {kProfileCmd, "profile"},
                {kListCmd, "list"},
                {kDoctorCmd, "doctor"}};
  // Every command that takes this spelling, not just the row we happened to
  // find: --engine and --objdump each have a row per command, and a user sent
  // to one of the two is sent to the wrong one half the time.
  unsigned owners = 0;
  for (const Option& row : table())
    if (std::string_view(row.flag) == o.flag) owners |= row.cmds;

  std::string named;
  for (const auto& n : kNames)
    if (owners & n.bit) {
      if (!named.empty()) named += "/";
      named += n.name;
    }
  return std::string(o.flag) + " is not a " + subcommand +
         " option (see 'andesim " + named + " --help')";
}

void print_command_options(std::FILE* out, unsigned bit) {
  print_block(out, "options:", owned_by, bit);
}

void print_global_options(std::FILE* out) {
  print_block(out, "global options (every command):", global, 0);
}

