// The help column: the row's own indent, its spelling, and its metavar --
// unless the row spells the column out itself (`-h, --help`, `-- <args...>`).
std::string column(const Option& o) {
  if (o.label[0]) return o.label;
  std::string s(o.indent ? 4 : 2, ' ');
  s += o.flag;
  if (o.metavar[0]) {
    s += ' ';
    s += o.metavar;
  }
  return s;
}

void print_row(std::FILE* out, const Option& o) {
  if (o.tag[0])
    std::fprintf(out, "%-29s %s  %s\n", column(o).c_str(), o.tag, o.brief);
  else
    std::fprintf(out, "%-29s %s\n", column(o).c_str(), o.brief);
}

// `select` says which rows belong to this block; the heading and the trailing
// blank line appear only when at least one row does.
void print_block(std::FILE* out, const char* heading,
                 bool (*select)(const Option&, unsigned), unsigned bit) {
  bool any = false;
  for (const Option& o : table()) {
    if (o.hidden || !select(o, bit)) continue;
    if (!any) {
      std::fprintf(out, "%s\n", heading);
      any = true;
    }
    print_row(out, o);
  }
  if (any) std::fputs("\n", out);
}

bool owned_by(const Option& o, unsigned bit) {
  return (o.cmds & bit) && o.cmds != kEveryCmd;
}
bool global(const Option& o, unsigned) { return o.cmds == kEveryCmd; }

