// The andesim option table -- one description of every option the tool takes.
//
// There used to be two lists: the parser's (which options are accepted) and
// help's (which options are advertised). Nothing held them together, so an
// option could be accepted and never mentioned, and a user had no way to find
// it. This table is the single source: the parser reads a row's left half
// (spelling, arity, owning commands, destination) and the help printer its
// right half (indent, metavar, tag, brief). An option that exists is therefore
// an option that prints -- unless the row says `hidden`, which only a second
// spelling of an already-printed option ever uses.
#ifndef ANDESIM_OPTIONS_HPP
#define ANDESIM_OPTIONS_HPP

#include <cstdio>
#include <string>
#include <string_view>
#include <vector>

#include "cli.hpp"

namespace andes_sim {

// Which commands accept an option, as a bitmask so one row can serve several.
// A row that names every command is a global option (--log-level and friends):
// help prints those once, in their own section, for every command.
enum CmdBit : unsigned {
  kRunCmd = 1u << 0,
  kProfileCmd = 1u << 1,
  kListCmd = 1u << 2,
  kDoctorCmd = 1u << 3,
  kEveryCmd = kRunCmd | kProfileCmd | kListCmd | kDoctorCmd,
};

// How the parser consumes the token.
enum class Arity {
  Switch,    // --verify              -> sets `on` to `sets`
  Value,     // --mem-size 2G | =2G   -> stores the value in `str`
  Boundary,  // -- <args...>          -> help only; the parser handles `--`
};

struct Option {
  const char* flag = "";        // the spelling the parser matches
  Arity arity = Arity::Switch;
  unsigned cmds = 0;            // the commands that accept it
  std::string Cli::* str = nullptr;  // Arity::Value destination
  bool Cli::* on = nullptr;          // Arity::Switch destination
  bool sets = true;             // what a Switch writes (--no-llm writes false)
  int indent = 0;               // help nesting: 1 = under the row above
  const char* metavar = "";     // "<spec>", "fast|cycle|hybrid"; "" for a switch
  const char* tag = "";         // "REQUIRED", "REQUIRED for hybrid"; "" for none
  const char* brief = "";
  const char* label = "";       // overrides the composed help column
  bool hidden = false;          // a second spelling of a row already printed
};

const std::vector<Option>& options();

// The bit for a command name; 0 for a name that is not a command.
unsigned cmd_bit(std::string_view subcommand);

// The row that answers `name` for a command, preferring the command's own row
// when a spelling is shared (--engine means one thing to run, another to
// profile). Null when no row carries the spelling at all. A returned row whose
// `cmds` lacks `bit` is an option this command does not take.
const Option* find_option(std::string_view name, unsigned bit);

// Why `flag` is wrong here, naming the command that does take it.
std::string wrong_command_error(const Option& o, const std::string& subcommand);

// One command's own options, then the globals every command shares. Each ends
// with a blank line when it printed anything.
void print_command_options(std::FILE* out, unsigned bit);
void print_global_options(std::FILE* out);

}  // namespace andes_sim

#endif  // ANDESIM_OPTIONS_HPP
