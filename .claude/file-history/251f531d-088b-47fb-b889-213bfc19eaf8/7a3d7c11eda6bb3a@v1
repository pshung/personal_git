// Andes-CSR capability gating. A core implements only the Andes CSRs its
// config.inc enables; restoring a CSR the core lacks can hang the DMI
// handshake (observed on ax45mpv_premium: ucode + mecc_code). So the
// resume/drain loops transport only the CSRs the target core supports. This
// pins the CSR-address -> feature-gate map and the premium subset.
#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/andes_caps.hpp"
#include "hybrid/state_abi.h"

#include <algorithm>
#include <string>
#include <vector>

using hybrid::AndesCaps;
using hybrid::AndesGate;

// ax45mpv_premium config.inc: CoDense + ILM + DLM + perf monitor on
// (NDS_PERFORMANCE_MONITOR_INT=1); NDS_SSCOFPMF_SUPPORT=0 so the Andes PMNDS
// counter scheme is live (PMNDS gate on); DSP, ECC, PowerBrake, StackSafe,
// PMA off; M-only (NDS_NUM_PRIVILEGE_LEVELS=1 -> UMODE + PMNDS_UMODE off).
static AndesCaps premium()
{
  AndesCaps c = AndesCaps::none();
  c.set(AndesGate::CODENSE);
  c.set(AndesGate::ILM);
  c.set(AndesGate::DLM);
  c.set(AndesGate::PERF_MONITOR);
  c.set(AndesGate::PMNDS);
  c.set(AndesGate::CCTL);    // 64K I$/D$ -> cache CCTL CSRs exist
  c.set(AndesGate::ALT_FP);  // NDS_BFLOAT16_ARITH_SUPPORT=1 + ACE
  return c;
}

// ax46mpv_advanced config.inc: perf monitor on BUT NDS_SSCOFPMF_SUPPORT=1 --
// the standard Sscofpmf scheme replaces the Andes PMNDS counter CSRs, so the
// PMNDS gates stay off. CoDense + ILM + DLM + PMA on; M-only.
static AndesCaps advanced()
{
  AndesCaps c = AndesCaps::none();
  c.set(AndesGate::CODENSE);
  c.set(AndesGate::ILM);
  c.set(AndesGate::DLM);
  c.set(AndesGate::PERF_MONITOR);
  c.set(AndesGate::PMA);
  c.set(AndesGate::TRIGGER);
  c.set(AndesGate::CCTL);    // 64K I$/D$
  c.set(AndesGate::ALT_FP);  // BF16 arith + ACE
  return c;
}

TEST_CASE("registration audit: the three under-claim classes are gated right")
{
  // Found by the ax46mpv_advanced registration audit (both engines'
  // kv_csr_dec.v existent_csr agree with the SPA on all three):
  // 1. mnvec 0x7C3: spec "IM Requirement: Required", RTL unconditional --
  //    it is base Andes NMI state, NOT part of Smrnmi (0x740-0x744, which
  //    these cores genuinely lack).
  CHECK(AndesCaps::none().supports_csr(0x7C3));   // ALWAYS
  // 2. mcctlbeginaddr/mcctldata: exist with the cache RAMs (RTL:
  //    CACHE_SUPPORT_INT), on BOTH engines; the old binding pointed at
  //    NDS_CCTLCSR macros no config generation emits.
  CHECK(premium().supports_csr(0x7CB));
  CHECK(advanced().supports_csr(0x7CD));
  CHECK_FALSE(AndesCaps::none().supports_csr(0x7CB));  // cache-less core
  // 3. umisc_ctl 0x813: spec ALT_FP_FMT|CST_CTL, RTL BF16_ARITH|ACE --
  //    "Access Mode: User and above" is who may TOUCH it, not an existence
  //    condition; the old UMODE gate dropped it on both (M-only) engines.
  CHECK(premium().supports_csr(0x813));
  CHECK(advanced().supports_csr(0x813));
  AndesCaps umode_only = AndesCaps::none();
  umode_only.set(AndesGate::UMODE);
  CHECK_FALSE(umode_only.supports_csr(0x813));    // U-mode alone: no
}

TEST_CASE("all() transports every Andes CSR (default = no gating)")
{
  const AndesCaps c = AndesCaps::all();
  CHECK(c.supports_csr(0x801));  // ucode
  CHECK(c.supports_csr(0x7C2));  // mecc_code
  CHECK(c.supports_csr(0x800));  // uitb
}

TEST_CASE("premium skips the CSRs its config lacks -- no hang")
{
  const AndesCaps c = premium();
  CHECK_FALSE(c.supports_csr(0x801));  // ucode      (DSP off)  -- the hang case
  CHECK_FALSE(c.supports_csr(0x7C2));  // mecc_code  (ECC off)  -- the hang case
  CHECK_FALSE(c.supports_csr(0x7C5));  // mpft_ctl   (PowerBrake off)
  CHECK_FALSE(c.supports_csr(0x7C6));  // mhsp_ctl   (StackSafe off)
  CHECK_FALSE(c.supports_csr(0x7C7));  // msp_bound
  CHECK_FALSE(c.supports_csr(0x7C8));  // msp_base
  CHECK_FALSE(c.supports_csr(0x7D1));  // mcountermask_m (M-only: needs U-mode)
  CHECK_FALSE(c.supports_csr(HYBRID_PMA_ADDR0_CSR));  // pmaaddr0 (PMA off)
  CHECK_FALSE(c.supports_csr(HYBRID_PMA_CFG0_CSR));   // pmacfg0
}

TEST_CASE("the PMNDS counter block needs the Andes scheme, not just a perf "
          "monitor: Sscofpmf cores drop it")
{
  // RTL ground truth (kv_csr_dec.v existent_csr): the PMNDS counter CSRs
  // exist iff PERFORMANCE_MONITOR_INT==1 & SSCOFPMF_SUPPORT==0 (+ privilege
  // terms) -- the standard Sscofpmf scheme REPLACES them. This is what the
  // SPA's `mmsc_cfg.PMNDS` condition compiles down to. ax46mpv_advanced
  // (perf monitor on, sscofpmf on) faulted the drain sweep on a csrr of
  // mcounterinten 0x7CF when it was gated on PERF_MONITOR alone.
  CHECK(premium().supports_csr(0x7CF));         // PMNDS scheme -> exists
  CHECK_FALSE(advanced().supports_csr(0x7CF));  // Sscofpmf -> replaced
  // The standard counters stay PERF_MONITOR-gated on both schemes.
  CHECK(advanced().supports_csr(0x320));        // mcountinhibit
  CHECK(advanced().supports_csr(0xB03));        // mhpmcounter3
}

TEST_CASE("mcountermask_m (0x7D1) needs PMNDS AND U-mode")
{
  // SPA IM Requirement: (mmsc_cfg.PMNDS==1) & (misa[20]==1) -- the same rule
  // as its twins mcountermask_u (0x7D3) and mcounterwen (0x7CE). RTL:
  // PERF & !SSCOFPMF & multi_level_mode. An M-only core (premium) or an
  // Sscofpmf core (advanced) does not implement them; a PB csrr raises
  // cmderr=3, which aborts a whole CSR sweep.
  CHECK_FALSE(premium().supports_csr(0x7D1));   // PMNDS but M-only
  CHECK_FALSE(advanced().supports_csr(0x7D1));  // U-mode-less AND no PMNDS

  AndesCaps pmnds_u = premium();
  pmnds_u.set(AndesGate::UMODE);
  CHECK_FALSE(pmnds_u.supports_csr(0x7D1));     // UMODE alone is not enough
  pmnds_u.set(AndesGate::PMNDS_UMODE);
  CHECK(pmnds_u.supports_csr(0x7D1));
  CHECK(pmnds_u.supports_csr(0x7CE));           // mcounterwen: same rule
  CHECK(pmnds_u.supports_csr(0x7D3));           // mcountermask_u: same rule
  // mcountermask_s additionally needs S-mode.
  CHECK_FALSE(pmnds_u.supports_csr(0x7D2));
}

TEST_CASE("jvt (0x017) needs Zcmt, not CoDense")
{
  // jvt is the standard Zcmt table-jump base. Classic Andes CoDense is
  // exec.it + uitb (0x800); a CoDense core without Zcmt does not implement
  // jvt, and its csrr faulted the drain sweep on ax45mpv_premium. No
  // current engine config carries a Zcmt knob, so the gate reads as off.
  AndesCaps codense_only = AndesCaps::none();
  codense_only.set(AndesGate::CODENSE);
  CHECK(codense_only.supports_csr(0x800));       // uitb rides CoDense
  CHECK_FALSE(codense_only.supports_csr(0x017)); // jvt does not

  AndesCaps with_zcmt = codense_only;
  with_zcmt.set(AndesGate::ZCMT);
  CHECK(with_zcmt.supports_csr(0x017));
}

TEST_CASE("premium keeps the CSRs its config has")
{
  const AndesCaps c = premium();
  CHECK(c.supports_csr(0x800));  // uitb     (CoDense on)
  CHECK_FALSE(c.supports_csr(0x017));  // jvt: Zcmt, which premium lacks
  CHECK(c.supports_csr(0x7C0));  // milmb    (ILM on)
  CHECK(c.supports_csr(0x7C1));  // mdlmb    (DLM on)
  CHECK(c.supports_csr(0x7C4));  // mxstatus (base machine CSR -> ALWAYS)
  CHECK(c.supports_csr(0x7DF));  // mclk_ctl (base machine CSR -> ALWAYS)
}

TEST_CASE("--describe name list reflects the caps")
{
  const std::vector<std::string> n = hybrid::supported_andes_csr_names(premium());
  auto has = [&](const char* s) {
    return std::find(n.begin(), n.end(), s) != n.end();
  };
  CHECK(has("uitb"));
  CHECK(has("milmb"));
  CHECK_FALSE(has("ucode"));
  CHECK_FALSE(has("mecc_code"));

  // PMA group markers ("pmacfg"/"pmaaddr") are emitted only when PMA is on, so
  // the driver can verify-exclude the whole PMA block on a core that lacks it.
  CHECK_FALSE(has("pmacfg"));   // premium: PMA off
  CHECK_FALSE(has("pmaaddr"));
  const std::vector<std::string> all = hybrid::supported_andes_csr_names(AndesCaps::all());
  auto all_has = [&](const char* s) {
    return std::find(all.begin(), all.end(), s) != all.end();
  };
  CHECK(all_has("pmacfg"));
  CHECK(all_has("pmaaddr"));
}
