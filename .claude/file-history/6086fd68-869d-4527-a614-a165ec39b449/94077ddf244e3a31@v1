TEST_CASE("HandoffController: PC-mode synthetic EXIT hit drains like marker EXIT")
{
  // PC-trigger mode populates the trigger map via add_pc_hit() instead of
  // scan_buffer(). HandoffController must dispatch on `kind` only and not
  // depend on a recorded `insn`. This is the single-test contract the PC
  // mode relies on.
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_gpr(12)] = 7;
  bus.regfile[hybrid::regno_csr(RD::kCsrDpc)] = 0x80000048;

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus);
  const auto state = h.on_retire(0x80000044);

  REQUIRE(state);
  CHECK(state->magic == HYBRID_STATE_MAGIC);
  CHECK(state->gpr[12] == 7);
  CHECK(state->pc == 0x80000048);
}

TEST_CASE("HandoffController: PC-mode hit at unrelated PC stays silent")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus);
  const auto state = h.on_retire(0x80000048);
  CHECK_FALSE(state.has_value());
  CHECK(bus.ops.empty());
}

// ---- cosim checkpoints (cosim_roi F2) ----

TEST_CASE("HandoffController cosim: sink fires every N retires with a "
          "resumable drain, k counts from 1")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_gpr(12)] = 42;
  bus.regfile[hybrid::regno_csr(RD::kCsrDpc)] = 0x80000010;

  hybrid::CsrTrigger trigger;  // no EXIT anywhere
  hybrid::HandoffController h(std::move(trigger), bus);

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64;
  input.priv    = 3;
  h.set_passthrough_input(input);

  std::vector<uint64_t> ks;
  std::vector<uint64_t> pcs;
  std::vector<uint64_t> x12s;
  h.enable_cosim(3, [&](const hybrid_state_v1& st, uint64_t k) {
    ks.push_back(k);
    pcs.push_back(st.pc);
    x12s.push_back(st.gpr[12]);
  });

  for (int i = 0; i < 7; ++i) {
    const auto state = h.on_retire(0x1000 + 4u * static_cast<unsigned>(i));
    CHECK_FALSE(state.has_value());
  }

  // Checkpoints at retires 3 and 6 (7th retire is below the next target).
  REQUIRE(ks.size() == 2);
  CHECK(ks[0] == 1u);
  CHECK(ks[1] == 2u);
  CHECK(pcs[0] == 0x80000010u);
  CHECK(x12s[0] == 42u);

  // Each checkpoint resumed the hart afterwards.
  std::size_t resumes = 0;
  for (const auto& op : bus.ops) {
    const bool resume_write = op.kind == hybrid::test::DmiOp::Kind::Write
      && op.reg == RD::kDmcontrol
      && (op.value & RD::kDmcontrolResumereq) != 0u;
    if (resume_write) ++resumes;
  }
  CHECK(resumes == 2u);
}

TEST_CASE("HandoffController cosim: EXIT wins on the same retire -- final "
          "drain returned, sink not invoked")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_csr(RD::kCsrDpc)] = 0x80000048;

  hybrid::CsrTrigger trigger;
  trigger.add_pc_hit(0x80000044, HYBRID_HANDOFF_EXIT);

  hybrid::HandoffController h(std::move(trigger), bus);

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64;
  input.priv    = 3;
  h.set_passthrough_input(input);

  std::size_t sink_calls = 0;
  h.enable_cosim(1, [&](const hybrid_state_v1&, uint64_t) { ++sink_calls; });

  const auto state = h.on_retire(0x80000044);
  REQUIRE(state.has_value());
  CHECK(sink_calls == 0u);
}

TEST_CASE("HandoffController cosim: checkpoint without the passthrough "
          "snapshot throws")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid::CsrTrigger trigger;
  hybrid::HandoffController h(std::move(trigger), bus);
  h.enable_cosim(1, [](const hybrid_state_v1&, uint64_t) {});

  CHECK_THROWS_AS((void) h.on_retire(0x1000), std::runtime_error);
}

TEST_CASE("HandoffController cosim: disabled by default -- plain retires stay "
          "silent even with passthrough set")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid::CsrTrigger trigger;
  hybrid::HandoffController h(std::move(trigger), bus);

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64;
  input.priv    = 3;
  h.set_passthrough_input(input);

  for (int i = 0; i < 100; ++i)
    CHECK_FALSE(h.on_retire(0x1000 + 4u * static_cast<unsigned>(i)).has_value());
  CHECK(bus.ops.empty());
}
