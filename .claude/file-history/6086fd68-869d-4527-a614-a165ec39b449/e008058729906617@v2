// StepDriver (cosim_redesign F2): hardware single-step via dcsr.step.
// With step set, each resume executes exactly one instruction -- or takes
// exactly one trap (debug re-entry lands at the handler) -- then re-enters
// debug mode. Zero halt slack, unlike haltreq checkpoints. stopcount is set
// best-effort so mcycle/minstret freeze while in debug mode.

#pragma once

#include "hybrid/abstract_command.hpp"
#include "hybrid/dmi_poll.hpp"
#include "hybrid/program_buffer.hpp"
#include "hybrid/resume_driver.hpp"

#include <cstdint>
#include <stdexcept>

namespace hybrid
{

class StepDriver
{
public:
  using RD = ResumeDriver;

  static constexpr uint64_t kDcsrStep      = 1ULL << 2;
  static constexpr uint64_t kDcsrStopcount = 1ULL << 10;

  explicit StepDriver(DmiBus& bus)
      : bus_{bus}
  {}

  // Hart must be halted. RMW dcsr to set step (+ stopcount, best effort)
  // and verify the WARL write took: an RTL that pins step to 0 cannot
  // single-step at all, so abort with a pick-another-engine error (same
  // policy as the L6 dcsr.prv verify). A pinned stopcount is tolerated --
  // counters then tick during debug mode and the comparison relies on
  // attempt-index alignment, not counter values.
  void enable()
  {
    const uint64_t dcsr =
      read_register_64(bus_, regno_csr(RD::kCsrDcsr), "StepDriver dcsr");
    write_register_abstract(bus_, regno_csr(RD::kCsrDcsr),
                            dcsr | kDcsrStep | kDcsrStopcount);
    const uint64_t got =
      read_register_64(bus_, regno_csr(RD::kCsrDcsr), "StepDriver verify");
    if ((got & kDcsrStep) == 0u)
      throw std::runtime_error(
        "StepDriver::enable: engine WARL-pins dcsr.step to 0 -- hardware "
        "single-step unsupported; pick an engine that implements it");
    stopcount_active_ = (got & kDcsrStopcount) != 0u;
  }

  // One instruction (or one trap) forward.
  //
  // dmstatus alone is NOT a reliable completion signal here: right after
  // the resumereq write, allresumeack and allhalted still hold their
  // stale pre-resume values for a few cycles (observed on ax45mpv RTL),
  // so a naive ack+halted poll returns while the hart is still mid-step
  // and the caller reads a mid-flight hart. The step is complete only on
  // ARCHITECTURAL evidence: minstret advanced by exactly one (a retire),
  // or DPC moved with minstret unchanged (a trapped step -- debug
  // re-entry at the handler, no retire). stopcount keeps minstret frozen
  // inside debug mode, so the +1 window is exact.
  void step_one()
  {
    const uint64_t minstret0 = read_register_64(
      bus_, regno_csr(RD::kCsrMinstret), "StepDriver minstret0");
    const uint64_t dpc0 =
      read_register_64(bus_, regno_csr(RD::kCsrDpc), "StepDriver dpc0");

    bus_.write(RD::kDmcontrol,
               RD::kDmcontrolDmactive | RD::kDmcontrolResumereq);

    for (unsigned i = 0; i < kDmiPollIterations; ++i) {
      if ((bus_.read(RD::kDmstatus) & RD::kDmstatusAllhalted) == 0)
        continue;  // hart left debug mode and is mid-step
      // Checked reads: a cmderr (command landed while the hart was
      // running) must read as "no evidence yet", not as a value.
      const auto mi = read_register_64_checked(
        bus_, regno_csr(RD::kCsrMinstret), "StepDriver minstret");
      if (!mi) continue;
      if (*mi == minstret0 + 1) return;  // one retire
      const auto pc = read_register_64_checked(
        bus_, regno_csr(RD::kCsrDpc), "StepDriver dpc");
      if (!pc) continue;
      if (*mi == minstret0 && *pc != dpc0) return;  // trapped step
      // Otherwise: a stale pre-resume halt; keep polling.
    }
    throw std::runtime_error("StepDriver::step_one: no step completion "
                             "evidence within the poll budget");
  }

  // Clear step + stopcount so a later plain resume runs freely.
  void disable()
  {
    const uint64_t dcsr =
      read_register_64(bus_, regno_csr(RD::kCsrDcsr), "StepDriver dcsr");
    write_register_abstract(bus_, regno_csr(RD::kCsrDcsr),
                            dcsr & ~(kDcsrStep | kDcsrStopcount));
  }

  // True when the enable() readback held stopcount: mcycle/minstret are
  // frozen during debug mode, so per-record counter values stay clean.
  auto stopcount_active() const -> bool { return stopcount_active_; }

private:
  DmiBus& bus_;
  bool stopcount_active_ = false;
};

}  // namespace hybrid
