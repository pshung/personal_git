// rt_trap_ecall.S
//
// Lock-step DV gate fixture (cosim_redesign F6). A self-contained,
// self-initializing testbench: it writes EVERY GPR to a known value before
// the ROI, so the QEMU-vs-RTL reset-state difference (QEMU seeds a0/a1/.. with
// boot args; the RTL resets GPRs to 0) has vanished by the arm point. Lock-step
// arms at `roi_start` (`--pc-start roi_start`), so the init prologue executes
// on both engines but is not recorded; record 0 is the ROI's first attempt
// with identical architectural state on both sides.
//
// The ROI exercises the trap path the PM decision (traps in scope) requires:
// two M-mode ecalls, each trapping to a handler that bumps mepc by 4 and
// mret's back. At each handler-entry attempt mcause==11 (ecall-from-M) and
// mepc are compared across the engines (lock-step diff compares the trap
// cause), so a mishandled trap on the DUT would diverge loudly. Exit is via
// the SimControl device (0xe0080000), which both QEMU's andes_ae350 and vsim
// model -- no semihosting, so the same ELF lock-steps on both legs.

.section .text
.globl _start
_start:
    // Trap vector -> trap_handler (Direct mode: low 2 bits 0).
    la      t0, trap_handler
    csrw    mtvec, t0

    // Initialize every GPR x1..x31 to a known value. After this, the two
    // engines agree on all architectural registers regardless of reset
    // conventions, so the ROI comparison starts from a common state.
    li      x1,  0x101
    li      x2,  0x202
    li      x3,  0x303
    li      x4,  0x404
    li      x5,  0x505
    li      x6,  0x606
    li      x7,  0x707
    li      x8,  0x808
    li      x9,  0x909
    li      x10, 0x0a0a
    li      x11, 0x0b0b
    li      x12, 0x0c0c
    li      x13, 0x0d0d
    li      x14, 0x0e0e
    li      x15, 0x0f0f
    li      x16, 0x1010
    li      x17, 0x1111
    li      x18, 0x1212
    li      x19, 0x1313
    li      x20, 0x1414
    li      x21, 0x1515
    li      x22, 0x1616
    li      x23, 0x1717
    li      x24, 0x1818
    li      x25, 0x1919
    li      x26, 0x1a1a
    li      x27, 0x1b1b
    li      x28, 0x1c1c
    li      x29, 0x1d1d
    li      x30, 0x1e1e
    li      x31, 0x1f1f

.globl roi_start
roi_start:
    // Straight-line work + two trapping ecalls. Each ecall: mcause=11,
    // mepc=<ecall pc>; the handler advances mepc by 4 and returns.
    addi    a0, a0, 1
    ecall
    addi    a1, a1, 2
    ecall
    add     a2, a0, a1

    // Exit 0 via SimControl (works on both engines).
    li      t3, 0xe0080000
    sw      x0, 0(t3)
hang:
    j       hang

// Synchronous trap handler: skip the trapping instruction (all traps here are
// 4-byte ecalls) and return. Reads mcause/mepc into GPRs so the values also
// surface in the compared register file.
.align 2
trap_handler:
    csrr    t1, mcause
    csrr    t2, mepc
    addi    t2, t2, 4
    csrw    mepc, t2
    mret
