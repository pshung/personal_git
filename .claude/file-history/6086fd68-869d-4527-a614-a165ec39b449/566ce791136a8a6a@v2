// See cosim_lockstep.hpp.
#include "cosim_lockstep.hpp"

#include <algorithm>

namespace andes_sim {

LockstepResult compare_lockstep_streams(
    const std::vector<hybrid_state_v1>& oracle,
    const std::vector<hybrid_state_v1>& dut) {
  LockstepResult r;
  const std::size_t common = std::min(oracle.size(), dut.size());

  for (std::size_t k = 0; k < common; ++k) {
    const DiffReport d =
        diff_states(oracle[k], dut[k], /*compare_trap_cause=*/true);
    if (!d.ok()) {
      r.diverged = true;
      r.record = k;
      r.matched = k;
      r.oracle_pc = oracle[k].pc;
      r.dut_pc = dut[k].pc;
      r.diff = d;
      return r;
    }
  }

  // Prefix matched. A length difference means one engine took more attempts
  // than the other -- a control-flow divergence localized to the first record
  // the shorter stream is missing.
  if (oracle.size() != dut.size()) {
    r.diverged = true;
    r.record = common;
    r.matched = common;
    r.length_mismatch =
        "stream length mismatch: oracle has " + std::to_string(oracle.size()) +
        " record(s), DUT has " + std::to_string(dut.size()) +
        " (matched " + std::to_string(common) + ")";
    if (common < oracle.size()) r.oracle_pc = oracle[common].pc;
    if (common < dut.size()) r.dut_pc = dut[common].pc;
    return r;
  }

  r.matched = common;
  return r;
}

std::vector<uint64_t> subdivide_window(uint64_t lo, uint64_t hi, int fanout,
                                       uint64_t spacing) {
  std::vector<uint64_t> targets;
  if (hi <= lo || spacing == 0) return targets;
  const uint64_t w = hi - lo;
  if (w <= spacing) return targets;  // at the floor; cannot narrow
  const uint64_t n =
      std::min<uint64_t>(static_cast<uint64_t>(fanout), w / spacing);
  if (n < 2) return targets;
  for (uint64_t j = 1; j <= n; ++j) {
    const uint64_t t = lo + (w * j) / n;  // j==n -> hi
    if (targets.empty() || t > targets.back()) targets.push_back(t);
  }
  return targets;
}

}  // namespace andes_sim
