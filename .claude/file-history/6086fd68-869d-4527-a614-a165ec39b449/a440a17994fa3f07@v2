// LockstepSession (cosim_redesign F4): DMI-driven lock-step record loop.
// Halt at reset, single-step to the arm pc, then step+drain_full one record
// per execution attempt into the sink. No retire-hook involvement, so no
// halt slack: every record boundary is exact.

#include "hybrid/abstract_command.hpp"
#include "hybrid/lockstep_controller.hpp"
#include "hybrid/resume_driver.hpp"
#include "hybrid/state_abi.h"
#include "hybrid/step_driver.hpp"
#include "recording_bus.hpp"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include <cstdint>
#include <stdexcept>
#include <vector>

using hybrid::test::DmiOp;
using hybrid::test::kDmstatusHaltedAndAcked;
using hybrid::test::RecordingBus;
using RD = hybrid::ResumeDriver;
using SD = hybrid::StepDriver;

namespace
{

constexpr uint64_t kArmPc    = 0x80000000ULL;
constexpr uint64_t kMisaRv64 = 2ULL << 62;

// A bus where the boot halt lands exactly at the arm pc (DPC == arm) and
// dcsr.step verifies. SteppingBus: each resumereq advances DPC by 4 and
// bumps minstret (the step-completion evidence step_one polls for).
auto armed_bus() -> hybrid::test::SteppingBus
{
  hybrid::test::SteppingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_csr(RD::kCsrDpc)]  = kArmPc;
  bus.regfile[hybrid::regno_csr(RD::kCsrMinstret)] = 100;
  bus.regfile[hybrid::regno_csr(RD::kCsrDcsr)] = 0x400000C3ULL | SD::kDcsrStep;
  bus.regfile[hybrid::regno_csr(0x301)]        = kMisaRv64;  // misa: no F/V
  return bus;
}

auto count_resumes(const std::vector<DmiOp>& ops) -> std::size_t
{
  std::size_t n = 0;
  for (const auto& op : ops)
    if (op.kind == DmiOp::Kind::Write && op.reg == RD::kDmcontrol
        && (op.value & RD::kDmcontrolResumereq) != 0u)
      ++n;
  return n;
}

}  // namespace

TEST_CASE("lockstep: halts at reset, records at the arm pc, one step "
          "between consecutive records")
{
  auto bus = armed_bus();
  bus.regfile[hybrid::regno_gpr(12)] = 42;

  std::vector<uint64_t> ks;
  hybrid::LockstepSession session(
    bus, {.arm_pc = kArmPc, .max_records = 3},
    [&](const hybrid_state_v1& st, uint64_t k) {
      ks.push_back(k);
      CHECK(st.gpr[12] == 42u);
      CHECK(st.pc == kArmPc + 4 * k);  // SteppingBus advances DPC per step
    },
    [] { return false; });

  const uint64_t records = session.run();

  CHECK(records == 3u);
  REQUIRE(ks.size() == 3);
  CHECK(ks[0] == 0u);
  CHECK(ks[2] == 2u);

  // Record 0 needs no step (DPC already == arm); records 1 and 2 take one
  // step each.
  CHECK(count_resumes(bus.ops) == 2u);

  // The first two DMCONTROL writes are the dmactive prime + haltreq.
  REQUIRE(bus.ops.size() >= 2);
  CHECK(bus.ops[0].reg == RD::kDmcontrol);
  CHECK((bus.ops[0].value & RD::kDmcontrolHaltreq) == 0u);
  CHECK(bus.ops[1].reg == RD::kDmcontrol);
  CHECK((bus.ops[1].value & RD::kDmcontrolHaltreq) != 0u);
}

TEST_CASE("lockstep: pre-arm step budget exhausts loudly when the arm pc is "
          "never reached")
{
  auto bus = armed_bus();
  bus.regfile[hybrid::regno_csr(RD::kCsrDpc)] = kArmPc + 4;  // never arms

  hybrid::LockstepSession session(
    bus, {.arm_pc = kArmPc, .max_records = 1, .pre_arm_step_budget = 5},
    [](const hybrid_state_v1&, uint64_t) {},
    [] { return false; });

  CHECK_THROWS_AS(session.run(), std::runtime_error);
  // The budget bounded the pre-arm stepping.
  CHECK(count_resumes(bus.ops) == 5u);
}

TEST_CASE("lockstep: stop check ends the session early")
{
  auto bus = armed_bus();

  std::size_t sunk = 0;
  hybrid::LockstepSession session(
    bus, {.arm_pc = kArmPc, .max_records = 10},
    [&](const hybrid_state_v1&, uint64_t) { ++sunk; },
    [&] { return sunk >= 2; });

  const uint64_t records = session.run();
  CHECK(records == 2u);
  CHECK(sunk == 2u);
}

TEST_CASE("lockstep: max_records=0 means unbounded -- the stop check is the "
          "only terminator")
{
  auto bus = armed_bus();

  std::size_t sunk = 0;
  hybrid::LockstepSession session(
    bus, {.arm_pc = kArmPc, .max_records = 0},
    [&](const hybrid_state_v1&, uint64_t) { ++sunk; },
    [&] { return sunk >= 7; });

  CHECK(session.run() == 7u);
}

TEST_CASE("lockstep: records carry drain_full state (flags probed from misa)")
{
  auto bus = armed_bus();
  bus.regfile[hybrid::regno_csr(0x301)] =
    kMisaRv64 | (1ULL << 3) | (1ULL << 5);  // +F +D
  bus.regfile[hybrid::regno_csr(RD::kCsrMstatus)] = 0x6600ULL;
  bus.regfile[hybrid::regno_fpr(7)] = 0xf007ULL;
  bus.regfile[hybrid::regno_csr(0x342)] = 0x2ULL;  // mcause

  hybrid_state_v1 got{};
  hybrid::LockstepSession session(
    bus, {.arm_pc = kArmPc, .max_records = 1},
    [&](const hybrid_state_v1& st, uint64_t) { got = st; },
    [] { return false; });
  (void) session.run();

  CHECK((got.flags & HYBRID_FLAG_FP) != 0u);
  CHECK(got.fpr[7] == 0xf007ULL);
  CHECK(got.mcause == 0x2ULL);
}
