  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_V;
  input.priv    = 3;
  input.vlenb   = 64;

  hybrid::StateDrain drain(bus);
  (void) drain.drain_checkpoint(input);

  // (a) the undo vsetvl runs AFTER the dump sweep's last vse8.v (v31).
  const auto last_vse =
    last_progbuf_insn(bus.ops, hybrid::encode_vse8_v(31, 7));
  const auto undo_vsetvl =
    last_progbuf_insn(bus.ops, hybrid::encode_vsetvl(0, 5, 6));
  REQUIRE(last_vse.has_value());
  REQUIRE(undo_vsetvl.has_value());
  CHECK(*last_vse < *undo_vsetvl);

  // (b) the undo vsetvl is staged with the DRAINED vl/vtype (not the sweep's
  //     e8/m1 constants): the last x5/x6 writes before it carry 16 / 0xC1.
  const auto x5_writes = abstract_writes_to(bus.ops, hybrid::regno_gpr(5));
  const auto x6_writes = abstract_writes_to(bus.ops, hybrid::regno_gpr(6));
  std::optional<uint64_t> staged_vl;
  std::optional<uint64_t> staged_vtype;
  for (const auto& [i, v] : x5_writes)
    if (i < *undo_vsetvl) staged_vl = v;
  for (const auto& [i, v] : x6_writes)
    if (i < *undo_vsetvl) staged_vtype = v;
  REQUIRE(staged_vl.has_value());
  REQUIRE(staged_vtype.has_value());
  CHECK(*staged_vl == 16u);
  CHECK(*staged_vtype == 0xC1ULL);

  // (c) vstart is restored via PB csrrw after the vsetvl (which zeroes it).
  const auto vstart_csrrw =
    last_progbuf_insn(bus.ops, hybrid::encode_csrrw(0, RD::kCsrVstart, 7));
  REQUIRE(vstart_csrrw.has_value());
  CHECK(*undo_vsetvl < *vstart_csrrw);
  const auto x7_writes = abstract_writes_to(bus.ops, hybrid::regno_gpr(7));
  std::optional<uint64_t> staged_vstart;
  for (const auto& [i, v] : x7_writes)
    if (i > *undo_vsetvl && i < *vstart_csrrw) staged_vstart = v;
  REQUIRE(staged_vstart.has_value());
  CHECK(*staged_vstart == 7u);

  // (d) the scratch GPRs are restored LAST with the drained values.
  REQUIRE(!x5_writes.empty());
  REQUIRE(!x6_writes.empty());
  REQUIRE(!x7_writes.empty());
  CHECK(x5_writes.back().second == 0x55u);
  CHECK(x6_writes.back().second == 0x66u);
  CHECK(x7_writes.back().second == 0x77u);
  CHECK(x5_writes.back().first > *vstart_csrrw);

  // (e) resume comes after everything above.
  const auto resume = last_dmcontrol_write(bus.ops);
  REQUIRE(resume.has_value());
  CHECK((bus.ops[*resume].value & RD::kDmcontrolResumereq) != 0u);
  CHECK(*resume > x7_writes.back().first);
}

TEST_CASE("drain_checkpoint without HYBRID_FLAG_V issues no Program Buffer ops "
          "and still resumes")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_FP;
  input.priv    = 3;

  hybrid::StateDrain drain(bus);
  (void) drain.drain_checkpoint(input);

  for (const auto& op : bus.ops) {
    const bool progbuf_write =
      op.kind == DmiOp::Kind::Write && op.reg == hybrid::kProgbuf0;
    CHECK_FALSE(progbuf_write);
  }

  const auto resume = last_dmcontrol_write(bus.ops);
  REQUIRE(resume.has_value());
  CHECK((bus.ops[*resume].value & RD::kDmcontrolResumereq) != 0u);
}

TEST_CASE("L6: drain reads the hart privilege from dcsr.prv")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  // dcsr: xdebugver=4, cause=3 (haltreq), prv=1 (S-mode at halt).
  bus.regfile[hybrid::regno_csr(RD::kCsrDcsr)] = 0x400000C1ULL;

  hybrid::StateDrain drain(bus);
  const auto state = drain.drain();

  CHECK(state.priv == 1u);
}

TEST_CASE("L6: drain_with_passthrough reports the freshly drained privilege, "
          "not the QEMU1 snapshot's")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_csr(RD::kCsrDcsr)] = 0x40000000ULL;  // prv=0 (U)

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64;
  input.priv    = 3;  // stale: QEMU1 drained M before the ROI dropped to U

  hybrid::StateDrain drain(bus);
  const auto state = drain.drain_with_passthrough(input);

  CHECK(state.priv == 0u);
}
