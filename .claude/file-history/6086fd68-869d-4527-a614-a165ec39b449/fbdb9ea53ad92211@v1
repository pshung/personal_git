TEST_CASE("drain_with_passthrough with HYBRID_FLAG_V: PB dumps v0..v31 to scratch "
          "after the architectural counter/CSR reads")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_V;
  input.priv    = 3;
  input.vlenb   = 64;

  hybrid::StateDrain drain(bus);
  (void) drain.drain_with_passthrough(input);

  // (a) every v0..v31 is dumped via a vse8.v executed in the Program Buffer.
  std::vector<int> missing;
  std::optional<std::size_t> first_vse_idx;
  for (uint16_t v = 0; v < 32; ++v) {
    const uint32_t want = hybrid::encode_vse8_v(static_cast<uint8_t>(v), 7);
    std::optional<std::size_t> at;
    for (std::size_t i = 0; i < bus.ops.size(); ++i) {
      const auto& op = bus.ops[i];
      if (op.kind == DmiOp::Kind::Write && op.reg == hybrid::kProgbuf0
          && op.value == want) { at = i; break; }
    }
    if (!at) { missing.push_back(v); continue; }
    if (!first_vse_idx || *at < *first_vse_idx) first_vse_idx = at;
  }
  CHECK(missing.empty());
  REQUIRE(first_vse_idx.has_value());

  // (b) the dump sweep runs AFTER the mcycle/minstret reads, so the sweep's
  //     vse8.v insns (and any counter increments) cannot corrupt the drained
  //     counters. minstret(0xB02) is the last counter read before the sweep.
  std::optional<std::size_t> minstret_read_idx;
  for (std::size_t i = 0; i < bus.ops.size(); ++i) {
    const auto& op = bus.ops[i];
    if (op.kind != DmiOp::Kind::Write || op.reg != RD::kCommand) continue;
    const auto regno   = static_cast<uint16_t>(op.value & 0xFFFFu);
    const bool is_read = ((op.value >> 16) & 1u) == 0u;
    if (is_read && regno == hybrid::regno_csr(0xB02)) minstret_read_idx = i;
  }
  REQUIRE(minstret_read_idx.has_value());
  CHECK(*minstret_read_idx < *first_vse_idx);
}

// ---- drain_checkpoint (cosim_roi F1): drain, undo clobbers, resume ----

namespace
{

// Index of the last DMCONTROL write in the op log.
auto last_dmcontrol_write(const std::vector<DmiOp>& ops)
  -> std::optional<std::size_t>
{
  std::optional<std::size_t> at;
  for (std::size_t i = 0; i < ops.size(); ++i)
    if (ops[i].kind == DmiOp::Kind::Write && ops[i].reg == RD::kDmcontrol)
      at = i;
  return at;
}

// Index of the last Program Buffer slot-0 write carrying `insn`.
auto last_progbuf_insn(const std::vector<DmiOp>& ops, uint32_t insn)
  -> std::optional<std::size_t>
{
  std::optional<std::size_t> at;
  for (std::size_t i = 0; i < ops.size(); ++i)
    if (ops[i].kind == DmiOp::Kind::Write && ops[i].reg == hybrid::kProgbuf0
        && ops[i].value == insn)
      at = i;
  return at;
}

// All abstract-command WRITES to `regno`: (op index of COMMAND, 64-bit value
// assembled from the DATA0/DATA1 writes immediately preceding it).
auto abstract_writes_to(const std::vector<DmiOp>& ops, uint16_t regno)
  -> std::vector<std::pair<std::size_t, uint64_t>>
{
  std::vector<std::pair<std::size_t, uint64_t>> hits;
  uint32_t data0 = 0;
  uint32_t data1 = 0;
  for (std::size_t i = 0; i < ops.size(); ++i) {
    const auto& op = ops[i];
    if (op.kind != DmiOp::Kind::Write) continue;
    if (op.reg == RD::kData0) { data0 = op.value; continue; }
    if (op.reg == RD::kData1) { data1 = op.value; continue; }
    if (op.reg != RD::kCommand) continue;
    const auto target  = static_cast<uint16_t>(op.value & 0xFFFFu);
    const bool is_write = ((op.value >> 16) & 1u) != 0u;
    if (is_write && target == regno)
      hits.emplace_back(i, (static_cast<uint64_t>(data1) << 32) | data0);
  }
  return hits;
}

}  // namespace

TEST_CASE("drain_checkpoint resumes the hart: resumereq is the final DMCONTROL "
          "write, followed by the resumeack poll")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64;
  input.priv    = 3;

  hybrid::StateDrain drain(bus);
  (void) drain.drain_checkpoint(input);

  const auto at = last_dmcontrol_write(bus.ops);
  REQUIRE(at.has_value());
  CHECK((bus.ops[*at].value & RD::kDmcontrolResumereq) != 0u);
  CHECK((bus.ops[*at].value & RD::kDmcontrolHaltreq) == 0u);

  // The resumeack poll reads dmstatus after the resume request.
  bool polled = false;
  for (std::size_t i = *at + 1; i < bus.ops.size(); ++i)
    if (bus.ops[i].kind == DmiOp::Kind::Read && bus.ops[i].reg == RD::kDmstatus)
      polled = true;
  CHECK(polled);
}

TEST_CASE("drain_checkpoint returns the same architectural state as "
          "drain_with_passthrough")
{
  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_FP | HYBRID_FLAG_V;
  input.priv    = 3;
  input.mstatus = 0x1800ULL;
  input.vlenb   = 64;

  const auto program = [](RecordingBus& bus) {
    bus.dmstatus_value = kDmstatusHaltedAndAcked;
    bus.regfile[hybrid::regno_csr(RD::kCsrDpc)] = 0x80001234ULL;
    for (uint16_t i = 0; i < 32; ++i) {
      bus.regfile[hybrid::regno_gpr(i)] = 0x10000000ULL + i;
      bus.regfile[hybrid::regno_fpr(i)] = 0xf000000000000000ULL + i;
    }
    bus.regfile[hybrid::regno_csr(RD::kCsrVl)]    = 16;
    bus.regfile[hybrid::regno_csr(RD::kCsrVtype)] = 0xC1ULL;
  };

  RecordingBus bus_a;
  RecordingBus bus_b;
  program(bus_a);
  program(bus_b);

  hybrid::StateDrain plain(bus_a);
  hybrid::StateDrain ckpt(bus_b);
  const auto want = plain.drain_with_passthrough(input);
  const auto got  = ckpt.drain_checkpoint(input);

  CHECK(std::memcmp(&want, &got, sizeof(want)) == 0);
}

