// Lock-step DV co-sim core (cosim_redesign F6, usage 1).
//
// Two record streams -- the QEMU oracle (golden) and the vsim DUT -- aligned
// by ATTEMPT INDEX (record k = state before execution attempt k+1 on each
// side). Alignment is by index, never by minstret: on andes_ae350 QEMU's
// minstret/mcycle alias a host free-running timer, so they are excluded from
// the diff (see diff_states) and the records merely carry them for inspection.
//
// The comparison walks the common prefix, diffing each record with trap-cause
// comparison on (mepc + mcause), and reports the FIRST diverging attempt. If
// the prefix matches but the streams differ in length, that is reported as a
// length mismatch at the first missing record (a control-flow divergence: one
// engine retired more attempts than the other).
#ifndef ANDES_SIM_COSIM_LOCKSTEP_HPP
#define ANDES_SIM_COSIM_LOCKSTEP_HPP

#include <cstdint>
#include <string>
#include <vector>

#include "hybrid/state_abi.h"
#include "state_diff.hpp"

namespace andes_sim {

struct LockstepResult {
  bool diverged = false;
  std::size_t record = 0;        // attempt index of the first divergence
  std::size_t matched = 0;       // records that compared equal before it
  uint64_t oracle_pc = 0;
  uint64_t dut_pc = 0;
  DiffReport diff;               // field diffs at `record` (empty on length-only)
  std::string length_mismatch;   // non-empty => streams differ in length
};

// Compare oracle vs dut. See header comment for the policy.
LockstepResult compare_lockstep_streams(
    const std::vector<hybrid_state_v1>& oracle,
    const std::vector<hybrid_state_v1>& dut);

// Refine-window subdivision (cosim_redesign F7). Split the diverging window
// (lo, hi] into up to `fanout` strictly-ascending checkpoint targets, the
// last == hi (the known-diverging endpoint). Probes are kept >= `spacing`
// apart so the vsim halt overshoot cannot reorder the achieved deltas: the
// probe count is min(fanout, (hi-lo)/spacing). Returns empty when the window
// is at/under the spacing floor and cannot be narrowed by haltreq checkpoints
// (the caller then reports the slack bracket).
std::vector<uint64_t> subdivide_window(uint64_t lo, uint64_t hi, int fanout,
                                       uint64_t spacing);

}  // namespace andes_sim

#endif  // ANDES_SIM_COSIM_LOCKSTEP_HPP
