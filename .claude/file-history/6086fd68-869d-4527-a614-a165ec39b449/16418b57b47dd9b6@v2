// Unit tests for the lock-step stream comparison core (cosim_redesign F6).
// compare_lockstep_streams aligns two record streams by ATTEMPT INDEX (never
// by minstret -- QEMU's is a host timer) and returns the first record whose
// architectural state (+ trap cause) diverges, or a length mismatch.
#include "cosim_lockstep.hpp"

#include <vector>

#include "hybrid/state_abi.h"
#include "test_check.hpp"

using namespace andes_sim;

namespace {

hybrid_state_v1 rec(uint64_t pc, uint64_t x10) {
  hybrid_state_v1 s{};
  s.magic = HYBRID_STATE_MAGIC;
  s.version = HYBRID_STATE_VERSION;
  s.flags = HYBRID_FLAG_RV64;
  s.priv = 3;
  s.pc = pc;
  s.gpr[10] = x10;
  return s;
}

}  // namespace

int main() {
  {  // identical streams -> no divergence, all records matched
    std::vector<hybrid_state_v1> a = {rec(0x100, 1), rec(0x104, 2),
                                      rec(0x108, 3)};
    const LockstepResult r = compare_lockstep_streams(a, a);
    CHECK(!r.diverged);
    CHECK(r.matched == 3);
    CHECK(r.length_mismatch.empty());
  }

  {  // a GPR divergence at record 1 is localized to attempt index 1
    std::vector<hybrid_state_v1> oracle = {rec(0x100, 1), rec(0x104, 2),
                                           rec(0x108, 3)};
    std::vector<hybrid_state_v1> dut = oracle;
    dut[1].gpr[10] = 0xbad;
    const LockstepResult r = compare_lockstep_streams(oracle, dut);
    CHECK(r.diverged);
    CHECK(r.record == 1);
    CHECK(r.oracle_pc == 0x104);
    CHECK(r.dut_pc == 0x104);
    CHECK(!r.diff.ok());
    bool saw = false;
    for (const FieldDiff& d : r.diff.diffs) saw |= d.field == "x10";
    CHECK(saw);
  }

  {  // first divergence wins even if later records also differ
    std::vector<hybrid_state_v1> oracle = {rec(0x100, 1), rec(0x104, 2),
                                           rec(0x108, 3)};
    std::vector<hybrid_state_v1> dut = oracle;
    dut[1].pc = 0xdead;
    dut[2].gpr[10] = 9;
    const LockstepResult r = compare_lockstep_streams(oracle, dut);
    CHECK(r.diverged);
    CHECK(r.record == 1);
  }

  {  // pc divergence at the same record is reported with both pcs
    std::vector<hybrid_state_v1> oracle = {rec(0x100, 1), rec(0x104, 2)};
    std::vector<hybrid_state_v1> dut = {rec(0x100, 1), rec(0x999, 2)};
    const LockstepResult r = compare_lockstep_streams(oracle, dut);
    CHECK(r.diverged);
    CHECK(r.record == 1);
    CHECK(r.oracle_pc == 0x104);
    CHECK(r.dut_pc == 0x999);
  }

  {  // mcause divergence is caught (trap-cause comparison is on for lock-step)
    std::vector<hybrid_state_v1> oracle = {rec(0x100, 1), rec(0x104, 2)};
    std::vector<hybrid_state_v1> dut = oracle;
    dut[1].mcause = 2;
    const LockstepResult r = compare_lockstep_streams(oracle, dut);
    CHECK(r.diverged);
    CHECK(r.record == 1);
    bool saw = false;
    for (const FieldDiff& d : r.diff.diffs) saw |= d.field == "mcause";
    CHECK(saw);
  }

  {  // counters never diverge the streams (QEMU minstret is a host timer)
    std::vector<hybrid_state_v1> oracle = {rec(0x100, 1), rec(0x104, 2)};
    std::vector<hybrid_state_v1> dut = oracle;
    dut[0].minstret = 5;
    dut[1].minstret = 7'000'000;
    dut[0].mcycle = 123;
    const LockstepResult r = compare_lockstep_streams(oracle, dut);
    CHECK(!r.diverged);
  }

  {  // DUT shorter than oracle: length mismatch at the first missing record
    std::vector<hybrid_state_v1> oracle = {rec(0x100, 1), rec(0x104, 2),
                                           rec(0x108, 3)};
    std::vector<hybrid_state_v1> dut = {rec(0x100, 1), rec(0x104, 2)};
    const LockstepResult r = compare_lockstep_streams(oracle, dut);
    CHECK(r.diverged);
    CHECK(!r.length_mismatch.empty());
    CHECK(r.record == 2);  // matched 0..1, oracle has a 3rd the DUT lacks
  }

  {  // matched prefix divergence beats the length mismatch
    std::vector<hybrid_state_v1> oracle = {rec(0x100, 1), rec(0x104, 2),
                                           rec(0x108, 3)};
    std::vector<hybrid_state_v1> dut = {rec(0x100, 1), rec(0x104, 9)};
    const LockstepResult r = compare_lockstep_streams(oracle, dut);
    CHECK(r.diverged);
    CHECK(r.length_mismatch.empty());  // a real field diff, not a length issue
    CHECK(r.record == 1);
  }

  {  // empty oracle stream is reported, not a crash
    std::vector<hybrid_state_v1> empty;
    std::vector<hybrid_state_v1> dut = {rec(0x100, 1)};
    const LockstepResult r = compare_lockstep_streams(empty, dut);
    CHECK(r.diverged);
    CHECK(!r.length_mismatch.empty());
  }

  // ---- cosim_redesign F7: refine window subdivision ----

  {  // wide window -> kFanout ascending probes, last == hi
    const std::vector<uint64_t> t = subdivide_window(0, 1600, 16, 8);
    CHECK(t.size() == 16);
    CHECK(t.front() == 100);
    CHECK(t.back() == 1600);
    for (size_t i = 1; i < t.size(); ++i) CHECK(t[i] > t[i - 1]);
  }

  {  // probes stay >= spacing apart: fanout capped by w/spacing
    const std::vector<uint64_t> t = subdivide_window(0, 16, 16, 8);
    CHECK(t.size() == 2);  // 16/8 = 2 probes
    CHECK(t[0] == 8);
    CHECK(t[1] == 16);
  }

  {  // window at/under the spacing floor cannot be narrowed
    CHECK(subdivide_window(0, 8, 16, 8).empty());
    CHECK(subdivide_window(100, 105, 16, 8).empty());
  }

  {  // a non-zero lo shifts the probes; last is still hi
    const std::vector<uint64_t> t = subdivide_window(1000, 1160, 16, 8);
    CHECK(t.size() == 16);
    CHECK(t.front() > 1000);
    CHECK(t.back() == 1160);
    for (size_t i = 1; i < t.size(); ++i) CHECK(t[i] > t[i - 1]);
  }

  return andes_sim::test::report("cosim_lockstep");
}
