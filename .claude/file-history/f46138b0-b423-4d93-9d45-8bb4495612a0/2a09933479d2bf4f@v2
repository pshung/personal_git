#!/usr/bin/env bash
# Diagnose QEMU startup hang. Run several times, time each, capture strace
# on the slow ones.
set -uo pipefail
cd /home/nick/work/hybrid_sim
LOG=/tmp/diag_qemu.log
exec > "$LOG" 2>&1

run_once() {
  local trial=$1
  local SHM=$(mktemp -p /dev/shm vsim-diag.XXXXXX)
  local STATE_Q=$(mktemp)
  local QLOG=$(mktemp)
  truncate -s $((128 * 1024 * 1024)) "$SHM"

  local start=$(date +%s.%N)
  timeout 30 ./build/qemu/qemu-system-riscv64 \
    -object "memory-backend-file,id=mem,share=on,mem-path=$SHM,size=$((128 * 1024 * 1024))" \
    -machine andes_ae350,memory-backend=mem \
    -cpu andes-ax45mpv,vlen=512 \
    -nographic \
    -semihosting-config enable=on,target=native \
    -bios ./tests/fixtures/rt_c_v_matmul_free.elf \
    -plugin ./qemu_plugin/libhybrid_handoff.so,outfile=$STATE_Q,icount=10000 \
    >"$QLOG" 2>&1
  local rc=$?
  local end=$(date +%s.%N)
  local elapsed=$(awk -v s=$start -v e=$end 'BEGIN{printf "%.2f", e-s}')
  echo "trial $trial: rc=$rc elapsed=${elapsed}s qlog_bytes=$(wc -c <"$QLOG")"
  if [ "${elapsed%.*}" -ge 5 ] 2>/dev/null; then
    echo "  >>> SLOW trial - qemu log:"
    cat "$QLOG" | sed 's/^/    /'
  fi
  rm -f "$SHM" "$STATE_Q" "$QLOG"
}

echo "=== ENV (full) ==="
env | sort
echo ""

echo "=== 8 sequential QEMU1-only runs (no vsim) ==="
for i in $(seq 1 8); do run_once $i; done

echo ""
echo "=== 8 sequential QEMU1-only runs with DEBUGINFOD_URLS unset ==="
unset DEBUGINFOD_URLS
for i in $(seq 1 8); do run_once "noDIF-$i"; done

echo ""
echo "=== done ==="
