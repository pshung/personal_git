#!/usr/bin/env bash
# Diagnose the icount demo hang from user's tmux window.
# Runs the demo, and if QEMU hangs >5s, grabs strace/stack info.

set -uo pipefail
cd /home/nick/work/hybrid_sim

LOG=/tmp/diag_hang.log
exec > "$LOG" 2>&1

echo "=== ENV ==="
env | sort
echo ""

echo "=== which/version ==="
which bash
bash --version | head -1
echo ""

echo "=== running demo ==="
./hsim demo icount_roundtrip &
DEMO_PID=$!
echo "demo PID=$DEMO_PID"

# Wait up to 8s, then if still running, find QEMU child and strace it
for i in $(seq 1 8); do
  if ! kill -0 $DEMO_PID 2>/dev/null; then
    echo "demo finished in <${i}s"
    break
  fi
  sleep 1
done

if kill -0 $DEMO_PID 2>/dev/null; then
  echo ""
  echo "=== demo still running after 8s, snapshot QEMU state ==="
  QEMU_PID=$(pgrep -P $(pgrep -P $DEMO_PID) qemu-system-riscv64 2>/dev/null | head -1)
  if [ -z "$QEMU_PID" ]; then
    QEMU_PID=$(pgrep -f "qemu-system-riscv64.*hybrid_handoff" | head -1)
  fi
  echo "QEMU PID=$QEMU_PID"
  if [ -n "$QEMU_PID" ]; then
    echo "--- /proc/$QEMU_PID/status ---"
    cat /proc/$QEMU_PID/status 2>&1 | head -20
    echo "--- /proc/$QEMU_PID/stack ---"
    cat /proc/$QEMU_PID/stack 2>&1 | head -20
    echo "--- /proc/$QEMU_PID/wchan ---"
    cat /proc/$QEMU_PID/wchan 2>&1; echo ""
    echo "--- /proc/$QEMU_PID/stat ---"
    cat /proc/$QEMU_PID/stat 2>&1
    echo "--- threads ---"
    ls /proc/$QEMU_PID/task/ 2>&1
    for tid in /proc/$QEMU_PID/task/*/; do
      tid_n=$(basename "$tid")
      echo "  tid $tid_n wchan: $(cat $tid/wchan 2>&1)"
    done
    echo "--- strace 5s sample ---"
    timeout 5 strace -p $QEMU_PID -f -e trace=all -tt 2>&1 | head -100
    echo "--- open files ---"
    ls -la /proc/$QEMU_PID/fd/ 2>&1 | head -30
  fi
fi

wait $DEMO_PID
echo ""
echo "=== demo exit code: $? ==="
echo "=== LOG done ==="
