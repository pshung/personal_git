#!/usr/bin/env bash
# Run demo, snapshot any QEMU process that's hung after 8s.
set -uo pipefail
cd /home/nick/work/hybrid_sim
LOG=/tmp/trace_hang.log
exec > "$LOG" 2>&1

echo "=== ENV ==="
env | sort
echo ""

echo "=== running demo ==="
./hsim demo icount_roundtrip >/tmp/trace_demo.log 2>&1 &
DEMO_PID=$!

sleep 8

# Find ANY qemu-system-riscv64 still alive
QPID=$(pgrep -f "qemu-system-riscv64.*hybrid_handoff" | head -1)
if [ -z "$QPID" ]; then
  echo "no hung QEMU after 8s, demo may have passed"
  wait $DEMO_PID; echo "demo rc=$?"
  echo "demo log:"; cat /tmp/trace_demo.log
  exit 0
fi

echo "=== QEMU $QPID is alive after 8s ==="
echo "--- status ---"; grep -E '^(State|Threads|VmRSS)' /proc/$QPID/status
echo "--- wchan (main) ---"; cat /proc/$QPID/wchan; echo
echo "--- stack (main) ---"; head -10 /proc/$QPID/stack 2>/dev/null
echo "--- all threads ---"
for t in /proc/$QPID/task/*/wchan; do
  tid=$(basename $(dirname $t))
  comm=$(cat /proc/$QPID/task/$tid/comm 2>/dev/null)
  wch=$(cat $t 2>/dev/null)
  echo "tid=$tid comm=$comm wchan=$wch"
done
echo "--- open fds (sockets/pipes) ---"
ls -la /proc/$QPID/fd/ 2>/dev/null | grep -E 'socket|pipe' | head -20
echo "--- network sockets ---"
ss -tnp 2>/dev/null | grep " $QPID/" || echo "(none)"
echo "--- strace 6s ---"
timeout 6 strace -p $QPID -f -tt -e trace=network,openat,read,futex 2>&1 | head -60
echo "=========================="

wait $DEMO_PID
echo "demo rc=$?"
echo "demo log:"; cat /tmp/trace_demo.log
