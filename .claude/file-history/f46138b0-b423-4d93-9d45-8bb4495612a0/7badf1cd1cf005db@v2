#!/usr/bin/env bash
# Loop the demo until it fails; on failure, strace the next QEMU launch.
set -uo pipefail
cd /home/nick/work/hybrid_sim

LOG=/tmp/catch_hang.log
exec > "$LOG" 2>&1

echo "=== ENV (relevant) ==="
env | grep -E 'DEBUGINFOD|proxy|PATH|HYBRID' | sort
echo ""

for trial in $(seq 1 20); do
  echo "=== trial $trial ==="
  start=$(date +%s)
  # Launch demo in background
  ./hsim demo icount_roundtrip >/tmp/catch_demo_$trial.log 2>&1 &
  DEMO_PID=$!

  # Wait for QEMU child to appear (up to 3s)
  QPID=""
  for i in $(seq 1 30); do
    QPID=$(pgrep -f "qemu-system-riscv64.*hybrid_handoff" 2>/dev/null | head -1)
    [ -n "$QPID" ] && break
    sleep 0.1
  done
  echo "  QEMU PID: $QPID (after ${i}*0.1s)"

  if [ -n "$QPID" ]; then
    # Snapshot state at +1s, +3s, +6s if still alive
    for delay in 1 3 6 15; do
      sleep $delay
      if kill -0 $QPID 2>/dev/null; then
        echo "  --- at +${delay}s QEMU still alive ---"
        echo "  wchan: $(cat /proc/$QPID/wchan 2>/dev/null)"
        echo "  state: $(grep ^State /proc/$QPID/status 2>/dev/null)"
        echo "  stack top:"
        head -5 /proc/$QPID/stack 2>/dev/null | sed 's/^/    /'
        echo "  threads:"
        for t in /proc/$QPID/task/*/wchan; do
          tid=$(basename $(dirname $t))
          echo "    tid=$tid wchan=$(cat $t 2>/dev/null)"
        done
        echo "  open net/sockets:"
        ls -la /proc/$QPID/fd/ 2>/dev/null | grep -E 'socket|pipe|TCP|inet' | head -10 | sed 's/^/    /'
        if [ $delay -eq 1 ]; then
          echo "  --- strace 4s sample ---"
          timeout 4 strace -p $QPID -f -e trace=network,openat,connect,read -tt 2>&1 | head -80 | sed 's/^/    /'
        fi
      else
        echo "  QEMU exited before +${delay}s"
        break
      fi
    done
  fi

  wait $DEMO_PID
  rc=$?
  end=$(date +%s)
  echo "  demo rc=$rc elapsed=$((end - start))s"
  if [ $rc -ne 0 ]; then
    echo "  >>> FAILURE - demo log:"
    sed 's/^/    /' /tmp/catch_demo_$trial.log | head -20
    echo "  --- captured this hang, stopping ---"
    break
  fi
  rm -f /tmp/catch_demo_$trial.log
done

echo ""
echo "=== done ==="
