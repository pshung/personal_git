#!/usr/bin/env bash
# F2c RED->GREEN: the SimPoint headline demo must print a positive
# estimated_cycles - the whole-program weighted-CPI cycle estimate produced
# by `hsim estimate` - so the SimPoint mode shows the whole-program cycle
# figure required by the 4-mode model.
#
# Manual TDD smoke test (runs the full SimPoint pipeline + estimate, ~1-2min);
# not wired into scripts/run_e2e.sh.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

fail() { echo "[FAIL] $*" >&2; exit 1; }

out=$(bash "$ROOT/tests/demos/demo_simpoint_loop.sh" 2>&1)
rc=$?
if [ "$rc" -eq 77 ]; then
  echo "[skip] simpoint demo skipped (rc=77, e.g. simpoint/python missing)"
  exit 0
fi
[ "$rc" -eq 0 ] || { echo "$out"; fail "simpoint demo did not exit 0 (rc=$rc)"; }

echo "$out" | grep -qE 'estimated_cycles=[0-9]+' \
  || { echo "$out"; fail "no estimated_cycles in simpoint demo output"; }

n=$(echo "$out" | grep -oE 'estimated_cycles=[0-9]+' | head -1 | cut -d= -f2)
{ [ -n "$n" ] && [ "$n" -gt 0 ]; } \
  || { echo "$out"; fail "estimated_cycles not a positive integer (got '${n:-}')"; }

echo "[ok] simpoint demo printed estimated_cycles=$n"
echo "PASS test_simpoint_estimated_cycles"
