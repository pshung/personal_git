#!/usr/bin/env bash
# F2a RED->GREEN: tests/e2e.sh must print the kernel cycle count - the vsim
# mcycle delta over the measured region (vsim drain mcycle - QEMU1 drain
# mcycle, offset 624) - for the kernel modes, so the csr/pc demos that wrap
# e2e.sh surface the cycle figure required by the 4-mode model.
#
# Manual TDD smoke test (runs real QEMU+vsim round-trips); not wired into
# scripts/run_e2e.sh.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

fail() { echo "[FAIL] $*" >&2; exit 1; }

check_mode() {
  local mode="$1" out rc n
  out=$(FIXTURE=rt_c_v_regs TRIGGER_MODE="$mode" EXPECT_RC=0 bash "$ROOT/tests/e2e.sh" 2>&1)
  rc=$?
  if [ "$rc" -eq 77 ]; then
    echo "[skip] $mode round-trip skipped (rc=77, e.g. toolchain missing)"
    return 0
  fi
  [ "$rc" -eq 0 ] || { echo "$out"; fail "$mode round-trip did not exit 0 (rc=$rc)"; }
  echo "$out" | grep -qE 'kernel_cycles' || { echo "$out"; fail "$mode: no kernel_cycles line"; }
  n=$(echo "$out" | sed -nE 's/.*kernel_cycles\][[:space:]]*([0-9]+).*/\1/p' | head -1)
  { [ -n "$n" ] && [ "$n" -gt 0 ]; } \
    || { echo "$out"; fail "$mode: kernel_cycles not a positive integer (got '${n:-}')"; }
  echo "[ok] $mode round-trip printed kernel_cycles=$n"
}

check_mode csr
check_mode pc
echo "PASS test_kernel_cycles"
