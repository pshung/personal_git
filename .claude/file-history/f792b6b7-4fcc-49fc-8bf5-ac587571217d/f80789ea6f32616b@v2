#!/usr/bin/env bash
# F2b RED->GREEN: the icount round-trip must print the window cycle count -
# the vsim mcycle delta over the measured window (vsim drain mcycle - QEMU
# drain mcycle, offset 624) - so icount mode shows the cycle figure required
# by the 4-mode model.
#
# Manual TDD smoke test (runs one real QEMU+vsim icount round-trip on the
# CSR-less icount_spin fixture); not wired into scripts/run_e2e.sh.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

fail() { echo "[FAIL] $*" >&2; exit 1; }

out=$(bash "$ROOT/tests/demos/demo_icount_roundtrip.sh" 2>&1) \
  || { echo "$out"; fail "icount demo did not exit 0"; }

echo "$out" | grep -qE 'window_cycles' \
  || { echo "$out"; fail "no window_cycles line in icount demo output"; }

n=$(echo "$out" | sed -nE 's/.*window_cycles[^0-9]*([0-9]+).*/\1/p' | head -1)
{ [ -n "$n" ] && [ "$n" -gt 0 ]; } \
  || { echo "$out"; fail "window_cycles not a positive integer (got '${n:-}')"; }

echo "[ok] icount demo printed window_cycles=$n"
echo "PASS test_icount_window_cycles"
