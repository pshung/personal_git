#!/usr/bin/env bash
# Rewrite 8b53fc2..HEAD into one clean commit per feature.
# Strategy (locked with PM): one commit/feature, /simplify folded in
# (reuse prior results), anchor 8b53fc2 included (base = its parent 03dfe23).
# Content is checked out from the verified-green tip c50297e, so the
# rewritten tip tree is byte-identical to it (asserted at the end).
set -euo pipefail

R=/home/nick/work/hybrid_sim/verilator
SRC=c50297e          # verified-green tip (simplifications already in tree)
BASE=03dfe23         # parent of anchor 8b53fc2
COAUTHOR="Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>"

# Preserve the 8 additive simplify commits before we move the branch.
git -C "$R" branch -f refactor-additive-backup "$SRC"

# Reset refactor to the base; tracked files revert to base, untracked
# (ROADMAP.md, hybrid/test/) and the submodule working dir are untouched.
git -C "$R" checkout -q -B refactor "$BASE"

n=0
feat() {              # feat "<subject>" "<body>" file...
  local subject="$1"; shift
  local body="$1"; shift
  git -C "$R" checkout -q "$SRC" -- "$@"
  git -C "$R" commit -q -m "$subject" -m "$body" -m "$COAUTHOR"
  n=$((n+1))
  printf '  [%2d] %s\n' "$n" "$subject"
}

feat "feat(platform): shared-mem RAM substrate (SimpleMemory + MmapBacking)" \
"Cross-simulator shared mmap substrate: SimpleMemory span, MmapBacking,
Platform RAM region, and memory-map constants.

/simplify: deduped the ~85%-identical shared-mem doctests behind
tests/hybrid/test_helpers.hpp (tlm_access/tlm_write/tlm_read)." \
  src/platform/simple_memory.hpp src/platform/mmap_backing.hpp \
  src/platform/platform.hpp src/platform/memory_map.h \
  src/tests/platform/simple_memory.test.cpp src/tests/platform/mmap_backing.test.cpp \
  tests/hybrid/memory_map.test.cpp tests/hybrid/shared_mem_offset.test.cpp \
  tests/hybrid/shared_mem_smoke.test.cpp tests/hybrid/test_helpers.hpp

feat "feat(dmi): Debug Module access layer (abstract command + program buffer)" \
"Low-level DMI bus, Abstract Command, Program Buffer and DMI poll, plus the
recording-bus test double.

/simplify: single home for the DMI register addresses (kDmiData0/Data1/
Abstractcs/Command) and busy/cmderr masks; added addr_type/data_type
aliases to systemc_dmi_bus.hpp." \
  src/hybrid/systemc_dmi_bus.hpp src/hybrid/abstract_command.hpp \
  src/hybrid/program_buffer.hpp src/hybrid/dmi_poll.hpp \
  tests/hybrid/abstract_command.test.cpp tests/hybrid/program_buffer.test.cpp \
  tests/hybrid/dmi_smoke.cpp tests/hybrid/recording_bus.hpp

feat "feat(state-loader): load hybrid_state_v1 from drain file + ABI guard" \
"Load the hybrid_state_v1 wire struct from the drain file; ABI layout guard.

/simplify: dropped dead includes; shared a lightweight SystemC-free tmpfile
helper (tests/hybrid/test_tmpfile.hpp); std::size() loops over gpr[]." \
  src/hybrid/state_loader.hpp tests/hybrid/state_loader.test.cpp \
  tests/hybrid/state_abi.test.cpp tests/hybrid/test_tmpfile.hpp

feat "feat(trigger-csr): CSR/PC trigger and instruction matching" \
"CSR pre-scan, PC-hit detection, instruction matching, handoff-site helper.

/simplify: insn_match test reuses the shared insn encoders
(tests/hybrid/insn_encoders.hpp) instead of local re-implementations." \
  src/hybrid/csr_trigger.hpp tests/hybrid/csr_trigger.test.cpp \
  tests/hybrid/insn_match.test.cpp tests/hybrid/insn_encoders.hpp \
  tests/hybrid/handoff_site.test.cpp

feat "feat(trigger-icount): drain after N retired instructions" \
"Instruction-count trigger for CSR-less whole-program windows.

/simplify: reviewed clean, no change needed." \
  src/hybrid/icount_trigger.hpp tests/hybrid/icount_trigger.test.cpp

feat "feat(vxfer): V regfile transport through scratch RAM" \
"save-all / reload-all V-register helpers through the shared scratch region.

/simplify: reviewed clean, no change needed." \
  src/hybrid/v_regfile_xfer.hpp tests/hybrid/v_regfile_xfer.test.cpp

feat "feat(resume): ResumeDriver Tier A/B CSR restore + V reload sweep" \
"Restore GPR/FPR/CSR/V state into the vsim hart via Abstract Commands and
Program Buffer (Tier A/B), including the vle8 V-data reload sweep.

/simplify: single-sourced the DMI register consts (aliased to the shared
kDmi* set); named the mstatus FS/VS mask + initial constants." \
  src/hybrid/resume_driver.hpp src/hybrid/resume_from_qemu.hpp \
  tests/hybrid/resume_driver.test.cpp tests/hybrid/resume_from_qemu.test.cpp

feat "feat(drain): StateDrain readback + V drain policy" \
