  src/hybrid/gdbstub_client.hpp src/hybrid/gdbstub_session.hpp \
  tests/hybrid/gdbstub_client.test.cpp

feat "feat(controller): HandoffController phase dispatch + exit codes" \
"Phase dispatcher gluing trigger -> resume -> drain; exit-code mapping.

/simplify: reviewed clean, no change needed." \
