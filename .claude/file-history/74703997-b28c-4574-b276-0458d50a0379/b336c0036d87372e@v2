#pragma once

// Lightweight, SystemC-free scaffolding shared by the hybrid file-IO doctests:
// a per-process unique temp path and a raw binary-file writer.

#include <unistd.h>

#include <cstddef>
#include <filesystem>
#include <fstream>
#include <string>

namespace hybrid::test {

// Collision-free temp path: prefix + caller tag + pid. Any stale file is
// removed up front so the caller starts clean.
inline auto unique_tmp_path(const char* tag) -> std::string
{
  auto p = std::filesystem::temp_directory_path()
           / (std::string{"vsim_test_"} + tag + "_" + std::to_string(::getpid()));
  std::filesystem::remove(p);
  return p.string();
}

// Write n raw bytes from `data` to `path`, truncating any existing file.
inline void write_binary_file(const std::string& path, const void* data,
                              std::size_t n)
{
  std::ofstream f(path, std::ios::binary | std::ios::trunc);
  f.write(static_cast<const char*>(data), static_cast<std::streamsize>(n));
}

}  // namespace hybrid::test
