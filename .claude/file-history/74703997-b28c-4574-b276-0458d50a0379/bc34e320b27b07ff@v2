#pragma once

#include <cstdint>

namespace hybrid {

enum class AarSize : uint8_t
{
  Bits32 = 2,
  Bits64 = 3,
  Bits128 = 4,
};

constexpr auto regno_csr(uint16_t csr) -> uint16_t { return csr; }
constexpr auto regno_gpr(uint16_t i) -> uint16_t { return 0x1000u + i; }
constexpr auto regno_fpr(uint16_t i) -> uint16_t { return 0x1020u + i; }
constexpr auto regno_vector(uint16_t i) -> uint16_t { return 0x1040u + i; }

constexpr auto access_register_command(uint16_t regno, AarSize size, bool write,
                                       bool postexec = false) -> uint32_t
{
  uint32_t cmd = 0;
  cmd |= (uint32_t(size) & 0x7u) << 20;
  if (postexec) cmd |= 1u << 18;
  cmd |= 1u << 17;
  if (write) cmd |= 1u << 16;
  cmd |= regno;
  return cmd;
}

// DMI register addresses (RISC-V Debug Spec table 3.1 / DM register map).
inline constexpr uint8_t kDmiData0 = 0x04u;
inline constexpr uint8_t kDmiData1 = 0x05u;
inline constexpr uint8_t kDmiAbstractcs = 0x16u;
inline constexpr uint8_t kDmiCommand = 0x17u;

// abstractcs fields (Debug Spec 3.14.6).
inline constexpr uint32_t kAbstractcsBusy = 1u << 12;
inline constexpr uint32_t kAbstractcsCmderrMask = 0x7u << 8;

}  // namespace hybrid
