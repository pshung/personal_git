/* Raw uncached-syscall-window protocol check, no newlib syscalls involved.
 *
 * Speaks the SimControl mailbox window directly (u64 MMIO only): stage
 * gettimeofday in the window's arg slots, ring SYSCALL_GO, read the result
 * and the tv payload back out of the window. No cacheable RAM address
 * appears anywhere in the exchange, so this must pass on every engine
 * regardless of its cache hierarchy -- including ax66's private write-back
 * PL2C, which shadows the legacy RAM-magicmem protocol. Contract:
 * ROADMAP_HTIF_WINDOW.md; host side: vsim src/platform/sim_control.hpp
 * (and the QEMU andes_ae350 mirror once W4 lands).
 */

#include <stdint.h>
#include <stdio.h>

#define SIM_CTRL_BASE 0xe0080000UL
#define SYSCALL_GO (*(volatile uint32_t*) (SIM_CTRL_BASE + 0x28))
#define WINDOW ((volatile uint64_t*) (SIM_CTRL_BASE + 0x800))
#define WINDOW_DATA_VA (SIM_CTRL_BASE + 0x840)

#define VH_SYS_GETTIMEOFDAY 5

int main(void)
{
  WINDOW[0] = VH_SYS_GETTIMEOFDAY;
  WINDOW[1] = WINDOW_DATA_VA; /* tv lands in the window's data area */
  for (int i = 2; i < 8; ++i)
    WINDOW[i] = 0;

  SYSCALL_GO = 1;

  uint64_t ret = WINDOW[0];
  uint64_t tv_sec = *(volatile uint64_t*) WINDOW_DATA_VA;

  if (ret != 0 || tv_sec < 1700000000ULL) {
    printf("WINDOW: bad ret=%ld tv_sec=%lu\n", (long) ret,
           (unsigned long) tv_sec);
    return 1;
  }
  printf("window ok\n");
  return 0;
}
