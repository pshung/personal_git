/* gettimeofday() must succeed on EVERY cycle-accurate engine, including
 * ones whose mmsc_cfg reports PL2C support with zero configured L2 size
 * (ax66_makatau): it is the runtime's first HTIF syscall, so a bad L2
 * probe inside flush_dcache() breaks it before the ROI even starts. */

#include <stdio.h>
#include <sys/time.h>

int main(void)
{
  struct timeval tv;
  if (gettimeofday(&tv, NULL) != 0) {
    printf("GETTIMEOFDAY: call failed\n");
    return 1;
  }
  printf("gettimeofday ok\n");
  return 0;
}
