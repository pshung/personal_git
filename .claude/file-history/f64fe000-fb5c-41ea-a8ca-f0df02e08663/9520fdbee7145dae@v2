/* gettimeofday() must succeed on EVERY cycle-accurate engine, including
 * ones with a private write-back L2 (ax66_makatau's PL2C): it is the
 * runtime's first HTIF syscall, so a syscall transport that is not
 * cache-coherent breaks here before the ROI even starts. This is what
 * killed the legacy RAM-magicmem protocol on ax66 (the guest read its
 * own stale PL2C line instead of the host's result); the runtime now
 * rides the uncached SimControl window, and this test pins that. */

#include <stdio.h>
#include <sys/time.h>

int main(void)
{
  struct timeval tv;
  if (gettimeofday(&tv, NULL) != 0) {
    printf("GETTIMEOFDAY: call failed\n");
    return 1;
  }
  printf("gettimeofday ok\n");
  return 0;
}
