-include ../../Make.var

all: cpp.elf cpp.dump

cpp.elf: main.cpp
	$(CXX) $(CFLAGS) $< -o $@

cpp.dump: cpp.elf
	$(OBJDUMP) -d $< > $@

# The four andesim modes, one target each. Same ELF everywhere.
cpp-fast: cpp.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

cpp-cycle: cpp.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

cpp-hybrid-marker: cpp.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

cpp-hybrid-pc: cpp.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start cpp_roi --pc-end cpp_roi_end \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: cpp-fast cpp-cycle cpp-hybrid-marker cpp-hybrid-pc

clean:
	- rm -f cpp.elf cpp.dump

.PHONY: all run clean cpp-fast cpp-cycle cpp-hybrid-marker cpp-hybrid-pc
