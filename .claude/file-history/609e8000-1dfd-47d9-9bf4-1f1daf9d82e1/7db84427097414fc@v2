/* C++ runtime contract on the vplat runtime (tests/vplat/test_vplat_cpp.sh):
 *
 *   1. Static constructors run before main: crt0 walks .init_array via
 *      newlib's __libc_init_array. The ctor assembles the "CPP" tag one
 *      character at a time, so the tag cannot exist unless the ctor ran.
 *   2. libstdc++ heap containers work on the runtime's _sbrk heap:
 *      std::vector growth plus std::string concatenation.
 *   3. Returning from main has C++ exit(rc) semantics: the static
 *      object's destructor prints CPP_DTOR_OK after main returns.
 *
 * printf (not iostream) keeps the cycle-engine leg small.
 */

#include <cstdio>
#include <string>
#include <vector>

namespace {

struct Banner {
  int ctor_ran = 0; /* plain int: safe to test even if the ctor never ran */
  std::string tag;
  Banner()
  {
    tag += 'C';
    tag += 'P';
    tag += 'P';
    ctor_ran = 1;
  }
  ~Banner() { printf("CPP_DTOR_OK tag=%s\n", tag.c_str()); }
};

Banner banner; /* static storage: ctor rides .init_array */

} /* namespace */

static volatile int src[4] = {1, 2, 3, 4};

int main()
{
  if (!banner.ctor_ran) {
    printf("CPP_FAIL static ctor did not run\n");
    return 1;
  }
  if (banner.tag != "CPP") {
    printf("CPP_FAIL ctor tag='%s' want='CPP'\n", banner.tag.c_str());
    return 1;
  }

  std::vector<int> v;
  for (int i = 0; i < 4; i++) {
    int x = src[i]; /* volatile read anchors the loop at runtime */
    v.push_back(x);
  }
  int sum = 0;
  for (int x : v)
    sum += x;
  if (sum != 10) {
    printf("CPP_FAIL vector sum=%d want=10\n", sum);
    return 1;
  }

  std::string msg = banner.tag + "_OK";
  printf("%s sum=%d\n", msg.c_str(), sum);
  return 0;
}
