/* Unified linker script for all hybrid test fixtures.
 *
 * Load base: 0x00100000 (1 MiB into andes_ae350 DRAM).
 *
 * andes_ae350 memory map:
 *   DRAM : 0x00000000 .. 0x7FFFFFFF  (writable, executable)
 *   MROM : 0x80000000 .. 0x87FFFFFF  (read-only)
 *
 * Reserved scratch (below text, used by .S fixtures):
 *   0x00000004              rt_csr_survival mtvec test value
 *   0x00001000              semihost_exit.inc param block
 *   0x00002000              rt_all_gprs spill area
 *   0x00003000              rt_mem_loadstore / rt_unaligned_lh buffer
 *   0x00010000              rt_shared_mem 4 KB buffer
 *
 * Layout above 0x00100000:
 *   .text         pinned at 0x00100000 (entry _start)
 *   .rodata
 *   .preinit_array/.init_array/.fini_array + EH tables (C++ runtime;
 *                 deliberately ABOVE _edata, see the comment there)
 *   .data         _edata terminates .data
 *   .bss          _end   terminates .bss (crt0 zeros [.bss, _end))
 *   _stack        0x00700000 (used by crt0.S to init sp)
 *
 * V-register transport scratch (L26): NOT a fixed address any more. The driver
 * maps one 4 KiB page above --mem-size and parks the scratch there (the mmap's
 * top page, v_scratch_gpa = ram_base + --mem-size), so it sits just past the
 * program's RAM -- nothing in this script can collide with it. No reservation
 * needed here.
 *
 * .S fixtures with no .data/.bss leave those sections empty (zero cost).
 * C fixtures rely on _edata / _end / _stack.
 */

ENTRY(_start)

SECTIONS {
    . = 0x00100000;

    .text : {
        *(.text.init)
        *(.text*)
    }

    .rodata : {
        *(.rodata*)
        *(.srodata*)
    }

    /* C++ constructor/destructor arrays and EH metadata. Everything here
     * must stay ABOVE _edata: crt0 zeroes [_edata, _end) before it walks
     * .init_array, so an array placed after .data would be wiped first.
     * crt0.S runs newlib's __libc_init_array, which reads the WEAK
     * start/end symbols below -- without these PROVIDEs they resolve to
     * 0 and no constructor ever runs. KEEP: entries are only referenced
     * through these bounds, never by symbol. */
    .preinit_array : {
        PROVIDE_HIDDEN(__preinit_array_start = .);
        KEEP(*(.preinit_array))
        PROVIDE_HIDDEN(__preinit_array_end = .);
    }
    .init_array : {
        PROVIDE_HIDDEN(__init_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
        KEEP(*(.init_array .ctors))
        PROVIDE_HIDDEN(__init_array_end = .);
    }
    .fini_array : {
        PROVIDE_HIDDEN(__fini_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.fini_array.*) SORT_BY_INIT_PRIORITY(.dtors.*)))
        KEEP(*(.fini_array .dtors))
        PROVIDE_HIDDEN(__fini_array_end = .);
    }
    /* crtbegin.o's __EH_FRAME_BEGIN__ leads and crtend.o's terminator
     * closes .eh_frame via the specs' startfile/endfile link order. */
    .eh_frame : { KEEP(*(.eh_frame)) }
    .gcc_except_table : { *(.gcc_except_table*) }

    .data : {
        *(.data*)
        *(.sdata*)
    }
    _edata = .;

    .bss : {
        *(.bss*)
        *(.sbss*)
        *(COMMON)
    }
    _end = .;

    /* Default stack top; the V-transport scratch lives above program RAM
     * (top of the shared mmap), so no headroom below it is needed here.
     * Override at link time with -Wl,--defsym,_stack=... if needed. */
    PROVIDE(_stack = 0x00700000);
}
