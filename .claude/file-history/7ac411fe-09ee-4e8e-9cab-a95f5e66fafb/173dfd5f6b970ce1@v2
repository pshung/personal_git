-include ../../Make.var

all: fp.elf fp.dump

fp.elf: main.c
	$(CC) $(CFLAGS) $< -o $@

fp.dump: fp.elf
	$(OBJDUMP) -d $< > $@

# The four andesim modes, one target each. Same ELF everywhere.
fp-fast: fp.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

fp-cycle: fp.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

fp-hybrid-marker: fp.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

fp-hybrid-pc: fp.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start fp_roi --pc-end fp_roi_end \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: fp-fast fp-cycle fp-hybrid-marker fp-hybrid-pc

clean:
	- rm -f fp.elf fp.dump

.PHONY: all run clean fp-fast fp-cycle fp-hybrid-marker fp-hybrid-pc
