-include ../../Make.var

all: verify.elf verify_taint.elf verify.dump verify_taint.dump

# RVV intrinsics need V in the arch string; the later -march wins.
verify.elf: main.c
	$(CC) $(CFLAGS) -march=rv$(XLEN)gcv $< -o $@

verify_taint.elf: main.c
	$(CC) $(CFLAGS) -march=rv$(XLEN)gcv -DVERIFY_TAINT $< -o $@

verify.dump: verify.elf
	$(OBJDUMP) -d $< > $@

verify_taint.dump: verify_taint.elf
	$(OBJDUMP) -d $< > $@

verify-fast: verify.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

# The headline: --verify re-runs the ELF on pure QEMU up to the ROI exit
# and diffs the drained state field by field against the cycle engine.
verify-hybrid-marker: verify.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) \
	    --verify $(ANDESIM_FLAGS) $<

# FAILS BY DESIGN: the taint build holds an mcycle sample in x31 at the
# exit marker, so the diff names x31 and andesim exits non-zero. Run it
# to see what verify catching real divergence looks like.
verify-taint-hybrid-marker: verify_taint.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) \
	    --verify $(ANDESIM_FLAGS) $<

run: verify-fast verify-hybrid-marker

# Self-asserting: clean build must PASS verify, taint build must FAIL it
# naming exactly x31.
check: verify.elf verify_taint.elf
	@ANDESIM_BIN="$(ANDESIM_BIN)" ENGINE="$(ENGINE)" bash check.sh

clean:
	- rm -f verify.elf verify_taint.elf verify.dump verify_taint.dump

.PHONY: all run check clean verify-fast verify-hybrid-marker \
        verify-taint-hybrid-marker
