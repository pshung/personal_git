/* Why timing-config transport matters: the cache-enable state.
 *
 * The andesim runtime's crt0 enables the L1 I/D caches by writing
 * mcache_ctl (0x7CA) at boot. On hybrid that write runs on QEMU, which
 * models no caches -- the ONLY reason the vsim ROI runs cached is that
 * the handoff transports the written mcache_ctl value and restores it
 * before the ROI resumes. This demo makes that visible as a number:
 *
 *   cache_on.elf   the default program: crt0's enable is transported,
 *                  the ROI runs WITH L1 caches -- what this program
 *                  would do on real silicon.
 *   cache_off.elf  same source, -DCACHE_OFF: the program clears
 *                  mcache_ctl.IC_EN|DC_EN (bits 0|1) before the ROI,
 *                  so the transported value disables the caches and
 *                  the same kernel runs UNCACHED -- every instruction
 *                  fetch and data access goes out to DRAM.
 *
 * The gap between the two figures is what the transport buys; without
 * it, EVERY hybrid window would measure like cache_off (the engine's
 * reset default is caches-disabled). It is also a write-mask demo: a
 * config CSR is restored only because the program (crt0 or the
 * CACHE_OFF line) actually wrote it.
 *
 * The ROI is a pure kernel -- PASSES sweeps over a 4 KB volatile array,
 * no I/O inside the window. The checksum verdict (CACHE_OK) prints
 * after the ROI, so it appears on fast and cycle only; on hybrid the
 * output is just the cycle figure, compared by check.sh.
 *
 * There is deliberately NO cache_off cycle target: from reset on the
 * RTL the program runs cached until the clear, so disabling the
 * D-cache mid-run would strand its dirty lines (that needs a CCTL
 * writeback-invalidate first). On hybrid the vsim caches start empty
 * at the restore, so the plain disable is safe and exact.
 */

#include <stdint.h>
#include <stdio.h>
#include <andesim/ROI.h>

/* Sized for the UNCACHED case: every fetch and load then goes to DRAM,
 * costing tens of cycles each on the RTL, and the whole window must
 * still finish inside the driver's 90 s per-leg budget on a kHz-class
 * RTL simulation. 4 passes x 256 words keeps the uncached window in
 * the low hundreds of thousands of cycles. */
#define PASSES 4
#define WORDS  256  /* 1 KB: fits easily in the L1 D-cache */

/* volatile: every element read is a real load on every pass -- the
 * compiler can neither cache the array in registers nor fold the
 * per-pass sums into one sweep. */
static volatile int32_t buf[WORDS];

/* Small values in [-8, 7]. */
static inline int32_t elem(uint32_t i)
{
  uint32_t h = (i + 0xCACEu) * 2654435761u;
  return (int32_t) (h >> 28) - 8;
}

/* ROI body, noinline and non-static so --trigger pc can name it. */
__attribute__((noinline)) long cache_kernel(void)
{
  long sum = 0;
  for (int p = 0; p < PASSES; p++)
    for (int i = 0; i < WORDS; i++)
      sum += buf[i];
  return sum;
}

int main(void)
{
  long single = 0;
  for (int i = 0; i < WORDS; i++) {
    buf[i] = elem((uint32_t) i);
    single += buf[i];
  }
  long want = (long) PASSES * single;

#ifdef CACHE_OFF
  /* Clear mcache_ctl.IC_EN|DC_EN. The write-mask records this CSR
   * write, so the handoff restores the DISABLED state into vsim. */
  __asm__ __volatile__("csrrc x0, 0x7ca, %0" : : "r"(3UL));
  printf("CACHE staged: %u KB x %u passes, caches DISABLED for the ROI\n",
         (unsigned) (sizeof buf / 1024), (unsigned) PASSES);
#else
  printf("CACHE staged: %u KB x %u passes, crt0 cache enable transported\n",
         (unsigned) (sizeof buf / 1024), (unsigned) PASSES);
#endif

  andesim_ROI_begin();
  long sum = cache_kernel();
  andesim_ROI_end();
  /* ROI end symbol for --pc-end: the point right after the call. */
  __asm__ __volatile__(".globl cache_roi_end\ncache_roi_end:" ::: "memory");

  /* Runs on fast and cycle only: a hybrid run ended at the exit trigger. */
  if (sum != want) {
    printf("CACHE_BAD sum=%ld want=%ld\n", sum, want);
    return 1;
  }
  printf("CACHE_OK sum=%ld\n", sum);
  return 0;
}
