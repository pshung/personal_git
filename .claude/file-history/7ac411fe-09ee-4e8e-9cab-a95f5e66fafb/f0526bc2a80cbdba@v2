-include ../../Make.var

all: engines.elf engines.dump

engines.elf: main.c
	$(CC) $(CFLAGS) $< -o $@

engines.dump: engines.elf
	$(OBJDUMP) -d $< > $@

# The standard modes run on the default $(ENGINE).
engines-fast: engines.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

engines-cycle: engines.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

engines-hybrid-marker: engines.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

engines-hybrid-pc: engines.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start engines_kernel --pc-end engines_roi_end \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: engines-fast engines-cycle engines-hybrid-marker engines-hybrid-pc

# The demo's point: sweep EVERY installed vsim engine over the same ELF
# (parsed from `andesim list engines`; override with ENGINES="vsim:a ...")
# and print the comparison table.
check: engines.elf
	@ANDESIM_BIN="$(ANDESIM_BIN)" bash check.sh

clean:
	- rm -f engines.elf engines.dump

.PHONY: all run check clean engines-fast engines-cycle \
        engines-hybrid-marker engines-hybrid-pc
