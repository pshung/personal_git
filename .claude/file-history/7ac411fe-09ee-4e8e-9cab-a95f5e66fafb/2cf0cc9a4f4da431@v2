/* Scalar FP state across the handoff -- fcsr (frm + sticky fflags).
 *
 * demo/rvv covers the vector unit; this demo covers the scalar FPU's
 * architectural state. The handoff restores fcsr over the Debug Module
 * before the ROI resumes, and this demo proves it BEHAVIORALLY: the
 * ROI's own arithmetic comes out right only if the transported
 * rounding mode steers it.
 *
 * QEMU phase (before the ROI):
 *   - clear fflags, set frm = RTZ (round toward zero; the reset
 *     default is RNE, round to nearest even)
 *   - raise the sticky divide-by-zero flag with a real 1.0f/0.0f
 *     (+inf is exact, so DZ is the only flag it raises)
 *
 * vsim ROI:
 *   - q = 1.0f/3.0f. The quotient is not representable; the fdiv.s
 *     (dynamic rounding) truncates to 0x3eaaaaaa under RTZ, while the
 *     reset-default RNE would round up to 0x3eaaaaab. The BITS of q
 *     tell which rounding mode the divide really used.
 *   - read the CSRs back: frm must still be RTZ, and fflags must be
 *     exactly DZ|NX -- DZ sticky from before the handoff, NX freshly
 *     raised by the divide.
 *
 * The checks and the FP_OK print live INSIDE the ROI: a hybrid run
 * ends at the exit trigger, so code after the ROI never runs there.
 * The printf's UART cycles land in the figure -- this demo measures
 * correctness, not a clean kernel number.
 */

#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <andesim/ROI.h>

/* fcsr fields (RISC-V F extension). */
#define FRM_RTZ   1u     /* round toward zero; the RNE reset default is 0 */
#define FFLAG_NX  0x01u  /* inexact */
#define FFLAG_DZ  0x08u  /* divide by zero */

/* The two floats nearest to 1/3: RTZ truncates down, RNE rounds up. */
#define THIRD_RTZ_BITS 0x3eaaaaaau
#define THIRD_RNE_BITS 0x3eaaaaabu
#define POS_INF_BITS   0x7f800000u

/* volatile: force a real runtime fdiv.s, no compile-time folding. */
static volatile float f_one = 1.0f, f_three = 3.0f, f_zero = 0.0f;

static inline uint32_t float_bits(float f)
{
  uint32_t u;
  memcpy(&u, &f, sizeof u);
  return u;
}

/* ROI body, noinline and non-static so --trigger pc can name it. */
__attribute__((noinline)) int fp_roi(void)
{
  float q = f_one / f_three;  /* fdiv.s, rounded by the LIVE frm */

  unsigned long rm, flags;
  /* The dummy 'q' input orders the flag read after the divide. */
  __asm__ __volatile__("csrr %0, fflags" : "=r"(flags) : "f"(q));
  __asm__ __volatile__("csrr %0, frm" : "=r"(rm));

  int bad = 0;
  if (float_bits(q) != THIRD_RTZ_BITS) {
    printf("FP_BAD quotient=0x%08x want=0x%08x (RNE gives 0x%08x)\n",
           (unsigned) float_bits(q), (unsigned) THIRD_RTZ_BITS,
           (unsigned) THIRD_RNE_BITS);
    bad = 1;
  }
  if (rm != FRM_RTZ) {
    printf("FP_BAD frm=%lu want=%u (RTZ)\n", rm, (unsigned) FRM_RTZ);
    bad = 1;
  }
  if (flags != (FFLAG_DZ | FFLAG_NX)) {
    printf("FP_BAD fflags=0x%02lx want=0x%02x (DZ|NX)\n",
           flags, (unsigned) (FFLAG_DZ | FFLAG_NX));
    bad = 1;
  }
  if (bad)
    return 1;

  printf("FP_OK quotient=0x%08x frm=RTZ fflags=DZ|NX\n",
         (unsigned) float_bits(q));
  return 0;
}

int main(void)
{
  /* Stage the FP environment the ROI must inherit. */
  __asm__ __volatile__("csrw fflags, x0");  /* clean slate */
  __asm__ __volatile__("csrw frm, %0" : : "r"((unsigned long) FRM_RTZ));

  float inf = f_one / f_zero;  /* raises the sticky DZ flag, and only DZ */
  if (float_bits(inf) != POS_INF_BITS) {
    printf("FP_STAGE_BAD 1/0=0x%08x\n", (unsigned) float_bits(inf));
    return 2;
  }
  printf("FP staged: frm=RTZ fflags=DZ\n");

  andesim_ROI_begin();
  int rc = fp_roi();
  andesim_ROI_end();
  /* ROI end symbol for --pc-end: the point right after the call. */
  __asm__ __volatile__(".globl fp_roi_end\nfp_roi_end:" ::: "memory");

  /* Runs on fast and cycle only: a hybrid run ended at the exit trigger. */
  return rc; /* exit code travels via SimControl */
}
