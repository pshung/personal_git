#pragma once

#include "memory_region.hpp"

#include <fmt/format.h>
#include <spdlog/spdlog.h>
#include <systemc>
#include <tlm>
#include <tlm_utils/multi_passthrough_initiator_socket.h>
#include <tlm_utils/multi_passthrough_target_socket.h>

#include <cstdint>

#include <map>
#include <set>

/**
 * An interconnect that routes transactions based on memory regions.
 * Uses plain TLM2.0 base protocol types — no AXI/AHB dependency.
 */
template<std::size_t BusWidth>
class Interconnect : public sc_core::sc_module
{
  using this_type = Interconnect<BusWidth>;
  using protocol_types = tlm::tlm_base_protocol_types;

  using base_initiator_socket =
    tlm::tlm_base_initiator_socket<BusWidth,
                                   tlm::tlm_fw_transport_if<protocol_types>,
                                   tlm::tlm_bw_transport_if<protocol_types>>;

  using base_target_socket =
    tlm::tlm_base_target_socket<BusWidth,
                                tlm::tlm_fw_transport_if<protocol_types>,
                                tlm::tlm_bw_transport_if<protocol_types>>;

  tlm_utils::
    multi_passthrough_initiator_socket<this_type, BusWidth, protocol_types>
      initiator_sockets{"initiator_sockets"};

  tlm_utils::
    multi_passthrough_target_socket<this_type, BusWidth, protocol_types>
      target_sockets{"target_sockets"};

  std::map<const tlm::tlm_generic_payload*, unsigned> trans_map;
  using fw_if = tlm::tlm_fw_transport_if<protocol_types>;
  std::vector<std::tuple<MemoryRegion, fw_if*, std::string>> memory_regions;
  std::vector<std::tuple<MemoryRegion, std::string>> reserved_regions;
  std::set<fw_if*> bound_targets;

  auto find_fw_if_from_address(const uint64_t addr) -> fw_if*
  {
    for (const auto& [mr, socket, _]: this->memory_regions) {
      if (mr.contains(addr))
        return socket;
    }

    return nullptr;
  }

  auto nb_transport_fw(const int id,
                       tlm::tlm_generic_payload& trans,
                       tlm::tlm_phase& phase,
                       sc_core::sc_time& delay) -> tlm::tlm_sync_enum
  {
    const auto addr = trans.get_address();
    assert(id >= 0 && unsigned(id) < this->target_sockets.size());
    const auto target = this->find_fw_if_from_address(addr);
    if (!target) {
      spdlog::critical("target socket not found for address {:#x}, "
                       "initiator_port={}, cmd={}, len={}",
                       addr, id, trans.is_read() ? "read" : "write",
                       trans.get_data_length());
      trans.set_response_status(tlm::TLM_ADDRESS_ERROR_RESPONSE);
      return tlm::tlm_sync_enum::TLM_COMPLETED;
    }

    const auto sync = target->nb_transport_fw(trans, phase, delay);
    if (sync != tlm::TLM_COMPLETED) {
      this->trans_map[&trans] = id;
    }
    return sync;
  }

  auto nb_transport_bw(const int id,
                       tlm::tlm_generic_payload& trans,
                       tlm::tlm_phase& phase,
                       sc_core::sc_time& delay) -> tlm::tlm_sync_enum
  {
    assert(id >= 0 && unsigned(id) < this->initiator_sockets.size());
    const auto tsckt_id = this->trans_map.at(&trans);
    assert(tsckt_id < this->target_sockets.size());

    const auto sync =
      this->target_sockets[tsckt_id]->nb_transport_bw(trans, phase, delay);

    if (sync == tlm::TLM_COMPLETED) {
      this->trans_map.erase(&trans);
    }
    return sync;
  }

  void b_transport(const int id,
                   tlm::tlm_generic_payload& trans,
                   sc_core::sc_time& delay)
  {
    const auto addr = trans.get_address();
    assert(id >= 0 && unsigned(id) < this->target_sockets.size());
    const auto target = this->find_fw_if_from_address(addr);
    if (!target) {
      spdlog::critical("target socket not found for address {:#x}, "
                       "initiator_port={}, cmd={}, len={}",
                       addr, id, trans.is_read() ? "read" : "write",
                       trans.get_data_length());
      trans.set_response_status(tlm::TLM_ADDRESS_ERROR_RESPONSE);
      return;
    }
    target->b_transport(trans, delay);
  }

  bool has_overlaps(const MemoryRegion& in_mr)
  {
    for (const auto& [mr, _, __]: this->memory_regions)
      if (mr.overlaps(in_mr))
        return true;
    for (const auto& [mr, _]: this->reserved_regions)
      if (mr.overlaps(in_mr))
        return true;
    return false;
  }

public:
  Interconnect(const sc_core::sc_module_name& name)
      : sc_core::sc_module{name}
  {
    this->target_sockets.register_nb_transport_fw(
      this, &Interconnect::nb_transport_fw);
    this->target_sockets.register_b_transport(this, &Interconnect::b_transport);
    this->initiator_sockets.register_nb_transport_bw(
      this, &Interconnect::nb_transport_bw);
  }

  void bind_initiator(base_initiator_socket& initiator)
  {
    initiator.bind(this->target_sockets);
  }

  void bind_target_no_check(base_target_socket& target, const MemoryRegion& mr)
  {
    auto* fw_if = &target.get_base_interface();
    if (bound_targets.find(fw_if) == bound_targets.end()) {
      this->initiator_sockets.bind(target);
      bound_targets.insert(fw_if);
    }
    memory_regions.emplace_back(
      std::make_tuple(mr, fw_if, std::string(target.name())));
  }

  // Forward memory accesses within the specified region (mr) to the given
  // target for processing.
  void bind_target(base_target_socket& target, const MemoryRegion& mr)
  {
    if (has_overlaps(mr))
      throw std::invalid_argument(std::format(
        "invalid memory region: [{:#x}-{:#x}], overlapped with existing memory regions",
        mr.base_address, mr.end_address));
    bind_target_no_check(target, mr);
  }

  // Reserve a memory region to prevent it from being bound as a target.
  void reserve_region(const std::string& name, const MemoryRegion& mr)
  {
    reserved_regions.push_back({mr, name});
  }

  void dump_region()
  {
    fmt::print("=== Memory Regions ===\n");
    for (size_t i = 0; i < memory_regions.size(); ++i) {
      const auto& [mr, socket, name] = memory_regions[i];
      fmt::print("{}: [{:#x}-{:#x}] (size: {:#x})\n", name, mr.base_address,
                 mr.end_address, mr.end_address - mr.base_address + 1);
    }

    for (size_t i = 0; i < reserved_regions.size(); ++i) {
      const auto& [mr, name] = reserved_regions[i];
      fmt::print("{}: [{:#x}-{:#x}] (size: {:#x})\n", name, mr.base_address,
                 mr.end_address, mr.end_address - mr.base_address + 1);
    }
  }
};
