#pragma once

#include <cstdint>

#include <format>
#include <limits>
#include <stdexcept>
#include <string>
#include <string_view>

/**
 * A memory region in the range of `[base_address, end_address)`.
 * The constructor takes an inclusive end address and stores it as exclusive.
 * e.g. memory_region(0x80000000, 0x8fffffff) stores base=0x80000000,
 *      end=0x90000000.
 */
struct MemoryRegion
{
  using addr_type = uint64_t;

  const addr_type base_address; // inclusive
  const addr_type end_address; // exclusive (stored as param + 1)

  /**
   * @param base_address The base address of the memory region (inclusive).
   * @param end_address The end address of the memory region (inclusive).
   * @throws std::invalid_argument if base_address > end_address.
   * @example memory_region(0x00, 0xff) represents [0x00, 0x100)
   */
  MemoryRegion(const addr_type base_address, const addr_type end_address)
      : base_address{base_address}, end_address{end_address + 1}
  {
    if (base_address > end_address)
      throw std::invalid_argument(std::format(
        "invalid memory region: [{:#x}-{:#x}]", base_address, end_address));
  }

  auto contains(const addr_type addr) const noexcept -> bool
  {
    return addr >= this->base_address && addr < this->end_address;
  }

  auto contains(const MemoryRegion& other) const noexcept -> bool
  {
    return other.base_address >= this->base_address
        && other.end_address <= this->end_address;
  }

  // Does this region fully contain the half-open access [addr, addr + len)?
  // Takes a raw access (exclusive length) rather than a MemoryRegion, so it
  // does NOT go through the inclusive-end ctor (which adds 1). An access whose
  // exclusive end lands exactly on end_address is contained, so the final byte
  // of the region is reachable. contains(addr) also guarantees addr <
  // end_address, so end_address - addr cannot underflow, and comparing len
  // against it avoids overflowing addr + len at the top of the address space.
  auto contains_access(const addr_type addr,
                       const addr_type len) const noexcept -> bool
  {
    return this->contains(addr) && len <= this->end_address - addr;
  }

  auto overlaps(const MemoryRegion& other) const noexcept -> bool
  {
    return this->end_address > other.base_address
        && this->base_address < other.end_address;
  }
};

/**
 * The CPU HVM subordinate-port aperture. NDS_HVM_SIZE_KB is KILOBYTES; the
 * decode window must equal the memory, so the KB conversion lives here, in
 * one named place (a *0x1000 at the bind sites once decoded a 4x window).
 */
inline auto hvm_aperture(const MemoryRegion::addr_type base,
                         const MemoryRegion::addr_type size_kb) -> MemoryRegion
{
  return {base, base + size_kb * 1024 - 1};
}

/**
 * One `--print-memmap` line. Converts the stored EXCLUSIVE end back to the
 * inclusive last byte and the true span here, in one place, so no dump site
 * re-does the arithmetic (a former dump printed the exclusive end as if
 * inclusive and size = span + 1). Reserved holes -- regions blocked from
 * binding, not routable targets -- are tagged.
 */
inline auto format_region_line(const std::string_view name,
                               const MemoryRegion& mr,
                               const bool reserved = false) -> std::string
{
  return std::format("{}: [{:#x}-{:#x}] (size: {:#x}){}", name,
                     mr.base_address, mr.end_address - 1,
                     mr.end_address - mr.base_address,
                     reserved ? " (reserved)" : "");
}
