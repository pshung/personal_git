// vsim's main RAM must cover QEMU's `virt`-machine RAM base (0x80000000) so
// the same ELF can be loaded at the same physical address in both halves of
// the hybrid handoff. The cap stays below NDS_HVM_BASE (0x90000000), which
// is the CPU's slave-port HVM region; further peripherals (ILM, ACM, AIA,
// SMU, UART) start at 0xA0000000+.

#include "platform/memory_map.h"
#include "platform/memory_region.hpp"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include <cstdint>

constexpr uint64_t kNdsHvmBase = 0x90000000ULL;

// --print-memmap line format: MemoryRegion stores an EXCLUSIVE end, and the
// converter back to human form lives in exactly one place. The printed upper
// bound is the inclusive last byte and the size is the true span (a former
// dump printed the exclusive end and span+1), with reserved holes tagged.
TEST_CASE("format_region_line prints inclusive end and true size")
{
  const MemoryRegion uart{0xf0300000ULL, 0xf03fffffULL};
  CHECK(format_region_line("uart2", uart)
        == "uart2: [0xf0300000-0xf03fffff] (size: 0x100000)");
}

TEST_CASE("format_region_line tags reserved regions")
{
  const MemoryRegion pldm{0xe6800000ULL, 0xe6800fffULL};
  CHECK(format_region_line("PLDM", pldm, /*reserved=*/true)
        == "PLDM: [0xe6800000-0xe6800fff] (size: 0x1000) (reserved)");
}

// The CPU HVM subordinate-port aperture: NDS_HVM_SIZE_KB is KILOBYTES. The
// interconnect window must equal the memory -- a *0x1000 scaling at the bind
// site once decoded a 4x window ([0x90000000-0x900fffff] for a 256 KiB HVM),
// routing [0x90040000+] into the BFM while QEMU (256 KiB, hvm_size_pow_2=18)
// bus-errors there: engine-divergent behavior in the hybrid handoff.
TEST_CASE("hvm_aperture spans exactly NDS_HVM_SIZE_KB kilobytes")
{
  const MemoryRegion hvm = hvm_aperture(0x90000000ULL, 256);
  CHECK(hvm.base_address == 0x90000000ULL);
  CHECK(hvm.end_address == 0x90040000ULL);  // exclusive: base + 256 KiB
  CHECK(format_region_line("hvm", hvm)
        == "hvm: [0x90000000-0x9003ffff] (size: 0x40000)");
}

TEST_CASE("RAM region covers QEMU virt RAM base 0x80000000")
{
  CHECK(static_cast<uint64_t>(RAM_END) >= 0x80000000ULL);
}

TEST_CASE("RAM region does not collide with NDS_HVM_BASE")
{
  CHECK(static_cast<uint64_t>(RAM_END) < kNdsHvmBase);
}

TEST_CASE("RAM region does not collide with HART0 ILM peripheral")
{
  CHECK(static_cast<uint64_t>(RAM_END) < static_cast<uint64_t>(HART0_ILM_BASE));
}
