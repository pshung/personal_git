// The hybrid guest memory map: which regions a workload may touch in
// `run --mode hybrid`, composed from the same sources the run itself trusts.
//
// Only hybrid-SUPPORTED regions appear (PM rule): regions modeled by BOTH
// engines whose content or device behavior the handoff actually provides.
// QEMU-only devices (MROM/PLIC/PLMT/virtio/...), vsim-reserved holes (PLDM),
// and unverified-parity devices (UART1/SMU) are deliberately absent.
//
// Sources, in provenance order:
//   - DRAM + V-scratch: the driver's own window math (--mem-size; the
//     reserved HYBRID_V_SCRATCH_BYTES page above program RAM, L26).
//   - ILM/DLM/HVM bases: the engine's `--print-qemu-config` text -- the same
//     staged qemu.cfg the QEMU fast leg boots with, so the printed bases are
//     exactly the run's effective geometry.
//   - ILM/DLM/HVM sizes + row presence: the engine descriptor's backdoor-gated
//     ilm/dlm/hvm_size (0 = content cannot cross the handoff -> row omitted).
//   - SimControl/HTIF + UART2: fixed AE350 platform constants, identical in
//     QEMU (hw/riscv/andes_ae350.c memmap table) and vsim (platform
//     memory_map.h); drift is guarded by tests/andes_sim/
//     test_andes_sim_print_memmap.sh, which cross-checks the engine's own
//     `--print-memmap` dump.
//   - L2C register window (0xe0500000): intentionally absent until an engine
//     ships with an L2C -- `--describe` carries no L2C capability today, and
//     every current engine is built _NDS_L2C_CACHE_SIZE_KB=0.
#ifndef ANDESIM_MEMMAP_HPP
#define ANDESIM_MEMMAP_HPP

#include <cstdint>
#include <map>
#include <string>
#include <vector>

#include "engine_descriptor.hpp"

namespace andes_sim {

struct MemmapRow {
  std::string region;     // "DRAM", "V-scratch", "ILM", ...
  uint64_t base = 0;      // guest physical, first byte
  uint64_t end = 0;       // guest physical, LAST byte (inclusive)
  std::string transport;  // what the handoff does with the region's content
};

struct MemmapResult {
  std::vector<MemmapRow> rows;
  std::vector<std::string> warnings;  // e.g. LM geometry unavailable
};

// Extract the `riscv.andes.ae350.soc` [global] properties from an engine's
// --print-qemu-config text: property name -> value string, other drivers'
// globals (the CPU ISA block) excluded.
std::map<std::string, std::string> qemu_cfg_soc_props(
    const std::string& cfg_text);

// Compose the hybrid map for `eng` with `mem_size` bytes of program RAM
// (--mem-size) and the engine's --print-qemu-config text (may be empty:
// LM/HVM rows are then dropped with a warning naming the missing probe).
MemmapResult hybrid_memmap(const EngineDescriptor& eng, long long mem_size,
                           const std::string& qemu_cfg_text);

// "128M" / "4K" / "2G" for whole binary multiples, plain decimal bytes else.
std::string fmt_size(uint64_t bytes);

// Render as an aligned text table (REGION/BASE/END/SIZE/TRANSPORT), warnings
// appended one per line.
std::string render_memmap(const MemmapResult& r);

}  // namespace andes_sim

#endif  // ANDESIM_MEMMAP_HPP
