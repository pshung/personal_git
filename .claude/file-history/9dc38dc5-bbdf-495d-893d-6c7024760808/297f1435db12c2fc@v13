# ---- the kernel code on the page uses meaningful names -----------------------

CRYPTIC = ["is_not_zero", "qy", "neg_qy", "sy", "red", "sumi", "facc", "sumf", "yc", "dx", "aw", "aq",
           "w0", "w1", "w2", "w3", "vneg1", "bx", "a_ptr", "ab", "yb", "d0"]
IDENT = {name: re.compile(rf"(?<![\w.]){re.escape(name)}(?![\w])") for name in CRYPTIC}


def shown_code(page):
    out = []
    for prefix in ("anr", "anv"):
        m = re.search(rf'<pre id="{prefix}-code"><code>(.*?)</code></pre>', page, re.S)
        out.append((prefix, html.unescape(re.sub(r"<[^>]+>", "", m.group(1)))))
    for layout, n, code, names, note in steps(page):
        out.append((f"{layout}-{n}", code))
    return out


def test_kernel_code_on_the_page_uses_meaningful_names(page):
    for where, code in shown_code(page):
        code_only = "\n".join(l.split("//")[0] for l in code.splitlines())
        hits = [name for name, rx in IDENT.items() if rx.search(code_only)]
        assert not hits, (where, hits)


def test_rename_is_a_pure_consistent_renaming_of_the_kernel_source():
    for layout, src in bp.kernel_sources().items():
        renamed = bp.rename_code(layout, src)
        # same shape: same number of lines, same intrinsic calls, same punctuation skeleton
        assert renamed.count("\n") == src.count("\n")
        strip = lambda s: re.sub(r"[A-Za-z_][A-Za-z0-9_]*", "", s)
        assert strip(renamed) == strip(src)
        expected = {"upstream": ("sign_mask", "row_total"), "rvv": ("sign_mask", "row_totals"), "vd4": ("signs0", "row_totals")}
        for name in expected[layout]:
            assert name in renamed, (layout, name)
        # mnemonics are never touched
        for mn in ("vmv.v.x", "vmv.x.s", "vfcvt.f.x.v", "nds.vd4dots.vv"):
            assert (mn in renamed) == (mn in src)


