TOKEN = re.compile(r"\{[^}]*\}")


@pytest.mark.parametrize("layout,prefix", [("rvv", "anr"), ("vd4", "anv")])
def test_repack_animation_pictures_use_plain_names(page, layout, prefix):
    m = re.search(rf'<svg id="svg-anim-{layout}".*?</svg>', page, re.S)
    assert m
    texts = [html.unescape(t) for t in re.findall(r"<text [^>]*>([^<]*)</text>", m.group(0))]
    assert len(texts) >= 12
    bad = [t for t in texts if CODE_NAMES.search(TOKEN.sub("", t))]
    assert not bad, bad[:8]
    for s in bp.repack_trace(layout)["steps"]:
        for t in [s["state"], s.get("tpl") or ""] + list((s.get("tpls") or {}).values()):
            assert not CODE_NAMES.search(TOKEN.sub("", t)), (s["name"], t)
    for b in ("play", "prev", "next", "reset", "speed", "follow", "data", "code"):
        assert f'id="{prefix}-{b}"' in page
    assert "function q1Anim" in page


