CODE_NAMES = re.compile(r"(\b(is_not_zero|neg_qy|qy|sy|red|acc|sumf|d0|yb|vl32|ib|nb)\b|x\[|\*s|->|\[c\])")


# ---- repack animations (layouts 2 and 3): 64 rows at once, one row followed --

def reference_rows(tr):
    """out[j] = sum_l dx[l][j] * sum_k dy[4l+k] * sum_c (bit ? code : -code), from the sample data"""
    out = []
    for j in range(64):
        total = 0.0
        for l, xb in enumerate(tr["x"]):
            facc = 0.0
            for k in range(4):
                yb = tr["y"][4 * l + k]
                bits = xb["bits"][j][32 * k:32 * k + 32]
                facc += yb["d"] * sum(q if b else -q for q, b in zip(yb["qs"], bits))
            total += xb["d"][j] * facc
        out.append(total)
    return out


def final_state(tr):
    st = {}
    for s in tr["steps"]:
        st.update(s["set"])
    return st


@pytest.mark.parametrize("layout", ["rvv", "vd4"])
def test_repack_animation_trace_matches_the_dot_product_for_every_row(layout):
    tr = bp.repack_trace(layout)
    st = final_state(tr)
    assert len(st["out"]) == 64
    assert st["out"] == pytest.approx(reference_rows(tr))


