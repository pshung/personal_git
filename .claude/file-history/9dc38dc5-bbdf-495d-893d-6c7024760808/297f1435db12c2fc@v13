@pytest.mark.parametrize("layout,per_group,lines", [
    ("rvv", 12, {5, 8, 9, 10, 11, 12, 13, 14, 16, 19, 21}),
    ("vd4", 8, {5, 10, 11, 12, 13, 14, 18, 19, 21, 24, 26}),
])
def test_repack_animation_steps_follow_the_kernel_loops(layout, per_group, lines):
    tr = bp.repack_trace(layout)
    nb = tr["nb"]
    assert nb == 2
    assert len(tr["steps"]) == nb * (1 + 4 * per_group + 1) + 1
    assert {s["line"] for s in tr["steps"]} == lines
    assert sum(s["name"] == "facc" for s in tr["steps"]) == 4 * nb     # x activation scale, once per group
    assert sum(s["name"] == "sumf" for s in tr["steps"]) == nb         # x weight scale, once per block
    assert tr["steps"][-1]["name"] == "store"
    for s in tr["steps"]:
        assert len(s["state"].split()) >= 3
        assert s.get("tpl") or s.get("tpls")


def test_rvv_animation_column_steps_are_the_masked_add_subtract():
    tr = bp.repack_trace("rvv")
    st = {}
    for s in tr["steps"]:
        prev = dict(st)
        st.update(s["set"])
        if s["name"] == "vsub":
            assert st["sumi"] == [p - st["yc"] for p in prev["sumi"]]
        if s["name"] == "vadd":
            assert st["sumi"] == [p + (2 * st["yc"] if b else 0) for p, b in zip(prev["sumi"], st["sign"])]
        if s["name"] == "facc":
            assert st["facc"] == pytest.approx([p + st["dy"] * q for p, q in zip(prev["facc"], st["sumi"])])
        if s["name"] == "sumf":
            assert st["sumf"] == pytest.approx([p + d * f for p, d, f in zip(prev["sumf"], st["dx"], st["facc"])])


def test_vd4_animation_dot_step_is_four_products_per_row():
    tr = bp.repack_trace("vd4")
    st = {}
    for s in tr["steps"]:
        prev = dict(st)
        st.update(s["set"])
        if s["name"] == "dot":
            quad = st["quadv"]
            assert len(st["w0"]) == 256 and set(st["w0"]) <= {-1, 1} and len(quad) == 4
            for j in range(64):
                assert st["dot"][j] == sum(st["w0"][4 * j + r] * quad[r] for r in range(4))
                assert st["acc"][j] == prev["acc"][j] + st["dot"][j]
        if s["name"] == "facc":
            assert st["facc"] == pytest.approx([p + st["dy"] * a for p, a in zip(prev["facc"], st["acc"])])


