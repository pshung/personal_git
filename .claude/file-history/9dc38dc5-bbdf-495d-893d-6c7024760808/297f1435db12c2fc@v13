# ---- step ladders: figure + instruction, names must match ------------------

STEP = re.compile(r'<li class="step" data-layout="(\w+)" data-step="(\d+)">(.*?)</li>', re.S)


def steps(page):
    out = []
    for m in STEP.finditer(page):
        body = m.group(3)
        code = html.unescape(re.search(r"<code[^>]*>(.*?)</code>", body, re.S).group(1))
        names = [html.unescape(t) for t in re.findall(r'<text [^>]*data-role="var"[^>]*>([^<]*)</text>', body)]
        note = re.search(r'<p class="note">(.*?)</p>', body, re.S)
        out.append((m.group(1), int(m.group(2)), code, names, note.group(1) if note else ""))
    return out


def calls(code):
    """every __riscv_*( ... ) call with balanced parentheses"""
    out = []
    for m in re.finditer(r"__riscv_\w+\(", code):
        depth = 0
        for k in range(m.end() - 1, len(code)):
            if code[k] == "(":
                depth += 1
            elif code[k] == ")":
                depth -= 1
                if depth == 0:
                    out.append(code[m.start():k + 1])
                    break
    return out


def norm(s):
    return re.sub(r"\s+", " ", s)


def test_each_layout_has_a_numbered_step_ladder(page):
