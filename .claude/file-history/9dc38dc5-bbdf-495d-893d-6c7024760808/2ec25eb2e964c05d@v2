#!/usr/bin/env python3
"""Render every <svg id=...> of the built page to PNG (light theme) for one visual check."""
import re
import subprocess
from pathlib import Path

import build_page as bp

LIGHT = {
    "--paper": "#F6F7F9", "--track": "#E9EDF1", "--ink": "#1F2A3A", "--muted": "#5B6979", "--line": "#D4DAE2",
    "--up": "#7E8C9E", "--up-lt": "#CBD3DC", "--rvv": "#2B6CB0", "--rvv-lt": "#B9D2EE",
    "--vd4": "#C2611A", "--vd4-lt": "#F1CBA8", "--scale": "#1E8577", "--scale-lt": "#B6E1D9",
    "--act": "#6B4FBB", "--act-lt": "#D9D0F1", "--m0": "#5A3FA8", "--m1": "#8069C9", "--m2": "#A896DE", "--m3": "#CFC4EF",
    "--on-mark": "#FFFFFF",
}

out = Path(__file__).with_name("png")
out.mkdir(exist_ok=True)
page = bp.build_html()
for m in re.finditer(r'<svg id="([^"]+)"(.*?)</svg>', page, re.S):
    fid, body = m.group(1), m.group(2)
    s = f'<svg xmlns="http://www.w3.org/2000/svg" id="{fid}"{body}</svg>'
    for k, v in LIGHT.items():
        s = s.replace(f"var({k})", v)
    s = s.replace("currentColor", LIGHT["--ink"])
    s = s.replace("<defs>", '<style>text{font-family:"IBM Plex Mono","DejaVu Sans Mono",monospace}</style><defs>', 1)
    svg_path = out / f"{fid}.svg"
    svg_path.write_text(s)
    subprocess.run(["rsvg-convert", "-z", "1.6", "-b", LIGHT["--paper"], "-o", str(out / f"{fid}.png"), str(svg_path)], check=True)
    print(fid)
