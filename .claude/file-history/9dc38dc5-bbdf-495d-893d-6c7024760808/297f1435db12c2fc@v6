# ---- step ladders: figure + instruction, names must match ------------------

STEP = re.compile(r'<li class="step" data-layout="(\w+)" data-step="(\d+)">(.*?)</li>', re.S)


def steps(page):
    out = []
    for m in STEP.finditer(page):
        body = m.group(3)
        code = html.unescape(re.search(r"<code[^>]*>(.*?)</code>", body, re.S).group(1))
        names = [html.unescape(t) for t in re.findall(r'<text [^>]*data-role="var"[^>]*>([^<]*)</text>', body)]
        note = re.search(r'<p class="note">(.*?)</p>', body, re.S)
        out.append((m.group(1), int(m.group(2)), code, names, note.group(1) if note else ""))
    return out


def calls(code):
    """every __riscv_*( ... ) call with balanced parentheses"""
    out = []
    for m in re.finditer(r"__riscv_\w+\(", code):
        depth = 0
        for k in range(m.end() - 1, len(code)):
            if code[k] == "(":
                depth += 1
            elif code[k] == ")":
                depth -= 1
                if depth == 0:
                    out.append(code[m.start():k + 1])
                    break
    return out


def norm(s):
    return re.sub(r"\s+", " ", s)


def test_each_layout_has_a_numbered_step_ladder(page):
    by = {}
    for layout, n, code, names, note in steps(page):
        by.setdefault(layout, []).append(n)
    assert set(by) == {"upstream", "rvv", "vd4"}
    for layout, ns in by.items():
        assert ns == list(range(len(ns))), (layout, ns)
        assert len(ns) >= 7, (layout, len(ns))


def test_every_step_draws_at_least_one_named_variable_and_has_a_note(page):
    for layout, n, code, names, note in steps(page):
        assert names, (layout, n)
        assert len(note.split()) >= 4, (layout, n, note)


def test_drawn_variable_names_appear_in_that_steps_code(page):
    for layout, n, code, names, note in steps(page):
        for name in names:
            assert norm(name) in norm(code), (layout, n, name)


def test_step_intrinsics_are_verbatim_from_the_kernels(page):
    src = {k: norm(v) for k, v in bp.kernel_sources().items()}
    seen = 0
    for layout, n, code, names, note in steps(page):
        for c in calls(code):
            assert norm(c) in src[layout], (layout, n, c)
            seen += 1
    assert seen >= 20


def test_vd4_asm_lines_are_the_ones_in_the_asm_helper(page):
    asm = bp.kernel_sources()["vd4"]
    lines = [l.strip() for layout, n, code, names, note in steps(page) if layout == "vd4"
             for l in code.splitlines() if l.strip().startswith(("vsetvli", "vmv.v.x", "nds.vd4dots.vv"))]
    assert lines
    for l in lines:
        mnemonic = l.split()[0]
        assert mnemonic in asm, l
        if mnemonic == "vsetvli":
            assert "vsetvli t0, zero, e32, m2, ta, ma" in asm


def test_upstream_rvv_vd4_ladders_end_by_storing_the_result(page):
    last = {}
    for layout, n, code, names, note in steps(page):
        last[layout] = code
    assert "*s = sumf" in last["upstream"]
    assert "__riscv_vse32_v_f32m2(s + (size_t) x * 64, sumf, vl)" in last["rvv"]
    assert "__riscv_vse32_v_f32m2(s + (size_t) x * 64, sumf, vl32)" in last["vd4"]


# ---- upstream animation: every arithmetic step, both scales ---------------

def reference_dot(tr):
    total = 0.0
    for ib, xb in enumerate(tr["x"]):
        acc = 0.0
        for k in range(4):
            yb = tr["y"][4 * ib + k]
            bits = xb["bits"][32 * k:32 * k + 32]
            acc += yb["d"] * sum(q if b else -q for q, b in zip(yb["qs"], bits))
        total += xb["d"] * acc
    return total


def test_upstream_animation_trace_matches_the_dot_product():
    tr = bp.upstream_trace()
    last = tr["steps"][-1]
    assert last["name"] == "store"
    assert last["sumf"] == pytest.approx(reference_dot(tr))
    assert last["s_text"] == last["sumf_text"]


def test_upstream_animation_steps_follow_the_kernel_loops():
    tr = bp.upstream_trace()
    nb = tr["nb"]
    assert nb >= 2, "two blocks are needed to show the weight scale applied per block"
    assert len(tr["steps"]) == nb * (1 + 4 * 7 + 1) + 1   # block, 4 groups x 7, sumf; then store
    assert {s["line"] for s in tr["steps"]} == {1, 4, 5, 6, 7, 8, 9, 10, 12, 14}
    assert sum(s["line"] == 10 for s in tr["steps"]) == 4 * nb    # x yb->d, once per 32-K group
    assert sum(s["line"] == 12 for s in tr["steps"]) == nb        # x d0, once per 128-K block
    for s in tr["steps"]:
        assert s["hot"] in ("xd", "yb", "mask", "qy", "neg", "sy", "red", "acc", "sumf", "store")
        assert len(s["mask"]) == len(s["qy"]) == len(s["neg"]) == len(s["sy"]) == 32
        assert len(s["text"].split()) >= 3


def test_upstream_animation_arithmetic_is_shown_step_by_step():
    tr = bp.upstream_trace()
    for s in tr["steps"]:
        if s["name"] == "sy":
            assert all(v == (q if m else -q) for v, q, m in zip(s["sy"], s["qy"], s["mask"]))
        if s["name"] == "red":
            assert s["red"] == sum(s["sy"])
        if s["name"] == "acc":
            assert "×" in s["text"] and s["dy_text"] in s["text"] and s["red_text"] in s["text"]
        if s["name"] == "sumf":
            assert "×" in s["text"] and s["d0_text"] in s["text"]


def test_upstream_animation_code_lines_are_verbatim_from_the_kernel():
    src = norm(bp.kernel_sources()["upstream"])
    lines = bp.upstream_trace()["lines"]
    assert len(lines) == 15
    for line in lines:
        assert norm(line.strip()) in src, line
        for c in calls(line):
            assert norm(c) in src, c


def test_upstream_animation_is_on_the_page_and_readable_at_rest(page):
    assert 'id="anim-upstream"' in page and 'id="an-data"' in page and 'id="an-code"' in page
    assert "prefers-reduced-motion" in page
    last = bp.upstream_trace()["steps"][-1]
    m = re.search(r'<text [^>]*id="an-sumf"[^>]*>([^<]*)</text>', page)
    assert m and m.group(1) == last["sumf_text"]
    for i in range(32):
        assert f'id="an-st{i}"' in page
    for b in ("an-play", "an-prev", "an-next", "an-reset", "an-speed"):
        assert f'id="{b}"' in page
