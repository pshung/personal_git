STRUCTS_W = """// ---- weights: Q1_0 ------------------------------------------------------------
typedef struct {            // block_q1_0 · 18 B · upstream: one row, 128 K
    ggml_half d;            // bytes 0..1       scale, fp16
    uint8_t   qs[16];       // bytes 2..17      parameters: 128 sign bits, bit c at qs[c / 8] bit (c % 8)
