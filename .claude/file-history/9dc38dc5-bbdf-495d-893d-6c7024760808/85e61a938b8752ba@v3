    body.append(T(x0, y1 + hh + 52, "the standard RVV gemm reads qs[c·4 + m] as scalars and needs no copy", 11, fill=MUTED))
    body.append(T(x0, y2 - 22, "VD4DOT gemm de-interleaves once per row tile: vle32.v (32 × u32) → vnsrl.wx 0 / 16 → vnsrl.wx 0 / 8 → vse8.v × 4", 12, weight="bold"))
    rowh = 14
    for m in range(4):
        y = y2 + m * (rowh + 3)
        body.append(T(x0, y + 11, f"aq[{m}·n + ..]", 10, anchor="start", fill=MUTED))
        for q in range(QK8 // 4):
            body.append(R(x0 + 90 + q * 4 * p, y, 4 * p - 0.5, rowh, ACT_ROW[m]))
        body.append(T(x0 + 90 + QK8 * p + 8, y + 11, f"row {m}: 32 contiguous codes = 8 aligned quads → a{m}[c / 4]", 10, fill=MUTED))
    y_end = y2 + 4 * (rowh + 3) + 20
    body.append(T(x0, y_end, "one weight vector w then feeds four dots: nds.vd4dots.vv acc0..acc3, w, splat(a0..a3[c/4]) → the weight stream is read once for 4 output rows", 11))
