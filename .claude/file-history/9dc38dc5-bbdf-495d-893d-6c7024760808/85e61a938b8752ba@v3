typedef struct {            // block_q8_0 · 34 B · gemv (decode): one row, 32 K
    ggml_half d;            // bytes 0..1       scale, fp16
    int8_t    qs[32];       // bytes 2..33      parameters: int8 codes, qs[c] = K 32g + c
} block_q8_0;

struct block_q8_0x4 {       // 136 B · gemm (prefill): 4 rows, 32 K   (repack.h: using block_q8_0x4 = block<8, 4>)
    ggml_half d[4];         // bytes 0..7       scales, d[m] = scale of activation row m
    int8_t    qs[128];      // bytes 8..135     parameters, interleaved: qs[c * 4 + m] = row m, K c
};

// VD4DOT only: aligned copy of the parameters, made once per call (the scales stay in the blocks above)
int8_t   aq[n];             // gemv: aq[32 * g + c]  = block g, code c     32 B per group, 4-byte aligned
int8_t   aq[4 * n];         // gemm: aq[m * n + K]   = row m, code K       rows de-interleaved
