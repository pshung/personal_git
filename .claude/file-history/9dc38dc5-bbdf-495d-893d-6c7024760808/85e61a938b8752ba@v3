        off = g * BLOCK_Q8 + 2
        body.append(T(x + 2 * p + QK8 * p / 2, y1 + 14, f"qs at byte {off} · {off} mod 4 = {off % 4}", 10, anchor="middle", fill="var(--on-mark)"))
    for b in range(0, 4 * BLOCK_Q8 + 1, 4):
        x = x0 + b * p
        body.append(L(x, y1 - 6, x, y1, stroke=MUTED, width=0.6))
    body.append(T(x0, y1 - 9, "4-byte address grid", 9, fill=MUTED))
    body.append(R(x0 + 2 * p, y1, 4 * p, hh, "none", stroke=INK, stroke_width=2))
    body.append(T(x0 + 2 * p, y1 + hh + 14, "first quad a[0..3] sits at bytes 2..5: it crosses a 4-byte boundary. Groups 0 and 2 are 2 mod 4, groups 1 and 3 are 0 mod 4.", 11))
    body.append(T(x0, y2 - 22, "Aligned copy made once per call: vle8.v / vse8.v, 32 B per group · every quad is 4-byte aligned · scales stay in the stream", 12, weight="bold"))
