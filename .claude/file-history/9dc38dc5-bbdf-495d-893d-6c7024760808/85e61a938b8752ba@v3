    return svg("fig-act-gemm", W, y_end + 36, ("", "".join(body)),
               "The gemm activation block interleaves four rows byte by byte; the VD4DOT gemm peels them apart once with narrowing "
               "shifts so each row's 32 codes are contiguous and form aligned 4-byte quads.")


