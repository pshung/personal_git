def fig_upstream_anim():
    tr = upstream_trace()
    last = tr["steps"][-1]
    LX, P = 112, 14.5
    up, up_lt = COL["upstream"], COL_LT["upstream"]
    om = "var(--on-mark)"
    AR = f'class="an-ar" fill="none" stroke="{LINE}" stroke-width="1.4" marker-end="url(#arrow)"'
    b = []
    b.append(T(0, 12, last["state"], 11, weight="bold", id="an-state"))
    b.append(T(0, 27, last["text"], 10, fill=MUTED, id="an-formula"))
    # memory: the weight block and the activation group in use
    b.append('<g id="an-row-xd" class="an-row">'
             + T(LX, 38, f"weights, block {last['ib']}", 11, weight="bold", id="an-xlabel")
             + R(LX, 42, 56, 20, SCALE)
             + T(LX + 28, 56, "scale " + last["d0_text"], 9, anchor="middle", fill=om, id="an-xd") + "</g>")
    for k in range(4):
        b.append(R(174 + 52 * k, 42, 50, 20, up, id=f"an-xg{k}", **{"class": "an-g" + (" an-on" if k == last["k"] else "")}))
        b.append(T(174 + 52 * k + 25, 56, f"group {k}", 9, anchor="middle", fill=om))
    b.append('<g id="an-row-yb" class="an-row">'
             + T(394, 38, f"activations, group {last['k']}", 11, weight="bold", id="an-ylabel")
             + R(394, 42, 56, 20, SCALE)
             + T(422, 56, "scale " + last["dy_text"], 9, anchor="middle", fill=om, id="an-yd")
             + R(456, 42, 114, 20, ACT) + T(513, 56, "32 codes", 9, anchor="middle", fill=om) + "</g>")
    gx = tr["gx"][last["k"]]
    b.append(f'<path id="an-ar-mask" {AR} d="M{gx},62 L{gx},82"/>')
    b.append(f'<path id="an-ar-qy" {AR} d="M570,52 L586,52 L586,128 L{LX + 32 * P + 4:g},128"/>')

    def row(y, rid, label, tp, rp, values, colors, h=16):
        out = [f'<g id="an-row-{rid}" class="an-row">', T(LX - 6, y + h - 4, label, 11, anchor="end", weight="bold")]
        for c in range(32):
            out.append(R(LX + c * P, y, P - 1, h, colors[c], id=f"an-{rp}{c}"))
            out.append(T(LX + c * P + (P - 1) / 2, y + h - 5, str(values[c]), 8, anchor="middle", fill=om, id=f"an-{tp}{c}"))
        out.append("</g>")
        return "".join(out)

    m = last["mask"]
    mid = LX + 16 * P
    b.append(row(84, "mask", "sign mask", "mt", "m", m, [up if v == 1 else up_lt for v in m], h=14))
    b.append(row(120, "qy", "activation codes", "qt", "q", last["qy"], [ACT] * 32))
    b.append(f'<path id="an-ar-neg" {AR} d="M{mid:g},136 L{mid:g},152"/>')
    b.append(row(154, "neg", "negated codes", "nt", "n", last["neg"], [ACT_LT] * 32))
    b.append(f'<path id="an-ar-sy" {AR} d="M{mid:g},170 L{mid:g},186"/>')
    b.append(row(188, "sy", "signed values", "st", "s", last["sy"], [ACT if v == 1 else ACT_LT for v in m]))
    # the horizontal reduction
    b.append(f'<path id="an-ar-red" class="an-ar an-funnel" fill="{up_lt}" fill-opacity="0.6" stroke="none" '
             f'd="M{LX},204 L{LX + 32 * P:g},204 L{LX + 40},232 L{LX},232 Z"/>')
    b.append('<g id="an-row-red" class="an-row">'
             + T(LX - 6, 244, "group sum", 11, anchor="end", weight="bold")
             + R(LX, 232, 40, 16, up) + T(LX + 20, 243, last["red_text"], 9, anchor="middle", fill=om, id="an-red")
             + T(LX + 48, 243, "= all 32 signed values added together (one horizontal reduction)", 10, fill=MUTED) + "</g>")
    # scale 1
    b.append(f'<path id="an-ar-acc" {AR} d="M{LX + 20},248 L{LX + 20},270"/>')
    b.append('<g id="an-row-acc" class="an-row">'
             + T(LX, 268, "group sum", 9, fill=MUTED) + R(LX, 272, 64, 18, TRACK, stroke=INK, stroke_width=1)
             + T(LX + 32, 285, last["red_text"], 10, anchor="middle", id="an-red2")
             + T(LX + 73, 286, "×", 12, anchor="middle")
             + T(LX + 82, 268, "activation scale", 9, fill=MUTED) + R(LX + 82, 272, 64, 18, SCALE)
             + T(LX + 114, 285, last["dy_text"], 10, anchor="middle", fill=om, id="an-dy")
             + right(LX + 152, 281, LX + 196, "+=", below=True)
             + T(LX + 196, 268, "block sum", 9, fill=MUTED) + R(LX + 196, 272, 72, 18, TRACK, stroke=INK, stroke_width=1)
             + T(LX + 232, 285, last["acc_text"], 10, anchor="middle", id="an-acc")
             + T(LX + 280, 285, "scale 1: once per 32-K group", 10, fill=MUTED) + "</g>")
    # scale 2
    b.append(f'<path id="an-ar-sumf" {AR} d="M{LX + 232},292 L{LX + 232},306 L{LX + 36},306 L{LX + 36},320"/>')
    b.append('<g id="an-row-sumf" class="an-row">'
             + T(LX, 318, "block sum", 9, fill=MUTED) + R(LX, 322, 72, 18, TRACK, stroke=INK, stroke_width=1)
             + T(LX + 36, 335, last["acc_text"], 10, anchor="middle", id="an-acc2")
             + T(LX + 81, 336, "×", 12, anchor="middle")
             + T(LX + 90, 318, "weight scale", 9, fill=MUTED) + R(LX + 90, 322, 64, 18, SCALE)
             + T(LX + 122, 335, last["d0_text"], 10, anchor="middle", fill=om, id="an-d0")
             + right(LX + 160, 331, LX + 204, "+=", below=True)
             + T(LX + 204, 318, "row total", 9, fill=MUTED) + R(LX + 204, 322, 72, 18, TRACK, stroke=INK, stroke_width=1)
             + T(LX + 240, 335, last["sumf_text"], 10, anchor="middle", id="an-sumf")
             + T(LX + 288, 335, "scale 2: once per 128-K block", 10, fill=MUTED) + "</g>")
    # store
    b.append(f'<path id="an-ar-store" {AR} d="M{LX + 240},342 L{LX + 240},362"/>')
    b.append('<g id="an-row-store" class="an-row">'
             + T(LX + 204, 368, "output", 9, fill=MUTED) + R(LX + 204, 372, 72, 18, up)
             + T(LX + 240, 385, last["s_text"], 10, anchor="middle", fill=om, id="an-s")
             + T(LX + 288, 385, "one value for this output row", 10, fill=MUTED) + "</g>")
    b.append(legend(0, 406, [(SCALE, "scale: fp16 d"), (up, "weight parameters: sign bits"), (ACT, "activation parameters: int8 codes")]))
    picture = svg("svg-anim-upstream", 580, 414, ("", "".join(b)),
                  "Animated: one output row through the upstream kernel, block by block and group by group: sign mask, codes, "
                  "negated codes, signed values, group sum, times the activation scale into the block sum, times the weight "
                  "scale into the row total, then the output.")
    code = "".join(f'<span class="ln{" active" if i == last["line"] else ""}" data-line="{i}">{esc(l)}</span>' for i, l in enumerate(tr["lines"]))
    payload = json.dumps(tr, separators=(",", ":")).replace("</", "<\\/")
    controls = ('<div class="an-controls"><button id="an-play" type="button">▶ Play</button>'
                '<button id="an-prev" type="button">◀ Step</button><button id="an-next" type="button">Step ▶</button>'
                '<button id="an-reset" type="button">Reset</button>'
                '<label>speed <select id="an-speed"><option value="0.5">0.5×</option><option value="1" selected>1×</option>'
                '<option value="2">2×</option></select></label>'
                f'<span class="an-pos" id="an-pos">{len(tr["steps"])} / {len(tr["steps"])}</span></div>')
    caption = (f"All arithmetic of the upstream kernel for one output row of {tr['nb']} × 128 K, on sample data. "
               "Press Play, or step with the buttons; the active kernel line is highlighted on the left, and grey rows still "
               "hold the previous group. Scale 1 (activation scale) is applied after every 32-K group, scale 2 (weight scale) "
               "after every 128-K block. Plain names in the picture, kernel names in the code: sign mask = is_not_zero, "
               "activation codes = qy, negated codes = neg_qy, signed values = sy, group sum = red[0], block sum = acc, "
               "row total = sumf, weight scale = d0 = x[ib].d, activation scale = yb->d.")
    return (f'<figure id="anim-upstream" class="animfig">{controls}<div class="anim">'
            f'<pre id="an-code"><code>{code}</code></pre><div class="stepfig">{picture}</div></div>'
            f'<figcaption>{caption}</figcaption>'
            f'<script type="application/json" id="an-data">{payload}</script><script>{ANIM_JS}</script></figure>')


