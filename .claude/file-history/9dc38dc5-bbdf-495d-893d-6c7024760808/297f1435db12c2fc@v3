def test_struct_listing_is_visible_with_types_and_byte_offsets(page):
    sec = re.search(r'<section id="structs">(.*?)</section>', page, re.S)
    assert sec, "no structs section"
    visible = re.sub(r"<details.*?</details>", "", sec.group(1), flags=re.S)
    pres = re.findall(r"<pre>.*?</pre>", visible, re.S)
    assert pres, "struct listing must be visible, not behind <details>"
    text = html.unescape(" ".join(pres))
    for needle in ("ggml_half d;", "uint8_t   qs[16];", "ggml_half d[64];", "uint8_t   qs[128][8];",
                   "int8_t    qs[32];", "ggml_half d[4];", "int8_t    qs[128];",
                   "18 B", "1152 B", "34 B", "136 B", "bytes 2..17", "bytes 128..1151", "bytes 8..135"):
        assert needle in text, needle
