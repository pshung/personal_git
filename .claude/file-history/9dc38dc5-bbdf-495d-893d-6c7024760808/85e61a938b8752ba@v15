    dyc = [0.1, 0.2, 0.25, 0.5, 0.1, 0.2, 0.25, 0.5]
    x = [{"d": [rnd.choice(dxc) for _ in range(64)],
          "bits": [[rnd.randint(0, 1) for _ in range(QK1)] for _ in range(64)]} for _ in range(nb)]
    y = [{"d": dyc[g % len(dyc)], "qs": [rnd.randint(-4, 4) for _ in range(QK8)]} for g in range(4 * nb)]
    return x, y


def repack_trace(layout, nb=2):
    x, y = repack_data(nb)
    steps = []

    def emit(name, line, hot, stale, state, tpl=None, tpls=None, tplby=None, **setv):
        d = dict(name=name, line=line, hot=hot, stale=list(stale), state=state, set=setv)
        if tpl:
            d["tpl"] = tpl
        if tpls:
            d["tpls"], d["tplby"] = tpls, tplby
        steps.append(d)

    sumf = [0.0] * 64
    if layout == "rvv":
        for l in range(nb):
            dx = x[l]["d"]
            facc = [0.0] * 64
            emit("dx", 5, "dx", ["sign", "sumi"], f"block {l} · load the 64 weight scales, reset the 64 block sums",
                 tpl="row {j}: weight scale = {dx:2}, block sum = 0", l=l, dx=dx, facc=list(facc), sumf=list(sumf))
            for k in range(4):
                g = 4 * l + k
                codes, dy = y[g]["qs"], y[g]["d"]
                pre = f"block {l} · group {k} · "
                emit("ab", 8, "yb", ["sign", "sumi"], pre + "next activation group: scale and 32 codes",
                     tpl="group {k}: activation scale = {dy:2}, 32 codes", k=k, g=g, dy=dy, codes=codes)
                sumi = [0] * 64
                emit("sumi0", 9, "sumi", ["sign"], pre + "reset the 64 partial sums",
                     tpl="row {j}: partial sum = 0", sumi=list(sumi))
                for c in range(QK8):
                    yc = codes[c]
                    col = 32 * k + c
                    sign = [x[l]["bits"][j][col] for j in range(64)]
                    detail = c < 2
                    if detail:
                        emit("yc", 11, "yb", ["sign"], pre + f"column {c}: read one code",
                             tpl="column {c}: code = {yc}, the same for all 64 rows",
                             c=c, yc=yc, colx=AN_PLANES_X + col * AN_COL_PX, codex=AN_CODES_X + c * 3.5)
                        emit("sign", 12, "sign", [], pre + f"column {c}: load the 64 sign bits",
                             tpl="row {j}: sign bit of column {c} = {sign}", sign=sign)
                    sumi = [v - yc for v in sumi]
                    if detail:
                        emit("vsub", 13, "sumi", [], pre + f"column {c}: every row minus the code",
                             tpl="row {j}: partial sum = {prev:sumi} − {yc} = {sumi}", sumi=list(sumi))
                    sumi = [v + (2 * yc if b else 0) for v, b in zip(sumi, sign)]
                    if detail:
                        emit("vadd", 14, "sumi", [], pre + f"column {c}: rows with sign 1 plus 2 × the code",
                             tpls={"1": "row {j}: sign 1 → {prev:sumi} + 2 × {yc} = {sumi}   (net: + code)",
                                   "0": "row {j}: sign 0 → unchanged, {sumi}   (net: − code)"},
                             tplby="sign", sumi=list(sumi))
                emit("ff", 10, "sumi", [], pre + "columns 2 .. 31 the same way",
                     tpl="row {j}: after all 32 columns the partial sum is {sumi}",
                     c=31, yc=codes[31], sign=sign, sumi=list(sumi),
                     colx=AN_PLANES_X + (32 * k + 31) * AN_COL_PX, codex=AN_CODES_X + 31 * 3.5)
                facc = [f + dy * v for f, v in zip(facc, sumi)]
                emit("facc", 16, "facc", [], pre + "× activation scale → block sums  (scale 1)",
                     tpl="row {j}: block sum = {prev:facc:2} + {dy:2} × {sumi} = {facc:2}", facc=list(facc))
            sumf = [s + d * f for s, d, f in zip(sumf, dx, facc)]
            emit("sumf", 19, "sumf", [], f"block {l} · × weight scales → row totals  (scale 2)",
                 tpl="row {j}: row total = {prev:sumf:2} + {dx:2} × {facc:2} = {sumf:2}", sumf=list(sumf))
        emit("store", 21, "out", [], "all blocks done · store the 64 outputs",
             tpl="row {j}: output = {out:2}", out=list(sumf))
        lines = RVV_LINES
    else:
        for l in range(nb):
            dx = x[l]["d"]
            facc = [0.0] * 64
            emit("dx", 5, "dx", ["w0", "dot", "acc"], f"block {l} · load the 64 weight scales, reset the 64 block sums",
                 tpl="row {j}: weight scale = {dx:2}, block sum = 0", l=l, dx=dx, facc=list(facc), sumf=list(sumf))
            for k in range(4):
                g = 4 * l + k
                codes, dy = y[g]["qs"], y[g]["d"]
                pre = f"block {l} · group {k} · "
                emit("aw", 10, "yb", ["w0", "dot", "acc"], pre + "next activation group: scale and 8 quads of 4 codes",
                     tpl="group {k}: activation scale = {dy:2}, 8 quads of 4 codes", k=k, g=g, dy=dy, codes=codes)
                acc = [0] * 64
                emit("acc0", 11, "acc", ["w0", "dot"], pre + "reset the 64 group sums",
                     tpl="row {j}: group sum = 0", acc=list(acc))
                for qi in range(8):
                    c0 = 4 * qi
                    w0 = [1 if x[l]["bits"][j][32 * k + c0 + r] else -1 for j in range(64) for r in range(4)]
                    quad = codes[c0:c0 + 4]
                    dot = [sum(w0[4 * j + r] * quad[r] for r in range(4)) for j in range(64)]
                    acc = [a + d for a, d in zip(acc, dot)]
                    mark = dict(qi=qi, c0=c0, c3=c0 + 3, planex=AN_PLANES_X + (8 * k + qi) * AN_PLANE_PX, quadx=AN_CODES_X + qi * 14,
                                quad=", ".join(str(v) for v in quad), quadv=quad)
                    if qi == 0:
                        emit("p", 13, "xd", ["w0", "dot"], pre + "pass 1 of 2: point at 4 planes = 16 columns",
                             tpl="planes for columns {c0} .. {c1} of this group", c1=15, **mark)
                        emit("w0", 14, "w0", ["dot"], pre + "plane 0 → 256 signs: 4 columns × 64 rows",
                             tpl="row {j}: signs of columns {c0} .. {c3} = {w0@4}", w0=w0)
                        emit("s0", 19, "s0", ["dot"], pre + "quad 0 → its 4 codes in every row")
                        steps[-1]["tpl"] = "quad {qi}: codes {quad} in every row"
                        emit("dot", 18, "acc", [], pre + "one dot instruction: 4 products per row, added to the group sum",
                             tpl="row {j}: ({w0@4}) · ({quad}) = {dot} → group sum {prev:acc} + {dot} = {acc}",
                             dot=dot, acc=list(acc))
                emit("ff", 12, "acc", [], pre + "the other 7 quads the same way (two passes of 4 planes)",
                     tpl="row {j}: after all 8 quads the group sum is {acc}", w0=w0, dot=dot, acc=list(acc), **mark)
                facc = [f + dy * a for f, a in zip(facc, acc)]
                emit("facc", 21, "facc", [], pre + "× activation scale → block sums  (scale 1)",
                     tpl="row {j}: block sum = {prev:facc:2} + {dy:2} × {acc} = {facc:2}", facc=list(facc))
            sumf = [s + d * f for s, d, f in zip(sumf, dx, facc)]
            emit("sumf", 24, "sumf", [], f"block {l} · × weight scales → row totals  (scale 2)",
                 tpl="row {j}: row total = {prev:sumf:2} + {dx:2} × {facc:2} = {sumf:2}", sumf=list(sumf))
        emit("store", 26, "out", [], "all blocks done · store the 64 outputs",
             tpl="row {j}: output = {out:2}", out=list(sumf))
        lines = VD4_LINES
    return dict(layout=layout, nb=nb, x=x, y=y, steps=steps, lines=[rename_code(layout, l) for l in lines], follow=AN_FOLLOW)


