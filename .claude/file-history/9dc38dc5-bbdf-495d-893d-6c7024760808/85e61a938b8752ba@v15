# ---- meaningful names for the kernel code shown on the page -------------------
# Applied to every code panel, ladder and picture label; the raw source stays in
# the details blocks. Each list is applied in order with identifier boundaries,
# and an identifier after a "." (a mnemonic like vmv.v.x) is never touched.
RENAMES = {
    "upstream": [("x", "weights"), ("y", "activations"), ("nb", "n_blocks"), ("ib", "block"), ("k", "group"),
                 ("d0", "weight_scale"), ("acc", "block_sum"), ("yb", "act_group"), ("is_not_zero", "sign_mask"),
                 ("qy", "codes"), ("neg_qy", "neg_codes"), ("sy", "signed_codes"), ("red", "group_sum"),
                 ("sumf", "row_total"), ("s", "out")],
    "rvv": [("bx", "weights"), ("a_ptr", "activations"), ("nc", "n_out"), ("nb", "n_blocks"), ("x", "tile"),
            ("l", "block"), ("k", "group"), ("c", "col"), ("ab", "act_group"), ("dx", "weight_scales"),
            ("facc", "block_sums"), ("sumi", "row_sums"), ("yc", "code"), ("sign", "sign_mask"),
            ("sumf", "row_totals"), ("s", "out")],
    "vd4": [("bx", "weights"), ("a_ptr", "activations"), ("aq", "codes_aligned"), ("aw", "quads"), ("nc", "n_out"),
            ("nb", "n_blocks"), ("ng", "n_groups"), ("x", "tile"), ("l", "block"), ("k", "group"), ("g", "abs_group"),
            ("q", "quad"), ("p", "plane"), ("dx", "weight_scales"), ("facc", "block_sums"), ("acc", "group_sums"),
            ("vneg1", "neg_ones"), ("w0", "signs0"), ("w1", "signs1"), ("w2", "signs2"), ("w3", "signs3"),
            ("s0", "bcast0"), ("s1", "bcast1"), ("u0", "word0"), ("u1", "word1"), ("u2", "word2"), ("u3", "word3"),
            ("sumf", "row_totals"), ("s", "out")],
}
PROSE_SKIP = {"sign", "nb", "nc", "ng", "ib"}
CODEISH = re.compile(r"[\[\]+]|->|QK|[A-Za-z]_[A-Za-z]")


def _ident(old):
    return re.compile(rf"(?<![\w.]){re.escape(old)}(?![\w])")


def rename_code(layout, text):
    """The kernel text with the meaningful names of RENAMES[layout]."""
    for old, new in RENAMES[layout]:
        text = _ident(old).sub(new, text)
    return text


def rename_prose(layout, text):
    """Only the unmistakable identifiers (no single letters, no English words) - for notes."""
    for old, new in RENAMES[layout]:
        if len(old) >= 2 and old not in PROSE_SKIP:
            text = _ident(old).sub(new, text)
    return text


def rename_svg(layout, markup):
    """Picture labels: code-like texts and variable labels get the full map, prose the safe map."""
    def sub(m):
        attrs, raw = m.group(1), html.unescape(m.group(2))
        full = 'data-role="var"' in attrs or CODEISH.search(raw)
        return f"<text {attrs}>{esc(rename_code(layout, raw) if full else rename_prose(layout, raw))}</text>"
    return re.sub(r"<text ([^>]*)>([^<]*)</text>", sub, markup)


def renamed_sources():
    return {k: rename_code(k, v) for k, v in kernel_sources().items()}


# ---- step ladders: one instruction, one picture, the same names ------------
RX, RW = 170, 512          # registers start at RX and are RW px wide in every step figure
REPACK = "ggml/src/ggml-cpu/arch/riscv/repack.cpp"


def kernel_sources():
    """The kernel text every step ladder is checked against."""
    return {
        "upstream": excerpt("ggml/src/ggml-cpu/arch/riscv/quants.c", "static NOINLINE void ggml_vec_dot_q1_0_q8_0_vl256("),
        "rvv": excerpt(REPACK, "static void q1_gemv_64x1_vl1024(") + "\n" + excerpt(REPACK, "static inline vfloat32m2_t q1_expand_fp16_64_m2("),
        "vd4": excerpt(REPACK, "static void q1_gemv_64_vd4dot_vl1024(") + "\n" + excerpt(REPACK, "static inline vint32m2_t q1_vd4dots_x4_m2("),
    }


def var(x, y, name, anchor="end", size=12):
    return T(x, y, name, size, anchor=anchor, weight="bold", data_role="var")


def reg(y, name, n, colors, h=14, note=None, named=True, size=12):
    """A register of n lanes, RW px wide. colors[i] is lane i's fill, None = idle."""
    pitch = RW / n
    gap = 0.6 if pitch >= 3 else 0
    out = [var(RX - 10, y + h - 3, name, size=size) if named else T(RX - 10, y + h - 3, name, 11, anchor="end", fill=MUTED)]
    out.append(R(RX, y, RW, h, TRACK))
    for i, c in enumerate(colors):
        if c:
            out.append(R(RX + i * pitch, y, max(pitch - gap, 0.5), h, c))
    if note:
        out.append(T(RX + RW + 10, y + h - 3, note, 10, fill=MUTED))
    return "".join(out)


def groups(y, n, every, h):
    """Thin separators every `every` lanes, e.g. the 4-lane rows of an e8/m2 dot operand."""
    pitch = RW / n
    return "".join(L(RX + i * pitch, y, RX + i * pitch, y + h, stroke=PAPER, width=0.8) for i in range(0, n + 1, every))


def ticks(y, n, marks):
    pitch = RW / n
    return "".join(T(RX + i * pitch + (pitch / 2 if len(t) <= 6 else 0), y, t, 9,
                     anchor="middle" if len(t) <= 6 else "start", fill=MUTED) for i, t in marks.items())


def mem(x, y, nbytes, px, fill, name, h=18, sub=None, named=True, below=False):
    out = [R(x, y, nbytes * px, h, fill)]
    ly = y + h + 12 if below else y - 5
    out.append(var(x, ly, name, anchor="start") if named else T(x, ly, name, 10, fill=MUTED))
    if sub:
        out.append(T(x + nbytes * px / 2, y + h - 5, sub, 9, anchor="middle", fill="var(--on-mark)"))
    return "".join(out)


def quad(x, y, name, px=8, below=False):
    """one 4-byte activation quad, the four codes in the four row tints"""
    return "".join(R(x + i * px, y, px - 0.5, 18, ACT_ROW[i]) for i in range(4)) + var(x, y + 30 if below else y - 5, name, anchor="start")


def box(x, y, name, w=90, h=20, sub=None):
    out = [R(x, y, w, h, TRACK, stroke=INK, stroke_width=1), var(x + w / 2, y + h - 6, name, anchor="middle")]
    if sub:
        out.append(T(x + w / 2, y + h + 12, sub, 9, anchor="middle", fill=MUTED))
    return "".join(out)


def right(x1, y, x2, label=None, below=False):
    s = L(x1, y, x2, y, arrow=True)
    if label:
        s += T((x1 + x2) / 2, y + 14 if below else y - 6, label, 10, anchor="middle", fill=MUTED)
    return s


def funnel(y1, y2, lanes_from, to_x, to_w, fill):
    x1, x2 = RX, RX + lanes_from
    return f'<polygon points="{x1:g},{y1:g} {x2:g},{y1:g} {to_x + to_w:g},{y2:g} {to_x:g},{y2:g}" fill="{fill}" fill-opacity="0.7"/>'


def steps_html(layout, steps):
    items = []
    for n, (code, (h, body, label), note) in enumerate(steps):
        fig = rename_svg(layout, svg(f"svg-{layout}-{n}", W, h, ("", body), rename_prose(layout, label)))
        items.append(f'<li class="step" data-layout="{layout}" data-step="{n}"><div class="body">'
                     f'{pre(rename_code(layout, code))}<div class="stepfig">{fig}</div>'
                     f'<p class="note">{rename_prose(layout, note)}</p></div></li>')
    return f'<ol class="steps">{"".join(items)}</ol>'


def steps_rvv():
