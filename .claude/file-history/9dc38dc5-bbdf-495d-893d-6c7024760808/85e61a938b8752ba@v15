def reindent(line):
    """4-space kernel indentation shown as 2 spaces, so the longest line fits beside the picture."""
    n = len(line) - len(line.lstrip(" "))
    return " " * (n // 2) + line.lstrip(" ")


def _py_fmt(v, dec=None):
    if v is None:
        return None
    if isinstance(v, bool):
        return str(int(v))
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        return f"{v:.{dec if dec is not None else 2}f}"
    return str(v)


def _py_fill(tpl, st, prev, j):
    """The resting-state twin of the JS fill(): same tokens, same formatting."""
    missing = [False]

    def one(m):
        tok = m.group(1)
        if tok == "j":
            return str(j)
        parts = tok.split(":")
        src = st
        if parts[0] == "prev":
            src = prev
            parts = parts[1:]
        key = parts[0]
        dec = int(parts[1]) if len(parts) > 1 else None
        if key.endswith("@4"):
            a = src.get(key[:-2])
            v = None if a is None else ", ".join(_py_fmt(a[4 * j + r]) for r in range(4))
        else:
            v = src.get(key)
            if isinstance(v, list):
                v = v[j]
            v = _py_fmt(v, dec)
        if v is None:
            missing[0] = True
            return ""
        return v
    out = re.sub(r"\{([^}]+)\}", one, tpl)
    return "" if missing[0] else out


