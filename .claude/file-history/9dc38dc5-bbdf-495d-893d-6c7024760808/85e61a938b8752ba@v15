    org, org_lt = COL["vd4"], COL_LT["vd4"]
    om = "var(--on-mark)"
    bits = [sample_bits(256, 3 + k) for k in range(4)]
    ex = helper_lane_example()
    SX, SW, BUS, BX, BW = 40, 448, 540, 592, 448      # signs bar, bus x, broadcast bar
    LPX = SW / 256
    rows = [110, 180, 250, 320]
    nums = {"vset": 1, "mv": [2, 3, 6, 7], "dot": [4, 5, 8, 9]}
    b = []

    def num(x, y, n):
        return (R(x - 7, y - 11, 14, 14, INK, rx=7)
                + T(x, y, str(n), 9, anchor="middle", weight="bold", fill=PAPER, **{"class": "step-no"}))

    def bar(x, y, key, fills, h=14, every=4):
        pitch = (SW if key.startswith("signs") or key.startswith("bcast") else SW) / len(fills)
        out = [R(x + i * pitch, y, pitch - 0.3, h, fills[i], data_role="lane", data_reg=key, data_busy="1") for i in range(len(fills))]
        if every:
            out += [L(x + i * pitch, y, x + i * pitch, y + h, stroke=PAPER, width=0.8) for i in range(0, len(fills) + 1, every)]
        return "".join(out)

    def acc(x, y, key):
        pitch = SW / 64
        return "".join(R(x + i * pitch, y, pitch - 0.6, 14, org, data_role="lane", data_reg=key, data_busy="1") for i in range(64))

    def arrow(points):
        return f'<polyline points="{points}" fill="none" stroke="{INK}" stroke-width="1.3" marker-end="url(#arrow)"/>'

    def node(x, y, glyph, w=34):
