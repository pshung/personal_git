HELPER_EXAMPLE = dict(signs=[1, -1, 1, 1], quad=[3, -2, 0, 4])


def helper_lane_example():
    """One lane of one dot: four sign x code products and their sum."""
    signs, quad = HELPER_EXAMPLE["signs"], HELPER_EXAMPLE["quad"]
    products = [a * b for a, b in zip(signs, quad)]
    return dict(signs=signs, quad=quad, products=products, sum=sum(products))


