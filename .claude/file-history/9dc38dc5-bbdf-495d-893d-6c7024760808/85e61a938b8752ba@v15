    # accumulator in, the bus of four dots, accumulator out
    ax = BUS - SW / 2
    b.append(num(ax + 7, 22, nums["vset"]) + T(ax + 18, 22, "vsetvli t0, zero, e32, m2, ta, ma", 10, fill=MUTED))
    b.append(T(ax + SW, 22, "group_sums in · 64 lanes × int32", 10, anchor="end", fill=MUTED))
    b.append(acc(ax, 28, "acc_in"))
    b.append(arrow(f"{BUS},42 {BUS},{rows[0] - 14}"))
    for k, y in enumerate(rows):
        b.append(T(SX, y - 12, f"signs{k} · 64 rows × 4 signs", 10, fill=MUTED))
        b.append(bar(SX, y - 7, f"signs{k}", [org if v else org_lt for v in bits[k]]))
        b.append(arrow(f"{SX + SW + 4},{y} {BUS - 19},{y}"))
        b.append(num(BX + 7, y - 12, nums["mv"][k]) + T(BX + 18, y - 12, f"vmv.v.x bcast{k % 2}, word{k}", 10, fill=MUTED))
        b.append(bar(BX, y - 7, f"bcast{k % 2}", [ACT_ROW[i % 4] for i in range(256)]))
        b.append(arrow(f"{BX - 4},{y} {BUS + 19},{y}"))
        b.append("".join(R(BX + BW + 24 + i * 14, y - 7, 13.4, 14, ACT_ROW[i], **({"data_role": "word"} if i == 0 else {})) for i in range(4)))
        b.append(T(BX + BW + 24, y - 12, f"word{k}", 10, fill=MUTED))
        b.append(arrow(f"{BX + BW + 22},{y} {BX + BW + 4},{y}"))
        b.append(node(BUS, y, "dot"))
        b.append(num(BUS - 150, y + 26, nums["dot"][k]) + T(BUS - 139, y + 26, f"nds.vd4dots.vv group_sums, signs{k}, bcast{k % 2}", 10, fill=MUTED))
        if k < 3:
            b.append(arrow(f"{BUS},{y + 13} {BUS},{rows[k + 1] - 14}"))
    b.append(arrow(f"{BUS},{rows[3] + 13} {BUS},392"))
    b.append(acc(ax, 394, "acc_out"))
    b.append(T(ax, 424, "group_sums out · every row advanced by 16 columns", 10, fill=MUTED))
    b.append(T(ax, 440, "bcast0 and bcast1 are the same two scratch registers, filled twice", 10, fill=MUTED))
    # one lane, inside dot 4
    zy = 452
    z = [R(SX, zy, 1120, 150, TRACK, rx=8)]
    z.append(T(SX + 16, zy + 22, f"inside one lane j (row j) of dot {nums['dot'][0]}, the same in all 64 lanes", 11, weight="bold"))
    cy = zy + 56

    def cells(x, vals, fills, label, textfill=INK):
        out = [T(x, cy - 8, label, 10, fill=MUTED)]
        for i, v in enumerate(vals):
            out.append(R(x + i * 38, cy, 36, 28, fills[i]))
            out.append(T(x + i * 38 + 18, cy + 19, v, 12, anchor="middle", weight="bold", fill=textfill))
        return "".join(out)
    fmt = lambda v: ("+" if v > 0 else "−" if v < 0 else "") + str(abs(v)) if v != 0 else "0"
    z.append(cells(SX + 16, [fmt(v) for v in ex["signs"]], [org if v > 0 else org_lt for v in ex["signs"]], "signs0, lanes 4j .. 4j+3", om))
    z.append(T(SX + 16 + 4 * 38 + 10, cy + 20, "×", 16, anchor="middle"))
    z.append(cells(SX + 16 + 4 * 38 + 30, [str(v) if v >= 0 else "−" + str(-v) for v in ex["quad"]], ACT_ROW, "bcast0, lanes 4j .. 4j+3", om))
    z.append(T(SX + 16 + 8 * 38 + 50, cy + 20, "=", 16, anchor="middle"))
    z.append(cells(SX + 16 + 8 * 38 + 70, [str(v) for v in ex["products"]], [TRACK] * 4, "4 products"))
    z.append(T(SX + 16 + 12 * 38 + 96, cy + 20, "Σ", 16, anchor="middle"))
    z.append(R(SX + 16 + 12 * 38 + 114, cy, 44, 28, org) + T(SX + 16 + 12 * 38 + 136, cy + 19, str(ex["sum"]), 12, anchor="middle", weight="bold", fill=om))
    z.append(arrow(f"{SX + 16 + 12 * 38 + 164},{cy + 14} {SX + 16 + 12 * 38 + 196},{cy + 14}"))
    z.append(T(SX + 16 + 12 * 38 + 202, cy + 19, f"group_sums[j] += {ex['sum']}", 12, weight="bold"))
    z.append(T(SX + 16, zy + 128, "int8 × int8 products, summed into one int32 lane; the 4 columns of this quad for row j", 10, fill=MUTED))
    b.append(f'<g data-role="lane-zoom">{"".join(z)}</g>')
    b.append(T(1160, zy + 128, "e8 view: 256 lanes · e32 view: 64 lanes", 10, anchor="end", fill=MUTED))
    picture = svg("svg-vd4-helper", 1200, 612, ("", "".join(b)),
                  "Inside q1_vd4dots_x4_m2: one vsetvli, then four broadcasts and four dots in the numbered order; the two "
                  "scratch registers are filled, used by two dots, refilled and used again; below, one lane of one dot: four "
                  "sign times code products summed into the row's int32 accumulator.")
    caption = ("Inside q1_vd4dots_x4_m2. One call is one vsetvli, four broadcasts and four dots, in the numbered order ① to ⑨. "
               "bcast0 and bcast1 are two scratch registers: filled with word0 and word1, used by dots ④ and ⑤, refilled with "
               "word2 and word3, used by dots ⑧ and ⑨. All 32-bit work sits in one asm block, so one vsetvli covers the four dots, "
               "and each broadcast is vmv.v.x from a scalar register. Bottom: inside one lane, the four sign × code products are "
               "summed and added into group_sums[j]; every lane does the same in the same instruction.")
    return f'<figure id="fig-vd4-helper" class="animfig"><div class="stepfig">{picture}</div><figcaption>{caption}</figcaption></figure>'


