def fig_upstream_flow():
    p = PX_FLOW
    body = []
    y_mem, hh = 36, 20
    # memory
    body.append(T(0, 10, "memory", 11, fill=MUTED, weight="bold"))
    body.append(R(0, y_mem, 2 * p, hh, SCALE)); body.append(T(p, y_mem + 14, "d", 10, anchor="middle", fill="var(--on-mark)"))
    body.append(R(2 * p, y_mem, 16 * p, hh, COL["upstream"]))
    body.append(T(2 * p + 8 * p, y_mem + 14, "block_q1_0.qs · 16 B", 10, anchor="middle", fill="var(--on-mark)"))
    body.append(R(2 * p, y_mem, 4 * p, hh, "none", stroke=INK, stroke_width=2))
    body.append(T(2 * p, y_mem - 6, "qs[4k .. 4k+3] · 4 B", 11))
    xa = 300
    body.append(R(xa, y_mem, 2 * p, hh, SCALE)); body.append(T(xa + p, y_mem + 14, "d", 10, anchor="middle", fill="var(--on-mark)"))
    body.append(R(xa + 2 * p, y_mem, QK8 * p, hh, ACT))
    body.append(T(xa + 2 * p + QK8 * p / 2, y_mem + 14, "block_q8_0.qs · 32 B = a[32k .. 32k+31]", 10, anchor="middle", fill="var(--on-mark)"))
    body.append(T(xa, y_mem - 6, "one Q8_0 group of row y", 11))
    # registers
    y_reg = 100
    body.append(down(2 * p + 16, y_mem + hh, y_reg, "vlm.v: 4 B → 32 mask bits"))
    mask_x, lane = 0, 4
    bits = sample_bits(32, 1)
    body.append(lanes(mask_x, y_reg, 32, lane, 14, [COL["upstream"] if b else COL_LT["upstream"] for b in bits]))
    body.append(T(0, y_reg + 26, "is_not_zero: 32 sign bits", 11))
    vx = xa + 2 * p
    body.append(down(vx + 40, y_mem + hh, y_reg, "vle8.v: 32 i8 into a 128-lane register"))
    body.append(R(vx, y_reg, VLENB * lane, 14, TRACK))
    body.append(lanes(vx, y_reg, 32, lane, 14, [ACT] * 32))
    body.append(T(vx + 32 * lane + 6, y_reg + 11, "lanes 32 .. 127 idle", 10, fill=MUTED))
    body.append(T(vx, y_reg + 26, "qy: 32 of 128 lanes", 11))
    # select
    y_sel = 156
    body.append(down(vx + 40, y_reg + 30, y_sel, "vneg.v → neg_qy, then vmerge.vvm with is_not_zero: sy[c] = bit ? qy[c] : neg_qy[c]"))
    body.append(L(mask_x + 64, y_reg + 30, vx + 30, y_sel - 2, stroke=COL["upstream"], width=1, dash="4 3", arrow=True))
    body.append(R(vx, y_sel, VLENB * lane, 14, TRACK))
    body.append(lanes(vx, y_sel, 32, lane, 14, [ACT if b else ACT_LT for b in bits]))
    body.append(T(vx, y_sel + 26, "sy: 32 signed products, one row, 32 K", 11))
    # reduce
    y_red = 216
    body.append(f'<polygon points="{vx:g},{y_sel + 30:g} {vx + 32 * lane:g},{y_sel + 30:g} {vx + 68:g},{y_red:g} {vx + 60:g},{y_red:g}" fill="{COL_LT["upstream"]}"/>')
    body.append(R(vx + 60, y_red, 8, 14, COL["upstream"]))
    body.append(T(vx + 76, y_red + 11, "red = vwredsum.vs: 32 lanes → 1 i16 (horizontal reduction), vmv.x.s → scalar", 11))
    y_sc = y_red + 40
    body.append(T(vx, y_sc, "acc += yb->d · red[0]        (scalar float, once per 32 K)", 11))
    body.append(T(vx, y_sc + 18, "sumf += d0 · acc             (scalar float, once per 128 K)", 11))
    body.append(T(0, y_sc + 48, f"Repeat for every output row: 64 rows × 4 groups × 5 = {OPS_PER_SUBTILE['upstream']} vector instructions per 64 rows × 32 K, plus 64 reductions.", 11, weight="bold"))
    return svg("fig-up", W, y_sc + 60, ("", "".join(body)),
               "Upstream: a 4-byte mask load and a 32-byte activation load fill 32 of 128 lanes, a merge selects the sign, "
               "and a horizontal reduction collapses the 32 lanes to one scalar per row per 32 K.")


