#### HERO
def fig_hero():
    colw, gap = 288, 28
    cell = TILE_CELL
    tw, th = QK1 * cell, ROWS * cell          # 256 x 128: the parameter tile, one cell per sign bit
    band = 8 * cell                            # 64 x 16 scale bits = 8 rows of 128 bits
    y_title, y_top = 14, 26
    y_tile = y_top + band
    y_foot = y_tile + th + 16
    y_reg = y_foot + 12
    y_regl = y_reg + 28
    y_out = y_regl + 20
    y_bar = y_out + 14
    y_barl = y_bar + 28
    y_leg = y_barl + 24
    H = y_leg + 8
    g = 8 * cell
    defs = (f'<pattern id="grid8" width="{g:g}" height="{g:g}" patternUnits="userSpaceOnUse">'
            f'<path d="M {g:g} 0 L 0 0 0 {g:g}" fill="none" stroke="{LINE}" stroke-width="0.6"/></pattern>')
    body = []
    for i, v in enumerate(VARIANTS):
        x0 = i * (colw + gap)
        body.append(R(x0, y_title - 10, 10, 10, COL[v]))
        body.append(T(x0 + 16, y_title, NAME[v], 13, weight="bold"))
        body.append(T(x0 + colw, y_title, "9216 bits = 1152 B", 11, anchor="end", fill=MUTED))
        if v == "upstream":
            xt = x0 + 16 * cell
            body.append(T(x0, y_top + 11, "scale d_j: 16 bits in front of each row", 9, fill=MUTED))
            body.append(R(x0, y_tile, 16 * cell, th, SCALE, data_role="tilescale", data_variant=v))
            body.append(T(x0 + 8 * cell, y_tile + 12, "d", 9, anchor="middle", fill="var(--on-mark)"))
        else:
            xt = x0
            body.append(R(x0, y_top, tw, band, SCALE, data_role="tilescale", data_variant=v))
            body.append(T(x0 + tw / 2, y_top + 11, "d[0..63]: 1024 bits in front of all parameters", 9, anchor="middle", fill="var(--on-mark)"))
        body.append(R(xt, y_tile, tw, th, TRACK))
        body.append(R(xt, y_tile, tw, th, "url(#grid8)"))
        cols, rows = FOOTPRINT_CELLS[v]
        body.append(R(xt, y_tile, cols * cell, rows * cell, COL[v],
                      data_role="tilefoot", data_variant=v, data_cols=cols, data_rows=rows))
        body.append(T(x0, y_foot, f"one vlm.v = {cols * rows} sign bits: {rows} row{'s' if rows > 1 else ''} × {cols} column{'s' if cols > 1 else ''}",
                      11, data_for=f"tilefoot-{v}"))
        # register: 256-byte axis for all three
        body.append(R(x0, y_reg, REG_AXIS * PX_REG, 14, TRACK))
        body.append(R(x0, y_reg, REG_BUSY[v] * PX_REG, 14, COL[v], data_role="regbusy", data_variant=v, data_bytes=REG_BUSY[v]))
        body.append(R(x0, y_reg, REG_GROUP[v] * PX_REG, 14, "none", stroke=INK, stroke_width=1))
        body.append(T(x0, y_regl, REG_LABEL[v], 11, fill=MUTED))
        body.append(T(x0, y_out, OUTCOME[v], 11))
        n = OPS_PER_SUBTILE[v]
        body.append(R(x0, y_bar, n * PX_OPS, 14, COL[v], data_role="opsbar", data_variant=v, data_ops=n))
        body.append(T(x0, y_barl, f"{n} vector instructions per 64 rows × 32 K", 11, weight="bold", data_for=f"opsbar-{v}"))
    body.append(legend(0, y_leg, [(SCALE, "scale: fp16 d, 16 bits per row"),
                                  (TRACK, "parameters: 64 rows × 128 sign bits, one cell per bit"),
                                  (COL["vd4"], "the bits one vlm.v reads (colour = layout)")]))
    return svg("fig-hero", W, H, (defs, "".join(body)),
               "The same 9216 bits per tile: upstream keeps 16 scale bits in front of each row, both repacks keep all 1024 "
               "scale bits in front of the parameters. One vlm.v covers a 1x32 sliver upstream, a 64x1 column after the RVV "
               "repack and a 64x4 band after the VD4DOT repack; the register goes from 32 busy lanes to 256, and the "
               "instruction count per 64x32 sub-tile from 320 to 32.")


#### BYTEMAP
def fig_bytemap():
    xl = 36
    pw, ph = MAP_WRAP * PX_MAP, MAP_ROWS * MAP_CELL_H      # 256 x 288
    gap = 40
    y_title, y_map = 14, 26
    y_fl = y_map + ph + 14
    y_it = y_fl + 30
    y_in = y_it + 6
    y_leg = y_in + 16 + 26
    H = y_leg + 8
    defs = (f'<pattern id="cellgrid" width="{PX_MAP}" height="{MAP_CELL_H}" patternUnits="userSpaceOnUse">'
            f'<path d="M {PX_MAP} 0 L 0 0 0 {MAP_CELL_H}" fill="none" stroke="{PAPER}" stroke-width="0.5" stroke-opacity="0.7"/></pattern>')
    body = []
    for r in range(0, MAP_ROWS + 1, 4):
        body.append(T(xl - 5, y_map + r * MAP_CELL_H + (7 if r < MAP_ROWS else 3), f"{r * MAP_WRAP}", 9, anchor="end", fill=MUTED))
    struct_name = {"upstream": "64 × block_q1_0", "rvv": "block_q1_0x64", "vd4": "block_q1_0x64, Q1_VD4DOT"}
    ys = y_map + SCALE_BYTES // MAP_WRAP * MAP_CELL_H       # first parameter row of the repacks
    for i, v in enumerate(VARIANTS):
        x0 = xl + i * (pw + gap)
        body.append(R(x0, y_title - 10, 10, 10, COL[v]))
        body.append(T(x0 + 16, y_title, f"{NAME[v]} · {struct_name[v]}", 12, weight="bold"))
        body.append(R(x0, y_map, pw, ph, TRACK, data_role="map", data_variant=v))
        if v == "upstream":
            for j in range(ROWS):
                base = j * BLOCK_Q1
                body.append(map_cells(x0, y_map, base, 2, SCALE, data_role="scale", data_variant=v, data_byte=base))
                body.append(map_cells(x0, y_map, base + 2, 16, COL[v]))
            for j in (0, 1, 2, 3, 63):
                row, col = divmod(j * BLOCK_Q1, MAP_WRAP)
                body.append(T(x0 + col * PX_MAP + PX_MAP, y_map + row * MAP_CELL_H + 6.5, f"d{j}", 7, anchor="middle", fill="var(--on-mark)"))
            body.append(T(x0 + 2 * PX_MAP + 3, y_map + 6.5, "row 0: qs[16], 128 sign bits", 7, fill="var(--on-mark)"))
            body.append(T(x0 + 20 * PX_MAP + 3, y_map + 6.5, "row 1", 7, fill="var(--on-mark)"))
            fx, fy, fb = x0 + 2 * PX_MAP, y_map, FOOTPRINT_BYTES[v]
            flabel = ("one vlm.v reads 4 B = qs[0..3] of row 0", "scales: 64 scalar 2-B reads, one per row")
            first = "bits 0..7 of byte 2 (qs[0] of row 0):"
            owner = {i: (0, i) for i in range(8)}
        else:
            body.append(R(x0, y_map, pw, ys - y_map, SCALE, data_role="scales", data_variant=v))
            body.append(T(x0 + pw / 2, y_map + 20, "ggml_half d[64] · 64 scales · 128 B", 9, anchor="middle", fill="var(--on-mark)"))
            body.append(R(x0, ys, pw, ph - (ys - y_map), COL[v]))
            if v == "rvv":
                for k in range(1, 4):
                    body.append(L(x0 + k * 8 * PX_MAP, ys, x0 + k * 8 * PX_MAP, y_map + ph, stroke=PAPER, width=1.2))
                for k in range(4):
                    body.append(T(x0 + k * 8 * PX_MAP + 4 * PX_MAP, ys + 6.5, f"col {k}", 7, anchor="middle", fill="var(--on-mark)"))
                body.append(T(x0 + 3 * 8 * PX_MAP + 4 * PX_MAP, y_map + ph - 1.5, "col 127", 7, anchor="middle", fill="var(--on-mark)"))
                body.append(T(x0 + pw / 2, ys + 44, "128 planes × 8 B · plane c = column c", 9, anchor="middle", fill="var(--on-mark)"))
                body.append(T(x0 + pw / 2, ys + 58, "bit j of plane c = sign(row j, col c)", 9, anchor="middle", fill="var(--on-mark)"))
                flabel = ("one vlm.v reads 8 B = column 0, rows 0..63", "scales: one 128-B vector read")
                first = "bits 0..7 of byte 128 (qs[0][0]):"
                owner = bit_owner(sign_bit_rvv)
            else:
                for q in range(4):
                    body.append(T(x0 + 3, ys + q * MAP_CELL_H + 6.5, f"plane {q}: cols {4 * q}..{4 * q + 3}, rows 0..63", 7, fill="var(--on-mark)"))
                body.append(T(x0 + 3, y_map + ph - 1.5, "plane 31: cols 124..127", 7, fill="var(--on-mark)"))
                body.append(T(x0 + pw / 2, ys + 64, "32 planes × 32 B · plane q = cols 4q..4q+3", 9, anchor="middle", fill="var(--on-mark)"))
                body.append(T(x0 + pw / 2, ys + 78, "bit 4j + r of plane q = sign(row j, col 4q + r)", 9, anchor="middle", fill="var(--on-mark)"))
                flabel = ("one vlm.v reads 32 B = columns 0..3, rows 0..63", "scales: one 128-B vector read")
                first = "bits 0..7 of byte 128 (plane 0, byte 0):"
                owner = bit_owner(sign_bit_vd4)
            fx, fy, fb = x0, ys, FOOTPRINT_BYTES[v]
        body.append(R(x0, y_map, pw, ph, "url(#cellgrid)"))
        body.append(R(fx, fy, fb * PX_MAP, MAP_CELL_H, "none", stroke=INK, stroke_width=1.5,
                      data_role="footprint", data_variant=v, data_bytes=fb))
        body.append(T(x0, y_fl, flabel[0], 9, data_for=f"footprint-{v}"))
        body.append(T(x0, y_fl + 13, flabel[1], 9, fill=MUTED))
        body.append(T(x0, y_it, first, 9, fill=MUTED))
        for b in range(8):
            j, c = owner[b]
            body.append(R(x0 + b * 32, y_in, 31, 16, COL_LT[v]))
            body.append(T(x0 + b * 32 + 15.5, y_in + 11.5, f"r{j}c{c}", 9, anchor="middle", data_for=f"bit-{v}-{b}"))
    body.append(legend(xl, y_leg, [(SCALE, "scale: ggml_half d"),
                                   (COL["rvv"], "parameters: uint8_t qs, sign bits (colour = layout)"),
                                   (None, "bytes one vlm.v reads")]))
    return svg("fig-bytemap", W, H, (defs, "".join(body)),
               "Byte map of the 1152-byte tile for each layout, 32 bytes per row: upstream puts a 2-byte scale every 18 bytes, "
               "both repacks put all 128 scale bytes first. Under each map, the row and column that each bit of the first "
               "parameter byte belongs to.")


