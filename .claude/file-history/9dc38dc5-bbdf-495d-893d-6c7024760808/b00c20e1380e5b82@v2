            dict(key="sumi", label="partial sums", y=108, h=16, n=64, by="sign", fills={"p": col, "n": col_lt, "z": TRACK}),
            dict(key="facc", label="block sums", y=144, h=16, n=64, by="sign", fills={"p": col, "n": col_lt, "z": TRACK}, dec=2),
            dict(key="dx", label="weight scales", y=180, h=16, n=64, by="sign", fills={"p": SCALE, "n": SCALE, "z": TRACK}, dec=2),
            dict(key="sumf", label="row totals", y=216, h=16, n=64, by="sign", fills={"p": col, "n": col_lt, "z": TRACK}, dec=2),
            dict(key="out", label="output", y=252, h=16, n=64, by="sign", fills={"p": COL["upstream"], "n": COL_LT["upstream"], "z": TRACK}, dec=2),
        ]
        arrows = [("sign", f"M{st['colx']},62 L{st['colx']},82"), ("sumi", f"M{LX + 208},98 L{LX + 208},106"),
                  ("facc", f"M{LX + 208},126 L{LX + 208},142"), ("sumf", f"M520,162 L520,214"), ("out", f"M{LX + 208},234 L{LX + 208},250")]
        groups = ["xd", "yb", "sign", "sumi", "facc", "dx", "sumf", "out"]
        H = 292
        ylegend = 282
    else:
        attrs = [dict(id="planemark", attr="x", tpl="{planex}"), dict(id="quadmark", attr="x", tpl="{quadx}"),
                 dict(id="ar-w0", attr="d", tpl="M{planex},62 L{planex},82"),
                 dict(id="ar-s0", attr="d", tpl="M{quadx},62 L{quadx},68 L520,68 L520,108")]
        b.append(R(st["planex"], 42, 32, 20, "none", stroke=INK, stroke_width=1.5, id=ids("planemark")))
        b.append(R(st["quadx"], 42, 14, 20, "none", stroke=INK, stroke_width=1.5, id=ids("quadmark")))
        texts.append(dict(id="info", tpl="quad {qi}: codes {quad}   (one 32-bit word, broadcast to all 64 rows)"))
        b.append(T(LX, 76, _py_fill("quad {qi}: codes {quad}   (one 32-bit word, broadcast to all 64 rows)", st, prev, j), 10, fill=MUTED, id=ids("info")))
        rows = [
            dict(key="w0", label="signs, 4 columns × 64 rows", y=84, h=14, n=256, fills={"1": col, "-1": col_lt}, show="@4"),
            dict(key="s0", label="codes, repeated", y=110, h=14, n=256, valkey="quad"),
            dict(key="dot", label="4-product sums", y=136, h=16, n=64, by="sign", fills={"p": col, "n": col_lt, "z": TRACK}),
            dict(key="acc", label="group sums", y=172, h=16, n=64, by="sign", fills={"p": col, "n": col_lt, "z": TRACK}),
            dict(key="facc", label="block sums", y=208, h=16, n=64, by="sign", fills={"p": col, "n": col_lt, "z": TRACK}, dec=2),
            dict(key="dx", label="weight scales", y=244, h=16, n=64, by="sign", fills={"p": SCALE, "n": SCALE, "z": TRACK}, dec=2),
            dict(key="sumf", label="row totals", y=280, h=16, n=64, by="sign", fills={"p": col, "n": col_lt, "z": TRACK}, dec=2),
            dict(key="out", label="output", y=316, h=16, n=64, by="sign", fills={"p": COL["upstream"], "n": COL_LT["upstream"], "z": TRACK}, dec=2),
        ]
        arrows = [("w0", f"M{st['planex']},62 L{st['planex']},82"), ("s0", f"M{st['quadx']},62 L{st['quadx']},68 L520,68 L520,108"),
                  ("dot", f"M{LX + 208},124 L{LX + 208},134"), ("acc", f"M{LX + 208},154 L{LX + 208},170"),
                  ("facc", f"M{LX + 208},190 L{LX + 208},206"), ("sumf", f"M520,226 L520,278"), ("out", f"M{LX + 208},298 L{LX + 208},314")]
        groups = ["xd", "yb", "w0", "s0", "dot", "acc", "facc", "dx", "sumf", "out"]
        H = 356
        ylegend = 346
    for key, d in arrows:
        b.append(f'<path id="{ids("ar-" + key)}" class="an-ar" {AR} d="{d}"/>')
    tints = [ACT_ROW[i % 4] for i in range(256)]
    for row in rows:
        key, n, y, h = row["key"], row["n"], row["y"], row["h"]
        pitch = AN_LANES / n
        arr = st.get(key)
        b.append(f'<g id="{ids("row-" + key)}" class="an-row">')
        b.append(T(LX - 6, y + h - 4, row["label"], 11, anchor="end", weight="bold"))
        for c in range(n):
            if key == "s0":
                f = tints[c]
            elif arr is None or "fills" not in row:
                f = TRACK
            elif row.get("by") == "sign":
                v = arr[c]
                f = row["fills"]["p" if v > 0 else "n" if v < 0 else "z"]
            else:
                f = row["fills"].get(str(arr[c]), TRACK)
            b.append(R(LX + c * pitch, y, max(pitch - (0.5 if pitch >= 2 else 0), 0.5), h, f,
                       id=ids(f"{key}-{c}"), data_lane=c, data_n=n))
        b.append(R(LX + j * P, y, P, h, "none", stroke=INK, stroke_width=1.5, id=ids(key + "-fl"), data_x0=LX, data_pitch=P))
        if row.get("valkey"):
            val = _py_fmt(st.get(row["valkey"]))
        elif row.get("show") == "@4":
            val = ", ".join(_py_fmt(arr[4 * j + r]) for r in range(4)) if arr else ""
        else:
            val = _py_fmt(arr[j], row.get("dec")) if arr else ""
        b.append(R(528, y, 68, h, TRACK, stroke=LINE, stroke_width=1))
        b.append(T(562, y + h - 4, val or "", 9, anchor="middle", id=ids(key + "-val")))
        b.append("</g>")
    b.append(T(562, 80, f"row {j}", 9, anchor="middle", fill=MUTED, id=ids("followhdr")))
    texts.append(dict(id="followhdr", tpl="row {j}"))
    b.append(legend(0, ylegend, [(SCALE, "scale: fp16 d"), (col, "weight parameters: sign bits"), (ACT, "activation parameters: int8 codes"), (None, "the row you follow")]))
    label = ("Animated: 64 output rows through the RVV repack kernel, one column at a time: sign mask, masked add and subtract, "
             "block sums times the activation scale, row totals times the weight scales, store."
             if layout == "rvv" else
             "Animated: 64 output rows through the VD4DOT kernel: a 32-byte plane becomes 256 signs, a 4-code quad is broadcast, "
             "one dot instruction adds 4 products per row, then the activation scale and the weight scales.")
    picture = svg(f"svg-anim-{layout}", 600, H, ("", "".join(b)), label)
    code = "".join(f'<span class="ln{" active" if i == last["line"] else ""}" data-line="{i}">{esc(l)}</span>' for i, l in enumerate(tr["lines"]))
    data = dict(layout=layout, follow=j, steps=tr["steps"], rows=[{k: v for k, v in r.items() if k not in ("label", "y", "h")} for r in rows],
                texts=texts, attrs=attrs, groups=groups)
    payload = json.dumps(data, separators=(",", ":")).replace("</", "<\\/")
    nsteps = len(tr["steps"])
    controls = (f'<div class="an-controls"><button id="{p}-play" type="button">▶ Play</button>'
                f'<button id="{p}-prev" type="button">◀ Step</button><button id="{p}-next" type="button">Step ▶</button>'
                f'<button id="{p}-reset" type="button">Reset</button>'
                f'<label>speed <select id="{p}-speed"><option value="0.5">0.5×</option><option value="1" selected>1×</option>'
                f'<option value="2">2×</option><option value="4">4×</option></select></label>'
                f'<label>follow row <input id="{p}-follow" type="number" min="0" max="63" value="{j}"></label>'
                f'<span class="an-pos" id="{p}-pos">{nsteps} / {nsteps}</span></div>')
    if layout == "rvv":
        caption = ("All arithmetic of the RVV repack kernel for 64 output rows over 2 × 128 K, on sample data (the same data as the "
                   "VD4DOT animation below, so both end with the same 64 outputs). Every lane is one output row; the outlined lane is "
                   "the row whose numbers are printed on the right and in the caption line. Click any lane or type a row number to "
                   "follow another row. Columns 0 and 1 of each group are shown step by step, then the other 30 columns are applied at once. "
                   "Scale 1 (activation scale) is applied once per 32-K group with one vector multiply-add, scale 2 (the 64 weight "
                   "scales) once per 128-K block. Plain names in the picture, kernel names in the code: sign mask = sign, partial sums = sumi, "
                   "block sums = facc, weight scales = dx, row totals = sumf, code = yc, activation scale = ab->d.")
    else:
        caption = ("All arithmetic of the VD4DOT kernel for the same 64 rows and the same sample data as the RVV animation above. "
                   "The 256-lane rows are 64 rows × 4 columns: a 32-byte plane becomes 256 signs, and one 4-code quad is broadcast "
                   "to every row. One nds.vd4dots.vv adds 4 products into each row's group sum. Quad 0 of each group is shown step by "
                   "step, then the other 7 quads are applied at once. Scale 1 (activation scale) once per 32-K group, scale 2 (the 64 "
                   "weight scales) once per 128-K block. Plain names in the picture, kernel names in the code: signs = w0, codes = s0, "
                   "group sums = acc, block sums = facc, weight scales = dx, row totals = sumf, activation scale = a_ptr[g].d.")
    return (f'<figure id="anim-{layout}" class="animfig">{controls}<div class="anim">'
            f'<pre id="{p}-code"><code>{code}</code></pre><div class="stepfig">{picture}</div></div>'
            f'<figcaption>{caption}</figcaption>'
            f'<script type="application/json" id="{p}-data">{payload}</script><script>q1Anim("{p}");</script></figure>')


