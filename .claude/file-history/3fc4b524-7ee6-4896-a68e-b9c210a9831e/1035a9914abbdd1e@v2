/* HVM content transport across the hybrid handoff, on the VECTOR path.
 *
 * The HVM (High-Bandwidth Vector Memory) is the vector unit's private
 * 256 KB SRAM at 0x90000000, 2 banks (bank = address bit 17). Unlike
 * the ILM/DLM it has no enable CSR and no local/slave address split --
 * 0x90000000 is the only window. What it does have is two hardware
 * paths: the VPU's direct high-bandwidth path (this demo) and the bus
 * subordinate port for scalar/external masters (demo/hvm_slave).
 *
 * QEMU phase (before the ROI):
 *   - fill the whole 256 KB with a runtime-computed pattern via VECTOR
 *     stores (vle32 from a DRAM staging buffer, vse32 into the HVM)
 *   - sanity: scalar spot-check of head and tail
 *
 * vsim ROI:
 *   - VECTOR-read three 64-word windows back -- bank0 head, the
 *     bank0/bank1 boundary straddle, bank1 tail (the spots a bank-split
 *     or byte-order bug would hit) -- and compare; HVM_OK / HVM_BAD
 *
 * The pattern bytes exist nowhere but the HVM: QEMU's HVM RAM is not
 * backed by the shared DRAM mmap, so the ONLY road into the RTL's HVM
 * SRAM is the sidecar transport (plugin drain -> <state>.hvm -> vsim
 * backdoor load). No transport => the ROI reads reset-empty SRAM.
 *
 * Geometry matches vsim:ax45mpv_premium: HVM 256 KB at 0x90000000.
 */

#include <stdint.h>
#include <stdio.h>
#include <andesim/ROI.h>

#define HVM_BASE   0x90000000u
#define HVM_BYTES  262144u
#define HVM_WORDS  (HVM_BYTES / 4u)
#define WIN_WORDS  64u

static inline uint32_t pat(uint32_t i) { return i * 2654435761u + 0xB4A1u; }

static uint32_t stage[HVM_WORDS]; /* DRAM staging for the vector copy */

/* Vector memcpy, 32-bit elements. v8 carries the data with no clobber
 * list: this toolchain never touches V registers on its own. */
static void v_copy(const uint32_t *src, uint32_t *dst, uint32_t n)
{
  while (n) {
    unsigned long vl;
    __asm__ __volatile__("vsetvli %0, %1, e32, m1, ta, ma\n\t"
                         "vle32.v v8, (%2)\n\t"
                         "vse32.v v8, (%3)"
                         : "=&r"(vl)
                         : "r"((unsigned long) n), "r"(src), "r"(dst)
                         : "memory");
    src += vl;
    dst += vl;
    n -= (uint32_t) vl;
  }
}

/* ROI body, noinline and non-static so --trigger pc can name it. */
__attribute__((noinline)) int hvm_check(void)
{
  static const uint32_t win[3] = {0, HVM_WORDS / 2u - WIN_WORDS / 2u,
                                  HVM_WORDS - WIN_WORDS};
  uint32_t buf[WIN_WORDS];

  uint32_t bad = 0;
  for (int w = 0; w < 3; w++) {
    v_copy((const uint32_t *) (uintptr_t) (HVM_BASE + win[w] * 4u), buf,
           WIN_WORDS);
    for (uint32_t i = 0; i < WIN_WORDS; i++)
      if (buf[i] != pat(win[w] + i)) bad++;
  }
  if (bad != 0) {
    printf("HVM_BAD count=%u\n", (unsigned) bad);
    return 1;
  }
  printf("HVM_OK sampled=%u\n", (unsigned) (3 * WIN_WORDS));
  return 0;
}

int main(void)
{
  for (uint32_t i = 0; i < HVM_WORDS; i++) stage[i] = pat(i);
  v_copy(stage, (uint32_t *) (uintptr_t) HVM_BASE, HVM_WORDS);

  /* Sanity, still in QEMU: scalar spot-check of the vector writes. */
  volatile uint32_t *hvm = (volatile uint32_t *) (uintptr_t) HVM_BASE;
  if (hvm[0] != pat(0) || hvm[HVM_WORDS - 1] != pat(HVM_WORDS - 1)) {
    printf("HVM_STAGE_BAD\n");
    return 2;
  }
  printf("HVM staged\n");

  andesim_ROI_begin();
  int rc = hvm_check();
  andesim_ROI_end();
  /* ROI end symbol for --pc-end: the point right after the call. */
  __asm__ __volatile__(".globl hvm_roi_end\nhvm_roi_end:" ::: "memory");

  return rc;
}
