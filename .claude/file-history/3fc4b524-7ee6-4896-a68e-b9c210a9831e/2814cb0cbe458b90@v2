-include ../../Make.var

all: lm.elf lm.dump

lm.elf: main.c
	$(CC) $(CFLAGS) $< -o $@

lm.dump: lm.elf
	$(OBJDUMP) -d $< > $@

# The four andesim modes, one target each. Same ELF everywhere.
#
# fast: plain QEMU knows no engine, so its compiled-in LM geometry (2 MB
# ILM at 0x0) would shadow the program image at 0x100000 the moment the
# program sets milmb.EN. Pass the engine's real geometry through `--`.
# cycle/hybrid need nothing: the engine IS the geometry, and the hybrid
# fast leg gets it synced automatically.
lm-fast: lm.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $< -- \
	    -global driver=riscv.andes.ae350.soc,property=ilm_size,value=65536 \
	    -global driver=riscv.andes.ae350.soc,property=dlm_size,value=32768

lm-cycle: lm.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

lm-hybrid-marker: lm.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

lm-hybrid-pc: lm.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start lm_check --pc-end lm_roi_end \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: lm-fast lm-cycle lm-hybrid-marker lm-hybrid-pc

clean:
	- rm -f lm.elf lm.dump

.PHONY: all run clean lm-fast lm-cycle lm-hybrid-marker lm-hybrid-pc
