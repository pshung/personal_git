#include "log.hpp"

#include <cstdarg>
#include <cstdio>
#include <ctime>

namespace andes_sim {
namespace {
int g_threshold = kLogInfo;
std::FILE* g_sink = nullptr;
std::string g_sink_path;

const char* level_name(int level) {
  static const char* const names[] = {"trace",    "debug", "info", "warn",
                                      "error",    "critical", "off"};
  return (level >= 0 && level <= 6) ? names[level] : "?";
}

std::string vformat(const char* fmt, va_list ap) {
  va_list ap2;
  va_copy(ap2, ap);
  const int n = std::vsnprintf(nullptr, 0, fmt, ap2);
  va_end(ap2);
  if (n <= 0) return "";
  std::string s(static_cast<size_t>(n), '\0');
  std::vsnprintf(s.data(), s.size() + 1, fmt, ap);
  return s;
}

// Console when the threshold passes; the sink (timestamped, level-tagged)
// unconditionally.
void emit(int level, std::FILE* console, const std::string& text) {
  if (log_on(level)) {
    std::fputs(text.c_str(), console);
    std::fputc('\n', console);
  }
  if (g_sink) {
    char ts[24];
    const std::time_t now = std::time(nullptr);
    std::tm tm{};
    gmtime_r(&now, &tm);
    std::strftime(ts, sizeof(ts), "%Y-%m-%dT%H:%M:%SZ", &tm);
    std::fprintf(g_sink, "[%s] [%s] %s\n", ts, level_name(level), text.c_str());
    std::fflush(g_sink);
  }
}
}  // namespace

bool set_log_threshold(const std::string& cli_value) {
  if (cli_value.empty()) return true;
  if (cli_value.size() != 1 || cli_value[0] < '0' || cli_value[0] > '6')
    return false;
  g_threshold = cli_value[0] - '0';
  return true;
}

int log_threshold() { return g_threshold; }

bool log_on(int level) { return level >= g_threshold; }

bool set_log_file(const std::string& path) {
  if (path.empty()) return true;
  std::FILE* f = std::fopen(path.c_str(), "a");
  if (!f) return false;
  g_sink = f;
  g_sink_path = path;
  return true;
}

const std::string& log_file_path() { return g_sink_path; }

void log_line(int level, const char* fmt, ...) {
  if (!log_on(level) && !g_sink) return;
  va_list ap;
  va_start(ap, fmt);
  const std::string text = vformat(fmt, ap);
  va_end(ap);
  emit(level, stderr, text);
}

void log_result(int level, const char* fmt, ...) {
  if (!log_on(level) && !g_sink) return;
  va_list ap;
  va_start(ap, fmt);
  const std::string text = vformat(fmt, ap);
  va_end(ap);
  emit(level, stdout, text);
}

}  // namespace andes_sim
