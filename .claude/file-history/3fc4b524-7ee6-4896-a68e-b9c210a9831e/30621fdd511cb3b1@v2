-include ../../Make.var

# Dhrystone's ground rule: the two passes are separate compilations.
# RUNS is a knob (1000 gives a CoreMark-sized RTL window).
RUNS ?= 1000
DHRY_DEFS := -DNUMBER_OF_RUNS=$(RUNS)

all: dhrystone.elf dhrystone.dump

dry1.o: dry.c
	$(CC) $(CFLAGS) $(DHRY_DEFS) -c $< -o $@

dry2.o: dry.c
	$(CC) $(CFLAGS) $(DHRY_DEFS) -DPASS2 -c $< -o $@

dhrystone.elf: dry1.o dry2.o
	$(CC) $(CFLAGS) $^ -o $@

dhrystone.dump: dhrystone.elf
	$(OBJDUMP) -d $< > $@

# The four andesim modes, one target each. Same ELF everywhere.
dhrystone-fast: dhrystone.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

dhrystone-cycle: dhrystone.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

dhrystone-hybrid-marker: dhrystone.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

# The ROI boundaries are the port's timing functions themselves.
dhrystone-hybrid-pc: dhrystone.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start start_time --pc-end stop_time \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: dhrystone-fast dhrystone-cycle dhrystone-hybrid-marker dhrystone-hybrid-pc

clean:
	- rm -f dhrystone.elf dhrystone.dump dry1.o dry2.o

.PHONY: all run clean dhrystone-fast dhrystone-cycle dhrystone-hybrid-marker dhrystone-hybrid-pc
