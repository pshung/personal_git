#!/usr/bin/env bash
# Default-command contract: `run` may be omitted.
#
#   1. `andesim --mode fast <elf>` behaves exactly like `andesim run ...`.
#   2. ELF-first spelling works too: `andesim <elf> --mode fast`.
#   3. Explicit commands are untouched: `list engines` still lists engines.
#   4. Bare `andesim` still prints usage and exits non-zero.
#   5. `andesim -h` is still the top-level help (exit 0, shows the tree).
#
# RED-then-green smoke test, run manually during driver development. Not wired
# into run_e2e.sh.
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
. "$SCRIPT_DIR/../lib/log.sh"

BIN="$ROOT/build/andesim"
ELF="$ROOT/tests/fixtures/vplat_hello.elf"

bash "$ROOT/scripts/build_driver.sh" >/dev/null 2>&1 || fail "build_driver.sh failed"
[ -x "$BIN" ] || fail "missing executable: $BIN"
[ -f "$ELF" ] || fail "missing fixture: $ELF"

# 1. flag-first implicit run
out=$("$BIN" --mode fast "$ELF" 2>&1) || fail "implicit run (flag-first) exited non-zero:"$'\n'"$out"
echo "$out" | grep -q "hello from vplat" || fail "implicit run missing program output:"$'\n'"$out"

# 2. ELF-first implicit run
out=$("$BIN" "$ELF" --mode fast 2>&1) || fail "implicit run (ELF-first) exited non-zero:"$'\n'"$out"
echo "$out" | grep -q "hello from vplat" || fail "ELF-first run missing program output:"$'\n'"$out"

# 3. explicit commands unchanged
out=$("$BIN" list engines 2>&1) || fail "list engines exited non-zero"
echo "$out" | grep -q "ENGINE" || fail "list engines missing header:"$'\n'"$out"

# 4. bare invocation still prints usage, non-zero
"$BIN" >/dev/null 2>&1 && fail "bare andesim should exit non-zero"
out=$("$BIN" 2>&1)
echo "$out" | grep -q "usage:" || fail "bare andesim missing usage:"$'\n'"$out"

# 5. top-level -h unchanged
out=$("$BIN" -h 2>&1); rc=$?
[ "$rc" -eq 0 ] || fail "-h exit code should be 0, got $rc"
echo "$out" | grep -q "usage:" || fail "-h missing usage:"$'\n'"$out"

ok "default run command"
