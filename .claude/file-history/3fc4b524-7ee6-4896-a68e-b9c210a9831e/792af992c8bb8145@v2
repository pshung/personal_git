#include "cli.hpp"

namespace andes_sim {
namespace {

// Try to read an option's value at args[i]. Supports both `--flag value`
// (consumes the next token, advancing i) and `--flag=value`.
//   returns  1 = matched, `out` set
//            0 = this token is not `flag`
//           -1 = matched `--flag` but no value follows
int match_opt(const std::vector<std::string>& args, size_t& i,
              const std::string& flag, std::string& out) {
  const std::string& a = args[i];
  if (a == flag) {
    if (i + 1 >= args.size()) return -1;
    out = args[++i];
    return 1;
  }
  const std::string pfx = flag + "=";
  if (a.starts_with(pfx)) {
    out = a.substr(pfx.size());
    return 1;
  }
  return 0;
}

}  // namespace

bool is_subcommand(std::string_view name) {
  return name == "run" || name == "list" || name == "doctor";
}

Cli parse_cli(const std::vector<std::string>& args) {
  Cli c;
  if (args.empty()) return c;  // no subcommand; caller prints usage

  // First token is the subcommand, unless it is a top-level help request.
  if (args[0] == "-h" || args[0] == "--help") {
    c.help = true;
    return c;
  }

  // `run` is the default command: any other first token is `run`'s own
  // first argument (a flag or the ELF), not a subcommand.
  size_t first = 1;
  if (is_subcommand(args[0])) {
    c.subcommand = args[0];
  } else {
    c.subcommand = "run";
    first = 0;
  }

  for (size_t i = first; i < args.size(); ++i) {
    const std::string& a = args[i];

    if (a == "--") {  // the passthrough boundary: rest is verbatim
      c.has_passthrough = true;
      for (size_t j = i + 1; j < args.size(); ++j) c.passthrough.push_back(args[j]);
      break;
    }
    if (a == "-h" || a == "--help") {
      c.help = true;
      continue;
    }
    if (a == "--dry-run") {
      c.dry_run = true;
      continue;
    }
    if (a == "--print-memmap") {
      c.print_memmap = true;
      continue;
    }
    if (a == "--verify") {
      c.verify = true;
      continue;
    }
    if (a == "--gdb") {
      c.gdb = true;
      continue;
    }

    const struct {
      const char* flag;
      std::string* out;
    } opts[] = {{"--mode", &c.model},
                {"--engine", &c.engine},
                {"--trigger", &c.trigger},
                {"--pc-start", &c.pc_start},
                {"--pc-end", &c.pc_end},
                {"--mem-size", &c.mem_size},
                {"--mmap-size", &c.mem_size},  // retired spelling, same knob
                {"--kanata", &c.kanata},
                {"--objdump", &c.objdump},
                {"--log-level", &c.log_level},
                {"--gdb-port", &c.gdb_port}};
    bool consumed = false;
    for (const auto& o : opts) {
      int r = match_opt(args, i, o.flag, *o.out);
      if (r < 0) { c.error = std::string("missing value for ") + o.flag; return c; }
      if (r > 0) { consumed = true; break; }
    }
    if (consumed) continue;

    if (a.size() > 1 && a[0] == '-') {
      c.error = "unknown option: " + a;
      return c;
    }
    c.positional.push_back(a);
  }

  return c;
}

Cli parse_cli(int argc, char** argv) {
  std::vector<std::string> args;
  args.reserve(argc > 1 ? static_cast<size_t>(argc - 1) : 0);
  for (int i = 1; i < argc; ++i) args.emplace_back(argv[i]);
  return parse_cli(args);
}

}  // namespace andes_sim
