#include "log.hpp"

namespace andes_sim {
namespace {
int g_threshold = kLogInfo;
}  // namespace

bool set_log_threshold(const std::string& cli_value) {
  if (cli_value.empty()) return true;
  if (cli_value.size() != 1 || cli_value[0] < '0' || cli_value[0] > '6')
    return false;
  g_threshold = cli_value[0] - '0';
  return true;
}

bool log_on(int level) { return level >= g_threshold; }

}  // namespace andes_sim
