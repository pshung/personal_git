/* RVV inside the ROI. The workload is an 8x8x8 int32 GEMM, but the
 * demo tests the vector unit, not the math.
 *
 * The other demos move DATA across the hybrid handoff; this one moves
 * COMPUTE. The ROI runs a vector kernel written with the standard RVV
 * intrinsics (<riscv_vector.h>), proving
 *   - the toolchain's RVV intrinsics compile and run on every mode,
 *   - on hybrid, the vector unit works right after the handoff: the
 *     restored mstatus.VS and V CSRs let the ROI issue vector
 *     instructions with no V setup code of its own.
 *
 * The kernel is INTEGER on purpose: this engine's VPU is integer-only
 * (config: VECTOR_SINT/VDOT/INT4, no vector FP32) -- a vector-float op
 * like vfmacc.vf traps illegal-instruction on the RTL even though
 * QEMU's model accepts it. int32 matches the hardware on both engines.
 *
 * QEMU phase (before the ROI):
 *   - fill A and B with runtime-computed small values
 *   - compute the scalar reference C_ref
 *
 * vsim ROI:
 *   - C = A x B with vle32/vmacc/vse32, strip-mined by vsetvl so the
 *     kernel is correct for any VLEN
 *   - compare C with C_ref; prints RVV_OK / RVV_BAD
 *
 * A, B, C_ref live in normal DRAM -- the shared mmap -- which is how
 * they survive the QEMU -> vsim handoff.
 */

#include <stdint.h>
#include <stdio.h>
#include <riscv_vector.h>
#include <andesim/ROI.h>

#define N 8

static int32_t A[N][N], B[N][N], C[N][N], C_ref[N][N];

/* Small values in [-8, 7]. */
static inline int32_t elem(uint32_t i, uint32_t salt)
{
  uint32_t h = (i + salt) * 2654435761u;
  return (int32_t) (h >> 28) - 8;
}

/* ROI body, noinline and non-static so --trigger pc can name it. */
__attribute__((noinline)) int rvv_kernel(void)
{
  for (int i = 0; i < N; i++) {
    int j = 0;
    while (j < N) {
      size_t vl = __riscv_vsetvl_e32m1((size_t) (N - j));
      vint32m1_t acc = __riscv_vmv_v_x_i32m1(0, vl);
      for (int k = 0; k < N; k++) {
        vint32m1_t b = __riscv_vle32_v_i32m1(&B[k][j], vl);
        acc = __riscv_vmacc_vx_i32m1(acc, A[i][k], b, vl);
      }
      __riscv_vse32_v_i32m1(&C[i][j], acc, vl);
      j += (int) vl;
    }
  }

  uint32_t bad = 0;
  for (int i = 0; i < N; i++)
    for (int j = 0; j < N; j++)
      bad += (C[i][j] != C_ref[i][j]);

  if (bad != 0) {
    printf("RVV_BAD count=%u\n", (unsigned) bad);
    return 1;
  }
  printf("RVV_OK n=%u\n", (unsigned) (N * N));
  return 0;
}

int main(void)
{
  for (int i = 0; i < N; i++)
    for (int k = 0; k < N; k++) {
      A[i][k] = elem((uint32_t) (i * N + k), 0xA11Au);
      B[i][k] = elem((uint32_t) (i * N + k), 0xB22Bu);
    }

  for (int i = 0; i < N; i++)
    for (int j = 0; j < N; j++) {
      int32_t s = 0;
      for (int k = 0; k < N; k++) s += A[i][k] * B[k][j];
      C_ref[i][j] = s;
      C[i][j] = 0;
    }
  printf("GEMM 8x8x8 staged\n");

  andesim_ROI_begin();
  int rc = rvv_kernel();
  andesim_ROI_end();
  /* ROI end symbol for --pc-end: the point right after the call. */
  __asm__ __volatile__(".globl rvv_roi_end\nrvv_roi_end:" ::: "memory");

  return rc;
}
