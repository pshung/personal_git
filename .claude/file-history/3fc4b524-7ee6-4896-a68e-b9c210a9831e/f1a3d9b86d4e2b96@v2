-include ../../Make.var

all: hvm_slave.elf hvm_slave.dump

hvm_slave.elf: main.c
	$(CC) $(CFLAGS) $< -o $@

hvm_slave.dump: hvm_slave.elf
	$(OBJDUMP) -d $< > $@

# The four andesim modes, one target each. Same ELF everywhere.
#
# fast: plain QEMU knows no engine geometry -- its compiled-in HVM is
# 1 byte, so pass the engine's real size (log2: 2^18 = 256 KB) via `--`.
hvm_slave-fast: hvm_slave.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $< -- \
	    -global driver=riscv.andes.ae350.soc,property=hvm_size_pow_2,value=18

hvm_slave-cycle: hvm_slave.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

hvm_slave-hybrid-marker: hvm_slave.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

hvm_slave-hybrid-pc: hvm_slave.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start hslv_check --pc-end hslv_roi_end \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: hvm_slave-fast hvm_slave-cycle hvm_slave-hybrid-marker hvm_slave-hybrid-pc

clean:
	- rm -f hvm_slave.elf hvm_slave.dump

.PHONY: all run clean hvm_slave-fast hvm_slave-cycle hvm_slave-hybrid-marker hvm_slave-hybrid-pc
