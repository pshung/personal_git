// andesim leveled logging.
//
// The scale mirrors the vsim engines' --log-level option so users learn one
// scheme: 0=trace 1=debug 2=info 3=warn 4=error 5=critical 6=off. A message
// prints when its level >= the threshold; the default threshold is info.
//
// What lives at which level (driver policy):
//   info  -- the answers: program output relays, the cycle figure,
//            --dry-run/--verify results. Program output itself is never
//            gated (it is the program's, not a log).
//   debug -- driver chatter: the hybrid banner, the mmap line, PASS lines,
//            verify progress notes.
//   warn  -- degradations: unsupported-CSR warnings, skipped engines.
// Fatal errors are not gated: they accompany a non-zero exit.
#ifndef ANDESIM_LOG_HPP
#define ANDESIM_LOG_HPP

#include <string>

namespace andes_sim {

enum LogLevel {
  kLogTrace = 0,
  kLogDebug = 1,
  kLogInfo = 2,
  kLogWarn = 3,
  kLogError = 4,
  kLogCritical = 5,
  kLogOff = 6,
};

// Set the process-wide threshold from the CLI value. "" keeps the default
// (info). Returns false (and leaves the threshold alone) when the value is
// not an integer in 0..6.
bool set_log_threshold(const std::string& cli_value);

// The current threshold (0..6). Used to forward the level to child engines.
int log_threshold();

// True when a message at `level` should print.
bool log_on(int level);

// Open the --log-file sink. Once open, EVERY log_line/log_result message --
// all levels, even below the console threshold -- is appended to the file
// with a UTC timestamp and a level tag. Returns false if the file cannot be
// opened (the sink stays off). Empty path is a no-op success.
bool set_log_file(const std::string& path);

// The open sink's path, or "" when none.
const std::string& log_file_path();

// Emit one chatter line to stderr when `level` passes the threshold. Pass
// the complete line text (including its "[andesim] " prefix), without the
// trailing newline. Always mirrored to the --log-file sink.
void log_line(int level, const char* fmt, ...)
    __attribute__((format(printf, 2, 3)));

// Emit one RESULT line (the cycle figure, PASS/verify verdicts) to stdout
// when `level` passes the threshold. Always mirrored to the sink.
void log_result(int level, const char* fmt, ...)
    __attribute__((format(printf, 2, 3)));

}  // namespace andes_sim

#endif  // ANDESIM_LOG_HPP
