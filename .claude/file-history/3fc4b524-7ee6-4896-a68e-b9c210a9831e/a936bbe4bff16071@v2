// OpLog: a pure per-operation event recorder for the hybrid DM transport.
//
// ResumeDriver / StateDrain record one event per SEMANTIC operation (an
// abstract register write/read, a Program-Buffer execution, a tolerated
// cmderr) when a log is attached; the simulator renders the events via
// spdlog at debug/trace. Keeping the recorder pure keeps hybrid/*.hpp
// spdlog-free and the event stream unit-testable against the RecordingBus
// mock -- and on a resume abort the tail of the log IS the forensic trail
// (which register/CSR the transport was touching when it died).

#pragma once

#include <cstdint>
#include <vector>

namespace hybrid {

struct OpLog
{
  enum class Kind : uint8_t
  {
    AbstractWrite,  // abstract register write (regno: csr / 0x1000+gpr / 0x1020+fpr)
    AbstractRead,   // abstract register read
    ProgBuf,        // program-buffer execution (value = first instruction word)
    PbFallback,     // abstract CSR write faulted; retried via program buffer
    CmdErr,         // sticky cmderr observed + cleared (value = cmderr code)
  };

  struct Event
  {
    Kind kind;
    uint16_t regno;
    uint64_t value;
  };

  std::vector<Event> events;

  void record(Kind kind, uint16_t regno, uint64_t value)
  {
    events.push_back({kind, regno, value});
  }
};

}  // namespace hybrid
