/* ILM/DLM slave-port (subordinate) aperture across the hybrid handoff.
 *
 * demo/lm proves the CONTENT migrates (hart-local view). This demo
 * proves the SLAVE-PORT ROUTING: the same SRAMs are also visible at the
 * bus apertures HART0_ILM 0xA0000000 / HART0_DLM 0xA0200000 -- a hart
 * access there goes OUT the bus master port, through the interconnect,
 * and back into the local memory's slave port.
 *
 * QEMU phase (before the ROI):
 *   - enable the ILM and DLM
 *   - write the DLM pattern and the 3-instruction ILM kernel THROUGH the
 *     slave-port view
 *   - sanity: read a few words back through the hart-local view -- both
 *     views must alias one SRAM on the QEMU side too
 *
 * vsim ROI:
 *   - call the ILM kernel at its hart-local address (the fetch path)
 *   - read the kernel words and sampled DLM words back THROUGH the
 *     slave-port view and compare
 *   - print the verdict: SLV_OK, or SLV_ILM_BAD / SLV_DLM_BAD
 *
 * The DLM check samples every 16th word plus the boundaries: full-content
 * transport is demo/lm's job; here each load is a bus round trip and the
 * point is the routing, not the bytes.
 *
 * Geometry matches vsim:ax45mpv_premium hart 0: ILM 64 KB (local 0x0,
 * slave 0xA0000000), DLM 32 KB (local 0x200000, slave 0xA0200000).
 */

#include <stdint.h>
#include <stdio.h>
#include <andesim/ROI.h>

#define ILM_LOCAL     0x0u
#define ILM_SLAVE     0xA0000000u
#define DLM_LOCAL     0x200000u
#define DLM_SLAVE     0xA0200000u
#define ILM_FN_OFF    0x100u
#define DLM_BYTES     32768u
#define DLM_WORDS     (DLM_BYTES / 4u)
#define DLM_STRIDE    16u

typedef uint32_t (*ilm_fn)(uint32_t);

#define LM_ENABLE(csr_lit)                                        \
  do {                                                            \
    unsigned long long v_;                                        \
    __asm__ __volatile__("csrr %0, " csr_lit : "=r"(v_));         \
    __asm__ __volatile__("csrw " csr_lit ", %0" ::"r"(v_ | 1));   \
    __asm__ __volatile__("fence" ::: "memory");                   \
  } while (0)

static inline uint32_t pat(uint32_t i) { return i * 2654435761u + 0x51A7u; }

static volatile uint32_t imm_src = 0x3C3u;

/* ROI body, noinline and non-static so --trigger pc can name it. */
__attribute__((noinline)) int slv_check(ilm_fn f, uint32_t x, uint32_t want,
                                        uint32_t insn0)
{
  volatile uint32_t *ilm_slv = (volatile uint32_t *) (uintptr_t) ILM_SLAVE;
  volatile uint32_t *dlm_slv = (volatile uint32_t *) (uintptr_t) DLM_SLAVE;

  /* The fetch path: execute the kernel at its hart-local address. */
  uint32_t got = f(x);
  if (got != want) {
    printf("SLV_ILM_BAD exec got=0x%08x want=0x%08x\n", (unsigned) got,
           (unsigned) want);
    return 1;
  }

  /* The slave load path: the kernel words, then the sampled DLM words. */
  const uint32_t fn_w = ILM_FN_OFF / 4u;
  if (ilm_slv[fn_w] != insn0 || ilm_slv[fn_w + 1] != 0x32150513u ||
      ilm_slv[fn_w + 2] != 0x00008067u) {
    printf("SLV_ILM_BAD read got=0x%08x want=0x%08x\n",
           (unsigned) ilm_slv[fn_w], (unsigned) insn0);
    return 1;
  }

  uint32_t bad = 0, first = 0, checked = 0;
  for (uint32_t i = 0; i < DLM_WORDS; i += DLM_STRIDE) {
    checked++;
    if (dlm_slv[i] != pat(i)) {
      if (bad == 0) first = i;
      bad++;
    }
  }
  if (dlm_slv[DLM_WORDS - 1] != pat(DLM_WORDS - 1)) { bad++; first = DLM_WORDS - 1; }
  checked++;

  if (bad != 0) {
    printf("SLV_DLM_BAD count=%u first=%u got=0x%08x want=0x%08x\n",
           (unsigned) bad, (unsigned) first, (unsigned) dlm_slv[first],
           (unsigned) pat(first));
    return 1;
  }

  printf("SLV_OK ilm=0x%08x dlm_sampled=%u\n", (unsigned) got,
         (unsigned) checked);
  return 0;
}

int main(void)
{
  LM_ENABLE("0x7c0"); /* milmb: ILM on */
  LM_ENABLE("0x7c1"); /* mdlmb: DLM on */

  volatile uint32_t *ilm_slv = (volatile uint32_t *) (uintptr_t) ILM_SLAVE;
  volatile uint32_t *dlm_slv = (volatile uint32_t *) (uintptr_t) DLM_SLAVE;
  volatile uint32_t *ilm_loc = (volatile uint32_t *) (uintptr_t) ILM_LOCAL;
  volatile uint32_t *dlm_loc = (volatile uint32_t *) (uintptr_t) DLM_LOCAL;

  /* Everything is WRITTEN through the slave-port view. */
  for (uint32_t i = 0; i < DLM_WORDS; i++) dlm_slv[i] = pat(i);

  const uint32_t imm = imm_src & 0xFFFu;
  const uint32_t insn0 = 0x00054513u | (imm << 20); /* xori a0, a0, IMM */
  const uint32_t fn_w = ILM_FN_OFF / 4u;
  ilm_slv[fn_w] = insn0;
  ilm_slv[fn_w + 1] = 0x32150513u; /* addi a0, a0, 0x321 */
  ilm_slv[fn_w + 2] = 0x00008067u; /* ret */
  __asm__ __volatile__("fence.i" ::: "memory");

  /* Sanity, still in QEMU: both views must alias one SRAM. */
  if (ilm_loc[fn_w] != insn0 || dlm_loc[0] != pat(0) ||
      dlm_loc[DLM_WORDS - 1] != pat(DLM_WORDS - 1)) {
    printf("SLV_STAGE_BAD alias\n");
    return 2;
  }

  ilm_fn f = (ilm_fn) (uintptr_t) (ILM_LOCAL + ILM_FN_OFF);
  const uint32_t x = 0x4321u;
  const uint32_t want = (x ^ imm) + 0x321u;
  if (f(x) != want) {
    printf("SLV_STAGE_BAD exec\n");
    return 2;
  }
  printf("SLV staged\n");

  andesim_ROI_begin();
  int rc = slv_check(f, x, want, insn0);
  andesim_ROI_end();
  /* ROI end symbol for --pc-end: the point right after the call. */
  __asm__ __volatile__(".globl slv_roi_end\nslv_roi_end:" ::: "memory");

  return rc;
}
