-include ../../Make.var

# EEMBC-standard config; ITERATIONS is a knob (1 is enough for a
# cycle-accurate figure and still validates the CRCs).
ITERATIONS ?= 1
COREMARK_DEFS := -DTOTAL_DATA_SIZE=2000 -DPERFORMANCE_RUN=1 \
                 -DITERATIONS=$(ITERATIONS) -DSEED_METHOD=SEED_VOLATILE \
                 -DMEM_METHOD=MEM_MALLOC

SRCS := core_list_join.c core_main.c core_matrix.c core_state.c \
        core_util.c core_portme.c

all: coremark.elf coremark.dump

coremark.elf: $(SRCS) coremark.h core_portme.h
	$(CC) $(CFLAGS) $(COREMARK_DEFS) -I. $(SRCS) -o $@

coremark.dump: coremark.elf
	$(OBJDUMP) -d $< > $@

# The four andesim modes, one target each. Same ELF everywhere.
coremark-fast: coremark.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

coremark-cycle: coremark.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

coremark-hybrid-marker: coremark.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

# The ROI boundaries are the port layer's timing functions themselves.
coremark-hybrid-pc: coremark.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start start_time --pc-end stop_time \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: coremark-fast coremark-cycle coremark-hybrid-marker coremark-hybrid-pc

clean:
	- rm -f coremark.elf coremark.dump

.PHONY: all run clean coremark-fast coremark-cycle coremark-hybrid-marker coremark-hybrid-pc
