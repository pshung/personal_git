/*
 * CoreMark port for andesim-demo.
 *
 * Timing is based on the RISC-V cycle counter so the benchmark can run inside
 * the simulator without relying on host time APIs.
 *
 * The andesim ROI markers live HERE, in the port layer, not in the EEMBC
 * benchmark sources: start_time() opens the ROI, stop_time() closes it, so
 * the hybrid window is exactly the region CoreMark itself times. The markers
 * are HINT NOPs, so fast and cycle runs are unaffected. On hybrid the run
 * ends at stop_time()'s marker (that is where the cycle figure is drained),
 * so CoreMark's own report after the timed run prints on fast and cycle only.
 */

#include <stdio.h>
#include <stdlib.h>
#include <andesim/ROI.h>

#include "coremark.h"

#if (MEM_METHOD == MEM_MALLOC)
void *
portable_malloc(size_t size)
{
    return malloc(size);
}

void
portable_free(void *p)
{
    free(p);
}
#else
void *
portable_malloc(size_t size)
{
    (void)size;
    return NULL;
}

void
portable_free(void *p)
{
    (void)p;
}
#endif

#if (SEED_METHOD == SEED_VOLATILE)
#if VALIDATION_RUN
volatile ee_s32 seed1_volatile = 0x3415;
volatile ee_s32 seed2_volatile = 0x3415;
volatile ee_s32 seed3_volatile = 0x66;
#endif
#if PERFORMANCE_RUN
volatile ee_s32 seed1_volatile = 0x0;
volatile ee_s32 seed2_volatile = 0x0;
volatile ee_s32 seed3_volatile = 0x66;
#endif
#if PROFILE_RUN
volatile ee_s32 seed1_volatile = 0x8;
volatile ee_s32 seed2_volatile = 0x8;
volatile ee_s32 seed3_volatile = 0x8;
#endif
volatile ee_s32 seed4_volatile = ITERATIONS;
volatile ee_s32 seed5_volatile = 0;
#endif

#define TIMER_RES_DIVIDER 50000
#define EE_TICKS_PER_SEC (1000000000 / TIMER_RES_DIVIDER)

static CORE_TICKS start_time_val;
static CORE_TICKS stop_time_val;

static CORE_TICKS
read_cycle_counter(void)
{
    unsigned long cycle;

    asm volatile("csrr %0, mcycle" : "=r"(cycle));
    return (CORE_TICKS)cycle;
}

/* ROI markers sit OUTSIDE the mcycle reads, so CoreMark's own tick count
 * is a subset of the hybrid window: cycle mode's "Total ticks" and the
 * hybrid "[andesim] N cycles" figure measure the same region. */
void
start_time(void)
{
    andesim_ROI_begin();
    start_time_val = read_cycle_counter();
}

void
stop_time(void)
{
    stop_time_val = read_cycle_counter();
    andesim_ROI_end();
}

CORE_TICKS
get_time(void)
{
    return (CORE_TICKS)(stop_time_val - start_time_val);
}

secs_ret
time_in_secs(CORE_TICKS ticks)
{
    return ((secs_ret)ticks) / (secs_ret)EE_TICKS_PER_SEC;
}

ee_u32 default_num_contexts = 1;

void
portable_init(core_portable *p, int *argc, char *argv[])
{
    (void)argc;
    (void)argv;

    if (sizeof(ee_ptr_int) != sizeof(ee_u8 *))
    {
        ee_printf("ERROR! Please define ee_ptr_int to a type that holds a pointer!\n");
    }
    if (sizeof(ee_u32) != 4)
    {
        ee_printf("ERROR! Please define ee_u32 to a 32b unsigned type!\n");
    }
    p->portable_id = 1;
}

void
portable_fini(core_portable *p)
{
    p->portable_id = 0;
}
