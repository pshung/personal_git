/* One ELF, four andesim runs:
 *
 *   hello-fast           --mode fast: QEMU only, full speed
 *   hello-cycle          --mode cycle: vsim from reset, cycle-accurate
 *   hello-hybrid-marker  --mode hybrid --trigger marker: QEMU fast-forwards
 *                        the boot, vsim measures the region between the
 *                        ROI markers
 *   hello-hybrid-pc      --mode hybrid --trigger pc --pc-start say_hello
 *                        --pc-end hello_roi_end: same window, named by
 *                        symbols instead of markers
 *
 * The ROI markers are RISC-V HINT instructions (architectural NOPs), so
 * this one binary runs unchanged on every engine and on silicon.
 */

#include <stdio.h>
#include <andesim/ROI.h>

__attribute__((noinline)) void say_hello(void)
{
  printf("hello from andesim!\n");
}

int main(void)
{
  andesim_ROI_begin();
  say_hello();
  andesim_ROI_end();
  /* ROI end symbol for --pc-end: the point right after the call. */
  __asm__ __volatile__(".globl hello_roi_end\nhello_roi_end:" ::: "memory");
  return 0;
}
