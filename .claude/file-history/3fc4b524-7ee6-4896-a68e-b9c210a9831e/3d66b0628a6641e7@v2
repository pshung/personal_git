-include ../../Make.var

all: hello.elf hello.dump

hello.elf: main.c
	$(CC) $(CFLAGS) $< -o $@

hello.dump: hello.elf
	$(OBJDUMP) -d $< > $@

# The four andesim modes, one target each. Same ELF everywhere.
hello-fast: hello.elf
	$(ANDESIM_BIN) --mode fast $(ANDESIM_FLAGS) $<

hello-cycle: hello.elf
	$(ANDESIM_BIN) --mode cycle --engine $(ENGINE) $(ANDESIM_FLAGS) $<

hello-hybrid-marker: hello.elf
	$(ANDESIM_BIN) --mode hybrid --trigger marker --engine $(ENGINE) $(ANDESIM_FLAGS) $<

hello-hybrid-pc: hello.elf
	$(ANDESIM_BIN) --mode hybrid --trigger pc \
	    --pc-start say_hello --pc-end hello_roi_end \
	    --engine $(ENGINE) $(ANDESIM_FLAGS) $<

run: hello-fast hello-cycle hello-hybrid-marker hello-hybrid-pc

clean:
	- rm -f hello.elf hello.dump

.PHONY: all run clean hello-fast hello-cycle hello-hybrid-marker hello-hybrid-pc
