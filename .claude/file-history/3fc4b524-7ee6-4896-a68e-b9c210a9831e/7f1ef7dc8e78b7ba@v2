QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;

typedef struct {
    struct qemu_plugin_register *gpr[32];
    struct qemu_plugin_register *fpr[32];
    struct qemu_plugin_register *fcsr;  // L20: frm[7:5] | fflags[4:0]
    struct qemu_plugin_register *pc;
    struct qemu_plugin_register *priv;  // L6: gdbstub virtual feature

    // M-mode CSRs as exposed by QEMU's gdbstub csr feature.
    struct qemu_plugin_register *mstatus;
    struct qemu_plugin_register *mepc;
    struct qemu_plugin_register *mtvec;
    struct qemu_plugin_register *mcause;
    struct qemu_plugin_register *mtval;
    struct qemu_plugin_register *mscratch;
    struct qemu_plugin_register *medeleg;
    struct qemu_plugin_register *mideleg;
    struct qemu_plugin_register *mip;
    struct qemu_plugin_register *mie;
    struct qemu_plugin_register *mcycle;
    struct qemu_plugin_register *minstret;
    struct qemu_plugin_register *satp;

    // Andes custom machine setup CSRs (crt0 writes these at boot). mcache_ctl
    // enables the L1 caches; without transporting it the cycle engine resumes
    // with caches off. Absent on non-Andes stubs -> NULL handle -> drains 0.
    struct qemu_plugin_register *mcache_ctl;
    struct qemu_plugin_register *mmisc_ctl;

    // Andes V5 CSR block (v3). HYBRID_ANDES_CSR_LIST is the shared source of
    // truth; a NULL handle (non-Andes stub) drains 0 -> tolerant no-op.
#define HYBRID_ANDES_FIELD(field, addr, name) \
    struct qemu_plugin_register *andes_##field;
    HYBRID_ANDES_CSR_LIST(HYBRID_ANDES_FIELD)
#undef HYBRID_ANDES_FIELD
    struct qemu_plugin_register *pmacfg[HYBRID_PMA_CFG_NUM];
    struct qemu_plugin_register *pmaaddr[HYBRID_PMA_ADDR_NUM];

    // M-ext CSR block (v4). Same shared X-macro; a NULL handle (the stub's
    // gdbstub does not advertise this CSR for the paired cpu) drains 0.
#define HYBRID_M_EXT_FIELD(field, addr, name) \
    struct qemu_plugin_register *m_ext_##field;
    HYBRID_M_EXT_CSR_LIST(HYBRID_M_EXT_FIELD)
#undef HYBRID_M_EXT_FIELD

    struct qemu_plugin_register *pmpcfg[HYBRID_PMP_CFG_NUM];
    struct qemu_plugin_register *pmpaddr[HYBRID_PMP_ADDR_NUM];

    struct qemu_plugin_register *vstart;
    struct qemu_plugin_register *vxsat;
    struct qemu_plugin_register *vxrm;
    struct qemu_plugin_register *vcsr;
    struct qemu_plugin_register *vtype;
    struct qemu_plugin_register *vl;
    struct qemu_plugin_register *vlenb;
    struct qemu_plugin_register *vreg[32];
} VcpuRegs;

static struct qemu_plugin_scoreboard *vcpu_state;
static char *outfile_path;

// PC-trigger mode: when enter_pc_arg is non-zero (set via plugin arg
// `enter_pc=0x...`), the CSR-insn matcher is bypassed entirely and the
// drain callback is registered only for instructions whose vaddr equals
// enter_pc_arg. The kind reported on the drain is HYBRID_HANDOFF_ENTER
// (entry into vsim), matching marker-mode enter-marker semantics.
static uint64_t enter_pc_arg;
static int pc_mode;

// Oracle exit-drain mode (verify_oracle F1): when exit_marker_mode or
// exit_pc_mode is set (plugin args `exit_marker=1` / `exit_pc=0x...`), a
// pure-QEMU run produces the differential verifier's reference state. Every
// insn gets an exec callback: the tick ARMS on the
// ROI exit boundary (EXIT marker match, or vaddr == exit_pc) and DRAINS on
// the next callback. Exec callbacks fire before their insn executes, so the
// armed drain captures "after the boundary insn retired" -- exactly vsim's
// exit-drain record (DPC = next insn to execute) -- and reports that next
// insn's vaddr as pc, correct even when the boundary insn branches.
// Exclusive with the other trigger modes: the oracle run never hands off.
//
// drain_pc=0x... (optional modifier): drain at the first post-arm tick whose
// vaddr equals drain_pc, instead of the very next tick. The differential
// harness passes vsim's actual drained pc here: vsim's DMI halt lands a
// variable 0-3 insns past the trigger (the core keeps retiring while the
// haltreq propagates), and the two states only compare equal when both
// sides sample the SAME architectural point. If vsim's pc is never reached
// (a real control-flow divergence), the oracle never drains and QEMU runs
// to completion -- the caller sees exit != 200.
static uint64_t exit_pc_arg;
static int      exit_pc_mode;
static int      exit_marker_mode;
static uint64_t drain_pc_arg;
static int      drain_pc_set;
// v5: L2C MMIO register base. DS220 24.2 maps the AE350 L2C block at 0xE0500000;
// overridable via `l2c_base=0x...` for a platform with a relocated block.
static uint64_t l2c_base_arg = 0xE0500000ull;

// LM transport (F1): hart-0 local-memory slave-port windows (AE350 memmap).
// When ilm_size/dlm_size/hvm_size are non-zero the drain also captures that
// many bytes of ILM/DLM/HVM CONTENT into raw sidecar files
// "<outfile>.ilm"/".dlm"/".hvm", for the vsim leg's --ilm/--dlm/--hvm
// backdoor load. The LM slave-port aperture is used (never the hart-local
// view: its ILM base 0x0 is also DRAM 0x0); HVM has only the one aperture
// (plain RAM at hvm_base, no enable bit). Size 0 (the default) = the paired
// engine has no such memory -> nothing read, no file written.
static uint64_t ilm_base_arg = 0xA0000000ull;
static uint64_t dlm_base_arg = 0xA0200000ull;
static uint64_t hvm_base_arg = 0x90000000ull;
static uint64_t ilm_size_arg;
static uint64_t dlm_size_arg;
static uint64_t hvm_size_arg;

// Forwarded driver verbosity (plugin arg `log_level=N`, vsim's spdlog scale:
// 0=trace 1=debug 2=info ... 6=off). Chatter prints only at <= debug.
static uint64_t log_level_arg = 2;
static volatile int oracle_armed;

// v6: which mask-governed config CSRs the guest has WRITTEN so far
// (hybrid/write_mask.h slot numbering). Marked by per-insn exec callbacks that
// are registered ONLY on instructions whose translate-time decode says "writes
// a governed CSR" -- steady-state code carries no instrumentation. Single-hart
// flow (like the rest of the handoff); atomics keep a future SMP guest safe.
static uint64_t csr_write_mask[2];

static void on_csr_write(unsigned int vcpu_idx, void *udata)
{
    (void) vcpu_idx;
    const unsigned slot = (unsigned) (uintptr_t) udata;
    __atomic_fetch_or(&csr_write_mask[slot >> 6],
                      (uint64_t) 1 << (slot & 63u), __ATOMIC_RELAXED);
}

static struct qemu_plugin_register *find_reg(GArray *regs, const char *name)
{
    for (guint i = 0; i < regs->len; i++) {
        qemu_plugin_reg_descriptor *rd =
            &g_array_index(regs, qemu_plugin_reg_descriptor, i);
        if (g_ascii_strcasecmp(rd->name, name) == 0) {
            return rd->handle;
        }
    }
    return NULL;
}

// Lazily resolves register handles. The plugin's vcpu_init runs before
// QEMU has registered the dynamic gdb coprocessors (FPU, virtual, csr,
// vector), so qemu_plugin_get_registers() returns only the 33 core CPU
// regs at that moment. By the time the entry trigger fires, all dynamic
// features are registered and a fresh call returns the full list.
static void resolve_handles(VcpuRegs *v)
{
    g_autoptr(GArray) regs = qemu_plugin_get_registers();
    for (int i = 0; i < 32; i++) {
        v->gpr[i] = find_reg(regs, hybrid_gpr_names[i]);
        v->fpr[i] = find_reg(regs, hybrid_fpr_names[i]);
    }
    v->fcsr = find_reg(regs, "fcsr");
    v->pc = find_reg(regs, "pc");
    v->priv = find_reg(regs, "priv");

    v->mstatus  = find_reg(regs, "mstatus");
    v->mepc     = find_reg(regs, "mepc");
    v->mtvec    = find_reg(regs, "mtvec");
    v->mcause   = find_reg(regs, "mcause");
    v->mtval    = find_reg(regs, "mtval");
    v->mscratch = find_reg(regs, "mscratch");
    v->medeleg  = find_reg(regs, "medeleg");
    v->mideleg  = find_reg(regs, "mideleg");
    v->mip      = find_reg(regs, "mip");
    v->mie      = find_reg(regs, "mie");
    v->mcycle   = find_reg(regs, "mcycle");
    v->minstret = find_reg(regs, "minstret");
    v->satp     = find_reg(regs, "satp");

    v->mcache_ctl = find_reg(regs, "mcache_ctl");
    v->mmisc_ctl  = find_reg(regs, "mmisc_ctl");

    char buf[16];

    // Andes V5 CSR block (v3): resolve by gdb mnemonic from the shared X-macro.
#define HYBRID_ANDES_FIELD(field, addr, name) v->andes_##field = find_reg(regs, name);
    HYBRID_ANDES_CSR_LIST(HYBRID_ANDES_FIELD)
#undef HYBRID_ANDES_FIELD

    // M-ext CSR block (v4): resolve by gdb mnemonic (NULL if the stub does not
    // advertise it for the paired cpu).
#define HYBRID_M_EXT_FIELD(field, addr, name) v->m_ext_##field = find_reg(regs, name);
    HYBRID_M_EXT_CSR_LIST(HYBRID_M_EXT_FIELD)
#undef HYBRID_M_EXT_FIELD
    for (int i = 0; i < HYBRID_PMA_CFG_NUM; i++) {
        // RV64 packs 8 PMA entries per cfg CSR, so only even cfg CSRs exist.
        g_snprintf(buf, sizeof(buf), "pmacfg%d", 2 * i);
        v->pmacfg[i] = find_reg(regs, buf);
    }
    for (int i = 0; i < HYBRID_PMA_ADDR_NUM; i++) {
        g_snprintf(buf, sizeof(buf), "pmaaddr%d", i);
        v->pmaaddr[i] = find_reg(regs, buf);
    }
    for (int i = 0; i < HYBRID_PMP_CFG_NUM; i++) {
        g_snprintf(buf, sizeof(buf), "pmpcfg%d", i);
        v->pmpcfg[i] = find_reg(regs, buf);
    }
    for (int i = 0; i < HYBRID_PMP_ADDR_NUM; i++) {
        g_snprintf(buf, sizeof(buf), "pmpaddr%d", i);
        v->pmpaddr[i] = find_reg(regs, buf);
    }

    v->vstart = find_reg(regs, "vstart");
    v->vxsat  = find_reg(regs, "vxsat");
    v->vxrm   = find_reg(regs, "vxrm");
    v->vcsr   = find_reg(regs, "vcsr");
    v->vtype  = find_reg(regs, "vtype");
    v->vl     = find_reg(regs, "vl");
    v->vlenb  = find_reg(regs, "vlenb");
    for (int i = 0; i < 32; i++) {
        g_snprintf(buf, sizeof(buf), "v%d", i);
        v->vreg[i] = find_reg(regs, buf);
    }
}

static uint64_t read_reg64(struct qemu_plugin_register *h)
{
    if (!h) return 0;
    g_autoptr(GByteArray) buf = g_byte_array_new();
    int sz = qemu_plugin_read_register(h, buf);
    if (sz <= 0) return 0;
    uint64_t v = 0;
    memcpy(&v, buf->data, sz < 8 ? (size_t) sz : 8);
    return v;
}

// Reads up to `dst_max` bytes from a register handle. Returns the byte
// count written (0 on failure or NULL handle). Used for vector regs whose
// width = vlenb bytes.
static size_t read_reg_bytes(struct qemu_plugin_register *h,
                             uint8_t *dst, size_t dst_max)
{
    if (!h || dst_max == 0) return 0;
    g_autoptr(GByteArray) buf = g_byte_array_new();
    int sz = qemu_plugin_read_register(h, buf);
    if (sz <= 0) return 0;
    size_t n = (size_t) sz < dst_max ? (size_t) sz : dst_max;
    memcpy(dst, buf->data, n);
    return n;
}

// Atomic on POSIX: write to a mkstemp-reserved tmp file, fsync, rename.
// mkstemp guarantees uniqueness via a 6-char random suffix + atomic
// O_EXCL-style inode reservation, so concurrent plugin instances cannot
// collide even under aggressive PID reuse (B13). The tmp lives in the
// same directory as `path` so the rename is intra-filesystem.
static int write_blob_atomic(const void *data, size_t len, const char *path)
{
    char tmp[PATH_MAX];
    int n = g_snprintf(tmp, sizeof(tmp), "%s.tmp.XXXXXX", path);
    if (n < 0 || (size_t) n >= sizeof(tmp)) {
        fprintf(stderr, "hybrid_handoff: tmp path too long\n");
        return -1;
    }
    int fd = g_mkstemp(tmp);
    if (fd < 0) {
        perror("hybrid_handoff: g_mkstemp");
        return -1;
    }
    // g_mkstemp creates the file 0600; no further chmod needed.
    ssize_t got = write(fd, data, len);
    if (got != (ssize_t) len) {
        perror("hybrid_handoff: write");
        close(fd);
        unlink(tmp);
        return -1;
    }
    fsync(fd);
    close(fd);
    if (rename(tmp, path) != 0) {
        perror("hybrid_handoff: rename");
        unlink(tmp);
        return -1;
    }
    return 0;
}

static int write_state_atomic(const struct hybrid_state_v1 *s, const char *path)
{
    return write_blob_atomic(s, sizeof(*s), path);
}

// Drain CPU state into `*s`. pc is computed by the caller (from a
// HandoffSite for trigger paths).
static void drain_state_into(unsigned int vcpu_idx, uint64_t pc,
                             struct hybrid_state_v1 *sp)
{
    VcpuRegs *v = qemu_plugin_scoreboard_find(vcpu_state, vcpu_idx);
    resolve_handles(v);
    memset(sp, 0, sizeof(*sp));
    struct hybrid_state_v1 s = {0};
    s.magic   = HYBRID_STATE_MAGIC;
    s.version = HYBRID_STATE_VERSION;
    s.flags   = HYBRID_FLAG_RV64;
    s.hart_id = vcpu_idx;
    // L6: real privilege at the boundary; M-mode fallback only when the
    // stub doesn't advertise the gdbstub virtual feature (a missing handle
    // reads as 0 = U, which would silently demote the hart).
    s.priv    = v->priv ? (read_reg64(v->priv) & 0x3) : 3;
    s.pc      = pc;
    for (int i = 0; i < 32; i++) s.gpr[i] = read_reg64(v->gpr[i]);

    // Floating-point: only set FP flag if at least one handle was bound,
    // i.e. QEMU advertised the FPU feature (D extension).
    int has_fp = 0;
    for (int i = 0; i < 32; i++) {
        s.fpr[i] = read_reg64(v->fpr[i]);
        if (v->fpr[i]) has_fp = 1;
    }
    if (has_fp) s.flags |= HYBRID_FLAG_FP;
    s.fcsr = read_reg64(v->fcsr);  // L20: rides HYBRID_FLAG_FP

    s.mstatus  = read_reg64(v->mstatus);
    s.mepc     = read_reg64(v->mepc);
    s.mtvec    = read_reg64(v->mtvec);
    s.mcause   = read_reg64(v->mcause);
    s.mtval    = read_reg64(v->mtval);
    s.mscratch = read_reg64(v->mscratch);
    s.medeleg  = read_reg64(v->medeleg);
    s.mideleg  = read_reg64(v->mideleg);
    s.mip      = read_reg64(v->mip);
    s.mie      = read_reg64(v->mie);
    s.mcycle   = read_reg64(v->mcycle);
    s.minstret = read_reg64(v->minstret);
    s.satp     = read_reg64(v->satp);

    // Andes cache fix: carry crt0's cache-enable so the cycle engine resumes
    // with caches on (NULL handle on a non-Andes stub reads back as 0).
    s.mcache_ctl = read_reg64(v->mcache_ctl);
    s.mmisc_ctl  = read_reg64(v->mmisc_ctl);

    // Andes V5 CSR block (v3): drain every transported Andes CSR. Set
    // HYBRID_FLAG_ANDES if the stub advertised at least one (mirrors has_fp/
    // has_v); otherwise the block stays zero and consumers skip it. A NULL
    // handle on a non-Andes stub reads back as 0 -> tolerant.
    int has_andes = 0;
#define HYBRID_ANDES_FIELD(field, addr, name)  \
    s.andes.field = read_reg64(v->andes_##field); \
    if (v->andes_##field) has_andes = 1;
    HYBRID_ANDES_CSR_LIST(HYBRID_ANDES_FIELD)
#undef HYBRID_ANDES_FIELD
    for (int i = 0; i < HYBRID_PMA_CFG_NUM; i++) {
        s.andes.pmacfg[i] = read_reg64(v->pmacfg[i]);
        if (v->pmacfg[i]) has_andes = 1;
    }
    for (int i = 0; i < HYBRID_PMA_ADDR_NUM; i++) {
        s.andes.pmaaddr[i] = read_reg64(v->pmaaddr[i]);
        if (v->pmaaddr[i]) has_andes = 1;
    }
    if (has_andes) s.flags |= HYBRID_FLAG_ANDES;

    // M-ext CSR block (v4): drain every transported M-mode CSR the stub
    // advertised. Set HYBRID_FLAG_M_EXT if at least one resolved; a NULL handle
    // reads 0. The vsim caps gate decides which of these the cycle engine
    // actually restores, so draining an absent-on-vsim CSR here is harmless.
    int has_m_ext = 0;
#define HYBRID_M_EXT_FIELD(field, addr, name)  \
    s.m_ext.field = read_reg64(v->m_ext_##field); \
    if (v->m_ext_##field) has_m_ext = 1;
    HYBRID_M_EXT_CSR_LIST(HYBRID_M_EXT_FIELD)
#undef HYBRID_M_EXT_FIELD
    if (has_m_ext) s.flags |= HYBRID_FLAG_M_EXT;

    for (int i = 0; i < HYBRID_PMP_CFG_NUM; i++)
        s.pmpcfg[i] = read_reg64(v->pmpcfg[i]);
    for (int i = 0; i < HYBRID_PMP_ADDR_NUM; i++)
        s.pmpaddr[i] = read_reg64(v->pmpaddr[i]);

    // Vector: only set V flag if QEMU advertised the V extension. vlenb
    // bounds the per-register byte count copied into vreg[]. The policy
    // helper (hybrid_v_drain_policy) decides SKIP/OK/ABORT from the
    // handle truthiness so we don't conflate "stub missing vlenb" with
    // "V disabled at runtime"; see include/hybrid/v_drain_policy.h.
    s.vstart = read_reg64(v->vstart);
    s.vxsat  = read_reg64(v->vxsat);
    s.vxrm   = read_reg64(v->vxrm);
    s.vcsr   = read_reg64(v->vcsr);
    s.vtype  = read_reg64(v->vtype);
    s.vl     = read_reg64(v->vl);
    s.vlenb  = read_reg64(v->vlenb);
    int has_other_v = (v->vstart || v->vxsat || v->vxrm || v->vcsr
                       || v->vtype || v->vl);
    if (!has_other_v) {
        for (int i = 0; i < 32; i++)
            if (v->vreg[i]) { has_other_v = 1; break; }
    }
    HybridVDrainPolicy vpol = hybrid_v_drain_policy(
        v->vlenb != NULL, has_other_v, s.vlenb);
    if (vpol == HYBRID_V_DRAIN_ABORT) {
        if (v->vlenb == NULL)
            fprintf(stderr,
                    "hybrid_handoff: stub advertised V CSRs/regs but not "
                    "vlenb; refusing to drain partial V state\n");
        else
            fprintf(stderr,
                    "hybrid_handoff: vlenb=%" PRIu64 " exceeds the wire-format "
                    "ceiling HYBRID_VLEN_BYTES_MAX=%d (VLEN %d); refusing to "
                    "truncate V registers\n",
                    s.vlenb, HYBRID_VLEN_BYTES_MAX,
                    8 * HYBRID_VLEN_BYTES_MAX);
        exit(2);
    }
    if (vpol == HYBRID_V_DRAIN_OK) {
        s.flags |= HYBRID_FLAG_V;
        /* The policy guarantees vlenb <= HYBRID_VLEN_BYTES_MAX here, so the
         * full live register fits the wire-format slot -- no clamp (L11). */
        for (int i = 0; i < 32; i++)
            (void) read_reg_bytes(v->vreg[i],
                                  &s.vreg[(size_t) i * HYBRID_VLEN_BYTES_MAX],
                                  (size_t) s.vlenb);
    }

    // v6: which mask-governed CSRs the guest actually wrote (translate-time
    // decode + exec callbacks above). ucode rides transport-always: DSP
    // instructions update its sticky OV flag without any CSR instruction, so
    // instruction-level tracking cannot see those writes (like fcsr's fflags).
    s.write_mask[0] = __atomic_load_n(&csr_write_mask[0], __ATOMIC_RELAXED);
    s.write_mask[1] = __atomic_load_n(&csr_write_mask[1], __ATOMIC_RELAXED);
    hybrid_wm_set(s.write_mask, HYBRID_WM_ANDES_BASE + HYBRID_WM_ANDES_IDX_ucode);
    s.flags |= HYBRID_FLAG_WRITE_MASK;

    // v5: L2C MMIO register window (DS220 11.8.5 Table 112, offsets
    // 0x0000..0x0527). Read the whole documented block from the L2C base by
    // PHYSICAL address (paging is off in the M-mode boot flow, so VA==PA anyway).
    // QEMU's AE350 machine maps L2C as a device region; if the read fails (a
    // machine without an L2C), the flag stays clear and consumers skip the
    // block. Little-endian native host, so the raw bytes land directly in
    // s.l2c.reg[]. The vsim side gates restore on its OWN L2C presence, so
    // setting the flag whenever QEMU can read the region is correct.
    {
        g_autoptr(GByteArray) l2c = g_byte_array_new();
        enum qemu_plugin_hwaddr_operation_result r =
            qemu_plugin_read_memory_hwaddr(l2c_base_arg, l2c,
                                           HYBRID_L2C_REG_WINDOW_BYTES);
        if (r == QEMU_PLUGIN_HWADDR_OPERATION_OK
            && l2c->len == HYBRID_L2C_REG_WINDOW_BYTES) {
            memcpy(s.l2c.reg, l2c->data, HYBRID_L2C_REG_WINDOW_BYTES);
            s.flags |= HYBRID_FLAG_L2C;
        }
    }

    *sp = s;
}

// LM sidecar drain: read `size` bytes of local memory at physical `base`
// (the slave-port aperture) into "<state_path><suffix>". Failure is as hard
// an error as a failed state write: the caller asked for this memory
// (size > 0), so a missing/short sidecar must not masquerade as a clean
// handoff -- the vsim leg would silently resume with an empty ILM/DLM,
// exactly the bug this transport exists to fix.
static void drain_lm_sidecar(const char *state_path, const char *suffix,
                             uint64_t base, uint64_t size)
{
    if (size == 0) return;
    g_autofree char *path = g_strdup_printf("%s%s", state_path, suffix);
    g_autoptr(GByteArray) buf = g_byte_array_new();
    enum qemu_plugin_hwaddr_operation_result r =
        qemu_plugin_read_memory_hwaddr(base, buf, size);
    if (r != QEMU_PLUGIN_HWADDR_OPERATION_OK || buf->len != size) {
        fprintf(stderr,
                "hybrid_handoff: cannot read %" PRIu64 " bytes of local "
                "memory at %#" PRIx64 " (result %d)\n", size, base, (int) r);
        exit(2);
    }
    if (write_blob_atomic(buf->data, buf->len, path) != 0) {
        fprintf(stderr, "hybrid_handoff: failed to write %s\n", path);
        exit(2);
    }
}

// Drain CPU state to `path`. Does NOT call exit -- the caller decides
// exit(200).
static void drain_state_to_file(unsigned int vcpu_idx, uint64_t pc,
                                const char *path)
{
    struct hybrid_state_v1 s;
    drain_state_into(vcpu_idx, pc, &s);
    if (write_state_atomic(&s, path) != 0) {
        fprintf(stderr, "hybrid_handoff: failed to write state file\n");
        exit(2);
    }
    // LM transport (F1) + HVM transport (F2): content sidecars ride next to
    // the state file; this is the single choke point, so every trigger mode
    // (marker/pc/oracle) gets them.
    drain_lm_sidecar(path, ".ilm", ilm_base_arg, ilm_size_arg);
    drain_lm_sidecar(path, ".dlm", dlm_base_arg, dlm_size_arg);
    drain_lm_sidecar(path, ".hvm", hvm_base_arg, hvm_size_arg);
    if (log_level_arg <= 1) {
        fprintf(stderr,
                "[hybrid_handoff] drained state to %s (pc=%#" PRIx64
                ", flags=%#x, vlenb=%" PRIu64 ")\n",
                path, s.pc, s.flags, (uint64_t) s.vlenb);
    }
}

// Shared drain tail: capture the (pre-execution) state, report `resume_pc`
// as the vsim resume point, and exit 200.
static void handoff_drain(unsigned int vcpu_idx, uint64_t resume_pc)
{
    drain_state_to_file(vcpu_idx, resume_pc, outfile_path);
    // 200 == kExitHandoffToQemu in the vsim repo's src/hybrid/exit_codes.hpp.
    // Distinguishes drain from workload completion (0) so the orchestrator
    // can decide the next spawn.
    exit(200);
}

// Marker sites. The marker is an architectural NOP, so the pre-execution
// state equals the post-retire state and the window resumes AFTER it
// (vaddr+size, computed at translation time; reading the gdbstub PC inside
// the exec callback can lag the actual current insn when V instructions
// retire just before the trigger -- TCG defers PC writes for performance).
static void on_handoff(unsigned int vcpu_idx, void *udata)
{
    const HandoffSite *site = (const HandoffSite *) udata;
    if (site->kind != HYBRID_HANDOFF_ENTER) return;
    handoff_drain(vcpu_idx, compute_handoff_pc(site));
}

// pc boundary sites. Exec callbacks fire BEFORE the insn
// executes, and the boundary insn is real user code (unlike a marker NOP):
// the drained state must resume AT the boundary so the insn executes inside
// the vsim window rather than on neither leg. (Skipping it corrupts the
// window's architectural state -- e.g. a skipped vsetivli leaves vtype.vill
// set and the first vector op of the window faults.)
static void on_handoff_boundary(unsigned int vcpu_idx, void *udata)
{
    const HandoffSite *site = (const HandoffSite *) udata;
    if (site->kind != HYBRID_HANDOFF_ENTER) return;
    handoff_drain(vcpu_idx, site->vaddr);
}

// Per-insn tick for oracle exit-drain mode. udata is this insn's HandoffSite.
// When armed (the exit boundary's own tick ran), this tick fires before its
// insn executes, so a drain here records the post-retire state of the
// boundary insn with pc = the dynamically-next insn's vaddr.
static void on_oracle_tick(unsigned int vcpu_idx, void *udata)
{
    const HandoffSite *site = (const HandoffSite *) udata;
    if (oracle_armed
        && (!drain_pc_set || site->vaddr == drain_pc_arg)) {
        handoff_drain(vcpu_idx, site->vaddr);
    }
    if (exit_pc_mode ? (site->vaddr == exit_pc_arg)
                     : (site->kind == HYBRID_HANDOFF_EXIT)) {
        oracle_armed = 1;
    }
}

static void vcpu_tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
{
    (void) id;
    size_t n = qemu_plugin_tb_n_insns(tb);

    for (size_t i = 0; i < n; i++) {
        struct qemu_plugin_insn *insn = qemu_plugin_tb_get_insn(tb, i);

        // v6: CSR write-mask tracking, active in every trigger mode (the mode
        // branches below `continue`). Decoded once at translation; only an
        // instruction that writes a mask-governed CSR gets an exec callback
        // (the CSR address is a static field of the encoding), so this costs
        // nothing at execution time outside boot-style CSR setup code. No
        // compressed CSR instruction exists, so the size==4 gate is exact.
        if (qemu_plugin_insn_size(insn) == 4) {
            uint32_t w = 0;
            if (qemu_plugin_insn_data(insn, &w, sizeof(w)) == sizeof(w)) {
                const int slot = hybrid_wm_slot_for_insn(w);
                if (slot >= 0)
                    qemu_plugin_register_vcpu_insn_exec_cb(
                        insn, on_csr_write, QEMU_PLUGIN_CB_NO_REGS,
                        (void *) (uintptr_t) slot);
            }
        }

        // Oracle exit-drain mode: exclusive with every other mode (enforced
        // at install), so it owns the insn's registration outright. The site
        // carries the marker kind so the tick can arm on the EXIT marker.
        if (exit_marker_mode || exit_pc_mode) {
            HandoffSite *site = g_new0(HandoffSite, 1);
            site->kind  = HYBRID_HANDOFF_NONE;
            site->vaddr = qemu_plugin_insn_vaddr(insn);
            site->size  = (uint32_t) qemu_plugin_insn_size(insn);
            if (exit_marker_mode && site->size == 4) {
                uint32_t raw = 0;
                if (qemu_plugin_insn_data(insn, &raw, sizeof(raw)) == sizeof(raw))
                    hybrid_match_handoff_insn(raw, &site->kind);
            }
            qemu_plugin_register_vcpu_insn_exec_cb(
                insn, on_oracle_tick, QEMU_PLUGIN_CB_R_REGS, site);
            continue;
        }

        if (pc_mode) {
            // PC-trigger mode: vaddr-only match; the drain resumes AT the
            // boundary (on_handoff_boundary), so the insn size is recorded
            // only for completeness.
            if (qemu_plugin_insn_vaddr(insn) != enter_pc_arg) continue;
            HandoffSite *site = g_new0(HandoffSite, 1);
            site->kind  = HYBRID_HANDOFF_ENTER;
            site->vaddr = qemu_plugin_insn_vaddr(insn);
            site->size  = (uint32_t) qemu_plugin_insn_size(insn);
            qemu_plugin_register_vcpu_insn_exec_cb(
                insn, on_handoff_boundary, QEMU_PLUGIN_CB_R_REGS, site);
            continue;
        }

        // Marker-trigger mode (default).
        // The markers are `slti x0, x0, 0x5A0/0x5A1`, always 32-bit
        // (sz==4): SLTI has no compressed form, so the sz!=4 skip is
        // exact, not an approximation.
        size_t sz = qemu_plugin_insn_size(insn);
        if (sz != 4) continue;
        uint32_t raw = 0;
        if (qemu_plugin_insn_data(insn, &raw, sizeof(raw)) != sizeof(raw))
            continue;
        hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
        if (!hybrid_match_handoff_insn(raw, &kind)) continue;
        HandoffSite *site = g_new0(HandoffSite, 1);
        site->kind  = kind;
        site->vaddr = qemu_plugin_insn_vaddr(insn);
        site->size  = (uint32_t) sz;
        qemu_plugin_register_vcpu_insn_exec_cb(
            insn, on_handoff, QEMU_PLUGIN_CB_R_REGS, site);
    }
}

// Parse a `name=value` plugin arg's value as u64 (base auto-detected, so
// 0x-hex and decimal both work). Same accept/reject behavior as the previous
// per-option copies of this block. Returns 0 on success, -1 (after printing
// the standard invalid-arg line) on garbage.
static int parse_u64_arg(const char *name, const char *val, uint64_t *out)
{
    char *endp = NULL;
    unsigned long long v = g_ascii_strtoull(val, &endp, 0);
    if (!endp || *endp != '\0') {
        fprintf(stderr, "hybrid_handoff: invalid %s=%s\n", name, val);
        return -1;
    }
    *out = (uint64_t) v;
    return 0;
}

QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
                                           const qemu_info_t *info,
                                           int argc, char **argv)
{
    (void) info;
    for (int i = 0; i < argc; i++) {
        g_auto(GStrv) tok = g_strsplit(argv[i], "=", 2);
        if (g_strcmp0(tok[0], "outfile") == 0 && tok[1]) {
            outfile_path = g_strdup(tok[1]);
        } else if (g_strcmp0(tok[0], "enter_pc") == 0 && tok[1]) {
            if (parse_u64_arg("enter_pc", tok[1], &enter_pc_arg) != 0)
                return -1;
            pc_mode = 1;
        } else if (g_strcmp0(tok[0], "exit_pc") == 0 && tok[1]) {
            if (parse_u64_arg("exit_pc", tok[1], &exit_pc_arg) != 0)
                return -1;
            exit_pc_mode = 1;
        } else if (g_strcmp0(tok[0], "exit_marker") == 0 && tok[1]) {
            uint64_t v;
            if (parse_u64_arg("exit_marker", tok[1], &v) != 0)
                return -1;
            exit_marker_mode = (v != 0);
        } else if (g_strcmp0(tok[0], "drain_pc") == 0 && tok[1]) {
            if (parse_u64_arg("drain_pc", tok[1], &drain_pc_arg) != 0)
                return -1;
            drain_pc_set = 1;
        } else if (g_strcmp0(tok[0], "l2c_base") == 0 && tok[1]) {
            if (parse_u64_arg("l2c_base", tok[1], &l2c_base_arg) != 0)
                return -1;
        } else if (g_strcmp0(tok[0], "ilm_base") == 0 && tok[1]) {
            if (parse_u64_arg("ilm_base", tok[1], &ilm_base_arg) != 0)
                return -1;
        } else if (g_strcmp0(tok[0], "ilm_size") == 0 && tok[1]) {
            if (parse_u64_arg("ilm_size", tok[1], &ilm_size_arg) != 0)
                return -1;
        } else if (g_strcmp0(tok[0], "dlm_base") == 0 && tok[1]) {
            if (parse_u64_arg("dlm_base", tok[1], &dlm_base_arg) != 0)
                return -1;
        } else if (g_strcmp0(tok[0], "dlm_size") == 0 && tok[1]) {
            if (parse_u64_arg("dlm_size", tok[1], &dlm_size_arg) != 0)
                return -1;
        } else if (g_strcmp0(tok[0], "hvm_base") == 0 && tok[1]) {
            if (parse_u64_arg("hvm_base", tok[1], &hvm_base_arg) != 0)
                return -1;
        } else if (g_strcmp0(tok[0], "hvm_size") == 0 && tok[1]) {
            if (parse_u64_arg("hvm_size", tok[1], &hvm_size_arg) != 0)
                return -1;
        } else if (g_strcmp0(tok[0], "log_level") == 0 && tok[1]) {
            if (parse_u64_arg("log_level", tok[1], &log_level_arg) != 0)
                return -1;
        } else {
            fprintf(stderr, "hybrid_handoff: unknown option: %s\n", argv[i]);
            return -1;
        }
    }
    if (!outfile_path) {
        fputs("hybrid_handoff: outfile=PATH is required\n", stderr);
        return -1;
    }
    if (pc_mode) {
        fprintf(stderr,
                "hybrid_handoff: PC-mode enter=0x%" PRIx64 "\n",
                enter_pc_arg);
    }
    if (exit_marker_mode || exit_pc_mode) {
        if ((exit_marker_mode && exit_pc_mode) || pc_mode) {
            fputs("hybrid_handoff: oracle exit drain (exit_marker/exit_pc) "
                  "is exclusive with the other trigger modes\n", stderr);
            return -1;
        }
        if (exit_pc_mode) {
            fprintf(stderr,
                    "hybrid_handoff: oracle exit-drain mode exit_pc=0x%"
                    PRIx64 "\n", exit_pc_arg);
        } else {
            fputs("hybrid_handoff: oracle exit-drain mode (exit marker)\n",
                  stderr);
        }
        if (drain_pc_set) {
            fprintf(stderr, "hybrid_handoff: oracle drain_pc=0x%" PRIx64 "\n",
                    drain_pc_arg);
        }
    } else if (drain_pc_set) {
        fputs("hybrid_handoff: drain_pc requires oracle exit-drain mode "
              "(exit_marker/exit_pc)\n", stderr);
        return -1;
    }

    vcpu_state = qemu_plugin_scoreboard_new(sizeof(VcpuRegs));
    qemu_plugin_register_vcpu_tb_trans_cb(id, vcpu_tb_trans);
    return 0;
}
