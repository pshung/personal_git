// Tests the config.inc-macro -> AndesCaps binding for the mk_core family
// (AX6x series). A separate TU from andes_caps_config.test.cpp because the
// _NDS_* macros are global per translation unit.
//
// ax66_makatau's macro shape, from build/Vax66_makatau/obj_sc/Vax66_config.h.
// Two things distinguish the mk generation:
//  1. identity: NDS_CPUID 0x8a66 -- the series nibble (6) selects the mk_core
//     CSR decoder, whose existence terms differ from kv_csr_dec.v;
//  2. macro naming: plain-integer NDS_* knobs -- there are NO *_INT variants
//     (on kv the base names are hex-encoded strings and only *_INT is numeric).
#define _NDS_CPUID                   0x8a66
#define _NDS_NUM_PRIVILEGE_LEVELS    3
#define _NDS_RVH_SUPPORT             1
#define _NDS_PERFORMANCE_MONITOR     1
#define _NDS_POWERBRAKE_SUPPORT      1
#define _NDS_NUM_TRIGGER             4
#define _NDS_PMA_ENTRIES             16
#define _NDS_ICACHE_SIZE_KB          64
#define _NDS_DCACHE_SIZE_KB          64
#define _NDS_DSP_SUPPORT             0
#define _NDS_CODENSE_SUPPORT         0
#define _NDS_STACKSAFE_SUPPORT       0
#define _NDS_ILM_SIZE_KB             0
#define _NDS_DLM_SIZE_KB             0

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/andes_caps_config.hpp"

using hybrid::AndesGate;

TEST_CASE("mk config macros -> the ax66 gate set (probe-confirmed)")
{
  const auto c = hybrid::andes_caps_from_config();

  // plain-integer macro names (no _INT) must be understood
  CHECK(c.gate_on(AndesGate::PERF_MONITOR));
  CHECK(c.gate_on(AndesGate::POWERBRAKE));
  // mk RTL: unconditional existence regardless of config knobs
  CHECK(c.gate_on(AndesGate::ECC));        // mecc_code
  CHECK(c.gate_on(AndesGate::EPMP));       // mseccfg
  // mk RTL: mstateen0-3 ride RVH_SUPPORT
  CHECK(c.gate_on(AndesGate::SMSTATEEN));
  // privilege levels
  CHECK(c.gate_on(AndesGate::UMODE));
  CHECK(c.gate_on(AndesGate::SMODE));
  // shared-name knobs
  CHECK(c.gate_on(AndesGate::PMA));
  CHECK(c.gate_on(AndesGate::TRIGGER));
  CHECK(c.gate_on(AndesGate::CCTL));

  // mk RTL never decodes these -- gates must stay off even though the
  // "related" features (triggers, U-mode, perf monitor) are on
  CHECK_FALSE(c.gate_on(AndesGate::TCONTROL));
  CHECK_FALSE(c.gate_on(AndesGate::UZOB));
  CHECK_FALSE(c.gate_on(AndesGate::ESLEEP));
  CHECK_FALSE(c.gate_on(AndesGate::PMNDS));      // hard-0 in mk_csr_decode.v
  CHECK_FALSE(c.gate_on(AndesGate::PMNDS_UMODE));
  CHECK_FALSE(c.gate_on(AndesGate::PMNDS_SMODE));
  CHECK_FALSE(c.gate_on(AndesGate::DSP));        // ucode not decoded on mk
  CHECK_FALSE(c.gate_on(AndesGate::ALT_FP));     // umisc_ctl not decoded on mk
  CHECK_FALSE(c.gate_on(AndesGate::CODENSE));
  CHECK_FALSE(c.gate_on(AndesGate::STACKSAFE));
  CHECK_FALSE(c.gate_on(AndesGate::ILM));
  CHECK_FALSE(c.gate_on(AndesGate::DLM));
  CHECK_FALSE(c.gate_on(AndesGate::SMRNMI));
  CHECK_FALSE(c.gate_on(AndesGate::EXCSLVL));
  CHECK_FALSE(c.gate_on(AndesGate::CLIC));
  CHECK_FALSE(c.gate_on(AndesGate::PPI));
  CHECK_FALSE(c.gate_on(AndesGate::FIO));
}

TEST_CASE("mk binding reaches the right CSR-level conclusions")
{
  const auto c = hybrid::andes_caps_from_config();
  // the ax66 registration's over-claims stay off
  CHECK_FALSE(c.supports_csr(0x7A5));  // tcontrol
  CHECK_FALSE(c.supports_csr(0x808));  // uzobctl
  CHECK_FALSE(c.supports_csr(0x811));  // sleepvalue
  // the under-claims are claimed
  CHECK(c.supports_csr(0x747));        // mseccfg
  CHECK(c.supports_csr(0x7C2));        // mecc_code
  CHECK(c.supports_csr(0x7C5));        // mpft_ctl
  CHECK(c.supports_csr(0x320));        // mcountinhibit
  CHECK(c.supports_csr(0x30C));        // mstateen0
  // option A: the S/U trap CSRs transport on this S-mode engine
  CHECK(c.supports_csr(0x180));        // satp
  CHECK(c.supports_csr(0x302));        // medeleg
  CHECK(c.supports_csr(0x303));        // mideleg
}
