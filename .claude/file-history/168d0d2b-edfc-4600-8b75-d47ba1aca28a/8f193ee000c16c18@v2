// The phase-plan grammar driven by run_plan (F6), minus the dropped QEMU2
// step.
//
// A Plan is a list of Steps; each Step names an engine (by id, resolved against
// the F2 registry), the role to invoke it in (its `invoke` template key, e.g.
// "fast-leg" / "accurate-leg"), and a Trigger. run_plan spawns each leg in
// order, threads the drained hybrid_state_v1 file forward, and returns each
// leg's mcycle/minstret. Under the no-QEMU2-handback design every F6 step
// drains, so the hybrid cycle figure is the vsim-leg mcycle minus the qemu-leg
// mcycle.
#ifndef ANDESIM_PLAN_HPP
#define ANDESIM_PLAN_HPP

#include <map>
#include <string>
#include <vector>

#include "hybrid/state_abi.h"

namespace andes_sim {

// The ROI delimiter for a step. `kind` is marker|pc; `params` carries
// kind-specific values (e.g. enter_pc, exit_pc) that F9 maps onto trigger
// args. F6 only exercises the default marker case (no params).
struct Trigger {
  std::string kind;
  std::map<std::string, std::string> params;
};

// One leg of a plan: which engine, which invoke role, under which trigger.
// `extra_args` are verbatim tokens appended after the filled template and the
// trigger args -- the seam for user-forwarded per-leg flags (e.g. the vsim
// leg's --kanata), which are orthogonal to the trigger.
struct Step {
  std::string engine_id;  // "qemu" | "verilator:ax45mpv_premium"
  std::string role;       // invoke-template key: "fast-leg" | "accurate-leg"
  Trigger trigger;
  std::vector<std::string> extra_args{};  // default-init: keeps 3-field Step{} literals warning-free
};

// A whole hybrid run. Every step loads `elf`; the shared mmap (`mem_size`
// bytes, at `mmap_path` or allocated by run_plan when empty) survives across
// every leg so memory threads through.
struct Plan {
  std::string elf;          // path to the ELF every leg launches
  long long mem_size = 0;   // shared-mmap size in bytes
  std::string mmap_path;    // "" => run_plan allocates one (F5) and owns it
  std::vector<Step> steps;
  // The engine whose hardware the fast leg(s) must model when the plan has
  // NO accurate-leg step of its own (the --verify oracle plan): the ISA sync
  // ({vlen}, {qemu_cpu}, -readconfig, LM sidecars) reads this engine instead.
  // Empty => derive from the plan's accurate-leg step (the normal case).
  std::string hw_engine_id;
};

// What one drain step measured (read back from its state file), plus the
// leg's captured stdout -- the guest program's own output (UART/semihosting)
// rides the engine's stdout and must flow through to the user. `st` is the
// full drained record (verify_oracle F4: run --verify diffs the vsim drain
// against the oracle leg's in-process, after run_plan removed the files).
struct PhaseResult {
  unsigned long long mcycle = 0;
  unsigned long long minstret = 0;
  std::string out;
  hybrid_state_v1 st{};
};

// Aggregate outcome. `error` empty => every step matched its expected exit and
// drained a valid state file; `phases` then holds one entry per step in order.
struct PlanResult {
  std::string error;
  std::vector<PhaseResult> phases;
  // The concrete per-step argv run_plan built (after placeholder fill, qemu_cfg
  // staging, and state threading). Populated whether or not the steps spawn, so
  // a --dry-run can print the exact commands without executing them.
  std::vector<std::vector<std::string>> argvs;
  // On a leg failure: where the kept evidence lives (the workdir's drain/
  // sidecar/cfg files, a copy of the ELF, manifest.txt). Empty on success or
  // when the bundle could not be written.
  std::string repro_dir;
  bool ok() const { return error.empty(); }
};

}  // namespace andes_sim

#endif  // ANDESIM_PLAN_HPP
