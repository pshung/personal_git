// Build an AndesCaps from the core's compiled-in config.inc feature macros
// (_NDS_*, supplied by the build-generated per-engine V<engine>_config.h).
// This is the ONE place that binds each Andes feature gate to its config
// macro -- the sim-binary counterpart of the Verilator-free andes_caps.hpp,
// kept separate so the unit tests never need the generated header.
//
// PRECONDITION: the _NDS_* macros must already be in scope (include this AFTER
// cpu_config.hpp). A macro that is absent reads as "feature off" (gate clear),
// never a compile error -- so a core whose config omits a knob stays safe.
//
// TWO INDEPENDENT AXES decide a gate:
//
// 1. MACRO NAMING (config generation). kv-era configs emit hex-string base
//    names ("yes"/"no") with numeric *_INT twins; mk/chh-era configs emit
//    plain-integer base names and no *_INT at all. A string macro inside an
//    evaluated #if is ill-formed, so every generation-varying knob uses the
//    ladder: prefer the *_INT name IF DEFINED (a taken #if branch keeps the
//    later #elif unevaluated, so the kv string never reaches evaluation),
//    else evaluate the plain name (numeric on mk/chh). Found live: d23
//    (chh generation) dropped uitb because CODENSE was bound to the kv-only
//    *_INT name -- a --describe-vs-offline-deriver parity FAIL.
//
// 2. CSR-DECODER FAMILY (RTL). The mk_core decoder (AX6x series, CPUID
//    series nibble 6 -- mk_csr_decode.v) diverges from kv_csr_dec.v on
//    several existence terms; those gates get mk overrides AFTER the
//    knob-driven bindings. Non-mk families keep the kv-shaped terms until
//    their own registration audits say otherwise.
#pragma once

#include "hybrid/andes_caps.hpp"

#if defined(_NDS_CPUID) && ((_NDS_CPUID & 0xF0) == 0x60)
#define ANDES_CAPS_MK_FAMILY 1
#else
#define ANDES_CAPS_MK_FAMILY 0
#endif

namespace hybrid {

inline AndesCaps andes_caps_from_config()
{
  AndesCaps c = AndesCaps::none();

  // ---- integer knobs (same macro name + meaning in every generation) ------
  // Privilege-level gates from NDS_NUM_PRIVILEGE_LEVELS (1 = M, 2 = M+U,
  // 3 = M+S+U). SMODE also carries the S/U trap CSRs satp/medeleg/mideleg
  // (ax66 registration, option A).
#if defined(_NDS_NUM_PRIVILEGE_LEVELS) && (_NDS_NUM_PRIVILEGE_LEVELS >= 2)
  c.set(AndesGate::UMODE);         // menvcfg, mcounteren, ucctlbeginaddr
#endif
#if defined(_NDS_NUM_PRIVILEGE_LEVELS) && (_NDS_NUM_PRIVILEGE_LEVELS >= 3)
  c.set(AndesGate::SMODE);         // mslideleg, satp, medeleg, mideleg
#endif
#if defined(_NDS_PMA_ENTRIES) && (_NDS_PMA_ENTRIES > 0)
  c.set(AndesGate::PMA);           // pmacfg / pmaaddr
#endif
#if defined(_NDS_ILM_SIZE_KB) && (_NDS_ILM_SIZE_KB > 0)
  c.set(AndesGate::ILM);           // milmb
#endif
#if defined(_NDS_DLM_SIZE_KB) && (_NDS_DLM_SIZE_KB > 0)
  c.set(AndesGate::DLM);           // mdlmb
#endif
#if defined(_NDS_NUM_TRIGGER) && (_NDS_NUM_TRIGGER > 0)
  c.set(AndesGate::TRIGGER);       // tselect, tdata1, tdata2, mcontext
  // tcontrol rides its own gate: kv decodes it with the trigger module,
  // mk comments it out entirely (cleared in the mk overrides below).
  c.set(AndesGate::TCONTROL);
#endif
  // CCTL: the RTL gates the mcctl* CSRs on cache presence (the spec's
  // mmsc_cfg.CCTLCSR follows the cache RAMs); no config generation emits a
  // dedicated NDS_CCTLCSR knob, so bind the cache sizes.
#if (defined(_NDS_CCTLCSR) && _NDS_CCTLCSR) || (defined(_NDS_CCTL) && _NDS_CCTL) || \
    (defined(_NDS_ICACHE_SIZE_KB) && (_NDS_ICACHE_SIZE_KB > 0)) || \
    (defined(_NDS_DCACHE_SIZE_KB) && (_NDS_DCACHE_SIZE_KB > 0))
  c.set(AndesGate::CCTL);          // mcctlbeginaddr, mcctldata
#endif
#if (defined(_NDS_SMEPMP) && _NDS_SMEPMP) || (defined(_NDS_EPMP) && _NDS_EPMP)
  c.set(AndesGate::EPMP);          // mseccfg (kv: needs the ePMP knob)
#endif
#if (defined(_NDS_SMRNMI) && _NDS_SMRNMI) || (defined(_NDS_RNMI) && _NDS_RNMI)
  c.set(AndesGate::SMRNMI);        // mnscratch/mnepc/mncause/mnstatus/mrnxvec
#endif
#if defined(_NDS_EXCSLVL) && (_NDS_EXCSLVL > 0)
  c.set(AndesGate::EXCSLVL);       // msave*
#endif
#if (defined(_NDS_ECLIC) && _NDS_ECLIC) || (defined(_NDS_CLIC) && _NDS_CLIC)
  c.set(AndesGate::CLIC);          // mtvt, mintthresh, mcirq_entry
#endif
#if defined(_NDS_SMSTATEEN) && _NDS_SMSTATEEN
  c.set(AndesGate::SMSTATEEN);     // mstateen0..3 (kv knob; mk: RVH, below)
#endif
#if defined(_NDS_PPI_SIZE_KB) && (_NDS_PPI_SIZE_KB > 0)
  c.set(AndesGate::PPI);           // mppib
#endif
#if (defined(_NDS_FIO_SIZE_KB) && (_NDS_FIO_SIZE_KB > 0)) || \
    (defined(_NDS_FIO) && _NDS_FIO)
  c.set(AndesGate::FIO);           // mfiob
#endif
  // uzobctl (UZOB) / sleepvalue (ESLEEP): NO current decoder generation
  // carries an existent term for them (kv and mk both; ax66 probe confirmed
  // absent on a live U-mode core), so no binding sets them. Spec-vs-RTL
  // discrepancy recorded in the ax66 registration report -- re-audit when a
  // core family adds them.

  // ---- generation-varying knobs: prefer *_INT if defined, else plain ------
#if defined(_NDS_DSP_SUPPORT_INT)
#if _NDS_DSP_SUPPORT_INT
  c.set(AndesGate::DSP);           // ucode
#endif
#elif defined(_NDS_DSP_SUPPORT) && _NDS_DSP_SUPPORT
  c.set(AndesGate::DSP);
#endif

#if defined(_NDS_CODENSE_SUPPORT_INT)
#if _NDS_CODENSE_SUPPORT_INT
  c.set(AndesGate::CODENSE);       // uitb
#endif
#elif defined(_NDS_CODENSE_SUPPORT) && _NDS_CODENSE_SUPPORT
  c.set(AndesGate::CODENSE);
#endif

#if defined(_NDS_POWERBRAKE_SUPPORT_INT)
#if _NDS_POWERBRAKE_SUPPORT_INT
  c.set(AndesGate::POWERBRAKE);    // mpft_ctl
#endif
#elif defined(_NDS_POWERBRAKE_SUPPORT) && _NDS_POWERBRAKE_SUPPORT
  c.set(AndesGate::POWERBRAKE);
#endif

#if defined(_NDS_STACKSAFE_SUPPORT_INT)
#if _NDS_STACKSAFE_SUPPORT_INT
  c.set(AndesGate::STACKSAFE);     // mhsp_ctl, msp_bound, msp_base
#endif
#elif defined(_NDS_STACKSAFE_SUPPORT) && _NDS_STACKSAFE_SUPPORT
  c.set(AndesGate::STACKSAFE);
#endif

  // Zcmt (jvt): the kv RTL gates jvt on ZCE_SUPPORT (newer config.inc
  // generations carry the knob; older ones have none -- absent = off).
#if (defined(_NDS_ZCMT_SUPPORT_INT) && _NDS_ZCMT_SUPPORT_INT) || \
    (defined(_NDS_ZCE_SUPPORT_INT) && _NDS_ZCE_SUPPORT_INT)
  c.set(AndesGate::ZCMT);          // jvt
#endif

  // umisc_ctl existence: BF16 arithmetic or ACE (spec ALT_FP_FMT | CST_CTL).
#if (defined(_NDS_BFLOAT16_ARITH_SUPPORT) && _NDS_BFLOAT16_ARITH_SUPPORT)
  c.set(AndesGate::ALT_FP);        // umisc_ctl
#elif defined(_NDS_ACE_SUPPORT_INT)
#if _NDS_ACE_SUPPORT_INT
  c.set(AndesGate::ALT_FP);
#endif
#elif defined(_NDS_ACE_SUPPORT) && _NDS_ACE_SUPPORT
  c.set(AndesGate::ALT_FP);
#endif

  // ECC: mecc_code exists if ANY RAM block is configured with ECC (kv rule;
  // mk decodes it unconditionally, overridden below). The *_ECC_TYPE base
  // names are hex-encoded strings on kv, so only the *_INT twins are read.
#if (defined(_NDS_DCACHE_ECC_TYPE_INT) && _NDS_DCACHE_ECC_TYPE_INT) || \
    (defined(_NDS_ICACHE_ECC_TYPE_INT) && _NDS_ICACHE_ECC_TYPE_INT) || \
    (defined(_NDS_ILM_ECC_TYPE_INT)    && _NDS_ILM_ECC_TYPE_INT)    || \
    (defined(_NDS_DLM_ECC_TYPE_INT)    && _NDS_DLM_ECC_TYPE_INT)
  c.set(AndesGate::ECC);           // mecc_code
#endif

  // Andes PMNDS scheme (kv rule: PERFORMANCE_MONITOR & !SSCOFPMF, plus the
  // privilege terms the SPA conditions carry). mk hard-wires the scheme off
  // (overridden below).
#if defined(_NDS_PERFORMANCE_MONITOR_INT)
#if _NDS_PERFORMANCE_MONITOR_INT
  c.set(AndesGate::PERF_MONITOR);  // mcountinhibit, mhpmcounter/event3-6
#if !defined(_NDS_SSCOFPMF_SUPPORT) || !_NDS_SSCOFPMF_SUPPORT
  c.set(AndesGate::PMNDS);
#if defined(_NDS_NUM_PRIVILEGE_LEVELS) && (_NDS_NUM_PRIVILEGE_LEVELS >= 2)
  c.set(AndesGate::PMNDS_UMODE);
#endif
#if defined(_NDS_NUM_PRIVILEGE_LEVELS) && (_NDS_NUM_PRIVILEGE_LEVELS >= 3)
  c.set(AndesGate::PMNDS_SMODE);
#endif
#endif
#endif
#elif defined(_NDS_PERFORMANCE_MONITOR) && _NDS_PERFORMANCE_MONITOR
  c.set(AndesGate::PERF_MONITOR);
#if !defined(_NDS_SSCOFPMF_SUPPORT) || !_NDS_SSCOFPMF_SUPPORT
  c.set(AndesGate::PMNDS);
#if defined(_NDS_NUM_PRIVILEGE_LEVELS) && (_NDS_NUM_PRIVILEGE_LEVELS >= 2)
  c.set(AndesGate::PMNDS_UMODE);
#endif
#if defined(_NDS_NUM_PRIVILEGE_LEVELS) && (_NDS_NUM_PRIVILEGE_LEVELS >= 3)
  c.set(AndesGate::PMNDS_SMODE);
#endif
#endif
#endif

#if ANDES_CAPS_MK_FAMILY
  // ---- mk_core RTL overrides: mk_csr_decode.v's terms differ from kv ------
  // mecc_code and mseccfg are UNCONDITIONAL in mk_csr_decode.v (ax66 probe:
  // both present with no ECC RAMs configured and no Smepmp knob).
  c.set(AndesGate::ECC);
  c.set(AndesGate::EPMP);
  // mstateen0-3 ride the hypervisor extension (SMSTATEEN_SUPPORT =
  // RVH_SUPPORT in the decoder).
#if defined(_NDS_RVH_SUPPORT) && _NDS_RVH_SUPPORT
  c.set(AndesGate::SMSTATEEN);
#endif
  // The PMNDS scheme is hard-0 in mk_csr_decode.v (SSCOFPMF_SUPPORT is a
  // hard-1 localparam), and tcontrol/ucode/umisc_ctl/jvt have NO existent
  // term at all -- their gates clear regardless of the config knobs.
  c.set(AndesGate::PMNDS, false);
  c.set(AndesGate::PMNDS_UMODE, false);
  c.set(AndesGate::PMNDS_SMODE, false);
  c.set(AndesGate::TCONTROL, false);
  c.set(AndesGate::DSP, false);
  c.set(AndesGate::ALT_FP, false);
  c.set(AndesGate::ZCMT, false);
#endif  // ANDES_CAPS_MK_FAMILY

  return c;
}

}  // namespace hybrid
