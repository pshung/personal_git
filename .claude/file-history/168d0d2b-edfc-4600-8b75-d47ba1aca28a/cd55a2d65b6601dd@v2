// Tests the config.inc-macro -> AndesCaps binding for a chh_core-generation
// config (d23): plain-integer NDS_* macros (like mk) but a non-AX6x CPUID --
// the macro NAMING axis is independent of the CSR-decoder FAMILY axis, so the
// binding must read the plain name whenever the *_INT twin is absent, on any
// family. Found live: d23's --describe dropped uitb (CODENSE bound to the
// kv-only *_INT name) while the offline deriver claimed it -- a parity FAIL.
#define _NDS_CPUID                   0x00023
#define _NDS_NUM_PRIVILEGE_LEVELS    3
#define _NDS_CODENSE_SUPPORT         1
#define _NDS_DSP_SUPPORT             0
#define _NDS_POWERBRAKE_SUPPORT      0
#define _NDS_STACKSAFE_SUPPORT       0

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include "doctest.h"

#include "hybrid/andes_caps_config.hpp"

using hybrid::AndesGate;

TEST_CASE("plain-named knobs bind on a non-mk family (d23 parity fix)")
{
  const auto c = hybrid::andes_caps_from_config();
  CHECK(c.gate_on(AndesGate::CODENSE));       // _NDS_CODENSE_SUPPORT 1, no _INT
  CHECK(c.supports_csr(0x800));               // uitb
  CHECK_FALSE(c.gate_on(AndesGate::DSP));     // plain 0 stays off
  CHECK_FALSE(c.gate_on(AndesGate::POWERBRAKE));
  // non-mk CPUID: the mk RTL overrides must NOT fire
  CHECK_FALSE(c.gate_on(AndesGate::ECC));     // no ECC RAM knobs -> off
  CHECK_FALSE(c.gate_on(AndesGate::EPMP));    // no Smepmp knob -> off
  // S/U trap CSRs ride SMODE on every family
  CHECK(c.supports_csr(0x180));
}
