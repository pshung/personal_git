#!/usr/bin/env python3
"""Convert Andes config.inc to QEMU cfg.

Default mode emits CPU ISA globals only. Optional platform/SOC globals
(ILM/DLM/HVM) can be enabled with --with-platform.

Usage:
    python3 scripts/config_inc_to_qemu_cfg.py config_inc/a45.config.inc
    python3 scripts/config_inc_to_qemu_cfg.py config_inc/a45.config.inc -o out.cfg
    python3 scripts/config_inc_to_qemu_cfg.py config_inc/ax46mpv-1c_0.config.inc --cpu-model ax46mpv
    python3 scripts/config_inc_to_qemu_cfg.py config_inc/ax46mpv-1c_0.config.inc --with-platform
    python3 scripts/config_inc_to_qemu_cfg.py config_inc/ax46mpv-1c_0.config.inc --qemu-v9-strict
"""
from __future__ import annotations

import argparse
import math
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from config_to_march import parse_inc, derive_march, _int, is_yes  # noqa: E402
from config_inc_shared import (
    derive_cpu_model_from_path,
    format_hex,
    normalize_march_token,
    parse_verilog_int,
)  # noqa: E402


# CPU global properties observed in vep2qemuconf/qemu-v9-cfgs
_QEMU_CPU_ISA_PROPS = {
    "a", "b", "c", "d", "f", "h", "m", "v",
    "zba", "zbb", "zbc", "zbkb", "zbkc", "zbkx", "zbs",
    "zca", "zcb", "zcf", "zcmp", "zcmt",
    "zfbfmin", "zfh",
    "zicbom", "zicbop", "zicboz",
    "zicntr", "zicsr", "zifencei", "zihpm",
    "zilsd",
    "sscofpmf", "sstc", "svinval", "svpbmt",
    "zkn", "zks", "zkt",
    "zknd", "zkne", "zknh", "zksed", "zksh",
    "smaia", "ssaia",
    "zve64f",
    "zve64d",
    "zvfbfmin", "zvfbfwma",
    "xandesv5isa",
}
_MARCH_TO_QEMU_PROP = {
    "xandes": "xandesv5isa",
}

_LETTER_PROP_ORDER = ["m", "a", "f", "d", "c", "b", "v", "h"]
_SOC_DRIVER = "riscv.andes.ae350.soc"
_STRICT_ALLOW_UNMAPPED = {"zicsr", "zifencei", "zicntr", "zihpm"}
_ANDES_CFG_ORDER = [
    "isa-bf16cvt",
    "isa-codense",
    "codense-ver",
    "isa-dsp",
    "powerbrake",
    "veccfg",
    "ppi",
    "isa-vdot",
    "isa-vpfh",
    "isa-vsih",
    "isa-vl4",
    "isa-zvqmac",
    "mmsc-cfg-hvmcsr",
    "pfm-nds",
]
def _global_block(driver: str, prop: str, val: str) -> str:
    return (
        "[global]\n"
        f'driver = "{driver}"\n'
        f'property = "{prop}"\n'
        f'value = "{val}"\n\n'
    )


def _andes_cfg_block(props: list[tuple[str, str]]) -> str:
    out = ['[andes-config "cpu"]\n']
    for prop, val in props:
        out.append(f'{prop} = "{val}"\n')
    out.append("\n")
    return "".join(out)


def _machine_block(props: list[tuple[str, str]]) -> str:
    out = ["[machine]\n"]
    for key, val in props:
        out.append(f'{key} = "{val}"\n')
    out.append("\n")
    return "".join(out)


def _collect_isa_props(cfg: dict[str, str], march: str) -> tuple[list[tuple[str, str]], list[str]]:
    enabled: set[str] = set()
    forced_off: set[str] = set()
    dropped: list[str] = []

    # 1) march-driven properties
    for tok in march.split("_"):
        if not tok or tok.startswith("rv32") or tok.startswith("rv64"):
            continue
        prop = normalize_march_token(tok)
        prop = _MARCH_TO_QEMU_PROP.get(prop, prop)
        # Skip Zvl for now; not exposed as QEMU CPU global properties.
        if prop.startswith("zvl"):
            continue
        if prop in _QEMU_CPU_ISA_PROPS:
            enabled.add(prop)
        else:
            dropped.append(prop)

    # 2) important raw config signals not always represented as a direct march token
    if is_yes(cfg, "NDS_RVB_SUPPORT"):
        enabled.add("b")
    if is_yes(cfg, "NDS_RVV_SUPPORT"):
        enabled.add("v")
    # RISC-V D depends on F; keep QEMU flags coherent.
    if "d" in enabled:
        enabled.add("f")

    out: list[tuple[str, str]] = []
    for p in _LETTER_PROP_ORDER:
        if p in enabled:
            out.append((p, "on"))

    vlen = _int(cfg, "NDS_VLEN")
    if "v" in enabled and vlen is not None:
        out.append(("vlen", str(vlen)))
    elen = _int(cfg, "NDS_ELEN")
    if "v" in enabled and elen is not None:
        out.append(("elen", str(elen)))

    for p in sorted(enabled):
        if len(p) == 1:
            continue
        out.append((p, "on"))

    # Zc v1.0: with C + D + Zcmp + Zcmt, force-disable Zcd in QEMU cfg.
    c_enabled = "c" in enabled or "zca" in enabled
    if c_enabled and "d" in enabled and "zcmp" in enabled and "zcmt" in enabled:
        forced_off.add("zcd")
    for p in sorted(forced_off):
        out.append((p, "off"))

    return out, sorted(set(dropped))


def _is_expected_unmapped(token: str) -> bool:
    if token in _STRICT_ALLOW_UNMAPPED:
        return True
    if token == "p0p5":
        return True
    if token.startswith("xandes") or token == "xnexcit":
        return True
    if token.startswith("zve") or token.startswith("zvl"):
        return True
    if token.startswith("sm") or token.startswith("ss") or token.startswith("sv"):
        return True
    return False


def _collect_soc_props(cfg: dict[str, str]) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []

    ilm_size_kb = _int(cfg, "NDS_ILM_SIZE_KB")
    dlm_size_kb = _int(cfg, "NDS_DLM_SIZE_KB")

    ilm_base = parse_verilog_int(cfg.get("NDS_ILM_BASE", ""))
    if ilm_base is not None:
        out.append(("ilm_base", format_hex(ilm_base)))
    dlm_base = parse_verilog_int(cfg.get("NDS_DLM_BASE", ""))
    if dlm_base is not None:
        out.append(("dlm_base", format_hex(dlm_base)))

    if ilm_size_kb is not None:
        out.append(("ilm_size", str(ilm_size_kb * 1024)))
    if dlm_size_kb is not None:
        out.append(("dlm_size", str(dlm_size_kb * 1024)))

    # Defaults: prefer explicit enable when present, otherwise infer from size.
    if "NDS_ILM_ENABLE" in cfg or "NDS_ILM_ENABLE_INT" in cfg:
        out.append(("ilm_default_enable", "on" if is_yes(cfg, "NDS_ILM_ENABLE") else "off"))
    elif ilm_size_kb is not None:
        out.append(("ilm_default_enable", "on" if ilm_size_kb > 0 else "off"))

    if "NDS_DLM_ENABLE" in cfg or "NDS_DLM_ENABLE_INT" in cfg:
        out.append(("dlm_default_enable", "on" if is_yes(cfg, "NDS_DLM_ENABLE") else "off"))
    elif dlm_size_kb is not None:
        out.append(("dlm_default_enable", "on" if dlm_size_kb > 0 else "off"))

    hvm_base = parse_verilog_int(cfg.get("NDS_HVM_BASE", ""))
    if hvm_base is not None:
        out.append(("hvm_base", format_hex(hvm_base)))

    hvm_size_kb = _int(cfg, "NDS_HVM_SIZE_KB")
    if hvm_size_kb is not None and hvm_size_kb > 0:
        size_bytes = hvm_size_kb * 1024
        pow_2 = math.log2(size_bytes)
        if pow_2.is_integer():
            out.append(("hvm_size_pow_2", str(int(pow_2))))

    return out


def _collect_machine_props(cfg: dict[str, str]) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    if not is_yes(cfg, "NDS_AIA_SUPPORT"):
        return out

    out.append(("aia", "aplic-imsic"))
    # If RVH is enabled, set guests based on GEILEN - 1.
    if is_yes(cfg, "NDS_RVH_SUPPORT"):
        geilen = _int(cfg, "NDS_GEILEN")
        if geilen is not None and geilen >= 1:
            out.append(("aia-guests", str(geilen - 1)))
    return out


def _collect_andes_cfg_props(cfg: dict[str, str], march: str) -> list[tuple[str, str]]:
    toks = {normalize_march_token(t) for t in march.split("_") if t and not t.startswith("rv32") and not t.startswith("rv64")}
    # Store explicit on/off when config.inc gives a direct signal.
    values: dict[str, str] = {}

    def set_from_yes(key: str, cfg_key: str) -> None:
        if cfg_key in cfg or (cfg_key + "_INT") in cfg:
            values[key] = "on" if is_yes(cfg, cfg_key) else "off"

    set_from_yes("isa-codense", "NDS_CODENSE_SUPPORT")
    set_from_yes("isa-dsp", "NDS_DSP_SUPPORT")
    set_from_yes("powerbrake", "NDS_POWERBRAKE_SUPPORT")
    set_from_yes("isa-vdot", "NDS_VECTOR_VDOT_SUPPORT")
    set_from_yes("isa-vpfh", "NDS_VECTOR_PACKED_FP16_SUPPORT")
    set_from_yes("isa-vsih", "NDS_VECTOR_SINT_SUPPORT")
    set_from_yes("isa-vl4", "NDS_INT4_VECTOR_LOAD_SUPPORT")
    set_from_yes("isa-zvqmac", "NDS_QMAC_SUPPORT")

    if "NDS_ISA_V5_PERFORMANCE" in cfg or "NDS_ISA_V5_PERFORMANCE_INT" in cfg:
        values["pfm-nds"] = "on" if _int(cfg, "NDS_ISA_V5_PERFORMANCE") == 1 else "off"

    if "NDS_RVV_SUPPORT" in cfg or "NDS_RVV_SUPPORT_INT" in cfg:
        values["veccfg"] = "on" if is_yes(cfg, "NDS_RVV_SUPPORT") else "off"

    ppi_size_kb = _int(cfg, "NDS_PPI_SIZE_KB")
    if ppi_size_kb is not None:
        values["ppi"] = "on" if ppi_size_kb > 0 else "off"

    hvm_size_kb = _int(cfg, "NDS_HVM_SIZE_KB")
    if hvm_size_kb is not None:
        values["mmsc-cfg-hvmcsr"] = "on" if hvm_size_kb > 0 else "off"

    # Direct bf16 support from config.inc
    bf16_on = False
    if "NDS_BFLOAT16_SUPPORT" in cfg or "NDS_BFLOAT16_SUPPORT_INT" in cfg:
        bf16_on = bf16_on or is_yes(cfg, "NDS_BFLOAT16_SUPPORT")
    if "NDS_BFLOAT16_ARITH_SUPPORT" in cfg or "NDS_BFLOAT16_ARITH_SUPPORT_INT" in cfg:
        bf16_on = bf16_on or is_yes(cfg, "NDS_BFLOAT16_ARITH_SUPPORT")
    if bf16_on:
        values["isa-bf16cvt"] = "on"
    elif ("NDS_BFLOAT16_SUPPORT" in cfg or "NDS_BFLOAT16_SUPPORT_INT" in cfg
          or "NDS_BFLOAT16_ARITH_SUPPORT" in cfg or "NDS_BFLOAT16_ARITH_SUPPORT_INT" in cfg):
        values["isa-bf16cvt"] = "off"

    # March-token fallback only when a direct config signal is unavailable.
    if "isa-bf16cvt" not in values and "xandesbfhcvt" in toks:
        values["isa-bf16cvt"] = "on"
    if "isa-codense" not in values and ("xandescodense" in toks or "xnexcit" in toks):
        values["isa-codense"] = "on"
    zce_enabled = ("zcmp" in toks and "zcmt" in toks)
    if not zce_enabled and ("NDS_ZCE_SUPPORT" in cfg or "NDS_ZCE_SUPPORT_INT" in cfg):
        zce_enabled = is_yes(cfg, "NDS_ZCE_SUPPORT")
    if zce_enabled and values.get("isa-codense") == "on":
        values["codense-ver"] = "1"
    # P-extension v0.5 token in march implies Andes DSP support.
    if "p0p5" in toks:
        values["isa-dsp"] = "on"
    if "isa-vdot" not in values and "xandesvdot" in toks:
        values["isa-vdot"] = "on"
    if "isa-vpfh" not in values and "xandesvpackfph" in toks:
        values["isa-vpfh"] = "on"
    if "isa-vsih" not in values and "xandesvsinth" in toks:
        values["isa-vsih"] = "on"
    if "isa-vl4" not in values and "xandessintload" in toks:
        values["isa-vl4"] = "on"
    if "isa-zvqmac" not in values and "xandesvqmac" in toks:
        values["isa-zvqmac"] = "on"
    if "pfm-nds" not in values and ("xandesperf" in toks or "xandes5" in toks):
        values["pfm-nds"] = "on"

    out: list[tuple[str, str]] = []
    for k in _ANDES_CFG_ORDER:
        if k in values:
            out.append((k, values[k]))
    return out


def convert(
    path: Path,
    cpu_model: str | None = None,
    with_platform: bool = False,
    qemu_v9_strict: bool = False,
) -> tuple[str, list[str]]:
    cfg = parse_inc(path)
    march = derive_march(cfg)
    model = cpu_model or derive_cpu_model_from_path(path)
    driver = f"andes-{model}-riscv-cpu"

    props, dropped = _collect_isa_props(cfg, march)

    lines: list[str] = []
    if with_platform:
        machine_props = _collect_machine_props(cfg)
        if machine_props:
            lines.append(_machine_block(machine_props))

    for prop, val in props:
        lines.append(_global_block(driver, prop, val))

    andes_cfg = _collect_andes_cfg_props(cfg, march)
    andes_cfg_vals = {k: v for k, v in andes_cfg}
    handled_by_andes_cfg: set[str] = set()
    if "isa-bf16cvt" in andes_cfg_vals:
        handled_by_andes_cfg.add("xandesbfhcvt")
    if "pfm-nds" in andes_cfg_vals:
        handled_by_andes_cfg.update({"xandesperf", "xandes5"})
    if "isa-vl4" in andes_cfg_vals:
        handled_by_andes_cfg.add("xandessintload")
    if "isa-vdot" in andes_cfg_vals:
        handled_by_andes_cfg.add("xandesvdot")
    if "isa-vpfh" in andes_cfg_vals:
        handled_by_andes_cfg.add("xandesvpackfph")
    if "isa-zvqmac" in andes_cfg_vals:
        handled_by_andes_cfg.add("xandesvqmac")
    if "isa-vsih" in andes_cfg_vals:
        handled_by_andes_cfg.add("xandesvsinth")
    if "isa-codense" in andes_cfg_vals:
        handled_by_andes_cfg.add("xandescodense")
    if "isa-dsp" in andes_cfg_vals:
        handled_by_andes_cfg.add("p0p5")
    if andes_cfg_vals.get("isa-codense") == "on" and andes_cfg_vals.get("codense-ver") == "1":
        handled_by_andes_cfg.add("xnexcit")
    dropped = [t for t in dropped if t not in handled_by_andes_cfg]
    if andes_cfg:
        lines.append(_andes_cfg_block(andes_cfg))

    if with_platform:
        for prop, val in _collect_soc_props(cfg):
            lines.append(_global_block(_SOC_DRIVER, prop, val))

    if dropped and not qemu_v9_strict:
        lines.append(
            "# NOTE: march tokens not mapped to QEMU CPU global properties in this ISA-only pass:\n"
        )
        lines.append("# " + " ".join(dropped) + "\n")
    return "".join(lines), dropped


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("config_inc", type=Path, help="Input config.inc path")
    ap.add_argument("-o", "--output", type=Path, default=None, help="Output cfg path (default: stdout)")
    ap.add_argument("--cpu-model", default=None, help="Override CPU model for driver name")
    ap.add_argument("--with-platform", action="store_true",
                    help="Also emit platform/SOC globals (ILM/DLM/HVM).")
    ap.add_argument("--qemu-v9-strict", action="store_true",
                    help="Emit only known v9 QEMU globals and fail if march tokens are unmapped.")
    args = ap.parse_args()

    text, dropped = convert(
        args.config_inc,
        cpu_model=args.cpu_model,
        with_platform=args.with_platform,
        qemu_v9_strict=args.qemu_v9_strict,
    )
    strict_unknown = [t for t in dropped if not _is_expected_unmapped(t)]
    if args.qemu_v9_strict and strict_unknown:
        sys.stderr.write(
            "error: unmapped march tokens for qemu-v9 strict mode: "
            + " ".join(sorted(set(strict_unknown)))
            + "\n"
        )
        return 2
    if args.output is None:
        sys.stdout.write(text)
        return 0
    args.output.write_text(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
