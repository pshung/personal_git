// The bundled functional engine(s). QEMU does not implement --describe, so the
// descriptor is built in. builtin_qemu_arch(64) is the rv64 "qemu64";
// builtin_qemu_arch(32) is the rv32 "qemu32" (qemu-system-riscv32). The
// standalone (model=fast) run uses qemu's OWN default -cpu -- the user's post-`--`
// args (incl. an explicit -cpu) still win; only the rv64 hybrid fast-leg pins a
// -cpu. Binary path honors $VSIM_QEMU / $VSIM_QEMU32, then $QEMU_BIN_DIR (env or
// config.env), then the legacy in-tree build. Exposed (engine_registry.hpp) so
// `run --mode fast` resolves qemu directly, skipping the per-engine --describe
// scan whole-registry discovery would spawn.
EngineDescriptor builtin_qemu_arch(int xlen) {
  const bool rv32 = (xlen == 32);
  EngineDescriptor d;
  d.id = rv32 ? kQemuId32 : kQemuId64;
  d.type = "qemu";
  d.kind = "functional";
  d.xlen = xlen;
  d.triggers = {"marker", "pc"};
  d.state = {"drain"};
  d.source = "built-in";

  d.roles = {"standalone"};
  if (!rv32) {  // hybrid rv32 (qemu32 fast-leg + engine-matched -cpu) not wired yet
    // The hybrid fast-forward leg (rv64): load the ELF, drain on the plugin's
    // trigger into {state_out}, exit 200. {plugin}/{mmap}/{mmap_size}/{state_out}
    // are filled by the plan executor (F6); {trigger} is the plugin comma-suffix
    // (empty for marker), folded by leg_trigger_args (F9).
    d.roles.push_back("fast-leg");
    // {qemu_cpu}: the accurate engine's CPU model (from its --print-qemu-config
    // driver globals; run_plan falls back to the andes-ax45mpv family default).
    // The -readconfig globals apply only to the driver they name, so the model
    // must follow the engine -- andes-ax45mpv silently kept vlen=512 when the
    // ax66 (VLEN 128) pairing asked for 128.
    d.invoke.push_back(
        {"fast-leg",
         {"{bin}", "-object",
          "memory-backend-file,id=mem,share=on,mem-path={mmap},size={mmap_size}",
          "-machine", "andes_ae350,memory-backend=mem", "-cpu",
          "{qemu_cpu},vlen={vlen}", "-nographic", "-semihosting-config",
          "enable=on,target=native", "-bios", "{elf}", "-plugin",
          "{plugin},outfile={state_out}{trigger}"}});
  }

  // The standalone functional run (model=fast). andes_ae350's generic default
  // -cpu hangs the vplat fixtures, so pin a concrete andes core: the
  // vector-capable andes-ax46mpv (rv64) / andes-a46mpv (rv32). We pass NO vlen --
  // the cpu model's own QEMU default applies, so both scalar and vector binaries
  // run out of the box; a user who needs a specific width passes it via the
  // post-`--` -cpu (e.g. -cpu andes-ax46mpv,vlen=512), which still wins.
  // run_passthrough fills {bin}/{elf}.
  const char* fast_cpu = rv32 ? "andes-a46mpv" : "andes-ax46mpv";
  d.invoke.push_back(
      {"standalone",
       {"{bin}", "-machine", "andes_ae350", "-cpu", fast_cpu, "-nographic",
        "-semihosting-config", "enable=on,target=native", "-bios", "{elf}"}});

  const std::string sys =
      std::string("qemu-system-") + (rv32 ? "riscv32" : "riscv64");
  const char* env = rv32 ? "VSIM_QEMU32" : "VSIM_QEMU";
  if (const char* q = std::getenv(env); q && *q)
    d.bin_path = q;
  else if (std::string qd = config_env_value("QEMU_BIN_DIR"); !qd.empty())
    d.bin_path = (fs::path(qd) / sys).string();
  else
    d.bin_path = (repo_root() / "build" / "qemu" / sys).string();
  return d;
}

// rv64 qemu (back-compat: the default functional engine and hybrid fast leg).
EngineDescriptor builtin_qemu() { return builtin_qemu_arch(64); }

namespace {

constexpr int kDescribeTimeoutMs = 5000;

bool is_executable_file(const fs::path& p) {
  std::error_code ec;
  if (!fs::is_regular_file(p, ec)) return false;
  return ::access(p.c_str(), X_OK) == 0;
}

std::string read_file(const fs::path& p) {
  std::ifstream f(p, std::ios::binary);
  std::ostringstream ss;
  ss << f.rdbuf();
  return ss.str();
}

// Ask one binary to describe itself: try `<bin> --describe`, else read the
// <bin>.json sidecar. On success fills `d` and returns true; on failure leaves
// a human-readable note in `warn`.
bool describe_one(const fs::path& bin, EngineDescriptor& d, std::string& warn) {
  RunResult r = run_process({bin.string(), "--describe"}, kDescribeTimeoutMs);
  if (!r.spawn_failed && !r.timed_out && r.rc == 0) {
    json::Parsed p = json::parse(r.out);
    if (p.ok) {
      std::string err = descriptor_from_json(p.value, d);
      if (err.empty()) {
        d.bin_path = bin.string();
        d.source = "--describe";
        return true;
      }
      warn = bin.string() + ": --describe JSON invalid: " + err;
    } else {
      warn = bin.string() + ": --describe output is not JSON: " + p.error;
    }
  }

  fs::path sidecar = bin;
  sidecar += ".json";
  std::error_code ec;
  if (fs::exists(sidecar, ec)) {
    json::Parsed p = json::parse(read_file(sidecar));
    if (p.ok) {
      EngineDescriptor sd;
      std::string err = descriptor_from_json(p.value, sd);
      if (err.empty()) {
        sd.bin_path = bin.string();
        sd.source = "sidecar";
        d = std::move(sd);
        return true;
      }
      warn = sidecar.string() + ": invalid descriptor: " + err;
    } else {
      warn = sidecar.string() + ": not JSON: " + p.error;
    }
  }

  if (warn.empty()) warn = bin.string() + ": no --describe and no sidecar";
  return false;
}

// `prefix` filters candidate basenames; empty accepts any executable. The
// default VSIM_BIN_DIR scan passes "sim_"; a user-curated engines dir passes
// "" so a drop-in alioth/sid (any name) is eligible. The naming convention thus
// lives in the call site, not in this engine-agnostic scanner.
void scan_dir(const fs::path& dir, std::string_view prefix, Discovery& out,
              std::set<std::string>& seen) {
  std::error_code ec;
  if (!fs::is_directory(dir, ec)) return;

  std::vector<fs::path> entries;
  for (const auto& e : fs::directory_iterator(dir, ec)) entries.push_back(e.path());
  std::sort(entries.begin(), entries.end());  // stable, deterministic order

  for (const fs::path& p : entries) {
    if (!prefix.empty() && !p.filename().string().starts_with(prefix)) continue;
    if (!is_executable_file(p)) continue;
    EngineDescriptor d;
    std::string warn;
    if (describe_one(p, d, warn)) {
      normalize_engine_label(d);  // verilator -> vsim, before dedup keys on id
      if (seen.insert(d.id).second) out.engines.push_back(std::move(d));
    } else if (!warn.empty()) {
      out.warnings.push_back(warn);
    }
  }
}

}  // namespace

// See engine_registry.hpp. VSIM_BIN_DIR (the external prebuilt vsim build,
// mirroring QEMU_BIN_DIR) resolved env-first then from config.env, so the driver
// finds the external vsim without a prior `source ./setup.sh`. Empty when
// unset everywhere -- there is no in-tree vsim to fall back to.
fs::path vsim_scan_dir(const fs::path& config_file) {
  return config_env_value("VSIM_BIN_DIR", config_file);
}

fs::path vsim_scan_dir() {
  return vsim_scan_dir(repo_root() / "config.env");
}

Discovery discover_engines() {
  Discovery out;
  std::set<std::string> seen;

  EngineDescriptor qemu = builtin_qemu();
  seen.insert(qemu.id);
  out.engines.push_back(std::move(qemu));

  // rv32 functional engine, listed alongside qemu so `list engines` shows both
  // (its binary is qemu-system-riscv32 under the same QEMU_BIN_DIR).
  EngineDescriptor qemu32 = builtin_qemu_arch(32);
  seen.insert(qemu32.id);
  out.engines.push_back(std::move(qemu32));

  if (const char* env = std::getenv("ANDESIM_ENGINES_DIR"); env && *env) {
    std::stringstream ss(env);
    std::string dir;
    while (std::getline(ss, dir, ':'))
      if (!dir.empty()) scan_dir(dir, /*prefix=*/"", out, seen);
  } else {
    scan_dir(vsim_scan_dir(), /*prefix=*/"sim_", out, seen);
  }
  return out;
}

}  // namespace andes_sim
