#pragma once

// andesim ROI node selection for the Q1_0 shape sweep (opt_roadmap F7).
//
// `andesim run --mode hybrid` reports cycle-accurate numbers for the code
// between andesim_ROI_begin/end. ggml executes a whole graph in one shot, so
// the only way to isolate one matmul is to count GGML_OP_MUL_MAT nodes in the
// dispatch loop and bracket node #K (see ggml-cpu.c). Which node that is comes
// from the build default -DANDESIM_ROI_MUL_MAT_K, overridable at run time so
// one binary can measure every shape in the model.
//
// Pure, host-testable (tests/test-roi-node.cpp); the markers themselves are
// RISC-V inline asm and live in ggml-cpu.c behind the same -D.

// Node index from an env string, or `fallback` when it is unset or not a node
// index. Strict on purpose: nodes are 1-indexed and a mis-parsed index measures
// the wrong matmul, which only shows up after hours of RTL simulation.
static inline int ggml_roi_node_index(const char * env_val, int fallback) {
    if (!env_val) {
        return fallback;
    }
    int n = 0;
    for (const char * p = env_val; *p; ++p) {
        if (*p < '0' || *p > '9') {
            return fallback;   // whitespace, sign, trailing junk
        }
        n = n * 10 + (*p - '0');
    }
    return n > 0 ? n : fallback;   // "" and "0" both land here
}
