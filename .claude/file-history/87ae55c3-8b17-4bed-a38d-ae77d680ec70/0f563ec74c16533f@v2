#!/usr/bin/env bash
# Launch one wave of hybrid ROI cycle runs concurrently (cycle counts are
# contention-independent, only wall time suffers). One log per binary.
SP=/tmp/claude-1002/-home-nick-work-llama-cpp/87ae55c3-8b17-4bed-a38d-ae77d680ec70/scratchpad
mkdir -p "$SP/roi"
export TMPDIR=/home/nick/tmp
export TIMEOUT=${TIMEOUT:-43200000}   # 12h per leg: ffn pristine is ~42M cycles
for b in "$@"; do
  ( bash /home/nick/work/llama.cpp/measure.sh "$b" > "$SP/roi/$b.log" 2>&1; \
    echo "rc=$?" >> "$SP/roi/$b.log" ) &
  echo "launched $b (pid $!)"
done
wait
echo "wave done"
