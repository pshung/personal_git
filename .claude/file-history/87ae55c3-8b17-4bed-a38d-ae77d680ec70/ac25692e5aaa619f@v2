// Unit test for the andesim ROI node selector (opt_roadmap F7: per-shape cycle
// measurement).
//
// The ROI brackets MUL_MAT node #K so `andesim run --mode hybrid` can report
// cycle-accurate numbers for one matmul. K used to be a compile-time -D, which
// meant one rebuild per measured node. Bonsai-4B has 6 distinct Q1_0 GEMV
// shapes, so a shape sweep needs the node index chosen at run time instead.
//
// A wrong index silently measures the wrong matmul and wastes hours of RTL
// simulation, so parsing is strict: the whole string must be a positive
// integer (nodes are 1-indexed), anything else falls back to the build default.

#include "../ggml/src/ggml-cpu/roi.h"

#include <cstdio>

static int failures = 0;
#define CHECK(cond)                                                        \
    do {                                                                   \
        if (!(cond)) {                                                     \
            printf("FAIL line %d: %s\n", __LINE__, #cond);                 \
            ++failures;                                                    \
        }                                                                  \
    } while (0)

int main(void) {
    const int DEFAULT_K = 51;  // the shipped -DANDESIM_ROI_MUL_MAT_K

    // unset / empty env => keep the build default
    CHECK(ggml_roi_node_index(NULL, DEFAULT_K) == DEFAULT_K);
    CHECK(ggml_roi_node_index("", DEFAULT_K) == DEFAULT_K);

    // a valid index overrides it -- the four Bonsai-4B shapes to sweep
    CHECK(ggml_roi_node_index("50", DEFAULT_K) == 50);    // blk.7.attn_q
    CHECK(ggml_roi_node_index("53", DEFAULT_K) == 53);    // blk.7.attn_output
    CHECK(ggml_roi_node_index("54", DEFAULT_K) == 54);    // blk.7.ffn_gate
    CHECK(ggml_roi_node_index("56", DEFAULT_K) == 56);    // blk.7.ffn_down
    CHECK(ggml_roi_node_index("253", DEFAULT_K) == 253);  // result_output
    CHECK(ggml_roi_node_index("1", DEFAULT_K) == 1);

    // not a node index => default, never a silently wrong measurement
    CHECK(ggml_roi_node_index("0", DEFAULT_K) == DEFAULT_K);    // 1-indexed
    CHECK(ggml_roi_node_index("-3", DEFAULT_K) == DEFAULT_K);
    CHECK(ggml_roi_node_index("abc", DEFAULT_K) == DEFAULT_K);
    CHECK(ggml_roi_node_index("54x", DEFAULT_K) == DEFAULT_K);  // trailing junk
    CHECK(ggml_roi_node_index("x54", DEFAULT_K) == DEFAULT_K);
    CHECK(ggml_roi_node_index(" 54", DEFAULT_K) == DEFAULT_K);  // no whitespace
    CHECK(ggml_roi_node_index("54 ", DEFAULT_K) == DEFAULT_K);

    printf(failures ? "FAILED (%d)\n" : "ALL PASS\n", failures);
    return failures != 0;
}
