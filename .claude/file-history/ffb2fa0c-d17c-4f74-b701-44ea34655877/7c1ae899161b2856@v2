// Tiny assert-and-count harness shared by the driver's standalone unit tests
// (cli_test, json_test, and F5+ infra tests). No doctest dependency: each test
// is its own executable, calls CHECK(...) for each assertion, and ends with
// `return andes_sim::test::report("<name>");`.
#ifndef ANDES_SIM_TEST_CHECK_HPP
#define ANDES_SIM_TEST_CHECK_HPP

#include <cstdio>
#include <string>
#include <vector>

namespace andes_sim::test {

inline int g_failures = 0;

inline int report(const char* what) {
  if (g_failures) {
    std::fprintf(stderr, "%d check(s) failed\n", g_failures);
    return 1;
  }
  std::printf("all %s checks passed\n", what);
  return 0;
}

}  // namespace andes_sim::test

#define CHECK(cond)                                                        \
  do {                                                                     \
    if (!(cond)) {                                                         \
      std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
      ++andes_sim::test::g_failures;                                       \
    }                                                                      \
  } while (0)

namespace andes_sim::test {

// Element-wise compare two string vectors: CHECK the size, then each element,
// printing got/want on the first mismatch. `label` tags the diff line. Shared
// by the driver's argv-shaped unit tests (plan_test, run_test). Defined after
// CHECK so the macro is in scope.
inline void check_eq(const std::vector<std::string>& got,
                     const std::vector<std::string>& want, const char* label) {
  CHECK(got.size() == want.size());
  const size_t n = got.size() < want.size() ? got.size() : want.size();
  for (size_t i = 0; i < n; ++i) {
    if (got[i] != want[i])
      std::fprintf(stderr, "  %s[%zu]: got '%s' want '%s'\n", label, i,
                   got[i].c_str(), want[i].c_str());
    CHECK(got[i] == want[i]);
  }
}

}  // namespace andes_sim::test

#endif  // ANDES_SIM_TEST_CHECK_HPP
