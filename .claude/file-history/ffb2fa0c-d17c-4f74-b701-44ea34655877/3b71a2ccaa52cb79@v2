// `andes-sim run --model fast|accurate|hybrid [engine selection] ELF [-- engine args]`.
//
// The top selection axis. F7 lands `--model fast`: resolve the built-in qemu
// engine and hand off to transparent passthrough -- the ELF plus everything
// after `--` becomes QEMU's own command line, run with inherited stdio, no
// timeout, and the exit code propagated, so a gdbstub / monitor / semihosting
// console all behave as if QEMU were invoked directly. `accurate` (F8) and
// `hybrid` (F9) land in later features; their dispatch arms stub for now.
#include <cstdio>
#include <string>

#include "cli.hpp"
#include "engine_registry.hpp"
#include "models.hpp"
#include "run_passthrough.hpp"

namespace andes_sim {
namespace {

const EngineDescriptor* find_engine(const Discovery& disc, const std::string& id) {
  for (const EngineDescriptor& e : disc.engines)
    if (e.id == id) return &e;
  return nullptr;
}

// `run --model fast`: QEMU alone, functional, transparent passthrough.
int run_fast(const Cli& cli) {
  if (cli.positional.empty()) {
    std::fprintf(stderr, "andes-sim run --model fast: missing ELF\n");
    return 2;
  }
  if (cli.positional.size() > 1) {
    std::fprintf(stderr,
                 "andes-sim run --model fast: unexpected argument '%s' "
                 "(engine args go after --)\n",
                 cli.positional[1].c_str());
    return 2;
  }
  // fast is QEMU-only; an explicit engine must name it.
  if (!cli.engine.empty() && cli.engine != "qemu") {
    std::fprintf(stderr,
                 "andes-sim run --model fast: engine must be 'qemu', got '%s'\n",
                 cli.engine.c_str());
    return 2;
  }

  Discovery disc = discover_engines();
  const EngineDescriptor* qemu = find_engine(disc, "qemu");
  if (!qemu) {
    std::fprintf(stderr, "andes-sim run --model fast: qemu engine not found\n");
    return 2;
  }

  std::string err;
  int rc = run_passthrough(*qemu, "standalone", cli.positional[0],
                           cli.passthrough, err);
  if (!err.empty()) {
    std::fprintf(stderr, "andes-sim run: %s\n", err.c_str());
    return 2;
  }
  return rc;
}

}  // namespace

int cmd_run(const Cli& cli) {
  if (cli.model.empty()) {
    std::fprintf(stderr,
                 "andes-sim run: --model fast|accurate|hybrid is required\n");
    return 2;
  }
  if (!find_model(cli.model)) {
    std::fprintf(stderr,
                 "andes-sim run: unknown model '%s' (want fast|accurate|hybrid)\n",
                 cli.model.c_str());
    return 2;
  }
  if (cli.model == "fast") return run_fast(cli);

  std::fprintf(stderr, "andes-sim run --model %s: not yet implemented\n",
               cli.model.c_str());
  return 3;
}

}  // namespace andes_sim
