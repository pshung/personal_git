// Transparent passthrough. See run_passthrough.hpp.
#include "run_passthrough.hpp"

#include "argv.hpp"
#include "process.hpp"

namespace andes_sim {

std::vector<std::string> passthrough_argv(
    const EngineDescriptor& eng, const std::string& role, const std::string& elf,
    const std::vector<std::string>& passthrough, std::string& err) {
  const std::vector<std::string>* tmpl = eng.invoke_for(role);
  if (!tmpl) {
    err = "engine '" + eng.id + "' has no invoke template for role '" + role +
          "'";
    return {};
  }
  std::vector<std::string> argv =
      build_argv(*tmpl, {{"bin", eng.bin_path}, {"elf", elf}}, err);
  if (!err.empty()) return {};
  argv.insert(argv.end(), passthrough.begin(), passthrough.end());
  return argv;
}

int run_passthrough(const EngineDescriptor& eng, const std::string& role,
                    const std::string& elf,
                    const std::vector<std::string>& passthrough,
                    std::string& err) {
  std::vector<std::string> argv =
      passthrough_argv(eng, role, elf, passthrough, err);
  if (!err.empty()) return 2;
  return exec_passthrough(argv);
}

}  // namespace andes_sim
