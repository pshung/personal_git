#!/usr/bin/env bash
set -u
QEMU=/home/nick/work/qemu_andesim/build/qemu/qemu-system-riscv64
PLUGIN=/home/nick/work/andesim/qemu_plugin/libhybrid_handoff.so
ELF=/home/nick/work/andesim/hello.elf
MMAP=$(mktemp -p /dev/shm hsim-test.XXXXXX)
truncate -s 134221824 "$MMAP"
OUT=/tmp/qleg-state.bin; rm -f "$OUT"

echo "=== QEMU fast-leg ALONE: reset -> enter_pc 0x10007c, drain state ==="
START=$(date +%s.%N)
"$QEMU" \
  -object "memory-backend-file,id=mem,share=on,mem-path=$MMAP,size=134221824" \
  -machine andes_ae350,memory-backend=mem \
  -cpu andes-ax45mpv,vlen=512 \
  -nographic -semihosting-config enable=on,target=native \
  -bios "$ELF" \
  -plugin "$PLUGIN,outfile=$OUT,enter_pc=0x10007c" >/tmp/qleg.out 2>&1
RC=$?
END=$(date +%s.%N)
echo "exit=$RC  wall=$(awk "BEGIN{printf \"%.3f\", $END-$START}")s"
echo "drained state: $([ -f "$OUT" ] && stat -c '%s bytes' "$OUT" || echo MISSING)"
echo "--- qemu output tail ---"; tail -5 /tmp/qleg.out
rm -f "$MMAP"
