#include "platform/memory_region.hpp"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include <cstdint>

TEST_CASE("ctor")
{
  const auto mr = MemoryRegion{0x1234, 0x2234};
  CHECK(mr.base_address == 0x1234);
}

TEST_CASE("ctor-edge-cases")
{
  CHECK_NOTHROW(MemoryRegion{0xffff'ffff, 0xffff'ffff});
  CHECK_NOTHROW(MemoryRegion{0x0, 0xffff'ffff});
}

TEST_CASE("ctor-out-of-range")
{
  CHECK_THROWS(MemoryRegion{0xffff'ffff, 0xffff'fffe});
}

TEST_CASE("contains")
{
  CHECK(MemoryRegion{0x1000, 0x1000}.contains(0x1000));
  CHECK(MemoryRegion{0x1000, 0x1fff}.contains(0x1fff));
  CHECK(!MemoryRegion{0x1000, 0x1000}.contains(0x1001));
}

TEST_CASE("contains-range")
{
  const auto r = MemoryRegion{0x1000, 0x1fff};

  CHECK(r.contains(MemoryRegion{0x1000, 0x1fff}));
  CHECK(r.contains(MemoryRegion{0x1000, 0x1000}));
  CHECK(r.contains(MemoryRegion{0x1fff, 0x1fff}));
  CHECK(!r.contains(MemoryRegion{0x1000, 0x2000}));
}

TEST_CASE("contains_access half-open range reaches the final byte")
{
  const auto r = MemoryRegion{0x1000, 0x1fff};  // [0x1000, 0x2000)

  CHECK(r.contains_access(0x1000, 0x1000));  // whole region
  CHECK(r.contains_access(0x1ffc, 4));       // ends exactly on end_address
  CHECK(r.contains_access(0x1fff, 1));       // the final byte
  CHECK(!r.contains_access(0x1ffc, 5));      // one byte past the end
  CHECK(!r.contains_access(0x0fff, 1));      // below base
  CHECK(!r.contains_access(0x2000, 1));      // at end_address (exclusive)
}

TEST_CASE("overlaps")
{
  CHECK(MemoryRegion{0x1000, 0x1000}.overlaps({0x1000, 0x1001}));
  CHECK(MemoryRegion{0x1000, 0x1fff}.overlaps({0x1500, 0x1600}));
  CHECK(MemoryRegion{0x1000, 0x1fff}.overlaps({0x1500, 0x2600}));
  CHECK(!MemoryRegion{0x1000, 0x1fff}.overlaps({0x0, 0x100}));
}
