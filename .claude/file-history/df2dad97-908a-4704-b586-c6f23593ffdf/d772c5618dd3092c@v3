// #1 (drain-minimal): when --verify is off the driver consumes only the vsim
// mcycle delta, so the full register-file readback (~190 DMI abstract commands)
// is wasted. drain_counters_only refreshes mcycle+minstret from the hart and
// passes every other field through from the QEMU1 snapshot, issuing exactly two
// abstract-command reads.
TEST_CASE("drain_counters_only refreshes only mcycle+minstret, preserves passthrough")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_csr(RD::kCsrMcycle)]   = 0xABCD1234ULL;
  bus.regfile[hybrid::regno_csr(RD::kCsrMinstret)] = 0x56789ABCULL;

  // Passthrough input (QEMU1 snapshot) with distinctive non-counter fields.
  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_FP | HYBRID_FLAG_V
                  | HYBRID_FLAG_ANDES | HYBRID_FLAG_M_EXT;
  input.priv    = 3;
  for (uint16_t i = 0; i < 32; ++i) {
    input.gpr[i] = 0x1000ULL + i;
    input.fpr[i] = 0x2000ULL + i;
  }
  input.mstatus        = 0xDEADULL;
  input.andes.mxstatus = 0xBEEFULL;
  input.m_ext.menvcfg  = 0xCAFEULL;
  input.mcycle = input.minstret = 0;  // stale -- must be overwritten by the read

  hybrid::StateDrain drain(bus, kScratch);
  const auto out = drain.drain_counters_only(input);

  // Counters refreshed from the hart.
  CHECK(out.mcycle   == 0xABCD1234ULL);
  CHECK(out.minstret == 0x56789ABCULL);
  // Every other field passes through untouched (no DMI read issued for it).
  CHECK(out.mstatus        == 0xDEADULL);
  CHECK(out.andes.mxstatus == 0xBEEFULL);
  CHECK(out.m_ext.menvcfg  == 0xCAFEULL);
  for (uint16_t i = 1; i < 32; ++i) {
    CHECK(out.gpr[i] == 0x1000ULL + i);
    CHECK(out.fpr[i] == 0x2000ULL + i);
  }

  // The whole point of #1: the ONLY abstract-command reads are the two
  // counters -- no GPR/FPR/CSR register-file readback.
  int reads = 0, mcycle_reads = 0, minstret_reads = 0;
  for (const auto& op : bus.ops) {
    if (op.kind != DmiOp::Kind::Write || op.reg != RD::kCommand) continue;
    const bool is_write = ((op.value >> 16) & 1u) != 0;
    if (is_write) continue;
    const uint16_t regno = op.value & 0xffffu;
    ++reads;
    if (regno == hybrid::regno_csr(RD::kCsrMcycle))   ++mcycle_reads;
    if (regno == hybrid::regno_csr(RD::kCsrMinstret)) ++minstret_reads;
    CHECK(regno < 0x1000u);  // never a GPR (>=0x1000) nor FPR (>=0x1020)
  }
  CHECK(reads == 2);
  CHECK(mcycle_reads == 1);
  CHECK(minstret_reads == 1);
}
