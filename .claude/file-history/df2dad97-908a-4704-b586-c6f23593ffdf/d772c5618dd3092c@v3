TEST_CASE("L26: drain of V state with the scratch GPA unset throws (no silent "
          "dump to a bogus address)")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_V;
  input.priv    = 3;
  input.vlenb   = 16;

  // Default ctor leaves scratch_gpa = kVScratchGpaUnset; the V dump sweep must
  // fail loudly rather than vse8.v into garbage.
  hybrid::StateDrain drain(bus);
  CHECK_THROWS_AS(drain.drain_with_passthrough(input), std::runtime_error);

  // Supplying a real scratch GPA lets the same V drain complete.
  RecordingBus bus2;
  bus2.dmstatus_value = kDmstatusHaltedAndAcked;
  hybrid::StateDrain ok(bus2, kScratch);
  CHECK_NOTHROW((void) ok.drain_with_passthrough(input));
}

TEST_CASE("Andes v3: drain_with_passthrough re-reads the whole Andes CSR block "
          "from the hart, not the QEMU1 passthrough snapshot")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  // Post-ROI values the measured region left in the hart's Andes CSRs.
  uint64_t hv = 0x700;
#define X(field, addr, name) bus.regfile[hybrid::regno_csr(addr)] = hv++;
  HYBRID_ANDES_CSR_LIST(X)
#undef X
  for (int i = 0; i < HYBRID_PMA_CFG_NUM; ++i)
    bus.regfile[hybrid::regno_csr(0xBC0 + 2 * i)] = 0x800 + i;
  for (int i = 0; i < HYBRID_PMA_ADDR_NUM; ++i)
    bus.regfile[hybrid::regno_csr(0xBD0 + i)] = 0x900 + i;

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_ANDES;
  input.priv    = 3;
  // Stale QEMU1 values; none must survive into the drained state.
#define X(field, addr, name) input.andes.field = 0xDEAD;
  HYBRID_ANDES_CSR_LIST(X)
#undef X
  for (int i = 0; i < HYBRID_PMA_CFG_NUM; ++i)  input.andes.pmacfg[i]  = 0xDEAD;
  for (int i = 0; i < HYBRID_PMA_ADDR_NUM; ++i) input.andes.pmaaddr[i] = 0xDEAD;

  hybrid::StateDrain drain(bus, kScratch);
  const auto state = drain.drain_with_passthrough(input);

  uint64_t exp = 0x700;
#define X(field, addr, name) CHECK(state.andes.field == exp++);
  HYBRID_ANDES_CSR_LIST(X)
#undef X
  for (int i = 0; i < HYBRID_PMA_CFG_NUM; ++i)
    CHECK(state.andes.pmacfg[i] == uint64_t(0x800 + i));
  for (int i = 0; i < HYBRID_PMA_ADDR_NUM; ++i)
    CHECK(state.andes.pmaaddr[i] == uint64_t(0x900 + i));
}

TEST_CASE("Andes caps: drain_with_passthrough skips re-reading the CSRs the "
          "core lacks (no hang), keeps their passthrough, re-reads the rest")
{
  RecordingBus bus;
  bus.dmstatus_value = kDmstatusHaltedAndAcked;
  bus.regfile[hybrid::regno_csr(0x800)] = 0xABCDEULL;  // uitb  (supported)
  bus.regfile[hybrid::regno_csr(0x7C0)] = 0x12345ULL;  // milmb (supported)
  bus.regfile[hybrid::regno_csr(0x801)] = 0x999ULL;    // ucode (absent; must NOT be read)

  hybrid_state_v1 input{};
  input.magic   = HYBRID_STATE_MAGIC;
  input.version = HYBRID_STATE_VERSION;
  input.flags   = HYBRID_FLAG_RV64 | HYBRID_FLAG_ANDES;
  input.priv    = 3;
  input.andes.ucode     = 0xDEAD;
  input.andes.mecc_code = 0xDEAD;
  input.andes.uitb      = 0xBEEF;  // stale; must be overwritten by the re-read

  // ax45mpv_premium: CoDense + ILM + DLM only.
  hybrid::AndesCaps premium = hybrid::AndesCaps::none();
  premium.set(hybrid::AndesGate::CODENSE);
  premium.set(hybrid::AndesGate::ILM);
  premium.set(hybrid::AndesGate::DLM);

  hybrid::StateDrain drain(bus, kScratch, premium);
  const auto state = drain.drain_with_passthrough(input);

  // Supported -> re-read from the hart.
  CHECK(state.andes.uitb  == 0xABCDEULL);
  CHECK(state.andes.milmb == 0x12345ULL);
  // Absent -> NOT re-read: passthrough value kept, and no read-COMMAND issued
  // (anti-hang, symmetric with the restore gate).
  CHECK(state.andes.ucode     == 0xDEADULL);
  CHECK(state.andes.mecc_code == 0xDEADULL);
  for (const auto& op : bus.ops) {
    if (op.kind != DmiOp::Kind::Write || op.reg != RD::kCommand) continue;
    CHECK((op.value & 0xFFFFu) != hybrid::regno_csr(0x801));  // ucode
    CHECK((op.value & 0xFFFFu) != hybrid::regno_csr(0x7C2));  // mecc_code
  }
}

TEST_CASE("Andes v3: drain_with_passthrough without HYBRID_FLAG_ANDES leaves the "
          "Andes block as the passthrough snapshot (no re-read)")
{
  RecordingBus bus;
