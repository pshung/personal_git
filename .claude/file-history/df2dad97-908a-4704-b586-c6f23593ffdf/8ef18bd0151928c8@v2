#!/usr/bin/env bash
# Native compile+run of a vsim platform doctest (no container).
# usage: build_test.sh <src.test.cpp> <out-name>
set -euo pipefail
cd /home/nick/work/vsim_andesim
SB=/tmp/claude-1002/-home-nick-work-andesim/df2dad97-908a-4704-b586-c6f23593ffdf/scratchpad
src="$1"; out="$SB/$2"
g++ -std=c++20 -O0 \
  -DSPDLOG_HEADER_ONLY -DSPDLOG_FMT_EXTERNAL -DFMT_HEADER_ONLY \
  -isystem build/deps/systemc/include \
  -isystem build/deps/spdlog/include \
  -isystem build/deps/fmt/include \
  -isystem external/doctest/doctest \
  -Isrc -Isrc/utils \
  "$src" \
  build/deps/systemc/lib/libsystemc.a \
  -lpthread -o "$out"
"$out"
