// LG3: cache-file helpers for the engine reset-state baseline -- the
// hybrid_state_v1 drained from a freshly reset, halted hart that the
// liveness gate (ResumeDriver::set_reset_baseline) compares restores
// against. Pure path/IO helpers; the capture itself lives in the simulator
// (it needs the DMI bus and the scratch-page lifts).

#pragma once

#include "hybrid/state_abi.h"
#include "hybrid/state_loader.hpp"

#include <cstdint>
#include <filesystem>
#include <fstream>
#include <optional>
#include <string>
#include <string_view>

namespace hybrid {

// <engine>-<version>-<binary mtime>-<binary size>-<elf mtime>-<elf size>.bin
// The binary identity invalidates the cache on rebuild. The ELF identity is
// part of the key because the hart free-runs a few workload instructions
// between reset and the DMI halt, so the halted state is deterministic
// per-(engine build, ELF), not per-engine.
inline auto reset_baseline_file_name(std::string_view engine,
                                     std::string_view version,
                                     uint64_t bin_mtime, uint64_t bin_size,
                                     uint64_t elf_mtime, uint64_t elf_size)
  -> std::string
{
  return std::string{engine} + "-" + std::string{version} + "-"
       + std::to_string(bin_mtime) + "-" + std::to_string(bin_size) + "-"
       + std::to_string(elf_mtime) + "-" + std::to_string(elf_size) + ".bin";
}

// $XDG_CACHE_HOME/andesim, else $HOME/.cache/andesim, else "" (disabled).
// Env values are injected so the resolution is unit-testable.
inline auto reset_baseline_cache_root(const char* xdg_cache_home,
                                      const char* home)
  -> std::filesystem::path
{
  if (xdg_cache_home && *xdg_cache_home)
    return std::filesystem::path{xdg_cache_home} / "andesim";
  if (home && *home)
    return std::filesystem::path{home} / ".cache" / "andesim";
  return {};
}

// nullopt on any load_state failure (missing / short / bad magic / wrong
// version) -- a stale or corrupt cache entry means "capture again", never
// an aborted run.
inline auto try_load_reset_baseline(const std::filesystem::path& p)
  -> std::optional<hybrid_state_v1>
{
  try {
    return load_state(p.string());
  } catch (const std::exception&) {
    return std::nullopt;
  }
}

// Create parent directories and write the raw struct. False on any failure
// -- the cache is an optimization, never a reason to abort a run.
inline auto save_reset_baseline(const std::filesystem::path& p,
                                const hybrid_state_v1& s) -> bool
{
  std::error_code ec;
  if (p.has_parent_path())
    std::filesystem::create_directories(p.parent_path(), ec);
  std::ofstream f(p, std::ios::binary | std::ios::trunc);
  if (!f) return false;
  f.write(reinterpret_cast<const char*>(&s), sizeof s);
  return static_cast<bool>(f);
}

}  // namespace hybrid
