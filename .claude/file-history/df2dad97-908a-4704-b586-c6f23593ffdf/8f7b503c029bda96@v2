#!/usr/bin/env bash
# Native compile+run of a vsim hybrid doctest (header-only, no SystemC).
# usage: build_hybrid_test.sh <src.test.cpp> <out-name>
set -euo pipefail
cd /home/nick/work/vsim_andesim
SB=/tmp/claude-1002/-home-nick-work-andesim/df2dad97-908a-4704-b586-c6f23593ffdf/scratchpad
src="$1"; out="$SB/$2"
g++ -std=c++20 -O0 \
  -isystem external/doctest/doctest \
  -Isrc -Iexternal/andesim_abi -Itests/hybrid \
  "$src" -lpthread -o "$out"
"$out"
