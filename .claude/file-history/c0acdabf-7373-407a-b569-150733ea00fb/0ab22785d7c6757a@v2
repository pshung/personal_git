// rt_priv_smode.S
//
// L6 fixture: the ROI runs in S-mode.
//
// Phase A (QEMU1, M-mode preamble): open PMP entry 0 over the whole
//   address space (S/U accesses fault when PMP is implemented and no
//   entry matches), point mtvec at the post-ROI exit handler, set
//   mstatus.MPP=S, mret into the ROI. The ENTER marker retires in
//   S-mode, so QEMU1 must drain priv=1.
// Phase B (vsim): resume must land in S-mode (dcsr.prv=1) with the PMP
//   block mirrored in; a little S-mode ALU work; the EXIT marker retires
//   in S-mode, so the vsim drain must record priv=1.
// Post-ROI: nop padding absorbs the 0-3 insn halt slack, then ecall
//   traps back to M (medeleg=0) and the handler exits via semihosting.
//   Only the standalone / oracle QEMU runs ever execute this tail.
//
// The harness asserts both drained priv fields with CHECK_PRIV=1.

#include "semihost_exit.inc"

.section .text
.globl _start
_start:
    li      t0, -1
    csrw    pmpaddr0, t0            // NAPOT over the full address space
    li      t0, 0x1F                // A=NAPOT | X | W | R
    csrw    pmpcfg0, t0

    la      t0, trap_exit
    csrw    mtvec, t0

    li      t0, (3 << 11)
    csrc    mstatus, t0             // MPP <- 0
    li      t0, (1 << 11)
    csrs    mstatus, t0             // MPP <- S (01)
    la      t0, roi
    csrw    mepc, t0
    mret                            // drop to S-mode

roi:
    slti    x0, x0, 0x5A0           // ENTER: QEMU1 drains, priv must be 1

    li      t1, 0x5000
    li      t2, 37
    mul     t3, t1, t2              // S-mode work; lands in the drained GPRs

    slti    x0, x0, 0x5A1           // EXIT: vsim drains, priv must be 1
    .rept 16                        // halt slack pad: the DMI halt lands a
    nop                             // core-dependent few insns past the
    .endr                           // trigger; keep the privilege-changing
                                    // ecall out of the halt's reach
    ecall                           // S -> M (medeleg=0): trap_exit

.align 2
trap_exit:
    li      a2, 0
    SEMIHOST_EXIT a2
