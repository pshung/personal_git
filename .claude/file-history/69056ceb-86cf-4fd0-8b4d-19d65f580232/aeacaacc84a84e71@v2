#pragma once

// Shared LM/HVM backdoor copy loops for the cpu wrappers' set_/get_
// ilm/dlm/hvm members (LM transport ROADMAP_ilm_dlm, HVM transport
// ROADMAP_hvm). Extracted verbatim from ax45mpv_premium_cpu_cluster_subsystem
// so every wrapper shares one geometry and the byte order cannot drift
// between engines.

#include <cstddef>
#include <cstdint>
#include <type_traits>
#include <vector>

// HVM bank backdoor copy: rows are wide Verilated words (e.g. VlWide<16> --
// 16 independent 32-bit data lanes per row, no ECC/parity), a geometry
// lm_backdoor_read's one-word-per-row decode below cannot express, hence the
// separate pair. Lane k of a row holds bytes 4k..4k+3, little-endian (R2,
// pinned by the head/tail probes of tests/vsim/test_vsim_hvm_load.sh).
// `base` is the bank's byte offset into the image; the write zero-fills
// where the image does not reach. The two duals share the geometry so the
// byte order cannot drift.
void hvm_bank_write(auto& mem, size_t bank_bytes,
                    const std::vector<uint8_t>& data, size_t base)
{
  constexpr size_t lanes = sizeof(mem[0]) / sizeof(mem[0][0]);
  for (size_t row = 0; row < bank_bytes / (lanes * 4); ++row)
    for (size_t lane = 0; lane < lanes; ++lane) {
      uint32_t w = 0;
      for (size_t j = 0; j < 4; ++j) {
        const size_t idx = base + row * lanes * 4 + lane * 4 + j;
        if (idx < data.size())
          w |= static_cast<uint32_t>(data[idx]) << (j * 8);
      }
      mem[row][lane] = w;
    }
}

void hvm_bank_read(auto& mem, size_t bank_bytes, uint8_t* out)
{
  constexpr size_t lanes = sizeof(mem[0]) / sizeof(mem[0][0]);
  for (size_t row = 0; row < bank_bytes / (lanes * 4); ++row)
    for (size_t lane = 0; lane < lanes; ++lane) {
      const uint32_t w = mem[row][lane];
      for (size_t j = 0; j < 4; ++j)
        out[row * lanes * 4 + lane * 4 + j] = static_cast<uint8_t>(w >> (j * 8));
    }
}

// Banked LM backdoor pair: 64-bit word w of the flat byte image lives in
// bank (w % NBanks) at row (w / NBanks) -- the interleave of the generated
// testbench's ilm_ram_init/dlm_ram_init tasks (bank = low word-address
// bits, in-bank row = word address >> log2(banks); ae350_tb.sv). Plain
// 64-bit rows only (no ECC/parity lanes); an ECC config needs the
// premium-style code ladder instead. The write zero-fills where the image
// does not reach. The two duals share the geometry so the interleave
// cannot drift.
template <typename Bank, typename... Rest>
void lm_banked_write64(const std::vector<uint8_t>& data, size_t bytes,
                       Bank& bank0, Rest&... rest)
{
  Bank* bank[] = {&bank0, &rest...};
  constexpr size_t n = 1 + sizeof...(rest);
  for (size_t w = 0; w < bytes / 8; ++w) {
    uint64_t word = 0;
    for (size_t j = 0; j < 8; ++j) {
      const size_t idx = w * 8 + j;
      if (idx < data.size())
        word |= static_cast<uint64_t>(data[idx]) << (j * 8);
    }
    (*bank[w % n])[w / n] = word;
  }
}

template <typename Bank, typename... Rest>
std::vector<uint8_t> lm_banked_read64(size_t bytes, Bank& bank0, Rest&... rest)
{
  Bank* bank[] = {&bank0, &rest...};
  constexpr size_t n = 1 + sizeof...(rest);
  std::vector<uint8_t> out(bytes);
  for (size_t w = 0; w < bytes / 8; ++w) {
    const uint64_t word = (*bank[w % n])[w / n];
    for (size_t j = 0; j < 8; ++j)
      out[w * 8 + j] = static_cast<uint8_t>(word >> (j * 8));
  }
  return out;
}

// Decode a Verilated LM SRAM array back to raw little-endian bytes -- the
// shared read loop of get_ilm/get_dlm (data bits only, ECC/parity stripped).
// DataWidth/EccType mirror the setters' #if ladder; `if constexpr` keeps the
// VlWide [0]/[1] indexing uninstantiated on scalar-typed (no-ECC) configs.
template <int DataWidth, int EccType>
std::vector<uint8_t> lm_backdoor_read(auto& mem, size_t bytes)
{
  constexpr size_t word_size = DataWidth == 64 ? 8 : 4;
  using word_t = std::conditional_t<DataWidth == 64, uint64_t, uint32_t>;
  std::vector<uint8_t> out(bytes);
  for (size_t i = 0; i < bytes / word_size; ++i) {
    word_t word;
    if constexpr (EccType == 2 && DataWidth == 64)
      word = static_cast<word_t>(mem[i][0])
             | (static_cast<word_t>(mem[i][1]) << 32);
    else if constexpr (EccType == 2)
      word = static_cast<word_t>(mem[i] & 0xFFFFFFFFull);
    else
      word = static_cast<word_t>(mem[i]);
    for (size_t j = 0; j < word_size; ++j)
      out[i * word_size + j] = static_cast<uint8_t>(word >> (j * 8));
  }
  return out;
}
