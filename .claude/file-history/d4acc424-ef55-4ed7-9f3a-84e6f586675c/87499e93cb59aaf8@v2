/* memsize demo: ONE ELF, run under various --mem-size.
 *
 * The payload verifies a small working set (4 KiB), so it runs unchanged on
 * fast, cycle AND hybrid, at ANY valid --mem-size -- the checksum never depends
 * on how much RAM the driver hands out.
 *
 * FOOTPRINT_MB (default 0) reserves a large static .bss array. The "big" build
 * (-DFOOTPRINT_MB=64) pushes the ELF's static-image top past a small --mem-size,
 * so the driver rejects it BEFORE any guest code runs (a pure driver check, not
 * a runtime fault). That is how --mem-size becomes observable in program terms;
 * see the Makefile `fit` / `check` targets.
 *
 * ROI markers are RISC-V HINT NOPs, so the same binary also runs standalone on
 * silicon; pc-trigger names the same window as `work` .. memsize_roi_end.
 */
#include <stdint.h>
#include <stdio.h>

#include <andesim/ROI.h>

#ifndef FOOTPRINT_MB
#define FOOTPRINT_MB 0
#endif
#if FOOTPRINT_MB > 0
volatile uint8_t footprint[(unsigned)FOOTPRINT_MB * 1024u * 1024u];
#endif

#define NWORDS 1024 /* 4 KiB working set: cheap even in cycle-accurate mode */
static uint32_t buf[NWORDS];

__attribute__((noinline)) uint32_t work(void)
{
  uint32_t sum = 0;
  for (int i = 0; i < NWORDS; i++)
    buf[i] = (uint32_t) i * 2654435761u; /* Knuth multiplicative hash */
  for (int i = 0; i < NWORDS; i++)
    sum += buf[i];
  return sum;
}

int main(void)
{
  andesim_ROI_begin();
  uint32_t sum = work();
  andesim_ROI_end();
  /* ROI end symbol for --pc-end: the point right after the measured window. */
  __asm__ __volatile__(".globl memsize_roi_end\nmemsize_roi_end:" ::: "memory");

#if FOOTPRINT_MB > 0
  footprint[0] = (uint8_t) sum; /* keep the reservation live */
  printf("memsize PASS checksum=0x%08x footprint=%dMB\n", sum, FOOTPRINT_MB);
#else
  printf("memsize PASS checksum=0x%08x\n", sum);
#endif
  return 0;
}
