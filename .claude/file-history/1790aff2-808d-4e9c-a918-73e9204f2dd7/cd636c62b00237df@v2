#!/usr/bin/env bash
# Asserts no fixture source carries `.globl _hybrid_*_pc` directives or
# `_hybrid_(enter|exit)_pc:` label definitions. PC-mode demos derive their
# switch PCs at runtime (tests/lib/inner_loop_roi.sh for the GEMM; explicit
# ROI_START/ROI_END for anyone else), so any planted label is dead weight
# in the ELF and an attractive nuisance for new tests. The csrwi
# 0x7C0,{0,1} insns stay; only the symbol-table footprint is removed.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)

PATTERN='(\.globl[[:space:]]+_hybrid_(enter|exit)_pc|_hybrid_(enter|exit)_pc:)'
OFFENDERS=$(grep -rnE --include='*.S' --include='*.c' --include='*.h' \
  "$PATTERN" "$ROOT/tests/fixtures" 2>/dev/null || true)

if [ -n "$OFFENDERS" ]; then
  echo "FAIL test_no_hybrid_pc_labels: dead .globl directives or labels still in fixtures:"
  echo "$OFFENDERS"
  exit 1
fi

echo "PASS test_no_hybrid_pc_labels: no .globl directives or _hybrid_*_pc: labels in tests/fixtures/"
