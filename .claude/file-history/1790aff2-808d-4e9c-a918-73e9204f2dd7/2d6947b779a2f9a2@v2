#!/usr/bin/env bash
# Asserts no fixture source plants `.globl _hybrid_enter_pc` or
# `.globl _hybrid_exit_pc`. PC-mode demos now derive switch PCs at runtime
# (tests/lib/inner_loop_roi.sh for the GEMM; explicit ROI_START/ROI_END for
# anyone else), so the exported labels are dead weight in the ELF symbol
# table. The csrwi 0x7C0,{0,1} insns and the source-level labels themselves
# stay - only the .globl exports are removed.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)

OFFENDERS=$(grep -rn --include='*.S' --include='*.c' --include='*.h' \
  '\.globl[[:space:]]\+_hybrid_enter_pc\|\.globl[[:space:]]\+_hybrid_exit_pc' \
  "$ROOT/tests/fixtures" 2>/dev/null || true)

if [ -n "$OFFENDERS" ]; then
  echo "FAIL test_no_globl_hybrid_pc: dead .globl directives still in fixtures:"
  echo "$OFFENDERS"
  exit 1
fi

echo "PASS test_no_globl_hybrid_pc: no .globl _hybrid_*_pc directives in tests/fixtures/"
