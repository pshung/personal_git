#!/usr/bin/env bash
# derive_inner_loop_roi: locate the first vle32.v PC and the first vse32.v PC
# after it inside the <vmatmul_kernel> section of an ELF. Those two PCs frame
# one full traversal of the inner k-loop in the RVV GEMM kernel and serve as
# ROI_START / ROI_END for PC-trigger demos against the markerless GEMM twin.
#
# Usage:
#   . tests/lib/inner_loop_roi.sh
#   read -r START END < <(derive_inner_loop_roi <elf> <objdump>)
#
# On success prints "0x<start> 0x<end>" (single line, space-separated) and
# returns 0. On miss prints nothing and returns 1.

derive_inner_loop_roi() {
  local elf="$1" objdump="$2"
  "$objdump" -d "$elf" 2>/dev/null | awk '
    function bare(addr,   x) { x = addr; sub(":", "", x); return x }
    /^[0-9a-f]+ <vmatmul_kernel>:/      { in_kern = 1; next }
    in_kern && /^[0-9a-f]+ <[^>]+>:/    { in_kern = 0 }
    in_kern && $3 == "vle32.v" && !start { start = bare($1) }
    in_kern && start && $3 == "vse32.v" {
      print "0x" start, "0x" bare($1); found = 1; exit
    }
    END { exit (found ? 0 : 1) }
  '
}
