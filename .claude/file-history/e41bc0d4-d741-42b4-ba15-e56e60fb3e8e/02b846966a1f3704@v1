// Shared-mmap allocation -- a C++ port of tools/hsim_shm.py. See shm.hpp.
#include "shm.hpp"

#include <cctype>
#include <cstdio>
#include <cstdlib>
#include <regex>
#include <vector>

#include <sys/stat.h>
#include <sys/statvfs.h>
#include <unistd.h>

namespace andes_sim {
namespace {

constexpr long long kSafetyMargin = 256LL * 1024 * 1024;  // 256 MiB headroom

// Free bytes on the filesystem holding `dir`, or -1 if statvfs fails.
long long free_bytes(const std::string& dir) {
  struct statvfs vfs;
  if (statvfs(dir.c_str(), &vfs) != 0) return -1;
  return static_cast<long long>(vfs.f_bavail) *
         static_cast<long long>(vfs.f_frsize);
}

// Human-readable byte count: "8.0 GiB", "512.0 MiB", "1024 B". Mirrors
// hsim_shm._format_bytes (one decimal, TiB/GiB/MiB/KiB, else "N B").
std::string format_bytes(long long n) {
  struct Unit {
    const char* suffix;
    long long mul;
  };
  static const Unit units[] = {
      {"TiB", 1024LL * 1024 * 1024 * 1024},
      {"GiB", 1024LL * 1024 * 1024},
      {"MiB", 1024LL * 1024},
      {"KiB", 1024LL},
  };
  for (const Unit& u : units) {
    if (n >= u.mul) {
      char buf[64];
      std::snprintf(buf, sizeof(buf), "%.1f %s",
                    static_cast<double>(n) / static_cast<double>(u.mul),
                    u.suffix);
      return buf;
    }
  }
  return std::to_string(n) + " B";
}

}  // namespace

long long parse_size(const std::string& spec, std::string& err) {
  static const std::regex re(R"(\s*(\d+(?:\.\d+)?)\s*([KMGT]?)\s*)",
                             std::regex::icase);
  std::smatch m;
  if (!std::regex_match(spec, m, re)) {
    err = "invalid mmap size '" + spec +
          "': expected <number>[K|M|G|T] (e.g. '128M', '8G', '1024')";
    return 0;
  }
  const double num = std::stod(m[1].str());
  long long mult = 1;
  if (m[2].length()) {
    switch (std::toupper(static_cast<unsigned char>(m[2].str()[0]))) {
      case 'K': mult = 1024LL; break;
      case 'M': mult = 1024LL * 1024; break;
      case 'G': mult = 1024LL * 1024 * 1024; break;
      case 'T': mult = 1024LL * 1024 * 1024 * 1024; break;
    }
  }
  // Truncate toward zero like Python int(float(num) * multiplier).
  const long long size =
      static_cast<long long>(num * static_cast<double>(mult));
  if (size <= 0) {
    err = "invalid mmap size '" + spec + "': must be > 0";
    return 0;
  }
  err.clear();
  return size;
}

std::string select_mmap_dir(long long size, std::string& err) {
  const char* pinned = std::getenv("HSIM_MMAP_DIR");
  const bool have_pin = pinned && pinned[0];
  const std::string target = have_pin ? std::string(pinned) : "/dev/shm";
  const std::string label =
      have_pin ? "HSIM_MMAP_DIR='" + std::string(pinned) + "'"
               : "/dev/shm (default)";

  struct stat sb;
  if (stat(target.c_str(), &sb) != 0 || !S_ISDIR(sb.st_mode)) {
    err = "mmap directory does not exist: " + target + " (" + label +
          "); set HSIM_MMAP_DIR=/path/to/existing/dir";
    return "";
  }
  const long long free = free_bytes(target);
  const long long need = size + kSafetyMargin;
  if (free < need) {
    err = target + " has " + std::to_string(free) + " bytes free, need " +
          std::to_string(need) + " (size=" + std::to_string(size) +
          " + 256 MiB margin); set HSIM_MMAP_DIR to a directory with more "
          "free space";
    return "";
  }
  err.clear();
  return target;
}

std::string allocate(long long size, std::string& err,
                     const std::string& prefix) {
  const std::string dir = select_mmap_dir(size, err);
  if (dir.empty()) return "";

  std::string tmpl = dir + "/" + prefix + "XXXXXX";
  std::vector<char> buf(tmpl.begin(), tmpl.end());
  buf.push_back('\0');
  const int fd = mkstemp(buf.data());
  if (fd < 0) {
    err = "failed to create mmap file in " + dir;
    return "";
  }
  close(fd);
  const std::string path(buf.data());
  if (truncate(path.c_str(), size) != 0) {
    unlink(path.c_str());
    err = "failed to size mmap file " + path;
    return "";
  }

  std::printf("[hsim mmap] %s at %s (free: %s)\n", format_bytes(size).c_str(),
              dir.c_str(), format_bytes(free_bytes(dir)).c_str());
  std::fflush(stdout);
  err.clear();
  return path;
}

}  // namespace andes_sim
