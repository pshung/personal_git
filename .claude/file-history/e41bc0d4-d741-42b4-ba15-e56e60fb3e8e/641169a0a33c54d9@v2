/* One ELF, three engines: printf over the vplat runtime (UART stdio +
 * SimControl exit, no semihosting).
 *
 *   fast    QEMU services the UART + exit device, prints, exits 0
 *   cycle   vsim does the same, from reset, cycle-accurately
 *   hybrid  --trigger pc --pc-start say_hello --pc-end vplat_roi_end:
 *           QEMU fast-forwards the newlib boot, vsim measures printf
 *           going out the modeled UART
 *
 * Deliberately NO csr markers (csrwi 0x7C0, ...): CSR 0x7C0 is MILMB on
 * the Andes core, and the exit marker's uimm=1 sets ILM-enable with base
 * 0, shadowing the DRAM this program runs from. Hybrid runs never execute
 * the exit marker on QEMU (it retires on vsim, where the drain fires
 * first), but a standalone fast run executes both markers, so an
 * engine-portable binary must delimit its ROI by PC instead.
 */

#include <stdio.h>

__attribute__((noinline)) void say_hello(void)
{
  printf("hello from vplat\n");
}

int main(void)
{
  say_hello();
  /* ROI end marker for --pc-end: the return point right after the call. */
  __asm__ __volatile__(".globl vplat_roi_end\nvplat_roi_end:" ::: "memory");
  return 0;
}
