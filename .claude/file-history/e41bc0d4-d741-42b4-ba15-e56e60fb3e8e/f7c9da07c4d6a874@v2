// Encoders that are the inverse of hybrid_match_handoff_insn. Used by the
// hybrid handoff tests (insn_match, csr_trigger, handoff_controller) to
// construct the marker HINTs -- and near-miss variants -- with explicit
// fields.

#pragma once

#include <array>
#include <cstdint>
#include <span>

namespace hybrid::test
{

// slti rd, rs1, imm: OP-IMM (0x13), funct3=010, imm[31:20]. The marker
// HINTs pin rd=rs1=x0; the explicit fields let tests build near-misses.
inline constexpr auto encode_slti(uint32_t rd, uint32_t rs1, uint32_t imm)
  -> uint32_t
{
  return (imm << 20) | (rs1 << 15) | (0b010u << 12) | (rd << 7) | 0x13u;
}

template<std::size_t N>
auto as_bytes(const std::array<uint32_t, N>& a) -> std::span<const uint8_t>
{
  return std::span{reinterpret_cast<const uint8_t*>(a.data()),
                   N * sizeof(uint32_t)};
}

}  // namespace hybrid::test
