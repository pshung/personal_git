 */

#include "qemu/osdep.h"
#include "hw/sysbus.h"
#include "qapi/error.h"
#include "qemu/log.h"
#include "qemu/module.h"
#include "sysemu/runstate.h"
#include "exec/cpu-common.h"
#include "hw/misc/andes_sim_control.h"
#include "sysemu/sysemu.h"

enum {
    SIM_CMD_FINISHED = 0x01234567,
    SIM_CMD_PASSED   = 0x01234568,
    SIM_CMD_FAILED   = 0x01234569,
    SIM_CMD_WARNING  = 0x01234570,
    SIM_CMD_SKIPPED  = 0x01234571,
    SIM_CMD_NEWLINE  = 0xddddeeee,
};

enum {
    REG_SIM_COMMAND = 0x00,
    REG_PUTCHAR     = 0x04,
    REG_HTIF_CMD    = 0x10,
};

static void sim_command(uint32_t cmd)
{
    switch (cmd) {
    case SIM_CMD_FINISHED:
    case SIM_CMD_PASSED:
    case SIM_CMD_SKIPPED:
        qemu_system_shutdown_request_with_code(
            SHUTDOWN_CAUSE_GUEST_SHUTDOWN, 0);
        return;
    case SIM_CMD_FAILED:
    case SIM_CMD_WARNING:
        qemu_system_shutdown_request_with_code(
            SHUTDOWN_CAUSE_GUEST_SHUTDOWN, 1);
        return;
    case SIM_CMD_NEWLINE:
        fputc('\n', stdout);
        fflush(stdout);
        return;
    default:
        if (cmd < 0x100) {
            qemu_system_shutdown_request_with_code(
                SHUTDOWN_CAUSE_GUEST_SHUTDOWN, cmd);
            return;
        }
        qemu_log_mask(LOG_GUEST_ERROR,
                      "%s: unknown sim command 0x%08x\n", __func__, cmd);
    }
}

/*
 * HTIF frontend syscalls, the byte-exact mirror of vsim's
 * verilator/src/htif/sys_call.hpp. The guest stages 8x u64 in an aligned
 * `magicmem` block ([0]=nr, [1..7]=args), writes its guest-physical
 * address to REG_HTIF_CMD, and reads the return value back from
 * magicmem[0]. Pointer args are guest addresses; paths resolve on the
 * host relative to the QEMU process cwd, exactly as vsim resolves them.
 */

#define HTIF_MAGICMEM_WORDS 8
#define HTIF_PATH_MAX       4096
#define HTIF_IO_MAX         (16 * 1024 * 1024)

/* newlib's BSD-derived O_* differ from Linux (O_CREAT 0x200 vs 0x40, ...);
 * same translation as sys_call.hpp's newlib_to_linux_open_flags. */
static int newlib_to_host_open_flags(uint64_t nl)
{
    int host = 0;

    switch (nl & 3) {
    case 0: host |= O_RDONLY; break;
    case 1: host |= O_WRONLY; break;
    case 2: host |= O_RDWR;   break;
    }
    if (nl & 0x0008) {
        host |= O_APPEND;
    }
    if (nl & 0x0200) {
        host |= O_CREAT;
    }
    if (nl & 0x0400) {
        host |= O_TRUNC;
    }
    if (nl & 0x0800) {
        host |= O_EXCL;
    }
    if (nl & 0x4000) {
        host |= O_NONBLOCK;
    }
    if (nl & 0x8000) {
        host |= O_NOCTTY;
    }
    return host;
}

/* Copy a NUL-terminated guest string into buf; false if unterminated. */
static bool read_guest_str(uint64_t addr, char *buf, size_t bufsz)
{
    size_t i;

    for (i = 0; i < bufsz; i++) {
        cpu_physical_memory_read(addr + i, &buf[i], 1);
        if (buf[i] == '\0') {
            return true;
        }
    }
    return false;
}

/* Mirror sys_call.hpp's stat writeback: ONLY st_mode and st_size land in
 * the guest's struct stat (newlib RV64 / pico_stat layout: st_mode is the
 * u32 at offset 4, st_size the i64 at offset 16). */
static void write_guest_stat(uint64_t gst, const struct stat *st)
{
    uint32_t mode = st->st_mode;
    int64_t size = st->st_size;

    cpu_physical_memory_write(gst + 4, &mode, sizeof(mode));
    cpu_physical_memory_write(gst + 16, &size, sizeof(size));
}

static uint64_t htif_path1_call(uint64_t nr, const char *path, uint64_t a1,
                                uint64_t a2)
{
    struct stat st;
    int ret;

    switch (nr) {
    case 6: /* open */
        return open(path, newlib_to_host_open_flags(a1), (mode_t)a2);
    case 13: /* access */
        return access(path, a1);
    case 18: /* lstat */
    case 19: /* stat */
        ret = (nr == 18) ? lstat(path, &st) : stat(path, &st);
        if (ret == 0) {
            write_guest_stat(a1, &st);
        }
        return ret;
    case 22: /* unlink */
        return unlink(path);
    default:
        g_assert_not_reached();
    }
}

static uint64_t htif_dispatch(uint64_t *a)
{
    char path[HTIF_PATH_MAX];
    char path2[HTIF_PATH_MAX];
    struct stat st;
    int ret;

    switch (a[0]) {
    case 5: { /* gettimeofday: timeval_64 {u64 sec, u64 usec} at a[1] */
        struct timeval tv;
        uint64_t gtv[2];

        if (gettimeofday(&tv, NULL) != 0) {
            return -1;
        }
        gtv[0] = tv.tv_sec;
        gtv[1] = tv.tv_usec;
        cpu_physical_memory_write(a[1], gtv, sizeof(gtv));
        return 0;
    }
    case 6: /* open(path, nl_flags, mode) */
    case 13: /* access(path, mode) */
    case 18: /* lstat(path, st) */
    case 19: /* stat(path, st) */
    case 22: /* unlink(path) */
        if (!read_guest_str(a[1], path, sizeof(path))) {
            return -1;
        }
        return htif_path1_call(a[0], path, a[2], a[3]);
    case 7: { /* write(fd, buf, len) */
        void *buf;
        ssize_t n;

        if (a[3] > HTIF_IO_MAX) {
            return -1;
        }
        buf = g_malloc(a[3]);
        cpu_physical_memory_read(a[2], buf, a[3]);
        n = write(a[1], buf, a[3]);
        g_free(buf);
        return n;
    }
    case 8: { /* getcwd(buf, size): nonzero (the guest buf) on success */
        char *cwd;

        if (a[2] > HTIF_IO_MAX) {
            return 0;
        }
        cwd = g_malloc0(a[2] ? a[2] : 1);
        if (getcwd(cwd, a[2] ? a[2] : 1) == NULL) {
            g_free(cwd);
            return 0;
        }
        cpu_physical_memory_write(a[1], cwd, a[2]);
        g_free(cwd);
        return a[1];
    }
    case 9: /* lseek(fd, offset, whence) */
        return lseek(a[1], a[2], a[3]);
    case 10: { /* read(fd, buf, len) */
        void *buf;
        ssize_t n;

        if (a[3] > HTIF_IO_MAX) {
            return -1;
        }
        buf = g_malloc(a[3]);
        n = read(a[1], buf, a[3]);
        if (n > 0) {
            cpu_physical_memory_write(a[2], buf, n);
        }
        g_free(buf);
        return n;
    }
    case 11: /* flen(fd) */
        if (fstat(a[1], &st) != 0) {
            return -1;
        }
        return st.st_size;
    case 12: /* close(fd) */
        return close(a[1]);
    case 14: /* faccessat(dirfd, path, mode, flags) */
        if (!read_guest_str(a[2], path, sizeof(path))) {
            return -1;
        }
        return faccessat(a[1], path, a[3], a[4]);
    case 15: /* fstat(fd, st) */
        ret = fstat(a[1], &st);
        if (ret == 0) {
            write_guest_stat(a[2], &st);
        }
        return ret;
    case 16: /* fstatat(dirfd, path, st, flags) */
        if (!read_guest_str(a[2], path, sizeof(path))) {
            return -1;
        }
        ret = fstatat(a[1], path, &st, a[4]);
        if (ret == 0) {
            write_guest_stat(a[3], &st);
        }
        return ret;
    case 17: /* link(old, new) */
    case 21: /* rename(old, new) */
        if (!read_guest_str(a[1], path, sizeof(path)) ||
            !read_guest_str(a[2], path2, sizeof(path2))) {
            return -1;
        }
        return (a[0] == 17) ? link(path, path2) : rename(path, path2);
    case 20: /* openat(dirfd, path, nl_flags) */
        if (!read_guest_str(a[2], path, sizeof(path))) {
            return -1;
        }
        return openat(a[1], path, newlib_to_host_open_flags(a[3]));
    default:
        qemu_log_mask(LOG_GUEST_ERROR,
                      "%s: invalid HTIF syscall %" PRIu64 "\n", __func__,
                      a[0]);
        return -1;
    }
}

static void htif_command(uint64_t tohost)
{
    uint64_t dev = tohost >> 56;
    uint64_t cmd = (tohost >> 48) & 0xff;
    uint64_t payload = (tohost << 16) >> 16;
    uint64_t args[HTIF_MAGICMEM_WORDS];

    if (dev != 0 || cmd != 0) {
        qemu_log_mask(LOG_GUEST_ERROR,
                      "%s: unknown HTIF device %" PRIu64 " cmd %" PRIu64 "\n",
                      __func__, dev, cmd);
        return;
    }
    cpu_physical_memory_read(payload, args, sizeof(args));
    args[0] = htif_dispatch(args);
    cpu_physical_memory_write(payload, args, sizeof(args));
}

static uint64_t andes_sim_control_read(void *opaque, hwaddr addr,
                                       unsigned int size)
{
    return 0;
}

static void andes_sim_control_write(void *opaque, hwaddr addr,
                                    uint64_t val64, unsigned int size)
{
    if (addr == REG_SIM_COMMAND && size == 4) {
        sim_command((uint32_t)val64);
        return;
    }
    if (addr == REG_PUTCHAR && size == 1) {
        fputc((int)(val64 & 0xff), stdout);
        fflush(stdout);
        return;
    }
    if (addr == REG_HTIF_CMD && size == 8) {
        htif_command(val64);
        return;
    }
    qemu_log_mask(LOG_GUEST_ERROR,
                  "%s: spurious write: addr=0x%x size=%u val=0x%016" PRIx64
                  "\n", __func__, (int)addr, size, val64);
}

static const MemoryRegionOps andes_sim_control_ops = {
    .read = andes_sim_control_read,
    .write = andes_sim_control_write,
    .endianness = DEVICE_LITTLE_ENDIAN,
    .valid = {
        .min_access_size = 1,
        .max_access_size = 8
    },
    /* Without impl.max = 8 the core splits the guest's 64-bit HTIF
     * command store into two 32-bit writes (vsim reassembles those for
     * RV32 guests; this device is RV64-only and wants them whole). */
    .impl = {
        .min_access_size = 1,
        .max_access_size = 8
    }
};

static void andes_sim_control_init(Object *obj)
{
    AndesSimControlState *s = ANDES_SIM_CONTROL(obj);

    memory_region_init_io(&s->mmio, obj, &andes_sim_control_ops, s,
                          TYPE_ANDES_SIM_CONTROL, 0x1000);
    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mmio);
}

static const TypeInfo andes_sim_control_info = {
    .name          = TYPE_ANDES_SIM_CONTROL,
    .parent        = TYPE_SYS_BUS_DEVICE,
    .instance_size = sizeof(AndesSimControlState),
    .instance_init = andes_sim_control_init,
};

static void andes_sim_control_register_types(void)
{
    type_register_static(&andes_sim_control_info);
}

type_init(andes_sim_control_register_types)

DeviceState *andes_sim_control_create(hwaddr addr)
{
    DeviceState *dev = qdev_new(TYPE_ANDES_SIM_CONTROL);
    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, addr);
    return dev;
}
