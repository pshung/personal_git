/*
 * Andes simulation control device
 *
 * MMIO mirror of vsim's SimControl model (verilator/src/platform/
 * sim_control.hpp) at the same guest address, so a single bare-metal ELF
 * behaves identically on QEMU's andes_ae350 and on the cycle-accurate
 * vsim. Register layout:
 *
 *   0x00  W32  simulation command / exit code
 *              0x01234567 FINISHED, 0x01234568 PASSED, 0x01234571 SKIPPED
 *                  -> shut down with exit code 0
 *              0x01234569 FAILED, 0x01234570 WARNING
 *                  -> shut down with exit code 1
 *              0xddddeeee NEWLINE -> '\n' on host stdout
 *              < 0x100 -> shut down with that exit code
 *   0x04  W8   putchar on host stdout
 *   0x10  W64  HTIF command (frontend syscall via magicmem)
 *
