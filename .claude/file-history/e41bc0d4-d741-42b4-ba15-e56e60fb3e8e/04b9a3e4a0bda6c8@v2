/* File-I/O parity probe for the vplat runtime: fopen/fwrite/fread/remove
 * must behave identically on QEMU (fast) and vsim (cycle), both serving
 * the HTIF frontend syscalls host-side. The file lands in the engine
 * process's working directory. */

#include <stdio.h>
#include <string.h>

int main(void)
{
  const char* path = "vplat_file_test.tmp";
  const char payload[] = "0123456789abcdef";

  FILE* f = fopen(path, "w");
  if (!f) {
    printf("FILEIO: fopen(w) failed\n");
    return 1;
  }
  size_t n = fwrite(payload, 1, sizeof payload, f);
  fclose(f);
  if (n != sizeof payload) {
    printf("FILEIO: short write (%u)\n", (unsigned) n);
    return 1;
  }

  char back[sizeof payload];
  memset(back, 0, sizeof back);
  f = fopen(path, "r");
  if (!f) {
    printf("FILEIO: fopen(r) failed\n");
    return 1;
  }
  n = fread(back, 1, sizeof back, f);
  fclose(f);
  if (n != sizeof payload || memcmp(payload, back, sizeof payload) != 0) {
    printf("FILEIO: readback mismatch (%u)\n", (unsigned) n);
    return 1;
  }

  if (remove(path) != 0) {
    printf("FILEIO: remove failed\n");
    return 1;
  }

  printf("file io ok\n");
  return 0;
}
