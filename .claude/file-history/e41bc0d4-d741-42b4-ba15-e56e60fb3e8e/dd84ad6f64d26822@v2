// Small text helpers shared across the command renderers (list, doctor).
// Header-only; no dependencies beyond the standard library.
#ifndef ANDES_SIM_STRUTIL_HPP
#define ANDES_SIM_STRUTIL_HPP

#include <string>
#include <vector>

namespace andes_sim {

// Left-justify `s` to width `w` (pad with spaces; never truncate).
inline std::string ljust(std::string s, size_t w) {
  if (s.size() < w) s.append(w - s.size(), ' ');
  return s;
}

// Join `v` with `sep` between elements.
inline std::string join(const std::vector<std::string>& v, const char* sep = ",") {
  std::string s;
  for (size_t k = 0; k < v.size(); ++k) {
    if (k) s += sep;
    s += v[k];
  }
  return s;
}

// Engine HW width param (VLEN/DLEN/ELEN/XLEN) for display: a positive width
// prints as its number, 0/absent "-".
inline std::string vlen_str(long v) {
  return v > 0 ? std::to_string(v) : std::string("-");
}

}  // namespace andes_sim

#endif  // ANDES_SIM_STRUTIL_HPP
