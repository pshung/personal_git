/* Tier-2 C-level fixture: 1D 3-tap FIR convolution (2-phase: QEMU1 -> vsim),
 * with the V regfile as the carrier of state from QEMU 1 into vsim.
 *
 * Workload
 *   y[i] = x[i-1] + 2 * x[i] + x[i+1]     (zero-padded at the edges)
 *   x[i] = i + 1                          (i in 0..15)
 *
 * Phase split
 *   QEMU 1   generate x via vid + 1
 *   vsim     apply the FIR kernel (vslide1up / vslide1down + vadd), then
 *            store y to .bss inside the ROI so the kernel is anchored, and
 *            drain.
 *
 * V regfile transport
 *   x rides QEMU 1 -> vsim in its compiler-picked V register. The fixture
 *   never names a physical V register; vsim transparently saves/restores the
 *   full 32-V-reg regfile bit-identically at the boundary via the Debug
 *   Module Program Buffer (see ResumeDriver and StateDrain), so the
 *   compiler's "x lives in v_compiler_choice" tracking stays valid across
 *   enter_vsim and the kernel can be written in pure RVV intrinsics.
 *
 * (The old phase-3 QEMU2 store + scalar verify -- which carried y across the
 * vsim -> QEMU2 boundary -- was removed with the QEMU2 leg. y is now stored
 * inside the ROI purely to keep the kernel from being eliminated.)
 *
 * Transport-coverage note
 *   This exercises V-regfile transport only if the compiler computes x in
 *   phase 1 and carries it in a V register across enter_vsim (rather than
 *   rematerializing vid+1 in phase 2). The Andes GCC does this on its own at
 *   -O1..-O3. If a future toolchain rematerializes x past the drain, the
 *   kernel would recompute instead of transport (silent coverage loss);
 *   re-add an asm volatile("" : : "vr"(x)) force-live guard before enter_vsim
 *   then.
 *
 * VLEN contract: VLEN=512, e32 m1 -> 16 lanes per V reg. N=16.
 *
 * The enter_vsim/exit_vsim span is kept syscall-free so the transport
 * test measures only the V kernel (vplat syscalls would work, but add
 * UART/SimControl cycles).
 */
#include "runtime/rt_c_helpers.h"

#include <riscv_vector.h>
#include <stdint.h>

#define N 16

static int32_t y_out[N];

int main(void)
{
  const size_t vl = __riscv_vsetvl_e32m1((size_t) N);

  /* Phase 1 (QEMU 1): x = [1, 2, 3, ..., N] via vid + 1. */
  const vuint32m1_t vid_u = __riscv_vid_v_u32m1(vl);
  const vint32m1_t  x     = __riscv_vadd_vx_i32m1(
        __riscv_vreinterpret_v_u32m1_i32m1(vid_u), 1, vl);

  enter_vsim();

  /* Phase 2 (vsim): 3-tap FIR convolution
   *   x_left[i]  = (i == 0)     ? 0 : x[i - 1]   (vslide1up)
   *   x_right[i] = (i == N - 1) ? 0 : x[i + 1]   (vslide1down)
   *   y[i]       = x_left[i] + 2 * x[i] + x_right[i] */
  const vint32m1_t x_left  = __riscv_vslide1up_vx_i32m1(x, 0, vl);
  const vint32m1_t x_right = __riscv_vslide1down_vx_i32m1(x, 0, vl);
  const vint32m1_t two_x   = __riscv_vsll_vx_i32m1(x, 1, vl);          /* 2*x */
  const vint32m1_t partial = __riscv_vadd_vv_i32m1(x_left, two_x, vl); /* x_left + 2x */
  const vint32m1_t y       = __riscv_vadd_vv_i32m1(partial, x_right, vl);

  /* Anchor y to .bss inside the ROI so the FIR kernel is not eliminated now
   * that the QEMU2 verify (which consumed y) is gone. */
  __riscv_vse32_v_i32m1(y_out, y, vl);

  exit_vsim();

  return 0;
}
