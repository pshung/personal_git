// Pattern recogniser for the magic handoff marker convention. The same
// predicate runs in two places: the QEMU TCG plugin (C) and the vsim PC
// pre-scan (C++).
//
// The markers are RISC-V HINT instructions: SLTI with rd=x0 discards its
// result, so it is an architectural NOP on every conforming core. Marker
// binaries therefore run unmodified on real silicon and on every engine
// (fast/cycle/hybrid) -- unlike the retired `csrwi 0x7C0` markers, where
// CSR 0x7C0 is MILMB on Andes cores and the exit marker enabled ILM at
// base 0, killing standalone runs. The 12-bit immediate carries the
// marker kind; rs1 is pinned to x0 so each marker is one exact 32-bit
// word. SLTI has no compressed form, so markers are always 4 bytes.

#ifndef HYBRID_INSN_MATCH_H
#define HYBRID_INSN_MATCH_H

#include <stdbool.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

typedef enum
{
  HYBRID_HANDOFF_NONE  = 0,
  HYBRID_HANDOFF_ENTER = 1,  // slti x0, x0, 0x5A0
  HYBRID_HANDOFF_EXIT  = 2,  // slti x0, x0, 0x5A1
} hybrid_handoff_kind;

// slti x0, x0, imm: OP-IMM (0x13), funct3=010, rd=rs1=x0, imm[31:20].
#define HYBRID_MARKER_ENTER_INSN 0x5A002013u
#define HYBRID_MARKER_EXIT_INSN  0x5A102013u

// Returns true when `insn` is one of the two marker HINTs. On match,
// *out_kind is set to ENTER or EXIT.
static inline bool hybrid_match_handoff_insn(uint32_t insn,
                                             hybrid_handoff_kind* out_kind)
{
  if (insn == HYBRID_MARKER_ENTER_INSN) {
    *out_kind = HYBRID_HANDOFF_ENTER;
    return true;
  }
  if (insn == HYBRID_MARKER_EXIT_INSN) {
    *out_kind = HYBRID_HANDOFF_EXIT;
    return true;
  }
  return false;
}

#ifdef __cplusplus
}  // extern "C"
#endif

#endif  // HYBRID_INSN_MATCH_H
