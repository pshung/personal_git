/*
 * F14 fixture: small C program with NO ROI marker HINT anywhere.
 * Exits naturally via crt0 -> _exit (vplat SimControl exit: a board
 * shutdown request serviced on QEMU's main loop).
 *
 * QEMU shuts down and runs its atexit chain; the hybrid_handoff
 * plugin's `drain_at_exit=1` callback writes a context-free count
 * record (registers unread -- there is no vCPU context on the main
 * thread) and _exit(200) so the SimPoint estimate pipeline can read
 * minstret as N_total.
 *
 * Loop is sized so the BBV profile pass at slice=1000 produces enough
 * rows for SimPoint --max-k 2 (>= 2 rows; we want >= 10 for safety).
 */
#include <stdio.h>

int main(void) {
    long acc = 0;
    for (long i = 0; i < 2000; i++) {
        acc += i * 3 + 7;
    }
    printf("no_trigger_exit acc=%ld\n", acc);
    return 0;
}
