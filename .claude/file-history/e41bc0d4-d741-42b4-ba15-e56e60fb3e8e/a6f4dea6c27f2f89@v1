// Shared-mmap allocation for andes-sim -- a C++ port of tools/hsim_shm.py.
//
// One rule: the caller asks for `size` bytes; we honor HSIM_MMAP_DIR (else
// /dev/shm), statvfs-check free space, allocate a sparse file with
// mkstemp+truncate, and print one status line. No fallback chain, no
// filesystem-type probing. (The HSIM_MMAP_DIR name and "[hsim mmap]" status
// line stay verbatim with the Python golden until the F14 rename.)
#ifndef ANDES_SIM_SHM_HPP
#define ANDES_SIM_SHM_HPP

#include <string>

namespace andes_sim {

// Parse "8G" / "512M" / "1024" / "1.5G" into a positive byte count. On success
// returns the count and leaves `err` empty; on failure returns 0 and sets `err`
// to the argparse-style message. Mirrors hsim_shm.parse_size (fractional values
// truncate, like Python int(float(num) * mult)).
long long parse_size(const std::string& spec, std::string& err);

// Resolve the pinned mmap directory (HSIM_MMAP_DIR if set, else /dev/shm) and
// validate it can hold size + 256 MiB. Returns the directory on success; on
// failure returns "" and sets `err`. Mirrors hsim_shm.select_mmap_dir.
std::string select_mmap_dir(long long size, std::string& err);

// Allocate a sparse mmap file of `size` bytes in the pinned dir (mkstemp +
// truncate), print one "[hsim mmap] <size> at <dir> (free: <free>)" line, and
// return its path. On failure returns "" and sets `err`. Caller owns the file's
// lifetime (unlink when done). Mirrors hsim_shm.allocate.
std::string allocate(long long size, std::string& err,
                     const std::string& prefix = "hsim-shm.");

}  // namespace andes_sim

#endif  // ANDES_SIM_SHM_HPP
