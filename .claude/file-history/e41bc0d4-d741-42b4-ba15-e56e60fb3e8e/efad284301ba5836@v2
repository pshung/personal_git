// Recognises the two marker HINTs `slti x0, x0, 0x5A0/0x5A1`, the magic
// handoff trigger. Pure bit pattern; the same predicate is consumed by the
// QEMU plugin (C) and by the vsim-side PC pre-scan (C++).
//
// rd=x0 integer-computational instructions are architectural NOPs (RISC-V
// HINT space), so marker binaries run unmodified on every engine and on
// real silicon -- unlike the retired `csrwi 0x7C0` markers (MILMB on Andes
// cores).

#include "hybrid/insn_match.h"

#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest.h>

#include "insn_encoders.hpp"

#include <cstdint>

using hybrid::test::encode_slti;

TEST_CASE("slti x0, x0, 0x5A0 (enter) matches")
{
  const auto insn = encode_slti(0, 0, 0x5A0);
  hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
  CHECK(hybrid_match_handoff_insn(insn, &kind));
  CHECK(kind == HYBRID_HANDOFF_ENTER);
  CHECK(insn == 0x5A002013u);  // pin the published wire encoding
}

TEST_CASE("slti x0, x0, 0x5A1 (exit) matches")
{
  const auto insn = encode_slti(0, 0, 0x5A1);
  hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
  CHECK(hybrid_match_handoff_insn(insn, &kind));
  CHECK(kind == HYBRID_HANDOFF_EXIT);
  CHECK(insn == 0x5A102013u);  // pin the published wire encoding
}

TEST_CASE("other immediates do not match (plain slti HINTs stay free)")
{
  hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
  CHECK_FALSE(hybrid_match_handoff_insn(encode_slti(0, 0, 0x5A2), &kind));
  CHECK_FALSE(hybrid_match_handoff_insn(encode_slti(0, 0, 0), &kind));
}

TEST_CASE("non-zero rd disqualifies (a real slti, not a HINT)")
{
  hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
  CHECK_FALSE(hybrid_match_handoff_insn(encode_slti(3, 0, 0x5A0), &kind));
}

TEST_CASE("non-zero rs1 disqualifies (still a HINT, but not our marker)")
{
  hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
  CHECK_FALSE(hybrid_match_handoff_insn(encode_slti(0, 5, 0x5A0), &kind));
}

TEST_CASE("sltiu (funct3=011) with the marker imm does not match")
{
  const uint32_t insn =
    (0x5A0u << 20) | (0u << 15) | (0b011u << 12) | (0u << 7) | 0x13u;
  hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
  CHECK_FALSE(hybrid_match_handoff_insn(insn, &kind));
}

TEST_CASE("the retired CSR markers (csrwi 0x7C0, 0/1) no longer match")
{
  hybrid_handoff_kind kind = HYBRID_HANDOFF_NONE;
  CHECK_FALSE(hybrid_match_handoff_insn(0x7C005073u, &kind));  // csrwi 0x7C0,0
  CHECK_FALSE(hybrid_match_handoff_insn(0x7C00D073u, &kind));  // csrwi 0x7C0,1
}
