+// F6 last mile: drive the accurate leg's Andes-CSR transport from the registered
+// manifest instead of the engine's compiled-in config macros.
+//
+// The registration directory tests/engines/<engine>-<hash>/csr_manifest.csv is
+// the measured ground truth for which CSRs an engine transports. This module
+// turns that table into the `--transport-csrs` address list vsim consumes
+// (hybrid::andes_caps_from_transport_set rebuilds the exact caps from it), so
+// the runtime and the registration audit share ONE source of truth -- retiring
+// the config->caps mirror (scripts/config_inc_to_andes_caps.py) and its parity
+// guard.
+//
+// transported_csr_addrs is the pure, unit-testable core (no filesystem, no
+// subprocess): manifest CSV text in, transported addresses out. The locating +
+// hashing glue lives in run_plan.cpp (integration-tested by the e2e --verify
+// flywheel).
+#ifndef ANDESIM_TRANSPORT_CSRS_HPP
+#define ANDESIM_TRANSPORT_CSRS_HPP
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace andes_sim {
+
+// Parse a csr_manifest.csv and return the `addr` cells of every row whose
+// `transported` column is "yes", in file order. Columns are located by header
+// name (robust to reordering). A range row ("0xLO~HI", e.g. pmpaddr1~63)
+// contributes its LOW address only -- enough for andes_caps_from_transport_set,
+// which keys each address on its shared feature gate, so one member of a
+// gate-group selects the whole group. Blank lines are skipped; a missing header
+// or either required column yields an empty vector.
+std::vector<std::string> transported_csr_addrs(std::string_view manifest_csv);
+
+}  // namespace andes_sim
+
+#endif  // ANDESIM_TRANSPORT_CSRS_HPP
