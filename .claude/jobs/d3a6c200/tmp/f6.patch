+#!/usr/bin/env bash
+# Normalized registration identity hash for a vsim build config.inc.
+#
+# config.inc's first line is a build timestamp ("// created on <date>"), so
+# hashing it raw re-stales the registration on every rebuild even when the
+# config is byte-identical otherwise. Strip that line, sha256, take the first 8
+# hex -- the stable per-config identity behind the registration dir name
+# (tests/engines/<engine>-<hash>/). ONE definition, shared by every consumer:
+#   - test_registration_guard.sh (the presence + hash gate)
+#   - the andesim driver's manifest-driven --transport-csrs wiring (run_plan.cpp)
+#   - the engine.env recompute instruction
+# so the identity can never drift between them.
+#
+# Usage: config_hash.sh <path/to/config.inc>   ->   prints 8 hex chars
+set -euo pipefail
+CFG="${1:?usage: config_hash.sh <config.inc>}"
+[ -f "$CFG" ] || { echo "config_hash.sh: no such config.inc: $CFG" >&2; exit 1; }
+grep -v '^// created on ' "$CFG" | sha256sum | cut -c1-8
