@@ -0,0 +1,74 @@
+// See transport_csrs.hpp.
+#include "transport_csrs.hpp"
+
+#include <cstddef>
+
+namespace andes_sim {
+namespace {
+
+// Strip surrounding ASCII whitespace (incl. a trailing CR from CRLF input).
+std::string_view trim(std::string_view s) {
+  const char* ws = " \t\r\n";
+  const size_t b = s.find_first_not_of(ws);
+  if (b == std::string_view::npos) return {};
+  return s.substr(b, s.find_last_not_of(ws) - b + 1);
+}
+
+// Split one CSV line into trimmed fields (no quoting -- the manifest has none).
+std::vector<std::string_view> fields(std::string_view line) {
+  std::vector<std::string_view> out;
+  size_t pos = 0;
+  for (;;) {
+    const size_t comma = line.find(',', pos);
+    const std::string_view cell =
+        line.substr(pos, comma == std::string_view::npos ? comma : comma - pos);
+    out.push_back(trim(cell));
+    if (comma == std::string_view::npos) break;
+    pos = comma + 1;
+  }
+  return out;
+}
+
+// Index of `name` in the header row, or npos.
+size_t col(const std::vector<std::string_view>& hdr, std::string_view name) {
+  for (size_t i = 0; i < hdr.size(); ++i)
+    if (hdr[i] == name) return i;
+  return static_cast<size_t>(-1);
+}
+
+}  // namespace
+
+std::vector<std::string> transported_csr_addrs(std::string_view csv) {
+  std::vector<std::string> out;
+  const size_t npos = static_cast<size_t>(-1);
+  size_t addr_col = npos, xport_col = npos;
+  bool have_header = false;
+
+  size_t pos = 0;
+  while (pos <= csv.size()) {
+    const size_t nl = csv.find('\n', pos);
+    const std::string_view raw =
+        csv.substr(pos, nl == std::string_view::npos ? nl : nl - pos);
+    pos = (nl == std::string_view::npos) ? csv.size() + 1 : nl + 1;
+
+    if (trim(raw).empty()) continue;  // skip blank lines
+    const std::vector<std::string_view> f = fields(raw);
+
+    if (!have_header) {  // first non-blank line names the columns
+      addr_col = col(f, "addr");
+      xport_col = col(f, "transported");
+      have_header = true;
+      if (addr_col == npos || xport_col == npos) return {};  // not a manifest
+      continue;
+    }
+
+    if (f.size() <= addr_col || f.size() <= xport_col) continue;
+    if (f[xport_col] != "yes") continue;
+    // A range row "0xLO~HI" contributes its low address (before '~').
+    std::string_view a = f[addr_col];
+    out.emplace_back(a.substr(0, a.find('~')));
+  }
+  return out;
+}
+
+}  // namespace andes_sim
