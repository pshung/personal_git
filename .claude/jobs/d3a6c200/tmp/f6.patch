+// Unit tests for the manifest -> transport-csrs parser (F6 last mile).
+#include "transport_csrs.hpp"
+
+#include "test_check.hpp"
+
+using namespace andes_sim;
+
+int main() {
+  // --- transported=yes rows, in file order; range -> low address ---
+  {
+    const std::string csv =
+        "addr,name,access,exists_cond,implemented,transported,"
+        "gate_or_disposition,reset_value,verify,safe_write\n"
+        "0xF11,mvendorid,MRO,Always,yes,no,CONST_RO,-,-,-\n"
+        "0x300,mstatus,MRW,Always,yes,yes,gate=on,0x0,yes,yes\n"
+        "0x3B1~3EF,pmpaddr1~63,MRW,Always,yes,yes,-,-,-,-\n"
+        "0x7C4,mxstatus,MRW,Always,yes,yes,-,yes,yes,yes\n";
+    test::check_eq(transported_csr_addrs(csv), {"0x300", "0x3B1", "0x7C4"},
+                   "addrs");
+  }
+
+  // --- header located by NAME, not position (columns reordered) ---
+  {
+    const std::string csv =
+        "transported,addr,name\n"
+        "no,0xF11,mvendorid\n"
+        "yes,0x7D0,mmisc_ctl\n";
+    test::check_eq(transported_csr_addrs(csv), {"0x7D0"}, "reordered");
+  }
+
+  // --- blank lines skipped; trailing CR tolerated ---
+  {
+    const std::string csv =
+        "addr,name,transported\r\n"
+        "\r\n"
+        "0x340,mscratch,yes\r\n"
+        "\n"
+        "0x341,mepc,yes\r\n";
+    test::check_eq(transported_csr_addrs(csv), {"0x340", "0x341"}, "crlf");
+  }
+
+  // --- empty / no header / missing column -> empty (tolerant fallback) ---
+  {
+    CHECK(transported_csr_addrs("").empty());
+    CHECK(transported_csr_addrs("addr,name\n0x300,mstatus\n").empty());
+  }
+
+  return test::report("transport-csrs");
+}
