+// config_hash.sh is a `grep | sha256sum | cut` -- effectively instant; a small
+// cap, not a real wait.
+constexpr int kConfigHashProbeMs = 5000;
+
+// F6: build the vsim accurate leg's --transport-csrs list from its REGISTERED
+// manifest, so the runtime transports exactly the CSR set registration
+// measured. From the engine binary path (<dir>/sim_<name>), hash its build
+// config.inc via the shared tests/engines/config_hash.sh (the same normalized
+// identity the registration guard keys on), locate
+// tests/engines/<name>-<hash>/csr_manifest.csv, and write its transported
+// addresses (one hex per line) to <workdir>/transport-csrs.list. Returns that
+// path, or "" on ANY miss -- a non-sim_ engine, a missing config.inc / hash
+// script / manifest, an unreadable or empty parse -- the tolerant fallback that
+// leaves the accurate leg on its compiled-in config caps (today's behavior).
+std::string stage_transport_csrs(const std::string& workdir,
+                                 const std::string& engine_bin) {
+  try {
+    std::error_code ec;
+    const fs::path bin(engine_bin);
+    const std::string fname = bin.filename().string();
+    constexpr std::string_view kSim = "sim_";
+    if (!fname.starts_with(kSim)) return "";  // not a vsim sim_<name> binary
+    const std::string name = fname.substr(kSim.size());
+
+    const fs::path cfg =
+        bin.parent_path() / ("V" + name) / "obj_sc" / "config.inc";
+    if (!fs::exists(cfg, ec)) return "";
+
+    const fs::path root = repo_root();
+    const fs::path engines_dir = root / "tests" / "engines";
+    const fs::path script = engines_dir / "config_hash.sh";
+    if (!fs::exists(script, ec)) return "";
+
+    const RunResult h = run_process({"bash", script.string(), cfg.string()},
+                                    kConfigHashProbeMs);
+    if (h.spawn_failed || h.timed_out || h.rc != 0) return "";
+    std::string hash = h.out;
+    if (const size_t e = hash.find_last_not_of(" \t\r\n");
+        e != std::string::npos)
+      hash.erase(e + 1);
+    else
+      return "";  // all whitespace
+
+    const fs::path manifest =
+        engines_dir / (name + "-" + hash) / "csr_manifest.csv";
+    std::ifstream mf(manifest, std::ios::binary);
+    if (!mf) return "";
+    const std::string csv((std::istreambuf_iterator<char>(mf)),
+                          std::istreambuf_iterator<char>());
+    const std::vector<std::string> addrs = transported_csr_addrs(csv);
+    if (addrs.empty()) return "";  // unreadable/malformed -> fall back
+
+    const std::string out = workdir + "/transport-csrs.list";
+    std::ofstream f(out, std::ios::binary | std::ios::trunc);
+    for (const std::string& a : addrs) f << a << '\n';
+    if (!f) return "";
+    return out;
+  } catch (...) {
+    return "";  // best-effort: never break a run over the transport-csrs probe
+  }
+}
